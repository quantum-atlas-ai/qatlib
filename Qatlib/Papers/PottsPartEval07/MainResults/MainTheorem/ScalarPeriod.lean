module


public import Qatlib.Papers.PottsPartEval07.MainResults.MainTheorem.GaussPeriod
public import Qatlib.Papers.PottsPartEval07.MainResults.MainTheorem.TraceFourier

@[expose] public section

/-!
# The actual scalar-orbit homomorphism in the McEliece reduction

Multiplication maps a prime-field unit and a trace-coordinate subgroup element
to an actual field unit. Every image fiber has the actual kernel cardinality.
Grouping this finite sum derives the Gauss period used by the trace-weight
formula, without assuming the desired weight formula.
-/

set_option autoImplicit false

noncomputable section

namespace Qatlib.Papers.PottsPartEval07.MainResults.MainTheorem

open scoped Classical BigOperators

/-- Grouping the actual fibers of a finite group homomorphism derives its sum multiplicity. -/
theorem hom_fiber_sum {G M : Type*} [Group G] [Fintype G] [Group M] [Fintype M]
    (map : G →* M) (value : M → ℂ) :
    (∑ g : G, value (map g)) =
      (Nat.card map.ker : ℂ) * ∑ u : map.range, value u := by
  rw [Finset.sum_comp]
  calc
    _ = ∑ u ∈ (Finset.univ : Finset G).image map,
        (Nat.card map.ker : ℂ) * value u := by
      apply Finset.sum_congr rfl
      intro u hu
      have hf := MonoidHom.card_fiber_eq_of_mem_range map
        (x := u) (y := 1) (by simpa using hu) ⟨1, map.map_one⟩
      have hk : (Finset.univ.filter (fun g : G => map g = 1)).card = Nat.card map.ker := by
        rw [Nat.card_eq_fintype_card]
        symm
        exact Fintype.card_subtype _
      rw [hf, hk, nsmul_eq_mul]
    _ = _ := by
      rw [← Finset.mul_sum]
      congr 1
      exact Finset.sum_subtype _ (by simp) _

/-- Removing zero from a field sum enumerates exactly its actual multiplicative units. -/
theorem field_erase_sum {K : Type*} [Field K] [Fintype K] (value : K → ℂ) :
    (∑ a ∈ (Finset.univ : Finset K).erase 0, value a) = ∑ u : Kˣ, value u := by
  have h := Equiv.sum_comp (fieldUnits (F := K)) value
  rw [Fintype.sum_option] at h
  change value 0 + (∑ u : Kˣ, value u) = ∑ a : K, value a at h
  apply add_right_cancel (b := value 0)
  calc
    _ = ∑ a : K, value a := Finset.sum_erase_add _ _ (Finset.mem_univ 0)
    _ = _ := h.symm.trans (add_comm _ _)

variable {F : Type*} [Field F] [Fintype F]
  [Algebra (ZMod (ringChar F)) F] [Fact (ringChar F).Prime]

/-- The actual scalar-coordinate multiplication homomorphism. -/
def scalarOrbit (subgroup : Subgroup Fˣ) :
    ((ZMod (ringChar F))ˣ × subgroup) →* Fˣ where
  toFun pair := Units.map (algebraMap (ZMod (ringChar F)) F).toMonoidHom pair.1 * pair.2.val
  map_one' := by simp
  map_mul' := by
    intro a b
    simp only [Prod.fst_mul, Prod.snd_mul, map_mul, Subgroup.coe_mul]
    ac_rfl

/-- The actual subgroup generated by scalar-coordinate products. -/
def scalarGroup (subgroup : Subgroup Fˣ) : Subgroup Fˣ := (scalarOrbit subgroup).range

/-- Actual nonzero scalar-coordinate products form one period with the derived fiber count. -/
theorem scalar_period (subgroup : Subgroup Fˣ) (additive : AddChar F ℂ) (parameter : F) :
    (∑ a : (ZMod (ringChar F))ˣ, ∑ u : subgroup,
      additive (parameter * (algebraMap (ZMod (ringChar F)) F a * (u : Fˣ)))) =
      (Nat.card (scalarOrbit subgroup).ker : ℂ) *
        ∑ u : scalarGroup subgroup, additive (parameter * (u : Fˣ)) := by
  have h := hom_fiber_sum (scalarOrbit subgroup) (fun u : Fˣ => additive (parameter * u))
  have hlhs : (∑ pair : (ZMod (ringChar F))ˣ × subgroup,
      additive (parameter * ((scalarOrbit subgroup) pair : F))) =
      ∑ a : (ZMod (ringChar F))ˣ, ∑ u : subgroup,
        additive (parameter * (algebraMap (ZMod (ringChar F)) F a * (u : Fˣ))) := by
    rw [Fintype.sum_prod_type]
    rfl
  rw [hlhs] at h
  refine h.trans ?_
  congr 1
  apply Finset.sum_congr
  · ext u
    constructor
    · intro _
      change (⟨u.1, u.2⟩ : scalarGroup subgroup) ∈
        (Finset.univ : Finset (scalarGroup subgroup))
      exact Finset.mem_univ _
    · intro _
      simp only [Finset.mem_univ]
  · intro u _
    rfl

/-- The actual scalar-orbit kernel and range cardinalities multiply to the input cardinality. -/
theorem scalar_card (subgroup : Subgroup Fˣ) :
    Nat.card (scalarOrbit subgroup).ker * Nat.card (scalarGroup subgroup) =
      (ringChar F - 1) * Nat.card subgroup := by
  have h := Subgroup.card_ker_mul_card_range (scalarOrbit subgroup)
  have hc : Nat.card (ZMod (ringChar F))ˣ = ringChar F - 1 := by
    rw [Nat.card_eq_fintype_card, Fintype.card_units, ZMod.card]
  simpa only [Nat.card_prod, hc, scalarGroup] using h

variable {E : Type*} [Fintype E] [DecidableEq E]

omit [DecidableEq E] in
/-- Actual subgroup trace coordinates turn the scalar-character weight sum into one period. -/
theorem trace_orbit_sum (subgroup : Subgroup Fˣ) (coordinate : E ≃ subgroup)
    (additive : AddChar (ZMod (ringChar F)) ℂ) (ha : additive.IsPrimitive) (parameter : F) :
    (ringChar F : ℂ) *
        (Qatlib.Papers.PottsPartEval07.ExactRecovery.hammingWeight
          (Qatlib.Papers.PottsPartEval07.CodeStructure.traceWord
            (fun e => ((coordinate e : Fˣ) : F)) parameter) : ℂ) =
      ((ringChar F : ℂ) - 1) * Fintype.card E -
        (Nat.card (scalarOrbit subgroup).ker : ℂ) *
          ∑ u : scalarGroup subgroup, traceAddChar additive (parameter * (u : Fˣ)) := by
  rw [trace_weight_sum additive ha]
  congr 1
  let value : ZMod (ringChar F) → ℂ := fun a => ∑ e : E, traceAddChar additive
    (algebraMap (ZMod (ringChar F)) F a * (parameter * ((coordinate e : Fˣ) : F)))
  change (∑ a ∈ (Finset.univ : Finset (ZMod (ringChar F))).erase 0, value a) = _
  calc
    _ = ∑ a : {a : ZMod (ringChar F) // a ≠ 0}, value a :=
      Finset.sum_subtype _ (by intro a; simp) _
    _ = ∑ a : (ZMod (ringChar F))ˣ, value a :=
      (Fintype.sum_equiv unitsEquivNeZero _ _ (fun _ => rfl)).symm
    _ = ∑ a : (ZMod (ringChar F))ˣ, ∑ u : subgroup,
        traceAddChar additive
          (parameter * (algebraMap (ZMod (ringChar F)) F a * (u : Fˣ))) := by
      apply Finset.sum_congr rfl
      intro a _
      dsimp only [value]
      rw [← Equiv.sum_comp coordinate]
      apply Finset.sum_congr rfl
      intro e _
      congr 1
      ring
    _ = _ := scalar_period subgroup (traceAddChar additive) parameter

end Qatlib.Papers.PottsPartEval07.MainResults.MainTheorem
