module

public import Qatlib.Papers.PottsPartEval07.MainResults.MainTheorem.TraceClasses

@[expose] public section

/-!
# Frobenius orbits and exact multiplicity tallies

Raising a nonzero field parameter to the `q`-th power multiplies its discrete-log
exponent by `q`, as used in [GeraciLidar2008], §II.F. For multiplication by `q`
on residues modulo `N`, an invariant weight is constant on each cyclotomic coset.
Given a trace-code orbit enumeration indexed by those residues and invariance of
its representative weights, the orbit sizes give the positive-weight multiplicities.
The zero-weight coefficient is one by uniqueness of the zero word.

## Main statements

* `frobeniusOrbit_invariant`: an invariant weight is constant on each Frobenius orbit.
* `frobenius_weight_tally`: the exact class tally for the orbit representatives.
* `frobenius_code_weight_tally`: the tally on residues with `n` copies per residue.
* `traceCode_frobenius_weight_tally`: the resulting positive-weight count in an
  actual trace code with a compatible orbit enumeration and invariant weight.
* `traceCode_zero_weight_card`: the zero word is the unique codeword of Hamming weight zero.

The trace-code result assumes the enumeration and Frobenius invariance.
Computing a compatible discrete-log enumeration and counting the cyclotomic
cosets by the divisor sum in Eq. (34) are outside its scope.

## References

* [Geraci and Lidar, 2008][GeraciLidar2008]
-/

set_option autoImplicit false

namespace Qatlib.Papers.PottsPartEval07.CodeStructure

open scoped BigOperators
open Qatlib.Papers.PottsPartEval07.CodeStructure
open Qatlib.Papers.PottsPartEval07.ExactRecovery
open Qatlib.Papers.PottsPartEval07.MainResults.MainTheorem

variable {N q : ℕ} [NeZero N]

/-- Multiplication by `q` modulo `N` as a permutation, assuming coprimality. -/
noncomputable def qmulPerm (h : Nat.Coprime q N) : Equiv.Perm (ZMod N) :=
  (ZMod.unitOfCoprime q h).mulLeft

omit [NeZero N] in
/-- The permutation of residues induced by multiplication by `q`. -/
@[simp]
theorem qmulPerm_apply (h : Nat.Coprime q N) (x : ZMod N) :
    qmulPerm h x = (q : ZMod N) * x := by
  simp [qmulPerm]

/-- The relation identifying two residues when an integer power of `q` carries one to the
other. -/
def frobeniusSetoid (h : Nat.Coprime q N) : Setoid (ZMod N) where
  r x y := ∃ m : ℤ, ((qmulPerm h) ^ m) x = y
  iseqv := by
    refine ⟨?_, ?_, ?_⟩
    · intro x
      exact ⟨0, by simp⟩
    · intro x y ⟨m, hm⟩
      refine ⟨-m, ?_⟩
      rw [← hm]
      simp [zpow_neg]
    · intro x y z ⟨m, hm⟩ ⟨n, hn⟩
      refine ⟨n + m, ?_⟩
      rw [← hn, ← hm]
      rw [zpow_add]
      rfl

/-- The forward orbit of a residue under the cyclic group generated by multiplication by
`q`. -/
noncomputable def frobeniusOrbit (h : Nat.Coprime q N) (x : ZMod N) : Finset (ZMod N) :=
  by
    classical
    exact Finset.univ.filter fun y => (frobeniusSetoid h).r x y

/-- Membership in the Frobenius orbit is the same as being an integer power of `q` applied to
the base point. -/
theorem mem_frobeniusOrbit_iff (h : Nat.Coprime q N) {x y : ZMod N} :
    y ∈ frobeniusOrbit h x ↔ ∃ m : ℤ, ((qmulPerm h) ^ m) x = y := by
  classical
  unfold frobeniusOrbit
  rw [Finset.mem_filter]
  simp only [Finset.mem_univ, true_and]
  rfl

/-- The base point belongs to its own Frobenius orbit. -/
theorem mem_frobeniusOrbit_self (h : Nat.Coprime q N) (x : ZMod N) :
    x ∈ frobeniusOrbit h x := by
  rw [mem_frobeniusOrbit_iff]
  exact ⟨0, by simp⟩

/-- Frobenius-orbit membership is symmetric. -/
theorem mem_frobeniusOrbit_comm (h : Nat.Coprime q N) {x y : ZMod N} :
    y ∈ frobeniusOrbit h x ↔ x ∈ frobeniusOrbit h y := by
  rw [mem_frobeniusOrbit_iff, mem_frobeniusOrbit_iff]
  constructor
  · rintro ⟨m, hm⟩
    refine ⟨-m, ?_⟩
    rw [← hm]
    rw [← Equiv.Perm.mul_apply, ← zpow_add]
    simp
  · rintro ⟨m, hm⟩
    refine ⟨-m, ?_⟩
    rw [← hm]
    rw [← Equiv.Perm.mul_apply, ← zpow_add]
    simp

/-- Orbits that share a point are equal. -/
theorem frobeniusOrbit_eq_of_mem (h : Nat.Coprime q N) {x y : ZMod N}
    (hy : y ∈ frobeniusOrbit h x) :
    frobeniusOrbit h y = frobeniusOrbit h x := by
  apply Finset.ext
  intro z
  rw [mem_frobeniusOrbit_iff, mem_frobeniusOrbit_iff]
  constructor
  · rintro ⟨m, hm⟩
    obtain ⟨n, hn⟩ := (mem_frobeniusOrbit_iff h).mp hy
    refine ⟨m + n, ?_⟩
    calc ((qmulPerm h) ^ (m + n)) x
        = ((qmulPerm h) ^ m) (((qmulPerm h) ^ n) x) := by
          rw [zpow_add, Equiv.Perm.mul_apply]
      _ = ((qmulPerm h) ^ m) y := by rw [hn]
      _ = z := hm
  · rintro ⟨m, hm⟩
    obtain ⟨n, hn⟩ := (mem_frobeniusOrbit_iff h).mp hy
    refine ⟨m - n, ?_⟩
    calc ((qmulPerm h) ^ (m - n)) y
        = ((qmulPerm h) ^ (m - n)) (((qmulPerm h) ^ n) x) := by rw [hn]
      _ = ((qmulPerm h) ^ (m - n + n)) x := by
          rw [← Equiv.Perm.mul_apply, ← zpow_add]
      _ = ((qmulPerm h) ^ m) x := by rw [show m - n + n = m by ring]
      _ = z := hm

/-- Multiplication by `q` preserves the orbit of a point. -/
theorem qmulPerm_mem_frobeniusOrbit_iff (h : Nat.Coprime q N) (r x : ZMod N) :
    qmulPerm h x ∈ frobeniusOrbit h r ↔ x ∈ frobeniusOrbit h r := by
  rw [mem_frobeniusOrbit_iff, mem_frobeniusOrbit_iff]
  constructor
  · rintro ⟨m, hm⟩
    refine ⟨m - 1, ?_⟩
    apply (qmulPerm h).injective
    calc qmulPerm h (((qmulPerm h) ^ (m - 1)) r)
        = ((qmulPerm h) ^ (1 + (m - 1))) r := by
          rw [zpow_one_add, Equiv.Perm.mul_apply]
      _ = ((qmulPerm h) ^ m) r := by rw [show 1 + (m - 1) = m by ring]
      _ = qmulPerm h x := hm
  · rintro ⟨m, hm⟩
    refine ⟨1 + m, ?_⟩
    rw [zpow_one_add, Equiv.Perm.mul_apply, hm]

/-- The orbit indicator is invariant under multiplication by `q`. -/
noncomputable def orbitIndicator (h : Nat.Coprime q N) (r : ZMod N) (x : ZMod N) : ℕ :=
  if x ∈ frobeniusOrbit h r then 1 else 0

/-- The orbit indicator satisfies the Frobenius-invariance hypothesis of the tally. -/
theorem orbitIndicator_invariant (h : Nat.Coprime q N) (r : ZMod N) :
    ∀ x, orbitIndicator h r ((q : ZMod N) * x) = orbitIndicator h r x := by
  intro x
  unfold orbitIndicator
  by_cases hx : x ∈ frobeniusOrbit h r
  · have hx' : (q : ZMod N) * x ∈ frobeniusOrbit h r := by
      rw [← qmulPerm_apply h x]
      exact (qmulPerm_mem_frobeniusOrbit_iff h r x).mpr hx
    rw [ite_eq_left hx', ite_eq_left hx]
  · have hx' : (q : ZMod N) * x ∉ frobeniusOrbit h r := by
      intro hmem
      rw [← qmulPerm_apply h x] at hmem
      exact hx ((qmulPerm_mem_frobeniusOrbit_iff h r x).mp hmem)
    rw [ite_eq_right hx', ite_eq_right hx]

omit [NeZero N] in
/-- An invariant weight is constant along each integer power of the Frobenius permutation. -/
theorem frobenius_zpow_invariant (h : Nat.Coprime q N) (S : ZMod N → ℕ)
    (hS : ∀ x, S ((q : ZMod N) * x) = S x) (m : ℤ) (x : ZMod N) :
    S (((qmulPerm h) ^ m) x) = S x := by
  have hf : ∀ y, S (qmulPerm h y) = S y := by
    intro y
    rw [qmulPerm_apply]
    exact hS y
  have hfinv : ∀ y, S ((qmulPerm h)⁻¹ y) = S y := by
    intro y
    have := hf ((qmulPerm h)⁻¹ y)
    have h1 : (qmulPerm h) ((qmulPerm h)⁻¹ y) = y :=
      Equiv.apply_symm_apply (qmulPerm h) y
    rw [h1] at this
    exact this.symm
  exact zpow_induction_left (g := qmulPerm h)
    (P := fun a => S (a x) = S x) (by simp)
    (fun a ha => by
      rw [show (qmulPerm h * a) x = qmulPerm h (a x) by rfl, hf, ha])
    (fun a ha => by
      rw [show ((qmulPerm h)⁻¹ * a) x = (qmulPerm h)⁻¹ (a x) by rfl, hfinv, ha]) m

/-- An invariant weight is constant on every Frobenius orbit. -/
theorem frobeniusOrbit_invariant (h : Nat.Coprime q N) (S : ZMod N → ℕ)
    (hS : ∀ x, S ((q : ZMod N) * x) = S x) {x y : ZMod N}
    (hy : y ∈ frobeniusOrbit h x) :
    S y = S x := by
  obtain ⟨m, rfl⟩ := (mem_frobeniusOrbit_iff h).mp hy
  exact frobenius_zpow_invariant h S hS m x

/-- A classically chosen representative of the Frobenius orbit of `x`. -/
noncomputable def orbitRep (h : Nat.Coprime q N) (x : ZMod N) : ZMod N :=
  Quotient.out (Quotient.mk (frobeniusSetoid h) x)

/-- The chosen representative lies in the orbit it represents. -/
theorem orbitRep_mem (h : Nat.Coprime q N) (x : ZMod N) :
    orbitRep h x ∈ frobeniusOrbit h x := by
  have hout : (frobeniusSetoid h).r (orbitRep h x) x :=
    Quotient.exact (Quotient.out_eq (Quotient.mk (frobeniusSetoid h) x))
  exact (mem_frobeniusOrbit_comm h).mpr (by simpa [frobeniusOrbit] using hout)

/-- Orbit representatives are constant on a common orbit. -/
theorem orbitRep_eq_of_mem (h : Nat.Coprime q N) {x y : ZMod N}
    (hy : y ∈ frobeniusOrbit h x) :
    orbitRep h y = orbitRep h x := by
  have hq : Quotient.mk (frobeniusSetoid h) y = Quotient.mk (frobeniusSetoid h) x :=
    (Quotient.sound (by simpa [frobeniusOrbit] using hy)).symm
  exact congrArg Quotient.out hq

/-- A representative is idempotent. -/
theorem orbitRep_idem (h : Nat.Coprime q N) (x : ZMod N) :
    orbitRep h (orbitRep h x) = orbitRep h x :=
  orbitRep_eq_of_mem h (orbitRep_mem h x)

/-- Two points have the same representative exactly when they lie in the same orbit. -/
theorem orbitRep_eq_iff (h : Nat.Coprime q N) {x y : ZMod N} :
    orbitRep h x = orbitRep h y ↔ y ∈ frobeniusOrbit h x := by
  constructor
  · intro heq
    have hxrep : orbitRep h x ∈ frobeniusOrbit h x := orbitRep_mem h x
    have hyrep : orbitRep h y ∈ frobeniusOrbit h y := orbitRep_mem h y
    rw [heq] at hxrep
    have horbit_eq : frobeniusOrbit h y = frobeniusOrbit h x := by
      have hx_eq : frobeniusOrbit h x = frobeniusOrbit h (orbitRep h y) :=
        (frobeniusOrbit_eq_of_mem h hxrep).symm
      have hy_eq : frobeniusOrbit h y = frobeniusOrbit h (orbitRep h y) :=
        (frobeniusOrbit_eq_of_mem h hyrep).symm
      rw [hy_eq, hx_eq]
    rw [← horbit_eq]
    exact mem_frobeniusOrbit_self h y
  · intro hy
    exact (orbitRep_eq_of_mem h hy).symm

/-- The fibre of a representative is exactly its orbit. -/
theorem card_fiber_orbitRep (h : Nat.Coprime q N) {r : ZMod N}
    (hr : r ∈ Finset.univ.image (fun x => orbitRep h x)) :
    (Finset.univ.filter (fun x => orbitRep h x = r)).card =
      (frobeniusOrbit h r).card := by
  have hrrep : orbitRep h r = r := by
    obtain ⟨x, _, rfl⟩ := Finset.mem_image.mp hr
    exact orbitRep_idem h x
  have hset : Finset.univ.filter (fun x => orbitRep h x = r) = frobeniusOrbit h r := by
    apply Finset.ext
    intro x
    constructor
    · intro hx
      rw [Finset.mem_filter] at hx
      have hmem := orbitRep_mem h x
      rw [hx.2] at hmem
      exact (mem_frobeniusOrbit_comm h).mp hmem
    · intro hx
      rw [Finset.mem_filter]
      refine ⟨Finset.mem_univ _, ?_⟩
      rw [orbitRep_eq_of_mem h hx, hrrep]
  rw [hset]

/-- The fibre of a representative with a prescribed weight is a full orbit or empty. -/
theorem card_fiber_weight (h : Nat.Coprime q N) (S : ZMod N → ℕ)
    (hS : ∀ x, S ((q : ZMod N) * x) = S x) (w : ℕ) {r : ZMod N}
    (hr : r ∈ Finset.univ.image (fun x => orbitRep h x)) :
    (Finset.univ.filter (fun x => S x = w ∧ orbitRep h x = r)).card =
      if S r = w then (frobeniusOrbit h r).card else 0 := by
  have hconst : ∀ x, orbitRep h x = r → S x = S r := by
    intro x hx
    have hmem := orbitRep_mem h x
    rw [hx] at hmem
    exact frobeniusOrbit_invariant h S hS ((mem_frobeniusOrbit_comm h).mp hmem)
  by_cases hw : S r = w
  · rw [ite_eq_left hw, ← card_fiber_orbitRep h hr]
    congr 1
    apply Finset.ext
    intro x
    simp only [Finset.mem_filter, Finset.mem_univ, true_and]
    constructor
    · rintro ⟨_, hxr⟩
      exact hxr
    · intro hxr
      exact ⟨by rw [hconst x hxr, hw], hxr⟩
  · rw [ite_eq_right hw]
    rw [Finset.card_eq_zero, Finset.eq_empty_iff_forall_notMem]
    intro x hx
    rw [Finset.mem_filter] at hx
    exact hw ((hconst x hx.2.2).symm.trans hx.2.1)

/-- The exact Frobenius class tally for an invariant weight. -/
theorem frobenius_weight_tally (h : Nat.Coprime q N) (S : ZMod N → ℕ)
    (hS : ∀ x, S ((q : ZMod N) * x) = S x) (w : ℕ) :
    (Finset.univ.filter (fun x : ZMod N => S x = w)).card =
      ∑ r ∈ Finset.univ.image (fun x => orbitRep h x),
        if S r = w then (frobeniusOrbit h r).card else 0 := by
  classical
  have hmap : (Finset.univ.filter (fun x : ZMod N => S x = w) : Set (ZMod N)).MapsTo
      (fun x => orbitRep h x) (Finset.univ.image (fun x => orbitRep h x)) := by
    intro x _
    exact Finset.mem_image_of_mem _ (Finset.mem_univ x)
  rw [Finset.card_eq_sum_card_fiberwise hmap]
  refine Finset.sum_congr rfl ?_
  intro r hr
  rw [← card_fiber_weight h S hS w hr]
  congr 1
  apply Finset.ext
  intro x
  simp only [Finset.mem_filter, Finset.mem_univ, true_and]

/-- The orbit sizes over a representative set sum to `N`. -/
theorem sum_orbit_card (h : Nat.Coprime q N) :
    ∑ r ∈ Finset.univ.image (fun x => orbitRep h x), (frobeniusOrbit h r).card =
      Fintype.card (ZMod N) := by
  have := frobenius_weight_tally h (fun _ => 0) (by intro x; rfl) 0
  simpa using this.symm

/-- Count weighted residue records with `n` copies of each residue. -/
theorem frobenius_code_weight_tally (h : Nat.Coprime q N) (n : ℕ) (S : ZMod N → ℕ)
    (hS : ∀ x, S ((q : ZMod N) * x) = S x) (w : ℕ) :
    (Finset.univ.filter (fun p : ZMod N × Fin n => S p.1 = w)).card =
      n * ∑ r ∈ Finset.univ.image (fun x => orbitRep h x),
        if S r = w then (frobeniusOrbit h r).card else 0 := by
  rw [show Finset.univ.filter (fun p : ZMod N × Fin n => S p.1 = w) =
      (Finset.univ.filter (fun x : ZMod N => S x = w)) ×ˢ
        (Finset.univ : Finset (Fin n)) by
    ext p
    simp]
  rw [Finset.card_product, frobenius_weight_tally h S hS w]
  simp [Nat.mul_comm]

/-- The Hamming weight of a word is zero exactly for the zero word. -/
theorem hammingWeight_eq_zero_iff {ι : Type*} [Fintype ι] {q : ℕ} [NeZero q]
    (v : ι → ZMod q) :
    hammingWeight v = 0 ↔ v = 0 := by
  constructor
  · intro h
    funext i
    by_contra hi
    have hmem : i ∈ Finset.univ.filter (fun j => v j ≠ 0) := by
      rw [Finset.mem_filter]
      exact ⟨Finset.mem_univ _, hi⟩
    have hpos : 0 < (Finset.univ.filter (fun j => v j ≠ 0)).card :=
      Finset.card_pos.mpr ⟨i, hmem⟩
    rw [hammingWeight] at h
    omega
  · intro h
    rw [h]
    simp [hammingWeight]

/-- A spanning trace representation with invariant representative weights has the
Frobenius multiplicity formula for actual codewords of positive weight. -/
theorem traceCode_frobenius_weight_tally {F : Type*} [Field F] [Fintype F]
    [Algebra (ZMod (ringChar F)) F] [NeZero (ringChar F)]
    {E : Type*} [Fintype E] [DecidableEq E] [Nonempty E] {classes : ℕ}
    (h : Nat.Coprime (ringChar F) N) (index : ZMod N ≃ Fin classes) (g : E → F)
    (hspan : Submodule.span (ZMod (ringChar F)) (Set.range g) = ⊤)
    (orbits : TraceOrbits g classes (Fintype.card E))
    (hS : ∀ x,
      hammingWeight (traceWord g (orbits.representative (index ((ringChar F : ZMod N) * x)))) =
        hammingWeight (traceWord g (orbits.representative (index x))))
    (w : ℕ) (hw : 0 < w) :
    (Finset.univ.filter (fun c : traceCode g => hammingWeight c.val = w)).card =
      Fintype.card E * ∑ r ∈ Finset.univ.image (fun x => orbitRep h x),
        if hammingWeight (traceWord g (orbits.representative (index r))) = w
        then (frobeniusOrbit h r).card else 0 := by
  classical
  let partition := traceWeightClasses g hspan orbits
  let S := fun x => hammingWeight (traceWord g (orbits.representative (index x)))
  let pairIndex := Equiv.prodCongr index (Equiv.refl (Fin (Fintype.card E)))
  have hrecord (p : ZMod N × Fin (Fintype.card E)) :
      hammingWeight (partition.encode (some (pairIndex p))).val = S p.1 :=
    partition.same_weight (index p.1) p.2
  rw [← frobenius_code_weight_tally h (Fintype.card E) S hS w]
  symm
  refine Finset.card_bij (fun p _ => partition.encode (some (pairIndex p))) ?_ ?_ ?_
  · intro p hp
    simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hp ⊢
    rw [hrecord p]
    exact hp
  · intro a _ b _ hab
    exact pairIndex.injective (Option.some.inj (partition.encode.injective hab))
  · intro c hc
    obtain ⟨record, rfl⟩ := partition.encode.surjective c
    simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hc
    cases record with
    | none =>
      rw [partition.zero_word, (hammingWeight_eq_zero_iff _).mpr rfl] at hc
      exact (Nat.ne_of_gt hw hc.symm).elim
    | some r =>
      refine ⟨pairIndex.symm r, ?_, by rw [pairIndex.apply_symm_apply]⟩
      simp only [Finset.mem_filter, Finset.mem_univ, true_and]
      rwa [← hrecord, pairIndex.apply_symm_apply]

/-- The zero word is the unique codeword of Hamming weight zero in a trace code. -/
theorem traceCode_zero_weight_card {F : Type*} [Field F] [Fintype F]
    [Algebra (ZMod (ringChar F)) F] [NeZero (ringChar F)]
    {E : Type*} [Fintype E] [DecidableEq E] [Nonempty E] (g : E → F) :
    (Finset.univ.filter (fun c : traceCode g => hammingWeight c.val = 0)).card = 1 := by
  classical
  have hfilter : (Finset.univ.filter (fun c : traceCode g => hammingWeight c.val = 0)) =
      {0} := by
    ext c
    rw [Finset.mem_filter, Finset.mem_singleton]
    constructor
    · rintro ⟨_, hw⟩
      have hv : (c : E → ZMod (ringChar F)) = 0 := (hammingWeight_eq_zero_iff c.val).mp hw
      exact Subtype.ext hv
    · intro hc
      rw [hc]
      exact ⟨Finset.mem_univ _, by simp [hammingWeight]⟩
  rw [hfilter, Finset.card_singleton]

end Qatlib.Papers.PottsPartEval07.CodeStructure
