module

public import Qatlib.Papers.PottsPartEval07.ExactRecovery.MacWilliams

@[expose] public section

/-!
# Systematic codes and their explicit parity-check duals

The membership step in [GeraciLidar2008] writes a length-`n` code in systematic form
`CMM = [I_{n-k} | X]` and proposes the parity-check matrix `H = [-Xᵀ | I_k]` for its dual.
This module formalizes that construction on a split index type `A ⊕ B`. The information block
is indexed by `A`, the parity block by `B`, and `X` is the rectangular block `A → B → ZMod q`.

## Main statements

* `dot_systematic_parityCheck`: the rows of `H` are orthogonal to every systematic codeword.
* `parityCheckCode_eq_dualCode`: the range of `H` is exactly the dot-product dual of the
  systematic code.
* `finrank_parityCheckCode`: for prime `q`, the dual has dimension `|B| = k`, so `H` is a
  full-rank parity-check matrix.

## References

* [Geraci and Lidar, 2008][GeraciLidar2008]
-/

set_option autoImplicit false

namespace Qatlib.Papers.PottsPartEval07.ClassMembership

open scoped BigOperators
open Qatlib.Papers.PottsPartEval07.ExactRecovery

variable {q : ℕ} [NeZero q]
variable {A B : Type*} [Fintype A] [Fintype B] [DecidableEq A] [DecidableEq B]

/-- The systematic encoder `u ↦ (u, u X)` on the split index type `A ⊕ B`. -/
noncomputable def systematicEncode (X : A → B → ZMod q) :
    (A → ZMod q) →ₗ[ZMod q] (A ⊕ B → ZMod q) where
  toFun u := Sum.elim u fun b => ∑ a, u a * X a b
  map_add' := by
    intro u v
    ext i
    cases i with
    | inl a => simp
    | inr b => simp [add_mul, Finset.sum_add_distrib]
  map_smul' := by
    intro c u
    ext i
    cases i with
    | inl a => simp
    | inr b =>
        simp only [Sum.elim_inr, Pi.smul_apply, smul_eq_mul, Finset.mul_sum,
          RingHom.id_apply]
        refine Finset.sum_congr rfl ?_
        intro a _
        ring

/-- The parity-check encoder `v ↦ (-Xᵀ v, v)` on the split index type `A ⊕ B`. -/
noncomputable def parityCheckEncode (X : A → B → ZMod q) :
    (B → ZMod q) →ₗ[ZMod q] (A ⊕ B → ZMod q) where
  toFun v := Sum.elim (fun a => -∑ b, X a b * v b) v
  map_add' := by
    intro v w
    ext i
    cases i with
    | inl a =>
        simp only [Sum.elim_inl, Pi.add_apply, mul_add, Finset.sum_add_distrib, neg_add]
    | inr b => simp
  map_smul' := by
    intro c v
    ext i
    cases i with
    | inl a =>
        simp only [Sum.elim_inl, Pi.smul_apply, smul_eq_mul, mul_neg, RingHom.id_apply]
        rw [Finset.mul_sum]
        simp only [neg_inj]
        refine Finset.sum_congr rfl ?_
        intro b _
        ring
    | inr b => simp

/-- The systematic code `[I | X]` as the range of the systematic encoder. -/
noncomputable def systematicCode (X : A → B → ZMod q) :
    Submodule (ZMod q) (A ⊕ B → ZMod q) :=
  LinearMap.range (systematicEncode X)

/-- The candidate dual code generated by the explicit parity-check matrix `H = [-Xᵀ | I]`. -/
noncomputable def parityCheckCode (X : A → B → ZMod q) :
    Submodule (ZMod q) (A ⊕ B → ZMod q) :=
  LinearMap.range (parityCheckEncode X)

omit [NeZero q] [DecidableEq A] [DecidableEq B] in
/-- The dot product of a systematic codeword with a parity-check row is zero. -/
theorem dot_systematic_parityCheck (X : A → B → ZMod q)
    (u : A → ZMod q) (v : B → ZMod q) :
    dot (systematicEncode X u) (parityCheckEncode X v) = 0 := by
  rw [dot, Fintype.sum_sum_type]
  change (∑ a, u a * (-∑ b, X a b * v b)) +
      (∑ b, (∑ a, u a * X a b) * v b) = 0
  simp only [mul_neg, Finset.mul_sum, Finset.sum_mul, Finset.sum_neg_distrib, mul_assoc]
  rw [Finset.sum_comm]
  simp only [neg_add_cancel]

omit [NeZero q] [DecidableEq A] [DecidableEq B] in
/-- Every parity-check codeword is orthogonal to every systematic codeword. -/
theorem parityCheckCode_le_dualCode (X : A → B → ZMod q) :
    parityCheckCode X ≤ dualCode (systematicCode X) := by
  intro w hw
  rw [mem_dualCode]
  intro c hc
  obtain ⟨v, rfl⟩ := hw
  obtain ⟨u, rfl⟩ := hc
  exact dot_systematic_parityCheck X u v

omit [NeZero q] [Fintype A] [DecidableEq A] [DecidableEq B] in
/-- The `H` map is injective because its second block is the identity. -/
theorem parityCheckEncode_injective (X : A → B → ZMod q) :
    Function.Injective (parityCheckEncode X) := by
  intro v w h
  funext b
  have := congrFun h (Sum.inr b)
  simpa [parityCheckEncode] using this

omit [NeZero q] [DecidableEq B] in
/-- Every word orthogonal to the systematic code is an explicit parity-check codeword. -/
theorem dualCode_le_parityCheckCode (X : A → B → ZMod q)
    [Nonempty A] :
    dualCode (systematicCode X) ≤ parityCheckCode X := by
  intro w hw
  classical
  refine LinearMap.mem_range.mpr ⟨fun b => w (Sum.inr b), ?_⟩
  ext i
  cases i with
  | inr b => simp [parityCheckEncode]
  | inl a =>
      let e : A → ZMod q := Function.update (0 : A → ZMod q) a 1
      have hsingle : ∀ b : B,
          (∑ a', e a' * X a' b) = X a b := by
        intro b
        rw [Finset.sum_eq_single a]
        · simp [e, Function.update_self]
        · intro a' _ ha'
          simp [e, Function.update_of_ne ha']
        · intro ha
          exact (ha (Finset.mem_univ a)).elim
      have hsum_inl : (∑ a', e a' * w (Sum.inl a')) = w (Sum.inl a) := by
        rw [Finset.sum_eq_single a]
        · simp [e, Function.update_self]
        · intro a' _ ha'
          simp [e, Function.update_of_ne ha']
        · intro ha
          exact (ha (Finset.mem_univ a)).elim
      have horth := hw (systematicEncode X e)
        (LinearMap.mem_range_self _ _)
      rw [dot, Fintype.sum_sum_type] at horth
      simp only [systematicEncode, LinearMap.coe_mk, AddHom.coe_mk, Sum.elim_inl,
        Sum.elim_inr, hsingle] at horth
      rw [hsum_inl] at horth
      rw [parityCheckEncode]
      change -∑ b, X a b * w (Sum.inr b) = w (Sum.inl a)
      rw [eq_comm]
      exact eq_neg_of_add_eq_zero_right (by simpa [add_comm] using horth)

omit [NeZero q] [DecidableEq B] in
/-- The explicit parity-check matrix generates exactly the dual of the systematic code. -/
theorem parityCheckCode_eq_dualCode (X : A → B → ZMod q) [Nonempty A] :
    parityCheckCode X = dualCode (systematicCode X) :=
  le_antisymm (parityCheckCode_le_dualCode X) (dualCode_le_parityCheckCode X)

omit [NeZero q] [Fintype A] [DecidableEq A] [DecidableEq B] in
/-- For prime `q`, the parity-check code has dimension `k = |B|`. -/
theorem finrank_parityCheckCode [Fact q.Prime] (X : A → B → ZMod q) :
    Module.finrank (ZMod q) (parityCheckCode X) = Fintype.card B := by
  rw [parityCheckCode,
    LinearMap.finrank_range_of_inj (parityCheckEncode_injective X),
    Module.finrank_fintype_fun_eq_card]

omit [NeZero q] [Fintype B] [DecidableEq A] [DecidableEq B] in
/-- For prime `q`, the systematic code has dimension `n - k = |A|`. -/
theorem finrank_systematicCode [Fact q.Prime] (X : A → B → ZMod q) :
    Module.finrank (ZMod q) (systematicCode X) = Fintype.card A := by
  rw [systematicCode,
    LinearMap.finrank_range_of_inj (by
      intro u v h
      funext a
      have := congrFun h (Sum.inl a)
      simpa [systematicEncode] using this),
    Module.finrank_fintype_fun_eq_card]

end Qatlib.Papers.PottsPartEval07.ClassMembership
