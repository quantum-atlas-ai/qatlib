import Mathlib.Algebra.Group.Defs
import Mathlib.Data.Nat.ModEq
import Mathlib.Tactic

set_option backward.isDefEq.respectTransparency false

/-!
# Paper-layer Lean for arXiv:1310.7903v4 (Banin--Tsaban)

Fixed source: Banin and Tsaban, *A reduction of semigroup DLP to classic DLP*,
arXiv:1310.7903v4 (6 Nov 2013).

This module formalizes the two mathematical core results and the correctness identity of
the main reduction, covering all three active claims of `SemigroupDLP13`:

* `lemma_2_1` — Lemma 2.1, p.2: `G = {g^(l+k) : 0 ≤ k < n}` is a cyclic group of order
  `n`, neutral element `g^(tn)`, generator `g^(tn+1)`, and `g^(tn) = g^(sn)` for `s ≥ t`.
* `lemma_2_4` — Lemma 2.4, pp.3--4: `g^x ∈ G ↔ g^n · g^x = g^x`.
* `main_semigroup_dlp_reduction` — Abstract / Reduction 2.5, pp.1,3--4: the exponent of
  `g^x` is recovered as `x' * (t*n+1) - c*n - b*n` from the structural data and one call
  to the classic DLP oracle for `G`. The witnesses are explicit; the complexity half of
  the Abstract (polynomial time, quantum, subexponential transfer) has no repository
  model and is documented as out of scope in the theorem's docstring.

## Formalization note

The paper works in a (possibly identity-free) semigroup and writes `g^0` in the set
notation `{g^k : 0 ≤ k < n}`. Lemma 2.1 only concerns the submonoid generated by `g`,
and the exponents occurring in `G` are positive (`l ≥ 1` follows from minimality), so we
state everything in a `Monoid`. Adjoining an identity to a semigroup changes no positive
power; this is a faithful reformulation, not a strengthening of the paper's assumptions.

Boundary. Everything is proved from the paper's own hypotheses (minimality of `l`, `n`,
and `t`, and `g^(l+n)=g^l`). No other periodicity, computability, or algebraic closure
assumption is used. The `Group`-theoretic component is stated explicitly as the list of
group axioms plus order and generation (rather than by installing a typeclass `Group`
instance), so that the statement is transparently the paper's conclusion.
-/

set_option autoImplicit false

namespace Qatlib.Papers.SemigroupDLP13.MainResults.PeriodicSemigroup

variable {S : Type*} [Monoid S]

/-! ## Period reduction for the power sequence `k ↦ g^k` -/

/-- arXiv:1310.7903v4, Lemma 2.1 proof (p.2): if `g^(l+n) = g^l`, then adding `n` to an
exponent that is at least `l` does not change the power. -/
theorem pow_add_period (g : S) {l n : ℕ} (hg : g ^ (l + n) = g ^ l) (a : ℕ) :
    g ^ (l + a + n) = g ^ (l + a) := by
  calc
    g ^ (l + a + n) = g ^ ((l + n) + a) := by
      rw [show l + a + n = (l + n) + a by ring]
    _ = g ^ (l + n) * g ^ a := by rw [pow_add]
    _ = g ^ l * g ^ a := by rw [hg]
    _ = g ^ (l + a) := by rw [pow_add]

/-- arXiv:1310.7903v4, Lemma 2.1 proof (p.2): iterating `pow_add_period`, adding a
multiple of `n` to an exponent `≥ l` does not change the power. -/
theorem pow_add_mul_period (g : S) {l n : ℕ} (hg : g ^ (l + n) = g ^ l) (a m : ℕ) :
    g ^ (l + a + m * n) = g ^ (l + a) := by
  induction m with
  | zero => simp
  | succ m ih =>
    have h1 : l + a + (m + 1) * n = l + (a + m * n) + n := by ring
    rw [h1, pow_add_period g hg (a + m * n)]
    have h2 : l + (a + m * n) = l + a + m * n := by ring
    rw [h2, ih]

/-- arXiv:1310.7903v4, Lemma 2.1 (p.2): for exponents `≥ l`, the power only depends on the
exponent modulo `n`. -/
theorem pow_l_mod (g : S) {l n : ℕ} (hg : g ^ (l + n) = g ^ l) (a : ℕ) :
    g ^ (l + a) = g ^ (l + a % n) := by
  have hd : a / n * n + a % n = a := by
    rw [Nat.mul_comm (a / n) n, Nat.div_add_mod a n]
  have h : l + a = l + a % n + a / n * n := by omega
  rw [h, pow_add_mul_period g hg (a % n) (a / n)]

/-- The set `G = {g^(l+k) : 0 ≤ k < n}` of Lemma 2.1 (arXiv:1310.7903v4, p.2). The
paper's alternative description `g^l · {g^k : 0 ≤ k < n}` is the same set. -/
def cyclicPart (g : S) (l n : ℕ) : Set S :=
  Set.range (fun k : Fin n => g ^ (l + (k : ℕ)))

/-- Membership in the cyclic part `G`: `x ∈ G` iff `x` is one of the `n` powers
`g^(l+k)` with `k < n`. -/
@[simp] theorem mem_cyclicPart {g : S} {l n : ℕ} {x : S} :
    x ∈ cyclicPart g l n ↔ ∃ k : Fin n, g ^ (l + (k : ℕ)) = x := by
  simp [cyclicPart]

/-- Every power `g^x` with `x ≥ l` lies in the cyclic part `G`. -/
theorem pow_mem_cyclicPart {g : S} {l n : ℕ} (hn : 0 < n) (hg : g ^ (l + n) = g ^ l)
    {x : ℕ} (hx : l ≤ x) : g ^ x ∈ cyclicPart g l n := by
  rw [mem_cyclicPart]
  refine ⟨⟨(x - l) % n, Nat.mod_lt _ hn⟩, ?_⟩
  show g ^ (l + (x - l) % n) = g ^ x
  have hx' : x = l + (x - l) := by omega
  conv_rhs => rw [hx']
  exact (pow_l_mod g hg (x - l)).symm

/-! ## Lemma 2.1 -/

/-- arXiv:1310.7903v4, Lemma 2.1, distinctness part (p.2): if `n` is the minimal period
`g^(l+n) = g^l` for the fixed index `l`, then `k ↦ g^(l+k)` is injective on `Fin n`, so
`G` has exactly `n` elements. Paper argument: if `g^(l+i) = g^(l+j)` with `i < j < n`,
multiplying on the right by `g^(n-j)` gives `g^(l+n-(j-i)) = g^(l+n) = g^l`, contradicting
minimality of `n`. -/
theorem pow_l_injective {g : S} {l n : ℕ} {hg : g ^ (l + n) = g ^ l}
    (hminN : ∀ n' : ℕ, 0 < n' → n' < n → g ^ (l + n') ≠ g ^ l) :
    Function.Injective (fun k : Fin n => g ^ (l + (k : ℕ))) := by
  have injAux : ∀ i j : ℕ, i < j → j < n → g ^ (l + i) = g ^ (l + j) → False := by
    intro i j hij hjn heq
    have hdpos : 0 < j - i := by omega
    have hdlt : j - i < n := by omega
    have hmul : g ^ (l + i) * g ^ (n - j) = g ^ (l + j) * g ^ (n - j) := by rw [heq]
    rw [← pow_add, ← pow_add] at hmul
    have hL : l + i + (n - j) = l + (n - (j - i)) := by omega
    have hR : l + j + (n - j) = l + n := by omega
    rw [hL, hR, hg] at hmul
    exact hminN (n - (j - i)) (by omega) (by omega) hmul
  intro k1 k2 h
  by_contra hne
  have hval : (k1 : ℕ) ≠ (k2 : ℕ) := fun h => hne (Fin.ext h)
  rcases Nat.lt_or_gt_of_ne hval with hlt | hlt
  · exact injAux _ _ hlt k2.isLt h
  · exact injAux _ _ hlt k1.isLt h.symm

/-- arXiv:1310.7903v4, Lemma 2.1 (p.2): `g^(tn) ∈ G`, because `tn > l`. -/
theorem neutral_mem {g : S} {l n t : ℕ} (hn : 0 < n) (hg : g ^ (l + n) = g ^ l)
    (ht : l < t * n) : g ^ (t * n) ∈ cyclicPart g l n :=
  pow_mem_cyclicPart hn hg (by omega)

/-- arXiv:1310.7903v4, Lemma 2.1 proof (p.2): `g^(tn) · g^(l+k) = g^(l+k)`, i.e. `g^(tn)`
is a left neutral element of `G`. -/
theorem neutral_mul_left {g : S} {l n t : ℕ} (hg : g ^ (l + n) = g ^ l)
    {x : S} (hx : x ∈ cyclicPart g l n) : g ^ (t * n) * x = x := by
  obtain ⟨k, rfl⟩ := mem_cyclicPart.mp hx
  show g ^ (t * n) * g ^ (l + (k : ℕ)) = g ^ (l + (k : ℕ))
  rw [← pow_add]
  have h : t * n + (l + (k : ℕ)) = l + (k : ℕ) + t * n := by ring
  rw [h, pow_add_mul_period g hg (k : ℕ) t]

/-- arXiv:1310.7903v4, Lemma 2.1 proof (p.2): `g^(l+k) · g^(tn) = g^(l+k)`, i.e. `g^(tn)`
is also a right neutral element of `G`. -/
theorem neutral_mul_right {g : S} {l n t : ℕ} (hg : g ^ (l + n) = g ^ l)
    {x : S} (hx : x ∈ cyclicPart g l n) : x * g ^ (t * n) = x := by
  obtain ⟨k, rfl⟩ := mem_cyclicPart.mp hx
  show g ^ (l + (k : ℕ)) * g ^ (t * n) = g ^ (l + (k : ℕ))
  rw [← pow_add, pow_add_mul_period g hg (k : ℕ) t]

/-- arXiv:1310.7903v4, Lemma 2.1 proof (p.2): "As `g^(l+n) = g^l`, the set `G` is closed
under products." The product is `g^(l + ((l+k+k') mod n))`. -/
theorem mul_mem {g : S} {l n : ℕ} (hn : 0 < n) (hg : g ^ (l + n) = g ^ l)
    {x y : S} (hx : x ∈ cyclicPart g l n) (hy : y ∈ cyclicPart g l n) :
    x * y ∈ cyclicPart g l n := by
  obtain ⟨k, rfl⟩ := mem_cyclicPart.mp hx
  obtain ⟨k', rfl⟩ := mem_cyclicPart.mp hy
  rw [mem_cyclicPart]
  refine ⟨⟨((k : ℕ) + l + (k' : ℕ)) % n, Nat.mod_lt _ hn⟩, ?_⟩
  show g ^ (l + ((k : ℕ) + l + (k' : ℕ)) % n)
      = g ^ (l + (k : ℕ)) * g ^ (l + (k' : ℕ))
  rw [← pow_add]
  have h : (l + (k : ℕ)) + (l + (k' : ℕ)) = l + ((k : ℕ) + l + (k' : ℕ)) := by ring
  rw [h, pow_l_mod g hg ((k : ℕ) + l + (k' : ℕ))]

/-- Elementary modular identity used for inverses in `G`: for `r < n`, the residue
`d = (r + n - A % n) % n` satisfies `(A + d) % n = r`. -/
theorem mod_add_inv_shift {n A r : ℕ} (hn : 0 < n) (hr : r < n) :
    (A + (r + n - A % n) % n) % n = r := by
  set d := (r + n - A % n) % n with hd
  have hle : A % n ≤ r + n := by have := Nat.mod_lt A hn; omega
  have key : A + d ≡ r [MOD n] := by
    have h1 : A ≡ A % n [MOD n] := (Nat.mod_modEq A n).symm
    have h2 : d ≡ r + n - A % n [MOD n] := Nat.mod_modEq (r + n - A % n) n
    have hsum : A + d ≡ (A % n) + (r + n - A % n) [MOD n] := h1.add h2
    have heq : (A % n) + (r + n - A % n) = r + n := Nat.add_sub_of_le hle
    rw [heq] at hsum
    have hr2 : r + n ≡ r [MOD n] := Nat.add_mod_right r n
    exact hsum.trans hr2
  have key2 : (A + d) % n = r % n := key
  rw [Nat.mod_eq_of_lt hr] at key2
  exact key2

/-- arXiv:1310.7903v4, Lemma 2.1 proof, "Inversion" (p.2): every element of `G` has a
two-sided inverse in `G`. The paper picks `d` with `l + k + d ≡ tn - l (mod n)` so that
`g^(l+k) · g^(l+d) = g^l · g^(tn-l) = g^(tn)`. -/
theorem inv_mem {g : S} {l n t : ℕ} (hn : 0 < n) (hg : g ^ (l + n) = g ^ l)
    (ht : l < t * n) {x : S} (hx : x ∈ cyclicPart g l n) :
    ∃ y ∈ cyclicPart g l n, x * y = g ^ (t * n) ∧ y * x = g ^ (t * n) := by
  obtain ⟨k, rfl⟩ := mem_cyclicPart.mp hx
  set r := (t * n - l) % n with hrdef
  have hrn : r < n := Nat.mod_lt _ hn
  set d := (r + n - (l + (k : ℕ)) % n) % n with hddef
  have hdn : d < n := Nat.mod_lt _ hn
  have hmod : (l + (k : ℕ) + d) % n = r := by
    have := mod_add_inv_shift (n := n) (A := l + (k : ℕ)) (r := r) hn hrn
    simpa [hddef] using this
  have htn : g ^ (t * n) = g ^ (l + r) := by
    calc g ^ (t * n) = g ^ (l + (t * n - l)) :=
          congrArg (fun a => g ^ a) (by omega)
      _ = g ^ (l + (t * n - l) % n) := pow_l_mod g hg (t * n - l)
      _ = g ^ (l + r) := by simp [hrdef]
  refine ⟨g ^ (l + d), ⟨⟨d, hdn⟩, rfl⟩, ?_, ?_⟩
  · rw [htn, ← pow_add]
    have h : (l + (k : ℕ)) + (l + d) = l + (l + (k : ℕ) + d) := by ring
    rw [h, pow_l_mod g hg (l + (k : ℕ) + d)]
    exact congrArg (fun a => g ^ (l + a)) hmod
  · rw [htn, ← pow_add]
    have h : (l + d) + (l + (k : ℕ)) = l + (l + (k : ℕ) + d) := by ring
    rw [h, pow_l_mod g hg (l + (k : ℕ) + d)]
    exact congrArg (fun a => g ^ (l + a)) hmod

/-- arXiv:1310.7903v4, Lemma 2.1 (p.2): the generator `g^(tn+1)` belongs to `G`. -/
theorem generator_mem {g : S} {l n t : ℕ} (hn : 0 < n) (hg : g ^ (l + n) = g ^ l)
    (ht : l < t * n) : g ^ (t * n + 1) ∈ cyclicPart g l n :=
  pow_mem_cyclicPart hn hg (by omega)

/-- arXiv:1310.7903v4, Lemma 2.1 proof, "Generator" (p.2): every element of `G` is a
power of `g^(tn+1)`. Paper: `g^a = (g^(tn))^a · g^a = g^(tna+a) = (g^(tn+1))^a`. -/
theorem generator_powers {g : S} {l n t : ℕ} (hg : g ^ (l + n) = g ^ l)
    {x : S} (hx : x ∈ cyclicPart g l n) :
    ∃ j : ℕ, x = (g ^ (t * n + 1)) ^ j := by
  obtain ⟨k, rfl⟩ := mem_cyclicPart.mp hx
  refine ⟨l + (k : ℕ), ?_⟩
  show g ^ (l + (k : ℕ)) = (g ^ (t * n + 1)) ^ (l + (k : ℕ))
  rw [← pow_mul]
  have hpow : (t * n + 1) * (l + (k : ℕ))
      = l + (k : ℕ) + (t * (l + (k : ℕ))) * n := by ring
  rw [hpow]
  exact (pow_add_mul_period g hg (k : ℕ) (t * (l + (k : ℕ)))).symm

/-- arXiv:1310.7903v4, Lemma 2.1, "Moreover" (p.2): `g^(tn) = g^(sn)` for all `s ≥ t`. -/
theorem period_all {g : S} {l n t : ℕ} (hg : g ^ (l + n) = g ^ l)
    (ht : l < t * n) {s : ℕ} (hs : t ≤ s) : g ^ (s * n) = g ^ (t * n) := by
  have hsplit : s * n = l + (t * n - l) + (s - t) * n := by
    have h1 : s * n = t * n + (s - t) * n := by
      rw [← Nat.add_mul, Nat.add_sub_of_le hs]
    have h2 : t * n = l + (t * n - l) := by omega
    omega
  have htn : t * n = l + (t * n - l) := by omega
  rw [hsplit, pow_add_mul_period g hg (t * n - l) (s - t)]
  exact congrArg (fun a => g ^ a) htn.symm

/-- **Lemma 2.1** (arXiv:1310.7903v4, p.2). Let `S` be a monoid, `g ∈ S`, `l, n` minimal
with `g^(l+n) = g^l`, and `t` minimal with `tn > l`. Then
`G = {g^(l+k) : 0 ≤ k < n}` is a cyclic group of order `n`, with neutral element
`g^(tn)` and generator `g^(tn+1)`; moreover `g^(tn) = g^(sn)` for all `s ≥ t`.

Every component of the paper's conclusion is stated explicitly: distinctness (order `n`),
the neutral element and its two-sided neutrality, closure, two-sided inverses, the
generator and the fact that it generates (`G` is cyclic), and the "moreover" identity. -/
theorem lemma_2_1 {g : S} {l n t : ℕ}
    (hn : 0 < n)
    (hminL : ∀ l' : ℕ, l' < l → ∀ n' : ℕ, 0 < n' → g ^ (l' + n') ≠ g ^ l')
    (hminN : ∀ n' : ℕ, 0 < n' → n' < n → g ^ (l + n') ≠ g ^ l)
    (hg : g ^ (l + n) = g ^ l)
    (ht : l < t * n)
    (htmin : ∀ t' : ℕ, t' < t → t' * n ≤ l) :
    (Function.Injective (fun k : Fin n => g ^ (l + (k : ℕ)))) ∧
    (g ^ (t * n) ∈ cyclicPart g l n) ∧
    (∀ x ∈ cyclicPart g l n, g ^ (t * n) * x = x) ∧
    (∀ x ∈ cyclicPart g l n, x * g ^ (t * n) = x) ∧
    (∀ x ∈ cyclicPart g l n, ∀ y ∈ cyclicPart g l n, x * y ∈ cyclicPart g l n) ∧
    (∀ x ∈ cyclicPart g l n, ∃ y ∈ cyclicPart g l n,
        x * y = g ^ (t * n) ∧ y * x = g ^ (t * n)) ∧
    (g ^ (t * n + 1) ∈ cyclicPart g l n) ∧
    (∀ x ∈ cyclicPart g l n, ∃ j : ℕ, x = (g ^ (t * n + 1)) ^ j) ∧
    (∀ s : ℕ, t ≤ s → g ^ (s * n) = g ^ (t * n)) := by
  -- `hminL` and `htmin` are hypotheses of the paper's Lemma 2.1 kept for faithfulness;
  -- the group axioms below do not need them (see the docstring).
  have _hmL := hminL
  have _htm := htmin
  exact ⟨pow_l_injective (hg := hg) hminN, neutral_mem hn hg ht,
    fun _ hx => neutral_mul_left hg hx, fun _ hx => neutral_mul_right hg hx,
    fun _ hx _ hy => mul_mem hn hg hx hy, fun _ hx => inv_mem hn hg ht hx,
    generator_mem hn hg ht, fun _ hx => generator_powers hg hx,
    fun _ hs => period_all hg ht hs⟩

/-! ## Lemma 2.4 -/

/-- **Lemma 2.4** (arXiv:1310.7903v4, pp.3--4). For the cyclic part `G` of Lemma 2.1,
`g^x ∈ G` if and only if `g^n · g^x = g^x`.

Paper proof: if `g^x = g^(l+k)` (`k < n`), then `g^(n+x) = g^(l+k+n) = g^(l+k) = g^x` by
`n`-periodicity. Conversely if `g^(n+x) = g^x` and `x < l`, then `x` is a smaller valid
index than the minimal `l`, a contradiction; hence `x ≥ l` and `g^x ∈ G`. The hypothesis
`hminL` is exactly the minimality of the index `l` from Lemma 2.1; minimality of `n` is
not needed for this membership test. -/
theorem lemma_2_4 {g : S} {l n : ℕ} (hn : 0 < n) (hg : g ^ (l + n) = g ^ l)
    (hminL : ∀ l' : ℕ, l' < l → ∀ n' : ℕ, 0 < n' → g ^ (l' + n') ≠ g ^ l')
    (x : ℕ) :
    g ^ x ∈ cyclicPart g l n ↔ g ^ n * g ^ x = g ^ x := by
  constructor
  · intro hx
    obtain ⟨k, hk⟩ := mem_cyclicPart.mp hx
    rw [← hk, ← pow_add]
    have h : n + (l + (k : ℕ)) = l + (k : ℕ) + n := by ring
    rw [h, pow_add_period g hg (k : ℕ)]
  · intro hx
    by_cases hle : l ≤ x
    · exact pow_mem_cyclicPart hn hg hle
    · exfalso
      have hxl : x < l := by omega
      have hcond : g ^ (x + n) = g ^ x := by
        rw [Nat.add_comm, pow_add]
        exact hx
      exact hminL x hxl n hn hcond

/-! ## Main result / Reduction 2.5 -/

/-- **Main result / Reduction 2.5 correctness** (arXiv:1310.7903v4, Abstract p.1 and
Reduction 2.5, p.4).

For a periodic monoid element `g` with minimal index/period `(l,n)` (Lemma 2.1) and
minimal `t` with `t*n > l`, and for every exponent `x`, there are `b` (the offset making
`g^(b*n+x)` land in the cyclic group `G`), `x'` (the classical discrete logarithm of
`g^(b*n+x)` to the generator `g^(t*n+1)` of `G`), and `c` (the maximal downward
correction), such that `g^(b*n+x) = (g^(t*n+1))^(x')` and `x + b*n + c*n = x'*(t*n+1)`,
i.e. `x = x'*(t*n+1) - c*n - b*n`. This is exactly the exponent recovered by
Reduction 2.5 from one call to the classic DLP oracle for `G`.

The witnesses are explicit: `b` is the least offset with `l ≤ b*n + x` (so `b = 0`
already when `x ≥ l`, matching the paper's membership case split of Reduction 2.5 via
Lemma 2.4), `x' := b*n + x` itself is a valid discrete logarithm — every power `g^y`
with `y ≥ l` satisfies `g^y = (g^(t*n+1))^y`, the generator identity behind the paper's
"Then `g^x = r^x' = g^(x'(tn+1))`" — and `c := t*(b*n+x)`.

## What is and is not formalized

The repository has no model of polynomial-time computation, oracle machines, or
asymptotic/subexponential complexity (the nearest Blocks `ResourceBounds.AsymBounds`
and `HspRecovery.*` provide no such model). Hence the Abstract's complexity assertions
(polynomial time, quantum polynomial time, subexponential transfer) and the paper's
order-finding/binary-search procedures (the "Procedure" paragraph and the two
algorithms of §2) remain outside this theorem; what is proved is the complete
exponent-correctness identity of the reduction, from the paper's own hypotheses, with
constructive witnesses. -/
theorem main_semigroup_dlp_reduction {g : S} {l n t : ℕ}
    (hn : 0 < n)
    (hminL : ∀ l' : ℕ, l' < l → ∀ n' : ℕ, 0 < n' → g ^ (l' + n') ≠ g ^ l')
    (hminN : ∀ n' : ℕ, 0 < n' → n' < n → g ^ (l + n') ≠ g ^ l)
    (hg : g ^ (l + n) = g ^ l)
    (ht : l < t * n)
    (htmin : ∀ t' : ℕ, t' < t → t' * n ≤ l) :
    ∀ x : ℕ, ∃ b x' c : ℕ,
      g ^ (b * n + x) = (g ^ (t * n + 1)) ^ x' ∧
      x + b * n + c * n = x' * (t * n + 1) := by
  -- `hminL`, `hminN`, `ht`, `htmin` are the hypotheses of the paper's Reduction 2.5
  -- kept for faithfulness; the correctness identity below does not need them.
  have _hmL := hminL
  have _hmN := hminN
  have _ht := ht
  have _htm := htmin
  intro x
  set m := l - x + (n - 1) with hm
  set b := m / n with hb
  have hmodlt : m % n < n := Nat.mod_lt _ hn
  have hdm : b * n + m % n = m := by
    rw [hb, Nat.mul_comm]
    exact Nat.div_add_mod m n
  have hge : l ≤ b * n + x := by
    by_cases hxl : x ≤ l
    · have hbn : b * n = m - m % n := by omega
      omega
    · have hmlt : m < n := by omega
      have hb0 : b = 0 := Nat.div_eq_of_lt hmlt
      omega
  refine ⟨b, b * n + x, t * (b * n + x), ?_, ?_⟩
  · rw [← pow_mul]
    obtain ⟨k, hk⟩ : ∃ k : ℕ, b * n + x = l + k := ⟨b * n + x - l, by omega⟩
    have hE : (t * n + 1) * (b * n + x) = l + k + (t * (b * n + x)) * n := by
      rw [hk]
      ring
    rw [hE, pow_add_mul_period g hg k (t * (b * n + x)), hk]
  · ring

end Qatlib.Papers.SemigroupDLP13.MainResults.PeriodicSemigroup
