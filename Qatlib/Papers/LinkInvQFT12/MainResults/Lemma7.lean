import Mathlib.GroupTheory.FreeGroup.Basic
import Mathlib.GroupTheory.QuotientGroup.Basic
import Mathlib.Algebra.Group.Subgroup.Ker

set_option backward.isDefEq.respectTransparency false

/-!
# LinkInvQFT12.MainResults.Lemma7 — free-group evaluation kernels (c006)

Krovi--Russell, arXiv:1210.1550 (v2 PDF, p.21–22, Lemma 7).

For a finite group `G`, `Fₖ` the free group on `x₁,…,xₖ`, `d ∈ Gᵏ` and the evaluation
homomorphism `φ_d : xᵢ ↦ dᵢ`, put `A_d = ker φ_d`.  For `c ∈ Gᵏ`, let `C`, `D` be the
subgroups generated by `c`, `d` and `A_d(c) = φ_c(A_d)`.  Lemma 7 states:

1. `A_d(c)` is normal in `C`; in particular normal in `G` when `c` generates `G`.
2. If no homomorphism `D → C` carries each `dᵢ` to `cᵢ`, then `A_d(c) ≠ 1`.

The file proves both parts.  Part 1 is proved by conjugating a word `v ∈ ker φ_d`
with a word `w` for an arbitrary `g = φ_c(w) ∈ C`, using that `ker φ_d ◁ Fₖ`; the
"in particular" clause is the `C = G` instance.  Part 2 is the paper's explicit
contrapositive: if `A_d(c) = 1` then `ker φ_d ≤ ker φ_c`, so `φ_c` factors through
the quotient `Fₖ/ker φ_d ≃ D` (Noether's first isomorphism theorem in the form
`QuotientGroup.quotientKerEquivRange`) and the resulting composite `D →* C` carries
`dᵢ ↦ cᵢ`.

Both parts below are proved in full, without any unfinished subgoal or additional
assumption beyond those in the statements.  Note that the paper writes the reduction `D → C` with
the direction "`cᵢ ↦ dᵢ`" in the statement of part 2 while its own proof (and the
diagram of Figure 6) builds `ψ : D → C` with `ψ(dᵢ) = cᵢ`; we state the latter, which
is what the proof establishes.
-/

set_option autoImplicit false
noncomputable section

namespace Qatlib.Papers.LinkInvQFT12.MainResults

variable {G : Type*} [Group G] {k : ℕ}

/-- The evaluation homomorphism `φ_d : Fₖ →* G` carrying the generator `xᵢ` to `dᵢ`
(arXiv:1210.1550, Lemma 7). -/
def evalHom (d : Fin k → G) : FreeGroup (Fin k) →* G := FreeGroup.lift d

/-- `C`, the subgroup generated by the tuple `c`, realised as the range of `φ_c`
(equal to `Subgroup.closure (Set.range c)`). -/
def genSub (c : Fin k → G) : Subgroup G := (evalHom c).range

/-- `A_d = ker φ_d ≤ Fₖ` (arXiv:1210.1550, Lemma 7). -/
def AdSub (d : Fin k → G) : Subgroup (FreeGroup (Fin k)) := (evalHom d).ker

/-- `A_d(c) = φ_c(A_d) ≤ G` (arXiv:1210.1550, Lemma 7). -/
def AdcSub (c d : Fin k → G) : Subgroup G := (AdSub d).map (evalHom c)

/-- The element `cᵢ` as an element of the subgroup `C = genSub c`. -/
def genElem (c : Fin k → G) (i : Fin k) : genSub c :=
  ⟨c i, ⟨FreeGroup.of i, by simp [evalHom]⟩⟩

/-- **Lemma 7, part 1** (arXiv:1210.1550, p.21).  `A_d(c)` is normal in `C`: for every
`g ∈ C` and `x ∈ A_d(c)`, the conjugate `g x g⁻¹` lies again in `A_d(c)`. -/
theorem lemma7_part1_normal_in_closure (c d : Fin k → G) :
    ∀ g ∈ genSub c, ∀ x ∈ AdcSub c d, g * x * g⁻¹ ∈ AdcSub c d := by
  intro g hg x hx
  -- `g ∈ C = range φ_c`, so `g = φ_c w`.
  rw [genSub] at hg
  obtain ⟨w, hw⟩ := hg
  -- `x ∈ φ_c(A_d)`, so `x = φ_c v` with `v ∈ ker φ_d`.
  rw [AdcSub, Subgroup.mem_map] at hx
  obtain ⟨v, hv, rfl⟩ := hx
  rw [← hw]
  -- conjugate by `φ_c w`; the witness is `w v w⁻¹`, and `ker φ_d ◁ Fₖ`.
  rw [AdcSub, Subgroup.mem_map]
  refine ⟨w * v * w⁻¹, ?_, ?_⟩
  · rw [AdSub, MonoidHom.mem_ker] at hv ⊢
    rw [map_mul, map_mul, map_inv, hv]
    simp
  · rw [map_mul, map_mul, map_inv]

/-- **Lemma 7, part 1, "in particular" clause** (arXiv:1210.1550, p.21).  If the `cᵢ`
generate `G` (i.e. `C = G`), then `A_d(c)` is normal in `G`. -/
theorem lemma7_part1_normal_of_gen (c d : Fin k → G) (hgen : genSub c = ⊤) :
    (AdcSub c d).Normal := by
  refine ⟨fun x hx g => ?_⟩
  exact lemma7_part1_normal_in_closure c d g (by rw [hgen]; exact Subgroup.mem_top g) x hx

/-- **Lemma 7, part 2** (arXiv:1210.1550, p.21).  If no homomorphism `ψ : D → C` sends
each `dᵢ` to `cᵢ`, then `A_d(c) ≠ 1`.

The proof is the paper's contrapositive: `A_d(c) = 1` forces `ker φ_d ≤ ker φ_c`;
`φ_c` then descends to `Fₖ/ker φ_d`, which is isomorphic to `D = range φ_d` by
Noether's first isomorphism theorem, producing `ψ` with `ψ(dᵢ) = cᵢ`. -/
theorem lemma7_part2_nontrivial (c d : Fin k → G)
    (h : ¬ ∃ ψ : genSub d →* genSub c,
        ∀ i : Fin k, ψ (genElem d i) = genElem c i) :
    AdcSub c d ≠ ⊥ := by
  intro hbot
  apply h
  -- From `A_d(c) = 1`, get `ker φ_d ≤ ker φ_c`.
  have hle : AdSub d ≤ (evalHom c).ker :=
    (Subgroup.map_eq_bot_iff (AdSub d)).mp hbot
  let φd := evalHom d
  let φc := evalHom c
  -- Restrict `φ_c` to `C = range φ_c`.
  let φc' : FreeGroup (Fin k) →* genSub c :=
    φc.codRestrict (genSub c) (fun w => ⟨w, rfl⟩)
  have hkerc' : AdSub d ≤ φc'.ker := by
    intro v hv
    have hcv : evalHom c v = 1 := MonoidHom.mem_ker.mp (hle hv)
    rw [MonoidHom.mem_ker]
    apply Subtype.ext
    simpa [φc', φc] using hcv
  haveI hN : (AdSub d).Normal := MonoidHom.normal_ker (evalHom d)
  -- `q : Fₖ/ker φ_d →* C` induced by `φ_c`.
  let q : FreeGroup (Fin k) ⧸ AdSub d →* genSub c :=
    QuotientGroup.lift (AdSub d) φc' hkerc'
  -- Noether's first isomorphism theorem: `D ≃ Fₖ/ker φ_d`.
  let e : genSub d ≃* (FreeGroup (Fin k) ⧸ AdSub d) :=
    (QuotientGroup.quotientKerEquivRange φd).symm
  -- The composite `ψ : D → C`.
  let ψ : genSub d →* genSub c := q.comp e.toMonoidHom
  refine ⟨ψ, ?_⟩
  intro i
  -- Evaluate `e` on the generator `dᵢ`.
  have hΦ : (QuotientGroup.quotientKerEquivRange φd)
        (QuotientGroup.mk (FreeGroup.of i)) = genElem d i := by
    show (QuotientGroup.rangeKerLift φd) (QuotientGroup.mk (FreeGroup.of i)) = genElem d i
    rw [QuotientGroup.rangeKerLift, QuotientGroup.lift_mk]
    apply Subtype.ext
    rw [MonoidHom.coe_rangeRestrict]
    exact FreeGroup.lift_apply_of
  have he : e (genElem d i) = QuotientGroup.mk (FreeGroup.of i) := by
    change (QuotientGroup.quotientKerEquivRange φd).symm (genElem d i)
        = QuotientGroup.mk (FreeGroup.of i)
    have h := congrArg (QuotientGroup.quotientKerEquivRange φd).symm hΦ
    rw [MulEquiv.symm_apply_apply] at h
    exact h.symm
  -- `ψ(dᵢ) = q(mk xᵢ) = φ_c'(xᵢ) = cᵢ`.
  show ψ (genElem d i) = genElem c i
  show q (e (genElem d i)) = genElem c i
  rw [he]
  show QuotientGroup.lift (AdSub d) φc' hkerc' (QuotientGroup.mk (FreeGroup.of i)) = genElem c i
  rw [QuotientGroup.lift_mk]
  apply Subtype.ext
  show (evalHom c) (FreeGroup.of i) = c i
  exact FreeGroup.lift_apply_of

end Qatlib.Papers.LinkInvQFT12.MainResults
