import Qatlib.Papers.PottsTutte07.MainResults.Definitions
import Qatlib.Papers.PottsTutte07.MainResults.Scales

/-!
# Weight types and approximation predicates

The module defines the unitary, complex nonunitary, and real nonunitary weight conditions used
in the Tutte approximation statements. It also introduces the instance record `TutteInstance`,
entrywise distance, density in a target matrix set, generated matrix words, and the numerical
bound `polyLogBound` [AharonovEtAl2007].

## Main statements

* `IsUnitaryType`: Specifies norm and partner-weight conditions on odd and even weights.
* `DenseIn`: Expresses approximation of each target in entrywise distance.
* `polyLogBound`: A natural-number bound built from the logarithm of reciprocal accuracy.

## References

* [Aharonov et al., 2007][AharonovEtAl2007]
-/

set_option autoImplicit false
noncomputable section

namespace Qatlib.Papers.PottsTutte07.MainResults

open scoped BigOperators

/-- The condition that both weight sets are nonempty, obey the specified unitary norm relations,
and contain partners satisfying the odd and even inverse relations. -/
def IsUnitaryType (q : ℂ) (Wodd Weven : Set ℂ) : Prop :=
  Wodd.Nonempty ∧ Weven.Nonempty ∧
  (∀ v ∈ Wodd, ‖v + q‖ = ‖v‖) ∧
  (∀ v ∈ Weven, ‖1 + v‖ = 1) ∧
  (∀ v ∈ Wodd, ∃ w ∈ Wodd, w + v + q = 0) ∧
  (∀ v ∈ Weven, ∃ w ∈ Weven, w + v + w * v = 0)

/-- The condition that the weight data fail `IsUnitaryType` and some weight or `q` has nonzero
imaginary part. -/
def IsComplexNonUnitaryType (q : ℂ) (Wodd Weven : Set ℂ) : Prop :=
  ¬ IsUnitaryType q Wodd Weven ∧
  ((∃ v ∈ Wodd, v.im ≠ 0) ∨ (∃ v ∈ Weven, v.im ≠ 0) ∨ q.im ≠ 0)

/-- The condition that the weight data fail `IsUnitaryType`, all weights and `q` are real, and
`q.re` exceeds `4 * cos (π / 5)^2`. -/
def IsRealNonUnitaryType (q : ℂ) (Wodd Weven : Set ℂ) : Prop :=
  ¬ IsUnitaryType q Wodd Weven ∧
  q.im = 0 ∧ 4 * Real.cos (Real.pi / 5) ^ 2 < q.re ∧
  (∀ v ∈ Wodd, v.im = 0) ∧ (∀ v ∈ Weven, v.im = 0)

/-- A record of vertex and edge counts, complex Potts parameters, designated odd edges, a target
value, and a real approximation window. -/
structure TutteInstance where
  numV : ℕ
  numE : ℕ
  q : ℂ
  weights : Fin numE → ℂ
  Eodd : Finset (Fin numE)
  target : ℂ
  window : ℝ

/-- The sum of the norms of all corresponding entry differences between two matrices. -/
def entryDist {n : Type*} [Fintype n] (A B : Matrix n n ℂ) : ℝ :=
  ∑ i : n, ∑ j : n, ‖A i j - B i j‖

/-- The condition that every target matrix can be approximated arbitrarily closely in
`entryDist` by a matrix in the generating set. -/
def DenseIn {n : Type*} [Fintype n] (target gen : Set (Matrix n n ℂ)) : Prop :=
  ∀ U ∈ target, ∀ ε : ℝ, 0 < ε → ∃ g ∈ gen, entryDist g U < ε

/-- The set of unitary complex matrices of size `K` with determinant one. -/
def SpecialUnitarySet (K : ℕ) [NeZero K] : Set (Matrix (Fin K) (Fin K) ℂ) :=
  {U | IsUnitary U ∧ Matrix.det U = 1}

/-- The set of complex matrices of size `K` with determinant one. -/
def SpecialLinearSet (K : ℕ) [NeZero K] : Set (Matrix (Fin K) (Fin K) ℂ) :=
  {U | Matrix.det U = 1}

/-- The set of complex matrices of size `K` whose entries are real and whose determinant is one. -/
def SpecialLinearRealSet (K : ℕ) [NeZero K] : Set (Matrix (Fin K) (Fin K) ℂ) :=
  {U | (∀ i j, (U i j).im = 0) ∧ Matrix.det U = 1}

/-- The set underlying the multiplicative submonoid generated by the specified matrices. -/
def generatedBy {K : ℕ} (gens : Set (Matrix (Fin K) (Fin K) ℂ)) : Set (Matrix (Fin K) (Fin K) ℂ) :=
  (Submonoid.closure gens : Set (Matrix (Fin K) (Fin K) ℂ))

/-- The ordered product of a finite list of matrices. -/
def wordEval {K : ℕ} (word : List (Matrix (Fin K) (Fin K) ℂ)) : Matrix (Fin K) (Fin K) ℂ :=
  word.prod

/-- The natural-number bound `ceil (log (1 / δ)) ^ 2 + 1`. -/
def polyLogBound (δ : ℝ) : ℕ :=
  Nat.ceil (Real.log (1 / δ)) ^ 2 + 1

end Qatlib.Papers.PottsTutte07.MainResults
