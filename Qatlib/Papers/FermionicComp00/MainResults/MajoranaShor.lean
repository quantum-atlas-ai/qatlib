import Qatlib.Foundations.PureStateMath.Qubit

/-!
# Pauli labels and Majorana Shor stabilizers

The module defines Pauli labels, their matrices, weights, and multiplication with scalar phases
omitted. It builds a formal stabilizer-product predicate and a distance quantity using
`sourceWordCommute`, then specifies the words in `sourceShorStabilizers`. The word relation is
defined coordinatewise using the phase-omitting label multiplication.

These constructions belong to the formalization of [BravyiKitaev2002].

## Main statements

* `sourceCodeDistance`: the infimum of weights satisfying the specified logical-word predicate.
* `sourceShorStabilizers`: the finite family of the prescribed X/Z strings and adjacent Y pairs.

## References

* [Bravyi and Kitaev, 2002][BravyiKitaev2002]
-/

set_option autoImplicit false
noncomputable section

open Matrix
open Qatlib.Foundations.PureStateMath
open scoped Classical BigOperators

namespace Qatlib.Papers.FermionicComp00.MainResults.MajoranaShor

/-- The four single-qubit Pauli labels: identity, X, Y, and Z. -/
inductive sourcePauli : Type
  | I : sourcePauli
  | X : sourcePauli
  | Y : sourcePauli
  | Z : sourcePauli
deriving DecidableEq, Repr

/-- The computational-basis matrix entry of a Pauli label. -/
def sourcePauliEntry : sourcePauli → Bool → Bool → ℂ
  | .I, y, x => if y = x then 1 else 0
  | .X, y, x => if y = !x then 1 else 0
  | .Y, y, x => if y = !x then (if x then -Complex.I else Complex.I) else 0
  | .Z, y, x => if y = x then (if x then -1 else 1) else 0

/-- The tensor-product Pauli-word matrix, with entries given by products of single-qubit
entries. -/
def sourcePauliWordMat {n : ℕ} (w : Fin n → sourcePauli) : Matrix (Reg n) (Reg n) ℂ :=
  Matrix.of fun y x => ∏ i, sourcePauliEntry (w i) (y i) (x i)

/-- The number of positions in a Pauli word with a nonidentity label. -/
def sourcePauliWeight {n : ℕ} (w : Fin n → sourcePauli) : ℕ :=
  (Finset.univ.filter (fun i => w i ≠ sourcePauli.I)).card

/-- The all-identity Pauli word has weight zero. -/
theorem sourcePauliWeight_identity (n : ℕ) :
    sourcePauliWeight (fun _ : Fin n => sourcePauli.I) = 0 := by
  simp [sourcePauliWeight]

/-- Multiplication of Pauli labels with scalar phases omitted. -/
def sourcePauliMul : sourcePauli → sourcePauli → sourcePauli
  | .I, q => q
  | p, .I => p
  | .X, .X => .I
  | .Y, .Y => .I
  | .Z, .Z => .I
  | .X, .Y => .Z
  | .Y, .X => .Z
  | .X, .Z => .Y
  | .Z, .X => .Y
  | .Y, .Z => .X
  | .Z, .Y => .X

/-- Equality of the two multiplication orders under the phase-omitting Pauli-label
multiplication. -/
def sourcePauliCommute (p q : sourcePauli) : Prop :=
  sourcePauliMul p q = sourcePauliMul q p

/-- Coordinatewise multiplication of Pauli words using `sourcePauliMul`. -/
def sourceWordMul {n : ℕ} (w v : Fin n → sourcePauli) : Fin n → sourcePauli :=
  fun i => sourcePauliMul (w i) (v i)

/-- The coordinatewise relation requiring `sourcePauliCommute` at every position. -/
def sourceWordCommute {n : ℕ} (w v : Fin n → sourcePauli) : Prop :=
  ∀ i, sourcePauliCommute (w i) (v i)

/-- Pauli words generated from the identity word by multiplication with members of `S`, with
scalar phases omitted. -/
inductive sourceStabilizerProduct {n : ℕ} (S : Finset (Fin n → sourcePauli)) :
    (Fin n → sourcePauli) → Prop
  | nil : sourceStabilizerProduct S (fun _ => sourcePauli.I)
  | step {s : Fin n → sourcePauli} (hs : s ∈ S) {w : Fin n → sourcePauli}
      (hw : sourceStabilizerProduct S w) :
      sourceStabilizerProduct S (sourceWordMul s w)

/-- The infimum of weights of words related by `sourceWordCommute` to every member of `S` but
not generated by `sourceStabilizerProduct S`. -/
def sourceCodeDistance (n : ℕ) (S : Finset (Fin n → sourcePauli)) : ℕ :=
  sInf {w : ℕ | ∃ L : Fin n → sourcePauli,
    (∀ s ∈ S, sourceWordCommute L s) ∧ ¬ sourceStabilizerProduct S L ∧
      sourcePauliWeight L = w}

/-- The word with X at indices `k * l` and `(k + 2) * l - 1`, Z strictly between them, and
identity elsewhere. -/
def sourceZWord (l k : ℕ) : Fin (l * l) → sourcePauli :=
  fun s =>
    if s.val = k * l ∨ s.val = (k + 2) * l - 1 then .X
    else if k * l < s.val ∧ s.val < (k + 2) * l - 1 then .Z
    else .I

/-- The word with Y at the adjacent indices `k * l + j` and `k * l + j + 1`, and identity
elsewhere. -/
def sourceYWord (l k j : ℕ) : Fin (l * l) → sourcePauli :=
  fun s => if s.val = k * l + j ∨ s.val = k * l + j + 1 then .Y else .I

/-- The union of the specified `sourceZWord` strings and adjacent `sourceYWord` pairs on `l * l`
positions. -/
def sourceShorStabilizers (l : ℕ) : Finset (Fin (l * l) → sourcePauli) :=
  ((Finset.range (l - 1)).image (fun k => sourceZWord l k)) ∪
    (((Finset.range l).product (Finset.range (l - 1))).image
      (fun p => sourceYWord l p.1 p.2))

end Qatlib.Papers.FermionicComp00.MainResults.MajoranaShor
