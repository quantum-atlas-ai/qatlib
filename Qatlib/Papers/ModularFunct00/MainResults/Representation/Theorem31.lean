import Qatlib.Papers.ModularFunct00.MainResults.Setup
import Qatlib.Papers.ModularFunct00.MainResults.Examples

/-!
# Explicit spectral components of Theorem 3.1

This module packages spectrum, characteristic-polynomial, multiplicity, and braid-relation
calculations for the explicit Jones matrix examples associated with Theorem 3.1 of
[FreedmanLarsenWang2000]. The statements concern the given two-, five-, and eight-dimensional
matrices.

`GenInfiniteModCenter` separately names the property that the subgroup generated by two unitary
matrices has infinite quotient by its center.

## Main statements

* `theorem3_1_iii_two_by_two`: The explicit second two-dimensional generator has spectrum `{-1,
  q}`.
* `theorem3_1_iv_multiplicities`: The eight-dimensional example has root multiplicities three
  and five.
* `theorem3_1_two_by_two_braid_relation`: The two-dimensional pair satisfies the braid relation.

## References

* [Freedman et al., 2000][FreedmanLarsenWang2000]
-/

set_option autoImplicit false
noncomputable section

namespace Qatlib.Papers.ModularFunct00.MainResults.Representation

open Matrix Polynomial
open Qatlib.Papers.ModularFunct00.MainResults.Examples

/-- The subgroup generated by two unitary matrices has an infinite quotient by its own center. -/
def GenInfiniteModCenter {d : ℕ} (A B : ↥(unitaryGroup (Fin d) ℂ)) : Prop :=
  Infinite (↥(Subgroup.closure ({A, B} : Set ↥(unitaryGroup (Fin d) ℂ))) ⧸
    Subgroup.center ↥(Subgroup.closure ({A, B} : Set ↥(unitaryGroup (Fin d) ℂ))))

/-- Under the stated fifth-root and parameter hypotheses, the second two-dimensional generator
has spectrum `{-1, q}`; see [FreedmanLarsenWang2000]. -/
theorem theorem3_1_iii_two_by_two {q : ℂ} (s : ℂ) (hq5 : q ^ 5 = 1) (hq1 : q ≠ 1)
    (hs : s ^ 2 * q = q ^ 2 + q + 1) :
    spectrum ℂ (sig2_21 (q := q) s) = {(-1 : ℂ), q} :=
  spectrum_sig2_21 s hq5 hq1 hs

/-- The explicit five-dimensional diagonal generator has spectrum `{-1, q}`; see
[FreedmanLarsenWang2000]. -/
theorem theorem3_1_iii_five_by_five {q : ℂ} :
    spectrum ℂ (sig1_33 (q := q)) = {(-1 : ℂ), q} :=
  spectrum_sig1_33

/-- The explicit eight-dimensional diagonal generator has spectrum `{-1, q}`; see
[FreedmanLarsenWang2000]. -/
theorem theorem3_1_iii_eight_by_eight {q : ℂ} :
    spectrum ℂ (sig1_42 (q := q)) = {(-1 : ℂ), q} :=
  spectrum_sig1_42

/-- For `q^5 = 1`, the eight-dimensional generator's characteristic polynomial has root
multiplicities three at `-1` and five at `q`; see [FreedmanLarsenWang2000]. -/
theorem theorem3_1_iv_multiplicities {q : ℂ} (hq5 : q ^ 5 = 1) :
    rootMultiplicity (-1) (sig1_42 (q := q)).charpoly = 3 ∧
      rootMultiplicity q (sig1_42 (q := q)).charpoly = 5 :=
  multiplicity_sig1_42 hq5

/-- The eight-dimensional generator has characteristic polynomial `(X + 1)^3 * (X - C q)^5`; see
[FreedmanLarsenWang2000]. -/
theorem theorem3_1_iv_charpoly {q : ℂ} :
    (sig1_42 (q := q)).charpoly = (X - C (-1)) ^ 3 * (X - C q) ^ 5 :=
  charpoly_sig1_42

/-- Under the fifth-root and parameter equations, the explicit two-dimensional generators
satisfy the three-factor braid relation; see [FreedmanLarsenWang2000]. -/
theorem theorem3_1_two_by_two_braid_relation {q : ℂ} (s : ℂ) (hq5 : q ^ 5 = 1)
    (hs : s ^ 2 * q = q ^ 2 + q + 1) :
    sig1_21 (q := q) * sig2_21 (q := q) s * sig1_21 (q := q) =
      sig2_21 (q := q) s * sig1_21 (q := q) * sig2_21 (q := q) s :=
  braid_21 s hq5 hs

end Qatlib.Papers.ModularFunct00.MainResults.Representation
