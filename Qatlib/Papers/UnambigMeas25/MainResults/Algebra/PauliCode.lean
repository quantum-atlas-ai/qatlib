import Qatlib.Papers.UnambigMeas25.MainResults.Definitions.UnambigMeasModel

set_option backward.isDefEq.respectTransparency false

/-!
# Pauli relations and code character sums — Section 2

Paper: Buzet–Chailloux, *Fine-Grained Unambiguous Measurements*,
arXiv:2510.07298v2 (4 Nov 2025).

This file states Proposition 5 (p. 10) and Proposition 6 (p. 10).
-/

set_option autoImplicit false
noncomputable section

namespace Qatlib.Papers.UnambigMeas25.MainResults.Algebra

open Matrix BigOperators
open scoped Classical MatrixOrder ComplexOrder BigOperators

/-- **Proposition 5** (arXiv:2510.07298v2, p. 10).  For all `x, b ∈ 𝔽₂ⁿ`:
(i) the Fourier basis vector `|b̂⟩` is an eigenstate of `X_x` with eigenvalue
`(−1)^{x·b}`; (ii) `X_b · H^{⊗n} = H^{⊗n} · Z_b`; (iii) `H^{⊗n} · X_b = Z_b · H^{⊗n}`.

Source: Proposition 5, p. 10, Equations (5) and (6).  Proof: `X_b` acts as the
translation `|y⟩ ↦ |y+b⟩`, `Z_b` as the diagonal character `|y⟩ ↦ (−1)^{b·y}|y⟩`,
and the Hadamard matrix intertwines them; (i) is the same intertwining applied
to `|0⟩` (or a direct computation with the character). -/
def proposition5 {n : ℕ} (x b : F2 n) : Prop :=
  (Xop x).mulVec (fourierBasis b) = chi x b • fourierBasis b ∧
      Xop b * Hadamard n = Hadamard n * Zop b ∧
      Hadamard n * Xop b = Zop b * Hadamard n
  -- Paper: arXiv:2510.07298v2, Proposition 5, p. 10, Equations (5)–(6).
  -- Key steps: `((Xop x).mulVec (fourierBasis b)) i = fourierBasis b (i + x) =
  -- (sqrtTwoPow n)⁻¹ χ b (i+x) = χ b x · fourierBasis b i` using additivity of
  -- the bilinear form `f2dot`; the two matrix identities are checked entrywise:
  -- `(Xop b * Hadamard n) i j = (sqrtTwoPow n)⁻¹ χ b (i+j)` and
  -- `(Hadamard n * Zop b) i j = (sqrtTwoPow n)⁻¹ χ b i χ b j`, which agree since
  -- `χ b (i+j) = χ b i χ b j` and `χ b j = χ j b`.
  -- Gap: multiplicativity of `chi` (`char_mul`) and `f2dot` bilinearity, plus
  -- `f2dot` symmetry.
  -- Suggested tactic: prove `chi_add : chi a (x + y) = chi a x * chi a y` and
  -- `f2dot_comm`, then `ext i j` and `simp [Xop, Zop, Hadamard, chi,
  -- fourierBasis, mul_apply, Finset.sum_mul]`; handle `if` branches with `by_cases`.
  -- Candidate dependencies: `Finset.sum_add_distrib`, `Finset.sum_mul`.

/-- The dual code of the code generated by `Gᵀ`, as a predicate. -/
def InDualCode {n k : ℕ} (G : MatZ k n) (v : F2 n) : Prop :=
  ∀ s : Fin k → ZMod 2, f2dot v (transposeVec G s) = 0

/-- **Proposition 6** (arXiv:2510.07298v2, p. 10).  For the linear code
`C = {Gᵀ s}`, `∑_{c∈C} (−1)^{v·c}` equals `|C| = 2^k` if `v ∈ C^⊥`, and `0`
otherwise.

The hypothesis `v ∈ C^⊥` is written as `InDualCode G v`, i.e.
`∀ s, v · (Gᵀ s) = 0`.  When `G` has rank `k` this is exactly `v ∈ C^⊥`. -/
def proposition6 {n k : ℕ} (G : MatZ k n) (v : F2 n) : Prop :=
  (∑ s : Fin k → ZMod 2, chi v (transposeVec G s)) =
      if InDualCode G v then (2 : ℂ) ^ k else 0
  -- Paper: arXiv:2510.07298v2, Proposition 6, p. 10.
  -- Key steps: write `v · Gᵀ s = ∑_i w_i s_i` with `w_i = ∑_j G i j v_j`;
  -- then `∑_{s∈F₂^k} (−1)^{∑ w_i s_i} = ∏_i (∑_{t∈F₂} (−1)^{w_i t})`, which is
  -- `2^k` if all `w_i = 0` and `0` otherwise.
  -- Gap: the product decomposition of a character sum over a finite product
  -- type (`Finset.sum_prod`/`Fintype.prod_sum`), and the inner sum
  -- `∑ t : ZMod 2, (-1 : ℂ)^... = 2` or `0`.
  -- Suggested tactic: `rw [Finset.sum_comm]`; rewrite the summand as a product
  -- `∏ i, chi (w i) (fun _ => s i)`; use `Fintype.sum_prod_type`; then
  -- `simp [chi, f2dot]` and `split_ifs`.
  -- Candidate dependencies: `Finset.prod_univ_sum`, `Fintype.sum_prod_type`,
  -- `ZMod` character orthogonality.

end Qatlib.Papers.UnambigMeas25.MainResults.Algebra
