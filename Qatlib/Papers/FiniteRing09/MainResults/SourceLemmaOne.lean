import Mathlib.RingTheory.Ideal.Defs
import Mathlib.RingTheory.Ideal.Operations
import Mathlib.Algebra.Ring.Subring.Basic
import Mathlib.Algebra.Group.Subgroup.Lattice
import Mathlib.Algebra.Module.Submodule.Lattice

set_option backward.isDefEq.respectTransparency false

/-!
# FiniteRing09 — Lemma 1 (left ideals generated by a subset of themselves)

Source: Wocjan, Jordan, Ahmadi, Brennan, *Efficient quantum processing of ideals in finite
rings*, fixed arXiv:0908.0022v2 (5 Jul 2023), Lemma 1 on pp. 2--3.

Lemma 1. Let `I` be a left ideal generated by `{i₁, …, i_m}` in a finite ring `R`. Let `B̃_k ⊆ I`
be a subset of `I` containing `{i₁, …, i_m}`. The set of ring elements `B_k` additively
generated by `B̃_k` is equal to `I` if and only if `r * b ∈ B_k` for all `r ∈ R` and all
`b ∈ B̃_k`. In the algorithm only `r ∈ R̃` is tested, where `R̃` generates `R` as a ring, and the
paper's proof extends from `R̃` to `R`; both forms are proved below
(`source_lemma_one` for the literal `∀ r : R` statement, `source_lemma_one_generators` for the
computationally checkable `∀ r ∈ R̃` form).

Boundary: the paper states the lemma for finite rings; the formal proofs below do not use
finiteness, so they are stated for an arbitrary (not necessarily commutative) ring `R`. The
left ideal generated by `gen` is Mathlib's `Submodule.span R gen` (Mathlib's `Ideal R` is
`Submodule R R`, i.e. a left ideal over a possibly noncommutative ring). `B_k` is
`AddSubgroup.closure base`.
-/

set_option autoImplicit false

namespace Qatlib.Papers.FiniteRing09.MainResults.SourceLemmaOne

variable {R : Type*} [Ring R]

/-- **FiniteRing09, Lemma 1 (literal `∀ r : R` form), pp. 2--3.**

Let `I` be the left ideal generated by `gen` (so `I = Submodule.span R gen`), let `base` be a
subset of `I` containing `gen`, and let `B` be the additive subgroup generated by `base`. Then
`B = I` if and only if `r * b ∈ B` for every ring element `r` and every `b ∈ base`.

This is the statement read off the paper's Lemma 1 with `B_k = B` and `B̃_k = base`. The proof
follows the paper: `(⇐)` the closure conditions make `B` a left ideal containing `gen`, so the
left ideal generated by `gen` is contained in `B`, while `B ⊆ I` since `base ⊆ I` and `I` is a
left ideal; `(⇒)` immediate because `I` is a left ideal. -/
theorem source_lemma_one
    (gen base : Set R) (I : Ideal R)
    (hI : I = Submodule.span R gen)
    (hgen_sub : gen ⊆ base) (hbase_sub : base ⊆ (I : Set R)) :
    (AddSubgroup.closure base : Set R) = (I : Set R) ↔
      ∀ r : R, ∀ b ∈ base, r * b ∈ AddSubgroup.closure base := by
  constructor
  · intro hEq r b hb
    have hbI : b ∈ I := hbase_sub hb
    have hrb : r * b ∈ I := Ideal.mul_mem_left I r hbI
    have hrb' : r * b ∈ (I : Set R) := hrb
    rw [← hEq] at hrb'
    exact hrb'
  · intro hclos
    -- `B`, the additive closure of `base`, viewed as a left ideal.
    let B : Ideal R :=
      { carrier := (AddSubgroup.closure base : Set R)
        zero_mem' := AddSubgroup.zero_mem _
        add_mem' := fun hx hy => AddSubgroup.add_mem _ hx hy
        smul_mem' := fun r x hx => by
          refine AddSubgroup.closure_induction
            (p := fun y (_ : y ∈ AddSubgroup.closure base) =>
              r * y ∈ AddSubgroup.closure base) ?_ ?_ ?_ ?_ hx
          · intro y hy
            exact hclos r y hy
          · simpa using AddSubgroup.zero_mem (AddSubgroup.closure base)
          · intro u v _ _ hu hv
            rw [mul_add]
            exact AddSubgroup.add_mem _ hu hv
          · intro u _ hu
            rw [mul_neg]
            exact AddSubgroup.neg_mem _ hu }
    have hbaseB : base ⊆ (B : Set R) := fun b hb => AddSubgroup.subset_closure hb
    have hgenB : gen ⊆ (B : Set R) := fun x hx => hbaseB (hgen_sub hx)
    have hspan_le : Submodule.span R gen ≤ B := Submodule.span_le.mpr hgenB
    have hI_le : I ≤ B := by
      rw [hI]
      exact hspan_le
    have hB_le : B ≤ I := by
      intro x hx
      exact (AddSubgroup.closure_le (K := I.toAddSubgroup)).mpr hbase_sub hx
    ext x
    exact ⟨fun hx => hB_le hx, fun hx => hI_le hx⟩

/-- **FiniteRing09, Lemma 1 (computationally checkable `∀ r ∈ R̃` form), pp. 2--3.**

Same statement as `source_lemma_one`, but the left-multiplication invariance is only required on
a set `gen` that generates `R` as a ring (`Subring.closure gen = ⊤`). This is exactly the test
performed by the paper's algorithm: it checks `r * b ∈ B_k` for `r ∈ R̃` and `b ∈ B̃_k`, and the
paper's proof extends this from `R̃` to all of `R` because `R̃` generates `R`. -/
theorem source_lemma_one_generators
    (gen base : Set R) (I : Ideal R)
    (hI : I = Submodule.span R gen)
    (hgen_sub : gen ⊆ base) (hbase_sub : base ⊆ (I : Set R))
    (hspan_top : Subring.closure gen = ⊤) :
    (AddSubgroup.closure base : Set R) = (I : Set R) ↔
      ∀ r ∈ gen, ∀ b ∈ base, r * b ∈ AddSubgroup.closure base := by
  constructor
  · intro hEq r _ b hb
    have hbI : b ∈ I := hbase_sub hb
    have hrb : r * b ∈ I := Ideal.mul_mem_left I r hbI
    have hrb' : r * b ∈ (I : Set R) := hrb
    rw [← hEq] at hrb'
    exact hrb'
  · intro hclos
    -- Extend `∀ r ∈ gen` to all `r ∈ Subring.closure gen = ⊤` by subring induction,
    -- and simultaneously from `base` to the additive closure `B = closure base`.
    have hall : ∀ r ∈ Subring.closure gen,
        ∀ b ∈ AddSubgroup.closure base, r * b ∈ AddSubgroup.closure base := by
      intro r hr
      refine Subring.closure_induction
        (p := fun x (_ : x ∈ Subring.closure gen) =>
          ∀ b ∈ AddSubgroup.closure base, x * b ∈ AddSubgroup.closure base)
        ?_ ?_ ?_ ?_ ?_ ?_ hr
      · -- `r ∈ gen`: extend `r * b ∈ B` from `base` to the additive closure.
        intro x hx b hb
        refine AddSubgroup.closure_induction
          (p := fun y (_ : y ∈ AddSubgroup.closure base) =>
            x * y ∈ AddSubgroup.closure base) ?_ ?_ ?_ ?_ hb
        · intro y hy
          exact hclos x hx y hy
        · simp
        · intro u v _ _ hu hv
          rw [mul_add]
          exact AddSubgroup.add_mem _ hu hv
        · intro u _ hu
          rw [mul_neg]
          exact AddSubgroup.neg_mem _ hu
      · -- zero
        intro b _
        simp
      · -- one
        intro b hb
        simpa using hb
      · -- addition
        intro x y _ _ hx hy b hb
        rw [add_mul]
        exact AddSubgroup.add_mem _ (hx b hb) (hy b hb)
      · -- negation
        intro x _ hx b hb
        rw [neg_mul]
        exact AddSubgroup.neg_mem _ (hx b hb)
      · -- multiplication
        intro x y _ _ hx hy b hb
        rw [mul_assoc]
        exact hx (y * b) (hy b hb)
    apply (source_lemma_one gen base I hI hgen_sub hbase_sub).mpr
    intro r b hb
    exact hall r (by rw [hspan_top]; trivial) b (AddSubgroup.subset_closure hb)

end Qatlib.Papers.FiniteRing09.MainResults.SourceLemmaOne
