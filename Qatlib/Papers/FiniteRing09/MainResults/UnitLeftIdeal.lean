module

public import Qatlib.Papers.FiniteRing09.MainResults.IdealProblems

@[expose] public section

/-!
# The principal left ideal test for units

Section 4 characterizes a unit by whether its principal left ideal
contains the entire ring. Containment of one gives a left inverse,
and finiteness upgrades the left inverse to a unit.
-/

set_option autoImplicit false

open Qatlib.Papers.FiniteRing09.MainResults.IdealProblems

namespace Qatlib.Papers.FiniteRing09.MainResults

/-- In a finite ring the principal left ideal generated by an element is
the whole ring exactly when the element is a unit. -/
theorem unit_iff_leftIdeal_top {R : Type*} [Ring R] [Finite R] {r : R} :
    IsUnit r ↔ Submodule.span R ({r} : Set R) = ⊤ := by
  rw [source_unit_iff_left_inverse]
  constructor
  · rintro ⟨a, ha⟩
    apply top_unique
    intro x _
    apply (Submodule.mem_span_singleton (R := R) (x := x) (y := r)).2
    exact ⟨x * a, by rw [smul_eq_mul, mul_assoc, ha, mul_one]⟩
  · intro htop
    have h : (1 : R) ∈ Submodule.span R ({r} : Set R) := by
      rw [htop]
      exact Submodule.mem_top
    obtain ⟨a, ha⟩ :=
      (Submodule.mem_span_singleton (R := R) (x := (1 : R)) (y := r)).mp h
    exact ⟨a, by simpa only [smul_eq_mul] using ha⟩

end Qatlib.Papers.FiniteRing09.MainResults
