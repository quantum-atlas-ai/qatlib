import Qatlib.Concepts.CipherCircuits.CipherOracle

/-!
# Key predicates from plaintext-ciphertext transcripts

This module packages 128-bit block outputs into a transcript bank and defines the finite set
`marked` of keys matching every supplied plaintext-ciphertext pair. For the key-search
formulation in [GrasslEtAl2015], it proves that equality of banks is exactly the conjunction of
the individual encryption equalities and that a transcript generated by a secret key has a
marked key.

## Main statements

* `transcript_eq_target`: bank equality is equivalent to matching all supplied pairs.
* `secret_mem`: the generating secret key satisfies its transcript.
* `marked_nonempty`: the generated transcript has a positive marked-key count.

## References

* [Grassl et al., 2015][GrasslEtAl2015]
-/

namespace Qatlib.Papers.GroverAES15.KeyPredicate
set_option autoImplicit false
noncomputable section
open Qatlib.Concepts.CipherCircuits.CipherOracle
variable {K : Type*} {r : ℕ}

/-- A Boolean block of length 128. -/
abbrev Block := Fin 128 → Bool

/-- The bank of encrypted plaintext blocks for a candidate key, indexed by plaintext position
and output-bit position. -/
def transcript (enc : K → Block → Block) (texts : Fin r → Block) (key : K) :
    Bank (Fin r × Fin 128) := fun ij => enc key (texts ij.1) ij.2

/-- The bank formed by concatenating the supplied ciphertext blocks. -/
def target (ciphertexts : Fin r → Block) : Bank (Fin r × Fin 128) :=
  fun ij => ciphertexts ij.1 ij.2

/-- A candidate transcript equals the target bank if and only if the key encrypts each supplied
plaintext to its specified ciphertext [GrasslEtAl2015]. -/
theorem transcript_eq_target (enc : K → Block → Block) (texts ciphertexts : Fin r → Block)
    (key : K) :
    transcript enc texts key = target ciphertexts ↔ ∀ i, enc key (texts i) = ciphertexts i := by
  constructor
  · intro h i
    funext j
    exact congrFun h (i,j)
  · intro h
    funext ⟨i,j⟩
    exact congrFun (h i) j
variable [Fintype K]

/-- The finite set of keys whose transcript equals the supplied ciphertext bank. -/
def marked (enc : K → Block → Block) (texts ciphertexts : Fin r → Block) : Finset K :=
  Finset.univ.filter (fun key => transcript enc texts key = target ciphertexts)

/-- A key is marked if and only if it maps every supplied plaintext to the corresponding
ciphertext [GrasslEtAl2015]. -/
theorem mem_marked (enc : K → Block → Block) (texts ciphertexts : Fin r → Block) (key : K) :
    key ∈ marked enc texts ciphertexts ↔ ∀ i, enc key (texts i) = ciphertexts i := by
  simp [marked, transcript_eq_target]

/-- A secret key is marked for the ciphertexts obtained by encrypting the supplied plaintexts
with that key [GrasslEtAl2015]. -/
theorem secret_mem (enc : K → Block → Block) (texts : Fin r → Block) (secret : K) :
    secret ∈ marked enc texts (fun i => enc secret (texts i)) := by
  simp [mem_marked]

/-- The marked-key set for ciphertexts generated by a secret key has positive cardinality. -/
theorem marked_nonempty (enc : K → Block → Block) (texts : Fin r → Block) (secret : K) :
    0 < (marked enc texts (fun i => enc secret (texts i))).card :=
  Finset.card_pos.mpr ⟨secret, secret_mem enc texts secret⟩
end
end Qatlib.Papers.GroverAES15.KeyPredicate
