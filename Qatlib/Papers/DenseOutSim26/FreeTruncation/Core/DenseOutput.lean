import Mathlib.Analysis.SpecialFunctions.Integrals.Basic
import Mathlib.Analysis.SpecialFunctions.Pow.Real
import Mathlib.Tactic.FieldSimp
import Mathlib.Tactic.FunProp
import Mathlib.Tactic.Linarith
import Mathlib.Tactic.NormNum
import Mathlib.Tactic.Positivity
import Mathlib.Tactic.Ring

/-!
# Shared objects for `DenseOutSim26.FreeTruncation`

This module fixes the notation of Yang–Liu–Wang–Zhang–Liu, *Accelerating Quantum
Dense-Output Simulation through Locality* (arXiv:2609.40094v1), used by all claim
files of the `DenseOutSim26.FreeTruncation` Block.

The paper's central object is the dense output
`J_H(O) = ∫₀^T ⟨ψ(t)|O(t)|ψ(t)⟩ dt` (Eq. (4)), i.e. the time integral of a
time-resolved real signal.  A truncation replaces the region `Λ` by the radius-`R`
neighbourhood `X_R`, producing a second signal and hence a second dense output
(Eq. (9)).  The operator-norm truncation error is the time integral of the
operator-norm difference of the Heisenberg-evolved observables (Eq. (F2)).
-/

namespace Qatlib.Papers.DenseOutSim26.FreeTruncation.Core

open MeasureTheory intervalIntegral

set_option autoImplicit false

/-- The **dense output** `J_H(O) = ∫₀^T ⟨ψ(t)|O(t)|ψ(t)⟩ dt` (Eq. (4)): the
integral of the time-resolved real signal `t ↦ ⟨ψ(t)|O(t)|ψ(t)⟩` over `[0, T]`. -/
noncomputable def denseOutput (signal : ℝ → ℝ) (T : ℝ) : ℝ :=
  ∫ t in (0 : ℝ)..T, signal t

/-- The **truncated dense output** `J_{H_R}(O)` (Eq. (9)): the same time integral
for the signal generated by the restricted Hamiltonian `H_R`. -/
noncomputable def truncatedDenseOutput (signalR : ℝ → ℝ) (T : ℝ) : ℝ :=
  ∫ t in (0 : ℝ)..T, signalR t

/-- The **operator-norm truncation error** of Eq. (F2): the time integral of the
operator-norm distance between the observable `O(t)` along the full dynamics and
`O_R(t)` along the truncated dynamics.  Eq. (4) and the normalization of `ψ₀`
give `|J_H(O) − J_{H_R}(O)| ≤ operatorTruncationError O O_R T`. -/
noncomputable def operatorTruncationError {E : Type*} [NormedAddCommGroup E]
    (O OR : ℝ → E) (T : ℝ) : ℝ :=
  ∫ t in (0 : ℝ)..T, ‖O t - OR t‖

/-- **Lemma 1 shell-sum norm**, Eq. (23): the shell-sum estimate of `‖H‖` for a
power-law Hamiltonian, written as `J₀ ω_D ∫₁^L r^{D−1−α} dr`. -/
noncomputable def shellSumNorm (J0 ωD D α : ℝ) (L : ℝ) : ℝ :=
  J0 * ωD * ∫ r in (1 : ℝ)..L, r ^ (D - 1 - α)

/-- The **Lindbladian error profile** `F(μ,T) = ∫₀^T (T−s) e^{−μ s} ds` of
Eq. (79).  For `μ ≠ 0` this evaluates to `T/μ − (1−e^{−μT})/μ²`, and to `T²/2`
at `μ = 0`. -/
noncomputable def lindbladF (μ T : ℝ) : ℝ :=
  ∫ s in (0 : ℝ)..T, (T - s) * Real.exp (-μ * s)

/-- The **truncation radius of Corollary 2**, Eq. (20):
`R_ε(T) = Θ(max{(nT)^{max(1, 3/(α−D−η))}, (n²T^{5/2}/ε)^{2/(α−D−η)}})`. -/
noncomputable def corollary2Radius (n T ε α D η : ℝ) : ℝ :=
  max ((n * T) ^ (max 1 (3 / (α - D - η))))
      ((n ^ 2 * T ^ (5 / 2 : ℝ) / ε) ^ (2 / (α - D - η)))

/-- The **threshold system size of Proposition 5**, Eq. (D41):
`N = Θ(((log(1/ε) + D log R_obs)/(gT))^{D/(D−α)})`. -/
noncomputable def interactionPictureThreshold (g T ε Robs α D : ℝ) : ℝ :=
  ((Real.log (1 / ε) + D * Real.log Robs) / (g * T)) ^ (D / (D - α))

/-! ## Generic integration lemmas used by the truncation-error derivations

Every truncation bound of the paper is obtained the same way: a pointwise
light-cone estimate on `‖O(t) − O_R(t)‖` is integrated over `[0,T]`.  The
lemmas below are the shared analytic skeleton. -/

/-- `∫₀^T t dt = T²/2`. -/
theorem integral_id_eq (T : ℝ) : ∫ t in (0 : ℝ)..T, t = T ^ 2 / 2 := by
  have h := integral_rpow (a := (0 : ℝ)) (b := T) (r := 1) (Or.inl (by norm_num))
  simpa [Real.rpow_one, Real.zero_rpow (by norm_num : (2 : ℝ) ≠ 0)] using h

/-- `∫₀^T t dt ≤ T²` for `T ≥ 0`. -/
theorem integral_id_le_sq {T : ℝ} (_hT : 0 ≤ T) : ∫ t in (0 : ℝ)..T, t ≤ T ^ 2 := by
  rw [integral_id_eq]
  nlinarith [sq_nonneg T]

/-- `∫₀^T t^{3/2} dt = (2/5) T^{5/2}`. -/
theorem integral_rpow_three_halves (T : ℝ) (_hT : 0 ≤ T) :
    ∫ t in (0 : ℝ)..T, t ^ (3 / 2 : ℝ) = (2 / 5 : ℝ) * T ^ (5 / 2 : ℝ) := by
  have h := integral_rpow (a := (0 : ℝ)) (b := T) (r := (3 / 2 : ℝ)) (Or.inl (by norm_num))
  rw [show (3 / 2 : ℝ) + 1 = 5 / 2 by ring] at h
  have h0 : (0 : ℝ) ^ (5 / 2 : ℝ) = 0 :=
    Real.zero_rpow (by norm_num : (5 / 2 : ℝ) ≠ 0)
  rw [h0, sub_zero] at h
  rw [h]
  field_simp

/-- For a function nondecreasing on the segment `[0,T]` (with `T ≥ 0`), the
integral over `[0,T]` is at most `T` times its value at `T`.  This is the
"bound the integrand by its value at `s = t` times `t`" step used in the
paper's Dyson-tail estimates (e.g. Eq. (A12)). -/
theorem integral_le_mul_of_monotoneOn {g : ℝ → ℝ} {T : ℝ} (hT : 0 ≤ T)
    (hInt : IntervalIntegrable g volume (0 : ℝ) T)
    (hmono : MonotoneOn g (Set.Icc (0 : ℝ) T)) :
    ∫ t in (0 : ℝ)..T, g t ≤ T * g T := by
  have h1 : ∫ t in (0 : ℝ)..T, g t ≤ ∫ t in (0 : ℝ)..T, g T := by
    refine intervalIntegral.integral_mono_on hT hInt
      intervalIntegrable_const ?_
    intro t ht
    exact hmono ht ⟨hT, le_rfl⟩ ht.2
  rw [intervalIntegral.integral_const, sub_zero, smul_eq_mul] at h1
  exact h1

/-- Integrating a pointwise bound `f t ≤ c t / R^β` over `[0,T]` gives
`∫₀^T f ≤ c T²/R^β`: the shared integration step of Theorem 3 (Eq. (29)) and
Theorem 9 (Eq. (53)). -/
theorem integral_div_rpow_bound {f : ℝ → ℝ} {c T β R : ℝ} (hT : 0 ≤ T)
    (hc : 0 ≤ c) (hR : 0 < R)
    (hInt : IntervalIntegrable f volume (0 : ℝ) T)
    (hpt : ∀ t ∈ Set.Icc (0 : ℝ) T, f t ≤ c * t / R ^ β) :
    ∫ t in (0 : ℝ)..T, f t ≤ c * T ^ 2 / R ^ β := by
  have hcont : Continuous (fun t : ℝ => c * t / R ^ β) :=
    (continuous_const.mul continuous_id).div_const _
  have hg : IntervalIntegrable (fun t : ℝ => c * t / R ^ β) volume (0 : ℝ) T :=
    hcont.intervalIntegrable _ _
  have hmono := intervalIntegral.integral_mono_on hT hInt hg hpt
  have hcalc : ∫ t in (0 : ℝ)..T, c * t / R ^ β = (c / R ^ β) * (T ^ 2 / 2) := by
    rw [show (fun t : ℝ => c * t / R ^ β) = fun t => (c / R ^ β) * t by
      funext t; ring]
    rw [intervalIntegral.integral_const_mul, integral_id_eq]
  rw [hcalc] at hmono
  have hRβ : 0 < R ^ β := Real.rpow_pos_of_pos hR β
  have hsq : 0 ≤ T ^ 2 := sq_nonneg T
  have hstep : c * (T ^ 2 / 2) * (R ^ β)⁻¹ ≤ c * T ^ 2 * (R ^ β)⁻¹ := by
    refine mul_le_mul_of_nonneg_right ?_ (le_of_lt (inv_pos.mpr hRβ))
    nlinarith
  calc ∫ t in (0 : ℝ)..T, f t ≤ (c / R ^ β) * (T ^ 2 / 2) := hmono
    _ = c * (T ^ 2 / 2) * (R ^ β)⁻¹ := by rw [div_eq_mul_inv]; ring
    _ ≤ c * T ^ 2 * (R ^ β)⁻¹ := hstep
    _ = c * T ^ 2 / R ^ β := by rw [div_eq_mul_inv]

end Qatlib.Papers.DenseOutSim26.FreeTruncation.Core
