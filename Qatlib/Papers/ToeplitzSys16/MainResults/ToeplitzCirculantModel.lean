import Qatlib.Concepts.SpectralSketch.SpectrumPerturb.OrderedSpectralPerturbation
import Mathlib.Analysis.Fourier.AddCircle

set_option backward.isDefEq.respectTransparency false

/-!
# ToeplitzSys16 — matrix model for the Toeplitz / associated-circulant construction

Fixed source: arXiv:1608.02184v1, *Asymptotic Quantum Algorithm for the Toeplitz Systems* (2016),
§II eqs. (8), (10) and Appendix A.  The paper studies Toeplitz systems `Tₙ(f) x = b` generated by a
strictly positive continuous real symbol `f`, approximated by the "associated circulant" matrices
`Cₙ(f)` whose first row is the discrete Fourier transform of `f` sampled on the `n`-th roots of unity
(eq. (8)).

This file provides the concrete matrix model used by every result of the paper:

* `toeplitzCoeff f k` — the `k`-th Fourier coefficient `tₖ = (1/2π) ∫₀^{2π} f(λ) e^{-ikλ} dλ`,
  realised as Mathlib's `fourierCoeff` of the complexified symbol;
* `toeplitzMatrix n f` — `Tₙ(f)` with entry `(i,j) ↦ t_{i-j}`;
* `circulantRowCoeff n f k` — the first-row entries `cₖ` of eq. (8);
* `circulantMatrix n f` — the associated circulant `Cₙ(f)` with entry `(i,j) ↦ c_{(i-j) mod n}`;
* `relativeFrobeniusError n f` — the ratio `‖Tₙ(f) − Cₙ(f)‖_F / ‖Tₙ(f)‖_F` of eq. (10).

The Frobenius norm `spectralFrobenius` and its structural identities are reused from the Frozen
concept block `QuantumAlgorithm.Concepts.SpectralSketch.SpectrumPerturb`
(`spectralFrobenius`, `spectralFrobenius_sq`, `spectralFrobenius_sq_trace`,
`spectralFrobenius_sq_singular`).

Boundary: this is the paper's concrete symbol-to-matrix model. It does not assert the asymptotic
convergence of eq. (10) (that is Theorem 2, proved separately), nor any algorithmic oracle or gate
synthesis; the symbol is treated as a given continuous function.
-/

set_option autoImplicit false
noncomputable section

open Matrix Real Filter
open scoped Classical BigOperators Matrix.Norms.L2Operator

namespace Qatlib.Papers.ToeplitzSys16.MainResults

open Qatlib.Concepts.SpectralSketch.SpectrumPerturb

/-- `0 < 2π`, packaged so that `AddCircle (2 * π)` and `fourierCoeff` can be used. -/
instance instFactTwoPiPos : Fact (0 < 2 * Real.pi) := ⟨by positivity⟩

/-- The `k`-th Fourier coefficient of the (complexified) symbol `f`:
`tₖ = (1/2π) ∫₀^{2π} f(λ) e^{-ikλ} dλ`.  This is exactly Mathlib's `fourierCoeff`. -/
def toeplitzCoeff (f : AddCircle (2 * Real.pi) → ℝ) (k : ℤ) : ℂ :=
  fourierCoeff (fun x : AddCircle (2 * Real.pi) => (f x : ℂ)) k

/-- The Toeplitz matrix `Tₙ(f)` generated by `f`, with entry `(i,j) ↦ t_{i-j}`. -/
def toeplitzMatrix (n : ℕ) (f : AddCircle (2 * Real.pi) → ℝ) : Matrix (Fin n) (Fin n) ℂ :=
  fun i j => toeplitzCoeff f ((i : ℤ) - (j : ℤ))

/-- The first-row entries `cₖ` of the associated circulant, eq. (8):
`cₖ = (1/n) ∑_{j=0}^{n-1} f(2πj/n) e^{2πijk/n}`. -/
def circulantRowCoeff (n : ℕ) (f : AddCircle (2 * Real.pi) → ℝ) (k : ℕ) : ℂ :=
  (n : ℂ)⁻¹ * ∑ j : Fin n,
    ((f ((2 * Real.pi * (j : ℝ) / (n : ℝ) : ℝ) : AddCircle (2 * Real.pi)) : ℂ)
      * Complex.exp (2 * Real.pi * Complex.I * (j : ℂ) * (k : ℂ) / (n : ℂ)))

/-- The associated circulant `Cₙ(f)` of eq. (8), entry `(i,j) ↦ c_{(i-j) mod n}`. -/
def circulantMatrix (n : ℕ) (f : AddCircle (2 * Real.pi) → ℝ) : Matrix (Fin n) (Fin n) ℂ :=
  fun i j => circulantRowCoeff n f ((i.val + n - j.val) % n)

/-- The relative Frobenius error of eq. (10): `‖Tₙ(f) − Cₙ(f)‖_F / ‖Tₙ(f)‖_F`. -/
def relativeFrobeniusError (n : ℕ) (f : AddCircle (2 * Real.pi) → ℝ) : ℝ :=
  spectralFrobenius (toeplitzMatrix n f - circulantMatrix n f)
    / spectralFrobenius (toeplitzMatrix n f)

/-- The post-processing amplification factor of eq. (12): `2κ/(1 − κε)`, which converts the
relative matrix error `ε` of eq. (10) into the normalized-solution state error, `κ` the condition
number of `Tₙ(f)`. -/
def solutionErrorFactor (κ ε : ℝ) : ℝ := 2 * κ / (1 - κ * ε)

end Qatlib.Papers.ToeplitzSys16.MainResults
