import Qatlib.Concepts.LindbladFlow.GkslSemigroup.LindbladSemigroupCore
import QuantumInfo.ForMathlib.MatrixNorm.TraceNorm

set_option backward.isDefEq.respectTransparency false

/-!
# RepeatedLind23 — source model for Lindbladian simulation via repeated interactions

Paper: *Quantum Simulation of Lindbladian Dynamics via Repeated Interactions*,
arXiv:2312.05371 (fixed version used here: the arXiv posting of 2023-12-08,
2312.05371, whose body text is quoted below as `arXiv:2312.05371`, 2023).

This file fixes the objects that the six active claims of the paper speak about,
so that every claim file states the paper's result about the *same* mathematical
objects (Definition 1, Eq. (5); Eq. (14); Eq. (16) and following):

* `riStepFromHamiltonian` — one application of the repeated-interactions map
  `R_n(ρ) = Tr_{E_n}[e^{-iτH_n}(ρ ⊗ ρ_{E_n}) e^{iτH_n}]` of Definition 1,
  Eq. (5), realised with the unitary `e^{-iτH_n}` generated by the Hamiltonian;
* `riPass` / `riComposite` — the `m`-interaction composition `⨝_{n=1}^m R̃_n(t/ν)`
  and its `ν`-fold iterate of Eq. (14);
* `inducedOneNorm` — the induced Schatten `1→1` norm `‖·‖_{1→1}` in which the
  correspondence error of Theorem 2 (Eq. (16)) is measured;
* `correspondenceError` — the actual quantity `‖e^{tL} − (⨝_{n=1}^m R̃_n(t/ν))^{∘ν}‖_{1→1}`
  bounded in Theorem 2;
* `gamma` / `maxGamma4` — the strength `γ_n = max{‖H_0‖,‖H_{E_n}‖,‖H_{I_n}‖}` and
  `max_n γ_n^4` appearing in Eqs. (16), (26), (27);
* the cost budgets of Theorems 3, 5, 6 (Eqs. (45), (57), (63)) as explicit
  real-valued functions of the paper's parameters.

The Lindblad side reuses the frozen `GKSL` generator, its super-operator
`lindbladMap`, and the semigroup `lindbladSemigroup` of
`QuantumAlgorithm.Concepts.LindbladFlow.GkslSemigroup` (Frozen v2.0.2); only the
repeated-interaction side and the cost algebra are supplied here.

Scope: this is the paper-layer interface. It does not construct quantum circuits,
oracles `P`/`S` or QSVT phase sequences; Theorems 3/5/6 are stated at the level of
the *resource counts* the paper derives, driven by the standard primitives the
paper grants (QSVT query count of Eq. (48) and the channel Trotter error of
Ref. [41], Theorem 2). Those primitives enter each claim file as explicit
hypotheses, not as hidden axioms.
-/

set_option autoImplicit false
noncomputable section

open Matrix Qatlib
open Qatlib.Foundations.PureStateMath
open Qatlib.Concepts.LindbladFlow.GkslSemigroup
open Qatlib.Concepts.LindbladFlow.GkslSemigroup.LindbladSemigroupCore
open scoped BigOperators Matrix.Norms.L2Operator ComplexOrder Kronecker

namespace Qatlib.Papers.RepeatedLind23.MainResults

/-! ## The repeated-interactions map of Definition 1 -/

/-- Definition 1 / Eq. (5): one application of the repeated-interactions map.

The system has dimension `D`, the single bath subsystem `E_n` has dimension `dE`.
The map tensors the system state with the bath state `ρE`, conjugates by the joint
unitary `U` and traces the bath out. This is exactly
`R_n(ρ_S) = Tr_{E_n}[ U (ρ_S ⊗ ρ_{E_n}) U† ]`. -/
def riStepMap {D dE : ℕ}
    (U : Matrix (Fin D × Fin dE) (Fin D × Fin dE) ℂ)
    (ρE : Matrix (Fin dE) (Fin dE) ℂ) (ρS : Operator D) : Operator D :=
  (U * (ρS ⊗ₖ ρE) * Uᴴ).traceRight

/-- Definition 1 / Eq. (5): the step map generated by the interaction Hamiltonian
`H` over interaction time `τ`, i.e. with `U = e^{-iτH}` (the paper works in the
regime `λ²τ = 1`, so all coupling is absorbed into `H`; Eq. (17)). -/
def riStepFromHamiltonian {D dE : ℕ}
    (H : Matrix (Fin D × Fin dE) (Fin D × Fin dE) ℂ)
    (ρE : Matrix (Fin dE) (Fin dE) ℂ) (τ : ℝ) (ρS : Operator D) : Operator D :=
  riStepMap (NormedSpace.exp ((-(Complex.I * (τ : ℂ))) • H)) ρE ρS

/-- Eq. (14): one *pass* through the `m` interaction steps at interaction time `τ`,
i.e. `⨝_{n=1}^m R̃_n(τ)` (the paper's indexed multi-composition). The bath
subsystem `n` is prepared in `ρE n` and interacts for `τ`. -/
def riPass {D dE m : ℕ}
    (H : Fin m → Matrix (Fin D × Fin dE) (Fin D × Fin dE) ℂ)
    (ρE : Fin m → Matrix (Fin dE) (Fin dE) ℂ) (τ : ℝ) (ρS : Operator D) : Operator D :=
  (List.ofFn (fun n => riStepFromHamiltonian (H n) (ρE n) τ)).foldl
    (fun ρ f => f ρ) ρS

/-- Eq. (14): the full `ν`-fold composition `(⨝_{n=1}^m R̃_n(t/ν))^{∘ν}` of the
repeated-interactions map, with interaction time `τ = t/ν`. -/
def riComposite {D dE m : ℕ}
    (H : Fin m → Matrix (Fin D × Fin dE) (Fin D × Fin dE) ℂ)
    (ρE : Fin m → Matrix (Fin dE) (Fin dE) ℂ) (t : ℝ) (ν : ℕ)
    (ρS : Operator D) : Operator D :=
  (riPass H ρE (t / (ν : ℝ)))^[ν] ρS

/-! ## The induced Schatten `1→1` norm -/

/-- The induced Schatten `1→1` norm of a map on operators, i.e. the paper's
`‖·‖_{1→1}`: `sup_{‖ρ‖₁ ≤ 1} ‖T(ρ)‖₁`, with `‖·‖₁ = Matrix.traceNorm`. The maps
occurring in Theorem 2 are differences of CPTP maps, for which this supremum is
finite; the definition is stated for arbitrary maps as in the paper's notation. -/
def inducedOneNorm {D : ℕ} (T : Operator D → Operator D) : ℝ :=
  sSup { x : ℝ | ∃ ρ : Operator D, ρ.traceNorm ≤ 1 ∧ x = (T ρ).traceNorm }

/-- The correspondence error of Theorem 2, Eq. (16): the induced Schatten `1→1`
norm of `e^{tL} − (⨝_{n=1}^m R̃_n(t/ν))^{∘ν}`, where `e^{tL}` is the frozen
Lindblad semigroup `lindbladSemigroup G t`. -/
def correspondenceError {D dE m : ℕ} (G : GKSL D)
    (H : Fin m → Matrix (Fin D × Fin dE) (Fin D × Fin dE) ℂ)
    (ρE : Fin m → Matrix (Fin dE) (Fin dE) ℂ) (t : ℝ) (ν : ℕ) : ℝ :=
  inducedOneNorm (fun ρ => lindbladSemigroup G t ρ - riComposite H ρE t ν ρ)

/-! ## Strength parameters `γ_n` -/

/-- `γ_n = max{‖H_0‖, ‖H_{E_n}‖, ‖H_{I_n}‖}`, Theorem 2 below Eq. (16). -/
def gamma (H0norm HEnorm HInorm : ℝ) : ℝ := max H0norm (max HEnorm HInorm)

/-- `max_n γ_n^4` over the `m` bath subsystems, `m ≥ 1` (Theorem 2, Eq. (16)). -/
def maxGamma4 {m : ℕ} (hm : 0 < m) (γ : Fin m → ℝ) : ℝ :=
  (Finset.univ : Finset (Fin m)).sup' ⟨⟨0, hm⟩, Finset.mem_univ _⟩ (fun n => γ n ^ 4)

/-- The error budget of Theorem 2, Eq. (16):
`(t²/ν)·(‖L‖²_{1→1} + m·max_n γ_n⁴)`. -/
def theorem2Budget {D m : ℕ} (hm : 0 < m) (G : GKSL D) (γ : Fin m → ℝ)
    (t ν : ℝ) : ℝ :=
  (t ^ 2 / ν) *
    ((inducedOneNorm (lindbladMap G)) ^ 2 + (m : ℝ) * maxGamma4 hm γ)

/-- The `‖L‖_{1→1}` factor of Eq. (16). -/
def lindbladOneNorm {D : ℕ} (G : GKSL D) : ℝ := inducedOneNorm (lindbladMap G)

/-! ## Cost algebra of Theorem 3 (iterative qubitization) -/

/-- Eq. (50): the coefficient `1`-norm `α_n = √(ν/t)·α_{I_n} + (1/m)(α_0 + ω_n)`
of the `n`-th block-encoded repeated-interaction step. -/
def stepAlphaNorm (α0 αI ω : ℝ) (m : ℕ) (ν : ℕ) (t : ℝ) : ℝ :=
  Real.sqrt ((ν : ℝ) / t) * αI + (1 / (m : ℝ)) * (α0 + ω)

/-- The QSVT logarithmic factor `log(1/ε)/log log(1/ε)` of Eq. (45). -/
def qsvtLogFactor (ε : ℝ) : ℝ := Real.log (1 / ε) / Real.log (Real.log (1 / ε))

/-- Eq. (45) per-step qubitization query bound before multiplying by `κ = mν`:
`α_n·τ + log(1/ε)/log log(1/ε)` with `τ = t/ν` (Eq. (48)). -/
def qubitizationStepQueries {m : ℕ} (hm : 0 < m) (α0 αI ω : Fin m → ℝ)
    (ν : ℕ) (t ε : ℝ) : ℝ :=
  (Finset.univ : Finset (Fin m)).sup' ⟨⟨0, hm⟩, Finset.mem_univ _⟩
    (fun n => stepAlphaNorm (α0 n) (αI n) (ω n) m ν t * (t / (ν : ℝ)) + qsvtLogFactor ε)

/-- The total qubitization query count of Theorem 3, Eq. (45): `κ = mν` applications
of a map measured by `qubitizationStepQueries`. -/
def iterativeQubitizationCount {m : ℕ} (hm : 0 < m) (α0 αI ω : Fin m → ℝ)
    (ν : ℕ) (t ε : ℝ) : ℝ :=
  (m : ℝ) * (ν : ℝ) * qubitizationStepQueries hm α0 αI ω ν t ε

/-! ## Cost algebra of Theorems 5 and 6 (Trotter–Suzuki) -/

/-- Eq. (56): the number `Υ = 2·5^{k-1}` of stages of a `2k`-th order
Trotter–Suzuki product formula. -/
def suzukiStages (k : ℕ) : ℕ := 2 * 5 ^ (k - 1)

/-- Eq. (57) repetition-count budget `r` of Theorem 5 (higher-order
Trotter–Suzuki), for a fixed `n`-th bath subsystem. -/
def highOrderTrotterSteps (α0 αI ω : ℝ) (m ν : ℕ) (t ε : ℝ) (k : ℕ) : ℝ :=
  Real.rpow
    (((α0 + (m : ℝ) * ω) * t + (m : ℝ) * αI * Real.sqrt ((ν : ℝ) * t))
      / ((m : ℝ) * (ν : ℝ) * Real.rpow ε (1 / (2 * (k : ℝ)))))
    (1 + 1 / (2 * (k : ℝ)))

/-- The gate-count budget `l·Υ·r` of Theorem 5, Eq. (57). -/
def highOrderTrotterGates {m : ℕ} (hm : 0 < m) (α0 αI ω : Fin m → ℝ)
    (ν : ℕ) (t ε : ℝ) (k l : ℕ) : ℝ :=
  (l : ℝ) * (suzukiStages k : ℝ) *
    (Finset.univ : Finset (Fin m)).sup' ⟨⟨0, hm⟩, Finset.mem_univ _⟩
      (fun n => highOrderTrotterSteps (α0 n) (αI n) (ω n) m ν t ε k)

/-- Eq. (63) bracket of Theorem 6 (first-order Trotter–Suzuki):
`t^{3/2}/(2ε√ν)·(Σ_j ‖[H_{0j},H_{I_n}]‖ + m‖[H_{E_n},H_{I_n}]‖)
 + t²/(2εν)·Σ_{p,q} (1/m)‖[H_{0p},H_{0q}]‖`. -/
def firstOrderTrotterBracket (commHI commEI : ℝ) (commH0 : ℝ)
    (t ε ν m : ℝ) : ℝ :=
  (Real.rpow t (3 / 2 : ℝ) / (2 * ε * Real.sqrt ν)) * (commHI + m * commEI) +
    (t ^ 2 / (2 * ε * ν)) * ((1 / m) * commH0)

/-- The gate-count bound `l · bracket` of Theorem 6, Eq. (63). -/
def firstOrderTrotterGates (commHI commEI commH0 : ℝ) (t ε ν m : ℝ) (l : ℕ) : ℝ :=
  (l : ℝ) * firstOrderTrotterBracket commHI commEI commH0 t ε ν m

end Qatlib.Papers.RepeatedLind23.MainResults
