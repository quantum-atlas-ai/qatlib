set_option backward.isDefEq.respectTransparency false

/-!
# Model layer for SparseMarkov16

Childs--Li, *Efficient simulation of sparse Markovian quantum dynamics*,
fixed arXiv:1611.05543v3 (9 Oct 2023).

This module fixes the objects used by the paper-layer statements:

* `Op` — the Frozen `Operator` type, `N × N` complex matrices;
* `aFormApply` — Eq. (3): the PSD-matrix form of a Lindbladian;
* `diagLindbladApply` — Eq. (83): diagonal Lindbladians, together with the
  coefficient-sparsity predicates of Section 4.3.1;
* `ketSparseLindbladApply` — Eq. (141): 1-ket-sparse Lindbladians;
* `identCoordLindbladApply` / `identCoordEvolve` — Eqs. (69)--(77):
  identical-coordinate Lindbladians and their closed-form evolution;
* `jumpLindbladApply` — Eq. (167): the Lindbladian generated by one jump;
* sparsity predicates `RowSparse`, `ColSparse`, `DSparse`, `OneSparse`,
  `StronglyOneSparse`, `InvariantlyDSparseOperation`,
  `InvariantlySparseIsometry`;
* `DiamondClose` — the finite-reference (diamond-norm) closeness used by every
  simulation statement;
* `SparseSimProgram` and the decision-tree query models used for the
  no-fast-forwarding lower bound (Theorem 10);
* `superExp`, `productHalf`, `productFormula` — the superoperator exponential
  (as a state-level power series, matching the Frozen `lindbladSemigroup`
  convention) and the second-order product formula of Proposition 2.

This checkout supplies a model file, not simulation upper-bound theorems.
`SparseSimProgram` is a legacy unverified ledger. `SparseProgramImplementation`
ties it to a step list interpreted in a supplied primitive catalog. Composition
and query bounds below are conditional on that catalog and implementation data;
physical gate synthesis and the paper's quantum algorithms are not constructed.
The separate decision-tree models constrain oracle dependence and query depth.
-/

set_option autoImplicit false
noncomputable section

open Matrix
open Qatlib.Foundations.PureStateMath
open Qatlib.Concepts.LindbladFlow.GkslSemigroup
open Qatlib.Concepts.ChannelTheory.Stinespring
open Qatlib.Concepts.SchattenDiamond.DiamondNorm
open scoped BigOperators ComplexOrder

namespace Qatlib.Papers.SparseMarkov16.MainResults.Model

/-- The paper's `Operator N`: complex `N × N` matrices (the Frozen `Operator`). -/
abbrev Op (N : ℕ) := Operator N

/-- Pointwise comparison `f ≤ C g` for some positive multiplier. Uniform
asymptotic bounds require quantifying `C` before all varying parameters. -/
def BigO (f g : ℝ) : Prop :=
  ∃ C : ℝ, 0 < C ∧ f ≤ C * g

/-- State-level superoperator exponential by its power series, matching the
Frozen `lindbladSemigroup` convention. -/
noncomputable def superExp {N : ℕ} (T : Op N → Op N) (t : ℝ) : Op N → Op N :=
  fun ρ => ∑' k : ℕ, ((t : ℂ) ^ k / k.factorial) • (T^[k]) ρ

/-! ## Eq. (3): the PSD-matrix form of a Lindbladian -/

/-- Eq. (3) with `H` the Hamiltonian and `A` the `N² × N²` coefficient matrix;
the composite index is `p = (k,l)`, `q = (k',l')`. -/
noncomputable def aFormApply {N : ℕ} (H : Op N)
    (A : Matrix (Fin N × Fin N) (Fin N × Fin N) ℂ) (ρ : Op N) : Op N :=
  (-Complex.I) • (H * ρ - ρ * H) +
    ∑ p : Fin N × Fin N, ∑ q : Fin N × Fin N,
      ((2 * A p q * ρ q.2 p.2) • Matrix.single p.1 q.1 (1 : ℂ)
        - (if p.1 = q.1 then A p q • (Matrix.single q.2 p.2 (1 : ℂ) * ρ) else 0)
        - (if p.1 = q.1 then A p q • (ρ * Matrix.single q.2 p.2 (1 : ℂ)) else 0))

/-- Eq. (3) with zero Hamiltonian: the Lindbladian read off from the coefficient
matrix `A` alone. -/
noncomputable def lindbladianFromA {N : ℕ}
    (A : Matrix (Fin N × Fin N) (Fin N × Fin N) ℂ) : Op N → Op N :=
  aFormApply 0 A

/-- A linear map is a **Lindbladian** when it is a GKSL generator with finitely
many jump operators (the Frozen `lindbladMap`).  This is the paper's notion: a
map of jump-operator form (1)--(2). -/
def IsLindbladian {N : ℕ} (L : Op N →ₗ[ℂ] Op N) : Prop :=
  ∃ G : GKSL N, L = lindbladMap G

/-! ## Eq. (167): one-jump Lindbladians -/

/-- Eq. (167): the Lindbladian generated by the single jump operator `M`. -/
noncomputable def jumpLindbladApply {N : ℕ} (M : Op N) (ρ : Op N) : Op N :=
  M * ρ * M.conjTranspose -
    (1 / 2 : ℂ) • (M.conjTranspose * M * ρ + ρ * M.conjTranspose * M)

/-- A GKSL generator with a single nonzero jump operator `M`; the remaining
`D² − 1` jump slots are zero. -/
noncomputable def singleJumpGKSL {D : ℕ} (M : Op D) : GKSL D where
  ham := 0
  hamHermitian := Matrix.isHermitian_zero
  jumps := fun j => if j.1 = 0 then M else 0

/-! ## Section 4.3: diagonal Lindbladians (Eq. (83)) -/

/-- Eq. (83): the diagonal Lindbladian generated by the real coefficient
matrix `a` (with `a_{k,l} = A_{(k,l),(k,l)}`). -/
noncomputable def diagLindbladApply {N : ℕ} (a : Matrix (Fin N) (Fin N) ℝ)
    (ρ : Op N) : Op N :=
  ∑ k : Fin N, ∑ l : Fin N,
    ((2 * (a k l : ℂ) * ρ l l) • Matrix.single k k (1 : ℂ)
      - (a k l : ℂ) • (Matrix.single l l (1 : ℂ) * ρ)
      - (a k l : ℂ) • (ρ * Matrix.single l l (1 : ℂ)))

/-- Row mass `∑_l a_{k,l}` of the coefficient matrix. -/
noncomputable def rowMass {N : ℕ} (a : Matrix (Fin N) (Fin N) ℝ) (k : Fin N) : ℝ :=
  ∑ l : Fin N, a k l

/-- Row sparsity: some set of at most `d` columns contains every nonzero entry
of each row (a decidability-free form of "at most `d` nonzeros per row"). -/
def RowSparse {N : ℕ} (d : ℕ) (a : Matrix (Fin N) (Fin N) ℝ) : Prop :=
  ∀ k : Fin N, ∃ S : Finset (Fin N), S.card ≤ d ∧ ∀ l : Fin N, a k l ≠ 0 → l ∈ S

/-- Column sparsity, in the same decidability-free form. -/
def ColSparse {N : ℕ} (d : ℕ) (a : Matrix (Fin N) (Fin N) ℝ) : Prop :=
  ∀ l : Fin N, ∃ S : Finset (Fin N), S.card ≤ d ∧ ∀ k : Fin N, a k l ≠ 0 → k ∈ S

/-- `d`-sparse complex square matrix (the entry-sparsity of a Lindblad
operator, Section 5.1): at most `d` nonzeros per row and per column. -/
def EntryDSparse {N : ℕ} (d : ℕ) (M : Op N) : Prop :=
  (∀ i : Fin N, ∃ S : Finset (Fin N), S.card ≤ d ∧ ∀ j : Fin N, M i j ≠ 0 → j ∈ S) ∧
  (∀ j : Fin N, ∃ S : Finset (Fin N), S.card ≤ d ∧ ∀ i : Fin N, M i j ≠ 0 → i ∈ S)

/-- `d`-sparse complex rectangular matrix (row and column sparsity of the
isometry `V` in Proposition 3), for arbitrary finite row and column indices. -/
def EntryDSparseRect {m n : Type*} [Fintype m] [Fintype n]
    (d : ℕ) (M : Matrix m n ℂ) : Prop :=
  (∀ i : m, ∃ S : Finset n, S.card ≤ d ∧ ∀ j : n, M i j ≠ 0 → j ∈ S) ∧
  (∀ j : n, ∃ S : Finset m, S.card ≤ d ∧ ∀ i : m, M i j ≠ 0 → i ∈ S)

/-- `d`-sparse coefficient matrix (Section 4.3.1): at most `d` nonzeros per row
and per column. -/
def DSparse {N : ℕ} (d : ℕ) (a : Matrix (Fin N) (Fin N) ℝ) : Prop :=
  RowSparse d a ∧ ColSparse d a

/-- `1`-sparse coefficient matrix: at most one nonzero per row and per column. -/
def OneSparse {N : ℕ} (a : Matrix (Fin N) (Fin N) ℝ) : Prop :=
  RowSparse 1 a ∧ ColSparse 1 a

/-- Strongly `1`-sparse with neighbor function `ν` (Section 4.3.1): `ν` is an
involution and every nonzero entry lies at `(k,k)` or `(k,ν k)`. -/
def StronglyOneSparse {N : ℕ} (a : Matrix (Fin N) (Fin N) ℝ)
    (ν : Fin N → Fin N) : Prop :=
  Function.Involutive ν ∧ ∀ k l : Fin N, a k l ≠ 0 → l = k ∨ l = ν k

/-- Semigroup of a diagonal Lindbladian, as the state-level exponential of
`diagLindbladApply a` (power series, matching the Frozen convention). -/
noncomputable def diagSemigroup {N : ℕ} (a : Matrix (Fin N) (Fin N) ℝ)
    (t : ℝ) : Op N → Op N :=
  superExp (diagLindbladApply a) t

/-! ## Section 4.2: identical-coordinate Lindbladians (Eqs. (69)--(77)) -/

/-- Eqs. (74)--(75): the identical-coordinate Lindbladian action.  Diagonal
entries are fixed by Eq. (75); off-diagonal entries decay at the rate of
Eq. (74). -/
noncomputable def identCoordLindbladApply {N : ℕ} (a c : Fin N → ℝ)
    (ρ : Op N) : Op N :=
  fun u v => if u = v then 0
    else (-((a u + a v - 2 * (c u + c v) : ℝ)) : ℂ) * ρ u v

/-- Eqs. (76)--(77): the closed-form evolution of an identical-coordinate
Lindbladian. -/
noncomputable def identCoordEvolve {N : ℕ} (a c : Fin N → ℝ) (t : ℝ)
    (ρ : Op N) : Op N :=
  fun u v => if u = v then ρ u v
    else (Real.exp (-(a u + a v - 2 * (c u + c v)) * t) : ℂ) * ρ u v

/-! ## Section 4.4: 1-ket-sparse Lindbladians (Eq. (141)) -/

/-- Eq. (141): the 1-ket-sparse Lindbladian with neighbor function `ν` and
coefficient families `a`, `a'`, `b`. -/
noncomputable def ketSparseLindbladApply {N : ℕ} (ν : Fin N → Fin N)
    (a a' b : Fin N → ℝ) (ρ : Op N) : Op N :=
  (∑ k : Fin N,
      ((2 * (a k : ℂ) * ρ (ν k) (ν k)) • Matrix.single k k (1 : ℂ)
        - (a k : ℂ) • (Matrix.single (ν k) (ν k) (1 : ℂ) * ρ)
        - (a k : ℂ) • (ρ * Matrix.single (ν k) (ν k) (1 : ℂ))))
  + (∑ k : Fin N,
      ((2 * (a' k : ℂ) * ρ k k) • Matrix.single k k (1 : ℂ)
        - (a' k : ℂ) • (Matrix.single k k (1 : ℂ) * ρ)
        - (a' k : ℂ) • (ρ * Matrix.single k k (1 : ℂ))))
  + (∑ k : Fin N,
      (2 * (b k : ℂ) * (ρ k k + ρ (ν k) (ν k))) • Matrix.single k (ν k) (1 : ℂ))

/-! ## Sparsity of quantum operations and Stinespring isometries (Defs. 1--2) -/

/-- Definition 1: `E` is invariantly `d`-sparse when every `E(|x><y|)` is
supported in `S x × S y`, for sets `S` of size at most `d` that are for distinct
indices either disjoint or equal. -/
def InvariantlyDSparseOperation {N : ℕ} (d : ℕ) (E : Op N →ₗ[ℂ] Op N) : Prop :=
  ∃ S : Fin N → Finset (Fin N),
    (∀ x : Fin N, (S x).card ≤ d) ∧
    (∀ (x y : Fin N) (i j : Fin N),
      E (Matrix.single x y (1 : ℂ)) i j ≠ 0 → i ∈ S x ∧ j ∈ S y) ∧
    (∀ x y : Fin N, x ≠ y → Disjoint (S x) (S y) ∨ S x = S y)

/-- Definition 2: a Stinespring isometry `V : C^N → C^N ⊗ C^d` is invariantly
`d`-sparse when `V|x> = ∑_{i<r_x} |ν^i(x)>|φ_{x,i}>` for a permutation `ν` of
order at most `d`.  Encoded entrywise: `V (y,i) x ≠ 0` forces `y = ν^i x`. -/
def InvariantlySparseIsometry {N d : ℕ}
    (V : Matrix (Fin N × Fin d) (Fin N) ℂ) : Prop :=
  V.conjTranspose * V = (1 : Op N) ∧
    ∃ ν : Fin N → Fin N,
      (∀ x : Fin N, ν^[d] x = x) ∧
      (∀ (x : Fin N) (i : Fin d) (y : Fin N), V (y, i) x ≠ 0 → y = ν^[i.1] x)

/-! ## Diamond-norm closeness and resource ledgers -/

/-- Reference-amplified image of a state map at reference dimension `r`. -/
noncomputable def tensorImage {N : ℕ} (Φ : Op N → Op N) (r : ℕ)
    (X : Matrix (Fin N × Fin r) (Fin N × Fin r) ℂ) :
    Matrix (Fin N × Fin r) (Fin N × Fin r) ℂ :=
  fun x y => Φ (fun i j => X (i, x.2) (j, y.2)) x.1 y.1

/-- Finite-reference closeness: `δ`-close in the diamond norm, expressed as the
uniform trace-norm bound over every finite reference register and every raw
input (the definition underlying `finiteDiamondNorm`). -/
def DiamondClose {N : ℕ} (δ : ℝ) (F G : Op N → Op N) : Prop :=
  ∀ (r : ℕ) (X : Matrix (Fin N × Fin r) (Fin N × Fin r) ℂ),
    Matrix.traceNorm (tensorImage F r X - tensorImage G r X)
      ≤ δ * Matrix.traceNorm X

/-- Two-sided encoding of "the superoperator has diamond norm `c`": a uniform
trace-norm upper bound by `c`, attained at some input of unit trace norm. -/
def SuperoperatorDiamondNormEq {N : ℕ} (c : ℝ) (F : Op N → Op N) : Prop :=
  (∀ (r : ℕ) (X : Matrix (Fin N × Fin r) (Fin N × Fin r) ℂ),
      Matrix.traceNorm (tensorImage F r X) ≤ c * Matrix.traceNorm X) ∧
    (∃ (r : ℕ) (X : Matrix (Fin N × Fin r) (Fin N × Fin r) ℂ),
      Matrix.traceNorm X = 1 ∧ c ≤ Matrix.traceNorm (tensorImage F r X))

/-- Legacy operation and independent resource annotations. This record alone does
not certify a program. Use `SparseProgramImplementation` to tie all three fields
to a step sequence in a supplied primitive catalog. -/
structure SparseSimProgram (N : ℕ) where
  /-- Annotated operation, unverified until an implementation is supplied. -/
  realizes : Op N → Op N
  /-- Annotated two-qubit gate count. -/
  gateCount : ℕ
  /-- Annotated black-box query count. -/
  queryCount : ℕ

/-- A numerical comparison of legacy counters. An operational overhead claim
additionally requires implementations of the combined program and its parts. -/
def ConstantQueryOverhead {N : ℕ} (C : ℝ) (P : SparseSimProgram N)
    (parts : List (SparseSimProgram N)) : Prop :=
  (P.queryCount : ℝ) ≤ C * (parts.map (fun Q => (Q.queryCount : ℝ))).sum

/-- A call to a named primitive: `true` denotes an oracle query, `false` a gate.
Catalog entries and their physical validity are supplied hypotheses. -/
abbrev SparseStep := Bool × ℕ

/-- The number of calls of the indicated kind in a step list. -/
def sparseStepCount (query : Bool) (w : List SparseStep) : ℕ :=
  (w.filter (fun s => s.1 = query)).length

/-- Execute calls in list order. No operation is attached to an empty list. -/
def sparseEval {N : ℕ} (primitive : SparseStep → Op N → Op N)
    (w : List SparseStep) (ρ : Op N) : Op N :=
  w.foldl (fun σ s => primitive s σ) ρ

/-- Conditional implementation certificate: semantics and both counters come from
the same list. Physical oracle/gate realizations of `primitive` are assumed. -/
structure SparseProgramImplementation {N : ℕ}
    (primitive : SparseStep → Op N → Op N) (P : SparseSimProgram N) where
  steps : List SparseStep
  evaluates : P.realizes = sparseEval primitive steps
  gates_eq : P.gateCount = sparseStepCount false steps
  queries_eq : P.queryCount = sparseStepCount true steps

/-- Concatenation executes the second supplied sequence after the first. -/
theorem sparseEval_append {N : ℕ} (primitive : SparseStep → Op N → Op N)
    (u v : List SparseStep) (ρ : Op N) :
    sparseEval primitive (u ++ v) ρ = sparseEval primitive v (sparseEval primitive u ρ) := by
  simp [sparseEval, List.foldl_append]

/-- Counts add under actual sequence concatenation. -/
theorem sparseStepCount_append (query : Bool) (u v : List SparseStep) :
    sparseStepCount query (u ++ v) = sparseStepCount query u + sparseStepCount query v := by
  simp [sparseStepCount]

/-- An operational bound follows from an implementation and a bound on the calls
in its supplied step list. This does not construct a simulation algorithm. -/
theorem query_bound_of_implementation {N : ℕ}
    {primitive : SparseStep → Op N → Op N} {P : SparseSimProgram N}
    (I : SparseProgramImplementation primitive P) {q : ℕ}
    (h : sparseStepCount true I.steps ≤ q) : P.queryCount ≤ q := by
  rw [I.queries_eq]
  exact h

/-- Sequential composition of ledger annotations. Its operational interpretation
requires implementations of both operands, as in `compose_implementation`. -/
def composeSparsePrograms {N : ℕ} (P Q : SparseSimProgram N) : SparseSimProgram N where
  realizes := Q.realizes ∘ P.realizes
  gateCount := P.gateCount + Q.gateCount
  queryCount := P.queryCount + Q.queryCount

/-- Two supplied implementations compose by concatenating their actual call lists.
Both resource counts add; no target operation is installed as an output witness. -/
def compose_implementation {N : ℕ} {primitive : SparseStep → Op N → Op N}
    {P Q : SparseSimProgram N}
    (I : SparseProgramImplementation primitive P)
    (J : SparseProgramImplementation primitive Q) :
    SparseProgramImplementation primitive (composeSparsePrograms P Q) where
  steps := I.steps ++ J.steps
  evaluates := by
    funext ρ
    simp [composeSparsePrograms, I.evaluates, J.evaluates, sparseEval_append]
  gates_eq := by
    simp [composeSparsePrograms, sparseStepCount_append, I.gates_eq, J.gates_eq]
  queries_eq := by
    simp [composeSparsePrograms, sparseStepCount_append, I.queries_eq, J.queries_eq]

/-! ## Decision-tree query models for Theorem 10 -/

/-- A decision tree for the *matrix-entry* black box of Theorem 10(i): on each
oracle matrix it consults at most `depth` entries and its output depends only
on the consulted entries. -/
structure AEntryDecisionTree (N : ℕ) where
  /-- Number of entry queries. -/
  depth : ℕ
  /-- The entries consulted on a given oracle matrix. -/
  consulted : Matrix (Fin N × Fin N) (Fin N × Fin N) ℂ → Finset (Fin N × Fin N)
  /-- At most `depth` entries are consulted. -/
  consulted_card : ∀ A, (consulted A).card ≤ depth
  /-- The simulated operation. -/
  output : Matrix (Fin N × Fin N) (Fin N × Fin N) ℂ → Op N → Op N
  /-- The output depends only on the consulted entries. -/
  respects : ∀ A B, (∀ e ∈ consulted A, A e = B e) → output A = output B

/-- A decision tree for the *row/column* black box of Theorem 10(ii): it
consults at most `depth` rows or columns and its output depends only on the
entries of the consulted rows and columns. -/
structure SparseEntryDecisionTree (N : ℕ) where
  /-- Number of row/column queries. -/
  depth : ℕ
  /-- Consulted rows. -/
  consultedRows : Matrix (Fin N × Fin N) (Fin N × Fin N) ℂ → Finset (Fin N)
  /-- Consulted columns. -/
  consultedCols : Matrix (Fin N × Fin N) (Fin N × Fin N) ℂ → Finset (Fin N)
  /-- At most `depth` row/column accesses. -/
  consulted_card : ∀ A, (consultedRows A).card + (consultedCols A).card ≤ depth
  /-- The simulated operation. -/
  output : Matrix (Fin N × Fin N) (Fin N × Fin N) ℂ → Op N → Op N
  /-- The output depends only on the consulted rows and columns. -/
  respects : ∀ A B,
    (∀ r ∈ consultedRows A, ∀ c, A (r, c) = B (r, c)) →
    (∀ c ∈ consultedCols A, ∀ r, A (r, c) = B (r, c)) →
    output A = output B

/-- Entry-oracle lower bound: no `q`-query matrix-entry decision tree simulates
`target` within diamond error `1/8` on every oracle matrix. -/
def AEntryQueryLowerBound {N : ℕ}
    (target : Matrix (Fin N × Fin N) (Fin N × Fin N) ℂ → Op N → Op N) (q : ℕ) : Prop :=
  ∀ T : AEntryDecisionTree N, T.depth < q →
    ∃ A, ¬ DiamondClose (1 / 8) (T.output A) (target A)

/-- Row/column-oracle lower bound, analogous to `AEntryQueryLowerBound`. -/
def SparseEntryQueryLowerBound {N : ℕ}
    (target : Matrix (Fin N × Fin N) (Fin N × Fin N) ℂ → Op N → Op N) (q : ℕ) : Prop :=
  ∀ T : SparseEntryDecisionTree N, T.depth < q →
    ∃ A, ¬ DiamondClose (1 / 8) (T.output A) (target A)

/-! ## Product formula (Proposition 2) -/

/-- One symmetric Strang half-step of the product formula of Proposition 2:
`∏_i e^{t L_i / 2r}` followed by the same product in reverse order. -/
noncomputable def productHalf {N m : ℕ} (Ls : Fin m → Op N → Op N)
    (t : ℝ) (r : ℕ) (ρ : Op N) : Op N :=
  let h := t / (2 * (r : ℝ))
  let forward := (List.finRange m).foldl (fun σ i => superExp (Ls i) h σ) ρ
  (List.finRange m).reverse.foldl (fun σ i => superExp (Ls i) h σ) forward

/-- The full product formula with `r` symmetric steps. -/
noncomputable def productFormula {N m : ℕ} (Ls : Fin m → Op N → Op N)
    (t : ℝ) (r : ℕ) (ρ : Op N) : Op N :=
  (fun σ => productHalf Ls t r σ)^[r] ρ

/-! ## Ladder generator used in Lemma 8 and Theorem 10 -/

/-- The shift (lowering) matrix of Lemma 8: `L|n> = |n-1>` and `L|0> = 0` on
`C^{N+1}`. -/
noncomputable def shiftOp (N : ℕ) : Op (N + 1) :=
  fun i j => if i.1 + 1 = j.1 then 1 else 0

/-- The lowering operator on `C^N`: `|n> ↦ |n-1>` and `|0> ↦ 0`. -/
noncomputable def ladderOp (N : ℕ) : Op N :=
  fun i j => if i.1 + 1 = j.1 then 1 else 0

/-- Eq. (249): the Poisson-weighted diagonal output of the ladder semigroup. -/
noncomputable def poissonDiag (N : ℕ) (t : ℝ) : Op (N + 1) :=
  fun i j => if i = j then
      (if i.1 = 0 then
        ((1 - ∑ m ∈ Finset.range N, Real.exp (-t) * t ^ m / (m.factorial : ℝ)) : ℝ)
      else
        ((Real.exp (-t) * t ^ (N - i.1) / ((N - i.1).factorial : ℝ)) : ℝ))
    else 0

/-! ## Gram data for Lemma 9 -/

/-- Hermitian inner product of two complex vectors. -/
noncomputable def vInner {n : ℕ} (u v : Fin n → ℂ) : ℂ :=
  ∑ i : Fin n, star (u i) * v i

/-- The rank-one matrix `|v><v|`. -/
noncomputable def rankOne {n : ℕ} (v : Fin n → ℂ) : Op n :=
  fun i j => v i * star (v j)

/-- Gram matrix `G_{j,k} = <r_j, r_k>` of a family of `r` vectors in `C^n`
(Lemma 9). -/
noncomputable def gramMatrix {r n : ℕ} (vec : Fin r → Fin n → ℂ) :
    Matrix (Fin r) (Fin r) ℂ :=
  fun j k => vInner (vec j) (vec k)

/-! ## Locality proxy for Lemma 1 / Theorem 3 -/

/-- Row support bound: some set of at most `m` coordinates contains every row
index on which the matrix is nonzero. -/
def RowSupportWithin {D : ℕ} (M : Op D) (m : ℕ) : Prop :=
  ∃ S : Finset (Fin D), S.card ≤ m ∧ ∀ i : Fin D, (∃ j, M i j ≠ 0) → i ∈ S

/-- A `c`-local generator: the Hamiltonian and every jump operator act
nontrivially on at most `2^c` basis coordinates. -/
def IsCLocalGenerator {D : ℕ} (G : GKSL D) (c : ℕ) : Prop :=
  RowSupportWithin G.ham (2 ^ c) ∧ ∀ j, RowSupportWithin (G.jumps j) (2 ^ c)

end Qatlib.Papers.SparseMarkov16.MainResults.Model
