module

public import Qatlib.Papers.HydroSpinLatt21.SingleSpin.QuarticSpin
public import Mathlib.Analysis.Calculus.Deriv.Add
public import Mathlib.Algebra.Order.BigOperators.Ring.Finset

@[expose] public section

/-!
# Symmetric coupling and a finite-network Lyapunov identity

[Saenz2021HydroSpinLattices], Methods, motivates finite oscillator models with
geometry-dependent wave coupling. See
[the article](https://doi.org/10.1038/s41586-021-03682-1).

Here a real symmetric matrix represents a reciprocal coupling kernel. Its
quadratic interaction is combined with the on-site quartic potential from
`Qatlib.Papers.HydroSpinLatt21.SingleSpin.spinPotential`. Differentiating this
energy along the explicitly specified gradient dynamics gives minus the sum of
squared gradients. Symmetry is an actual hypothesis used to combine the two
interaction derivatives. The result does not assert that the paper's full
active Bessel or generalized Kuramoto dynamics is a gradient flow, nor does it
derive a Bessel kernel or any measured phase boundary.
-/

set_option autoImplicit false

noncomputable section

open scoped BigOperators

namespace Qatlib.Papers.HydroSpinLatt21.WaveCoupling

open Qatlib.Papers.HydroSpinLatt21.SingleSpin

/-- The bilinear interaction generated by a finite real matrix. -/
def pairForm {ι : Type*} [Fintype ι] (coupling : ι → ι → ℝ)
    (x y : ι → ℝ) : ℝ := ∑ i, ∑ j, coupling i j * (x i * y j)

/-- A reciprocal matrix gives a symmetric bilinear interaction. -/
theorem pair_form_symmetric {ι : Type*} [Fintype ι]
    (coupling : ι → ι → ℝ) (hsymm : ∀ i j, coupling i j = coupling j i)
    (x y : ι → ℝ) : pairForm coupling x y = pairForm coupling y x := by
  classical
  unfold pairForm
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro i _
  apply Finset.sum_congr rfl
  intro j _
  rw [hsymm j i]
  ring

/-- A matrix interaction differentiates by the two-factor product rule. -/
theorem pair_form_has_deriv_at {ι : Type*} [Fintype ι]
    (coupling : ι → ι → ℝ) (x : ℝ → ι → ℝ) (v : ι → ℝ) (t : ℝ)
    (hx : ∀ i, HasDerivAt (fun s => x s i) (v i) t) :
    HasDerivAt (fun s => pairForm coupling (x s) (x s))
      (pairForm coupling v (x t) + pairForm coupling (x t) v) t := by
  classical
  have h := HasDerivAt.fun_sum (u := Finset.univ) (fun i _ =>
    HasDerivAt.fun_sum (u := Finset.univ) (fun j _ =>
      (HasDerivAt.fun_mul (hx i) (hx j)).const_mul (coupling i j)))
  simpa only [pairForm, mul_add, Finset.sum_add_distrib] using h

/-- A quartic on-site energy with reciprocal quadratic interactions. -/
def networkEnergy {ι : Type*} [Fintype ι] (a : ℝ) (coupling : ι → ι → ℝ)
    (x : ι → ℝ) : ℝ :=
  (∑ i, spinPotential a (x i)) - (1 / 2 : ℝ) * pairForm coupling x x

/-- The explicit coordinate gradient of the finite-network energy. -/
def networkGradient {ι : Type*} [Fintype ι] (a : ℝ)
    (coupling : ι → ι → ℝ) (x : ι → ℝ) (i : ι) : ℝ :=
  x i ^ 3 - a * x i - ∑ j, coupling i j * x j

/-- The derivative of the reciprocal network energy is the gradient paired with
the coordinate velocities; no gradient formula is assumed in the proof. -/
theorem network_energy_has_deriv_at {ι : Type*} [Fintype ι]
    (a : ℝ) (coupling : ι → ι → ℝ) (hsymm : ∀ i j, coupling i j = coupling j i)
    (x : ℝ → ι → ℝ) (v : ι → ℝ) (t : ℝ)
    (hx : ∀ i, HasDerivAt (fun s => x s i) (v i) t) :
    HasDerivAt (fun s => networkEnergy a coupling (x s))
      (∑ i, networkGradient a coupling (x t) i * v i) t := by
  classical
  have hpotential := HasDerivAt.fun_sum (u := Finset.univ) (fun i _ =>
    (spin_potential_has_deriv_at a (x t i)).comp t (hx i))
  have hpair : HasDerivAt (fun s => pairForm coupling (x s) (x s))
      (2 * pairForm coupling v (x t)) t := by
    apply (pair_form_has_deriv_at coupling x v t hx).congr_deriv
    rw [pair_form_symmetric coupling hsymm (x t) v]
    ring
  apply HasDerivAt.congr_deriv (HasDerivAt.fun_sub hpotential (hpair.const_mul (1 / 2 : ℝ)))
  rw [show (1 / 2 : ℝ) * (2 * pairForm coupling v (x t)) =
      pairForm coupling v (x t) by ring]
  simp only [networkGradient, spinDrift, pairForm, Finset.sum_mul,
    sub_mul, Finset.sum_sub_distrib]
  have hterm : (∑ i, ∑ j, coupling i j * (v i * x t j)) =
      ∑ i, ∑ j, coupling i j * x t j * v i := by
    apply Finset.sum_congr rfl
    intro i _
    apply Finset.sum_congr rfl
    intro j _
    ring
  rw [hterm]
  have hon : (∑ i, -(a * x t i - x t i ^ 3) * v i) =
      (∑ i, x t i ^ 3 * v i) - ∑ i, a * x t i * v i := by
    rw [← Finset.sum_sub_distrib]
    apply Finset.sum_congr rfl
    intro i _
    ring
  rw [hon]

/-- The explicitly specified gradient ODE dissipates the network energy at a
rate equal to minus the sum of squared coordinate gradients. -/
theorem network_energy_dissipation {ι : Type*} [Fintype ι]
    (a : ℝ) (coupling : ι → ι → ℝ) (hsymm : ∀ i j, coupling i j = coupling j i)
    (x : ℝ → ι → ℝ) (t : ℝ)
    (hx : ∀ i, HasDerivAt (fun s => x s i) (-networkGradient a coupling (x t) i) t) :
    HasDerivAt (fun s => networkEnergy a coupling (x s))
      (-(∑ i, networkGradient a coupling (x t) i ^ 2)) t := by
  apply (network_energy_has_deriv_at a coupling hsymm x
    (fun i => -networkGradient a coupling (x t) i) t hx).congr_deriv
  simp only [← Finset.sum_neg_distrib]
  apply Finset.sum_congr rfl
  intro i _
  ring

/-- Along a solution of the stated gradient ODE, the energy derivative is
nonpositive, providing a genuine Lyapunov inequality. -/
theorem network_energy_deriv_nonpos {ι : Type*} [Fintype ι]
    (a : ℝ) (coupling : ι → ι → ℝ) (hsymm : ∀ i j, coupling i j = coupling j i)
    (x : ℝ → ι → ℝ) (t : ℝ)
    (hx : ∀ i, HasDerivAt (fun s => x s i) (-networkGradient a coupling (x t) i) t) :
    deriv (fun s => networkEnergy a coupling (x s)) t ≤ 0 := by
  rw [(network_energy_dissipation a coupling hsymm x t hx).deriv]
  exact neg_nonpos.mpr (Finset.sum_nonneg (fun _ _ => sq_nonneg _))

end Qatlib.Papers.HydroSpinLatt21.WaveCoupling
