import Qatlib.Concepts.LchsSimulation.StaticLchs.StaticNoncommutingLCHS

/-!
# Cauchy LCHS spectral representation

The definitions `propagator` and `spectralUnitary` fix the sign convention for finite matrix
dynamics: the target is `exp(t(L + i H))`, and each frequency contribution is `exp(i t(H + k
L))`. Conversion lemmas identify these expressions with the existing static evolution API.

For nonpositive Hermitian part and nonnegative time, `diagonalized_lchs_spectral_representation`
gives the Cauchy integral formula used in Theorem 1 of [ZhangEtAl2026], together with
integrability of every matrix entry.

## Main statements

* `spectralUnitary_eq_hamiltonianEvolution` matches the spectral exponential to Hamiltonian
  evolution with the corresponding signs.
* `staticNonunitaryEvolution_neg_neg` matches the target propagator to the static nonunitary
  evolution convention.
* `diagonalized_lchs_spectral_representation` proves the exact Cauchy-weighted spectral
  integral.

## References

- [Zhang et al., 2026][ZhangEtAl2026]
-/

set_option warningAsError false

set_option autoImplicit false
set_option maxHeartbeats 400000
noncomputable section

open Matrix MeasureTheory
open scoped Matrix.Norms.L2Operator BigOperators ComplexOrder

namespace Qatlib.Papers.KoopmanSim26.SpectralRep

open Qatlib.Concepts.LchsSimulation.StaticLchs Qatlib.Foundations.PureStateMath.Reflection
open Qatlib.Concepts.QspSimulation.Achievability

variable {I : Type} [Fintype I] [DecidableEq I]

/-- The matrix `propagator L H t` is the finite-dimensional evolution operator `exp(t(L + i
H))`. -/
noncomputable def propagator (L H : Matrix I I ℂ) (t : ℝ) : Matrix I I ℂ :=
  NormedSpace.exp (t • (L + Complex.I • H))

/-- The matrix `spectralUnitary L H t k` is the frequency-dependent exponential `exp(i t(H + k
L))`, which is unitary when the frequency matrix is Hermitian. -/
noncomputable def spectralUnitary (L H : Matrix I I ℂ) (t k : ℝ) : Matrix I I ℂ :=
  NormedSpace.exp ((Complex.I * (t : ℂ)) • (H + k • L))

/-- The spectral exponential equals Hamiltonian evolution generated by `-H + k(-L)` under the
library's evolution sign convention. -/
lemma spectralUnitary_eq_hamiltonianEvolution (L H : Matrix I I ℂ) (t k : ℝ) :
    spectralUnitary L H t k = hamiltonianEvolution ((-H) + k • (-L)) t := by
  dsimp only [spectralUnitary, hamiltonianEvolution]
  congr 1
  ext i j
  simp only [Matrix.add_apply, Matrix.smul_apply, Matrix.neg_apply, Complex.real_smul]
  ring

/-- Static nonunitary evolution with component data `-L` and `-H` equals `propagator L H t`. -/
lemma staticNonunitaryEvolution_neg_neg (L H : Matrix I I ℂ) (t : ℝ) :
    staticNonunitaryEvolution (-L) (-H) t = propagator L H t := by
  dsimp only [staticNonunitaryEvolution, propagator]
  congr 1
  ext i j
  simp only [Matrix.add_apply, Matrix.smul_apply, Matrix.neg_apply, Complex.real_smul]
  push_cast
  ring

/-- For positive semidefinite `-L`, Hermitian `H`, and nonnegative time, every entry of the
Cauchy-weighted spectral integrand is integrable and its matrix integral equals `exp(t(L + i
H))`. This is the LCHS integral identity of Theorem 1 in [ZhangEtAl2026]. -/
theorem diagonalized_lchs_spectral_representation
    (L H : Matrix I I ℂ) (t : ℝ)
    (hL : (-L).PosSemidef) (hH : H.IsHermitian) (ht : 0 ≤ t) :
    (∀ i j : I, Integrable (fun k : ℝ =>
      ((1/(Real.pi*(1+k^2)) : ℝ) : ℂ) * spectralUnitary L H t k i j)) ∧
    (∫ k : ℝ, (1/(Real.pi*(1+k^2))) • spectralUnitary L H t k) = propagator L H t := by
  obtain ⟨hint, hmain, -⟩ :=
    static_noncommuting_lchs_cauchy_representation I (-L) (-H) t hL hH.neg ht
  refine ⟨fun i j => ?_, ?_⟩
  · have he : (fun k : ℝ => ((1/(Real.pi*(1+k^2)) : ℝ) : ℂ) * spectralUnitary L H t k i j)
        = (fun k : ℝ => ((1/(Real.pi*(1+k^2)) : ℝ) : ℂ) *
            hamiltonianEvolution ((-H) + k • (-L)) t i j) := by
      funext k; rw [spectralUnitary_eq_hamiltonianEvolution]
    rw [he]; exact hint i j
  · have heq : (∫ k : ℝ, (1/(Real.pi*(1+k^2))) • spectralUnitary L H t k) =
        ∫ k : ℝ, (1/(Real.pi*(1+k^2))) • hamiltonianEvolution ((-H) + k • (-L)) t := by
      simp only [spectralUnitary_eq_hamiltonianEvolution]
    rw [heq, hmain, staticNonunitaryEvolution_neg_neg]

end Qatlib.Papers.KoopmanSim26.SpectralRep
