import Mathlib.Analysis.Normed.Algebra.MatrixExponential
import Mathlib.LinearAlgebra.Matrix.Hermitian
import Mathlib.LinearAlgebra.Matrix.NonsingularInverse
import Mathlib.Data.Complex.Basic

set_option backward.isDefEq.respectTransparency false

/-!
# UnitaryEvolution — source model for the linearized Vlasov–Maxwell evolution

Paper: Alexander Engel, Graeme Smith, Scott E. Parker,
"Quantum Algorithm for the Vlasov Equation", fixed arXiv:1907.09418.
Claim `c001` (MainResults): after the spatial Fourier transform and the
variable substitution `f̃' = i√(ξ/f_M) f̃` with `ξ = d³v`, the linearized
Vlasov–Maxwell system is `d|x⟩/dt = -i Ĥ_eff |x⟩` with
`Ĥ_eff = Ĥ_v + Ĥ_l + Ĥ_c`.  The paper proves (Eq. (10), Eq. (11), Eq. (12),
p. 2–3) that each of `Ĥ_v`, `Ĥ_l`, `Ĥ_c` is Hermitian, hence `Ĥ_eff` is
Hermitian, hence the generated evolution is unitary.

This file isolates exactly that algebraic core on a finite velocity/grid
space: a complex matrix `H` that is Hermitian (`Hᴴ = H`) generates the
propagator `exp(t·i·H)`, and this propagator is unitary
(`Uᴴ U = 1` and `U Uᴴ = 1`).  Sums of Hermitian operators stay Hermitian,
so the effective Hamiltonian of the paper indeed generates a unitary.

Boundary: the finite-dimensional grid model is the paper's actual setting
(`N_v` velocity grid cells plus the field register); no spectral theorem,
no continuous-space measure theory and no dynamics of the PDE itself are
assumed.  The exponential is the genuine matrix exponential of Mathlib.
-/

set_option autoImplicit false
noncomputable section

open Matrix
open scoped Matrix

namespace Qatlib.Papers.VlasovEqn19.MainResults.UnitaryEvolution

variable {n : Type*} [Fintype n] [DecidableEq n]

/-- The propagator `U(t) = exp(t·i·H)` of the Schrödinger-type equation
`d|x⟩/dt = -i H |x⟩` (paper Eq. (12), p. 3).  The factor `i = Complex.I`
matches `-i Ĥ_eff` in the paper's evolution equation. -/
def propagator (H : Matrix n n ℂ) (t : ℝ) : Matrix n n ℂ :=
  NormedSpace.exp (((t : ℂ) * Complex.I) • H)

omit [Fintype n] [DecidableEq n] in
/-- A real scalar multiple of `i` times a Hermitian matrix is
skew-Hermitian: `(t·i·H)ᴴ = -(t·i·H)`.  This is the finite-dimensional
form of the observation, used in Eq. (10)–(12) (p. 2–3), that the
Hamiltonian terms are self-adjoint. -/
theorem skew_hermitian_smul (H : Matrix n n ℂ) (hH : H.IsHermitian) (t : ℝ) :
    (((t : ℂ) * Complex.I) • H).conjTranspose = -(((t : ℂ) * Complex.I) • H) := by
  rw [Matrix.conjTranspose_smul, hH.eq]
  have hstar : star ((t : ℂ) * Complex.I) = -((t : ℂ) * Complex.I) := by
    rw [star_mul]
    simp
    ring
  rw [hstar, neg_smul]

/-- The conjugate transpose of the propagator is its inverse.  This is the
key step `U(t)ᴴ = exp(-t·i·H) = U(t)⁻¹` for a Hermitian `H`. -/
theorem propagator_conjTranspose (H : Matrix n n ℂ) (hH : H.IsHermitian) (t : ℝ) :
    (propagator H t).conjTranspose = (propagator H t)⁻¹ := by
  unfold propagator
  calc
    (NormedSpace.exp (((t : ℂ) * Complex.I) • H)).conjTranspose
        = NormedSpace.exp ((((t : ℂ) * Complex.I) • H).conjTranspose) :=
          (Matrix.exp_conjTranspose _).symm
    _ = NormedSpace.exp (-(((t : ℂ) * Complex.I) • H)) := by
          rw [skew_hermitian_smul H hH t]
    _ = (NormedSpace.exp (((t : ℂ) * Complex.I) • H))⁻¹ :=
          Matrix.exp_neg _

/-- For Hermitian `H`, the propagator `U(t) = exp(t·i·H)` is unitary:
both `Uᴴ U = 1` and `U Uᴴ = 1`.  This is the paper's conclusion
(Claim `c001`, p. 3): a Hermitian effective Hamiltonian generates a
unitary time evolution. -/
theorem propagator_unitary (H : Matrix n n ℂ) (hH : H.IsHermitian) (t : ℝ) :
    (propagator H t).conjTranspose * propagator H t = 1 ∧
      propagator H t * (propagator H t).conjTranspose = 1 := by
  have hc : (propagator H t).conjTranspose = (propagator H t)⁻¹ :=
    propagator_conjTranspose H hH t
  have hunit : IsUnit (propagator H t) := by
    unfold propagator
    exact Matrix.isUnit_exp _
  have hdet : IsUnit (propagator H t).det :=
    (Matrix.isUnit_iff_isUnit_det _).mp hunit
  constructor
  · rw [hc, Matrix.nonsing_inv_mul (propagator H t) hdet]
  · rw [hc, Matrix.mul_nonsing_inv (propagator H t) hdet]

omit [Fintype n] [DecidableEq n] in
/-- The effective Hamiltonian `Ĥ_eff = Ĥ_v + Ĥ_l + Ĥ_c` of Eq. (12)
(p. 3) is Hermitian whenever its three summands are. -/
theorem effective_hermitian (Hv Hl Hc : Matrix n n ℂ)
    (hv : Hv.IsHermitian) (hl : Hl.IsHermitian) (hc : Hc.IsHermitian) :
    (Hv + Hl + Hc).IsHermitian :=
  (hv.add hl).add hc

/-- Main result of Claim `c001`: the evolution generated by the Hermitian
effective Hamiltonian `Ĥ_eff = Ĥ_v + Ĥ_l + Ĥ_c` is unitary.  The summands
correspond to the velocity-space term `Ĥ_v` (Eq. (9)), the electromagnetic
field term `Ĥ_l` (Eq. (11)) and the coupling term `Ĥ_c` (Eq. (12)); each is
Hermitian in the paper. -/
theorem effective_evolution_unitary (Hv Hl Hc : Matrix n n ℂ)
    (hv : Hv.IsHermitian) (hl : Hl.IsHermitian) (hc : Hc.IsHermitian) (t : ℝ) :
    let U := propagator (Hv + Hl + Hc) t
    U.conjTranspose * U = 1 ∧ U * U.conjTranspose = 1 :=
  propagator_unitary (Hv + Hl + Hc) (effective_hermitian Hv Hl Hc hv hl hc) t

/-- The propagator of the zero Hamiltonian is the identity, the `t = 0`
anchor of the evolution group. -/
theorem propagator_zero_hamiltonian (t : ℝ) :
    propagator (0 : Matrix n n ℂ) t = 1 := by
  unfold propagator
  simp

end Qatlib.Papers.VlasovEqn19.MainResults.UnitaryEvolution
