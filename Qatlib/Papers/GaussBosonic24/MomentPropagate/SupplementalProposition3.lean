import Qatlib.Papers.GaussBosonic24.MomentPropagate.SourceModel

set_option backward.isDefEq.respectTransparency false

/-!
# Supplemental Proposition 3 (non-particle-preserving generators)

Paper: *Gate-based quantum simulation of Gaussian bosonic circuits on
exponentially many modes*, fixed arXiv:2407.06290 (2024), Supplemental
Information Appendix A.4, Supplemental Proposition 3, Eqs. (A38)–(A39).

The paper's statement (SI p. 11): for a gate generator

`Ĥ = Σ_{m,m'} Δ†_{mm'} â_m â_{m'} + Σ_{m,m'} Δ_{mm'} â†_m â†_{m'}`   (A38)

with `Δ` a symmetric matrix, one has `{Ω, K} = 0`, and the propagator `e^{tΩK}`
is an imaginary-time evolution under the effective Hamiltonian `-Ω K`.

Route followed (Eq. (A39)): rewriting in quadratures gives

`Ĥ = Σ Re[Δ_{mm'}] (q̂_m q̂_{m'} − p̂_m p̂_{m'})
     + Σ Im[Δ_{mm'}] (q̂_m p̂_{m'} + p̂_m q̂_{m'})`,

so the real symmetric matrix `K` has the block structure

`K = [[Re Δ, Im Δ], [Im Δ, -Re Δ]]`

on the phase-space split.  The conclusions are block-matrix identities:
`Ω K + K Ω = 0`, and `Ω K` is Hermitian, so `e^{tΩK} = e^{-t(−ΩK)}` is the
imaginary-time evolution generated by the Hermitian `−ΩK` (Eq. (A26)).
-/

set_option autoImplicit false
noncomputable section

open Matrix

namespace Qatlib.Papers.GaussBosonic24.MomentPropagate

variable {M : ℕ}

/-- **Supplemental Proposition 3, anticommutation half.**  For a symmetric
coefficient matrix `Δ`, the phase-space generator `K(Δ)` of Eq. (A39)
anticommutes with the symplectic form: `{Ω, K} = 0`. -/
theorem nonParticleK_anticommutes_omega {Δ : Matrix (Fin M) (Fin M) ℂ} (_hΔ : Δᵀ = Δ) :
    omega M * nonParticleK Δ + nonParticleK Δ * omega M = 0 := by
  rw [omega, nonParticleK, fromBlocks_multiply, fromBlocks_multiply, fromBlocks_add]
  simp

/-- The generator `Ω K(Δ)` of a non-particle-preserving gate is Hermitian. -/
theorem nonParticle_omegaK_isHermitian {Δ : Matrix (Fin M) (Fin M) ℂ} (hΔ : Δᵀ = Δ) :
    (omega M * nonParticleK Δ).IsHermitian := by
  have hre := rePart_transpose_of_transpose hΔ
  have him := imPart_transpose_of_transpose hΔ
  -- `Ω K` is the real symmetric block matrix `[[Im Δ, -Re Δ], [-Re Δ, -Im Δ]]`
  have hreH : (rePart Δ)ᴴ = rePart Δ := by
    rw [rePart_conjTranspose, hre]
  have himH : (imPart Δ)ᴴ = imPart Δ := by
    rw [imPart_conjTranspose, him]
  rw [Matrix.IsHermitian, omega, nonParticleK, fromBlocks_multiply]
  simp only [Matrix.zero_mul, Matrix.one_mul, Matrix.mul_one,
    Matrix.neg_mul, Matrix.mul_neg, zero_add, add_zero, neg_neg]
  rw [fromBlocks_conjTranspose]
  simp only [Matrix.conjTranspose_neg, Matrix.conjTranspose_add, Matrix.conjTranspose_zero,
    neg_zero, add_zero, himH, hreH, neg_neg]

/-- Imaginary-time evolution under a generator `H`: `e^{-tH}`. -/
def imaginaryTimeEvolution {I : Type*} [Fintype I] [DecidableEq I] (H : Matrix I I ℂ)
    (t : ℝ) : Matrix I I ℂ :=
  NormedSpace.exp ((-(t : ℂ)) • H)

/-- **Supplemental Proposition 3, propagator half.**  For symmetric `Δ` and real
`t`, the phase-space propagator `e^{tΩK}` is the imaginary-time evolution under
the effective Hamiltonian `−Ω K`: `e^{tΩK} = e^{-t(−ΩK)}`. -/
theorem nonParticle_propagator_eq_imaginaryTimeEvolution {Δ : Matrix (Fin M) (Fin M) ℂ}
    (_hΔ : Δᵀ = Δ) (t : ℝ) :
    NormedSpace.exp ((t : ℂ) • (omega M * nonParticleK Δ)) =
      imaginaryTimeEvolution (-(omega M * nonParticleK Δ)) t := by
  unfold imaginaryTimeEvolution
  congr 1
  rw [smul_neg, neg_smul, neg_neg]

end Qatlib.Papers.GaussBosonic24.MomentPropagate
