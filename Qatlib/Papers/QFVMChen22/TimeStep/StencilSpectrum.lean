module

public import Qatlib.Papers.QFVMChen22.TimeStep.ReciprocalReadout
public import Qatlib.Concepts.QlsReadoutSpec.WalkQSVT.WalkSpectralResolutionLows

@[expose] public section

/-!
# Spectral branches of the encoded finite-volume stencil

[ChenXueChenEtAl2022], Appendix C.3, invokes the gapped phase estimation
of [ChildsKothariSomma2017], Section 5. This module obtains the phases
available to a phase discriminator directly from the stencil's sparse
walk. It gives the two interior branches and the endpoint terms on the
invariant support generated by the embedded stencil eigenbasis.
Spectral threshold classification and stopping circuits require
additional definitions.

[Published paper](https://doi.org/10.1007/s11128-022-03478-w)
-/

set_option autoImplicit false

noncomputable section

namespace Qatlib.Papers.QFVMChen22.TimeStep

open Matrix
open Qatlib.Concepts.Execution.WorkspaceCP (IsIsometry)
open Qatlib.Concepts.PolynomialCalc.QubitizedPower (signal walk walk_unitary)
open Qatlib.Concepts.QlsReadoutSpec.WalkQSVT (Clause12WalkSpectralResolution_answer walkBranch walkSupport)
open Qatlib.Concepts.QsvtCore.PhaseExistence (sparseAlpha)
open Qatlib.Foundations.PureStateMath (Normalized)
open Qatlib.Concepts.QlsReadoutSpec.Amplification (pureDensity)
open Qatlib.Foundations.QramData.SquaredNormTree (Address)
open Qatlib.Papers.QFVMChen22.QramStorage (Geometry)
open scoped BigOperators Classical

variable {depth columnSlots : ℕ}

/-- The actual sparse stencil walk has normalized interior phase branches with angles
`± arccos λ`, and its spectral decomposition on the generated support includes both
endpoint signs. -/
theorem stencil_walk_spectral_resolution (geometry : Geometry depth)
    (coefficients : Address depth → Fin geometry.stencilSize → ℝ) (entryScale : ℝ)
    (rowScratch : Fin geometry.stencilSize) (columnScratch : Fin columnSlots)
    (hScale : 0 < entryScale)
    (hEntry : ∀ row column, |stencilMatrix geometry coefficients row column| ≤ entryScale)
    (hColumns : ∀ column, (geometry.affected column).dedup.length ≤ columnSlots) :
    let G := stencilWalkFrame depth rowScratch columnScratch
    let U := stencilWalkInvolution geometry coefficients entryScale rowScratch columnScratch
    let h := stencil_signal_hermitian geometry coefficients (entryScale * sparseAlpha geometry.stencilSize columnSlots)
    let S : Matrix (Address depth ⊕ Address depth) (Address depth ⊕ Address depth) ℂ := h.eigenvectorUnitary
    let eigenvalue := h.eigenvalues
    let v := fun i => G *ᵥ (fun j => S j i)
    walk G U ∈ Matrix.unitaryGroup (StencilWorkspace depth geometry.stencilSize columnSlots) ℂ ∧
      (∀ i, |eigenvalue i| < 1 → ∀ neg : Bool, Normalized (walkBranch U (v i) (eigenvalue i) neg) ∧
        walk G U *ᵥ walkBranch U (v i) (eigenvalue i) neg =
          Complex.exp (Complex.I * (if neg then -Real.arccos (eigenvalue i) else Real.arccos (eigenvalue i))) •
            walkBranch U (v i) (eigenvalue i) neg) ∧
      walk G U * walkSupport U G S eigenvalue =
        ∑ i, if |eigenvalue i| = 1 then (eigenvalue i : ℂ) • pureDensity (v i) else
          Complex.exp (Complex.I * Real.arccos (eigenvalue i)) • pureDensity (walkBranch U (v i) (eigenvalue i) false) +
            Complex.exp (-Complex.I * Real.arccos (eigenvalue i)) • pureDensity (walkBranch U (v i) (eigenvalue i) true) := by
  intro G U h S eigenvalue v
  obtain ⟨hG, hSelf, hSq, hSignal⟩ :=
    stencil_walk_encoding geometry coefficients entryScale rowScratch columnScratch hScale hEntry hColumns
  have hG' : Gᴴ * G = 1 := hG
  have hSelf' : Uᴴ = U := hSelf
  have hSq' : U * U = 1 := hSq
  have hUnitary : U ∈ Matrix.unitaryGroup (StencilWorkspace depth geometry.stencilSize columnSlots) ℂ := by
    rw [Matrix.mem_unitaryGroup_iff, Matrix.star_eq_conjTranspose, hSelf', hSq']
  have hTwo : Gᴴ * U ^ 2 * G = 1 := by rw [pow_two, hSq', Matrix.mul_one, hG']
  have hDiag : Gᴴ * U * G = S * diagonal (fun i => (eigenvalue i : ℂ)) * Sᴴ := by
    change signal G U = _
    change signal G U = _ at hSignal
    rw [hSignal]
    change _ = S * diagonal (Complex.ofReal ∘ eigenvalue) * Sᴴ
    simpa only [Unitary.conjStarAlgAut_apply, Matrix.star_eq_conjTranspose,
      RCLike.ofReal_eq_complex_ofReal, S, eigenvalue] using h.spectral_theorem
  obtain ⟨_, _, _, _, _, _, _, hBranches, hResolution⟩ :=
    Clause12WalkSpectralResolution_answer _ _ U G S eigenvalue hUnitary (show IsIsometry G from hG')
      h.eigenvectorUnitary.property hTwo hDiag
  have hWalk : Qatlib.Concepts.QlsReadoutSpec.WalkQSVT.walk G U = walk G U := by
    simp [Qatlib.Concepts.QlsReadoutSpec.WalkQSVT.walk, walk, two_smul,
      Qatlib.Foundations.MatrixGeometry.StochasticFrame.rangeReflection]
  refine ⟨?_, ?_, ?_⟩
  · rw [Matrix.mem_unitaryGroup_iff', Matrix.star_eq_conjTranspose]
    exact walk_unitary G U hG' hSelf' hSq'
  · intro i hi neg
    simpa only [v, hWalk] using (hBranches i hi).2.2.2.2.2 neg
  · simpa only [v, hWalk] using hResolution

end Qatlib.Papers.QFVMChen22.TimeStep
