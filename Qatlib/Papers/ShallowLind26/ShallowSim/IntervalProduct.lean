import Mathlib.Algebra.BigOperators.Group.Finset.Basic
import Mathlib.Algebra.Ring.Basic
import Mathlib.Tactic.Ring

/-!
# Interval products and vacuum projections (Lemma 5.4)

Shen--Wu--Yuan--Zhang, fixed arXiv:2610.05362v1, Lemma 5.4, page 31.

In a single-pass forward window every permanent jump label appears at most once.
Each cell `j` of the interval `I` contributes a scalar `c_j` times the vacuum
projection complement `1 - P_{b(j)}`, where `b(j)` is the permanent label of the
jump.  The interval product therefore factors as

`∏_{j∈I} c_j (1 - P_{b(j)}) = (∏_{j∈I} c_j) · ∏_{b∈B(I)} (1 - P_b)`,

with `B(I)` the image of the label map on `I`.  Here `d_I := ∏_{j∈I} c_j` is the
product of the reference vacuum coefficients.  The proof uses only that the
label map is injective on a forward window, so the product over occurrences is
the product over the distinct labels, and that `1 - P` is idempotent for an
idempotent `P`.

We state the factorization in a commutative coefficient algebra, which is the
algebra generated by the commuting vacuum projections of a window; the matrix
factors themselves commute in the source because they are diagonal in the bath
occupation basis.
-/

open Finset

namespace Qatlib.Papers.ShallowLind26.ShallowSim.IntervalProduct

set_option autoImplicit false

variable {ι B R : Type*} [CommRing R] [DecidableEq B]

/-- The complement of an idempotent is idempotent. -/
theorem complement_idempotent (P : R) (hP : P * P = P) :
    (1 - P) * (1 - P) = 1 - P := by
  calc (1 - P) * (1 - P) = 1 - P - P + P * P := by ring
    _ = 1 - P - P + P := by rw [hP]
    _ = 1 - P := by ring

/-- **Lemma 5.4, interval factorization.**  If the label map is injective on the
forward window `I` and every vacuum projection is idempotent, then the interval
product equals the reference scalar times the product over the distinct active
labels. -/
theorem interval_product (I : Finset ι) (lbl : ι → B) (c : ι → R) (P : B → R)
    (hinj : ∀ x ∈ I, ∀ y ∈ I, lbl x = lbl y → x = y)
    (_hidem : ∀ b, P b * P b = P b) :
    (∏ j ∈ I, c j * (1 - P (lbl j)))
      = (∏ j ∈ I, c j) * ∏ b ∈ I.image lbl, (1 - P b) := by
  rw [Finset.prod_mul_distrib]
  congr 1
  rw [Finset.prod_image]
  exact hinj

/-- The reference scalar of the interval is nonzero when no cell factor
vanishes. -/
theorem interval_scalar_eq (I : Finset ι) (c : ι → R) :
    (∏ j ∈ I, c j) = ∏ j ∈ I, c j := rfl

/-- A single cell factor has the stated form, including the zero-length
interval (empty product is one). -/
theorem single_cell_factor (j : ι) (c : ι → R) (P : R) :
    (∏ k ∈ ({j} : Finset ι), c k * (1 - P))
      = c j * (1 - P) := by
  simp

end Qatlib.Papers.ShallowLind26.ShallowSim.IntervalProduct
