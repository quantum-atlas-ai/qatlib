module

public import Qatlib.Papers.ExactSimon97.MainResults.GenExpect
public import Mathlib.Data.Nat.Find

@[expose] public section

/-!
# Finite-window subgroup generation: the uniform sampling process and its
first-generation stopping time

Section 2 of [BrassardHoyer1997] (pp. 2–3) backs the expected-polytime
(ZQP) reading of the exact Simon algorithm with the observation that independent
uniform samples of a finite Abelian group `H` generate `H` after at most
`2 log₂ |H|` samples in expectation. The existing module
`Qatlib.Papers.ExactSimon97.MainResults.GenExpect` bounds the truncated tail
sums of the generation-failure probabilities `failProbAt`; the claim record
explicitly keeps the *real stopping law* open.

This module supplies the first executable slice of that stopping law, entirely
within the repo's finite-distribution idiom (`Qatlib.Concepts.MonteCarloMean.FinDistBounds.FinDist.probOf` windows of an iid
uniform law `unifOnSub H` on a subgroup):

* iid sampling process: `firsts` selects the first `k ≤ L` coordinates of an
  `L`-sample window, `probEvent_firsts` proves marginal consistency — the
  probability of any `k`-sample event computed on the `L`-window equals its
  probability on the `k`-window — and `probOf_perm`/`probEvent_perm` prove
  coordinate-exchange invariance (the sample sequence is exchangeable).
* stopping time: `spanPrefix` is the subgroup generated by the first `k` draws,
  and `stopGen` is the first-generation time — the first moment at which the
  running span equals `H`, censored at the window length `L` when generation
  has not happened inside the window. Each growth step of the running span is
  exactly a draw landing outside the span generated so far (`span_escape`).
* tail-probability identification: `escape_null` shows that records with a draw
  escaping `H` within the first `k` positions form a null event under the
  uniform law, and `probEvent_stopGen_gt` identifies the tail probability
  `P(k < stopGen)` with the generation-failure probability `failProbAt H k`.
* tail-sum decomposition: `tailsum_eq` is the generic layer-cake identity
  `E[T] = Σ_{k<L} P(T > k)` for any window functional bounded by `L`, and
  `stopGen_tailsum` specializes it to
  `E[stopGen] = Σ_{k<L} failProbAt H k`. `stopGen_expect_le` composes this
  identity with `expected_le_two_log`.

Boundary: this module proves the tail-sum *decomposition identity* for the
window-censored first-generation time of the idealized uniform sampling
process. The full closed-form expectation of the uncensored stopping time of an
infinite sampling process — the infinite-product law, the monotone convergence
of the censored times, the exact series identity `E[T] = ∑' k, failProbAt H k`
and the bound `E[T] ≤ 2 log₂ |H|` — is constructed in the sibling module
`Qatlib.Papers.ExactSimon97.SampleStoppingInf`; within the present module
`stopGen_expect_le` remains a statement about the `L`-censored time on the
`L`-sample window, not about a complete expectation. The real quantum sampler
semantics is constructed in the sibling module
`Qatlib.Papers.ExactSimon97.SampleStoppingQuantum`; the present module's
idealized `unifOnSub` process is the probability interface to which that executable
query-then-Fourier sampler is proved equivalent.
-/

set_option autoImplicit false
set_option warningAsError true
set_option maxHeartbeats 400000

open scoped BigOperators Classical

namespace Qatlib.Papers.ExactSimon97.SampleStopping

open Qatlib.Concepts.MonteCarloMean.FinDistBounds
open Qatlib.Concepts.MonteCarloMean.FinDistBounds.FinDist
open Qatlib.Concepts.StabilizerAlg.NearUniformGen
open Qatlib.Papers.NoncommHSP98.MainResults
open Qatlib.Papers.ExactSimon97.MainResults

/-! ## The iid sampling process on finite windows -/

section Process

variable {X : Type*} [Fintype X] [DecidableEq X]

/-- The first `k` coordinates of an `L`-sample window, for `k ≤ L`: the `k`
prefix of the sampling process. -/
def firsts {k L : ℕ} (h : k ≤ L) (ω : Fin L → X) : Fin k → X :=
  fun i => ω (Fin.castLE h i)

omit [Fintype X] [DecidableEq X] in
/-- The range of the `k`-prefix of a window is the image of the first `k`
window positions: the bridge between prefix events and record-range events. -/
theorem range_firsts {k L : ℕ} (h : k ≤ L) (ω : Fin L → X) :
    Set.range (firsts h ω) = ω '' {i : Fin L | (i : ℕ) < k} := by
  ext x
  simp only [Set.mem_range, Set.mem_image]
  constructor
  · rintro ⟨j, rfl⟩
    exact ⟨Fin.castLE h j, by simp, rfl⟩
  · rintro ⟨i, hi, rfl⟩
    refine ⟨⟨(i : ℕ), hi⟩, ?_⟩
    have hci : Fin.castLE h ⟨(i : ℕ), hi⟩ = i :=
      Fin.val_injective (Fin.val_castLE h _)
    simp only [firsts, hci]

omit [DecidableEq X] in
/-- An event probability equals the probability-weighted sum of its indicator:
the bookkeeping form used for the exchangeability and layer-cake arguments. -/
theorem probEvent_eq_indicator {L : ℕ} (p : FinDist X) (E : (Fin L → X) → Prop)
    [DecidablePred E] :
    FinDist.probEvent (L := L) p E =
      ∑ ω : Fin L → X, p.probOf ω * (if E ω then (1 : ℝ) else 0) := by
  classical
  unfold FinDist.probEvent
  rw [Finset.sum_filter]
  refine Finset.sum_congr rfl (fun ω _ => ?_)
  by_cases hE : E ω <;> simp [hE]

/-- The total mass of the fiber of the prefix map `firsts h` over a fixed
`k`-record `η` equals the `k`-record mass of `η`: summing out the free
coordinates of an `L`-window leaves the `k`-window law untouched. -/
theorem fiber_probOf {k L : ℕ} (h : k ≤ L) (p : FinDist X) (η : Fin k → X) :
    ∑ ω ∈ (Finset.univ : Finset (Fin L → X)).filter (fun ω => firsts h ω = η),
        FinDist.probOf (L := L) p ω = FinDist.probOf (L := k) p η := by
  classical
  have hfiber : (Finset.univ : Finset (Fin L → X)).filter (fun ω => firsts h ω = η) =
      Fintype.piFinset
        (fun i : Fin L =>
          if hi : (i : ℕ) < k then ({η ⟨(i : ℕ), hi⟩} : Finset X) else Finset.univ) := by
    ext ω
    simp only [Finset.mem_filter, Finset.mem_univ, true_and, Fintype.mem_piFinset]
    constructor
    · intro hm i
      by_cases hi : (i : ℕ) < k
      · rw [dite_eq_left hi, Finset.mem_singleton]
        have hci : Fin.castLE h ⟨(i : ℕ), hi⟩ = i :=
          Fin.val_injective (Fin.val_castLE h _)
        have hfun := congrFun hm ⟨(i : ℕ), hi⟩
        simp only [firsts] at hfun
        rw [hci] at hfun
        exact hfun
      · rw [dite_eq_right hi]
        exact Finset.mem_univ _
    · intro hm
      funext j
      have hlt : ((Fin.castLE h j : Fin L) : ℕ) < k := by simp
      have hmem := hm (Fin.castLE h j)
      rw [dite_eq_left hlt, Finset.mem_singleton] at hmem
      simp only [firsts]
      rw [hmem]
      exact congrArg η (Fin.val_injective (Fin.val_castLE h j))
  rw [hfiber]
  unfold FinDist.probOf
  have hfacK : ∀ j : Fin k,
      (∑ x ∈ (if hi : ((Fin.castLE h j : Fin L) : ℕ) < k then
          {η ⟨((Fin.castLE h j : Fin L) : ℕ), hi⟩} else Finset.univ), p.prob x) =
        p.prob (η j) := by
    intro j
    have hlt : ((Fin.castLE h j : Fin L) : ℕ) < k := by simp
    rw [dite_eq_left hlt, Finset.sum_singleton]
    exact congrArg (p.prob ∘ η) (Fin.val_injective (Fin.val_castLE h j))
  have hfac1 : ∀ i : Fin L, ¬((i : ℕ) < k) →
      (∑ x ∈ (if hi : (i : ℕ) < k then {η ⟨(i : ℕ), hi⟩} else Finset.univ), p.prob x) = 1 := by
    intro i hi
    rw [dite_eq_right hi]
    exact p.sum_one
  have hinj : Set.InjOn (Fin.castLE h) (↑(Finset.univ : Finset (Fin k))) := by
    intro a _ b _ hab
    refine Fin.val_injective ?_
    rw [← Fin.val_castLE h a, ← Fin.val_castLE h b]
    exact congrArg Fin.val hab
  have himg : ((Finset.univ : Finset (Fin k)).image (Fin.castLE h) : Finset (Fin L)) =
      (Finset.univ : Finset (Fin L)).filter (fun i : Fin L => (i : ℕ) < k) := by
    ext i
    simp only [Finset.mem_image, Finset.mem_filter, Finset.mem_univ, true_and]
    constructor
    · rintro ⟨j, -, rfl⟩
      simp
    · intro hi
      refine ⟨⟨(i : ℕ), hi⟩, ?_⟩
      have hval : ((Fin.castLE h ⟨(i : ℕ), hi⟩ : Fin L) : ℕ) = (i : ℕ) :=
        Fin.val_castLE h _
      exact Fin.val_injective hval
  have hstep1 : (∏ i : Fin L,
      ∑ x ∈ (if hi : (i : ℕ) < k then {η ⟨(i : ℕ), hi⟩} else Finset.univ), p.prob x)
      = ∏ i ∈ (Finset.univ : Finset (Fin L)).filter (fun i : Fin L => (i : ℕ) < k),
          ∑ x ∈ (if hi : (i : ℕ) < k then {η ⟨(i : ℕ), hi⟩} else Finset.univ), p.prob x :=
    (Finset.prod_subset
      (Finset.filter_subset (fun i : Fin L => (i : ℕ) < k) Finset.univ)
      (fun i _ hi => hfac1 i
        (fun hc => hi (Finset.mem_filter.mpr ⟨Finset.mem_univ i, hc⟩)))).symm
  have hstep2 : (∏ i ∈ (Finset.univ : Finset (Fin L)).filter (fun i : Fin L => (i : ℕ) < k),
      ∑ x ∈ (if hi : (i : ℕ) < k then {η ⟨(i : ℕ), hi⟩} else Finset.univ), p.prob x)
      = ∏ j : Fin k,
          ∑ x ∈ (if hi : ((Fin.castLE h j : Fin L) : ℕ) < k then
            {η ⟨((Fin.castLE h j : Fin L) : ℕ), hi⟩} else Finset.univ), p.prob x := by
    rw [← himg, Finset.prod_image hinj]
  calc ∑ ω ∈ Fintype.piFinset
        (fun i : Fin L =>
          if hi : (i : ℕ) < k then ({η ⟨(i : ℕ), hi⟩} : Finset X) else Finset.univ),
        ∏ i, p.prob (ω i)
      = ∏ i : Fin L,
          ∑ x ∈ (if hi : (i : ℕ) < k then {η ⟨(i : ℕ), hi⟩} else Finset.univ), p.prob x :=
        (Finset.prod_univ_sum
          (fun i : Fin L =>
            if hi : (i : ℕ) < k then ({η ⟨(i : ℕ), hi⟩} : Finset X) else Finset.univ)
          (fun _ => p.prob)).symm
    _ = ∏ j : Fin k, p.prob (η j) := by
        rw [hstep1, hstep2]
        exact Finset.prod_congr rfl (fun j _ => hfacK j)

/-- Marginal consistency of the iid sampling process: for `k ≤ L`, the
probability of any `k`-sample event `E`, evaluated on the `L`-window law
through the prefix `firsts`, equals the probability of `E` on the `k`-window
law. Together with `probEvent_perm` this is the iid/exchangeability property of
the uniform sample sequence. -/
theorem probEvent_firsts {k L : ℕ} (h : k ≤ L) (p : FinDist X)
    (E : (Fin k → X) → Prop) [DecidablePred E]
    [DecidablePred (fun ω : Fin L → X => E (firsts h ω))] :
    FinDist.probEvent (L := L) p (fun ω => E (firsts h ω)) =
      FinDist.probEvent (L := k) p E := by
  classical
  unfold FinDist.probEvent
  have hmaps : ∀ ω ∈ (Finset.univ : Finset (Fin L → X)).filter
      (fun ω => E (firsts h ω)),
      firsts h ω ∈ (Finset.univ : Finset (Fin k → X)).filter E := by
    intro ω hω
    exact Finset.mem_filter.mpr ⟨Finset.mem_univ _, (Finset.mem_filter.mp hω).2⟩
  rw [← Finset.sum_fiberwise_of_maps_to hmaps
    (fun ω : Fin L → X => FinDist.probOf (L := L) p ω)]
  refine Finset.sum_congr rfl ?_
  intro η hη
  have hfiberE : ((Finset.univ : Finset (Fin L → X)).filter
      (fun ω => E (firsts h ω))).filter (fun ω => firsts h ω = η) =
      (Finset.univ : Finset (Fin L → X)).filter (fun ω => firsts h ω = η) := by
    ext ω
    simp only [Finset.mem_filter, Finset.mem_univ, true_and]
    exact ⟨fun hh => hh.2, fun hh => ⟨by rw [hh]; exact (Finset.mem_filter.mp hη).2, hh⟩⟩
  rw [hfiberE]
  exact fiber_probOf h p η

omit [DecidableEq X] in
/-- The window law of an iid sample record is invariant under coordinate
permutations: the record mass of `ω ∘ e` equals the record mass of `ω`. -/
theorem probOf_perm {L : ℕ} (p : FinDist X) (e : Fin L ≃ Fin L) (ω : Fin L → X) :
    FinDist.probOf (L := L) p (fun i => ω (e i)) = FinDist.probOf (L := L) p ω := by
  unfold FinDist.probOf
  exact Equiv.prod_comp e (fun i => p.prob (ω i))

omit [DecidableEq X] in
/-- Exchangeability of the sample sequence: the probability of an event is
unchanged when the sample record is read through a coordinate permutation. -/
theorem probEvent_perm {L : ℕ} (p : FinDist X) (e : Fin L ≃ Fin L)
    (E : (Fin L → X) → Prop) [DecidablePred E]
    [DecidablePred (fun ω : Fin L → X => E (fun i => ω (e i)))] :
    FinDist.probEvent (L := L) p (fun ω => E (fun i => ω (e i))) =
      FinDist.probEvent (L := L) p E := by
  classical
  unfold FinDist.probEvent
  refine Finset.sum_bij (fun ω _ => fun i => ω (e i)) ?_ ?_ ?_ ?_
  · intro ω hω
    exact Finset.mem_filter.mpr ⟨Finset.mem_univ _, (Finset.mem_filter.mp hω).2⟩
  · intro a₁ _ a₂ _ hab
    funext j
    simpa using congrFun hab (e.symm j)
  · intro σ hσ
    refine ⟨fun j => σ (e.symm j), Finset.mem_filter.mpr ⟨Finset.mem_univ _, ?_⟩, ?_⟩
    · simp only [Equiv.symm_apply_apply]
      exact (Finset.mem_filter.mp hσ).2
    · funext j
      simp
  · intro ω _
    exact (probOf_perm p e ω).symm

/-! ## Expectation of window functionals and the layer-cake identity -/

/-- The expectation of a natural-valued functional of an `L`-sample window
under the window law of `p`. -/
def expectRecord {L : ℕ} (p : FinDist X) (T : (Fin L → X) → ℕ) : ℝ :=
  ∑ ω : Fin L → X, p.probOf ω * (T ω : ℝ)

/-- Counting identity: a natural number `m ≤ L` counts the indices `k < L`
below it. -/
theorem count_indicator (m L : ℕ) (h : m ≤ L) :
    (m : ℝ) = ∑ k ∈ Finset.range L, (if k < m then (1 : ℝ) else 0) := by
  have hfilter : (Finset.range L).filter (fun k => k < m) = Finset.range m := by
    ext k
    simp only [Finset.mem_filter, Finset.mem_range]
    omega
  have hsum : (∑ k ∈ Finset.range L, (if k < m then (1 : ℝ) else 0)) =
      ∑ _k ∈ (Finset.range L).filter (fun k => k < m), (1 : ℝ) := by
    rw [Finset.sum_filter]
  have hones : (∑ _k ∈ Finset.range m, (1 : ℝ)) = (m : ℝ) := by
    rw [Finset.sum_const, Finset.card_range, Nat.smul_one_eq_cast]
  rw [hsum, hfilter, hones]

omit [DecidableEq X] in
/-- The layer-cake (tail-sum) identity for window functionals bounded by the
window length: `E[T] = Σ_{k<L} P(T > k)`. This is the decomposition identity
through which every expectation statement about the stopping time must pass. -/
theorem tailsum_eq {L : ℕ} (p : FinDist X) (T : (Fin L → X) → ℕ) (hT : ∀ ω, T ω ≤ L) :
    expectRecord p T =
      ∑ k ∈ Finset.range L,
        FinDist.probEvent (L := L) p (fun ω => k < T ω) := by
  classical
  unfold expectRecord
  have hcount : ∀ ω : Fin L → X, (T ω : ℝ) =
      ∑ k ∈ Finset.range L, (if k < T ω then (1 : ℝ) else 0) :=
    fun ω => count_indicator (T ω) L (hT ω)
  have hexpand : (∑ ω : Fin L → X, p.probOf ω * (T ω : ℝ)) =
      ∑ ω : Fin L → X, ∑ k ∈ Finset.range L,
        p.probOf ω * (if k < T ω then (1 : ℝ) else 0) :=
    Finset.sum_congr rfl (fun ω _ => by rw [hcount ω, Finset.mul_sum])
  rw [hexpand, Finset.sum_comm]
  exact Finset.sum_congr rfl
    (fun k _ => (probEvent_eq_indicator p (fun ω => k < T ω)).symm)

end Process

/-! ## The running span and the first-generation stopping time -/

section Stopping

variable {G : Type} [AddCommGroup G] [Fintype G] [DecidableEq G]

/-- The subgroup generated by the first `k` draws of a sample window: the
running span of the sampling process. -/
def spanPrefix {L : ℕ} (ω : Fin L → G) (k : ℕ) : AddSubgroup G :=
  AddSubgroup.closure (ω '' {i : Fin L | (i : ℕ) < k})

omit [Fintype G] [DecidableEq G] in
/-- The running span is monotone: generating with more draws can only
enlarge the subgroup. -/
theorem spanPrefix_mono {L : ℕ} (ω : Fin L → G) {i j : ℕ} (hij : i ≤ j) :
    spanPrefix ω i ≤ spanPrefix ω j := by
  refine AddSubgroup.closure_mono ?_
  intro x hx
  obtain ⟨i', hi1, hi2⟩ := hx
  exact ⟨i', lt_of_lt_of_le hi1 hij, hi2⟩

omit [Fintype G] [DecidableEq G] in
/-- If every one of the first `k` draws lies in a subgroup `K`, then the
running span after `k` draws is contained in `K`. -/
theorem spanPrefix_le {L : ℕ} (ω : Fin L → G) (k : ℕ) (K : AddSubgroup G)
    (hmem : ∀ i : Fin L, (i : ℕ) < k → ω i ∈ K) : spanPrefix ω k ≤ K := by
  refine (AddSubgroup.closure_le K).2 ?_
  intro x hx
  obtain ⟨i', hi1, hi2⟩ := hx
  exact hi2 ▸ hmem i' hi1

/-- The first-generation stopping time of the sampling process with respect to
a subgroup `H`: the first moment `j ≤ L` at which the first `j` draws generate
`H`, censored at the window length `L` when generation does not happen inside
the window. Each strict growth of the running span on the way is exactly a
draw landing outside the span generated so far (see `span_escape`). -/
noncomputable def stopGen (H : AddSubgroup G) {L : ℕ} (ω : Fin L → G) : ℕ :=
  if hex : ∃ j, j ≤ L ∧ spanPrefix ω j = H then Nat.find hex else L

omit [Fintype G] [DecidableEq G] in
/-- The censored first-generation time never exceeds its window. -/
theorem stopGen_le (H : AddSubgroup G) {L : ℕ} (ω : Fin L → G) :
    stopGen H ω ≤ L := by
  unfold stopGen
  split_ifs with hex
  · exact (Nat.find_spec hex).1
  · exact le_refl L

omit [Fintype G] [DecidableEq G] in
/-- If the first `k ≤ L` draws already generate `H`, the first-generation
time is at most `k`. -/
theorem stopGen_le_of_span (H : AddSubgroup G) {L : ℕ} (ω : Fin L → G) (k : ℕ)
    (hk : k ≤ L) (hspan : spanPrefix ω k = H) : stopGen H ω ≤ k := by
  unfold stopGen
  split_ifs with hex
  · exact Nat.find_min' hex ⟨hk, hspan⟩
  · exact absurd ⟨k, hk, hspan⟩ hex

omit [Fintype G] [DecidableEq G] in
/-- Growth dichotomy: if after `k < L` draws the running span is still not
`H`, then either generation happens strictly after `k`, or some draw among the
first `k` escaped the ambient subgroup `H` (a null event under the uniform
law by `escape_null`). This is the only way the tail event `spanPrefix ω k ≠ H`
and the event `k < stopGen H ω` can disagree. -/
theorem span_escape (H : AddSubgroup G) {L : ℕ} (ω : Fin L → G) (k : ℕ) (hk : k < L)
    (hspan : spanPrefix ω k ≠ H) :
    k < stopGen H ω ∨ ∃ i : Fin L, (i : ℕ) < k ∧ ω i ∉ H := by
  unfold stopGen
  split_ifs with hex
  · rcases lt_or_ge k (Nat.find hex) with hlt | hge
    · exact Or.inl hlt
    · right
      by_contra hno
      have hall : ∀ i : Fin L, (i : ℕ) < k → ω i ∈ H := by
        intro i hi
        by_contra hout
        exact absurd ⟨i, hi, hout⟩ hno
      have hHle : H ≤ spanPrefix ω k := by
        have hfs := Nat.find_spec hex
        rw [← hfs.2]
        exact spanPrefix_mono ω hge
      exact hspan (le_antisymm (spanPrefix_le ω k H hall) hHle)
  · exact Or.inl hk

/-- Under the uniform subgroup law, every draw lies in `H` with probability
one: the probability that all first `k` window positions land in `H` equals
one. -/
theorem prob_inH_one (H : AddSubgroup G) {L k : ℕ} :
    FinDist.probEvent (L := L) (unifOnSub H)
      (fun ω => ∀ i : Fin L, (i : ℕ) < k → ω i ∈ H) = 1 := by
  classical
  have hmass : (∑ x ∈ (Finset.univ : Finset G).filter (fun g => g ∈ H),
      (unifOnSub H).prob x) = 1 := by
    rw [Finset.sum_filter]
    have hone := (unifOnSub H).sum_one
    refine (Finset.sum_congr rfl (fun x _ => ?_)).symm.trans hone
    by_cases hx : x ∈ H <;> simp [hx, unifOnSub]
  have hprod := FinDist.probOf_subset_product (unifOnSub H) (fun g => g ∈ H)
    ((Finset.univ : Finset (Fin L)).filter (fun i : Fin L => (i : ℕ) < k))
  rw [hmass, Finset.prod_const_one] at hprod
  have hiff : ∀ ω : Fin L → G,
      (∀ n ∈ (Finset.univ : Finset (Fin L)).filter (fun i : Fin L => (i : ℕ) < k),
        (fun g => g ∈ H) (ω n)) ↔
      (∀ i : Fin L, (i : ℕ) < k → ω i ∈ H) := by
    intro ω
    constructor
    · intro hall i hi
      exact hall i (Finset.mem_filter.mpr ⟨Finset.mem_univ i, hi⟩)
    · intro hall n hn
      exact hall n (Finset.mem_filter.mp hn).2
  exact (asp_probability_congr L (unifOnSub H) _ _ hiff).symm.trans hprod

/-- Records in which some draw among the first `k` escapes the subgroup `H`
form a null event under the uniform subgroup law. -/
theorem escape_null (H : AddSubgroup G) {L k : ℕ} :
    FinDist.probEvent (L := L) (unifOnSub H)
      (fun ω => ∃ i : Fin L, (i : ℕ) < k ∧ ω i ∉ H) = 0 := by
  classical
  have hmono := asp_probability_mono L (unifOnSub H)
    (fun ω => ∃ i : Fin L, (i : ℕ) < k ∧ ω i ∉ H)
    (fun ω => ¬ ∀ i : Fin L, (i : ℕ) < k → ω i ∈ H)
    (fun ω hω => by
      rcases hω with ⟨i, hi1, hi2⟩
      exact not_forall.mpr ⟨i, fun hcon => hi2 (hcon hi1)⟩)
  rw [probEventCompl, prob_inH_one] at hmono
  have hnn : 0 ≤ FinDist.probEvent (L := L) (unifOnSub H)
      (fun ω => ∃ i : Fin L, (i : ℕ) < k ∧ ω i ∉ H) := by
    unfold FinDist.probEvent
    exact Finset.sum_nonneg
      (fun ω _ => Finset.prod_nonneg (fun i _ => (unifOnSub H).nonneg _))
  exact le_antisymm (by linarith) hnn

omit [DecidableEq G] in
/-- Tail-probability identification: for `k < L`, the probability that the
first-generation time exceeds `k` equals the generation-failure probability
`failProbAt H k` of the `k`-sample window. This connects the stopping time
with the counting side of Section 2. -/
theorem probEvent_stopGen_gt (H : AddSubgroup G) {L k : ℕ} (hkL : k < L) :
    FinDist.probEvent (L := L) (unifOnSub H) (fun ω => k < stopGen H ω) =
      failProbAt H k := by
  classical
  have hsub : ∀ ω : Fin L → G, k < stopGen H ω → spanPrefix ω k ≠ H := by
    intro ω hk' hspan'
    have hle := stopGen_le_of_span H ω k (le_of_lt hkL) hspan'
    omega
  have hle1 := asp_probability_mono L (unifOnSub H)
    (fun ω => k < stopGen H ω) (fun ω => spanPrefix ω k ≠ H) hsub
  have hle2 : FinDist.probEvent (L := L) (unifOnSub H)
      (fun ω => spanPrefix ω k ≠ H) ≤
      FinDist.probEvent (L := L) (unifOnSub H) (fun ω => k < stopGen H ω) := by
    have hpt : ∀ ω : Fin L → G,
        (if spanPrefix ω k ≠ H then (1 : ℝ) else 0) ≤
          (if k < stopGen H ω then (1 : ℝ) else 0) +
            (if ∃ i : Fin L, (i : ℕ) < k ∧ ω i ∉ H then (1 : ℝ) else 0) := by
      intro ω
      by_cases hA : k < stopGen H ω
      · have e1 : (if k < stopGen H ω then (1 : ℝ) else 0) = 1 := by simp [hA]
        have e2 : (if spanPrefix ω k ≠ H then (1 : ℝ) else 0) = 1 := by
          simp [hsub ω hA]
        rw [e1, e2]
        exact le_add_of_nonneg_right
          (by by_cases hN : ∃ i : Fin L, (i : ℕ) < k ∧ ω i ∉ H <;> simp [hN])
      · by_cases hB : spanPrefix ω k ≠ H
        · rcases span_escape H ω k hkL hB with h1 | h2
          · exact absurd h1 hA
          · have e1 : (if spanPrefix ω k ≠ H then (1 : ℝ) else 0) = 1 := by
              simp [hB]
            have e2 : (if k < stopGen H ω then (1 : ℝ) else 0) = 0 := by
              simp [hA]
            have e3 : (if ∃ i : Fin L, (i : ℕ) < k ∧ ω i ∉ H then (1 : ℝ) else 0) = 1 := by
              simp [h2]
            rw [e1, e2, e3]
            norm_num
        · have e0 : (if spanPrefix ω k ≠ H then (1 : ℝ) else 0) = 0 := by
            simp [hB]
          rw [e0]
          exact add_nonneg (by simp [hA])
            (by by_cases hN : ∃ i : Fin L, (i : ℕ) < k ∧ ω i ∉ H <;> simp [hN])
    have hsplit := probEvent_eq_indicator (unifOnSub H)
      (fun ω : Fin L → G => spanPrefix ω k ≠ H)
    have hsplitA := probEvent_eq_indicator (unifOnSub H)
      (fun ω : Fin L → G => k < stopGen H ω)
    have hsplitN := probEvent_eq_indicator (unifOnSub H)
      (fun ω : Fin L → G => ∃ i : Fin L, (i : ℕ) < k ∧ ω i ∉ H)
    have hmul : ∀ ω : Fin L → G, 0 ≤ (unifOnSub H).probOf (L := L) ω :=
      fun ω => Finset.prod_nonneg (fun i _ => (unifOnSub H).nonneg _)
    have hsumN : (∑ ω : Fin L → G, (unifOnSub H).probOf ω *
        (if ∃ i : Fin L, (i : ℕ) < k ∧ ω i ∉ H then (1 : ℝ) else 0)) = 0 := by
      rw [← hsplitN, escape_null]
    have hsumle : (∑ ω : Fin L → G, (unifOnSub H).probOf ω *
        (if spanPrefix ω k ≠ H then (1 : ℝ) else 0)) ≤
        (∑ ω : Fin L → G, (unifOnSub H).probOf ω *
          (if k < stopGen H ω then (1 : ℝ) else 0)) +
        (∑ ω : Fin L → G, (unifOnSub H).probOf ω *
          (if ∃ i : Fin L, (i : ℕ) < k ∧ ω i ∉ H then (1 : ℝ) else 0)) := by
      have hpairwise : ∀ ω ∈ (Finset.univ : Finset (Fin L → G)),
          ((unifOnSub H).probOf ω *
              (if spanPrefix ω k ≠ H then (1 : ℝ) else 0)) ≤
            ((unifOnSub H).probOf ω *
              (if k < stopGen H ω then (1 : ℝ) else 0)) +
            ((unifOnSub H).probOf ω *
              (if ∃ i : Fin L, (i : ℕ) < k ∧ ω i ∉ H then (1 : ℝ) else 0)) :=
        fun ω _ => (mul_le_mul_of_nonneg_left (hpt ω) (hmul ω)).trans
          (le_of_eq (by ring))
      rw [← Finset.sum_add_distrib]
      exact Finset.sum_le_sum hpairwise
    rw [hsplit, hsplitA]
    have hfinal : (∑ ω : Fin L → G, (unifOnSub H).probOf ω *
        (if k < stopGen H ω then (1 : ℝ) else 0)) +
        (∑ ω : Fin L → G, (unifOnSub H).probOf ω *
          (if ∃ i : Fin L, (i : ℕ) < k ∧ ω i ∉ H then (1 : ℝ) else 0)) =
        (∑ ω : Fin L → G, (unifOnSub H).probOf ω *
          (if k < stopGen H ω then (1 : ℝ) else 0)) := by
      rw [hsumN, add_zero]
    exact hsumle.trans (le_of_eq hfinal)
  have hmargin := probEvent_firsts (le_of_lt hkL) (unifOnSub H)
    (E := fun hs : Fin k → G => AddSubgroup.closure (Set.range hs) ≠ H)
  have hiff : ∀ ω : Fin L → G,
      (AddSubgroup.closure (Set.range (firsts (le_of_lt hkL) ω)) ≠ H) ↔
      (spanPrefix ω k ≠ H) := by
    intro ω
    rw [range_firsts]
    simp only [spanPrefix]
  have hconv : FinDist.probEvent (L := L) (unifOnSub H)
      (fun ω => spanPrefix ω k ≠ H) = failProbAt H k :=
    Eq.trans (asp_probability_congr L (unifOnSub H) _ _ (fun ω => (hiff ω).symm)) hmargin
  exact le_antisymm (le_trans hle1 hconv.le) (le_trans hconv.ge hle2)

omit [DecidableEq G] in
/-- Tail-sum decomposition for the first-generation stopping time: the
expectation of the `L`-censored stopping time on the `L`-sample window equals
the sum of the generation-failure probabilities over the window,
`E[stopGen] = Σ_{k<L} failProbAt H k`. This is the identity through which the
expectation of the stopping law is decomposed; it is an exact equality of the
window-censored time, not a closed form for an infinite-process expectation. -/
theorem stopGen_tailsum (H : AddSubgroup G) (L : ℕ) :
    expectRecord (L := L) (unifOnSub H) (stopGen H) =
      ∑ k ∈ Finset.range L, failProbAt H k := by
  classical
  rw [tailsum_eq (L := L) (unifOnSub H) (stopGen H) (fun ω => stopGen_le H ω)]
  exact Finset.sum_congr rfl
    (fun k hk => probEvent_stopGen_gt H (Finset.mem_range.mp hk))

/-- Composition with the existing truncated tail-sum bound: the expectation of
the `L`-censored first-generation time is at most `2 log₂ |H|` for every
window length `L` simultaneously. This is a statement about the censored time
on a finite window, obtained by composing the tail-sum decomposition with
`expected_le_two_log`; it is NOT a claim about the complete expectation of the
uncensored stopping time, which is closed in the sibling module
`Qatlib.Papers.ExactSimon97.SampleStoppingInf`. -/
theorem stopGen_expect_le (H : AddSubgroup G) (hH : 2 ≤ Fintype.card ↥H)
    (L : ℕ) :
    expectRecord (L := L) (unifOnSub H) (stopGen H) ≤
      2 * Real.logb 2 (Fintype.card ↥H : ℝ) :=
  le_trans (stopGen_tailsum H L).le (expected_le_two_log H hH L)

end Stopping

end Qatlib.Papers.ExactSimon97.SampleStopping
