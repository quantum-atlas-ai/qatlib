@[expose] public section

/-!
# Execution-derived success for ExactSimon97 oracle machines

This module defines the success event and completes the first
execution-derived `ClProc` enumeration. A fuel-`k` run is represented by its
configuration trace `runTrace`, indexed by `Fin (k + 1)`. The designated accept
predicate is evaluated only when the final configuration is halted
(`traceAccepts`, `accepts`, `SuccessEvent`). Success is consequently a function
of the program/oracle execution trace (`traceAccepts_det`,
`accepts_eq_of_runTrace_eq`), not an independently specified proposition, and it
is stable under excess fuel after halting (`accepts_mono`). The query/answer
transcript `oracleTranscript` is itself execution-derived: its length is exactly
`qcount`, and for a fixed program and initial configuration it determines the
final configuration and acceptance (`exec_eq_of_oracleTranscript_eq`,
`accepts_eq_of_oracleTranscript_eq`).

For a fixed scale-uniform Boolean oracle family and accept-predicate family,
`successValue` maps the deterministic event to the real values zero or one.
`machineProc` combines this with the machine enumeration’s execution-derived query count. The
resulting `MachineValid` relation constrains both fields of a raw `ClProc`.
Finally, `machineProcs` uses the bounded program enumeration at every scale;
`EnumeratedMachineValid` is its range and has exact `covers` semantics. Every
such enumerated profile is machine-valid and hence execution-derived machine-cost valid.

The coverage boundary is important: `bounded_family_covered` chooses an index
separately at each scale, so it does not imply that one global index covers an
arbitrary bounded family. `EnumeratedMachineValid` therefore describes exactly
the scale-uniform families generated by a common enumeration index.

The main `ClProc` bridge uses a fixed oracle for each scale and thus has
deterministic `0/1` success values. As a separate first probability link,
`uniformSuccess` applies the finite-distribution expectation machinery used by
the ExactSimon97 probability development to average that value over all Boolean
oracles. This generic uniform space is not claimed to be Simon's promised
oracle distribution. Theorem 9's adaptive-transcript probability lower bound
remains open. No diagonalization,
`QP^O` membership, quantum witness, or original Corollary 10 claim is made
(DESIGN §12.8).

## Main statements

* `successEvent_iff`: success is exactly halting with the accept predicate true
  at the execution-derived final configuration.
* `accepts_eq_of_runTrace_eq`: equal program/oracle traces determine equal
  success events.
* `accepts_eq_of_oracleTranscript_eq`: the complete query/answer transcript
  determines acceptance for a fixed program and initial configuration.
* `uniformSuccess_eq_average`: uniform-oracle success is the finite average of
  the execution-derived success indicator, with values between zero and one.
* `machineProc_queries_eq_qcount`: the same oracle used for success also gives
  the query count, by oracle independence of `qcount`.
* `machineProcs_valid`: every enumerated profile has both execution-derived
  fields and a uniform program-depth bound.
* `enumeratedMachineValid_covers`: the enumerated admissibility relation is
  covered exactly by `machineProcs`.
-/

set_option autoImplicit false
set_option warningAsError true

open scoped BigOperators

open Qatlib.Concepts.MonteCarloMean.FinDistBounds
open Qatlib.Concepts.StabilizerAlg.NearUniformGen
open Qatlib.Concepts.CircuitLang.XorOracle
open Qatlib.Papers.ExactSimon97.OracleMachine
open Qatlib.Papers.ExactSimon97.MachineEnum
open Qatlib.Papers.ExactSimon97.MainResults
open Qatlib.Papers.ExactSimon97.MainResults (BoolVec)

namespace Qatlib.Papers.ExactSimon97.MachineSuccess

variable {a w : ℕ}

/-! ## Configuration traces and the execution-derived success event -/

/-- The complete configuration trace of a fuel-`k` execution. Position `i`
contains the configuration after exactly `i` machine steps. -/
def runTrace (f : Addr a → Bool) (P : Prog a w) (k : ℕ) (c : Conf a w) :
    Fin (k + 1) → Conf a w :=
  fun i => exec f P i.1 c

/-- The final configuration of a nonempty finite configuration trace. -/
def traceFinal {k : ℕ} (t : Fin (k + 1) → Conf a w) : Conf a w :=
  t (Fin.last k)

/-- Evaluate a designated accept predicate on the final trace configuration,
and require that configuration to be halted. -/
def traceAccepts (P : Prog a w) (accept : Conf a w → Bool) {k : ℕ}
    (t : Fin (k + 1) → Conf a w) : Bool :=
  decide (halted P (traceFinal t)) && accept (traceFinal t)

/-- The execution-derived success event as Boolean data: run for the supplied
fuel, then apply `traceAccepts` to the resulting program/oracle trace. -/
def accepts (accept : Conf a w → Bool) (f : Addr a → Bool) (P : Prog a w)
    (k : ℕ) (c : Conf a w) : Bool :=
  traceAccepts P accept (runTrace f P k c)

/-- The propositional form of the execution-derived success event. -/
def SuccessEvent (accept : Conf a w → Bool) (f : Addr a → Bool) (P : Prog a w)
    (k : ℕ) (c : Conf a w) : Prop :=
  accepts accept f P k c = true

/-- The last entry of the execution trace is exactly the finite-depth
execution result. -/
theorem runTrace_last (f : Addr a → Bool) (P : Prog a w) (k : ℕ) (c : Conf a w) :
    traceFinal (runTrace f P k c) = exec f P k c :=
  rfl

/-- Success is exactly halting with the designated accept predicate true on the
final execution configuration. -/
theorem successEvent_iff (accept : Conf a w → Bool) (f : Addr a → Bool)
    (P : Prog a w) (k : ℕ) (c : Conf a w) :
    SuccessEvent accept f P k c ↔
      halted P (exec f P k c) ∧ accept (exec f P k c) = true := by
  unfold SuccessEvent accepts traceAccepts
  rw [runTrace_last]
  constructor
  · intro h
    obtain ⟨hh, ha⟩ := Bool.and_eq_true_iff.mp h
    exact ⟨of_decide_eq_true hh, ha⟩
  · rintro ⟨hh, ha⟩
    exact Bool.and_eq_true_iff.mpr ⟨decide_eq_true hh, ha⟩

/-- Success is a deterministic function of the configuration trace: equal
traces give the same success bit for a fixed program and accept predicate. -/
theorem traceAccepts_det (P : Prog a w) (accept : Conf a w → Bool) {k : ℕ}
    {t u : Fin (k + 1) → Conf a w} (h : t = u) :
    traceAccepts P accept t = traceAccepts P accept u := by
  rw [h]

/-- Equal program/oracle execution traces determine equal success events. This
is the trace-level determinism statement for the success semantics. -/
theorem accepts_eq_of_runTrace_eq (accept : Conf a w → Bool)
    (f g : Addr a → Bool) (P : Prog a w) (k : ℕ) (c d : Conf a w)
    (h : runTrace f P k c = runTrace g P k d) :
    accepts accept f P k c = accepts accept g P k d := by
  unfold accepts
  rw [h]

/-- Once a run has halted, additional fuel does not change its success bit. -/
theorem accepts_mono (accept : Conf a w → Bool) (f : Addr a → Bool)
    (P : Prog a w) (c : Conf a w) {k m : ℕ} (hkm : k ≤ m)
    (h : halted P (exec f P k c)) :
    accepts accept f P m c = accepts accept f P k c := by
  unfold accepts traceAccepts
  have hfinal : traceFinal (runTrace f P m c) = traceFinal (runTrace f P k c) := by
    rw [runTrace_last, runTrace_last, exec_mono f P c hkm h]
  rw [hfinal]

/-- The standard designated accept predicate: the final answer bit is true. -/
def answerAccept (c : Conf a w) : Bool :=
  c.reg.2.1

/-- On the single-query program, answer acceptance returns exactly the
answer bit produced by the real `xorInto` oracle update. -/
theorem accepts_oneQueryProg (f : Addr a → Bool) (x : OReg a w) :
    accepts answerAccept f (oneQueryProg : Prog a w) 2 ⟨0, x⟩ =
      (xorInto f x).2.1 := by
  obtain ⟨hex, _hh, _⟩ := one_query_exec f x
  have hh : halted oneQueryProg (⟨1, xorInto f x⟩ : Conf a w) := rfl
  unfold accepts traceAccepts
  rw [runTrace_last, hex, decide_eq_true hh]
  rfl

/-! ## Query/answer transcripts determine execution -/

/-- Away from an oracle instruction, the step function does not depend on the
oracle. -/
theorem step_eq_of_not_oracle (f g : Addr a → Bool) (P : Prog a w) (c : Conf a w)
    (h : instrAt P c.pc ≠ Instr.oracle) : step f P c = step g P c := by
  cases hi : instrAt P c.pc with
  | oracle => exact absurd hi h
  | flipA i => rw [step_flipA f P c hi, step_flipA g P c hi]
  | flipW i => rw [step_flipW f P c hi, step_flipW g P c hi]
  | halt => rw [step_halt f P c hi, step_halt g P c hi]

/-- The complete execution-derived query/answer transcript. Each entry records
the address of an actual oracle consultation and the bit returned by that
consultation, in chronological order. -/
def oracleTranscript (f : Addr a → Bool) (P : Prog a w) :
    ℕ → Conf a w → List (Addr a × Bool)
  | 0, _ => []
  | k + 1, c =>
      if instrAt P c.pc = Instr.oracle then
        (c.reg.1, f c.reg.1) :: oracleTranscript f P k (step f P c)
      else
        oracleTranscript f P k (step f P c)

/-- The transcript has one entry per actual oracle consultation: its length is
exactly the execution-derived query count. -/
theorem oracleTranscript_length (f : Addr a → Bool) (P : Prog a w) (k : ℕ) :
    ∀ c : Conf a w, (oracleTranscript f P k c).length = qcount f P k c := by
  induction k with
  | zero => intro c; rfl
  | succ k ih =>
      intro c
      by_cases hi : instrAt P c.pc = Instr.oracle
      · simp [oracleTranscript, qcount, hi, ih]
        omega
      · simp [oracleTranscript, qcount, hi, ih]

/-- A halted configuration produces an empty query/answer transcript. -/
theorem oracleTranscript_halted (f : Addr a → Bool) (P : Prog a w) (c : Conf a w)
    (h : halted P c) (k : ℕ) : oracleTranscript f P k c = [] := by
  apply List.length_eq_zero_iff.mp
  rw [oracleTranscript_length, qcount_halted f P c h k]

/-- For a fixed program and initial configuration, the complete query/answer
transcript determines the final configuration. At an oracle step, equality of
the first transcript entries makes the two `xorInto` updates agree; away from
an oracle step, the successor is oracle-independent. -/
theorem exec_eq_of_oracleTranscript_eq (f g : Addr a → Bool) (P : Prog a w) (k : ℕ) :
    ∀ c : Conf a w, oracleTranscript f P k c = oracleTranscript g P k c →
      exec f P k c = exec g P k c := by
  induction k with
  | zero => intro c _; rfl
  | succ k ih =>
      intro c htr
      by_cases hi : instrAt P c.pc = Instr.oracle
      · simp [oracleTranscript, hi] at htr
        obtain ⟨hfg, htail⟩ := htr
        have hstep : step f P c = step g P c := by
          rw [step_oracle f P c hi, step_oracle g P c hi]
          have hx : xorInto f c.reg = xorInto g c.reg := by
            unfold xorInto
            rw [hfg]
          rw [hx]
        change exec f P k (step f P c) = exec g P k (step g P c)
        rw [← hstep] at htail ⊢
        exact ih (step f P c) htail
      · simp [oracleTranscript, hi] at htr
        have hstep := step_eq_of_not_oracle f g P c hi
        change exec f P k (step f P c) = exec g P k (step g P c)
        rw [← hstep] at htr ⊢
        exact ih (step f P c) htr

/-- The query/answer transcript determines acceptance: two oracles producing
the same transcript from the same program and initial configuration have the
same execution-derived success bit. -/
theorem accepts_eq_of_oracleTranscript_eq (accept : Conf a w → Bool)
    (f g : Addr a → Bool) (P : Prog a w) (k : ℕ) (c : Conf a w)
    (h : oracleTranscript f P k c = oracleTranscript g P k c) :
    accepts accept f P k c = accepts accept g P k c := by
  have hfinal := exec_eq_of_oracleTranscript_eq f g P k c h
  unfold accepts traceAccepts
  rw [runTrace_last, runTrace_last, hfinal]

/-! ## Real-valued success and the bridge to `ClProc` -/

/-- A scale-uniform family of Boolean oracles for the machine address spaces. -/
abbrev BoolOracleFamily : Type := (n : ℕ) → Addr n → Bool

/-- A scale-uniform family of designated final-configuration accept predicates. -/
abbrev AcceptFamily : Type := (n : ℕ) → Conf n 0 → Bool

/-- The real value of a deterministic execution-derived success event: one for
acceptance and zero otherwise. -/
def successValue (accept : Conf a w → Bool) (f : Addr a → Bool) (P : Prog a w)
    (k : ℕ) (c : Conf a w) : ℝ :=
  if accepts accept f P k c = true then 1 else 0

/-- The real success value is one exactly on the execution-derived success
event. -/
theorem successValue_eq_one_iff (accept : Conf a w → Bool) (f : Addr a → Bool)
    (P : Prog a w) (k : ℕ) (c : Conf a w) :
    successValue accept f P k c = 1 ↔ SuccessEvent accept f P k c := by
  simp [successValue, SuccessEvent]

/-- Every deterministic execution-derived success value is either zero or one. -/
theorem successValue_zero_or_one (accept : Conf a w → Bool) (f : Addr a → Bool)
    (P : Prog a w) (k : ℕ) (c : Conf a w) :
    successValue accept f P k c = 0 ∨ successValue accept f P k c = 1 := by
  by_cases h : accepts accept f P k c = true
  · exact Or.inr (by simp [successValue, h])
  · exact Or.inl (by simp [successValue, h])

/-- Deterministic execution-derived success values are nonnegative. -/
theorem successValue_nonneg (accept : Conf a w → Bool) (f : Addr a → Bool)
    (P : Prog a w) (k : ℕ) (c : Conf a w) :
    0 ≤ successValue accept f P k c := by
  by_cases h : accepts accept f P k c = true <;> simp [successValue, h]

/-- Deterministic execution-derived success values are at most one. -/
theorem successValue_le_one (accept : Conf a w → Bool) (f : Addr a → Bool)
    (P : Prog a w) (k : ℕ) (c : Conf a w) :
    successValue accept f P k c ≤ 1 := by
  by_cases h : accepts accept f P k c = true <;> simp [successValue, h]

/-! ## Uniform-over-oracles expectation of the success indicator -/

/-- The uniform finite distribution on every Boolean oracle over a finite
address space, reusing the finite law underlying the ExactSimon97 expectation
development. -/
noncomputable def uniformOracleLaw (a : ℕ) : FinDist (Addr a → Bool) :=
  aspUniformLaw (Addr a → Bool)

/-- Expectation of a real-valued observable under the uniform distribution on
all Boolean oracles. -/
noncomputable def uniformOracleExpect (a : ℕ) (F : (Addr a → Bool) → ℝ) : ℝ :=
  FinDist.expect (uniformOracleLaw a) F

/-- Uniform-oracle expectation is the normalized finite sum over all oracle
truth tables. -/
theorem uniformOracleExpect_eq_average (a : ℕ) (F : (Addr a → Bool) → ℝ) :
    uniformOracleExpect a F = (∑ f : Addr a → Bool, F f) /
      (Fintype.card (Addr a → Bool) : ℝ) := by
  unfold uniformOracleExpect FinDist.expect
  change (∑ f : Addr a → Bool,
    (Fintype.card (Addr a → Bool) : ℝ)⁻¹ * F f) = _
  rw [← Finset.mul_sum, div_eq_mul_inv, mul_comm]

/-- The expectation of the execution-derived success indicator over the uniform
distribution on all Boolean oracles. This is generic finite-oracle machinery,
not yet the promised Simon-oracle distribution. -/
noncomputable def uniformSuccess (accept : Conf a w → Bool) (P : Prog a w)
    (k : ℕ) (c : Conf a w) : ℝ :=
  uniformOracleExpect a (fun f => successValue accept f P k c)

/-- Uniform-oracle success is the average of the deterministic execution
outcomes over all oracle truth tables. -/
theorem uniformSuccess_eq_average (accept : Conf a w → Bool) (P : Prog a w)
    (k : ℕ) (c : Conf a w) :
    uniformSuccess accept P k c =
      (∑ f : Addr a → Bool, successValue accept f P k c) /
        (Fintype.card (Addr a → Bool) : ℝ) :=
  uniformOracleExpect_eq_average a (fun f => successValue accept f P k c)

/-- Uniform-oracle execution success is nonnegative. -/
theorem uniformSuccess_nonneg (accept : Conf a w → Bool) (P : Prog a w)
    (k : ℕ) (c : Conf a w) : 0 ≤ uniformSuccess accept P k c := by
  unfold uniformSuccess uniformOracleExpect FinDist.expect
  exact Finset.sum_nonneg fun f _ =>
    mul_nonneg ((uniformOracleLaw a).nonneg f) (successValue_nonneg accept f P k c)

/-- Uniform-oracle execution success is at most one. -/
theorem uniformSuccess_le_one (accept : Conf a w → Bool) (P : Prog a w)
    (k : ℕ) (c : Conf a w) : uniformSuccess accept P k c ≤ 1 := by
  unfold uniformSuccess uniformOracleExpect FinDist.expect
  calc
    (∑ f : Addr a → Bool, (uniformOracleLaw a).prob f *
        successValue accept f P k c) ≤
        ∑ f : Addr a → Bool, (uniformOracleLaw a).prob f * 1 :=
      Finset.sum_le_sum fun f _ => mul_le_mul_of_nonneg_left
        (successValue_le_one accept f P k c) ((uniformOracleLaw a).nonneg f)
    _ = 1 := by simpa using (uniformOracleLaw a).sum_one

/-- The success profile obtained by executing a scale-uniform machine family
against a fixed scale-uniform oracle family and accept-predicate family. -/
def machineSuccess (O : BoolOracleFamily) (accept : AcceptFamily)
    (M : (n : ℕ) → Prog n 0) (k : ℕ) : ClInput → ℝ
  | ⟨n, x⟩ => successValue (accept n) (O n) (M n) k (initConf x)

/-- A full classical procedure profile: execution-derived query cost and
execution-derived deterministic success under the same machine family. -/
def machineProc (O : BoolOracleFamily) (accept : AcceptFamily)
    (M : (n : ℕ) → Prog n 0) (k : ℕ) : ClProc where
  queries := machineQueries M k
  success := machineSuccess O accept M k

/-- The query field of `machineProc` is the execution-derived query
profile. -/
theorem machineProc_queries (O : BoolOracleFamily) (accept : AcceptFamily)
    (M : (n : ℕ) → Prog n 0) (k : ℕ) :
    (machineProc O accept M k).queries = machineQueries M k :=
  rfl

/-- The success field of `machineProc` is the execution-derived success
profile. -/
theorem machineProc_success (O : BoolOracleFamily) (accept : AcceptFamily)
    (M : (n : ℕ) → Prog n 0) (k : ℕ) :
    (machineProc O accept M k).success = machineSuccess O accept M k :=
  rfl

/-- The query field also agrees with counting under the same oracle used for
success; the machine enumeration’s zero-oracle convention is immaterial by `qcount_oracle_indep`. -/
theorem machineProc_queries_eq_qcount (O : BoolOracleFamily) (accept : AcceptFamily)
    (M : (n : ℕ) → Prog n 0) (k : ℕ) (n : ℕ) (x : BoolVec n) :
    (machineProc O accept M k).queries (⟨n, x⟩ : ClInput) =
      qcount (O n) (M n) k (initConf x) := by
  exact qcount_oracle_indep (M n) k (fun _ => false) (O n) (initConf x)

/-- Full machine validity: both raw `ClProc` fields are obtained from one
uniformly depth-bounded machine family, with explicit oracle and acceptance
conventions. -/
def MachineValid (O : BoolOracleFamily) (accept : AcceptFamily) (d k : ℕ)
    (A : ClProc) : Prop :=
  ∃ M : (n : ℕ) → Prog n 0, (∀ n : ℕ, (M n).length ≤ d) ∧
    A.queries = machineQueries M k ∧ A.success = machineSuccess O accept M k

/-- Every fully machine-valid profile is execution-derived machine-cost valid. -/
theorem machineValid_cost {O : BoolOracleFamily} {accept : AcceptFamily}
    {d k : ℕ} {A : ClProc} (hA : MachineValid O accept d k A) :
    MachineCostValid d k A := by
  obtain ⟨M, hM, hq, _⟩ := hA
  exact ⟨M, hM, hq⟩

/-- Every fully machine-valid profile satisfies the execution-derived cube
budget premise whenever the scale absorbs the uniform fuel bound. -/
theorem machineValid_cube_budget {O : BoolOracleFamily} {accept : AcceptFamily}
    {d k : ℕ} {A : ClProc} (hA : MachineValid O accept d k A)
    (x : ClInput) (hk : k ^ 3 ≤ 2 ^ x.1) :
    A.queries x ^ 3 ≤ 2 ^ x.1 :=
  machineCostValid_cube_budget (machineValid_cost hA) x hk

/-- A bounded machine family and its explicit semantics make its assembled
profile fully machine-valid. -/
theorem machineProc_valid (O : BoolOracleFamily) (accept : AcceptFamily)
    (d k : ℕ) (M : (n : ℕ) → Prog n 0) (hM : ∀ n : ℕ, (M n).length ≤ d) :
    MachineValid O accept d k (machineProc O accept M k) :=
  ⟨M, hM, rfl, rfl⟩

/-- The first full `procs` sequence: at scale `n`, index `i` executes the enumerated
bounded enumeration program `enumProg n 0 d i`. Both profile fields are
execution-derived; surplus indices execute the inert empty program. -/
def machineProcs (O : BoolOracleFamily) (accept : AcceptFamily) (d k i : ℕ) :
    ClProc :=
  machineProc O accept (fun n => enumProg n 0 d i) k

/-- Every member of `machineProcs` is fully machine-valid with the common depth
bound supplied by the bounded program enumeration. -/
theorem machineProcs_valid (O : BoolOracleFamily) (accept : AcceptFamily)
    (d k i : ℕ) : MachineValid O accept d k (machineProcs O accept d k i) := by
  apply machineProc_valid
  intro n
  exact enumProg_le n 0 d i

/-- Every member of `machineProcs` is execution-derived machine-cost valid. -/
theorem machineProcs_costValid (O : BoolOracleFamily) (accept : AcceptFamily)
    (d k i : ℕ) : MachineCostValid d k (machineProcs O accept d k i) :=
  machineValid_cost (machineProcs_valid O accept d k i)

/-- Pointwise success equation for the enumerated full procedures: the raw real
field reduces to the accept bit of the actual enumerated execution. -/
theorem machineProcs_success_eq (O : BoolOracleFamily) (accept : AcceptFamily)
    (d k i n : ℕ) (x : BoolVec n) :
    (machineProcs O accept d k i).success (⟨n, x⟩ : ClInput) =
      successValue (accept n) (O n) (enumProg n 0 d i) k (initConf x) :=
  rfl

/-- The enumerated admissibility relation: a profile is admitted exactly when
it is generated by one global program-enumeration index. -/
def EnumeratedMachineValid (O : BoolOracleFamily) (accept : AcceptFamily)
    (d k : ℕ) (A : ClProc) : Prop :=
  ∃ i : ℕ, machineProcs O accept d k i = A

/-- Every enumerated admissible profile has execution-derived queries and
success from a uniformly bounded machine family. -/
theorem enumeratedMachineValid_machineValid {O : BoolOracleFamily}
    {accept : AcceptFamily} {d k : ℕ} {A : ClProc}
    (hA : EnumeratedMachineValid O accept d k A) :
    MachineValid O accept d k A := by
  obtain ⟨i, rfl⟩ := hA
  exact machineProcs_valid O accept d k i

/-- Exact `covers` semantics for the first full `procs` instance: every profile
admitted by the enumerated relation is returned at its witnessing index. -/
theorem enumeratedMachineValid_covers (O : BoolOracleFamily) (accept : AcceptFamily)
    (d k : ℕ) (A : ClProc) (hA : EnumeratedMachineValid O accept d k A) :
    ∃ i : ℕ, machineProcs O accept d k i = A :=
  hA

end Qatlib.Papers.ExactSimon97.MachineSuccess
