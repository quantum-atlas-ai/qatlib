import Mathlib.Algebra.Field.GeomSum
import Mathlib.Algebra.Group.Subgroup.ZPowers.Basic
import Mathlib.Tactic

set_option backward.isDefEq.respectTransparency false

/-!
# The affine group of a field

The group `G` of the paper is the set of matrices

```
[[a, b], [0, 1]]        (a ∈ Fˣ, b ∈ F),
```

with matrix multiplication.  In the coordinates `(a, b)` the product is
`(a, b) * (c, d) = (a * c, a * d + b)`.

This file supplies the coordinate group, its cyclic subgroups `C_b`, and the
power formula for the second coordinate.  It is the paper-level model used by
the statements of Le Lemma 1 and Lemma 3 of `HSPAffine13`.
-/

set_option autoImplicit false

namespace Qatlib.Papers.HSPAffine13.MainResults

/-- The affine group `x ↦ a * x + b` of a field, in the coordinates `(a, b)`.
The first coordinate is a unit, the second is an arbitrary field element. -/
@[ext]
structure AffineGroup (F : Type*) [Field F] where
  /-- The multiplicative part. -/
  a : Fˣ
  /-- The translation part. -/
  b : F
deriving DecidableEq

namespace AffineGroup

variable {F : Type*} [Field F]

/-- The matrix product in coordinates. -/
def mul (x y : AffineGroup F) : AffineGroup F :=
  ⟨x.a * y.a, x.a * y.b + x.b⟩

/-- The inverse in coordinates. -/
def inv (x : AffineGroup F) : AffineGroup F :=
  ⟨x.a⁻¹, -(x.a⁻¹ * x.b)⟩

/-- The identity affine transformation. -/
instance : One (AffineGroup F) := ⟨⟨1, 0⟩⟩

/-- Composition of affine transformations. -/
instance : Mul (AffineGroup F) := ⟨mul⟩

/-- The inverse affine transformation. -/
instance : Inv (AffineGroup F) := ⟨inv⟩

/-- The first coordinate of a product. -/
@[simp]
theorem mul_a (x y : AffineGroup F) : (x * y).a = x.a * y.a := rfl

/-- The second coordinate of a product. -/
@[simp]
theorem mul_b (x y : AffineGroup F) : (x * y).b = x.a * y.b + x.b := rfl

/-- The first coordinate of the identity. -/
@[simp]
theorem one_a : (1 : AffineGroup F).a = 1 := rfl

/-- The second coordinate of the identity. -/
@[simp]
theorem one_b : (1 : AffineGroup F).b = 0 := rfl

/-- The first coordinate of the inverse. -/
@[simp]
theorem inv_a (x : AffineGroup F) : x⁻¹.a = x.a⁻¹ := rfl

/-- The second coordinate of the inverse. -/
@[simp]
theorem inv_b (x : AffineGroup F) : x⁻¹.b = -(x.a⁻¹ * x.b) := rfl

/-- Associativity of the coordinate product. -/
theorem mul_assoc' (x y z : AffineGroup F) : x * y * z = x * (y * z) := by
  ext <;> simp [mul_assoc, add_assoc, add_comm, mul_add]

/-- The identity is a left unit. -/
theorem one_mul' (x : AffineGroup F) : 1 * x = x := by
  ext <;> simp

/-- The identity is a right unit. -/
theorem mul_one' (x : AffineGroup F) : x * 1 = x := by
  ext <;> simp

/-- The inverse cancels on the left. -/
theorem inv_mul_cancel' (x : AffineGroup F) : x⁻¹ * x = 1 := by
  ext <;> simp

/-- The group structure induced by affine composition and inversion. -/
instance : Group (AffineGroup F) where
  mul := (· * ·)
  one := 1
  inv := Inv.inv
  mul_assoc := mul_assoc'
  one_mul := one_mul'
  mul_one := mul_one'
  inv_mul_cancel := inv_mul_cancel'

/-- The product equivalence between the coordinate group and `Fˣ × F`. -/
def equivProd : AffineGroup F ≃ Fˣ × F where
  toFun g := (g.a, g.b)
  invFun p := ⟨p.1, p.2⟩
  left_inv g := by cases g; rfl
  right_inv p := by cases p; rfl

/-- The affine group has `q - 1` choices for the multiplicative part and `q`
choices for the translation, hence `q * (q - 1)` elements. -/
instance [Fintype F] [DecidableEq F] : Fintype (AffineGroup F) :=
  Fintype.ofEquiv (Fˣ × F) equivProd.symm


/-- The projection to the multiplicative part, a group homomorphism. -/
def aHom : AffineGroup F →* Fˣ where
  toFun x := x.a
  map_one' := rfl
  map_mul' x y := by simp

/-- The translation subgroup: elements with multiplicative part `1`. -/
def translationSubgroup : Subgroup (AffineGroup F) :=
  (aHom (F := F)).ker

/-- Membership in the translation subgroup is equality of the multiplicative
part to `1`. -/
@[simp]
theorem mem_translationSubgroup_iff (x : AffineGroup F) :
    x ∈ translationSubgroup ↔ x.a = 1 :=
  Iff.rfl

/-- A subgroup is maximal when it is proper and every strictly larger subgroup
is the whole group. -/
def IsMaximalSubgroup (H : Subgroup (AffineGroup F)) : Prop :=
  H ≠ ⊤ ∧ ∀ K : Subgroup (AffineGroup F), H < K → K = ⊤

/-- The cyclic subgroup generated by `(u, b)`, the paper's `C_b`. -/
def C (u : Fˣ) (b : F) : Subgroup (AffineGroup F) :=
  Subgroup.zpowers (⟨u, b⟩ : AffineGroup F)

/-- Membership in `C_b` is being an integer power of `(u, b)`. -/
@[simp]
theorem mem_C_iff (u : Fˣ) (b : F) (x : AffineGroup F) :
    x ∈ C u b ↔ ∃ k : ℤ, (⟨u, b⟩ : AffineGroup F) ^ k = x :=
  Subgroup.mem_zpowers_iff

/-- The generator of `C_b` belongs to `C_b`. -/
@[simp]
theorem generator_mem_C (u : Fˣ) (b : F) : (⟨u, b⟩ : AffineGroup F) ∈ C u b :=
  Subgroup.mem_zpowers _

/-- The first coordinate of the `n`-th power of `(u, b)`. -/
theorem pow_a (u : Fˣ) (b : F) (n : ℕ) :
    ((⟨u, b⟩ : AffineGroup F) ^ n).a = u ^ n := by
  induction n with
  | zero => simp
  | succ n ih =>
      rw [pow_succ, mul_a, ih]
      simp [pow_succ]

/-- The second coordinate of the `n`-th power of `(u, b)`, for natural `n`. -/
theorem pow_b (u : Fˣ) (b : F) (n : ℕ) :
    ((⟨u, b⟩ : AffineGroup F) ^ n).b = b * ∑ i ∈ Finset.range n, (u : F) ^ i := by
  induction n with
  | zero => simp
  | succ n ih =>
      rw [pow_succ, mul_b, ih, pow_a]
      rw [Finset.sum_range_succ]
      simp only [Units.val_pow_eq_pow_val]
      ring

/-- The second coordinate of the `n`-th power of `(u, b)`, for natural `n`,
in closed form when `u ≠ 1`. -/
theorem pow_b_eq (u : Fˣ) (b : F) (hu : (u : F) ≠ 1) (n : ℕ) :
    ((⟨u, b⟩ : AffineGroup F) ^ n).b = b * (((u : F) ^ n - 1) / ((u : F) - 1)) := by
  rw [pow_b, geom_sum_eq hu]

/-- The inverse of `(u, b)` is `(u⁻¹, -u⁻¹ * b)`. -/
@[simp]
theorem inv_mk (u : Fˣ) (b : F) :
    (⟨u, b⟩ : AffineGroup F)⁻¹ = ⟨u⁻¹, -((u⁻¹ : F) * b)⟩ := by
  ext <;> simp

/-- For every integer `k`, the first coordinate of `(u, b)^k` is `u^k`. -/
theorem zpow_a (u : Fˣ) (b : F) (k : ℤ) :
    ((⟨u, b⟩ : AffineGroup F) ^ k).a = u ^ k := by
  obtain ⟨n, rfl | rfl⟩ := k.eq_nat_or_neg
  · simpa using pow_a u b n
  · rw [zpow_neg, inv_a, zpow_natCast, pow_a, zpow_neg, zpow_natCast]

/-- The integer-power formula for the second coordinate:
`(u, b)^k` has second coordinate `b * (u^k - 1) / (u - 1)` for every integer
`k`, when `u ≠ 1`. -/
theorem zpow_b_eq (u : Fˣ) (b : F) (hu : (u : F) ≠ 1) (k : ℤ) :
    ((⟨u, b⟩ : AffineGroup F) ^ k).b = b * (((u : F) ^ k - 1) / ((u : F) - 1)) := by
  obtain ⟨n, rfl | rfl⟩ := k.eq_nat_or_neg
  · simpa [zpow_natCast] using pow_b_eq u b hu n
  · rw [zpow_neg, inv_mk, zpow_natCast, pow_b_eq u b hu n, pow_a]
    simp only [Units.val_pow_eq_pow_val, zpow_neg, zpow_natCast]
    have hu0 : (u : F) ≠ 0 := u.ne_zero
    have hden : (u : F) - 1 ≠ 0 := sub_ne_zero.mpr hu
    field_simp [hden, hu0]
    ring

end AffineGroup

end Qatlib.Papers.HSPAffine13.MainResults
