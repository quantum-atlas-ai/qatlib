module

public import Qatlib.Papers.Armillary26.Instances.Construction
public import Qatlib.Papers.Armillary26.RoutingModel.Internal
public import Qatlib.Papers.Armillary26.Pairing.Ordered

@[expose] public section

/-!
# Routed K/chi construction and universal Armillary parameters

The actual twelve-group cyclic route supplies effective permutation arrays.
For three retained X and Z rows, a row-dependent K/chi pairing proves static
CSS compatibility and ordered elimination separately. The same hypotheses
yield the universal encoded-qubit and rate bounds; no exact instance rank or
distance is asserted.
-/

namespace Qatlib.Papers.Armillary26.Instances

set_option autoImplicit false
set_option warningAsError true

open Qatlib.Concepts.CodeCert.PermBlocks
open Qatlib.Concepts.ErrorCorrection.CssBuild
open Qatlib.Papers.Armillary26.RoutingModel
open Qatlib.Papers.Armillary26.Pairing
open Qatlib.Concepts.CodingDecoding.CssTesters.CssCode
open scoped Matrix

/-- Generic retained-check K/chi conditions give all universal conclusions. -/
theorem kchi_pair {P : Type*} [Fintype P] [DecidableEq P] (p₀ : P)
    (gX gZ : Fin 3 → Fin 12) (σX σZ : Fin 3 → Fin 12 → Equiv.Perm P)
    (rho : Fin 3 → Fin 3 → Fin 12 → Fin 12) (h : Kchi gX gZ σX σZ rho) :
    6 * Fintype.card P + 4
      ≤ (retainedCode σX σZ (static_zero gX gZ σX σZ rho h)).encodedQubits
      ∧ (1 / 2 : ℚ)
        < ((retainedCode σX σZ (static_zero gX gZ σX σZ rho h)).encodedQubits : ℚ) /
          (12 * Fintype.card P : ℕ)
      ∧ ordC (steps gX σX) (steps gZ σZ) = 0 :=
  ⟨encoded_lower p₀ σX σZ (static_zero gX gZ σX σZ rho h),
    rate_gt_half p₀ σX σZ (static_zero gX gZ σX σZ rho h),
    ordered_zero gX gZ σX σZ rho h⟩

/-- Source parameters specialized to the twelve-group, six-pair route. -/
structure ArmParam (p q : ℕ) where
  hp : 0 < p
  hq : 0 < q
  perm : ZMod 12 → Fin 6 → Equiv.Perm (Fin q)
  shift : ZMod 12 → Fin 6 → Fin q → ZMod p

/-- Embed twelve-group source parameters in the generic cyclic router. -/
def toRoute {p q : ℕ} (a : ArmParam p q) : RouteParam :=
  { m := 6, p := p, q := q, hm := by decide, hp := a.hp, hq := a.hq,
    perm := a.perm, shift := a.shift }

/-- Effective internal permutations generated by the actual source route. -/
def armEff {p q : ℕ} (a : ArmParam p q) (g b : Fin 12) :
    Equiv.Perm (ZMod p × Fin q) :=
  effPerms (toRoute a) g b

/-- Every effective interaction generated by the source route has internal form. -/
theorem armEff_form {p q : ℕ} (a : ArmParam p q) (g b : Fin 12) :
    IntForm (armEff a g b) := by
  apply effInt_form

/-- The actual π/δ route and retained K/chi pairing close the full generic chain. -/
theorem route_pair {p q : ℕ} [NeZero p] (a : ArmParam p q)
    (gX gZ : Fin 3 → Fin 12) (rho : Fin 3 → Fin 3 → Fin 12 → Fin 12)
    (h : Kchi gX gZ (fun x => armEff a (gX x)) (fun z => armEff a (gZ z)) rho)
    (u₀ : ZMod p × Fin q) :
    6 * Fintype.card (ZMod p × Fin q) + 4
      ≤ (retainedCode (fun x => armEff a (gX x)) (fun z => armEff a (gZ z))
        (static_zero gX gZ (fun x => armEff a (gX x)) (fun z => armEff a (gZ z))
          rho h)).encodedQubits
      ∧ (1 / 2 : ℚ)
        < ((retainedCode (fun x => armEff a (gX x)) (fun z => armEff a (gZ z))
          (static_zero gX gZ (fun x => armEff a (gX x)) (fun z => armEff a (gZ z))
            rho h)).encodedQubits : ℚ) /
          (12 * Fintype.card (ZMod p × Fin q) : ℕ)
      ∧ ordC (steps gX (fun x => armEff a (gX x)))
        (steps gZ (fun z => armEff a (gZ z))) = 0 := by
  exact kchi_pair u₀ gX gZ (fun x => armEff a (gX x)) (fun z => armEff a (gZ z)) rho h

/-- Station shifts read directly from the actual routed action at station zero. -/
def armShift {p q : ℕ} (a : ArmParam p q) (g b : Fin 12) :
    Fin q → ZMod p :=
  fun j => (armEff a g b (0, j)).1

/-- Channel permutations and their inverses read directly from the actual routed
action. Internal form proves that station-zero projection preserves inversion. -/
def armChannel {p q : ℕ} (a : ArmParam p q) (g b : Fin 12) :
    Equiv.Perm (Fin q) where
  toFun j := (armEff a g b (0, j)).2
  invFun j := ((armEff a g b).symm (0, j)).2
  left_inv j := by
    rcases armEff_form a g b with ⟨ell, sigma, h⟩
    simp [h, intAct]
  right_inv j := by
    rcases armEff_form a g b with ⟨ell, sigma, h⟩
    simp [h, intAct]

/-- The extracted shifts and channels reconstruct the effective routed permutation. -/
theorem armEff_eq_intAct {p q : ℕ} (a : ArmParam p q) (g b : Fin 12) :
    armEff a g b = intAct (armShift a g b) (armChannel a g b) := by
  rcases armEff_form a g b with ⟨ell, sigma, h⟩
  apply Equiv.ext
  rintro ⟨i, j⟩
  simp [armShift, armChannel, h, intAct]

/-- Sufficient source conditions on actual internal channels, modular shifts, and
visit ordering for a fixed-point-free pairing of block columns. The conditions
do not assume CSS compatibility or any parameter bound. -/
structure ShiftPair {p q : ℕ} (a : ArmParam p q)
    (gX gZ : Fin 3 → Fin 12) (rho : Fin 3 → Fin 3 → Fin 12 → Fin 12) : Prop where
  involutive : ∀ x z, Function.Involutive (rho x z)
  noFixed : ∀ x z b, rho x z b ≠ b
  channel : ∀ x z b,
    armChannel a (gX x) (rho x z b) * (armChannel a (gX x) b)⁻¹ =
      armChannel a (gZ z) (rho x z b) * (armChannel a (gZ z) b)⁻¹
  shift : ∀ x z b j,
    armShift a (gX x) b j - armShift a (gX x) (rho x z b) j -
      armShift a (gZ z) b
        (((armChannel a (gZ z) b)⁻¹ * armChannel a (gX x) b) j) +
      armShift a (gZ z) (rho x z b)
        (((armChannel a (gZ z) b)⁻¹ * armChannel a (gX x) b) j) = 0
  order : ∀ x z b, chi (gX x) (gZ z) (rho x z b) = chi (gX x) (gZ z) b

/-- Actual routed internal forms and source channel/shift equations produce the
`Qatlib.Papers.Armillary26.Pairing.Kchi` contract by
`Qatlib.Papers.Armillary26.Pairing.K_of_shift`. -/
theorem shift_pair_kchi {p q : ℕ} [NeZero p] (a : ArmParam p q)
    (gX gZ : Fin 3 → Fin 12) (rho : Fin 3 → Fin 3 → Fin 12 → Fin 12)
    (h : ShiftPair a gX gZ rho) :
    Kchi gX gZ (fun x => armEff a (gX x)) (fun z => armEff a (gZ z)) rho := by
  refine ⟨h.involutive, h.noFixed, ?_, h.order⟩
  intro x z b
  unfold pairK
  simp only [armEff_eq_intAct]
  exact (K_of_shift (K := ZMod 2)
    (armShift a (gX x) b) (armShift a (gX x) (rho x z b))
    (armShift a (gZ z) b) (armShift a (gZ z) (rho x z b))
    (armChannel a (gX x) b) (armChannel a (gX x) (rho x z b))
    (armChannel a (gZ z) b) (armChannel a (gZ z) (rho x z b))
    (h.channel x z b) (h.shift x z b)).symm

/-- The routed source conditions construct legal CSS data on the original data
coordinates, deriving compatibility rather than requiring it as an input. -/
def routeCode {p q : ℕ} [NeZero p] (a : ArmParam p q)
    (gX gZ : Fin 3 → Fin 12) (rho : Fin 3 → Fin 3 → Fin 12 → Fin 12)
    (h : ShiftPair a gX gZ rho) :
    CssData (Fin 12 × (ZMod p × Fin q))
      (Fin 3 × (ZMod p × Fin q)) (Fin 3 × (ZMod p × Fin q)) :=
  retainedCode (fun x => armEff a (gX x)) (fun z => armEff a (gZ z))
    (static_zero gX gZ _ _ rho (shift_pair_kchi a gX gZ rho h))

/-- The complete sufficient construction chain: actual route, internal channel
and shift equations, and order-preserving pairing yield legal CSS checks,
the universal encoded-qubit and strict rate bounds, and ordered elimination.
No exact rank, distance, or dynamic measurement claim is made. -/
theorem route_shift_pair {p q : ℕ} [NeZero p] (a : ArmParam p q)
    (gX gZ : Fin 3 → Fin 12) (rho : Fin 3 → Fin 3 → Fin 12 → Fin 12)
    (h : ShiftPair a gX gZ rho) :
    (routeCode a gX gZ rho h).hX * (routeCode a gX gZ rho h).hZᵀ = 0 ∧
      6 * Fintype.card (ZMod p × Fin q) + 4
        ≤ (routeCode a gX gZ rho h).encodedQubits ∧
      (1 / 2 : ℚ) < ((routeCode a gX gZ rho h).encodedQubits : ℚ) /
        (12 * Fintype.card (ZMod p × Fin q) : ℕ) ∧
      ordC (steps gX (fun x => armEff a (gX x)))
        (steps gZ (fun z => armEff a (gZ z))) = 0 := by
  exact ⟨(routeCode a gX gZ rho h).hcompat,
    route_pair a gX gZ rho (shift_pair_kchi a gX gZ rho h) (0, ⟨0, a.hq⟩)⟩

end Qatlib.Papers.Armillary26.Instances
