module

public import Qatlib.Papers.DiracEquation16.LieStep.NativeWalk

@[expose] public section

/-!
# Constant scalar potential as a global phase

Section III.B.3 of [FillionGourdeauMacLeanLaflamme2017] observes that a translation-invariant
scalar potential can be dropped from the gate word: the factor `QV` of Eq. (23) degenerates to a
global phase when `V` is constant. This module proves that restricted statement for the finite
register. The unitary `scalarGate V e dt` is a rotation generated by the diagonal potential, and a
constant diagonal is a scalar multiple of the identity, so the generated exponential is a scalar
multiple of the identity on the whole spin-position register.

## Main statements

* `scalarGate_const_eq_globalPhase`: a constant potential yields the scalar phase
  `exp (-i e dt c₀)` times the identity.

## References

* [Fillion-Gourdeau et al., 2017][FillionGourdeauMacLeanLaflamme2017]
-/

set_option autoImplicit false

open Matrix
open scoped Matrix.Norms.L2Operator

namespace Qatlib.Papers.DiracEquation16.LieStep

open Qatlib.Foundations.MatrixAlgebra
open Qatlib.Foundations.MatrixAlgebra.CliffordWalk
open Qatlib.Papers.DiracEquation16.LieStep

/-- Rescaling the generator of a Clifford rotation rescales the angle. -/
theorem rotation_smul_generator {I : Type*} [Fintype I] [DecidableEq I]
    (P : Matrix I I ℂ) (c θ : ℝ) :
    CliffordWalk.rotation (c • P) θ = CliffordWalk.rotation P (c * θ) := by
  unfold CliffordWalk.rotation
  congr 1
  ext i j
  simp only [Matrix.smul_apply, smul_eq_mul, RCLike.real_smul_eq_coe_mul]
  push_cast
  ring

/-- The complex exponential of a negative imaginary argument, in terms of cosine and sine. -/
theorem exp_neg_I_mul (x : ℝ) :
    Complex.exp (-Complex.I * (x : ℂ)) =
      (Real.cos x : ℂ) - Complex.I * (Real.sin x : ℂ) := by
  rw [show (-Complex.I * (x : ℂ)) = ((-x : ℝ) : ℂ) * Complex.I by push_cast; ring]
  rw [Complex.exp_mul_I, ← Complex.ofReal_cos, ← Complex.ofReal_sin, Real.cos_neg,
    Real.sin_neg]
  push_cast
  ring

/-- A constant scalar potential contributes only the global phase `exp (-i e dt c₀)` to the
finite-register step, the degenerate case of Eq. (23) discussed in Sec. III.B.3 of
[FillionGourdeauMacLeanLaflamme2017]. -/
theorem scalarGate_const_eq_globalPhase {G : Type*} [Fintype G] [DecidableEq G]
    (c0 e dt : ℝ) :
    scalarGate (fun _ : G => c0) e dt =
      Complex.exp (-Complex.I * ((e * dt * c0 : ℝ) : ℂ)) •
        (1 : Matrix (Fin 4 × G) (Fin 4 × G) ℂ) := by
  have hdiag : Matrix.diagonal (fun _ : Fin 4 × G => (c0 : ℂ)) =
      c0 • (1 : Matrix (Fin 4 × G) (Fin 4 × G) ℂ) := by
    ext i j
    by_cases h : i = j
    · subst h
      simp
    · simp [h]
  rw [scalarGate, hdiag, rotation_smul_generator,
    CliffordWalk.rotation_euler_complex 1 (by simp)]
  rw [show c0 * (e * dt) = e * dt * c0 by ring, ← add_smul]
  rw [exp_neg_I_mul]
  congr 1
  ring

end Qatlib.Papers.DiracEquation16.LieStep
