module

public import Qatlib.Concepts.TrotterFormula.LieStrang.CommutatorProductFormula
public import Qatlib.Foundations.MatrixAlgebra.CliffordWalk.Euler

@[expose] public section

/-!
# Two-factor rotation error

The Dirac step of [FillionGourdeauMacLeanLaflamme2017] is a product of rotation factors of the
form `CliffordWalk.rotation`. Eq. (23) splits the evolution into such factors, and the local error
of the split is measured by comparing the ordered product of two factors with the single rotation
generated by the sum of their generators.

This module records the identification of a Clifford rotation with the Hamiltonian evolution of
the same generator and derives the two-factor error bound of Eq. (23) from the published two-term
Lie estimate `Qatlib.Concepts.TrotterFormula.LieStrang.product_formula_lie_two_term`.

## Main statements

* `rotation_eq_hamiltonianEvolution`: a Clifford rotation is a Hamiltonian evolution.
* `rotation_mul_rotation_error`: two rotation factors differ from the summed rotation by at most
  `t ^ 2 / 2 * ‖B * A - A * B‖` in the operator norm.

## References

* [Fillion-Gourdeau et al., 2017][FillionGourdeauMacLeanLaflamme2017]
* [Childs et al., 2021][ChildsEtAl2021Trotter]
-/

set_option autoImplicit false

open Matrix
open scoped Matrix.Norms.L2Operator

namespace Qatlib.Papers.DiracEquation16.LieStep

open Qatlib.Foundations.MatrixAlgebra
open Qatlib.Foundations.MatrixAlgebra.CliffordWalk
open Qatlib.Foundations.PureStateMath
open Qatlib.Concepts.TrotterFormula.LieStrang

/-- A Clifford rotation of a generator by angle `t` is the Hamiltonian evolution of the same
generator for time `t`. -/
theorem rotation_eq_hamiltonianEvolution {D : ℕ} (A : Operator D) (t : ℝ) :
    CliffordWalk.rotation A t = HamiltonianEvolution A t := by
  rw [CliffordWalk.rotation_eq_exp]
  unfold HamiltonianEvolution
  congr 1
  push_cast
  ring_nf

/-- Two rotation factors differ from the rotation generated by the sum of their generators by at
most `t ^ 2 / 2 * ‖B * A - A * B‖`, the two-factor instance of the split in Eq. (23) of
[FillionGourdeauMacLeanLaflamme2017]. -/
theorem rotation_mul_rotation_error {D : ℕ} (A B : Operator D) (hA : A.IsHermitian)
    (hB : B.IsHermitian) (t : ℝ) :
    ‖CliffordWalk.rotation A t * CliffordWalk.rotation B t - CliffordWalk.rotation (A + B) t‖ ≤
      t ^ 2 / 2 * ‖B * A - A * B‖ := by
  have h := product_formula_lie_two_term D B A t hB hA
  rw [rotation_eq_hamiltonianEvolution A t, rotation_eq_hamiltonianEvolution B t,
    rotation_eq_hamiltonianEvolution (A + B) t, add_comm A B] at *
  simpa [pfLie, pfComm, norm_sub_rev] using h

end Qatlib.Papers.DiracEquation16.LieStep
