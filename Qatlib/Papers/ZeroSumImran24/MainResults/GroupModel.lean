/-
Paper-layer group-theoretic model for Imran--Ivanyos,
"Zero sum subsequences and hidden subgroups".

Fixed source version: arXiv:2304.08376v1 (17 Apr 2023).
Definitions used by Theorem 1, Proposition 1, Lemma 2, Propositions 2 and 3
(paper §2.2, §3, §4).

The paper works over finite nilpotent black-box groups with unique encoding by
`ℓ`-bit strings (§2.2). We record the group-theoretic predicates faithfully:

* `commutatorSubgroup`, `lowerCentralSeries`, `IsNilpotentClassLE` — the lower
  central series `G = G₀ ▷ G₁ ▷ … ▷ G_c = 1` with `G_i = [G, G_{i-1}]` (§2.2).
* `PrimeFactorsBounded`, `EncodedByBits` — the two constant-size hypotheses of
  Theorem 1.
* `IsSemiElementary` — `G` a `p`-group of order `p^n` with elementary-abelian
  abelianisation `G/G'` (§1, p.3; §4).
* `HsmcAnswer` — the HSMC answer `H·G'` (§1, p.3).

Exact quantum computation itself (§2.1, uniform circuit families of Nishimura--
Ozawa) is kept outside the paper layer: the resource-bearing solvability
predicates `ExactHSPSolvable`, `HsmcSolvable` below are *specifications* of the
paper's model, not a re-implementation of the quantum oracle semantics.
-/
import Mathlib.Analysis.SpecialFunctions.Pow.Real
import Mathlib.Algebra.Group.Subgroup.Basic
import Qatlib.Papers.ZeroSumImran24.MainResults.SourceModel

set_option backward.isDefEq.respectTransparency false

set_option autoImplicit false
noncomputable section

namespace Qatlib.Papers.ZeroSumImran24.MainResults

/-! ## Lower central series and nilpotency class -/

section GroupTheory

variable (G : Type*) [Group G]

/-- The set of basic commutators `[h,k] = h k h⁻¹ k⁻¹` for `h ∈ H`, `k ∈ K`. -/
def commutatorSet (H K : Subgroup G) : Set G :=
  {x | ∃ h ∈ H, ∃ k ∈ K, x = h * k * h⁻¹ * k⁻¹}

/-- The commutator subgroup `[H,K]` generated by `commutatorSet H K` (§2.2). -/
def commutatorSubgroup (H K : Subgroup G) : Subgroup G :=
  Subgroup.closure (commutatorSet G H K)

/-- The lower central series `G₀ = G`, `G_{n+1} = [G, G_n]` (§2.2). -/
def lowerCentralSeries : ℕ → Subgroup G
  | 0 => ⊤
  | n + 1 => commutatorSubgroup G ⊤ (lowerCentralSeries n)

/-- `G` has nilpotency class at most `c`, i.e. `G_c = 1` (§2.2). -/
def IsNilpotentClassLE (c : ℕ) : Prop := lowerCentralSeries G c = ⊥

/-- The derived (commutator) subgroup `G' = [G,G]`. -/
def derivedSubgroup : Subgroup G := commutatorSubgroup G ⊤ ⊤

end GroupTheory

/-! ## Hypothesis vocabulary -/

/-- The prime factors of `|G|` are bounded by `b` (Theorem 1 hypothesis). -/
def PrimeFactorsBounded (G : Type*) [Group G] [Fintype G] (b : ℕ) : Prop :=
  ∀ q : ℕ, q.Prime → q ∣ Fintype.card G → q ≤ b

/-- `G` is uniquely encoded by `ℓ`-bit strings (Theorem 1 hypothesis; we record
the induced cardinality bound `|G| ≤ 2^ℓ`). -/
def EncodedByBits (G : Type*) [Group G] [Fintype G] (ell : ℕ) : Prop :=
  Fintype.card G ≤ 2 ^ ell

/-- `G` is semi-elementary for `p`: order `p^n` and elementary abelian
abelianisation, i.e. `g^p ∈ G'` for every `g` (§1, p.3; §4). -/
def IsSemiElementary (G : Type*) [Group G] [Fintype G] (p n : ℕ) : Prop :=
  Fintype.card G = p ^ n ∧ ∀ g : G, g ^ p ∈ derivedSubgroup G

/-- The HSMC answer: the hidden subgroup modulo the commutator, `H·G'` (§1). -/
def HsmcAnswer (G : Type*) [Group G] (H : Subgroup G) : Subgroup G :=
  H ⊔ derivedSubgroup G

/-! ## Specification predicates for the paper's exact quantum procedures

The paper's resource claims ("`poly(ℓ)` operations", "`poly(log|G|)` oracle
calls") are upper bounds delivered by the Nashimura--Ozawa uniform-circuit
model (§2.1). We package the specification of a correct exact solver together
with its claimed resource profile as a structure. The `ops`/`calls` fields are
the paper's operation and oracle-call counts; the `solve`/`correct` fields pin
the end-to-end correctness to the true answer. This is a *specification*, and
the paper layer does not formalise the underlying circuit semantics. -/

/-- A hidden-subgroup instance: a hiding function `f` that is constant exactly
on the left cosets of the hidden subgroup `H` (§1, standard HSP). -/
structure HSPInstance (G : Type*) [Group G] where
  H : Subgroup G
  f : G → ℂ
  constant_on_cosets : ∀ x y : G, y⁻¹ * x ∈ H → f x = f y
  separated : ∀ x y : G, y⁻¹ * x ∉ H → f x ≠ f y

/-- Exact quantum procedure solving the HSP in `G` from the hiding function,
with `ops` elementary operations and `calls` applications of the subgroup-state
oracle and its inverse (Theorem 1). -/
structure ExactHSPSolver (G : Type*) [Group G] where
  ops : ℕ
  calls : ℕ
  solve : (G → ℂ) → Subgroup G
  correct : ∀ inst : HSPInstance G, solve inst.f = inst.H

/-- Exact quantum procedure solving HSMC (compute `H·G'`) in `G` from the
hiding function, with the given operation and oracle-call counts
(Proposition 2). -/
structure HsmcSolver (G : Type*) [Group G] where
  ops : ℕ
  calls : ℕ
  solve : (G → ℂ) → Subgroup G
  correct : ∀ inst : HSPInstance G, solve inst.f = HsmcAnswer G inst.H

/-- Non-exact quantum procedure solving HSMC with success probability at least
`1 - 2⁻¹` (Proposition 3, "high probability"). -/
structure RandomizedHsmcSolver (G : Type*) [Group G] where
  ops : ℕ
  calls : ℕ
  solve : (G → ℂ) → Subgroup G
  successProb : ℚ
  successProb_lower : 1 / 2 ≤ successProb

end Qatlib.Papers.ZeroSumImran24.MainResults
