import Qatlib.Papers.NonAbelianHSP01.MainResults.Defs
import Qatlib.Papers.NonAbelianHSP01.MainResults.MembershipReduction
import Qatlib.Papers.NonAbelianHSP01.MainResults.Reductions

/-!
# Coprime power relations for subgroup membership

States the membership criterion for a subgroup generated by finitely many commuting elements.
The separate declaration `theorem_six_oracles` supplies nonemptiness of the oracle interface
under the given encoding hypothesis. See [IvanyosMagniezSantha2003] for the surrounding
analysis.

## Main statements

* `theorem_six`: An element lies in the subgroup generated by a finite commuting family exactly
  when there is an integer-power relation `zpowProd h hcomm m * g ^ (-n) = 1` with `n.natAbs`
  coprime to `orderOf g`.
* `theorem_six_oracles`: Given black-box group data and a unique encoding, the oracle interface
  `Oracles B` is nonempty.

## References

* [Ivanyos et al., 2003][IvanyosMagniezSantha2003]
-/

set_option autoImplicit false

namespace Qatlib.Papers.NonAbelianHSP01.MainResults.Claims

open scoped IsMulCommutative

/-- An element lies in the subgroup generated by a finite commuting family exactly when there is
an integer-power relation `zpowProd h hcomm m * g ^ (-n) = 1` with `n.natAbs` coprime to
`orderOf g` [IvanyosMagniezSantha2003]. -/
theorem theorem_six {M : Type*} [Group M] {ι : Type*} [Fintype ι] [DecidableEq ι]
    (h : ι → M) (hcomm : ∀ i j : ι, Commute (h i) (h j)) (g : M) :
    g ∈ Subgroup.closure (Set.range h) ↔
      ∃ (m : ι → ℤ) (n : ℤ),
        Nat.Coprime n.natAbs (orderOf g) ∧
          (zpowProd h hcomm m : M) * g ^ (-n) = 1 :=
  exists_coprime_kernel_iff h hcomm g

/-- Given black-box group data and a unique encoding, the oracle interface `Oracles B` is
nonempty [IvanyosMagniezSantha2003]. -/
theorem theorem_six_oracles {G : Type*} [Group G] (B : BlackBoxGroupData G)
    (E : Encoding G) (_hE : E.Unique) : Nonempty (Oracles B) :=
  oracles_nonempty B

end Qatlib.Papers.NonAbelianHSP01.MainResults.Claims
