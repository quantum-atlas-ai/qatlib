import Qatlib.Papers.SemidirectHSP07.MainResults.ReductionSource
import Mathlib.GroupTheory.QuotientGroup.Basic
import Mathlib.GroupTheory.Commutator.Basic

/-!
# Abelian quotient and normal candidate subgroups

This module develops the group-theoretic ingredients for the class (1) abelian reduction
discussed in [CosmePortugal2007]. For prime `p` and `2 ≤ r`, `classOne_quotient_commutative`
shows that quotienting `SDG p r φ` by the cyclic subgroup generated by `xGen p r φ ^ p ^ (r -
2)` gives a commutative group.

When `4 ≤ r`, that subgroup lies inside the one generated by `xGen p r φ ^ p ^ 2`. This
containment establishes normality of that candidate and of `form2 p r φ 2 2`.

## Main statements

* `classOne_quotient_commutative` proves commutativity of the quotient by the specified normal
  subgroup.
- `K0_le_cyclic_square` gives the containment needed for the larger candidates.
- `candidate_square_normal` and `candidate_form2_two_two_normal` prove their normality.

## References

* [Cosme and Portugal, 2007][CosmePortugal2007]
-/

set_option warningAsError false
set_option backward.isDefEq.respectTransparency false

set_option autoImplicit false
set_option linter.unusedVariables false
noncomputable section

namespace Qatlib.Papers.SemidirectHSP07.MainResults

open scoped commutatorElement

/-- For prime `p`, `2 ≤ r`, and a `ClassOne` action, the quotient by the normal cyclic subgroup
generated by `xGen p r φ ^ p ^ (r - 2)` is commutative [CosmePortugal2007]. -/
theorem classOne_quotient_commutative (p r : ℕ) (hp : p.Prime) (hr : 2 ≤ r)
    (φ : Cyc (p ^ 2) →* MulAut (Cyc (p ^ r))) (hφ : ClassOne p r φ) :
    letI : (Subgroup.zpowers (xGen p r φ ^ p ^ (r - 2))).Normal := K0_normal p r hp φ hφ
    IsMulCommutative (SDG p r φ ⧸ Subgroup.zpowers (xGen p r φ ^ p ^ (r - 2))) := by
  letI : (Subgroup.zpowers (xGen p r φ ^ p ^ (r - 2))).Normal := K0_normal p r hp φ hφ
  exact Subgroup.Normal.quotient_commutative_iff_commutator_le.mpr
    (classOne_commutator_le p r hp hr φ hφ)

/-- For prime `p` and `4 ≤ r`, the cyclic subgroup generated by `xGen p r φ ^ p ^ (r - 2)` lies
in the one generated by `xGen p r φ ^ p ^ 2` [CosmePortugal2007]. -/
theorem K0_le_cyclic_square (p r : ℕ) (hp : p.Prime) (hr4 : 4 ≤ r)
    (φ : Cyc (p ^ 2) →* MulAut (Cyc (p ^ r))) :
    Subgroup.zpowers (xGen p r φ ^ p ^ (r - 2)) ≤
      Subgroup.zpowers (xGen p r φ ^ p ^ 2) := by
  rw [Subgroup.zpowers_le]
  have h : p ^ (r - 2) = p ^ 2 * p ^ (r - 4) := by
    rw [← pow_add]
    congr 1
    omega
  rw [h, pow_mul]
  exact Subgroup.pow_mem _ (Subgroup.mem_zpowers _) _

/-- For prime `p`, `4 ≤ r`, and a `ClassOne` action, the cyclic subgroup generated by `xGen p r
φ ^ p ^ 2` is normal [CosmePortugal2007]. -/
theorem candidate_square_normal (p r : ℕ) (hp : p.Prime) (hr4 : 4 ≤ r)
    (φ : Cyc (p ^ 2) →* MulAut (Cyc (p ^ r))) (hφ : ClassOne p r φ) :
    (Subgroup.zpowers (xGen p r φ ^ p ^ 2)).Normal :=
  normal_of_contains_commutator p r hp (by omega) φ hφ _
    (K0_le_cyclic_square p r hp hr4 φ)

/-- For prime `p`, `4 ≤ r`, and a `ClassOne` action, the candidate subgroup `form2 p r φ 2 2` is
normal [CosmePortugal2007]. -/
theorem candidate_form2_two_two_normal (p r : ℕ) (hp : p.Prime) (hr4 : 4 ≤ r)
    (φ : Cyc (p ^ 2) →* MulAut (Cyc (p ^ r))) (hφ : ClassOne p r φ) :
    (form2 p r φ 2 2).Normal := by
  refine normal_of_contains_commutator p r hp (by omega) φ hφ _ ?_
  refine le_trans (K0_le_cyclic_square p r hp hr4 φ) ?_
  rw [Subgroup.zpowers_le]
  change xGen p r φ ^ p ^ 2 ∈
    Subgroup.closure ({xGen p r φ ^ p ^ 2, yGen p r φ ^ p ^ 2} : Set (SDG p r φ))
  exact Subgroup.subset_closure (by simp)

end Qatlib.Papers.SemidirectHSP07.MainResults
