import Qatlib.Papers.SemidirectHSP07.MainResults.Group
import Qatlib.Papers.SemidirectHSP07.MainResults.CommutatorStructure
import Mathlib.GroupTheory.PGroup
import Mathlib.GroupTheory.Nilpotent
import Mathlib.GroupTheory.Commutator.Basic

/-!
# Solvability and normality for the class (1) reduction

This module establishes two structural ingredients for the class (1) reductions of
[CosmePortugal2007]. The theorem `classOne_isSolvable` obtains solvability of `SDG p r φ` from
its finite prime-power order.

For `2 ≤ r`, `normal_of_contains_commutator` shows that a subgroup containing the cyclic
subgroup generated by `xGen p r φ ^ p ^ (r - 2)` is normal, using the previously established
containment of the commutator subgroup.

## Main statements

- `classOne_isSolvable` proves solvability under the stated prime and action assumptions.
* `normal_of_contains_commutator` turns containment of the specified cyclic subgroup into
  normality.

## References

* [Cosme and Portugal, 2007][CosmePortugal2007]
-/

set_option warningAsError false
set_option backward.isDefEq.respectTransparency false

set_option autoImplicit false
set_option linter.unusedVariables false
noncomputable section

namespace Qatlib.Papers.SemidirectHSP07.MainResults

open scoped commutatorElement

/-- For prime `p` and a `ClassOne` action, the group `SDG p r φ` is solvable, as follows from
its finite `p`-group structure [CosmePortugal2007]. -/
theorem classOne_isSolvable (p r : ℕ) (hp : p.Prime)
    (φ : Cyc (p ^ 2) →* MulAut (Cyc (p ^ r))) (hφ : ClassOne p r φ) :
    Group.IsSolvable (SDG p r φ) := by
  haveI : Fact p.Prime := ⟨hp⟩
  haveI : Finite (SDG p r φ) :=
    Nat.finite_of_card_ne_zero (by
      rw [card_SDG_prime_pow p r hp φ]
      exact pow_ne_zero _ hp.ne_zero)
  haveI : Group.IsNilpotent (SDG p r φ) := (isPGroup_SDG p r hp φ).isNilpotent
  infer_instance

/-- For prime `p`, `2 ≤ r`, and a `ClassOne` action, any subgroup containing the cyclic subgroup
generated by `xGen p r φ ^ p ^ (r - 2)` is normal [CosmePortugal2007]. -/
theorem normal_of_contains_commutator (p r : ℕ) (hp : p.Prime) (hr : 2 ≤ r)
    (φ : Cyc (p ^ 2) →* MulAut (Cyc (p ^ r))) (hφ : ClassOne p r φ)
    (H : Subgroup (SDG p r φ))
    (hH : Subgroup.zpowers (xGen p r φ ^ p ^ (r - 2)) ≤ H) : H.Normal :=
  Subgroup.Normal.of_commutator_le (SDG p r φ) (H := H)
    (le_trans (classOne_commutator_le p r hp hr φ hφ) hH)

end Qatlib.Papers.SemidirectHSP07.MainResults
