import Qatlib.Papers.DihedralSub16.MainResults.DifferenceSetInfluence
import Mathlib.GroupTheory.SpecificGroups.Dihedral
import Mathlib.Data.ZMod.Basic
import Mathlib.Tactic

namespace Qatlib.Papers.DihedralSub16.MainResults

open DihedralGroup

variable {N : ℕ} {S : Type*}

/-- `IsHidingFunction F H` says that `F` is constant exactly on the cosets of `H`,
i.e. `H` is a hidden subgroup of the hidden subgroup problem with hiding function
`F` (`F x = F y ↔ x⁻¹ y ∈ H`). -/
def IsHidingFunction (F : DihedralGroup N → S) (H : Subgroup (DihedralGroup N)) : Prop :=
  ∀ x y : DihedralGroup N, F x = F y ↔ x⁻¹ * y ∈ H

/-- The order-two subgroup `{1, sr s}` of `DihedralGroup N`; this is the image of
the paper's `⟨(-s, 1)⟩` under the correspondence `(a,1) ↦ sr (-a)`. -/
def orderTwoSubgroup (s : ZMod N) : Subgroup (DihedralGroup N) where
  carrier := {x | x = 1 ∨ x = DihedralGroup.sr s}
  one_mem' := Or.inl rfl
  mul_mem' := by
    rintro x y (hx | hx) (hy | hy)
    · rw [hx, hy, one_mul]; exact Or.inl rfl
    · rw [hx, hy, one_mul]; exact Or.inr rfl
    · rw [hx, hy, mul_one]; exact Or.inr rfl
    · rw [hx, hy, sr_mul_self]; exact Or.inl rfl
  inv_mem' := by
    rintro x (hx | hx)
    · rw [hx, inv_one]; exact Or.inl rfl
    · rw [hx, inv_sr]; exact Or.inr rfl

/-- Membership in the order-two subgroup `{1, sr s}`. -/
theorem mem_orderTwoSubgroup {s : ZMod N} {x : DihedralGroup N} :
    x ∈ orderTwoSubgroup s ↔ x = 1 ∨ x = DihedralGroup.sr s := Iff.rfl

/-- The order-two subgroup generated by `sr s` is `Subgroup.zpowers (sr s)`
(arXiv:1608.02005v1, proof of Theorem 4, step (iii), p. 14). -/
theorem orderTwoSubgroup_eq_zpowers (s : ZMod N) :
    orderTwoSubgroup s = Subgroup.zpowers (DihedralGroup.sr s) := by
  refine le_antisymm ?_ ?_
  · intro x hx
    rw [mem_orderTwoSubgroup] at hx
    rcases hx with rfl | rfl
    · exact Subgroup.one_mem _
    · exact Subgroup.mem_zpowers (G := DihedralGroup N) (DihedralGroup.sr s)
  · rw [Subgroup.zpowers_le]
    exact Or.inr rfl

/-- `r t` lies in the order-two subgroup `{1, sr s}` only for `t = 0`. -/
theorem r_mem_orderTwoSubgroup_iff (s t : ZMod N) :
    DihedralGroup.r t ∈ orderTwoSubgroup s ↔ t = 0 := by
  rw [mem_orderTwoSubgroup, show (1 : DihedralGroup N) = DihedralGroup.r 0 from rfl]
  constructor
  · rintro (h | h)
    · exact DihedralGroup.r.inj h
    · exact False.elim (by injection h)
  · intro h
    exact Or.inl (by rw [h])

/-- `sr t` lies in the order-two subgroup `{1, sr s}` exactly for `t = s`. -/
theorem sr_mem_orderTwoSubgroup_iff (s t : ZMod N) :
    DihedralGroup.sr t ∈ orderTwoSubgroup s ↔ t = s := by
  rw [mem_orderTwoSubgroup, show (1 : DihedralGroup N) = DihedralGroup.r 0 from rfl]
  constructor
  · rintro (h | h)
    · exact False.elim (by injection h.symm)
    · exact DihedralGroup.sr.inj h
  · intro h
    exact Or.inr (by rw [h])

/-- Products of inverses in the dihedral group, in the four constructor cases. -/
theorem r_inv_mul_r (a b : ZMod N) :
    (DihedralGroup.r a)⁻¹ * DihedralGroup.r b = DihedralGroup.r (b - a) := by
  simp [sub_eq_add_neg, add_comm]

/-- `(r a)⁻¹ * sr b = sr (b + a)` in the dihedral group. -/
theorem r_inv_mul_sr (a b : ZMod N) :
    (DihedralGroup.r a)⁻¹ * DihedralGroup.sr b = DihedralGroup.sr (b + a) := by
  simp [add_comm]

/-- `(sr a)⁻¹ * r b = sr (a + b)` in the dihedral group. -/
theorem sr_inv_mul_r (a b : ZMod N) :
    (DihedralGroup.sr a)⁻¹ * DihedralGroup.r b = DihedralGroup.sr (a + b) := by
  simp

/-- `(sr a)⁻¹ * sr b = r (b - a)` in the dihedral group. -/
theorem sr_inv_mul_sr (a b : ZMod N) :
    (DihedralGroup.sr a)⁻¹ * DihedralGroup.sr b = DihedralGroup.r (b - a) := by
  simp

/-- The hiding function on `DihedralGroup N` attached to a pair of functions
`f, g : ZMod N → S`, the paper's `F((a,0)) = f(a)`, `F((a,1)) = g(a)` under the
correspondence `(a,1) ↦ sr (-a)` (arXiv:1608.02005v1, p. 14). -/
def dihedralHiding (f g : ZMod N → S) : DihedralGroup N → S
  | DihedralGroup.r a => f a
  | DihedralGroup.sr a => g (-a)

/-- Theorem 4, step (iii) (arXiv:1608.02005v1, p. 14): an injective hidden shift
instance `g(x) = f(x + s)` yields a dihedral hidden subgroup instance over
`DihedralGroup N` whose hidden subgroup `{1, sr s}` has order two. -/
theorem dihedral_hsp_of_hidden_shift (f g : ZMod N → S) (s : ZMod N)
    (hshift : ∀ x, g x = f (x + s)) (hf : Function.Injective f) :
    IsHidingFunction (dihedralHiding f g) (orderTwoSubgroup s) := by
  intro x y
  constructor
  · intro heq
    rcases x with a | a <;> rcases y with b | b
    · -- `r a` against `r b`
      have hab : a = b := hf heq
      rw [r_inv_mul_r, r_mem_orderTwoSubgroup_iff, hab, sub_self]
    · -- `r a` against `sr b`
      have h : f a = f (s - b) := by
        have h' := heq
        simp only [dihedralHiding] at h'
        rw [hshift (-b)] at h'
        rwa [show -b + s = s - b by abel] at h'
      have hab : a = s - b := hf h
      rw [r_inv_mul_sr, sr_mem_orderTwoSubgroup_iff]
      rw [hab]
      abel
    · -- `sr a` against `r b`
      have h : f (s - a) = f b := by
        have h' := heq
        simp only [dihedralHiding] at h'
        rw [hshift (-a)] at h'
        rwa [show -a + s = s - a by abel] at h'
      have hab : s - a = b := hf h
      rw [sr_inv_mul_r, sr_mem_orderTwoSubgroup_iff]
      rw [← hab]
      abel
    · -- `sr a` against `sr b`
      have h : f (s - a) = f (s - b) := by
        have h' := heq
        simp only [dihedralHiding] at h'
        rw [hshift (-a), hshift (-b)] at h'
        rwa [show -a + s = s - a by abel, show -b + s = s - b by abel] at h'
      have hab : s - a = s - b := hf h
      have hab' : a = b := by
        have h2 : s - (s - a) = s - (s - b) := by rw [hab]
        simpa using h2
      rw [sr_inv_mul_sr, r_mem_orderTwoSubgroup_iff, hab', sub_self]
  · intro hmem
    rcases x with a | a <;> rcases y with b | b
    · -- `r a` against `r b`
      rw [r_inv_mul_r, r_mem_orderTwoSubgroup_iff] at hmem
      have hab : a = b := (sub_eq_zero.mp hmem).symm
      simp only [dihedralHiding]
      rw [hab]
    · -- `r a` against `sr b`
      rw [r_inv_mul_sr, sr_mem_orderTwoSubgroup_iff] at hmem
      have ha : a = s - b := by
        rw [← hmem]
        abel
      simp only [dihedralHiding]
      rw [hshift (-b), show -b + s = s - b by abel, ha]
    · -- `sr a` against `r b`
      rw [sr_inv_mul_r, sr_mem_orderTwoSubgroup_iff] at hmem
      have hb : s - a = b := by
        rw [← hmem]
        abel
      simp only [dihedralHiding]
      rw [hshift (-a), show -a + s = s - a by abel, hb]
    · -- `sr a` against `sr b`
      rw [sr_inv_mul_sr, r_mem_orderTwoSubgroup_iff] at hmem
      have hab : a = b := (sub_eq_zero.mp hmem).symm
      simp only [dihedralHiding]
      rw [hshift (-a), hshift (-b), show -a + s = s - a by abel,
        show -b + s = s - b by abel, hab]

/-- Theorem 4, step (iii), converse (arXiv:1608.02005v1, p. 14): if `F` is a
hiding function for the order-two subgroup `{1, sr s}`, then the two functions
`x ↦ F(r x)` and `x ↦ F(sr (-x))` form a hidden shift instance with shift `s`. -/
theorem hidden_shift_of_dihedral_hsp (F : DihedralGroup N → S) (s : ZMod N)
    (hF : IsHidingFunction F (orderTwoSubgroup s)) (x : ZMod N) :
    F (DihedralGroup.sr (-x)) = F (DihedralGroup.r (x + s)) := by
  refine (hF (DihedralGroup.sr (-x)) (DihedralGroup.r (x + s))).mpr ?_
  rw [sr_inv_mul_r, sr_mem_orderTwoSubgroup_iff]
  abel

/-- The resource profile claimed in Theorem 4 for Algorithm 1 on the Singer
family `N = 2^n - 1`: the number of queries to the hiding function, the quantum
time, and the quantum space, as functions of `n`.  The bounds are the paper's
`O(log N)` queries, `O(polylog N)` time and `O(log N)` space. -/
structure Theorem4Resources where
  /-- number of queries to the hiding function -/
  queries : ℕ → ℕ
  /-- quantum time -/
  time : ℕ → ℕ
  /-- quantum space -/
  space : ℕ → ℕ
  /-- `O(log N)` queries -/
  queries_log : ∃ c : ℕ, ∀ n : ℕ, 2 ≤ n → queries n ≤ c * (n + 1)
  /-- `O(polylog N)` quantum time -/
  time_poly : ∃ c d : ℕ, ∀ n : ℕ, 2 ≤ n → time n ≤ c * (n + 1) ^ d
  /-- `O(log N)` quantum space -/
  space_log : ∃ c : ℕ, ∀ n : ℕ, 2 ≤ n → space n ≤ c * (n + 1)

/-- A solver for the Singer-family dihedral hidden subgroup instances in the shape
produced in the proof of Theorem 4: a classical output function that recovers the
hidden shift from the hiding function, together with the three resource functions
of Algorithm 1 and the correctness of the recovery. -/
structure Theorem4Solver extends Theorem4Resources where
  /-- the shift output by the algorithm on the instance with hiding function `F` -/
  solve : ∀ n : ℕ, (DihedralGroup (2 ^ n - 1) → Bool) → ZMod (2 ^ n - 1)
  /-- the algorithm recovers the shift of every order-two instance -/
  correct : ∀ (n : ℕ) (_hn : 2 ≤ n) (s : ZMod (2 ^ n - 1))
    (F : DihedralGroup (2 ^ n - 1) → Bool),
    IsHidingFunction F (orderTwoSubgroup s) → solve n F = s

end Qatlib.Papers.DihedralSub16.MainResults
