module

public import Qatlib.Concepts.TrotterFormula.LieStrang.CommutatorProductFormula
public import Qatlib.Foundations.PureStateMath.Qubit
public import Mathlib.Analysis.SpecialFunctions.Pow.Real

@[expose] public section

/-!
# Group-commutator error of the double-bracket step

Paper version: **arXiv:2408.03987**, [GroundDBrak24], Sec. II A, Eq. (5), material lines 72-76.
<https://arxiv.org/abs/2408.03987>

The group commutator of the four short evolutions
`e^{-i√s H} e^{i√s D} e^{i√s H} e^{-i√s D}` approximates the evolution generated by the
commutator of `D` and `H` up to an `O(s^{3/2})` operator-norm error.

The source assessment writes the right-hand side as `rexp (commutator D H) s`, i.e.
`e^{+s [D,H]}`.  That sign is not the one produced by the four factors: the leading term is
`e^{-s [D,H]}`.  For small `s` the two exponentials differ by `2 s ‖[D,H]‖ + O(s²)`, so no
constant makes that literal statement true.  This module therefore records the corrected
companion `group_commutator_error_neg` with the target `rexp (commutator H D) s`, together with
its quantitative remainder bound.

The file restates the paper-local primitives `evo`, `rexp` and `commutator` of
`Qatlib.Papers.GroundDBrak24.MainResults.HigherOrder` under the `L²` operator norm.  The Public
`HigherOrder` module fixes `linfty` operator-norm instances locally, while the public
product-formula estimates used below are stated for the `L²` operator norm, so the restatement
keeps every estimate syntactically applicable.

## Main statements

* `exp_conj_second_order`: second-order remainder of conjugation by an exponential.
* `group_commutator_error_neg`: the corrected `O(s^{3/2})` group-commutator estimate.

## References

* [GroundDBrak24], arXiv:2408.03987, Eq. (5)
* [Childs et al., 2021][ChildsEtAl2021Trotter]
-/

set_option autoImplicit false
set_option maxHeartbeats 1200000

namespace Qatlib.Papers.GroundDBrak24.MainResults

open Matrix
open Qatlib.Foundations.PureStateMath
open Qatlib.Foundations.OperatorErrors.OperatorError
open Qatlib.Concepts.TrotterFormula.LieStrang
open scoped Matrix.Norms.L2Operator BigOperators

noncomputable section

noncomputable local instance matrixNormedAlgebraRat (n : ℕ) :
    NormedAlgebra ℚ (Matrix (Fin n) (Fin n) ℂ) :=
  NormedAlgebra.restrictScalars ℚ ℂ (Matrix (Fin n) (Fin n) ℂ)

/-- The granted operator evolution `e^{ⅈ r A}` of a square complex matrix. -/
def evo {n : ℕ} (A : Matrix (Fin n) (Fin n) ℂ) (r : ℂ) : Matrix (Fin n) (Fin n) ℂ :=
  NormedSpace.exp ((Complex.I * r) • A)

/-- The real-exponent matrix exponential `e^{t A}`, used for the commutator evolution on the
right-hand side of Eq. (5). -/
def rexp {n : ℕ} (A : Matrix (Fin n) (Fin n) ℂ) (t : ℝ) : Matrix (Fin n) (Fin n) ℂ :=
  NormedSpace.exp (t • A)

/-- The matrix commutator `[A, B] = A * B - B * A`. -/
def commutator {n : ℕ} (A B : Matrix (Fin n) (Fin n) ℂ) : Matrix (Fin n) (Fin n) ℂ :=
  A * B - B * A

/-- The granted evolution `e^{-ⅈ t A}` equals the Hamiltonian evolution `HamiltonianEvolution A t`
of the public library. -/
theorem evo_ham {n : ℕ} (A : Matrix (Fin n) (Fin n) ℂ) (t : ℝ) :
    evo A (-(t : ℂ)) = HamiltonianEvolution A t := by
  unfold evo HamiltonianEvolution
  congr 1
  ext i j
  simp only [Matrix.smul_apply]
  ring

/-- The granted evolution `e^{ⅈ t A}` is the Hamiltonian evolution at time `-t`. -/
theorem evo_ham' {n : ℕ} (A : Matrix (Fin n) (Fin n) ℂ) (t : ℝ) :
    evo A (t : ℂ) = HamiltonianEvolution A (-t) := by
  simpa using evo_ham A (-t)

/-- Conjugating a Hermitian generator gives the inverse evolution: `(e^{ⅈ r D})ᴴ = e^{-ⅈ r D}`. -/
theorem evo_conjTranspose {n : ℕ} (D : Matrix (Fin n) (Fin n) ℂ) (hD : D.IsHermitian)
    (r : ℝ) : (evo D (r : ℂ))ᴴ = evo D (-(r : ℂ)) := by
  unfold evo
  rw [← Matrix.exp_conjTranspose]
  congr 1
  rw [Matrix.conjTranspose_smul, hD.eq]
  congr 1
  simp only [star_mul', RCLike.star_def, Complex.conj_I, Complex.conj_ofReal]
  ring

/-- Scaling the left entry of a commutator scales the commutator. -/
theorem commutator_smul_left {n : ℕ} (a : ℂ) (A B : Matrix (Fin n) (Fin n) ℂ) :
    commutator (a • A) B = a • commutator A B := by
  simp only [commutator, Matrix.smul_mul, Matrix.mul_smul, smul_sub]

/-- Scaling the right entry of a commutator scales the commutator. -/
theorem commutator_smul_right {n : ℕ} (a : ℂ) (A B : Matrix (Fin n) (Fin n) ℂ) :
    commutator A (a • B) = a • commutator A B := by
  simp only [commutator, Matrix.smul_mul, Matrix.mul_smul, smul_sub]

/-- Real and complex scalars agree on complex matrices. -/
theorem real_smul_eq_complex {n : ℕ} (t : ℝ) (M : Matrix (Fin n) (Fin n) ℂ) :
    t • M = (t : ℂ) • M :=
  RCLike.real_smul_eq_coe_smul (K := ℂ) t M

/-- The squared modulus of `ⅈ r` is `r²` for real `r ≥ 0`. -/
theorem norm_I_mul_sq (r : ℝ) (hr : 0 ≤ r) :
    ‖(Complex.I * (r : ℂ)) * (Complex.I * (r : ℂ))‖ = r ^ 2 := by
  rw [norm_mul, norm_mul]
  simp only [Complex.norm_I, one_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hr]
  ring

/-- The derivative of the conjugation path `u ↦ e^{u X} Y e^{-u X}` is the conjugated
commutator `e^{u X} [X, Y] e^{-u X}`. -/
theorem expConj_deriv {n : ℕ} (X Y : Matrix (Fin n) (Fin n) ℂ) (s : ℝ) :
    HasDerivAt (fun u : ℝ => NormedSpace.exp (u • X) * Y * NormedSpace.exp ((-u) • X))
      (NormedSpace.exp (s • X) * commutator X Y * NormedSpace.exp ((-s) • X)) s := by
  have h1 : HasDerivAt (fun u : ℝ => NormedSpace.exp (u • X))
      (NormedSpace.exp (s • X) * X) s := hasDerivAt_exp_smul_const (𝕂 := ℝ) X s
  have h2 : HasDerivAt (fun u : ℝ => NormedSpace.exp ((-u) • X))
      (-(X * NormedSpace.exp ((-s) • X))) s := by
    have h := (hasDerivAt_exp_smul_const' (𝕂 := ℝ) X (-s)).scomp s
      (hasDerivAt_id s).neg
    convert! h using 1
    simp
  convert! ((h1.mul_const Y).mul h2) using 1
  simp only [commutator]
  noncomm_ring

/-- First-order conjugation bound: if all exponential paths `u ↦ e^{u X}` are contractive, then
conjugating `Y` changes it by at most `s ‖[X, Y]‖`. -/
theorem expConj_first_order {n : ℕ} (X Y : Matrix (Fin n) (Fin n) ℂ)
    (hX : ∀ u : ℝ, ‖NormedSpace.exp (u • X)‖ ≤ 1)
    (s : ℝ) (hs : s ∈ Set.Icc (0 : ℝ) 1) :
    ‖NormedSpace.exp (s • X) * Y * NormedSpace.exp ((-s) • X) - Y‖ ≤
      s * ‖commutator X Y‖ := by
  have h := norm_image_sub_le_of_norm_deriv_le_segment'
    (f := fun u : ℝ => NormedSpace.exp (u • X) * Y * NormedSpace.exp ((-u) • X))
    (f' := fun u : ℝ => NormedSpace.exp (u • X) * commutator X Y *
      NormedSpace.exp ((-u) • X))
    (a := 0) (b := 1) (C := ‖commutator X Y‖)
    (fun u _ => (expConj_deriv X Y u).hasDerivWithinAt) (fun u _ => ?_) s hs
  · simpa [mul_comm] using h
  · have hle := l2_norm_sandwich_le (NormedSpace.exp (u • X)) (commutator X Y)
      (NormedSpace.exp ((-u) • X)) (hX u) (hX (-u))
    simpa using hle

/-- Second-order conjugation bound: the conjugation defect is the first commutator plus a
quadratic remainder controlled by the nested commutator. -/
theorem exp_conj_second_order {n : ℕ} (X Y : Matrix (Fin n) (Fin n) ℂ)
    (hX : ∀ u : ℝ, ‖NormedSpace.exp (u • X)‖ ≤ 1) :
    ‖NormedSpace.exp X * Y * NormedSpace.exp (-X) - Y - commutator X Y‖ ≤
      (1 / 2) * ‖commutator X (commutator X Y)‖ := by
  let K : ℝ := ‖commutator X (commutator X Y)‖
  have hder (u : ℝ) : HasDerivAt
      (fun v : ℝ => NormedSpace.exp (v • X) * Y * NormedSpace.exp ((-v) • X) - Y -
        v • commutator X Y)
      (NormedSpace.exp (u • X) * commutator X Y * NormedSpace.exp ((-u) • X) -
        commutator X Y) u := by
    simpa only [id_eq, one_smul] using!
      (((expConj_deriv X Y u).sub_const Y).sub
        ((hasDerivAt_id u).smul_const (commutator X Y)))
  have hbound : ∀ u ∈ Set.Icc (0 : ℝ) 1,
      ‖NormedSpace.exp (u • X) * Y * NormedSpace.exp ((-u) • X) - Y -
        u • commutator X Y‖ ≤ u ^ 2 / 2 * K := by
    refine image_norm_le_of_norm_deriv_right_le_deriv_boundary
      (f := fun v : ℝ => NormedSpace.exp (v • X) * Y * NormedSpace.exp ((-v) • X) - Y -
        v • commutator X Y)
      (f' := fun v : ℝ => NormedSpace.exp (v • X) * commutator X Y *
        NormedSpace.exp ((-v) • X) - commutator X Y)
      (B := fun v : ℝ => v ^ 2 / 2 * K) (B' := fun v : ℝ => v * K)
      (fun v _ => (hder v).continuousAt.continuousWithinAt)
      (fun v _ => (hder v).hasDerivWithinAt) (by simp) ?_ ?_
    · intro u
      convert! ((hasDerivAt_id u).pow 2).mul_const (K / 2) using 1
      · funext x
        simp only [pow_two, Pi.mul_apply, id_eq]
        ring
      · simp only [id_eq]
        ring
    · intro u hu
      have h := expConj_first_order X (commutator X Y) hX u ⟨hu.1, hu.2.le⟩
      simpa [K] using h
  simpa [K, neg_one_smul] using hbound 1 ⟨zero_le_one, le_rfl⟩

/-- Conjugating a Hermitian matrix by the exponential of a Hermitian generator stays
Hermitian: `e^{ⅈ r D} H e^{-ⅈ r D}` is Hermitian whenever `D` and `H` are. -/
theorem conj_evo_hermitian {n : ℕ} (D H : Matrix (Fin n) (Fin n) ℂ) (hD : D.IsHermitian)
    (hH : H.IsHermitian) (r : ℝ) :
    (evo D (r : ℂ) * H * evo D (-(r : ℂ))).IsHermitian := by
  have hstar : (evo D (r : ℂ))ᴴ = evo D (-(r : ℂ)) := evo_conjTranspose D hD r
  have h := isHermitian_conjTranspose_mul_mul (B := (evo D (r : ℂ))ᴴ) hH
  rwa [conjTranspose_conjTranspose, hstar] at h

/-- Conjugating an evolution by an evolution of the same generator: the three-factor product
`e^{ⅈ r D} e^{ⅈ r H} e^{-ⅈ r D}` is the single evolution generated by the conjugate
`P = e^{ⅈ r D} H e^{-ⅈ r D}`. -/
theorem conj_evo_mul {n : ℕ} (D H : Matrix (Fin n) (Fin n) ℂ) (hD : D.IsHermitian)
    (r : ℝ) :
    evo D (r : ℂ) * evo H (r : ℂ) * evo D (-(r : ℂ)) =
      evo (evo D (r : ℂ) * H * evo D (-(r : ℂ))) (r : ℂ) := by
  have hU : evo D (r : ℂ) ∈ Matrix.unitaryGroup (Fin n) ℂ := by
    rw [evo_ham']
    exact hamiltonianEvolution_unitary hD (-r)
  have hUnit : IsUnit (evo D (r : ℂ)) :=
    Unitary.isUnit_coe (U := (⟨evo D (r : ℂ), hU⟩ :
      unitary (Matrix (Fin n) (Fin n) ℂ)))
  have hinv : (evo D (r : ℂ))⁻¹ = evo D (-(r : ℂ)) := by
    apply Matrix.inv_eq_right_inv
    have hneg : (-((Complex.I * (r : ℂ)) • D)) = (Complex.I * (-(r : ℂ))) • D := by
      rw [show (Complex.I * (-(r : ℂ))) = -(Complex.I * (r : ℂ)) by ring, neg_smul]
    calc evo D (r : ℂ) * evo D (-(r : ℂ))
        = NormedSpace.exp ((Complex.I * (r : ℂ)) • D) *
            NormedSpace.exp (-((Complex.I * (r : ℂ)) • D)) := by
          rw [show evo D (-(r : ℂ)) =
            NormedSpace.exp (-((Complex.I * (r : ℂ)) • D)) by rw [evo, hneg]]
          rfl
      _ = NormedSpace.exp (((Complex.I * (r : ℂ)) • D) +
            -((Complex.I * (r : ℂ)) • D)) := by
          rw [← NormedSpace.exp_add_of_commute ((Commute.refl _).neg_right)]
      _ = 1 := by simp
  have h := Matrix.exp_conj (evo D (r : ℂ)) ((Complex.I * (r : ℂ)) • H) hUnit
  rw [hinv] at h
  rw [Matrix.mul_smul, Matrix.smul_mul] at h
  simpa [evo, mul_assoc] using h.symm

/-- The commutator of two Hermitian matrices is skew-Hermitian. -/
theorem commutator_adjoint {n : ℕ} (D H : Matrix (Fin n) (Fin n) ℂ) (hD : D.IsHermitian)
    (hH : H.IsHermitian) : (commutator D H)ᴴ = - commutator D H := by
  rw [commutator, Matrix.conjTranspose_sub, Matrix.conjTranspose_mul,
    Matrix.conjTranspose_mul, hD.eq, hH.eq]
  abel

/-- Perturbing a skew-Hermitian exponential by another skew-Hermitian generator changes the
unitary by at most the norm of the perturbation. -/
theorem norm_exp_add_sub_exp_of_skew {n : ℕ} (A E : Matrix (Fin n) (Fin n) ℂ)
    (hA : Aᴴ = -A) (hAE : (A + E)ᴴ = -(A + E)) :
    ‖NormedSpace.exp (A + E) - NormedSpace.exp A‖ ≤ ‖E‖ := by
  have hder (u : ℝ) : HasDerivAt
      (fun v : ℝ => NormedSpace.exp (v • (A + E)) * NormedSpace.exp ((1 - v) • A))
      (NormedSpace.exp (u • (A + E)) * E * NormedSpace.exp ((1 - u) • A)) u := by
    have h1 : HasDerivAt (fun v : ℝ => NormedSpace.exp (v • (A + E)))
        (NormedSpace.exp (u • (A + E)) * (A + E)) u :=
      hasDerivAt_exp_smul_const (𝕂 := ℝ) (A + E) u
    have h2 : HasDerivAt (fun v : ℝ => NormedSpace.exp ((1 - v) • A))
        (-(A * NormedSpace.exp ((1 - u) • A))) u := by
      have h := (hasDerivAt_exp_smul_const' (𝕂 := ℝ) A (1 - u)).scomp u
        ((hasDerivAt_const u (1 : ℝ)).sub (hasDerivAt_id u))
      convert! h using 1
      simp
    convert! (h1.mul h2) using 1
    noncomm_ring
  have hnorm (u : ℝ) (hu : u ∈ Set.uIcc (0 : ℝ) 1) :
      ‖NormedSpace.exp (u • (A + E)) * E * NormedSpace.exp ((1 - u) • A)‖ ≤ ‖E‖ := by
    have h1 : ‖NormedSpace.exp (u • (A + E))‖ ≤ 1 := by
      apply l2_norm_unitary_le_one
      apply exp_unitary_of_skewHermitian
      rw [show (u • (A + E))ᴴ = -(u • (A + E)) by
        rw [Matrix.conjTranspose_smul, hAE, smul_neg]
        simp]
    have h2 : ‖NormedSpace.exp ((1 - u) • A)‖ ≤ 1 := by
      apply l2_norm_unitary_le_one
      apply exp_unitary_of_skewHermitian
      rw [show ((1 - u) • A)ᴴ = -((1 - u) • A) by
        rw [Matrix.conjTranspose_smul, hA, smul_neg]
        simp]
    exact l2_norm_sandwich_le _ E _ h1 h2
  have hint : ‖∫ u in (0 : ℝ)..1,
      NormedSpace.exp (u • (A + E)) * E * NormedSpace.exp ((1 - u) • A)‖ ≤ ‖E‖ := by
    have h := intervalIntegral.norm_integral_le_of_norm_le_const
      (a := 0) (b := 1) (C := ‖E‖)
      (f := fun u : ℝ => NormedSpace.exp (u • (A + E)) * E *
        NormedSpace.exp ((1 - u) • A))
      (fun u hu => hnorm u (Set.uIoc_subset_uIcc hu))
    simpa using h
  have hcont : Continuous (fun u : ℝ =>
      NormedSpace.exp (u • (A + E)) * E * NormedSpace.exp ((1 - u) • A)) := by
    have h1 : Continuous (fun u : ℝ => NormedSpace.exp (u • (A + E))) :=
      NormedSpace.exp_continuous.comp (continuous_id.smul continuous_const)
    have h2 : Continuous (fun u : ℝ => NormedSpace.exp ((1 - u) • A)) :=
      NormedSpace.exp_continuous.comp ((continuous_const.sub continuous_id).smul
        continuous_const)
    exact (h1.mul continuous_const).mul h2
  have hduhamel : NormedSpace.exp (A + E) - NormedSpace.exp A =
      ∫ u in (0 : ℝ)..1, NormedSpace.exp (u • (A + E)) * E *
        NormedSpace.exp ((1 - u) • A) := by
    have hi := intervalIntegral.integral_eq_sub_of_hasDerivAt
      (f := fun v : ℝ => NormedSpace.exp (v • (A + E)) * NormedSpace.exp ((1 - v) • A))
      (f' := fun v : ℝ => NormedSpace.exp (v • (A + E)) * E *
        NormedSpace.exp ((1 - v) • A))
      (fun u (_ : u ∈ Set.uIcc (0 : ℝ) 1) => hder u) (hcont.intervalIntegrable 0 1)
    simpa using hi.symm
  rw [hduhamel]
  exact hint

/-- **Corrected group-commutator error** — [GroundDBrak24], arXiv:2408.03987, Sec. II A,
Eq. (5).  For Hermitian `D` and `H`, the four-factor group commutator
`e^{-ⅈ√s H} e^{ⅈ√s D} e^{ⅈ√s H} e^{-ⅈ√s D}` differs from `e^{s [H, D]}` by an
`O(s^{3/2})` operator-norm error, uniformly for `s ∈ [0, 1]`.

The target commutator is `commutator H D = -commutator D H`: the four factors produce
`e^{-s [D, H]}` to leading order, so the literal target `rexp (commutator D H) s` has the
opposite sign and is false for small `s`. -/
theorem group_commutator_error_neg {n : ℕ} (D H : Matrix (Fin n) (Fin n) ℂ)
    (hD : D.IsHermitian) (hH : H.IsHermitian) :
    ∃ Cst : ℝ, 0 ≤ Cst ∧ ∀ s ∈ Set.Icc (0 : ℝ) 1,
      ‖evo H (-(((Real.sqrt s : ℝ)) : ℂ)) * evo D (((Real.sqrt s : ℝ)) : ℂ)
        * evo H (((Real.sqrt s : ℝ)) : ℂ) * evo D (-(((Real.sqrt s : ℝ)) : ℂ))
        - rexp (commutator H D) s‖ ≤ Cst * s ^ ((3 : ℝ) / 2) := by
  refine ⟨‖commutator D H‖ * ‖H‖ + ‖commutator D (commutator D H)‖ / 2,
    by positivity, ?_⟩
  intro s hs
  let r : ℝ := Real.sqrt s
  have hr0 : 0 ≤ r := Real.sqrt_nonneg s
  have hr1 : r ≤ 1 := by
    have := Real.sqrt_le_sqrt hs.2
    simpa [r] using this
  have hrsq : r ^ 2 = s := by simpa [r] using Real.sq_sqrt hs.1
  let C : Matrix (Fin n) (Fin n) ℂ := commutator D H
  let P : Matrix (Fin n) (Fin n) ℂ := evo D (r : ℂ) * H * evo D (-(r : ℂ))
  have hP : P.IsHermitian := conj_evo_hermitian D H hD hH r
  have hfirst : ‖P - H‖ ≤ r * ‖C‖ := by
    have h := product_formula_conjugation_commutator n D H (-r) hD
    rw [abs_neg, abs_of_nonneg hr0] at h
    have hham : HamiltonianEvolution D (-r) = evo D (r : ℂ) := by
      simpa using (evo_ham D (-r)).symm
    have hconj : (HamiltonianEvolution D (-r))ᴴ = evo D (-(r : ℂ)) := by
      rw [hham]
      exact evo_conjTranspose D hD r
    rw [hconj, hham] at h
    simpa [P, C, commutator, pfComm] using h
  have hsecond : ‖P - H - (Complex.I * (r : ℂ)) • C‖ ≤
      (r ^ 2 / 2) * ‖commutator D C‖ := by
    have hX : ∀ u : ℝ, ‖NormedSpace.exp (u • ((Complex.I * (r : ℂ)) • D))‖ ≤ 1 := by
      intro u
      have hscal : (u : ℝ) • ((Complex.I * (r : ℂ)) • D) =
          ((-Complex.I * ((-(u * r)) : ℝ) : ℂ)) • D := by
        ext i j
        simp only [Matrix.smul_apply, Complex.real_smul]
        push_cast
        ring
      rw [hscal]
      exact l2_norm_unitary_le_one (hamiltonianEvolution_unitary hD (-(u * r)))
    have h := exp_conj_second_order ((Complex.I * (r : ℂ)) • D) H hX
    have hneg : NormedSpace.exp (-((Complex.I * (r : ℂ)) • D)) = evo D (-(r : ℂ)) := by
      rw [evo, ← neg_smul]
      congr 1
      ring_nf
    have hc1 : commutator ((Complex.I * (r : ℂ)) • D) H =
        (Complex.I * (r : ℂ)) • C := by
      rw [commutator_smul_left]
    have hc2 : commutator ((Complex.I * (r : ℂ)) • D)
        (commutator ((Complex.I * (r : ℂ)) • D) H) =
        ((Complex.I * (r : ℂ)) * (Complex.I * (r : ℂ))) • commutator D C := by
      rw [hc1, commutator_smul_right, commutator_smul_left, smul_smul]
    rw [hneg, hc2, hc1, norm_smul, norm_I_mul_sq r hr0] at h
    have h' : ‖P - H - (Complex.I * (r : ℂ)) • C‖ ≤
        (1 / 2) * (r ^ 2 * ‖commutator D C‖) := by
      simpa [P, C, evo] using h
    calc ‖P - H - (Complex.I * (r : ℂ)) • C‖
        ≤ (1 / 2) * (r ^ 2 * ‖commutator D C‖) := h'
      _ = (r ^ 2 / 2) * ‖commutator D C‖ := by ring
  have hmul : evo D (r : ℂ) * evo H (r : ℂ) * evo D (-(r : ℂ)) = evo P (r : ℂ) := by
    simpa [P] using conj_evo_mul D H hD r
  have hlie : ‖evo H (-(r : ℂ)) * evo P (r : ℂ) - evo (P - H) (r : ℂ)‖ ≤
      r ^ 2 / 2 * ‖commutator P H‖ := by
    have h := product_formula_lie_two_term n P (-H) (-r) hP hH.neg
    have e0 : pfLie P (-H) (-r) =
        HamiltonianEvolution (-H) (-r) * HamiltonianEvolution P (-r) := rfl
    have e1 : HamiltonianEvolution (-H) (-r) = evo H (-(r : ℂ)) := by
      unfold HamiltonianEvolution evo
      congr 1
      ext i j
      simp only [Matrix.smul_apply, Matrix.neg_apply]
      push_cast
      ring_nf
    have e2 : HamiltonianEvolution P (-r) = evo P (r : ℂ) := by
      unfold HamiltonianEvolution evo
      congr 1
      ext i j
      simp only [Matrix.smul_apply]
      push_cast
      ring
    have e3 : HamiltonianEvolution (P + -H) (-r) = evo (P - H) (r : ℂ) := by
      unfold HamiltonianEvolution evo
      congr 1
      ext i j
      simp only [Matrix.smul_apply, Matrix.add_apply, Matrix.sub_apply, Matrix.neg_apply]
      push_cast
      ring_nf
    have epf : pfComm (-H) P = commutator P H := by
      simp only [pfComm, commutator]
      noncomm_ring
    rw [e0, e1, e2, e3, epf] at h
    have hsq : (-r) ^ 2 = r ^ 2 := by ring
    rw [hsq] at h
    exact h
  have hcomm : ‖commutator P H‖ ≤ 2 * ‖P - H‖ * ‖H‖ := by
    have heq : commutator P H = commutator (P - H) H := by
      simp only [commutator]
      noncomm_ring
    rw [heq]
    calc ‖commutator (P - H) H‖
        = ‖(P - H) * H - H * (P - H)‖ := rfl
      _ ≤ ‖(P - H) * H‖ + ‖H * (P - H)‖ := norm_sub_le _ _
      _ ≤ ‖P - H‖ * ‖H‖ + ‖H‖ * ‖P - H‖ :=
          add_le_add (norm_mul_le _ _) (norm_mul_le _ _)
      _ = 2 * ‖P - H‖ * ‖H‖ := by ring
  have hlie' : ‖evo H (-(r : ℂ)) * evo P (r : ℂ) - evo (P - H) (r : ℂ)‖ ≤
      r ^ 3 * (‖C‖ * ‖H‖) := by
    calc ‖evo H (-(r : ℂ)) * evo P (r : ℂ) - evo (P - H) (r : ℂ)‖
        ≤ r ^ 2 / 2 * ‖commutator P H‖ := hlie
      _ ≤ r ^ 2 / 2 * (2 * ‖P - H‖ * ‖H‖) := by
          exact mul_le_mul_of_nonneg_left hcomm (by positivity)
      _ ≤ r ^ 2 / 2 * (2 * (r * ‖C‖) * ‖H‖) := by
          have h2 : 2 * ‖P - H‖ * ‖H‖ ≤ 2 * (r * ‖C‖) * ‖H‖ := by
            have h3 : 2 * ‖P - H‖ ≤ 2 * (r * ‖C‖) := by
              have := mul_le_mul_of_nonneg_left hfirst (by norm_num : (0:ℝ) ≤ 2)
              linarith
            exact mul_le_mul_of_nonneg_right h3 (norm_nonneg H)
          exact mul_le_mul_of_nonneg_left h2 (by positivity)
      _ = r ^ 3 * (‖C‖ * ‖H‖) := by ring
  have hskew_bound :
      ‖evo (P - H) (r : ℂ) - rexp (commutator H D) s‖ ≤
        r ^ 3 * (‖commutator D C‖ / 2) := by
    set A : Matrix (Fin n) (Fin n) ℂ := -(s • C) with hA_def
    set E : Matrix (Fin n) (Fin n) ℂ :=
      (Complex.I * (r : ℂ)) • (P - H - (Complex.I * (r : ℂ)) • C) with hE_def
    have haa : (Complex.I * (r : ℂ)) * (Complex.I * (r : ℂ)) = -((s : ℝ) : ℂ) := by
      calc
        (Complex.I * (r : ℂ)) * (Complex.I * (r : ℂ))
            = (Complex.I * Complex.I) * ((r : ℂ) * (r : ℂ)) := by ring
        _ = -(((r : ℂ) * (r : ℂ))) := by rw [Complex.I_mul_I]; ring
        _ = -((r ^ 2 : ℝ) : ℂ) := by push_cast; ring
        _ = -((s : ℝ) : ℂ) := by rw [hrsq]
    have hdecomp : (Complex.I * (r : ℂ)) • (P - H) = A + E := by
      have hsc : (Complex.I * (r : ℂ)) • ((Complex.I * (r : ℂ)) • C) = A := by
        rw [smul_smul, haa, neg_smul, ← real_smul_eq_complex s C, ← hA_def]
      rw [hE_def]
      conv_rhs =>
        enter [2]
        rw [smul_sub, hsc]
      rw [hA_def]
      abel
    have hLHS : evo (P - H) (r : ℂ) = NormedSpace.exp (A + E) := by
      rw [evo, hdecomp]
    have hCD : commutator H D = -C := by
      simp only [C, commutator]
      noncomm_ring
    have hRHS : rexp (commutator H D) s = NormedSpace.exp A := by
      rw [rexp, hCD, smul_neg, hA_def]
    have hCadj : Cᴴ = -C := by
      simp only [C]
      exact commutator_adjoint D H hD hH
    have hA_skew : Aᴴ = -A := by
      rw [hA_def, Matrix.conjTranspose_neg, Matrix.conjTranspose_smul, hCadj]
      simp
    have hAC_herm : ((Complex.I * (r : ℂ)) • C).IsHermitian := by
      show ((Complex.I * (r : ℂ)) • C)ᴴ = (Complex.I * (r : ℂ)) • C
      have hstar : star (Complex.I * (r : ℂ)) = -(Complex.I * (r : ℂ)) := by
        simp only [RCLike.star_def, map_mul, Complex.conj_I, Complex.conj_ofReal]
        ring
      rw [Matrix.conjTranspose_smul, hCadj, hstar, neg_smul, smul_neg, neg_neg]
    have hdelta_herm : (P - H - (Complex.I * (r : ℂ)) • C).IsHermitian :=
      (hP.sub hH).sub hAC_herm
    have hE_skew : Eᴴ = -E := by
      rw [hE_def, Matrix.conjTranspose_smul, hdelta_herm.eq]
      have hstar : star (Complex.I * (r : ℂ)) = -(Complex.I * (r : ℂ)) := by
        simp only [RCLike.star_def, map_mul, Complex.conj_I, Complex.conj_ofReal]
        ring
      rw [hstar, neg_smul]
    have hAE_skew : (A + E)ᴴ = -(A + E) := by
      rw [Matrix.conjTranspose_add, hA_skew, hE_skew]
      abel
    have hskew := norm_exp_add_sub_exp_of_skew A E hA_skew hAE_skew
    rw [← hLHS, ← hRHS] at hskew
    have hE_norm : ‖E‖ ≤ r ^ 3 * (‖commutator D C‖ / 2) := by
      rw [hE_def, norm_smul, norm_mul, Complex.norm_I, one_mul, Complex.norm_real,
        Real.norm_eq_abs, abs_of_nonneg hr0]
      calc r * ‖P - H - (Complex.I * (r : ℂ)) • C‖
          ≤ r * (r ^ 2 / 2 * ‖commutator D C‖) :=
            mul_le_mul_of_nonneg_left hsecond hr0
        _ = r ^ 3 * (‖commutator D C‖ / 2) := by ring
    exact hskew.trans hE_norm
  have hU : evo H (-(r : ℂ)) * evo D (r : ℂ) * evo H (r : ℂ) * evo D (-(r : ℂ)) =
      evo H (-(r : ℂ)) * evo P (r : ℂ) := by
    calc evo H (-(r : ℂ)) * evo D (r : ℂ) * evo H (r : ℂ) * evo D (-(r : ℂ))
        = evo H (-(r : ℂ)) * (evo D (r : ℂ) * evo H (r : ℂ) * evo D (-(r : ℂ))) := by
          noncomm_ring
      _ = evo H (-(r : ℂ)) * evo P (r : ℂ) := by rw [hmul]
  have htri :
      ‖evo H (-(r : ℂ)) * evo D (r : ℂ) * evo H (r : ℂ) * evo D (-(r : ℂ))
        - rexp (commutator H D) s‖
        ≤ r ^ 3 * (‖C‖ * ‖H‖) + r ^ 3 * (‖commutator D C‖ / 2) := by
    rw [hU]
    have hsplit : evo H (-(r : ℂ)) * evo P (r : ℂ) - rexp (commutator H D) s =
        (evo H (-(r : ℂ)) * evo P (r : ℂ) - evo (P - H) (r : ℂ))
          + (evo (P - H) (r : ℂ) - rexp (commutator H D) s) := by abel
    rw [hsplit]
    exact (norm_add_le _ _).trans (add_le_add hlie' hskew_bound)
  have hs32 : s ^ ((3 : ℝ) / 2) = r ^ 3 := by
    rw [show r = Real.sqrt s from rfl, Real.sqrt_eq_rpow]
    rw [← Real.rpow_natCast (s ^ ((1 : ℝ) / 2)) 3, ← Real.rpow_mul hs.1]
    norm_num
  calc
    ‖evo H (-(r : ℂ)) * evo D (r : ℂ) * evo H (r : ℂ) * evo D (-(r : ℂ))
        - rexp (commutator H D) s‖
        ≤ r ^ 3 * (‖C‖ * ‖H‖) + r ^ 3 * (‖commutator D C‖ / 2) := htri
    _ = (‖commutator D H‖ * ‖H‖ +
          ‖commutator D (commutator D H)‖ / 2) * s ^ ((3 : ℝ) / 2) := by
      rw [hs32]
      simp only [C]
      ring

end

