module

public import Qatlib.Concepts.QlsReadoutSpec.WalkQSVT.CyclicQubitizationLows
public import Mathlib.Analysis.CStarAlgebra.Matrix

@[expose] public section

/-!
# Interior cyclic blocks for Hermitian qubitization

This module records the two-by-two matrix of the interior spectral block generated by an
embedded eigenvector of a Hermitian qubitization.  For an eigenvalue `λ` with `|λ| < 1`,
the normalized embedded vector and its residual give the block whose columns are
`(λ, sqrt(1 - λ²))` and `(sqrt(1 - λ²), -λ)`.  The block is unitary for every `|λ| ≤ 1`,
and its norm is the induced Euclidean operator norm.

The input model is the unitary `U`, isometry `G`, and Hermitian compression
`G†UG` used by `Qatlib.Concepts.QlsReadoutSpec.WalkQSVT.SpectralModels`.
The column matrix of the embedded vector and its residual intertwines this block with
the ambient unitary. This records the action of `U` in the interior case of
[LowSu2026], Proposition 18, Eq. (299).
See the [paper](https://arxiv.org/abs/2410.18178v2).
-/

set_option backward.isDefEq.respectTransparency false
set_option autoImplicit false
noncomputable section

namespace Qatlib.Papers.QLSStatePrep24.WalkQSVT

open Matrix
open Qatlib.Concepts.Execution.WorkspaceCP
open Qatlib.Foundations.PureStateMath
open Qatlib.Concepts.QlsReadoutSpec.WalkQSVT
open scoped Matrix.Norms.L2Operator ComplexOrder

/-- The Hermitian two-by-two block generated by an interior eigenvector of a qubitized
unitary compression. -/
def cyclicBlock (lam : ℝ) : Matrix (Fin 2) (Fin 2) ℂ :=
  !![(lam : ℂ), Real.sqrt (1 - lam ^ 2);
     Real.sqrt (1 - lam ^ 2), -(lam : ℂ)]

/-- Every admissible cyclic block is unitary, including the two boundary cases
`λ = ±1`. -/
theorem cyclicBlock_mem_unitaryGroup {lam : ℝ} (hlam : abs lam ≤ 1) :
    cyclicBlock lam ∈ Matrix.unitaryGroup (Fin 2) ℂ := by
  have hnonneg : 0 ≤ 1 - lam ^ 2 := sub_nonneg.mpr ((sq_le_one_iff_abs_le_one lam).mpr hlam)
  have hsquares : (lam : ℂ) ^ 2 + (Real.sqrt (1 - lam ^ 2) : ℂ) ^ 2 = 1 := by
    have hreal : lam ^ 2 + Real.sqrt (1 - lam ^ 2) ^ 2 = 1 := by
      rw [Real.sq_sqrt hnonneg]
      ring
    exact_mod_cast hreal
  rw [Matrix.mem_unitaryGroup_iff, Matrix.star_eq_conjTranspose]
  ext i j
  fin_cases i <;> fin_cases j <;>
    norm_num [cyclicBlock, Matrix.mul_apply, Matrix.conjTranspose_apply,
      Matrix.one_apply, Fin.sum_univ_two] <;>
    first | linear_combination hsquares | ring

/-- Every admissible cyclic block has operator norm one in the Euclidean `ℓ²`
operator norm. -/
theorem cyclicBlock_l2Operator_norm {lam : ℝ} (hlam : abs lam ≤ 1) :
    ‖cyclicBlock lam‖ = 1 :=
  CStarRing.norm_of_mem_unitary (cyclicBlock_mem_unitaryGroup hlam)

/-- Under the Hermitian qubitization hypotheses, an interior eigenvector generates the
explicit two-dimensional block recorded by `cyclicBlock`: `U` sends the embedded vector
to `λv + sqrt(1 - λ²)r`, and sends the residual `r` to `sqrt(1 - λ²)v - λr`.

The domains are required to be nonempty and the eigenvalue is interior (`|λ| < 1`), so
the residual is normalized by a nonzero factor. -/
theorem cyclic_qubitization_interior_block_action
    (H I : Type) [Fintype H] [DecidableEq H] [Nonempty H]
    [Fintype I] [DecidableEq I] [Nonempty I]
    (U : Matrix H H ℂ) (G : Matrix H I ℂ) (φ : QState I) (lam : ℝ)
    (hU : U ∈ Matrix.unitaryGroup H ℂ) (hG : IsIsometry G)
    (hHerm : (Gᴴ * U * G).IsHermitian)
    (hSquare : Gᴴ * (U ^ 2) * G = 1) (hφ : Normalized φ)
    (heigen : (Gᴴ * U * G) *ᵥ φ = (lam : ℂ) • φ)
    (hinterior : abs lam < 1) :
    U *ᵥ (G *ᵥ φ) =
      (lam : ℂ) • (G *ᵥ φ) +
      (Real.sqrt (1 - lam ^ 2) : ℂ) • residual U (G *ᵥ φ) lam ∧
    U *ᵥ residual U (G *ᵥ φ) lam =
      (Real.sqrt (1 - lam ^ 2) : ℂ) • (G *ᵥ φ) -
      (lam : ℂ) • residual U (G *ᵥ φ) lam := by
  have hUw : U *ᵥ (U *ᵥ (G *ᵥ φ)) = G *ᵥ φ :=
    ((Clause11CyclicQubitization_answer H I U G hU hG hHerm).2
      hSquare φ lam hφ heigen).2.2.2.2.2.1
  have hpos : 0 < 1 - lam ^ 2 := sub_pos.mpr ((sq_lt_one_iff_abs_lt_one lam).mpr hinterior)
  have hs0 : 0 < Real.sqrt (1 - lam ^ 2) := Real.sqrt_pos.mpr hpos
  have hsreal : Real.sqrt (1 - lam ^ 2) * Real.sqrt (1 - lam ^ 2) = 1 - lam ^ 2 := by
    simpa only [pow_two] using Real.sq_sqrt hpos.le
  have hsne0 : Real.sqrt (1 - lam ^ 2) ≠ 0 := ne_of_gt hs0
  have hsne : (Real.sqrt (1 - lam ^ 2) : ℂ) ≠ 0 := by exact_mod_cast hsne0
  have heq : residual U (G *ᵥ φ) lam =
      (Real.sqrt (1 - lam ^ 2) : ℂ)⁻¹ •
        (U *ᵥ (G *ᵥ φ) - (lam : ℂ) • (G *ᵥ φ)) := rfl
  have hfirst : U *ᵥ (G *ᵥ φ) =
      (lam : ℂ) • (G *ᵥ φ) +
      (Real.sqrt (1 - lam ^ 2) : ℂ) • residual U (G *ᵥ φ) lam := by
    conv_rhs => rw [heq]
    rw [smul_smul, mul_inv_cancel₀ hsne, one_smul]
    module
  refine ⟨hfirst, ?_⟩
  conv_lhs => rw [heq, Matrix.mulVec_smul]
  have hU2 : U *ᵥ (U *ᵥ (G *ᵥ φ) - (lam : ℂ) • (G *ᵥ φ)) =
      G *ᵥ φ - (lam : ℂ) • (U *ᵥ (G *ᵥ φ)) := by
    rw [Matrix.mulVec_sub, Matrix.mulVec_smul, hUw]
  rw [hU2, hfirst]
  have hcalc : G *ᵥ φ - (lam : ℂ) • ((lam : ℂ) • (G *ᵥ φ) +
      (Real.sqrt (1 - lam ^ 2) : ℂ) • residual U (G *ᵥ φ) lam) =
      ((1 : ℂ) - (lam : ℂ) * (lam : ℂ)) • (G *ᵥ φ) -
      ((lam : ℂ) * (Real.sqrt (1 - lam ^ 2) : ℂ)) •
        residual U (G *ᵥ φ) lam := by
    simp only [smul_add]
    module
  rw [hcalc, smul_sub, ← mul_smul, ← mul_smul]
  have h1 : (Real.sqrt (1 - lam ^ 2) : ℂ)⁻¹ *
      ((1 : ℂ) - (lam : ℂ) * (lam : ℂ)) =
      (Real.sqrt (1 - lam ^ 2) : ℂ) := by
    have hcoercion : ((1 : ℂ) - (lam : ℂ) * (lam : ℂ)) =
        ((1 - lam ^ 2 : ℝ) : ℂ) := by
      rw [Complex.ofReal_sub, Complex.ofReal_one, Complex.ofReal_pow]
      ring
    rw [hcoercion, ← Complex.ofReal_inv, ← Complex.ofReal_mul]
    simp only [Complex.ofReal_inj]
    calc
      _ = (Real.sqrt (1 - lam ^ 2))⁻¹ *
          (Real.sqrt (1 - lam ^ 2) * Real.sqrt (1 - lam ^ 2)) := by rw [hsreal]
      _ = _ := by rw [← mul_assoc, inv_mul_cancel₀ hsne0, one_mul]
  have h2 : (Real.sqrt (1 - lam ^ 2) : ℂ)⁻¹ *
      ((lam : ℂ) * (Real.sqrt (1 - lam ^ 2) : ℂ)) = (lam : ℂ) := by
    field_simp [hsne]
  rw [h1, h2]

/-- The columns are the embedded state and its interior residual, in that order. -/
def cyclicBlockColumns {H : Type} [Fintype H] (U : Matrix H H ℂ)
    (v : QState H) (lam : ℝ) : Matrix H (Fin 2) ℂ :=
  Matrix.of fun i => ![v i, residual U v lam i]

/-- The interior columns intertwine the ambient unitary with the explicit two-level
matrix of operator norm one. The same parameter determines the residual, the action,
and the operator norm statement. -/
theorem cyclic_qubitization_interior_block
    (H I : Type) [Fintype H] [DecidableEq H] [Nonempty H]
    [Fintype I] [DecidableEq I] [Nonempty I]
    (U : Matrix H H ℂ) (G : Matrix H I ℂ) (φ : QState I) (lam : ℝ)
    (hU : U ∈ Matrix.unitaryGroup H ℂ) (hG : IsIsometry G)
    (hHerm : (Gᴴ * U * G).IsHermitian)
    (hSquare : Gᴴ * (U ^ 2) * G = 1) (hφ : Normalized φ)
    (heigen : (Gᴴ * U * G) *ᵥ φ = (lam : ℂ) • φ)
    (hinterior : abs lam < 1) :
    let B := cyclicBlockColumns U (G *ᵥ φ) lam
    U * B = B * cyclicBlock lam ∧ ‖cyclicBlock lam‖ = 1 := by
  obtain ⟨hfirst, hsecond⟩ :=
    cyclic_qubitization_interior_block_action H I U G φ lam
      hU hG hHerm hSquare hφ heigen hinterior
  refine ⟨?_, cyclicBlock_l2Operator_norm hinterior.le⟩
  ext i j
  fin_cases j
  · simpa [cyclicBlockColumns, cyclicBlock, Matrix.mul_apply, Matrix.mulVec,
      dotProduct, Fin.sum_univ_two, mul_comm] using congrFun hfirst i
  · simpa [cyclicBlockColumns, cyclicBlock, Matrix.mul_apply, Matrix.mulVec,
      dotProduct, Fin.sum_univ_two, mul_comm, sub_eq_add_neg] using congrFun hsecond i

end Qatlib.Papers.QLSStatePrep24.WalkQSVT
