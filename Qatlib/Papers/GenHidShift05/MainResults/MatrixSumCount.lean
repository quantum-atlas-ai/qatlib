import Mathlib.Algebra.GCDMonoid.Finset
import Mathlib.Data.ZMod.Basic
import Mathlib.GroupTheory.Coset.Card
import Mathlib.GroupTheory.OrderOfElement
import Mathlib.Tactic

set_option backward.isDefEq.respectTransparency false

/-!
# The number of matrix-sum solutions (source Lemma 4)

Fixed source: A. M. Childs and W. van Dam, *Quantum algorithm for a generalized
hidden shift problem*, arXiv:quant-ph/0507190v1, Appendix
("Number of solutions of the matrix sum problem"), Lemma 4 and its proof.

Source Lemma 4: for any fixed `b = (b₁, …, b_k)`, the number of solutions
`x ∈ (ZMod N)^k` of `b · x = 0 mod N` is `N^(k-1) · gcd(b₁, …, b_k, N)`.

The count below is the cardinality of the solution subtype in `(ZMod N)^k`;
`matrixGcd N b` is `gcd(b₁, …, b_k, N)` read off the canonical representatives
`(b i).val`, which is the integer `gcd` the source means.  The source proves
the lemma prime-power by prime-power and then glues with the Chinese remainder
theorem; here the same count is obtained from the first isomorphism theorem for
the additive homomorphism `dotHom N b` and the description of its range as the
cyclic subgroup generated by `gcd(b₁, …, b_k, N)`, so that
`|ker| = N^k / (N / d) = N^(k-1) · d`.
-/

set_option autoImplicit false
noncomputable section

open Finset

namespace Qatlib.Papers.GenHidShift05.MainResults

variable {k : ℕ}
variable {N : ℕ}

/-- The matrix-sum form `b · x = ∑ i, b i * x i` as an additive homomorphism of
`(ZMod N)^k`; its kernel is the solution set of the homogeneous matrix-sum
equation of source Lemma 4. -/
def dotHom (N : ℕ) (b : Fin k → ZMod N) : (Fin k → ZMod N) →+ ZMod N where
  toFun x := ∑ i, b i * x i
  map_zero' := by simp
  map_add' x y := by
    simp [mul_add, Finset.sum_add_distrib]

/-- `gcd(b₁, …, b_k, N)` for a matrix-sum vector `b`, computed from the
canonical representatives `(b i).val` exactly as in source Lemma 4. -/
def matrixGcd (N : ℕ) (b : Fin k → ZMod N) : ℕ :=
  Nat.gcd N (univ.gcd fun i => (b i).val)

/-- `gcd(b₁, …, b_k, N)` divides `N`. -/
theorem matrixGcd_dvd_left (b : Fin k → ZMod N) : matrixGcd N b ∣ N :=
  Nat.gcd_dvd_left _ _

/-- `gcd(b₁, …, b_k, N)` divides every entry `b i`. -/
theorem matrixGcd_dvd_val (b : Fin k → ZMod N) (i : Fin k) :
    matrixGcd N b ∣ (b i).val :=
  (Nat.gcd_dvd_right _ _).trans (Finset.gcd_dvd (mem_univ i))

/-- For `N ≠ 0` the gcd `gcd(b₁, …, b_k, N)` is positive. -/
theorem matrixGcd_pos [NeZero N] (b : Fin k → ZMod N) : 0 < matrixGcd N b :=
  Nat.pos_of_dvd_of_pos (matrixGcd_dvd_left b) (Nat.pos_of_ne_zero (NeZero.ne N))

/-- Bézout for a finite family: the gcd of `f` over the finite set `s` is an
integral combination of the values `f a`, `a ∈ s`.  This is the arithmetic core
of "the range of the matrix-sum map is generated by the gcd". -/
theorem exists_int_combo_gcd_finset {α : Type*} (s : Finset α) (f : α → ℕ) :
    ∃ c : α → ℤ, ((s.gcd f : ℕ) : ℤ) = ∑ a ∈ s, c a * (f a : ℤ) := by
  classical
  induction s using Finset.induction with
  | empty => exact ⟨fun _ => 0, by simp⟩
  | insert a s ha ih =>
    obtain ⟨c, hc⟩ := ih
    have hgcd : (((insert a s).gcd f : ℕ) : ℤ) = Nat.gcd (f a) (s.gcd f) := by
      rw [Finset.gcd_insert]
      rfl
    refine ⟨fun x => if x = a then ((f a).gcdA (s.gcd f))
      else c x * ((f a).gcdB (s.gcd f)), ?_⟩
    rw [hgcd, Nat.gcd_eq_gcd_ab, Finset.sum_insert ha]
    have hbeta : (fun x => if x = a then ((f a).gcdA (s.gcd f))
        else c x * ((f a).gcdB (s.gcd f))) a = (f a).gcdA (s.gcd f) := by simp
    have hsum : ∑ x ∈ s, (if x = a then ((f a).gcdA (s.gcd f))
        else c x * ((f a).gcdB (s.gcd f))) * (f x : ℤ)
        = (∑ x ∈ s, c x * (f x : ℤ)) * ((f a).gcdB (s.gcd f)) := by
      rw [Finset.sum_mul]
      refine Finset.sum_congr rfl ?_
      intro x hx
      have hx' : x ≠ a := by rintro rfl; exact ha hx
      simp only [hx', if_false]
      ring
    rw [hbeta, hsum, ← hc]
    ring

/-- Bézout for the matrix-sum gcd: `gcd(b₁, …, b_k, N)` is an integral
combination of `N` and the representatives `(b i).val`. -/
theorem exists_int_combo_matrixGcd [NeZero N] (b : Fin k → ZMod N) :
    ∃ c : Fin k → ℤ, ∃ c₀ : ℤ,
      ((matrixGcd N b : ℕ) : ℤ) = c₀ * (N : ℤ) + ∑ i, c i * ((b i).val : ℤ) := by
  classical
  obtain ⟨c, hc⟩ := exists_int_combo_gcd_finset (univ : Finset (Fin k)) fun i => (b i).val
  refine ⟨fun i => c i * (N.gcdB (univ.gcd fun i => (b i).val)),
    N.gcdA (univ.gcd fun i => (b i).val), ?_⟩
  have hstep : ∀ i : Fin k,
      c i * (N.gcdB (univ.gcd fun i => (b i).val)) * ((b i).val : ℤ)
        = c i * ((b i).val : ℤ) * (N.gcdB (univ.gcd fun i => (b i).val)) := by
    intro i
    ring
  rw [matrixGcd, Nat.gcd_eq_gcd_ab, Finset.sum_congr rfl fun i _ => hstep i,
    ← Finset.sum_mul, ← hc]
  ring

/-- The range of the matrix-sum homomorphism is the cyclic subgroup generated by
`gcd(b₁, …, b_k, N)`: the image of `(ZMod N)^k` is exactly the set of residues
divisible by that gcd. -/
theorem range_dotHom [NeZero N] (b : Fin k → ZMod N) :
    (dotHom N b).range = AddSubgroup.zmultiples ((matrixGcd N b : ℕ) : ZMod N) := by
  refine le_antisymm ?_ ?_
  · rintro y ⟨x, rfl⟩
    show (∑ i, b i * x i) ∈ AddSubgroup.zmultiples ((matrixGcd N b : ℕ) : ZMod N)
    refine AddSubgroup.sum_mem _ ?_
    intro i _
    obtain ⟨q, hq⟩ := matrixGcd_dvd_val b i
    have hqd : q * matrixGcd N b = (b i).val := by
      rw [Nat.mul_comm]
      exact hq.symm
    have hb : b i = (q : ℕ) • ((matrixGcd N b : ℕ) : ZMod N) := by
      rw [nsmul_eq_mul, ← Nat.cast_mul, hqd, ZMod.natCast_zmod_val]
    have hmem : b i ∈ AddSubgroup.zmultiples ((matrixGcd N b : ℕ) : ZMod N) := by
      rw [hb]
      exact AddSubgroup.nsmul_mem _ (AddSubgroup.mem_zmultiples _) q
    have hx : b i * x i = (x i).val • (b i) := by
      rw [nsmul_eq_mul, ZMod.natCast_zmod_val, mul_comm]
    rw [hx]
    exact AddSubgroup.nsmul_mem _ hmem (x i).val
  · rw [AddSubgroup.zmultiples_le]
    obtain ⟨c, c₀, hc⟩ := exists_int_combo_matrixGcd b
    refine AddMonoidHom.mem_range.mpr ⟨fun i => ((c i : ℤ) : ZMod N), ?_⟩
    have hcast : ((matrixGcd N b : ℕ) : ZMod N)
        = ∑ i, ((c i : ℤ) : ZMod N) * (b i) := by
      have h := congrArg (fun z : ℤ => (z : ZMod N)) hc
      push_cast at h
      simpa only [ZMod.natCast_self, mul_zero, zero_add, ZMod.natCast_zmod_val] using h
    show (∑ i, b i * ((c i : ℤ) : ZMod N)) = ((matrixGcd N b : ℕ) : ZMod N)
    rw [hcast]
    refine Finset.sum_congr rfl ?_
    intro i _
    rw [mul_comm]

/-- The cardinality of the range: `N / gcd(b₁, …, b_k, N)`, in `Nat.card` form. -/
theorem card_range_dotHom [NeZero N] (b : Fin k → ZMod N) :
    Nat.card (dotHom N b).range = N / matrixGcd N b := by
  rw [range_dotHom]
  rw [Nat.card_eq_fintype_card, Fintype.card_zmultiples,
    ZMod.addOrderOf_coe _ (NeZero.ne N), Nat.gcd_eq_right (matrixGcd_dvd_left b)]

/-- **Source Lemma 4** (`Nat.card` form).  For any fixed `b = (b₁, …, b_k)` and
`N ≥ 1`, the number of solutions `x ∈ (ZMod N)^k` of `b · x = 0 mod N` is
`N^(k-1) · gcd(b₁, …, b_k, N)`. -/
theorem card_solutions [NeZero N] (hk : 0 < k) (b : Fin k → ZMod N) :
    Nat.card {x : Fin k → ZMod N // ∑ i, b i * x i = 0}
      = N ^ (k - 1) * matrixGcd N b := by
  classical
  have hdvd : matrixGcd N b ∣ N := matrixGcd_dvd_left b
  have hdpos : 0 < matrixGcd N b := matrixGcd_pos b
  have hNpos : 0 < N := Nat.pos_of_ne_zero (NeZero.ne N)
  have hquot : Nat.card ((Fin k → ZMod N) ⧸ (dotHom N b).ker) = N / matrixGcd N b := by
    rw [← card_range_dotHom b]
    exact Nat.card_congr (QuotientAddGroup.quotientKerEquivRange (dotHom N b)).toEquiv
  have hcard := AddSubgroup.card_eq_card_quotient_mul_card_addSubgroup (dotHom N b).ker
  rw [hquot, show Nat.card (Fin k → ZMod N) = N ^ k by simp] at hcard
  have hker_mul : Nat.card (dotHom N b).ker * (N / matrixGcd N b) = N ^ k := by
    rw [hcard, mul_comm]
  have hsplit : N = (N / matrixGcd N b) * matrixGcd N b :=
    (Nat.div_mul_cancel hdvd).symm
  have hdivpos : 0 < N / matrixGcd N b :=
    Nat.div_pos (Nat.le_of_dvd hNpos hdvd) hdpos
  have hkpos : N ^ k = N ^ (k - 1) * N := by
    obtain ⟨j, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.pos_iff_ne_zero.mp hk)
    rw [pow_succ]
    simp
  have hker : Nat.card (dotHom N b).ker = N ^ (k - 1) * matrixGcd N b := by
    refine Nat.eq_of_mul_eq_mul_right hdivpos ?_
    calc Nat.card (dotHom N b).ker * (N / matrixGcd N b) = N ^ k := hker_mul
      _ = N ^ (k - 1) * ((N / matrixGcd N b) * matrixGcd N b) := by rw [← hsplit, hkpos]
      _ = (N ^ (k - 1) * matrixGcd N b) * (N / matrixGcd N b) := by ring
  simpa [dotHom] using hker

/-- **Source Lemma 4.**  For any fixed `b = (b₁, …, b_k)` and `N ≥ 1`, the
number of solutions `x ∈ (ZMod N)^k` of `b · x = 0 mod N` is
`N^(k-1) · gcd(b₁, …, b_k, N)`. -/
theorem card_dot_eq_zero [NeZero N] (hk : 0 < k) (b : Fin k → ZMod N) :
    Fintype.card {x : Fin k → ZMod N // ∑ i, b i * x i = 0}
      = N ^ (k - 1) * matrixGcd N b := by
  rw [← Nat.card_eq_fintype_card, card_solutions hk b]

/-- The inhomogeneous matrix-sum equation `b · x = w mod N` is solvable as soon
as `gcd(b₁, …, b_k, N)` divides the representative of `w`: the residue `w` then
lies in the range of `dotHom N b`. -/
theorem mem_range_of_dvd [NeZero N] (b : Fin k → ZMod N) {w : ZMod N}
    (hw : matrixGcd N b ∣ w.val) : w ∈ (dotHom N b).range := by
  rw [range_dotHom, AddSubgroup.mem_zmultiples_iff]
  refine ⟨((w.val / matrixGcd N b : ℕ) : ℤ), ?_⟩
  rw [zsmul_eq_mul, Int.cast_natCast, ← Nat.cast_mul, Nat.div_mul_cancel hw,
    ZMod.natCast_zmod_val]

/-- The inhomogeneous matrix-sum count: when `gcd(b₁, …, b_k, N)` divides the
representative of `w`, the equation `b · x = w mod N` has exactly
`N^(k-1) · gcd(b₁, …, b_k, N)` solutions.  The solution sets of the
homogeneous and inhomogeneous equations are translates of one another, so the
count is the homogeneous one of source Lemma 4. -/
theorem card_dot_eq_of_dvd [NeZero N] (hk : 0 < k) (b : Fin k → ZMod N) {w : ZMod N}
    (hw : matrixGcd N b ∣ w.val) :
    Nat.card {x : Fin k → ZMod N // ∑ i, b i * x i = w}
      = N ^ (k - 1) * matrixGcd N b := by
  classical
  obtain ⟨x₀, hx₀⟩ := AddMonoidHom.mem_range.mp (mem_range_of_dvd b hw)
  rw [← card_solutions hk b]
  refine Nat.card_congr (Equiv.subtypeEquiv (p := fun x => ∑ i, b i * x i = 0)
    (q := fun x => ∑ i, b i * x i = w) (Equiv.addRight x₀) ?_).symm
  intro x
  change (dotHom N b x = 0 ↔ dotHom N b (x + x₀) = w)
  rw [map_add, hx₀]
  constructor
  · intro h
    rw [h, zero_add]
  · intro h
    have h' : dotHom N b x + w = 0 + w := by rw [zero_add]; exact h
    exact add_right_cancel h'

end Qatlib.Papers.GenHidShift05.MainResults
