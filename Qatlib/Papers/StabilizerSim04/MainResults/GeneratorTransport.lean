module

public import Qatlib.Papers.StabilizerSim04.MainResults.StructuralLemmas
public import Qatlib.Concepts.PauliClifford.PauliAlgebra.CliffordStabilizerConjugation

@[expose] public section

/-!
# Transport of tableau generator groups along legal Clifford words

Running a legal Clifford gate word over a tableau rewrites each row's Pauli element by the
accumulated Pauli action `actionWord`. This module proves that the *group* generated by the rows
is transported by the same action: the masked products of the evolved stabilizer generator list
are exactly the images of the masked products of the original list.

The mathematical input is that `actionWord` is multiplicative on Pauli elements, phases
included. Since `op` is injective, multiplicativity follows from `Uword`-conjugating the operator
identity `op (p * q) = op p * op q`. The operator injectivity is derived from the trace
computations of `Qatlib.Concepts.PauliClifford.PauliAlgebra.StabilizerDesign`: a Pauli operator
has nonvanishing trace exactly when its word is trivial, and the trace then reads off the global
phase.

This is the stabilizer-generation half of [AaronsonGottesman2004], Proposition 3 (i), for an
arbitrary legal Clifford word applied to the standard stabilizer tableau. The statements cover
the generator group only: they do not prove that the evolved tableau describes a state prepared
by the circuit, and they do not address the independent-generators condition used by the
stabilizer-counting results.

## Main statements

* `op_injective`: distinct Pauli elements have distinct operator matrices.
* `actionWord_mul`: `actionWord` is a group homomorphism on Pauli elements.
* `maskProduct_map_actionWord`: masked products commute with `actionWord`.
* `generatedSubgroup_run_standardStabilizer`: the stabilizer subgroup of the evolved standard
  tableau is the `actionWord` image of the initial stabilizer subgroup.

## References

* [Aaronson and Gottesman, 2004][AaronsonGottesman2004]

https://arxiv.org/abs/quant-ph/0406196
-/

set_option backward.isDefEq.respectTransparency false

set_option autoImplicit false
noncomputable section

namespace Qatlib.Papers.StabilizerSim04.MainResults

open Qatlib.Concepts.PauliClifford.PauliAlgebra
open Qatlib.Concepts.PauliClifford.PauliAlgebra.StabilizerDesign
open Qatlib.Concepts.PauliClifford.PauliAlgebra.PauliCliffordLawsProofs
open Qatlib.Concepts.PauliClifford.PauliAlgebra.CliffordTableauConstruction
open Qatlib.Papers.StabilizerSim04.MainResults
open Matrix
open scoped Classical BigOperators

/-- A single-qubit Pauli letter multiplied by itself is the identity. -/
@[simp] theorem pauliMul1_self (a : Pauli1) : pauliMul1 a a = Pauli1.I := by
  cases a <;> rfl

/-- The scalar phase exponent of a single-qubit Pauli letter multiplied by itself is zero. -/
@[simp] theorem pauliMulPhase_self (a : Pauli1) : pauliMulPhase a a = 0 := by
  cases a <;> rfl

/-- Two single-qubit Pauli letters whose product is the identity coincide. -/
theorem eq_of_pauliMul1_eq_one {a b : Pauli1} (h : pauliMul1 a b = Pauli1.I) : a = b := by
  cases a <;> cases b <;> simp_all [pauliMul1]

/-- Multiplying a Pauli element by the phase-free copy of its word yields the identity word
carrying the original phase. -/
theorem mul_wordSelf {n : ℕ} (p : PauliElem n) :
    PauliElem.mul p ⟨p.word, 0⟩ = (⟨fun _ => Pauli1.I, p.phase⟩ : PauliElem n) := by
  apply pauli_ext
  · funext i
    simp [PauliElem.mul]
  · simp [PauliElem.mul]

/-- The operator matrix of the phase-free copy of the word of `p` pairs with `op p` to a
nonvanishing trace. -/
theorem trace_mul_wordSelf {n : ℕ} (p : PauliElem n) :
    Matrix.trace (op (PauliElem.mul p ⟨p.word, 0⟩)) =
      (Complex.I ^ p.phase.val : ℂ) * (2 : ℂ) ^ n := by
  rw [mul_wordSelf p, trace_op_trivial]

/-- The phase factor `I ^ k` times `2 ^ n` is a nonzero complex number. -/
theorem complex_I_pow_mul_two_pow_ne_zero {n : ℕ} (k : ℕ) :
    (Complex.I ^ k : ℂ) * (2 : ℂ) ^ n ≠ 0 :=
  mul_ne_zero (pow_ne_zero _ (by simp)) (pow_ne_zero _ (by norm_num))

/-- Distinct Pauli elements have distinct operator matrices: the operator assignment `op` is
injective. -/
theorem op_injective {n : ℕ} : Function.Injective (fun p : PauliElem n => op p) := by
  intro p q h
  have hop : op p = op q := h
  have htr : Matrix.trace (op (PauliElem.mul q ⟨p.word, 0⟩)) =
      (Complex.I ^ p.phase.val : ℂ) * (2 : ℂ) ^ n := by
    have hsame : op (PauliElem.mul q ⟨p.word, 0⟩) = op (PauliElem.mul p ⟨p.word, 0⟩) := by
      rw [op_mul, op_mul, hop]
    rw [hsame, trace_mul_wordSelf]
  have hall : ∀ i, pauliMul1 (q.word i) (p.word i) = Pauli1.I := by
    intro i
    by_contra hne
    have hzero : Matrix.trace (op (PauliElem.mul q ⟨p.word, 0⟩)) = 0 :=
      trace_op_eq_zero_of_word_ne n _ ⟨i, by simpa [PauliElem.mul] using hne⟩
    rw [htr] at hzero
    exact complex_I_pow_mul_two_pow_ne_zero (n := n) p.phase.val hzero
  have hword : p.word = q.word :=
    funext fun i => (eq_of_pauliMul1_eq_one (hall i)).symm
  exact pauli_ext hword (op_eq_of_same_word hop hword)

/-- The accumulated Pauli action of a legal Clifford word is multiplicative on Pauli elements,
including their global phases. -/
theorem actionWord_mul {n : ℕ} (gs : List (CliffordGate n))
    (hgs : ∀ g ∈ gs, legalGate g) (p q : PauliElem n) :
    actionWord gs (PauliElem.mul p q) =
      PauliElem.mul (actionWord gs p) (actionWord gs q) := by
  apply op_injective
  have hU := Uword_unitary gs hgs
  calc op (actionWord gs (PauliElem.mul p q))
      = Uword gs * op (PauliElem.mul p q) * (Uword gs)ᴴ := (Uword_conj gs _ hgs).symm
    _ = Uword gs * (op p * op q) * (Uword gs)ᴴ := by rw [op_mul]
    _ = conjugate (Uword gs) (op p * op q) := rfl
    _ = conjugate (Uword gs) (op p) * conjugate (Uword gs) (op q) := conjugate_mul _ hU _ _
    _ = (Uword gs * op p * (Uword gs)ᴴ) * (Uword gs * op q * (Uword gs)ᴴ) := rfl
    _ = op (actionWord gs p) * op (actionWord gs q) := by
        rw [Uword_conj gs p hgs, Uword_conj gs q hgs]
    _ = op (PauliElem.mul (actionWord gs p) (actionWord gs q)) := (op_mul _ _).symm

/-- The accumulated Pauli action of a legal Clifford word fixes the identity Pauli element. -/
theorem actionWord_one {n : ℕ} (gs : List (CliffordGate n))
    (hgs : ∀ g ∈ gs, legalGate g) : actionWord gs (1 : PauliElem n) = 1 := by
  apply op_injective
  calc op (actionWord gs (1 : PauliElem n))
      = Uword gs * op (1 : PauliElem n) * (Uword gs)ᴴ := (Uword_conj gs _ hgs).symm
    _ = Uword gs * 1 * (Uword gs)ᴴ := by rw [op_one]
    _ = 1 := conjugate_one (Uword gs) (Uword_unitary gs hgs)
    _ = op (1 : PauliElem n) := op_one.symm

/-- A masked product of the `actionWord` images of a generator list is the `actionWord` image of
the masked product of the list. -/
theorem maskProduct_map_actionWord {n : ℕ} (gs : List (CliffordGate n))
    (hgs : ∀ g ∈ gs, legalGate g) (gens : List (PauliElem n)) :
    ∀ (m : Mask), m.length = gens.length →
      maskProduct (gens.map (actionWord gs)) m = actionWord gs (maskProduct gens m) := by
  induction gens with
  | nil =>
      intro m hm
      have : m = [] := List.eq_nil_of_length_eq_zero (by simpa using hm)
      subst this
      simp [maskProduct, actionWord_one gs hgs]
  | cons g gens ih =>
      intro m hm
      cases m with
      | nil => simp at hm
      | cons b m =>
          have hm' : m.length = gens.length := by simpa using hm
          cases b with
          | false => simp [maskProduct, ih m hm']
          | true =>
              simp only [maskProduct, List.map_cons, reduceIte]
              rw [ih m hm', actionWord_mul gs hgs g (maskProduct gens m)]

/-- The group generated by the `actionWord` images of a generator list is the image under
`actionWord` of the group generated by the list. -/
theorem generatedSubgroup_map_actionWord {n : ℕ} (gs : List (CliffordGate n))
    (hgs : ∀ g ∈ gs, legalGate g) (gens : List (PauliElem n)) :
    generatedSubgroup (gens.map (actionWord gs)) =
      {p | ∃ q ∈ generatedSubgroup gens, actionWord gs q = p} := by
  ext p
  constructor
  · rintro ⟨m, hm, rfl⟩
    have hm' : m.length = gens.length := by simpa using hm
    exact ⟨maskProduct gens m, ⟨m, hm', rfl⟩, (maskProduct_map_actionWord gs hgs gens m hm').symm⟩
  · rintro ⟨q, ⟨m, hm, rfl⟩, rfl⟩
    refine ⟨m, by simpa using hm, ?_⟩
    exact maskProduct_map_actionWord gs hgs gens m hm

/-- Proposition 3 (i) of [AaronsonGottesman2004] for an arbitrary legal Clifford word: the
stabilizer subgroup of the evolved standard stabilizer tableau is the `actionWord` image of the
initial stabilizer subgroup. -/
theorem generatedSubgroup_run_standardStabilizer {n : ℕ} (gs : List (CliffordGate n))
    (hgs : ∀ g ∈ gs, legalGate g) (p : PauliElem n) :
    p ∈ generatedSubgroup (tableauGenerators (run gs (standardStabilizer n))) ↔
      ∃ q ∈ generatedSubgroup (tableauGenerators (standardStabilizer n)),
        actionWord gs q = p := by
  rw [run_generators gs hgs (standardStabilizer n),
    generatedSubgroup_map_actionWord gs hgs (tableauGenerators (standardStabilizer n))]
  exact Iff.rfl

end Qatlib.Papers.StabilizerSim04.MainResults
