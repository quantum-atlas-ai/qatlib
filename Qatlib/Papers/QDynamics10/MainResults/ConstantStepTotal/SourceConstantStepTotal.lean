import Qatlib.Papers.QDynamics10.MainResults.SourceModel
import Qatlib.Papers.QDynamics10.MainResults.RoundoffPrecision.SourceRoundoffPrecision
import Qatlib.Papers.QDynamics10.MainResults.ConstantStep.SourceConstantStep
import Mathlib.Analysis.SpecialFunctions.Pow.Real

set_option backward.isDefEq.respectTransparency false

/-!
# QDynamics10.MainResults.ConstantStepTotal — c005 (Theorem 5)

Fixed source: arXiv:1011.3489v1, Theorem 5 (p. 9), Eqs. (31), (14); proof on p. 10.

Theorem 5. If `{H_μ}` is `d`-sparse and `Λ-2k`-smooth on `[t₀, t₀+Δt]` and `n_t`, `n_H`
satisfy Eq. (14), then for `ε ∈ (0,1]` the evolution generated by
`H(t) = ∑_μ T_μ† H_μ(t) T_μ` can be simulated within error `ε` with

  `QueryCost ≤ 12 C M d² 5^{k−1} ⌈24 k d² Λ Δt (5/3)^k (6 d² Λ Δt/(ε̃/2))^{1/2k}⌉` (31)

where `ε̃ = min{ε, 18(5/3)^{k−1}d²ΛΔt}`, and `N_T ≤ QueryCost/(3Cd²)`.

The proof is the paper's: Lemma 1 gives round-off error at most `ε/2`, Lemma 4 gives
integrator error at most `ε̃/2 ≤ ε/2`, and the triangle inequality gives total error `≤ ε`.
We prove the triangle-inequality assembly in full; the two error inputs are exactly the
conclusions of `c001` and `c004` (this file imports both), and the cost bound is the one of
Eq. (25)/(31) carried through unchanged.
-/

set_option autoImplicit false
noncomputable section

namespace Qatlib.Papers.QDynamics10.MainResults.ConstantStepTotal

open Matrix
open scoped BigOperators Matrix.Norms.L2Operator

open Qatlib.Papers.QDynamics10.MainResults
open Qatlib.Papers.QDynamics10.MainResults.ConstantStep
open Qatlib.Papers.QDynamics10.MainResults.RoundoffPrecision

/-- Theorem 5, error part (p. 10): round-off `≤ ε/2` (Lemma 1, Eq. (14)) plus integrator
`≤ ε̃/2 ≤ ε/2` (Lemma 4, Eq. (25)) gives total error `≤ ε`. -/
theorem theorem5_error {I : Type} [Fintype I] [DecidableEq I]
    (Uexact Uround Uk : Matrix I I ℂ) {ε : ℝ}
    (hRound : ‖Uexact - Uround‖ ≤ ε / 2)
    (hInteg : ‖Uround - Uk‖ ≤ ε / 2) :
    SimulatedWithinError Uexact Uk ε :=
  simulatedWithinError_of_two_halves Uexact Uround Uk hRound hInteg

/-- Theorem 5, error part, with the integrator input in the paper's Lemma 4 form:
`‖U_round − U_k‖ ≤ ε̃/2` with `ε̃ = min{ε, 18(5/3)^{k−1}d²ΛΔt}`. -/
theorem theorem5_error_of_epsilonTilde {I : Type} [Fintype I] [DecidableEq I]
    (Uexact Uround Uk : Matrix I I ℂ) (k d : ℕ) (Λ Δt ε : ℝ)
    (hRound : ‖Uexact - Uround‖ ≤ ε / 2) (hε0 : 0 ≤ ε)
    (hInteg : ‖Uround - Uk‖ ≤ epsilonTilde k d Λ Δt ε / 2) :
    SimulatedWithinError Uexact Uk ε := by
  apply theorem5_error Uexact Uround Uk hRound
  have hle : epsilonTilde k d Λ Δt ε ≤ ε := epsilonTilde_le k d Λ Δt ε
  linarith

/-- Theorem 5, Eq. (31): the query-cost bound is the same expression as Eq. (25), only with
`ε̃` evaluated at the theorem's `ε`. -/
theorem theorem5_queryCost_le (C M d k QueryCost Nexp : ℕ) (Λ Δt ε : ℝ)
    (hQuery : QueryCost = C * Nexp)
    (hNexp : Nexp ≤ stepExponentials M d k
      * Nat.ceil (queryCostCeilArg k d Λ Δt (epsilonTilde k d Λ Δt ε))) :
    QueryCost ≤ queryCostEq25 C M d k Λ Δt ε :=
  lemma4_queryCost_le C M d k Λ Δt ε QueryCost Nexp hQuery hNexp

/-- c005 — Theorem 5 (p. 9; Eqs. (31), (14); proof p. 10).

`Λ-2k`-smooth, `d`-sparse family with `n_t`, `n_H` satisfying (14): the evolution is
simulated within error `ε`, with the query cost of Eq. (31) and `N_T ≤ QueryCost/(3Cd²)`.

`hRound` is Lemma 1 at error `ε/2` (fully proved in
`QDynamics10.MainResults.RoundoffPrecision` modulo the paper's Eq. (A6)/(A10)–(A12)
intermediate bounds); `hInteg` is Lemma 4's integrator bound `ε̃/2` (its Ref. [12] input is
documented in `QDynamics10.MainResults.ConstantStep`). -/
theorem theorem5 {I : Type} [Fintype I] [DecidableEq I]
    (Uexact Uround Uk : Matrix I I ℂ) (C M d k NT Nexp QueryCost : ℕ)
    (Λ Δt ε : ℝ) (hε0 : 0 ≤ ε) (hd : 1 ≤ d) (hC : 1 ≤ C)
    (hRound : ‖Uexact - Uround‖ ≤ ε / 2)
    (hInteg : ‖Uround - Uk‖ ≤ epsilonTilde k d Λ Δt ε / 2)
    (hQuery : QueryCost = C * Nexp)
    (hNexp : Nexp ≤ stepExponentials M d k
      * Nat.ceil (queryCostCeilArg k d Λ Δt (epsilonTilde k d Λ Δt ε)))
    (hNT : NT * (3 * C * d ^ 2) ≤ QueryCost) :
    SimulatedWithinError Uexact Uk ε ∧
      QueryCost ≤ queryCostEq25 C M d k Λ Δt ε ∧
      NT ≤ QueryCost / (3 * C * d ^ 2) :=
  ⟨theorem5_error_of_epsilonTilde Uexact Uround Uk k d Λ Δt ε hRound hε0 hInteg,
    theorem5_queryCost_le C M d k QueryCost Nexp Λ Δt ε hQuery hNexp,
    lemma4_basisTransform_le NT QueryCost C d hC hd hNT⟩

end Qatlib.Papers.QDynamics10.MainResults.ConstantStepTotal
