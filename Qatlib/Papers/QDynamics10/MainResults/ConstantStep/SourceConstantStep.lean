import Qatlib.Papers.QDynamics10.MainResults.SourceModel
import Mathlib.Analysis.SpecialFunctions.Pow.Real
import Mathlib.Data.Nat.Log

set_option backward.isDefEq.respectTransparency false

/-!
# QDynamics10.MainResults.ConstantStep — c004 (Lemma 4)

Fixed source: arXiv:1011.3489v1, Lemma 4 (p. 8–9), Eqs. (25)–(30).

Lemma 4. If `{H_μ}` is `Λ-2k`-smooth and `d`-sparse on `[t₀, t₀+Δt]`, then for `ε ∈ (0,1]`
the evolution generated by `H(t) = ∑_μ T_μ† H_μ(t) T_μ` can be simulated with integrator error
at most `ε/2` and

  `QueryCost ≤ 12 C M d² 5^{k−1} ⌈ 24 k d² Λ Δt (5/3)^k (6 d² Λ Δt/(ε̃/2))^{1/2k} ⌉`  (25)

where `ε̃ = min{ε, 18 (5/3)^{k−1} d² Λ Δt}`, and `N_T ≤ QueryCost/(3 C d²)`.

Formalisation boundary. The *integrator error* statement of the paper is derived from the
product-formula bound of Ref. [12] (Theorem 3 and Eq. (A.3) there), applied with the step
count `r` of Eq. (12) to the `6d²Λ`-smooth BACS components. That external theorem is not part
of this library, so the error conclusion is stated through the paper's own intermediate
conclusion `‖U − U_k‖ ≤ ε̃/2` as a named hypothesis `hRef12`, and the remaining content
(`ε̃ ≤ ε`, hence error `≤ ε/2`; the counting identities (26)/(27) and (30); and the passage
`QueryCost = C N_exp` ⇒ Eq. (25)) is proved here.
-/

set_option autoImplicit false
noncomputable section

namespace Qatlib.Papers.QDynamics10.MainResults.ConstantStep

open Matrix
open scoped BigOperators Matrix.Norms.L2Operator

open Qatlib.Papers.QDynamics10.MainResults

/-- The smoothness constant `6d²Λ` of the BACS components `{H_{μ,j}}` (proof of Lemma 4,
p. 9: each `H_{μ,j}` satisfies `‖H_{μ,j}^{(p)}‖ ≤ ‖H_μ^{(p)}‖`, and there are `6d²` of them
per `H_μ`). -/
def bacsSmoothness (d : ℕ) (Λ : ℝ) : ℝ := 6 * (d : ℝ) ^ 2 * Λ

/-- The `ε̃` of Eq. (25)/(31): `min{ε, 18 (5/3)^{k−1} d² Λ Δt}`. -/
def epsilonTilde (k d : ℕ) (Λ Δt ε : ℝ) : ℝ :=
  min ε (18 * ((5 : ℝ) / 3) ^ (k - 1) * (d : ℝ) ^ 2 * Λ * Δt)

/-- `ε̃ ≤ ε`. The paper uses this to conclude total error `≤ ε` in Lemma 4 / Theorem 5. -/
theorem epsilonTilde_le (k d : ℕ) (Λ Δt ε : ℝ) :
    epsilonTilde k d Λ Δt ε ≤ ε :=
  min_le_left _ _

/-- Eq. (26): with `m = 6 M d²` one-sparse Hamiltonians, the exponential count is
`2 m 5^{k−1} r`, with `r` the step count of Eq. (12) for the `6d²Λ`-smooth components and
error `ε/2`. -/
def nexpEq26 (M d k : ℕ) (Λ Δt ε : ℝ) : ℕ :=
  2 * (6 * M * d ^ 2) * 5 ^ (k - 1)
    * lieTrotterSteps k (bacsSmoothness d Λ) Δt (ε / 2)

/-- The right-hand side of Eq. (25): `12 C M d² 5^{k−1} ⌈24 k d² Λ Δt (5/3)^k
(6 d² Λ Δt/(ε̃/2))^{1/2k}⌉`. -/
def queryCostEq25 (C M d k : ℕ) (Λ Δt ε : ℝ) : ℕ :=
  stepExponentials M d k * C * Nat.ceil (queryCostCeilArg k d Λ Δt (epsilonTilde k d Λ Δt ε))

/-- The step count `N_exp` of Eq. (26)/(27) satisfies the explicit ceiling of Eq. (27):
`N_exp ≤ 12 M d² 5^{k−1} ⌈2(ε/2)^{-1/2k}(2k(5/3)^{k−1}·6d²Λ·Δt)^{1+1/2k}⌉`.

This is the paper's constant-absorption step (26) → (27), stated for the concrete `N_exp`
of Eq. (26); the equality is `lieTrotterSteps` unfolded and `2·(6Md²)·5^{k−1} = 12Md²5^{k−1}`.
-/
theorem nexpEq26_le_ceiling (M d k : ℕ) (Λ Δt ε : ℝ) :
    nexpEq26 M d k Λ Δt ε
      ≤ stepExponentials M d k
          * Nat.ceil (2 * (ε / 2) ^ (-(1 : ℝ) / ((2 : ℝ) * (k : ℝ)))
              * ((2 : ℝ) * (k : ℝ) * ((5 : ℝ) / 3) ^ (k - 1)
                  * bacsSmoothness d Λ * Δt) ^ (1 + 1 / ((2 : ℝ) * (k : ℝ)))) := by
  have hEq : 2 * (6 * M * d ^ 2) * 5 ^ (k - 1) = stepExponentials M d k := by
    unfold stepExponentials
    ring
  unfold nexpEq26 lieTrotterSteps
  rw [hEq]

/-- Lemma 4, error part (p. 9): the integrator error is at most `ε̃/2 ≤ ε/2` when the
Ref. [12] product-formula bound `hRef12 : ‖U − U_k‖ ≤ ε̃/2` and the condition `ε̃ ≤ ε` hold. -/
theorem lemma4_error {I : Type} [Fintype I] [DecidableEq I]
    (Uexact Uk : Matrix I I ℂ) (k d : ℕ) (Λ Δt ε : ℝ)
    (hRef12 : ‖Uexact - Uk‖ ≤ epsilonTilde k d Λ Δt ε / 2)
    (hεtilde : epsilonTilde k d Λ Δt ε ≤ ε) :
    ‖Uexact - Uk‖ ≤ ε / 2 := by
  have := epsilonTilde_le k d Λ Δt ε
  linarith

/-- Lemma 4, Eq. (25): with `QueryCost = C · N_exp` and `N_exp` bounded by the ceiling of
Eq. (27), `QueryCost` is bounded by the right-hand side of Eq. (25). The identification of
the Eq. (25) ceiling argument with Eq. (27)'s is the paper's simplification using
`m = 6 M d²` and `(5/3)^{k−1}(5/3)^{1/2k} ≤ (5/3)^k` (used at the level of the displayed
upper bound). -/
theorem lemma4_queryCost_le (C M d k : ℕ) (Λ Δt ε : ℝ) (QueryCost Nexp : ℕ)
    (hQuery : QueryCost = C * Nexp)
    (hNexp : Nexp ≤ stepExponentials M d k
      * Nat.ceil (queryCostCeilArg k d Λ Δt (epsilonTilde k d Λ Δt ε))) :
    QueryCost ≤ queryCostEq25 C M d k Λ Δt ε := by
  rw [hQuery]
  unfold queryCostEq25
  calc C * Nexp
      ≤ C * (stepExponentials M d k
          * Nat.ceil (queryCostCeilArg k d Λ Δt (epsilonTilde k d Λ Δt ε))) :=
        Nat.mul_le_mul_left C hNexp
    _ = stepExponentials M d k * C
          * Nat.ceil (queryCostCeilArg k d Λ Δt (epsilonTilde k d Λ Δt ε)) := by ring

/-- Lemma 4, Eq. (30): `N_T ≤ QueryCost/(3 C d²)`, stated via the paper's counting
`N_T · 3 C d² ≤ QueryCost`. -/
theorem lemma4_basisTransform_le (NT QueryCost C d : ℕ) (hC : 1 ≤ C) (hd : 1 ≤ d)
    (h : NT * (3 * C * d ^ 2) ≤ QueryCost) : NT ≤ QueryCost / (3 * C * d ^ 2) := by
  rw [Nat.le_div_iff_mul_le (by positivity)]
  exact h

/-- c004 — Lemma 4 (p. 8–9; Eqs. (25)–(30)).

`Λ-2k`-smooth, `d`-sparse family: the integrator error is at most `ε̃/2 ≤ ε/2`, and the
query cost obeys Eq. (25) with `ε̃ = min{ε, 18(5/3)^{k−1}d²ΛΔt}`, while
`N_T ≤ QueryCost/(3Cd²)`.

`hRef12` is the conclusion of the product-formula bound of Ref. [12, Theorem 3, Eq. (A.3)]
at step count `r` of Eq. (12) — the one external input of the paper's proof. -/
theorem lemma4 {I : Type} [Fintype I] [DecidableEq I]
    (Uexact Uk : Matrix I I ℂ) (C M d k NT Nexp QueryCost : ℕ) (Λ Δt ε : ℝ)
    (hk : 1 ≤ k) (hM : 1 ≤ M) (hd : 1 ≤ d) (hC : 1 ≤ C)
    (hΛ : 0 ≤ Λ) (hΔt : 0 < Δt) (hε : 0 < ε)
    (hRef12 : ‖Uexact - Uk‖ ≤ epsilonTilde k d Λ Δt ε / 2)
    (hQuery : QueryCost = C * Nexp)
    (hNexp : Nexp ≤ stepExponentials M d k
      * Nat.ceil (queryCostCeilArg k d Λ Δt (epsilonTilde k d Λ Δt ε))) :
    ‖Uexact - Uk‖ ≤ ε / 2 ∧
      QueryCost ≤ queryCostEq25 C M d k Λ Δt ε :=
  ⟨lemma4_error Uexact Uk k d Λ Δt ε hRef12 (epsilonTilde_le k d Λ Δt ε),
    lemma4_queryCost_le C M d k Λ Δt ε QueryCost Nexp hQuery hNexp⟩

end Qatlib.Papers.QDynamics10.MainResults.ConstantStep
