import Mathlib.Analysis.Normed.Algebra.MatrixExponential
import Mathlib.LinearAlgebra.Matrix.Hermitian
import Mathlib.LinearAlgebra.UnitaryGroup
import Mathlib.Analysis.Complex.Basic
import Mathlib.Tactic.Ring
import Mathlib.Tactic.Push
import Mathlib.Tactic.NormNum

set_option backward.isDefEq.respectTransparency false

/-!
# Continuous-time quantum walk on an unweighted graph

Paper: A. M. Childs, *Universal computation by quantum walk*,
arXiv:0806.1972v1 (12 June 2008).

Section II defines the continuous-time quantum walk generated by the adjacency
matrix `A` of a graph: the Hilbert space is spanned by the vertices, and the
evolution for time `t` is the unitary `e^{-i A t}` (Eq. (1)).  The paper's
Hamiltonian is restricted to a `0/1` adjacency matrix of a graph of maximum
degree `3` (abstract and Sec. I).

This module fixes the kinematic objects once, so that the two paper claims can
be stated against them:

* `IsZeroOneHermitianAdjacency` — unweighted, undirected adjacency matrix;
* `MaxDegreeLe` — the maximum-degree bound (degree `3` in the paper);
* `walkPropagator` — the walk unitary `e^{-i A t}`;
* `walkAmplitude`, `walkProbability` — transition amplitudes and Born
  probabilities in the vertex basis.

The unitary nature of the propagator is proved here (`walkPropagator_unitary`)
rather than assumed; it is the only dynamical fact needed to make the paper's
measurement statements well typed.
-/

namespace Qatlib.Papers.UniversalWalk08.MainResults.WalkModel

open Matrix
open scoped Matrix

set_option autoImplicit false

variable {V : Type*} [Fintype V] [DecidableEq V]

/-- **Unweighted undirected adjacency matrix.**

The matrix entries are all `0` or `1`, and the matrix is Hermitian (for a real
`0/1` matrix this is exactly symmetry of the underlying undirected graph).
Paper: arXiv:0806.1972v1, abstract and Sec. I (Eq. (1) and the paragraph
"the edges are unweighted, and the graph has maximum degree 3"). -/
def IsZeroOneHermitianAdjacency (A : Matrix V V ℂ) : Prop :=
  (∀ i j, A i j = 0 ∨ A i j = 1) ∧ Aᴴ = A

/-- **Maximum-degree bound for a `0/1` adjacency matrix.**

Each row of the adjacency matrix contains at most `d` unit entries, expressed
as the row sum of the real parts being at most `d`.  Paper: arXiv:0806.1972v1,
Sec. I ("the graph has maximum degree 3 (which cannot be improved ...)"). -/
def MaxDegreeLe (A : Matrix V V ℂ) (d : ℕ) : Prop :=
  ∀ i, ∑ j, (A i j).re ≤ (d : ℝ)

/-- **Continuous-time quantum walk propagator.**

`walkPropagator A t = e^{-i A t}`, the evolution operator of the walk generated
by the adjacency matrix `A` for time `t`.  Paper: arXiv:0806.1972v1, Sec. II,
Eq. (1) ("the evolution of the walk for time `t` is described by the unitary
operator `e^{-iAt}`"). -/
noncomputable def walkPropagator (A : Matrix V V ℂ) (t : ℝ) : Matrix V V ℂ :=
  NormedSpace.exp ((-(Complex.I * (t : ℂ))) • A)

/-- **Transition amplitude** `⟨dest| e^{-i A t} |src⟩`.

Paper: arXiv:0806.1972v1, Sec. II, Eq. (11) (`⟨y, j'| e^{-iHt} |x, j⟩`). -/
noncomputable def walkAmplitude (A : Matrix V V ℂ) (t : ℝ) (dest src : V) : ℂ :=
  walkPropagator A t dest src

/-- **Born probability** of finding the walker at `dest` after time `t`.

Paper: arXiv:0806.1972v1, Sec. VII ("we measure in the vertex basis"). -/
noncomputable def walkProbability (A : Matrix V V ℂ) (t : ℝ) (dest src : V) : ℝ :=
  Complex.normSq (walkAmplitude A t dest src)

/-- **The propagator at time zero is the identity.**

Paper: arXiv:0806.1972v1, Sec. II (the walk is generated by `A`, so
`e^{-iA·0} = 1`). -/
@[simp]
theorem walkPropagator_zero (A : Matrix V V ℂ) : walkPropagator A 0 = 1 := by
  unfold walkPropagator
  simp

/-- **Semigroup law of the walk propagator.**

`e^{-iAs} e^{-iAt} = e^{-iA(s+t)}`, because scalar multiples of the same
matrix commute.  Paper: arXiv:0806.1972v1, Sec. II (one-parameter unitary
group generated by `A`). -/
theorem walkPropagator_mul (A : Matrix V V ℂ) (s t : ℝ) :
    walkPropagator A s * walkPropagator A t = walkPropagator A (s + t) := by
  unfold walkPropagator
  have hcomm : Commute ((-(Complex.I * (s : ℂ))) • A) ((-(Complex.I * (t : ℂ))) • A) :=
    ((Commute.refl A).smul_left _).smul_right _
  calc
    NormedSpace.exp ((-(Complex.I * (s : ℂ))) • A) *
        NormedSpace.exp ((-(Complex.I * (t : ℂ))) • A)
        = NormedSpace.exp (((-(Complex.I * (s : ℂ))) • A) +
            ((-(Complex.I * (t : ℂ))) • A)) :=
          (Matrix.exp_add_of_commute _ _ hcomm).symm
    _ = NormedSpace.exp ((-(Complex.I * ((s + t : ℝ) : ℂ))) • A) := by
          congr 1
          rw [← add_smul]
          congr 1
          push_cast
          ring

/-- **Conjugate transpose of the walk propagator.**

For a Hermitian adjacency matrix, `(e^{-iAt})ᴴ = e^{iAt} = e^{-iA(-t)}`.
Paper: arXiv:0806.1972v1, Sec. II (the walk operator is unitary). -/
theorem walkPropagator_conjTranspose {A : Matrix V V ℂ} (hA : Aᴴ = A) (t : ℝ) :
    (walkPropagator A t)ᴴ = walkPropagator A (-t) := by
  unfold walkPropagator
  rw [← Matrix.exp_conjTranspose]
  congr 1
  rw [Matrix.conjTranspose_smul, hA]
  congr 1
  -- `star (-(I * t)) = -(I * (-t))` for real `t`.
  push_cast
  rw [Complex.star_def, map_neg, map_mul, Complex.conj_ofReal, Complex.conj_I]
  ring

/-- **The walk propagator is unitary.**

For Hermitian `A`, the adjacency-matrix walk `e^{-iAt}` preserves the norm of
every state.  Paper: arXiv:0806.1972v1, Sec. II ("the evolution of the walk for
time `t` is described by the unitary operator `e^{-iAt}`"). -/
theorem walkPropagator_unitary {A : Matrix V V ℂ} (hA : Aᴴ = A) (t : ℝ) :
    (walkPropagator A t)ᴴ * walkPropagator A t = 1 ∧
      walkPropagator A t * (walkPropagator A t)ᴴ = 1 := by
  have hconj := walkPropagator_conjTranspose hA t
  constructor
  · rw [hconj, walkPropagator_mul]
    rw [show -t + t = 0 by ring, walkPropagator_zero]
  · rw [hconj, walkPropagator_mul]
    rw [show t + -t = 0 by ring, walkPropagator_zero]

omit [Fintype V] [DecidableEq V] in
/-- **Hermitian `0/1` adjacency matrices are the paper's Hamiltonians.**

Paper: arXiv:0806.1972v1, abstract ("a sparse matrix with all entries equal to
0 or 1, i.e., the adjacency matrix of a low-degree graph"). -/
theorem hermitian_of_isZeroOneHermitianAdjacency {A : Matrix V V ℂ}
    (h : IsZeroOneHermitianAdjacency A) : Aᴴ = A := h.2

/-- **A `0/1` adjacency matrix with a degree bound gives a unitary walk.**

This packages the kinematic facts needed by both paper claims: the walk is a
genuine unitary evolution on the vertex basis.  Paper: arXiv:0806.1972v1,
Sec. II and Sec. VII. -/
theorem walkPropagator_unitary_of_adjacency {A : Matrix V V ℂ}
    (h : IsZeroOneHermitianAdjacency A) (t : ℝ) :
    (walkPropagator A t)ᴴ * walkPropagator A t = 1 ∧
      walkPropagator A t * (walkPropagator A t)ᴴ = 1 :=
  walkPropagator_unitary (hermitian_of_isZeroOneHermitianAdjacency h) t

/-- **Total probability is conserved in the vertex basis.**

For a Hermitian adjacency matrix, the Born probabilities of the walk from any
fixed starting vertex sum to one.  Paper: arXiv:0806.1972v1, Sec. VII (the
final measurement is in the vertex basis). -/
theorem sum_walkProbability_eq_one {A : Matrix V V ℂ} (hA : Aᴴ = A) (t : ℝ)
    (src : V) :
    ∑ dest, walkProbability A t dest src = 1 := by
  -- Unitarity gives `∑ j, conj(U j src) * U j src = 1`.
  have hunit : (walkPropagator A t)ᴴ * walkPropagator A t = 1 :=
    (walkPropagator_unitary hA t).1
  have hentry := congrFun (congrFun hunit src) src
  simp only [Matrix.mul_apply, Matrix.one_apply_eq] at hentry
  -- Each term is the complex image of the Born probability.
  have hsumC : (∑ d, (((Complex.normSq ((walkPropagator A t) d src)) : ℝ) : ℂ)) = 1 := by
    rw [← hentry]
    refine Finset.sum_congr rfl fun d _ => ?_
    rw [Complex.normSq_eq_conj_mul_self]
    simp [Matrix.conjTranspose_apply]
  have hre := congrArg Complex.re hsumC
  simpa [walkProbability, walkAmplitude] using hre

end Qatlib.Papers.UniversalWalk08.MainResults.WalkModel
