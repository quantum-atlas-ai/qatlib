import Qatlib.Concepts.LchsSimulation.Kernel.NearExponentialLchsKernel
import Qatlib.Concepts.LchsSimulation.TimeLchs
import Qatlib.Concepts.LchsSimulation.TimeOrdered.TimeOrderedConsumers

open Qatlib.Concepts.LchsSimulation.Kernel
open Qatlib.Concepts.TimeEvolution.TimeOrderedEvolution
open Qatlib.Concepts.LchsSimulation.TimeLchs

/-!
# Lemma 10 for the actual time-ordered LCHS unitary family

Lemma 10 of arXiv:2312.03916v2 (p. 17, Eqs. (62)-(63)) bounds the truncation
error of `∫_ℝ g(k) U(T,k) dk` at `|k| = K`.  The frozen kernel module proves the
bound for an *arbitrary* continuous unitary family; this file supplies the
paper's actual family

  `U(T,k) = 𝒯 exp(-i ∫_0^T (k L(s) + H(s)) ds)`,

i.e. the matrix-valued time-ordered propagator generated by `i (H + k L)`, and
transports the frozen estimate to it.  Only the analytic truncation is treated:
Gauss quadrature, LCU compilation, input-state preparation and the query cost
of Theorem 15 are outside this file.
-/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false

noncomputable section

namespace Qatlib.Papers.LinDynamics23.Kernel

open Matrix MeasureTheory
open scoped Matrix.Norms.L2Operator ComplexOrder

/-- The paper's ordered propagator `U(T,k) = 𝒯 exp(-i ∫_s^T (k L(u) + H(u)) du)`.
The Dyson convention of `orderedEvolution` is `𝒯 exp(-∫ A)`, so the generator is
`A u = i (H u + k L u)`. -/
noncomputable def lchsPropagator {I : Type} [Fintype I] [DecidableEq I]
    (L H : ℝ → Matrix I I ℂ) (s T : ℝ) :
    ℝ → Matrix I I ℂ :=
  fun k => orderedEvolution (fun u => Complex.I • (H u + k • L u)) s T

/-- The generator of `lchsPropagator` is the paper's `i (H + k L)`, written in the
scaled form used by the complex-parameter analyticity theorem. -/
theorem lchsPropagator_generator {I : Type} [Fintype I] [DecidableEq I]
    (L H : ℝ → Matrix I I ℂ) (k : ℝ) :
    (fun u => ((k : ℂ) * Complex.I) • L u + Complex.I • H u) =
      (fun u => Complex.I • (H u + k • L u)) := by
  funext u
  have h1 : ((k : ℂ) * Complex.I) • L u = Complex.I • (k • L u) := by
    rw [mul_comm, ← smul_smul, Complex.coe_smul]
  rw [h1, smul_add, add_comm]

/-- `k ↦ U(T,k)` is continuous for continuous matrix fields `L` and `H`; the
parameter enters the Dyson series through an entire complex family. -/
theorem lchsPropagator_continuous {I : Type} [Fintype I] [DecidableEq I]
    (L H : ℝ → Matrix I I ℂ) (hL : Continuous L) (hH : Continuous H) (s T : ℝ) :
    Continuous (lchsPropagator L H s T) := by
  have hentire := ordered_evolution_entire_parameter L H hL hH s T
  have hpath : Continuous
      (fun k : ℝ => ((k : ℂ) * Complex.I)) :=
    Complex.continuous_ofReal.mul continuous_const
  have hc := hentire.continuous.comp hpath
  unfold lchsPropagator
  simpa only [Function.comp_def, lchsPropagator_generator L H] using hc

/-- Every value `U(T,k)` of the paper's ordered propagator is unitary when `L` is
positive semidefinite and `H` is Hermitian. -/
theorem lchsPropagator_mem_unitaryGroup {I : Type} [Fintype I] [DecidableEq I]
    (L H : ℝ → Matrix I I ℂ) (hL : Continuous L) (hH : Continuous H)
    (hPSD : ∀ u, (L u).PosSemidef) (hHerm : ∀ u, (H u).IsHermitian) (s T : ℝ)
    (k : ℝ) : lchsPropagator L H s T k ∈ Matrix.unitaryGroup I ℂ := by
  have hgen : Continuous (fun u => H u + k • L u) := hH.add (hL.const_smul k)
  have hHermGen : ∀ u, (H u + k • L u).IsHermitian :=
    fun u => (hHerm u).add ((hPSD u).isHermitian.smul (R := ℝ) (IsSelfAdjoint.all k))
  exact ordered_evolution_hermitian_unitary I (fun u => H u + k • L u) hgen hHermGen s T

/-- **Lemma 10(1)**, Eq. (62), for the paper's actual `U(T,k)`: the truncated
integral is absolutely entrywise integrable and its tail is bounded by the
printed constant `highKernelTailC β / K` times `exp(-K^β cos(βπ/2) / 2)`. -/
theorem lemma10_actual_lchs_truncation {I : Type} [Fintype I] [DecidableEq I]
    (L H : ℝ → Matrix I I ℂ) (hL : Continuous L) (hH : Continuous H)
    (hPSD : ∀ u, (L u).PosSemidef) (hHerm : ∀ u, (H u).IsHermitian)
    (β K : ℝ) (hβ : 0 < β) (hβ1 : β < 1) (hK : 1 ≤ K) :
    (∀ i j : I, Integrable (fun k : ℝ => highKernelG β k * lchsPropagator L H 0 K k i j)) ∧
      ‖(∫ k : ℝ, highKernelG β k • lchsPropagator L H 0 K k) -
        (∫ k in -K..K, highKernelG β k • lchsPropagator L H 0 K k)‖ ≤
        (highKernelTailC β / K) *
          Real.exp (-(K ^ β) * Real.cos (β * Real.pi / 2) / 2) := by
  have hcont : Continuous (lchsPropagator L H 0 K) :=
    lchsPropagator_continuous L H hL hH 0 K
  have hunit : ∀ k, lchsPropagator L H 0 K k ∈ Matrix.unitaryGroup I ℂ :=
    lchsPropagator_mem_unitaryGroup L H hL hH hPSD hHerm 0 K
  exact near_exponential_kernel_actual_unitary_tail I β K (lchsPropagator L H 0 K)
    hβ hβ1 hK hcont hunit

/-- **Lemma 10(2)**, Eq. (63), for the paper's actual `U(T,k)`: the explicit
integer window `K = highKernelCutoff β ε` is at least one and drives the
truncation error below `ε`. -/
theorem lemma10_actual_lchs_precision_window {I : Type} [Fintype I] [DecidableEq I]
    (L H : ℝ → Matrix I I ℂ) (hL : Continuous L) (hH : Continuous H)
    (hPSD : ∀ u, (L u).PosSemidef) (hHerm : ∀ u, (H u).IsHermitian)
    (β ε : ℝ) (hβ : 0 < β) (hβ1 : β < 1) (hε : 0 < ε) :
    let K : ℝ := highKernelCutoff β ε
    1 ≤ K ∧ ‖(∫ k : ℝ, highKernelG β k • lchsPropagator L H 0 K k) -
        (∫ k in -K..K, highKernelG β k • lchsPropagator L H 0 K k)‖ ≤ ε := by
  dsimp only
  have hcont : Continuous (lchsPropagator L H 0 (highKernelCutoff β ε : ℝ)) :=
    lchsPropagator_continuous L H hL hH 0 _
  have hunit : ∀ k, lchsPropagator L H 0 (highKernelCutoff β ε : ℝ) k ∈
      Matrix.unitaryGroup I ℂ :=
    lchsPropagator_mem_unitaryGroup L H hL hH hPSD hHerm 0 _
  exact near_exponential_kernel_chosen_precision_window I β ε _ hβ hβ1 hε hcont hunit

end Qatlib.Papers.LinDynamics23.Kernel
