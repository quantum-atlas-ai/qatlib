  obtain ⟨hN,hNC⟩ := StackCall.execution countCode Label.increment .shift ReadonlyRepeat.getIO ReadonlyRepeat.putIO
    (countFrame reader wire block output) (countFrame_at reader wire block output) (countFrame_update reader wire block output)
    (fun _ _ => rfl) (fun _ _ _ => rfl) Increment.program program (fun _ => rfl) v ticks _ _ hr
