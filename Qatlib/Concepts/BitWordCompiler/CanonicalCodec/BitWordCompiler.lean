theorem wire_key_prepare (raw reader width count fuel wireCount seen : Bits) (n : ℕ) (v : Local) :
    ∃ ticks last,
      Stacks.stackRun program ticks ⟨some (.transfer .fieldToValue .qWireIncrement 0),v,
        queryStore raw reader width count fuel wireCount seen [] [] n.bits.reverse⟩=
        some ⟨some (.step .qWireInsert),last,
          queryStore raw reader width count fuel wireCount seen (n+1).bits.reverse [] []⟩ ∧
      Stacks.stackRunClock program ticks ⟨some (.transfer .fieldToValue .qWireIncrement 0),v,
        queryStore raw reader width count fuel wireCount seen [] [] n.bits.reverse⟩≤1000*(1+n.bits.length)^2 := by
  let S0 := queryStore raw reader width count fuel wireCount seen [] [] n.bits.reverse
  let S1 := queryStore raw reader width count fuel wireCount seen [] n.bits []
  let S2 := queryStore raw reader width count fuel wireCount seen [] (n+1).bits []
  let v1 := putIO v none
  obtain ⟨hT,hTC⟩ := transfer_all .fieldToValue .qWireIncrement S0 v
  have hInput : S0 (transferBanks .fieldToValue).1=n.bits.reverse := rfl
  have hOutput : S0 (transferBanks .fieldToValue).2=[] := rfl
  simp only [hOutput,List.append_nil] at hT
  rw [transfer_frame_empty .fieldToValue S0 hOutput] at hT
  simp only [hInput,hOutput,List.reverse_reverse,List.length_reverse,List.length_nil,Nat.add_zero] at hT hTC
  simp only [transferBanks,S0,queryStore_update_field,queryStore_update_value] at hT
  obtain ⟨hB,hBC⟩ := goto_phase .qWireIncrement (.increment .qWireIncremented .carry) rfl S1 v1
  obtain ⟨incTicks,hI,hIC⟩ := increment_valid .qWireIncremented S1 v1 n rfl rfl
  rw [increment_frame S1 n.bits (n+1).bits rfl rfl] at hI
  simp only [S1,queryStore_update_value] at hI
  obtain ⟨hC,hCC⟩ :=
      goto_phase .qWireIncremented (.transfer .valueToTarget .qWireInsert 0) rfl S2 v1
  obtain ⟨hU,hUC⟩ := transfer_all .valueToTarget .qWireInsert S2 v1
  have huInput : S2 (transferBanks .valueToTarget).1=(n+1).bits := rfl
  have huOutput : S2 (transferBanks .valueToTarget).2=[] := rfl
  simp only [huOutput,List.append_nil] at hU
  rw [transfer_frame_empty .valueToTarget S2 huOutput] at hU
  simp only [huInput,huOutput,List.length_nil,Nat.add_zero] at hU hUC
  simp only [transferBanks,S2,queryStore_update_value,queryStore_update_target] at hU
  have eT : Stacks.Execution program _ _ _ := ⟨n.bits.length+1,hT,hTC.le⟩
  have eB : Stacks.Execution program _ _ 1 := ⟨1,hB,hBC.le⟩
  have eI : Stacks.Execution program _ _ _ := ⟨incTicks,hI,hIC⟩
  have eC : Stacks.Execution program _ _ 1 := ⟨1,hC,hCC.le⟩
  have eU : Stacks.Execution program _ _ _ := ⟨(n+1).bits.length+1,hU,hUC.le⟩
  obtain ⟨ticks,hr,hc⟩ := (((eT.trans eB).trans eI).trans eC).trans eU
  refine ⟨ticks,_,hr,hc.trans ?_⟩
  let B := 1+n.bits.length
  have hB : 1≤B := by dsimp [B]; omega
  have hB2 : B≤B^2 := Nat.le_pow (by decide)
  have hn : n.bits.length≤B := by dsimp [B]; omega
  have hn2 := Nat.mul_le_mul hn hn
  have hp : (n+1).bits.length≤B := by have h := bits_succ_length n; dsimp [B]; omega
  have hp2 := Nat.mul_le_mul hp hp
  change n.bits.length*(2*n.bits.length+5)+3+1+50*B^2+1+
    ((n+1).bits.length*(2*(n+1).bits.length+5)+3)≤1000*B^2
  nlinarith only [hB,hB2,hn,hn2,hp,hp2]

theorem insert_candidate (ret next : Phase)
    (hret : phaseProgram ret=.branch (fun v => v.inserted.1.found) (go .failure) (.goto (fun _ => .drain .target next 0)))
    (raw reader width count fuel wireCount : Bits) (values : List ℕ) (n : ℕ) (v : Local) :
    ∃ ticks last,
      Stacks.stackRun program ticks ⟨some (.insert ret (.find .start)),v,
        queryStore raw reader width count fuel wireCount (NatListFind.stream values).reverse n.bits.reverse [] []⟩=
        some ⟨some (.step (if n∈values then .failure else next)),last,
          queryStore raw reader width count fuel wireCount (NatListFind.stream (NatSetInsert.inserted values n)).reverse
            (if n∈values then n.bits.reverse else []) [] []⟩ ∧
      Stacks.stackRunClock program ticks ⟨some (.insert ret (.find .start)),v,
        queryStore raw reader width count fuel wireCount (NatListFind.stream values).reverse n.bits.reverse [] []⟩≤
          6000*(1+(NatListFind.stream values).length+n.bits.length)^3 := by
  let S0 :=
      queryStore raw reader width count fuel wireCount
      (NatListFind.stream values).reverse n.bits.reverse [] []
  let S1 :=
      queryStore raw reader width count fuel wireCount
      (NatListFind.stream (NatSetInsert.inserted values n)).reverse n.bits.reverse [] []
  have hdata : ∀ k,S0 (insertCode k)=NatSetInsert.store (NatListFind.stream values).reverse n.bits.reverse [] [] [] [] [] [] [] k := by
    intro k
    cases k with
    | none => rfl
    | some k => cases k <;> rfl
  obtain ⟨insertTicks,lastInsert,hI,hfound,hIC⟩ := insert_valid ret S0 v values n hdata
  rw [insert_frame S0 _ _ n.bits.reverse hdata] at hI
  simp only [S0,queryStore_update_seen] at hI
  let v1 := putInsert v lastInsert
  have hBC : Stacks.stackRunClock program 1 ⟨some (.step ret),v1,S1⟩=1 := by
    simp [Stacks.stackRunClock,program,hret,go,Stacks.stackClock]
  have eI : Stacks.Execution program _ _ _ := ⟨insertTicks,hI,hIC⟩
  let B := 1+(NatListFind.stream values).length+n.bits.length
  have hB : 1≤B := by dsimp [B]; omega
  have hB2 : B≤B^2 := Nat.le_pow (by decide)
  have h23 : B^2≤B^3 := Nat.pow_le_pow_right (by omega) (by decide)
  have hB3 : 1≤B^3 := Nat.one_le_pow 3 _ hB
  by_cases hmem : n∈values
  · have hv : v1.inserted.1.found=true := by simpa only [v1,putInsert,hmem,decide_true] using hfound
    have hBranch : Stacks.stackRun program 1 ⟨some (.step ret),v1,S1⟩=some ⟨some (.step .failure),v1,S1⟩ := by
      rw [phase_step,hret]
      simp [TM2.stepAux,hv,go]
    have eB : Stacks.Execution program _ _ 1 := ⟨1,hBranch,hBC.le⟩
    obtain ⟨ticks,hr,hc⟩ := eI.trans eB
    refine ⟨ticks,v1,?_,hc.trans ?_⟩
    · simpa only [if_pos hmem] using hr
    · change 5000*B^3+1≤6000*B^3
      omega
  · have hv : v1.inserted.1.found=false := by simpa only [v1,putInsert,hmem,decide_false] using hfound
    have hBranch : Stacks.stackRun program 1 ⟨some (.step ret),v1,S1⟩=some ⟨some (.drain .target next 0),v1,S1⟩ := by
      rw [phase_step,hret]
      simp [TM2.stepAux,hv]
    obtain ⟨hD,hDC⟩ :=
        drain_call (Label.drain .target next) (.step next) .target (fun _ => rfl) S1 v1
    have htarget : S1 (some .target)=n.bits.reverse := rfl
    rw [htarget] at hD hDC
    simp only [S1,queryStore_update_target] at hD
    have eB : Stacks.Execution program _ _ 1 := ⟨1,hBranch,hBC.le⟩
    have eD : Stacks.Execution program _ _ _ := ⟨n.bits.reverse.length+1,hD,hDC.le⟩
    obtain ⟨ticks,hr,hc⟩ := (eI.trans eB).trans eD
    refine ⟨ticks,putIO v1 none,?_,hc.trans ?_⟩
    · simpa only [if_neg hmem] using hr
    · have hn : n.bits.length≤B := by dsimp [B]; omega
      have hn2 := Nat.mul_le_mul hn hn
      simp only [List.length_reverse]
      change 5000*B^3+1+(n.bits.length^2+3*n.bits.length+3)≤6000*B^3
      nlinarith only [hn,hn2,hB,hB2,h23,hB3]

def wireStore (raw tail width count fuel counter : Bits) (seen : List ℕ) (a bound : ℕ) : Slot → Bits :=
  if a<bound then
    queryStore raw tail width count fuel counter (NatListFind.stream (NatSetInsert.inserted seen (a+1))).reverse
      (if a+1∈seen then (a+1).bits.reverse else []) [] []
  else queryStore raw tail width count fuel counter (NatListFind.stream seen).reverse [] [] a.bits.reverse

theorem wire_canonical (raw tail count fuel counter : Bits) (seen : List ℕ) (a width : ℕ) (v : Local) :
    ∃ ticks last,
      Stacks.stackRun program ticks ⟨some (.read .field .qWireRead .unary),v,
        queryStore raw (natBits a++tail) width.bits.reverse count fuel counter (NatListFind.stream seen).reverse [] [] []⟩=
        some ⟨some (.step (if a<width ∧ a+1∉seen then .qLoop else .failure)),last,
          wireStore raw tail width.bits.reverse count fuel counter seen a width⟩ ∧
      Stacks.stackRunClock program ticks ⟨some (.read .field .qWireRead .unary),v,
        queryStore raw (natBits a++tail) width.bits.reverse count fuel counter (NatListFind.stream seen).reverse [] [] []⟩≤
          10000*(1+(natBits a++tail).length+width.bits.length+(NatListFind.stream seen).length)^3 := by
  let S0 :=
      queryStore raw (natBits a++tail) width.bits.reverse count fuel counter
      (NatListFind.stream seen).reverse [] [] []
  let S1 :=
      queryStore raw tail width.bits.reverse count fuel counter (NatListFind.stream seen).reverse
      [] [] a.bits.reverse
  obtain ⟨addressTicks,v1,hA,hAC⟩ := address_canonical .qWireRead .qWireCompare
    (.transfer .fieldToValue .qWireIncrement 0) rfl rfl S0 a width tail v rfl rfl rfl rfl rfl rfl rfl
  simp only [S0,queryStore_update_reader,queryStore_update_field] at hA
  change _≤1000*(1+(natBits a++tail).length+width.bits.length)^2 at hAC
  let B := 1+(natBits a++tail).length+width.bits.length+(NatListFind.stream seen).length
  have hB : 1≤B := by dsimp [B]; omega
  have h23 : B^2≤B^3 := Nat.pow_le_pow_right (by omega) (by decide)
  have harg : 1+(natBits a++tail).length+width.bits.length≤B := by dsimp [B]; omega
  have harg2 := Nat.pow_le_pow_left harg 2
  by_cases ha : a<width
  · simp only [if_pos ha] at hA
    obtain ⟨keyTicks,v2,hK,hKC⟩ :=
        wire_key_prepare raw tail width.bits.reverse count fuel counter
        (NatListFind.stream seen).reverse a v1
    let S2 :=
        queryStore raw tail width.bits.reverse count fuel counter (NatListFind.stream seen).reverse
        (a+1).bits.reverse [] []
    obtain ⟨hB,hBC⟩ := goto_phase .qWireInsert (.insert .qWireInserted (.find .start)) rfl S2 v2
    obtain ⟨insertTicks,v3,hI,hIC⟩ :=
        insert_candidate .qWireInserted .qLoop rfl raw tail width.bits.reverse count fuel counter seen (a+1) v2
    have eA : Stacks.Execution program _ _ _ := ⟨addressTicks,hA,hAC⟩
    have eK : Stacks.Execution program _ _ _ := ⟨keyTicks,hK,hKC⟩
    have eB : Stacks.Execution program _ _ 1 := ⟨1,hB,hBC.le⟩
    have eI : Stacks.Execution program _ _ _ := ⟨insertTicks,hI,hIC⟩
    obtain ⟨ticks,hr,hc⟩ := ((eA.trans eK).trans eB).trans eI
    refine ⟨ticks,v3,?_,hc.trans ?_⟩
    · simpa [wireStore,ha] using hr
    · have han : 1+a.bits.length≤B := by
        dsimp [B]
        simp only [List.length_append,natBits_length]
        omega
      have han2 := Nat.pow_le_pow_left han 2
      have hin : 1+(NatListFind.stream seen).length+(a+1).bits.length≤B := by
        have hs := bits_succ_length a
        dsimp [B]
        simp only [List.length_append,natBits_length]
        omega
      have hin3 := Nat.pow_le_pow_left hin 3
      have hB3 : 1≤B^3 := Nat.one_le_pow 3 _ (by dsimp [B]; omega)
      change 1000*(1+(natBits a++tail).length+width.bits.length)^2+
        1000*(1+a.bits.length)^2+1+6000*(1+(NatListFind.stream seen).length+(a+1).bits.length)^3≤10000*B^3
      nlinarith only [harg2,han2,hin3,h23,hB3]
  · simp only [if_neg ha] at hA
    refine ⟨addressTicks,v1,?_,hAC.trans ?_⟩
    · simpa [wireStore,ha] using hA
    · change 1000*(1+(natBits a++tail).length+width.bits.length)^2≤10000*B^3
      nlinarith only [harg2,h23]

theorem query_count_zero (raw reader width count counter fuel seen : Bits) (v : Local) (hz : binaryValue counter=0) :
    ∃ ticks last,
      Stacks.stackRun program ticks ⟨some (.step .qLoop),v,queryStore raw reader width count fuel counter seen [] [] []⟩=
        some ⟨some (.step .qFinish),last,queryStore raw reader width count fuel [] seen [] [] []⟩ ∧
      Stacks.stackRunClock program ticks ⟨some (.step .qLoop),v,queryStore raw reader width count fuel counter seen [] [] []⟩≤
        100*(1+counter.length+fuel.length)^2 := by
  let S0 := queryStore raw reader width count fuel counter seen [] [] []
  let S1 :=
      queryStore raw reader width count fuel (List.replicate counter.length true) seen [] [] []
  let v1 := putGuard v (.zero,(false,none),v.guarded.2.2)
  obtain ⟨hB,hBC⟩ := goto_phase .qLoop (.guard true .qLoopResult (.counter .borrow)) rfl S0 v
  obtain ⟨guardTicks,hG,hGC⟩ := guard_zero true .qLoopResult S0 v rfl hz
  change Stacks.stackRun program guardTicks ⟨some (.guard true .qLoopResult (.counter .borrow)),v,S0⟩=
    some ⟨some (.step .qLoopResult),v1,StackCall.frame (guardCode true) S0 (Parsing.triple (List.replicate counter.length true) [] fuel)⟩ at hG
  change _≤20*(1+counter.length+fuel.length)^2 at hGC
  rw [guard_frame true S0 (List.replicate counter.length true) fuel rfl] at hG
  simp only [if_true,S0,queryStore_update_wireCount,queryStore_update_fuel] at hG
  obtain ⟨hZ,hZC⟩ := query_zero S1 v1 rfl
  obtain ⟨hD,hDC⟩ :=
      drain_call (Label.drain .wireCount .qFinish) (.step .qFinish) .wireCount (fun _ => rfl) S1 v1
  have hcounter : S1 (some .wireCount)=List.replicate counter.length true := rfl
  rw [hcounter] at hD hDC
  simp only [S1,queryStore_update_wireCount] at hD
  have eB : Stacks.Execution program _ _ 1 := ⟨1,hB,hBC.le⟩
  have eG : Stacks.Execution program _ _ _ := ⟨guardTicks,hG,hGC⟩
  have eZ : Stacks.Execution program _ _ 1 := ⟨1,hZ,hZC.le⟩
  have eD : Stacks.Execution program _ _ _ :=
      ⟨(List.replicate counter.length true).length+1,hD,hDC.le⟩
  obtain ⟨ticks,hr,hc⟩ := ((eB.trans eG).trans eZ).trans eD
  refine ⟨ticks,_,hr,hc.trans ?_⟩
  let B := 1+counter.length+fuel.length
  have hB : 1≤B := by dsimp [B]; omega
  have hB2 : B≤B^2 := Nat.le_pow (by decide)
  have hcounter : counter.length≤B := by dsimp [B]; omega
  have hcounter2 := Nat.mul_le_mul hcounter hcounter
  simp only [List.length_replicate]
  change 1+20*B^2+1+(counter.length^2+3*counter.length+3)≤100*B^2
  nlinarith only [hB,hB2,hcounter,hcounter2]

theorem query_fuel_empty (raw reader width count counter seen : Bits) (v : Local) (hp : 0<binaryValue counter) :
    ∃ ticks last output,output.length=counter.length ∧ binaryValue output+1=binaryValue counter ∧
      Stacks.stackRun program ticks ⟨some (.step .qLoop),v,queryStore raw reader width count [] counter seen [] [] []⟩=
        some ⟨some (.step .failure),last,queryStore raw reader width count [] output seen [] [] []⟩ ∧
      Stacks.stackRunClock program ticks ⟨some (.step .qLoop),v,queryStore raw reader width count [] counter seen [] [] []⟩≤100*(1+counter.length)^2 := by
  let S0 := queryStore raw reader width count [] counter seen [] [] []
  let v1 := putGuard v (.exhausted,(true,none),none)
  obtain ⟨hB,hBC⟩ := goto_phase .qLoop (.guard true .qLoopResult (.counter .borrow)) rfl S0 v
  obtain ⟨guardTicks,output,hlen,hvalue,hG,hGC⟩ := guard_positive true .qLoopResult S0 v rfl hp
  change output.length=counter.length at hlen
  change binaryValue output+1=binaryValue counter at hvalue
  change Stacks.stackRun program guardTicks ⟨some (.guard true .qLoopResult (.counter .borrow)),v,S0⟩=
    some ⟨some (.step .qLoopResult),v1,StackCall.frame (guardCode true) S0 (Parsing.triple output [] [])⟩ at hG
  change _≤20*(1+counter.length)^2 at hGC
  rw [guard_frame true S0 output [] rfl] at hG
  simp only [if_true,S0,queryStore_update_wireCount,queryStore_update_fuel] at hG
  obtain ⟨hE,hEC⟩ :=
      query_exhausted (queryStore raw reader width count [] output seen [] [] []) v1 rfl
  have eB : Stacks.Execution program _ _ 1 := ⟨1,hB,hBC.le⟩
  have eG : Stacks.Execution program _ _ _ := ⟨guardTicks,hG,hGC⟩
  have eE : Stacks.Execution program _ _ 1 := ⟨1,hE,hEC.le⟩
  obtain ⟨ticks,hr,hc⟩ := (eB.trans eG).trans eE
  refine ⟨ticks,_,output,hlen,hvalue,hr,hc.trans ?_⟩
  have hp : 1≤(1+counter.length)^2 := Nat.one_le_pow 2 _ (by omega)
  omega

theorem query_count_positive (raw reader width count counter seen : Bits) (fuel : ℕ) (v : Local) (hp : 0<binaryValue counter) :
    ∃ ticks last output,output.length=counter.length ∧ binaryValue output+1=binaryValue counter ∧
      Stacks.stackRun program ticks ⟨some (.step .qLoop),v,queryStore raw reader width count (List.replicate (fuel+1) true) counter seen [] [] []⟩=
        some ⟨some (.read .field .qWireRead .unary),last,queryStore raw reader width count (List.replicate fuel true) output seen [] [] []⟩ ∧
      Stacks.stackRunClock program ticks ⟨some (.step .qLoop),v,queryStore raw reader width count (List.replicate (fuel+1) true) counter seen [] [] []⟩≤
        100*(1+counter.length+(fuel+1))^2 := by
  let S0 := queryStore raw reader width count (List.replicate (fuel+1) true) counter seen [] [] []
  let v1 := putGuard v (.next,(true,none),some true)
  obtain ⟨hB,hBC⟩ := goto_phase .qLoop (.guard true .qLoopResult (.counter .borrow)) rfl S0 v
  obtain ⟨guardTicks,output,hlen,hvalue,hG,hGC⟩ := guard_positive true .qLoopResult S0 v rfl hp
  change output.length=counter.length at hlen
  change binaryValue output+1=binaryValue counter at hvalue
  change Stacks.stackRun program guardTicks ⟨some (.guard true .qLoopResult (.counter .borrow)),v,S0⟩=
    some ⟨some (.step .qLoopResult),v1,StackCall.frame (guardCode true) S0 (Parsing.triple output [] (List.replicate fuel true))⟩ at hG
  change _≤20*(1+counter.length+(List.replicate (fuel+1) true).length)^2 at hGC
  simp only [List.length_replicate] at hGC
  rw [guard_frame true S0 output (List.replicate fuel true) rfl] at hG
  simp only [if_true,S0,queryStore_update_wireCount,queryStore_update_fuel] at hG
  obtain ⟨hN,hNC⟩ :=
      query_next (queryStore raw reader width count (List.replicate fuel true) output seen [] [] []) v1 rfl
  have eB : Stacks.Execution program _ _ 1 := ⟨1,hB,hBC.le⟩
  have eG : Stacks.Execution program _ _ _ := ⟨guardTicks,hG,hGC⟩
  have eN : Stacks.Execution program _ _ 1 := ⟨1,hN,hNC.le⟩
  obtain ⟨ticks,hr,hc⟩ := (eB.trans eG).trans eN
  refine ⟨ticks,_,output,hlen,hvalue,hr,hc.trans ?_⟩
  have hp : 1≤(1+counter.length+(fuel+1))^2 := Nat.one_le_pow 2 _ (by omega)
  omega

theorem query_finish (raw reader width count fuel seen : Bits) (v : Local) :
    ∃ ticks last,
      Stacks.stackRun program ticks ⟨some (.step .qFinish),v,queryStore raw reader width count fuel [] seen [] [] []⟩=
        some ⟨some (.step .root),last,rootStore raw reader width count fuel []⟩ ∧
      Stacks.stackRunClock program ticks ⟨some (.step .qFinish),v,queryStore raw reader width count fuel [] seen [] [] []⟩≤
        10*(1+seen.length)^2 := by
  let S := queryStore raw reader width count fuel [] seen [] [] []
  obtain ⟨hB,hBC⟩ := goto_phase .qFinish (.drain .seen .root 0) rfl S v
  obtain ⟨hD,hDC⟩ := drain_call (Label.drain .seen .root) (.step .root) .seen (fun _ => rfl) S v
  have hs : S (some .seen)=seen := rfl
  rw [hs] at hD hDC
  simp only [S,queryStore_update_seen,queryStore_empty] at hD
  have eB : Stacks.Execution program _ _ 1 := ⟨1,hB,hBC.le⟩
  have eD : Stacks.Execution program _ _ _ := ⟨seen.length+1,hD,hDC.le⟩
  obtain ⟨ticks,hr,hc⟩ := eB.trans eD
  exact ⟨ticks,_,hr,hc.trans (by nlinarith only [Nat.zero_le seen.length])⟩

theorem successor_code_length (n : ℕ) : (natBits (n+1)).length≤3*(natBits n).length := by
  have hs := bits_succ_length n
  simp only [natBits_length]
  omega

theorem stream_append (seen : List ℕ) (n : ℕ) :
    NatListFind.stream (seen++[n])=NatListFind.stream seen++natBits n := by
  simp [NatListFind.stream]

theorem stream_member_length (seen : List ℕ) (n : ℕ) (hn : n∈seen) :
    (natBits n).length≤(NatListFind.stream seen).length := by
  induction seen with
  | nil => simp at hn
  | cons a seen ih =>
    rcases List.mem_cons.mp hn with rfl|hn
    · simp only [NatListFind.stream,List.flatMap_cons,List.length_append]
      omega
    · have hh := ih hn
      simp only [NatListFind.stream,List.flatMap_cons,List.length_append] at hh ⊢
      omega

theorem queryStore_cap (raw reader width count fuel counter seen target value field : Bits) (height : ℕ) :
    Cap (queryStore raw reader width count fuel counter seen target value field) height ↔
      raw.length≤height ∧ reader.length≤height ∧ width.length≤height ∧ count.length≤height ∧
        fuel.length≤height ∧ counter.length≤height ∧ seen.length≤height ∧ target.length≤height ∧
        value.length≤height ∧ field.length≤height := by
  constructor
  · intro h
    exact ⟨h .original,h .reader,h .width,h .opCount,h .fuel,h .wireCount,h .seen,h .target,h .value,h .field⟩
  · rintro ⟨hr,hi,hw,hc,hf,hk,hs,ht,hv,hp⟩ bank
    cases bank <;> simp [queryStore,rootStore,hr,hi,hw,hc,hf,hk,hs,ht,hv,hp]

theorem wire_budget (a : ℕ) (tail : Bits) (seen : List ℕ) (fuel height : ℕ)
    (h : 3*(natBits a++tail).length+(NatListFind.stream seen).length+3*(fuel+1)≤height) :
    3*tail.length+(NatListFind.stream (seen++[a+1])).length+3*fuel≤height := by
  have hs := successor_code_length a
  rw [stream_append,List.length_append]
  simp only [List.length_append] at h
  omega

theorem wireStore_cap (raw tail count fuel counter : Bits) (seen : List ℕ) (a width height : ℕ)
    (hr : raw.length≤height) (hw : width.bits.length≤height) (hc : count.length≤height)
    (hk : counter.length≤height) (hf : fuel.length≤height)
    (hb : 3*(natBits a++tail).length+(NatListFind.stream seen).length≤height) :
    Cap (wireStore raw tail width.bits.reverse count fuel counter seen a width) height := by
  have hs := successor_code_length a
  have ha : a.bits.length≤(natBits a).length := by simp only [natBits_length]; omega
  have ht : (a+1).bits.length≤(natBits (a+1)).length := by simp only [natBits_length]; omega
  simp only [List.length_append] at hb
  unfold wireStore
  split_ifs with hlt hmem
  · rw [queryStore_cap]
    have hm := stream_member_length seen (a+1) hmem
    simp only [NatSetInsert.inserted,if_pos hmem,List.length_reverse,List.length_nil]
    omega
  · rw [queryStore_cap]
    simp only [NatSetInsert.inserted,if_neg hmem,stream_append,List.length_append,List.length_reverse,List.length_nil]
    omega
  · rw [queryStore_cap]
    simp only [List.length_reverse,List.length_nil]
    omega

abbrev WireResult := Option (List ℕ×Bits×ℕ×List ℕ)
def wireEnd (result : WireResult) : Label := if result.isSome then .step .root else .step .failure
def WirePost (result : WireResult) (raw width count : Bits) (S : Slot → Bits) : Prop :=
  ∀ wires rest left keys,result=some (wires,rest,left,keys) → S=rootStore raw rest width count (List.replicate left true) []

theorem query_loop (fuel width height : ℕ) (raw reader count counter : Bits) (seen : List ℕ) (v : Local)
    (hraw : raw.length≤height) (hwidth : width.bits.length≤height) (hcount : count.length≤height)
    (hcounter : counter.length≤height)
    (hbudget : 3*reader.length+(NatListFind.stream seen).length+3*fuel≤height) :
    ∃ ticks last T,
      Stacks.stackRun program ticks ⟨some (.step .qLoop),v,
        queryStore raw reader width.bits.reverse count (List.replicate fuel true) counter (NatListFind.stream seen).reverse [] [] []⟩=
        some ⟨some (wireEnd (ValidatorSemantics.readWires fuel (binaryValue counter) width seen reader)),last,T⟩ ∧
      Cap T height ∧ T none=[] ∧
      WirePost (ValidatorSemantics.readWires fuel (binaryValue counter) width seen reader) raw width.bits.reverse count T ∧
      Stacks.stackRunClock program ticks ⟨some (.step .qLoop),v,
        queryStore raw reader width.bits.reverse count (List.replicate fuel true) counter (NatListFind.stream seen).reverse [] [] []⟩≤
          (fuel+1)*20000*(1+3*height)^3 := by
  induction fuel generalizing reader counter seen v with
  | zero =>
    cases hnum : binaryValue counter with
    | zero =>
      obtain ⟨ticks,v1,hZ,hZC⟩ :=
          query_count_zero raw reader width.bits.reverse count counter []
          (NatListFind.stream seen).reverse v hnum
      obtain ⟨finishTicks,v2,hF,hFC⟩ :=
          query_finish raw reader width.bits.reverse count [] (NatListFind.stream seen).reverse v1
      have eZ : Stacks.Execution program _ _ _ := ⟨ticks,hZ,hZC⟩
      have eF : Stacks.Execution program _ _ _ := ⟨finishTicks,hF,hFC⟩
      obtain ⟨total,hr,hc⟩ := eZ.trans eF
      refine ⟨total,v2,rootStore raw reader width.bits.reverse count [] [],?_,?_,rfl,?_,hc.trans ?_⟩
      · simpa [wireEnd,ValidatorSemantics.readWires,hnum] using hr
      · rw [rootStore_cap]
        simp only [List.length_reverse,List.length_nil]
        omega
      · intro wires rest left keys he
        simp only [ValidatorSemantics.readWires,Option.some.injEq,Prod.mk.injEq] at he
        rcases he with ⟨rfl,rfl,rfl,rfl⟩
        rfl
      · simp only [List.length_nil,List.length_reverse,Nat.add_zero,Nat.zero_add,Nat.one_mul]
        nlinarith only [hcounter,hbudget,Nat.zero_le height,Nat.zero_le (height^2),Nat.zero_le (height^3)]
    | succ n =>
      obtain ⟨ticks,v1,output,hlen,hvalue,hr,hc⟩ :=
          query_fuel_empty raw reader width.bits.reverse count counter
          (NatListFind.stream seen).reverse v (by omega)
      refine ⟨ticks,v1,queryStore raw reader width.bits.reverse count [] output (NatListFind.stream seen).reverse [] [] [],?_,?_,rfl,?_,hc.trans ?_⟩
      · simpa [wireEnd,ValidatorSemantics.readWires,hnum] using hr
      · rw [queryStore_cap]
        simp only [List.length_reverse,List.length_nil,hlen]
        omega
      · intro wires rest left keys he
        simp [ValidatorSemantics.readWires] at he
      · change _≤1*20000*(1+3*height)^3
        nlinarith only [hcounter,Nat.zero_le height,Nat.zero_le (height^2),Nat.zero_le (height^3)]
  | succ fuel ih =>
    cases hnum : binaryValue counter with
    | zero =>
      obtain ⟨ticks,v1,hZ,hZC⟩ :=
          query_count_zero raw reader width.bits.reverse count counter
          (List.replicate (fuel+1) true) (NatListFind.stream seen).reverse v hnum
      obtain ⟨finishTicks,v2,hF,hFC⟩ :=
          query_finish raw reader width.bits.reverse count (List.replicate (fuel+1) true)
          (NatListFind.stream seen).reverse v1
      have eZ : Stacks.Execution program _ _ _ := ⟨ticks,hZ,hZC⟩
      have eF : Stacks.Execution program _ _ _ := ⟨finishTicks,hF,hFC⟩
      obtain ⟨total,hr,hc⟩ := eZ.trans eF
      refine ⟨total,v2,rootStore raw reader width.bits.reverse count (List.replicate (fuel+1) true) [],?_,?_,rfl,?_,hc.trans ?_⟩
      · simpa [wireEnd,ValidatorSemantics.readWires,hnum] using hr
      · rw [rootStore_cap]
        simp only [List.length_reverse,List.length_replicate,List.length_nil]
        omega
      · intro wires rest left keys he
        simp only [ValidatorSemantics.readWires,Option.some.injEq,Prod.mk.injEq] at he
        rcases he with ⟨rfl,rfl,rfl,rfl⟩
        rfl
      · have hp : 1≤fuel+1+1 := by omega
        have hb : 100*(1+counter.length+(List.replicate (fuel+1) true).length)^2+10*(1+(NatListFind.stream seen).reverse.length)^2≤20000*(1+3*height)^3 := by
          simp only [List.length_replicate,List.length_reverse]
          nlinarith only [hcounter,hbudget,Nat.zero_le height,Nat.zero_le (height^2),Nat.zero_le (height^3)]
        exact hb.trans
            (by simpa only [Nat.mul_assoc] using Nat.le_mul_of_pos_left (20000*(1+3*height)^3) hp)
    | succ n =>
      obtain ⟨guardTicks,v1,output,hlen,hvalue,hG,hGC⟩ :=
          query_count_positive raw reader width.bits.reverse count counter
          (NatListFind.stream seen).reverse fuel v (by omega)
      have houtput : binaryValue output=n := by omega
      have hcap : Cap (queryStore raw reader width.bits.reverse count (List.replicate fuel true) output (NatListFind.stream seen).reverse [] [] []) height := by
        rw [queryStore_cap]
        simp only [List.length_reverse,List.length_replicate,List.length_nil,hlen]
        omega
      have eG : Stacks.Execution program _ _ _ := ⟨guardTicks,hG,hGC⟩
      cases hn : readNat reader with
      | none =>
        obtain ⟨readTicks,v2,T,hR,hT,hout,hRC⟩ := parsed_failure .field .qWireRead (.compare .field .qWireCompare .start) rfl
          (queryStore raw reader width.bits.reverse count (List.replicate fuel true) output (NatListFind.stream seen).reverse [] [] []) v1 height hcap rfl rfl hn
        have eR : Stacks.Execution program _ _ _ := ⟨readTicks,hR,hRC⟩
        obtain ⟨ticks,hr,hc⟩ := eG.trans eR
        refine ⟨ticks,v2,T,?_,hT,hout,?_,hc.trans ?_⟩
        · simpa [wireEnd,ValidatorSemantics.readWires,hnum,hn] using hr
        · intro wires rest left keys he
          simp [ValidatorSemantics.readWires,hn] at he
        · have hp : 1≤fuel+1+1 := by omega
          have hb : 100*(1+counter.length+(fuel+1))^2+60*(1+height)^2≤20000*(1+3*height)^3 := by
            nlinarith only [hcounter,hbudget,Nat.zero_le height,Nat.zero_le (height^2),Nat.zero_le (height^3)]
          exact hb.trans
              (by simpa only [Nat.mul_assoc] using Nat.le_mul_of_pos_left (20000*(1+3*height)^3) hp)
      | some pair =>
        rcases pair with ⟨a,tail⟩
        have hreader := readNat_sound reader a tail hn
        obtain ⟨wireTicks,v2,hW,hWC⟩ :=
            wire_canonical raw tail count (List.replicate fuel true) output seen a width v1
        rw [← hreader] at hW hWC
        have eW : Stacks.Execution program _ _ _ := ⟨wireTicks,hW,hWC⟩
        by_cases hlegal : a<width ∧ a+1∉seen
        · simp only [if_pos hlegal] at hW
          have hstore : wireStore raw tail width.bits.reverse count (List.replicate fuel true) output seen a width=
              queryStore raw tail width.bits.reverse count (List.replicate fuel true) output (NatListFind.stream (seen++[a+1])).reverse [] [] [] := by
            simp [wireStore,hlegal.1,hlegal.2,NatSetInsert.inserted]
          rw [hstore] at hW
          have hbudget' :=
              wire_budget a tail seen fuel height (by simpa only [← hreader] using hbudget)
          obtain ⟨restTicks,v3,T,hR,hT,hout,hpost,hRC⟩ :=
              ih tail output (seen++[a+1]) v2 (by omega) hbudget'
          have eW : Stacks.Execution program _ _ _ := ⟨wireTicks,hW,hWC⟩
          have eR : Stacks.Execution program _ _ _ := ⟨restTicks,hR,hRC⟩
          obtain ⟨ticks,hr,hc⟩ := (eG.trans eW).trans eR
          have he : ValidatorSemantics.readWires (fuel+1) (n+1) width seen reader=
              (ValidatorSemantics.readWires fuel n width (seen++[a+1]) tail).map
                (fun (ws,rest,left,keys) => (a::ws,rest,left,keys)) := by
            simp only [ValidatorSemantics.readWires,hn,Option.bind_eq_bind,Option.bind_some,if_pos hlegal]
            cases ValidatorSemantics.readWires fuel n width (seen++[a+1]) tail <;> rfl
          refine ⟨ticks,v3,T,?_,hT,hout,?_,hc.trans ?_⟩
          · simpa only [he,wireEnd,Option.isSome_map,houtput] using hr
          · intro wires rest left keys hh
            rw [he] at hh
            obtain ⟨⟨ws,ret,left',keys'⟩,hrec,heq⟩ := Option.map_eq_some_iff.mp hh
            simp only [Prod.mk.injEq] at heq
            rcases heq with ⟨rfl,rfl,rfl,rfl⟩
            exact hpost ws ret left' keys' (by simpa only [houtput] using hrec)
          · have hb : 100*(1+counter.length+(fuel+1))^2+10000*(1+reader.length+width.bits.length+(NatListFind.stream seen).length)^3≤20000*(1+3*height)^3 := by
              have hc1 : 1+counter.length+(fuel+1)≤1+3*height := by omega
              have hc2 := Nat.pow_le_pow_left hc1 2
              have hw1 :
                  1+reader.length+width.bits.length+(NatListFind.stream seen).length≤1+3*height :=
                  by omega
              have hw3 := Nat.pow_le_pow_left hw1 3
              have h23 : (1+3*height)^2≤(1+3*height)^3 :=
                  Nat.pow_le_pow_right (by omega) (by decide)
              nlinarith only [hc2,hw3,h23]
            change _+_+(fuel+1)*20000*(1+3*height)^3≤(fuel+1+1)*20000*(1+3*height)^3
            nlinarith only [hb]
        · simp only [if_neg hlegal] at hW
          have eW : Stacks.Execution program _ _ _ := ⟨wireTicks,hW,hWC⟩
          obtain ⟨ticks,hr,hc⟩ := eG.trans eW
          refine ⟨ticks,v2,wireStore raw tail width.bits.reverse count (List.replicate fuel true) output seen a width,?_,?_,?_,?_,hc.trans ?_⟩
          · simpa [wireEnd,ValidatorSemantics.readWires,hnum,hn,hlegal] using hr
          · apply wireStore_cap raw tail count (List.replicate fuel true) output seen a width height hraw hwidth hcount (by omega)
            · simpa only [List.length_replicate] using (show fuel≤height by omega)
            · rw [← hreader]
              omega
          · unfold wireStore
            split_ifs <;> rfl
          · intro wires rest left keys he
            simp [ValidatorSemantics.readWires,hn,hlegal] at he
          · have hp : 1≤fuel+1+1 := by omega
            have hb : 100*(1+counter.length+(fuel+1))^2+10000*(1+reader.length+width.bits.length+(NatListFind.stream seen).length)^3≤20000*(1+3*height)^3 := by
              have hc1 : 1+counter.length+(fuel+1)≤1+3*height := by omega
              have hc2 := Nat.pow_le_pow_left hc1 2
              have hw1 :
                  1+reader.length+width.bits.length+(NatListFind.stream seen).length≤1+3*height :=
                  by omega
              have hw3 := Nat.pow_le_pow_left hw1 3
              have h23 : (1+3*height)^2≤(1+3*height)^3 :=
                  Nat.pow_le_pow_right (by omega) (by decide)
              nlinarith only [hc2,hw3,h23]
            exact hb.trans
                (by simpa only [Nat.mul_assoc] using Nat.le_mul_of_pos_left (20000*(1+3*height)^3) hp)

theorem query_loop_valid (fuel width height : ℕ) (raw tail count counter : Bits) (seen wires : List ℕ) (v : Local)
    (hraw : raw.length≤height) (hwidth : width.bits.length≤height) (hcount : count.length≤height)
    (hcounter : counter.length≤height) (hnum : binaryValue counter=wires.length)
    (hbudget : 3*(wires.flatMap natBits++tail).length+(NatListFind.stream seen).length+3*fuel≤height)
    (hlegal : ∀ a∈wires,a<width) (hkeys : (seen++wires.map Nat.succ).Nodup) (hfuel : wires.length≤fuel) :
    ∃ ticks last,
      Stacks.stackRun program ticks ⟨some (.step .qLoop),v,
        queryStore raw (wires.flatMap natBits++tail) width.bits.reverse count (List.replicate fuel true) counter (NatListFind.stream seen).reverse [] [] []⟩=
        some ⟨some (.step .root),last,rootStore raw tail width.bits.reverse count (List.replicate (fuel-wires.length) true) []⟩ ∧
      Stacks.stackRunClock program ticks ⟨some (.step .qLoop),v,
        queryStore raw (wires.flatMap natBits++tail) width.bits.reverse count (List.replicate fuel true) counter (NatListFind.stream seen).reverse [] [] []⟩≤
          (fuel+1)*20000*(1+3*height)^3 := by
  obtain ⟨ticks,last,T,hr,_,_,hpost,hc⟩ :=
      query_loop fuel width height raw
      (wires.flatMap natBits++tail) count counter seen v hraw hwidth hcount hcounter hbudget
  have hs := ValidatorSemantics.readWires_complete wires seen tail fuel width hlegal hkeys hfuel
  have he : ValidatorSemantics.readWires fuel (binaryValue counter) width seen (wires.flatMap natBits++tail)=
      some (wires,tail,fuel-wires.length,seen++wires.map Nat.succ) := by simpa only [hnum] using hs
  rw [hpost wires tail (fuel-wires.length) (seen++wires.map Nat.succ) he] at hr
  exact ⟨ticks,last,by simpa [he,wireEnd] using hr,hc⟩

end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.WordValidator

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.WordValidator
open Turing Qatlib.Concepts.BitWordCompiler.CanonicalCodec

inductive FieldRule where | ignore | address | flag

def FieldRule.accepts (rule : FieldRule) (width n : ℕ) : Prop :=
  match rule with | .ignore => True | .address => n<width | .flag => n≤1
instance (rule : FieldRule) (width n : ℕ) : Decidable (rule.accepts width n) := by
  cases rule <;> unfold FieldRule.accepts <;> infer_instance

def fieldRead (rule : FieldRule) (middle next : Phase) : Label :=
  match rule with | .ignore => .drain .field next 0 | .address => .compare .field middle .start | .flag => .tag middle .first

def FieldMiddle (rule : FieldRule) (middle next : Phase) : Prop :=
  match rule with
  | .ignore => True
  | .address => phaseProgram middle=less (.drain .field next 0)
  | .flag => phaseProgram middle=.branch (fun v => decide (v.tagged.1.val≤1)) (go next) (go .failure)

def fieldResult (rule : FieldRule) (width : ℕ) (input : Bits) : Option Bits := do
  let (n,tail) ← readNat input
  if rule.accepts width n then pure tail else none

def fieldEnd (next : Phase) (result : Option Bits) : Label :=
    if result.isSome then .step next else .step .failure

def FieldPost (result : Option Bits) (S T : Slot → Bits) : Prop :=
  ∀ tail,result=some tail → T=Function.update S (some .reader) tail

theorem cap_update (S : Slot → Bits) (height : ℕ) (bank : Work) (bits : Bits)
    (hS : Cap S height) (hb : bits.length≤height) : Cap (Function.update S (some bank) bits) height := by
  intro k
  by_cases he : k=bank
  · subst k
    simpa using hb
  · simpa [Function.update_of_ne (fun h => he (Option.some.inj h))] using hS k

theorem parsed_lengths (input tail : Bits) (n : ℕ) (h : readNat input=some (n,tail)) :
    tail.length≤input.length ∧ n.bits.length≤input.length := by
  rw [readNat_sound input n tail h,List.length_append,natBits_length]
  omega

theorem field_all (rule : FieldRule) (ret middle next : Phase)
    (hread : phaseProgram ret=parsed (fieldRead rule middle next)) (hmiddle : FieldMiddle rule middle next)
    (S : Slot → Bits) (v : Local) (width height : ℕ) (hS : Cap S height)
    (hw : S (some .width)=width.bits.reverse)
    (hm : S (some .tempCount)=[]) (hf : S (some .field)=[])
    (ht : S (some .workCmpTemp)=[]) (hl : S (some .workCmpLeft)=[]) (hr : S (some .workCmpRight)=[]) :
    ∃ ticks last T,
      Stacks.stackRun program ticks ⟨some (.read .field ret .unary),v,S⟩=
        some ⟨some (fieldEnd next (fieldResult rule width (S (some .reader)))),last,T⟩ ∧
      Cap T height ∧ T none=S none ∧ FieldPost (fieldResult rule width (S (some .reader))) S T ∧
      Stacks.stackRunClock program ticks ⟨some (.read .field ret .unary),v,S⟩≤10000*(1+height)^2 := by
  have hi : (S (some .reader)).length≤height := hS .reader
  have hwi : width.bits.length≤height := by simpa only [hw,List.length_reverse] using hS .width
  have hp : 1≤(1+height)^2 := Nat.one_le_pow 2 _ (by omega)
  cases hn : readNat (S (some .reader)) with
  | none =>
    obtain ⟨ticks,last,T,hR,hT,hout,hC⟩ :=
        parsed_failure .field ret (fieldRead rule middle next) hread S v height hS hm hf hn
    refine ⟨ticks,last,T,?_,hT,hout,?_,hC.trans ?_⟩
    · simpa [fieldEnd,fieldResult,hn] using hR
    · intro tail he
      simp [fieldResult,hn] at he
    · omega
  | some pair =>
    rcases pair with ⟨n,tail⟩
    have hinput := readNat_sound (S (some .reader)) n tail hn
    obtain ⟨htail,hbits⟩ := parsed_lengths _ _ _ hn
    have hsmall : Cap (Function.update S (some .reader) tail) height :=
        cap_update S height .reader tail hS (by omega)
    have hfield : Cap (Function.update (Function.update S (some .reader) tail) (some .field) n.bits.reverse) height :=
      cap_update _ height .field n.bits.reverse hsmall (by simpa only [List.length_reverse] using (show n.bits.length≤height by omega))
    cases rule with
    | ignore =>
      obtain ⟨ticks,last,hR,hC⟩ := skip_canonical ret next hread S n tail v hinput hm hf
      refine ⟨ticks,last,Function.update S (some .reader) tail,?_,hsmall,?_,?_,hC.trans ?_⟩
      · simpa [fieldEnd,fieldResult,hn,FieldRule.accepts] using hR
      · simp
      · intro rest he
        simp only [fieldResult,hn,Option.bind_eq_bind,Option.bind_some,FieldRule.accepts,if_true,pure,Option.some.injEq] at he
        subst rest
        rfl
      · have hb := Nat.pow_le_pow_left (show 1+(S (some .reader)).length≤1+height by omega) 2
        nlinarith only [hb]
    | address =>
      by_cases ha : n<width
      · obtain ⟨ticks,last,hR,hC⟩ := address_drained ret middle next hread hmiddle S n width tail v hinput hw hm hf ht hl hr ha
        refine ⟨ticks,last,Function.update S (some .reader) tail,?_,hsmall,?_,?_,hC.trans ?_⟩
        · simpa [fieldEnd,fieldResult,hn,FieldRule.accepts,ha] using hR
        · simp
        · intro rest he
          simp only [fieldResult,hn,Option.bind_eq_bind,Option.bind_some,FieldRule.accepts,if_pos ha,pure,Option.some.injEq] at he
          subst rest
          rfl
        · have hb := Nat.pow_le_pow_left (show 1+(S (some .reader)).length+width.bits.length≤2*(1+height) by omega) 2
          nlinarith only [hb]
      · obtain ⟨ticks,last,hR,hC⟩ := address_canonical ret middle (.drain .field next 0) hread hmiddle S n width tail v hinput hw hm hf ht hl hr
        simp only [if_neg ha] at hR
        refine ⟨ticks,last,Function.update (Function.update S (some .reader) tail) (some .field) n.bits.reverse,?_,hfield,?_,?_,hC.trans ?_⟩
        · simpa [fieldEnd,fieldResult,hn,FieldRule.accepts,ha] using hR
        · simp
        · intro rest he
          simp [fieldResult,hn,FieldRule.accepts,ha] at he
        · have hb := Nat.pow_le_pow_left (show 1+(S (some .reader)).length+width.bits.length≤2*(1+height) by omega) 2
          nlinarith only [hb]
    | flag =>
      obtain ⟨ticks,last,hR,hC⟩ :=
          bool_canonical ret middle next hread hmiddle S n tail v hinput hm hf
      by_cases ha : n≤1
      · rw [if_pos ha,tag_drop_small n (by omega)] at hR
        have hclean : Function.update (Function.update S (some .reader) tail) (some .field) []=Function.update S (some .reader) tail := by
          have he : (Function.update S (some .reader) tail) (some .field)=[] := by simpa using hf
          rw [← he,Function.update_eq_self]
        rw [hclean] at hR
        refine ⟨ticks,last,Function.update S (some .reader) tail,?_,hsmall,?_,?_,hC.trans ?_⟩
        · simpa [fieldEnd,fieldResult,hn,FieldRule.accepts,ha] using hR
        · simp
        · intro rest he
          simp only [fieldResult,hn,Option.bind_eq_bind,Option.bind_some,FieldRule.accepts,if_pos ha,pure,Option.some.injEq] at he
          subst rest
          rfl
        · have hb := Nat.pow_le_pow_left (show 1+(S (some .reader)).length≤1+height by omega) 2
          nlinarith only [hb]
      · simp only [if_neg ha] at hR
        refine ⟨ticks,last,Function.update (Function.update S (some .reader) tail) (some .field) (n.bits.reverse.drop (NatTag.ticks n.bits.reverse)),?_,?_,?_,?_,hC.trans ?_⟩
        · simpa [fieldEnd,fieldResult,hn,FieldRule.accepts,ha] using hR
        · apply cap_update _ height .field _ hsmall
          have hd : (n.bits.reverse.drop (NatTag.ticks n.bits.reverse)).length≤n.bits.length := by
            simp only [List.length_drop,List.length_reverse]
            omega
          omega
        · simp
        · intro rest he
          simp [fieldResult,hn,FieldRule.accepts,ha] at he
        · have hb := Nat.pow_le_pow_left (show 1+(S (some .reader)).length≤1+height by omega) 2
          nlinarith only [hb]
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.WordValidator

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.WordValidator
open Turing Qatlib.Concepts.BitWordCompiler.CanonicalCodec

structure FieldStage where
  rule : FieldRule
  entry : Phase
  ret : Phase
  middle : Phase

def scriptPhase (last : Phase) : List FieldStage → Phase
  | [] => last
  | stage::_ => stage.entry

def ScriptCode (last : Phase) : List FieldStage → Prop
  | [] => True
  | stage::rest =>
      phaseProgram stage.entry=.goto (fun _ => .read .field stage.ret .unary) ∧
      phaseProgram stage.ret=parsed (fieldRead stage.rule stage.middle (scriptPhase last rest)) ∧
      FieldMiddle stage.rule stage.middle (scriptPhase last rest) ∧ ScriptCode last rest

def scriptResult (width : ℕ) : List FieldStage → Bits → Option Bits
  | [],input => some input
  | stage::rest,input => (fieldResult stage.rule width input).bind (scriptResult width rest)

theorem field_script (stages : List FieldStage) (last : Phase) (hcode : ScriptCode last stages)
    (S : Slot → Bits) (v : Local) (width height : ℕ) (hS : Cap S height)
    (hw : S (some .width)=width.bits.reverse)
    (hm : S (some .tempCount)=[]) (hf : S (some .field)=[])
    (ht : S (some .workCmpTemp)=[]) (hl : S (some .workCmpLeft)=[]) (hr : S (some .workCmpRight)=[]) :
    ∃ ticks saved T,
      Stacks.stackRun program ticks ⟨some (.step (scriptPhase last stages)),v,S⟩=
        some ⟨some (fieldEnd last (scriptResult width stages (S (some .reader)))),saved,T⟩ ∧
      Cap T height ∧ T none=S none ∧ FieldPost (scriptResult width stages (S (some .reader))) S T ∧
      Stacks.stackRunClock program ticks ⟨some (.step (scriptPhase last stages)),v,S⟩≤
        stages.length*10001*(1+height)^2 := by
  induction stages generalizing S v with
  | nil =>
    refine ⟨0,v,S,by rfl,hS,rfl,?_,by simp [Stacks.stackRunClock]⟩
    intro tail he
    simp only [scriptResult,Option.some.injEq] at he
    rw [← he,Function.update_eq_self]
  | cons stage stages ih =>
    rcases hcode with ⟨hgo,hread,hmiddle,hrest⟩
    obtain ⟨hB,hBC⟩ := goto_phase stage.entry (.read .field stage.ret .unary) hgo S v
    obtain ⟨fieldTicks,v1,U,hF,hU,hout,hpost,hFC⟩ := field_all stage.rule stage.ret stage.middle (scriptPhase last stages)
      hread hmiddle S v width height hS hw hm hf ht hl hr
    have eB : Stacks.Execution program _ _ 1 := ⟨1,hB,hBC.le⟩
    cases he : fieldResult stage.rule width (S (some .reader)) with
    | none =>
      simp only [he,fieldEnd,Option.isSome_none,Bool.false_eq_true,if_false] at hF
      have eF : Stacks.Execution program _ _ _ := ⟨fieldTicks,hF,hFC⟩
      obtain ⟨ticks,hR,hC⟩ := eB.trans eF
      refine ⟨ticks,v1,U,?_,hU,hout,?_,hC.trans ?_⟩
      · simpa only
          [scriptPhase,scriptResult,he,Option.bind_none,fieldEnd,Option.isSome_none,Bool.false_eq_true,if_false] using hR
      · intro tail hh
        simp [scriptResult,he] at hh
      · have hp : 1≤(1+height)^2 := Nat.one_le_pow 2 _ (by omega)
        simp only [List.length_cons]
        nlinarith only [hp,Nat.zero_le (stages.length*10001*(1+height)^2)]
    | some rest =>
      have hUeq := hpost rest he
      rw [hUeq] at hF
      simp only [he,fieldEnd,Option.isSome_some,if_true] at hF
      have hcap : Cap (Function.update S (some .reader) rest) height := by
        simpa only [← hUeq] using hU
      obtain ⟨restTicks,v2,T,hR,hT,hout2,hpost2,hRC⟩ := ih hrest (Function.update S (some .reader) rest) v1 hcap
        (by simpa using hw) (by simpa using hm) (by simpa using hf) (by simpa using ht) (by simpa using hl) (by simpa using hr)
      have eF : Stacks.Execution program _ _ _ := ⟨fieldTicks,hF,hFC⟩
      have eR : Stacks.Execution program _ _ _ := ⟨restTicks,hR,hRC⟩
      obtain ⟨ticks,hRun,hClock⟩ := (eB.trans eF).trans eR
      refine ⟨ticks,v2,T,?_,hT,?_,?_,hClock.trans ?_⟩
      · simpa only [scriptPhase,scriptResult,he,Option.bind_some,Function.update_self] using hRun
      · simpa using hout2
      · intro tail hh
        simp only [scriptResult,he,Option.bind_some] at hh
        have hh' :
            scriptResult width stages
            ((Function.update S (some .reader) rest) (some .reader))=some tail := by simpa using hh
        rw [hpost2 tail hh',update_twice]
      · have hp : 1≤(1+height)^2 := Nat.one_le_pow 2 _ (by omega)
        simp only [List.length_cons]
        nlinarith only [hp]

def hStages : List FieldStage := [⟨.address,.hAddress,.hResult,.hCompared⟩]
def phaseStages : List FieldStage :=
  [⟨.address,.pFirst,.pFirstResult,.pFirstCompared⟩,⟨.address,.pSecond,.pSecondResult,.pSecondCompared⟩,
    ⟨.ignore,.pPrecision,.pPrecisionResult,.pPrecisionResult⟩,⟨.flag,.pAdj,.pAdjResult,.pAdjCheck⟩]
def swapStages : List FieldStage :=
  [⟨.address,.sFirst,.sFirstResult,.sFirstCompared⟩,⟨.address,.sSecond,.sSecondResult,.sSecondCompared⟩]

theorem hStages_code : ScriptCode .root hStages := by
  simp [ScriptCode,hStages,scriptPhase,fieldRead,FieldMiddle,phaseProgram]

theorem phaseStages_code : ScriptCode .root phaseStages := by
  simp [ScriptCode,phaseStages,scriptPhase,fieldRead,FieldMiddle,phaseProgram,boolTag]

theorem swapStages_code : ScriptCode .root swapStages := by
  simp [ScriptCode,swapStages,scriptPhase,fieldRead,FieldMiddle,phaseProgram]
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.WordValidator

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.WordValidator
open Turing Qatlib.Concepts.BitWordCompiler.CanonicalCodec

theorem order_nat_gt (a width : ℕ) : ReadonlyCompare.order a.bits.reverse width.bits.reverse=.gt ↔ width<a := by
  simp only [ReadonlyCompare.order,List.reverse_reverse,binaryValue_bits]
  split_ifs <;> simp_all
  omega

theorem control_canonical (raw tail count fuel : Bits) (n width : ℕ) (v : Local) :
    ∃ ticks last,
      Stacks.stackRun program ticks ⟨some (.read .target .qControlResult .unary),v,
        queryStore raw (natBits n++tail) width.bits.reverse count fuel [] [] [] [] []⟩=
        some ⟨some (.step (if n≤width then .qAdj else .failure)),last,
          queryStore raw tail width.bits.reverse count fuel []
            (if n≤width then (NatListFind.stream [n]).reverse else [])
            (if n≤width then [] else n.bits.reverse) [] []⟩ ∧
      Stacks.stackRunClock program ticks ⟨some (.read .target .qControlResult .unary),v,
        queryStore raw (natBits n++tail) width.bits.reverse count fuel [] [] [] [] []⟩≤
          10000*(1+(natBits n++tail).length+width.bits.length)^3 := by
  let S0 := queryStore raw (natBits n++tail) width.bits.reverse count fuel [] [] [] [] []
  let S1 := queryStore raw tail width.bits.reverse count fuel [] [] n.bits.reverse [] []
  let v1 := putParse v (true,CheckedNat.lastField n.bits none)
  let v2 := putCompare v1 ((ReadonlyCompare.order n.bits.reverse width.bits.reverse,none,none),none)
  obtain ⟨readTicks,hR,hRC⟩ := read_valid .target .qControlResult S0 v n tail rfl rfl rfl
  rw [read_frame .target S0 tail n.bits.reverse rfl rfl] at hR
  simp only [S0,readBank,queryStore_update_reader,queryStore_update_target] at hR
  obtain ⟨hB,hBC⟩ :=
      parsed_true .qControlResult (.compare .target .qControlCompare .start) rfl S1 v1 rfl
  obtain ⟨compareTicks,hC,hCC⟩ := compare_all .target .qControlCompare S1 v1 rfl rfl rfl
  have ht : S1 (some .target)=n.bits.reverse := rfl
  have hw : S1 (some .width)=width.bits.reverse := rfl
  simp only [ht,hw] at hC hCC
  have hDC : Stacks.stackRunClock program 1 ⟨some (.step .qControlCompare),v2,S1⟩=1 := by
    simp [Stacks.stackRunClock,program,phaseProgram,Stacks.stackClock,go]
  have eR : Stacks.Execution program _ _ _ := ⟨readTicks,hR,hRC⟩
  have eB : Stacks.Execution program _ _ 1 := ⟨1,hB,hBC.le⟩
  have eC : Stacks.Execution program _ _ _ := ⟨compareTicks,hC,hCC⟩
  let B := 1+(natBits n++tail).length+width.bits.length
  have hB : 1≤B := by dsimp [B]; omega
  have h23 : B^2≤B^3 := Nat.pow_le_pow_right (by omega) (by decide)
  have hB3 : 1≤B^3 := Nat.one_le_pow 3 _ hB
  have hraw : 1+(natBits n++tail).length≤B := by dsimp [B]; omega
  have hraw2 := Nat.pow_le_pow_left hraw 2
  have hcmp : 1+n.bits.length+width.bits.length≤B := by
    dsimp [B]
    simp only [List.length_append,natBits_length]
    omega
  have hcmp2 := Nat.pow_le_pow_left hcmp 2
  by_cases hn : n≤width
  · have hgt : ReadonlyCompare.order n.bits.reverse width.bits.reverse≠.gt := by
      intro he
      have hh := (order_nat_gt n width).mp he
      omega
    have hD : Stacks.stackRun program 1 ⟨some (.step .qControlCompare),v2,S1⟩=
        some ⟨some (.insert .qControlInserted (.find .start)),v2,S1⟩ := by
      rw [phase_step]
      simp [phaseProgram,TM2.stepAux,v2,putCompare,hgt]
    obtain ⟨insertTicks,v3,hI,hIC⟩ :=
        insert_candidate .qControlInserted .qAdj rfl raw tail width.bits.reverse count fuel []
        [] n v2
    simp only [List.not_mem_nil,if_false,NatSetInsert.inserted,List.nil_append,NatListFind.stream,List.flatMap_nil] at hI hIC
    have eD : Stacks.Execution program _ _ 1 := ⟨1,hD,hDC.le⟩
    have eI : Stacks.Execution program _ _ _ := ⟨insertTicks,hI,hIC⟩
    obtain ⟨ticks,hr,hc⟩ := (((eR.trans eB).trans eC).trans eD).trans eI
    refine ⟨ticks,v3,?_,hc.trans ?_⟩
    · simpa only [if_pos hn,NatListFind.stream] using hr
    · have hnB : 1+n.bits.length≤B := by omega
      have hn3 := Nat.pow_le_pow_left hnB 3
      simp only [List.length_reverse,List.length_nil,Nat.add_zero] at hc ⊢
      change 50*(1+(natBits n++tail).length)^2+1+100*(1+n.bits.length+width.bits.length)^2+1+6000*(1+n.bits.length)^3≤10000*B^3
      nlinarith only [hraw2,hcmp2,h23,hB3,hn3]
  · have hgt : ReadonlyCompare.order n.bits.reverse width.bits.reverse=.gt := (order_nat_gt n width).mpr (by omega)
    have hD : Stacks.stackRun program 1 ⟨some (.step .qControlCompare),v2,S1⟩=some ⟨some (.step .failure),v2,S1⟩ := by
      rw [phase_step]
      simp [phaseProgram,go,TM2.stepAux,v2,putCompare,hgt]
    have eD : Stacks.Execution program _ _ 1 := ⟨1,hD,hDC.le⟩
    obtain ⟨ticks,hr,hc⟩ := ((eR.trans eB).trans eC).trans eD
    refine ⟨ticks,v2,?_,hc.trans ?_⟩
    · simpa only [if_neg hn] using hr
    · simp only [List.length_reverse]
      change 50*(1+(natBits n++tail).length)^2+1+100*(1+n.bits.length+width.bits.length)^2+1≤10000*B^3
      nlinarith only [hraw2,hcmp2,h23,hB3]
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.WordValidator

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.WordValidator
open Turing Qatlib.Concepts.BitWordCompiler.CanonicalCodec

def controlResult (width : ℕ) (input : Bits) : Option (ℕ×Bits) := do
  let (n,tail) ← readNat input
  if n≤width then pure (n,tail) else none

def controlEnd (result : Option (ℕ×Bits)) : Label :=
    if result.isSome then .step .qAdj else .step .failure

def ControlPost (result : Option (ℕ×Bits)) (raw width count fuel : Bits) (S : Slot → Bits) : Prop :=
  ∀ key tail,result=some (key,tail) →
    S=queryStore raw tail width count fuel [] (NatListFind.stream [key]).reverse [] [] []

theorem control_all (width height : ℕ) (raw reader count fuel : Bits) (v : Local)
    (hraw : raw.length≤height) (hwidth : width.bits.length≤height) (hcount : count.length≤height)
    (hreader : reader.length≤height) (hfuel : fuel.length≤height) :
    ∃ ticks last T,
      Stacks.stackRun program ticks ⟨some (.step .qControl),v,
        queryStore raw reader width.bits.reverse count fuel [] [] [] [] []⟩=
        some ⟨some (controlEnd (controlResult width reader)),last,T⟩ ∧
      Cap T height ∧ T none=[] ∧ ControlPost (controlResult width reader) raw width.bits.reverse count fuel T ∧
      Stacks.stackRunClock program ticks ⟨some (.step .qControl),v,
        queryStore raw reader width.bits.reverse count fuel [] [] [] [] []⟩≤20000*(1+3*height)^3 := by
  let S0 := queryStore raw reader width.bits.reverse count fuel [] [] [] [] []
  have hcap : Cap S0 height := by
    rw [queryStore_cap]
    simp only [List.length_reverse,List.length_nil]
    omega
  obtain ⟨hB,hBC⟩ := goto_phase .qControl (.read .target .qControlResult .unary) rfl S0 v
  have eB : Stacks.Execution program _ _ 1 := ⟨1,hB,hBC.le⟩
  have hH2 : (1+height)^2≤(1+3*height)^3 := by
    have h2 := Nat.pow_le_pow_left (show 1+height≤1+3*height by omega) 2
    exact h2.trans (Nat.pow_le_pow_right (by omega) (by decide))
  have hp : 1≤(1+3*height)^3 := Nat.one_le_pow 3 _ (by omega)
  cases hn : readNat reader with
  | none =>
    obtain ⟨readTicks,v1,T,hR,hT,hout,hRC⟩ :=
        parsed_failure .target .qControlResult
        (.compare .target .qControlCompare .start) rfl S0 v height hcap rfl rfl hn
    have eR : Stacks.Execution program _ _ _ := ⟨readTicks,hR,hRC⟩
    obtain ⟨ticks,hr,hc⟩ := eB.trans eR
    refine ⟨ticks,v1,T,?_,hT,hout,?_,hc.trans ?_⟩
    · simpa [controlEnd,controlResult,hn] using hr
    · intro key tail he
      simp [controlResult,hn] at he
    · nlinarith only [hp,hH2]
  | some pair =>
    rcases pair with ⟨n,tail⟩
    have hi := readNat_sound reader n tail hn
    obtain ⟨htail,hbits⟩ := parsed_lengths _ _ _ hn
    have hencoded : (natBits n).length≤reader.length := by rw [hi,List.length_append]; omega
    obtain ⟨controlTicks,v1,hC,hCC⟩ := control_canonical raw tail count fuel n width v
    rw [← hi] at hC hCC
    have eC : Stacks.Execution program _ _ _ := ⟨controlTicks,hC,hCC⟩
    obtain ⟨ticks,hr,hc⟩ := eB.trans eC
    let T := queryStore raw tail width.bits.reverse count fuel []
      (if n≤width then (NatListFind.stream [n]).reverse else []) (if n≤width then [] else n.bits.reverse) [] []
    refine ⟨ticks,v1,T,?_,?_,?_,?_,hc.trans ?_⟩
    · by_cases he : n≤width <;> simpa [S0,T,controlEnd,controlResult,hn,he] using hr
    · rw [queryStore_cap]
      by_cases he : n≤width
      · simp only [if_pos he,NatListFind.stream,List.flatMap_cons,List.flatMap_nil,List.append_nil,List.length_reverse,List.length_nil]
        omega
      · simp only [if_neg he,List.length_reverse,List.length_nil]
        omega
    · dsimp [T,queryStore,rootStore]
    · intro key rest he
      by_cases hl : n≤width
      · simp only [controlResult,hn,Option.bind_eq_bind,Option.bind_some,if_pos hl,pure,Option.some.injEq,Prod.mk.injEq] at he
        rcases he with ⟨rfl,rfl⟩
        simp only [T,if_pos hl]
      · simp [controlResult,hn,hl] at he
    · have hb : 1+reader.length+width.bits.length≤1+3*height := by omega
      have hb3 := Nat.pow_le_pow_left hb 3
      change 1+10000*(1+reader.length+width.bits.length)^3≤20000*(1+3*height)^3
      nlinarith only [hp,hb3]
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.WordValidator

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.WordValidator
open Turing Qatlib.Concepts.BitWordCompiler.CanonicalCodec

theorem query_count_canonical (raw tail width count fuel seen : Bits) (n : ℕ) (v : Local) :
    ∃ ticks last,
      Stacks.stackRun program ticks ⟨some (.step .qCount),v,
        queryStore raw (natBits n++tail) width count fuel [] seen [] [] []⟩=
        some ⟨some (.step .qLoop),last,queryStore raw tail width count fuel n.bits seen [] [] []⟩ ∧
      Stacks.stackRunClock program ticks ⟨some (.step .qCount),v,
        queryStore raw (natBits n++tail) width count fuel [] seen [] [] []⟩≤100*(1+(natBits n++tail).length)^2 := by
  let S0 := queryStore raw (natBits n++tail) width count fuel [] seen [] [] []
  let S1 := queryStore raw tail width count fuel [] seen [] [] n.bits.reverse
  let v1 := putParse v (true,CheckedNat.lastField n.bits none)
  obtain ⟨hB,hBC⟩ := goto_phase .qCount (.read .field .qCountResult .unary) rfl S0 v
  obtain ⟨readTicks,hR,hRC⟩ := read_valid .field .qCountResult S0 v n tail rfl rfl rfl
  rw [read_frame .field S0 tail n.bits.reverse rfl rfl] at hR
  simp only [S0,readBank,queryStore_update_reader,queryStore_update_field] at hR
  obtain ⟨hP,hPC⟩ := parsed_true .qCountResult (.transfer .fieldToWireCount .qLoop 0) rfl S1 v1 rfl
  obtain ⟨hT,hTC⟩ := transfer_all .fieldToWireCount .qLoop S1 v1
  have hIn : S1 (transferBanks .fieldToWireCount).1=n.bits.reverse := rfl
  have hOut : S1 (transferBanks .fieldToWireCount).2=[] := rfl
  simp only [hOut,List.append_nil] at hT
  rw [transfer_frame_empty .fieldToWireCount S1 hOut] at hT
  simp only [hIn,hOut,List.reverse_reverse,List.length_reverse,List.length_nil,Nat.add_zero] at hT hTC
  simp only [S1,transferBanks,queryStore_update_field,queryStore_update_wireCount] at hT
  have eB : Stacks.Execution program _ _ 1 := ⟨1,hB,hBC.le⟩
  have eR : Stacks.Execution program _ _ _ := ⟨readTicks,hR,hRC⟩
  have eP : Stacks.Execution program _ _ 1 := ⟨1,hP,hPC.le⟩
  have eT : Stacks.Execution program _ _ _ := ⟨n.bits.length+1,hT,hTC.le⟩
  obtain ⟨ticks,hr,hc⟩ := ((eB.trans eR).trans eP).trans eT
  refine ⟨ticks,_,hr,hc.trans ?_⟩
  let B := 1+(natBits n++tail).length
  have hB : 1≤B := by dsimp [B]; omega
  have hn : n.bits.length≤B := by dsimp [B]; simp only [List.length_append,natBits_length]; omega
  have hn2 := Nat.mul_le_mul hn hn
  have hB2 : B≤B^2 := Nat.le_pow (by decide)
  change 1+50*B^2+1+(n.bits.length*(2*n.bits.length+5)+3)≤100*B^2
  nlinarith only [hB,hn,hn2,hB2]

abbrev QueryResult := Option (Bits×ℕ)
def queryEnd (result : QueryResult) : Label := if result.isSome then .step .root else .step .failure
def QueryPost (result : QueryResult) (raw width count : Bits) (S : Slot → Bits) : Prop :=
  ∀ rest left,result=some (rest,left) → S=rootStore raw rest width count (List.replicate left true) []

def countResult (fuel width : ℕ) (seen : List ℕ) (input : Bits) : QueryResult := do
  let (n,tail) ← readNat input
  let (_,rest,left,_) ← ValidatorSemantics.readWires fuel n width seen tail
  pure (rest,left)

theorem query_count_all (fuel width height : ℕ) (raw reader count : Bits) (seen : List ℕ) (v : Local)
    (hraw : raw.length≤height) (hwidth : width.bits.length≤height) (hcount : count.length≤height)
    (hbudget : 3*reader.length+(NatListFind.stream seen).length+3*fuel≤height) :
    ∃ ticks last T,
      Stacks.stackRun program ticks ⟨some (.step .qCount),v,
        queryStore raw reader width.bits.reverse count (List.replicate fuel true) [] (NatListFind.stream seen).reverse [] [] []⟩=
        some ⟨some (queryEnd (countResult fuel width seen reader)),last,T⟩ ∧
      Cap T height ∧ T none=[] ∧ QueryPost (countResult fuel width seen reader) raw width.bits.reverse count T ∧
      Stacks.stackRunClock program ticks ⟨some (.step .qCount),v,
        queryStore raw reader width.bits.reverse count (List.replicate fuel true) [] (NatListFind.stream seen).reverse [] [] []⟩≤
          (fuel+1)*40000*(1+3*height)^3 := by
  let S0 :=
      queryStore raw reader width.bits.reverse count (List.replicate fuel true) []
      (NatListFind.stream seen).reverse [] [] []
  have hcap : Cap S0 height := by
    rw [queryStore_cap]
    simp only [List.length_reverse,List.length_nil,List.length_replicate]
    omega
  have hb : 1+reader.length≤1+3*height := by omega
  have hb2 := Nat.pow_le_pow_left hb 2
  have h23 : (1+3*height)^2≤(1+3*height)^3 := Nat.pow_le_pow_right (by omega) (by decide)
  have hH2 : (1+height)^2≤(1+3*height)^3 :=
      (Nat.pow_le_pow_left (show 1+height≤1+3*height by omega) 2).trans h23
  have hp : 1≤(1+3*height)^3 := Nat.one_le_pow 3 _ (by omega)
  cases hn : readNat reader with
  | none =>
    obtain ⟨hB,hBC⟩ := goto_phase .qCount (.read .field .qCountResult .unary) rfl S0 v
    obtain ⟨readTicks,v1,T,hR,hT,hout,hRC⟩ :=
        parsed_failure .field .qCountResult
        (.transfer .fieldToWireCount .qLoop 0) rfl S0 v height hcap rfl rfl hn
    have eB : Stacks.Execution program _ _ 1 := ⟨1,hB,hBC.le⟩
    have eR : Stacks.Execution program _ _ _ := ⟨readTicks,hR,hRC⟩
    obtain ⟨ticks,hr,hc⟩ := eB.trans eR
    refine ⟨ticks,v1,T,?_,hT,hout,?_,hc.trans ?_⟩
    · simpa [queryEnd,countResult,hn] using hr
    · intro rest left he
      simp [countResult,hn] at he
    · have hb' : 1+60*(1+height)^2≤40000*(1+3*height)^3 := by nlinarith only [hp,hH2]
      exact hb'.trans (by nlinarith only [Nat.zero_le (fuel*(40000*(1+3*height)^3))])
  | some pair =>
    rcases pair with ⟨n,tail⟩
    have hreader := readNat_sound reader n tail hn
    obtain ⟨htail,hbits⟩ := parsed_lengths _ _ _ hn
    obtain ⟨countTicks,v1,hC,hCC⟩ :=
        query_count_canonical raw tail width.bits.reverse count (List.replicate fuel true)
        (NatListFind.stream seen).reverse n v
    rw [← hreader] at hC hCC
    obtain ⟨loopTicks,v2,T,hL,hT,hout,hpost,hLC⟩ :=
        query_loop fuel width height raw tail count n.bits seen v1 hraw hwidth hcount (by omega)
        (by omega)
    have eC : Stacks.Execution program _ _ _ := ⟨countTicks,hC,hCC⟩
    have eL : Stacks.Execution program _ _ _ := ⟨loopTicks,hL,hLC⟩
    obtain ⟨ticks,hr,hc⟩ := eC.trans eL
    have he : countResult fuel width seen reader=(ValidatorSemantics.readWires fuel n width seen tail).map (fun q => (q.2.1,q.2.2.1)) := by
      simp only [countResult,hn,Option.bind_eq_bind,Option.bind_some]
      cases ValidatorSemantics.readWires fuel n width seen tail <;> rfl
    refine ⟨ticks,v2,T,?_,hT,hout,?_,hc.trans ?_⟩
    · simpa only [queryEnd,he,Option.isSome_map,wireEnd,binaryValue_bits] using hr
    · intro rest left hh
      rw [he] at hh
      obtain ⟨⟨ws,ret,left',keys⟩,hrec,heq⟩ := Option.map_eq_some_iff.mp hh
      simp only [Prod.mk.injEq] at heq
      rcases heq with ⟨rfl,rfl⟩
      exact hpost ws ret left' keys (by simpa only [binaryValue_bits] using hrec)
    · change 100*(1+reader.length)^2+(fuel+1)*20000*(1+3*height)^3≤(fuel+1)*40000*(1+3*height)^3
      nlinarith only [hb2,h23,Nat.zero_le (fuel*(20000*(1+3*height)^3))]
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.WordValidator

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.WordValidator
open Turing Qatlib.Concepts.BitWordCompiler.CanonicalCodec

theorem fieldResult_tail_le (rule : FieldRule) (width : ℕ) (input tail : Bits) (h : fieldResult rule width input=some tail) :
    tail.length≤input.length := by
  unfold fieldResult at h
  cases hn : readNat input with
  | none => simp [hn] at h
  | some pair =>
    rcases pair with ⟨n,rest⟩
    simp only [hn,Option.bind_eq_bind,Option.bind_some] at h
    split_ifs at h with hc
    simp only [pure,Option.some.injEq] at h
    subst tail
    exact (parsed_lengths input rest n hn).1

def scriptThen (stages : List FieldStage) (width : ℕ) (more : Bits → QueryResult) (input : Bits) : QueryResult :=
  (scriptResult width stages input).bind more

theorem continue_field_script (stages : List FieldStage) (next : Phase) (hcode : ScriptCode next stages)
    (S : Slot → Bits) (v : Local) (width height : ℕ) (hS : Cap S height) (hout : S none=[])
    (hw : S (some .width)=width.bits.reverse) (hm : S (some .tempCount)=[]) (hf : S (some .field)=[])
    (ht : S (some .workCmpTemp)=[]) (hl : S (some .workCmpLeft)=[]) (hr : S (some .workCmpRight)=[])
    (raw count : Bits) (more : Bits → QueryResult) (budget : ℕ)
    (hmore : ∀ tail,scriptResult width stages (S (some .reader))=some tail → ∀ saved : Local,
      ∃ ticks last T,
        Stacks.stackRun program ticks ⟨some (.step next),saved,Function.update S (some .reader) tail⟩=
          some ⟨some (queryEnd (more tail)),last,T⟩ ∧ Cap T height ∧ T none=[] ∧
        QueryPost (more tail) raw width.bits.reverse count T ∧
        Stacks.stackRunClock program ticks ⟨some (.step next),saved,Function.update S (some .reader) tail⟩≤budget) :
    ∃ ticks last T,
      Stacks.stackRun program ticks ⟨some (.step (scriptPhase next stages)),v,S⟩=
        some ⟨some (queryEnd (scriptThen stages width more (S (some .reader)))),last,T⟩ ∧
      Cap T height ∧ T none=[] ∧ QueryPost (scriptThen stages width more (S (some .reader))) raw width.bits.reverse count T ∧
      Stacks.stackRunClock program ticks ⟨some (.step (scriptPhase next stages)),v,S⟩≤stages.length*10001*(1+height)^2+budget := by
  obtain ⟨fieldTicks,v1,U,hF,hU,hout1,hpost,hFC⟩ :=
      field_script stages next hcode S v width height hS hw hm hf ht hl hr
  cases he : scriptResult width stages (S (some .reader)) with
  | none =>
    refine ⟨fieldTicks,v1,U,?_,hU,hout1.trans hout,?_,hFC.trans (Nat.le_add_right _ _)⟩
    · simpa [scriptThen,he,queryEnd,fieldEnd] using hF
    · intro rest left hh
      simp [scriptThen,he] at hh
  | some tail =>
    rw [hpost tail he] at hF
    simp only [he,fieldEnd,Option.isSome_some,if_true] at hF
    obtain ⟨moreTicks,v2,T,hM,hT,hout2,hpost2,hMC⟩ := hmore tail he v1
    have eF : Stacks.Execution program _ _ _ := ⟨fieldTicks,hF,hFC⟩
    have eM : Stacks.Execution program _ _ _ := ⟨moreTicks,hM,hMC⟩
    obtain ⟨ticks,hR,hC⟩ := eF.trans eM
    refine ⟨ticks,v2,T,?_,hT,hout2,?_,hC⟩
    · simpa only [scriptThen,he,Option.bind_some] using hR
    · simpa only [scriptThen,he,Option.bind_some] using hpost2

def adjStages : List FieldStage := [⟨.flag,.qAdj,.qAdjResult,.qAdjCheck⟩]

theorem adjStages_code : ScriptCode .qCount adjStages := by
  simp [ScriptCode,adjStages,scriptPhase,fieldRead,FieldMiddle,phaseProgram]

def adjResult (fuel width : ℕ) (seen : List ℕ) (input : Bits) : QueryResult :=
  (fieldResult .flag width input).bind (countResult fuel width seen)

theorem query_adj_all (fuel width height : ℕ) (raw reader count : Bits) (seen : List ℕ) (v : Local)
    (hraw : raw.length≤height) (hwidth : width.bits.length≤height) (hcount : count.length≤height)
    (hbudget : 3*reader.length+(NatListFind.stream seen).length+3*fuel≤height) :
    ∃ ticks last T,
      Stacks.stackRun program ticks ⟨some (.step .qAdj),v,
        queryStore raw reader width.bits.reverse count (List.replicate fuel true) [] (NatListFind.stream seen).reverse [] [] []⟩=
        some ⟨some (queryEnd (adjResult fuel width seen reader)),last,T⟩ ∧ Cap T height ∧ T none=[] ∧
      QueryPost (adjResult fuel width seen reader) raw width.bits.reverse count T ∧
      Stacks.stackRunClock program ticks ⟨some (.step .qAdj),v,
        queryStore raw reader width.bits.reverse count (List.replicate fuel true) [] (NatListFind.stream seen).reverse [] [] []⟩≤
          (fuel+1)*60000*(1+3*height)^3 := by
  let S :=
      queryStore raw reader width.bits.reverse count (List.replicate fuel true) []
      (NatListFind.stream seen).reverse [] [] []
  have hcap : Cap S height := by
    rw [queryStore_cap]
    simp only [List.length_reverse,List.length_nil,List.length_replicate]
    omega
  obtain ⟨ticks,last,T,hR,hT,hout,hpost,hC⟩ := continue_field_script adjStages .qCount adjStages_code S v width height hcap rfl rfl rfl rfl rfl rfl rfl raw count
    (countResult fuel width seen) ((fuel+1)*40000*(1+3*height)^3) (by
      intro tail he saved
      have he' : fieldResult .flag width reader=some tail := by
        simpa [scriptResult,adjStages] using! he
      have htlen := fieldResult_tail_le .flag width reader tail he'
      have hb : 3*tail.length+(NatListFind.stream seen).length+3*fuel≤height := by omega
      simpa only [S,queryStore_update_reader] using
          query_count_all fuel width height raw tail count seen saved hraw hwidth hcount hb)
  refine ⟨ticks,last,T,?_,hT,hout,?_,hC.trans ?_⟩
  · simpa [S,scriptThen,scriptResult,adjStages,scriptPhase,adjResult] using! hR
  · simpa [S,scriptThen,scriptResult,adjStages,adjResult] using! hpost
  · have hp : (1+height)^2≤(1+3*height)^3 := by
      have h2 := Nat.pow_le_pow_left (show 1+height≤1+3*height by omega) 2
      exact h2.trans (Nat.pow_le_pow_right (by omega) (by decide))
    change 1*10001*(1+height)^2+(fuel+1)*40000*(1+3*height)^3≤(fuel+1)*60000*(1+3*height)^3
    nlinarith only [hp,Nat.zero_le (fuel*(20000*(1+3*height)^3))]
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.WordValidator

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.WordValidator
open Turing Qatlib.Concepts.BitWordCompiler.CanonicalCodec

theorem controlResult_sound (width n : ℕ) (input tail : Bits) (h : controlResult width input=some (n,tail)) :
    readNat input=some (n,tail) ∧ n≤width := by
  unfold controlResult at h
  cases hn : readNat input with
  | none => simp [hn] at h
  | some pair =>
    rcases pair with ⟨key,rest⟩
    simp only [hn,Option.bind_eq_bind,Option.bind_some] at h
    split_ifs at h with hc
    simp only [pure,Option.some.injEq,Prod.mk.injEq] at h
    rcases h with ⟨rfl,rfl⟩
    exact ⟨rfl,hc⟩

def controlThenResult (fuel width : ℕ) (input : Bits) : QueryResult :=
  (controlResult width input).bind (fun q => adjResult fuel width [q.1] q.2)

theorem query_control_all (fuel width height : ℕ) (raw reader count : Bits) (v : Local)
    (hraw : raw.length≤height) (hwidth : width.bits.length≤height) (hcount : count.length≤height)
    (hbudget : 3*reader.length+3*fuel≤height) :
    ∃ ticks last T,
      Stacks.stackRun program ticks ⟨some (.step .qControl),v,
        queryStore raw reader width.bits.reverse count (List.replicate fuel true) [] [] [] [] []⟩=
        some ⟨some (queryEnd (controlThenResult fuel width reader)),last,T⟩ ∧ Cap T height ∧ T none=[] ∧
      QueryPost (controlThenResult fuel width reader) raw width.bits.reverse count T ∧
      Stacks.stackRunClock program ticks ⟨some (.step .qControl),v,
        queryStore raw reader width.bits.reverse count (List.replicate fuel true) [] [] [] [] []⟩≤
          (fuel+1)*90000*(1+3*height)^3 := by
  obtain ⟨controlTicks,v1,U,hC,hU,hout,hpost,hCC⟩ :=
      control_all width height raw reader count (List.replicate fuel true) v hraw hwidth hcount
      (by omega) (by simp only [List.length_replicate]; omega)
  cases he : controlResult width reader with
  | none =>
    refine ⟨controlTicks,v1,U,?_,hU,hout,?_,hCC.trans ?_⟩
    · simpa [controlThenResult,he,controlEnd,queryEnd] using hC
    · intro rest left hh
      simp [controlThenResult,he] at hh
    · nlinarith only [Nat.zero_le (fuel*(90000*(1+3*height)^3)),Nat.zero_le ((1+3*height)^3)]
  | some pair =>
    rcases pair with ⟨key,tail⟩
    obtain ⟨hn,_⟩ := controlResult_sound width key reader tail he
    have hreader := readNat_sound reader key tail hn
    have hb : 3*tail.length+(NatListFind.stream [key]).length+3*fuel≤height := by
      simp only [NatListFind.stream,List.flatMap_cons,List.flatMap_nil,List.append_nil]
      rw [hreader,List.length_append] at hbudget
      omega
    rw [hpost key tail he] at hC
    simp only [he,controlEnd,Option.isSome_some,if_true] at hC
    obtain ⟨adjTicks,v2,T,hA,hT,hout2,hpost2,hAC⟩ :=
        query_adj_all fuel width height raw tail count [key] v1 hraw hwidth hcount hb
    have eC : Stacks.Execution program _ _ _ := ⟨controlTicks,hC,hCC⟩
    have eA : Stacks.Execution program _ _ _ := ⟨adjTicks,hA,hAC⟩
    obtain ⟨ticks,hr,hc⟩ := eC.trans eA
    refine ⟨ticks,v2,T,?_,hT,hout2,?_,hc.trans ?_⟩
    · simpa only [controlThenResult,he,Option.bind_some] using hr
    · simpa only [controlThenResult,he,Option.bind_some] using hpost2
    · nlinarith only [Nat.zero_le (fuel*(30000*(1+3*height)^3)),Nat.zero_le ((1+3*height)^3)]

def slotStages : List FieldStage := [⟨.ignore,.qSlot,.qSlotResult,.qSlotResult⟩]

theorem slotStages_code : ScriptCode .qControl slotStages := by
  simp [ScriptCode,slotStages,scriptPhase,fieldRead,FieldMiddle,phaseProgram]

def queryResult (fuel width : ℕ) (input : Bits) : QueryResult :=
  (fieldResult .ignore width input).bind (controlThenResult fuel width)

theorem query_all (fuel width height : ℕ) (raw reader count : Bits) (v : Local)
    (hraw : raw.length≤height) (hwidth : width.bits.length≤height) (hcount : count.length≤height)
    (hbudget : 3*reader.length+3*fuel≤height) :
    ∃ ticks last T,
      Stacks.stackRun program ticks ⟨some (.step .qSlot),v,rootStore raw reader width.bits.reverse count (List.replicate fuel true) []⟩=
        some ⟨some (queryEnd (queryResult fuel width reader)),last,T⟩ ∧ Cap T height ∧ T none=[] ∧
      QueryPost (queryResult fuel width reader) raw width.bits.reverse count T ∧
      Stacks.stackRunClock program ticks ⟨some (.step .qSlot),v,rootStore raw reader width.bits.reverse count (List.replicate fuel true) []⟩≤
          (fuel+1)*110000*(1+3*height)^3 := by
  let S := queryStore raw reader width.bits.reverse count (List.replicate fuel true) [] [] [] [] []
  have hcap : Cap S height := by
    rw [queryStore_cap]
    simp only [List.length_reverse,List.length_nil,List.length_replicate]
    omega
  obtain ⟨ticks,last,T,hR,hT,hout,hpost,hC⟩ := continue_field_script slotStages .qControl slotStages_code S v width height hcap rfl rfl rfl rfl rfl rfl rfl raw count
    (controlThenResult fuel width) ((fuel+1)*90000*(1+3*height)^3) (by
      intro tail he saved
      have he' : fieldResult .ignore width reader=some tail := by
        simpa [scriptResult,slotStages] using! he
      have htlen := fieldResult_tail_le .ignore width reader tail he'
      have hb : 3*tail.length+3*fuel≤height := by omega
      simpa only [S,queryStore_update_reader] using
          query_control_all fuel width height raw tail count saved hraw hwidth hcount hb)
  refine ⟨ticks,last,T,?_,hT,hout,?_,?_⟩
  · simpa [S,queryStore_empty,scriptThen,scriptResult,slotStages,scriptPhase,queryResult] using! hR
  · simpa [S,scriptThen,scriptResult,slotStages,queryResult] using! hpost
  · have hp : (1+height)^2≤(1+3*height)^3 := by
      have h2 := Nat.pow_le_pow_left (show 1+height≤1+3*height by omega) 2
      exact h2.trans (Nat.pow_le_pow_right (by omega) (by decide))
    have hc : 1*10001*(1+height)^2+(fuel+1)*90000*(1+3*height)^3≤(fuel+1)*110000*(1+3*height)^3 := by
      nlinarith only [hp,Nat.zero_le (fuel*(20000*(1+3*height)^3))]
    simpa only [S,queryStore_empty,slotStages,List.length_cons,List.length_nil] using! hC.trans hc
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.WordValidator

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.WordValidator
open Turing Qatlib.Concepts.BitWordCompiler.CanonicalCodec

theorem fieldResult_spec (rule : FieldRule) (width : ℕ) (input tail : Bits) :
    fieldResult rule width input=some tail ↔ ∃ n,readNat input=some (n,tail) ∧ rule.accepts width n := by
  unfold fieldResult
  cases hn : readNat input with
  | none => simp
  | some pair =>
    rcases pair with ⟨n,rest⟩
    simp only [Option.bind_eq_bind,Option.bind_some]
    by_cases hc : rule.accepts width n <;> simp [hc,Prod.mk.injEq]

def queryBody (slot : ℕ) (control : Option ℕ) (adjoint : Bool) (wires : List ℕ) : Bits :=
  [slot,controlKey control,if adjoint then 1 else 0,wires.length].flatMap natBits++wires.flatMap natBits

theorem query_body_bits (slot : ℕ) (control : Option ℕ) (adjoint : Bool) (wires : List ℕ) :
    opBits (.oracle slot control adjoint wires)=natBits 3++queryBody slot control adjoint wires := by
  cases control <;> simp [opBits,fields,queryBody,controlKey,List.append_assoc]

theorem queryResult_complete (slot : ℕ) (control : Option ℕ) (adjoint : Bool) (wires : List ℕ)
    (tail : Bits) (fuel width : ℕ) (hlegal : legalOpcode width (.oracle slot control adjoint wires)) (hfuel : wires.length≤fuel) :
    queryResult fuel width (queryBody slot control adjoint wires++tail)=some (tail,fuel-wires.length) := by
  obtain ⟨hw,hc,hkeys⟩ := (oracle_legal_keys width slot control adjoint wires).mp hlegal
  have hkeys' : ([controlKey control]++wires.map Nat.succ).Nodup := by
    simpa only [List.singleton_append] using hkeys
  have hW :=
      ValidatorSemantics.readWires_complete wires
      [controlKey control] tail fuel width hw hkeys' hfuel
  cases adjoint <;>
    simp [queryBody,queryResult,fieldResult,FieldRule.accepts,controlThenResult,controlResult,
      adjResult,countResult,List.append_assoc,readNat_complete,hc,hW]

theorem key_roundtrip (key : ℕ) : controlKey (optionNatEquiv key)=key := by cases key <;> rfl

theorem queryResult_sound (fuel width : ℕ) (input tail : Bits) (left : ℕ)
    (h : queryResult fuel width input=some (tail,left)) :
    ∃ slot control adjoint wires,
      legalOpcode width (.oracle slot control adjoint wires) ∧
      input=queryBody slot control adjoint wires++tail ∧ wires.length+left=fuel := by
  unfold queryResult at h
  obtain ⟨afterSlot,hslot,h⟩ := Option.bind_eq_some_iff.mp h
  obtain ⟨slot,hslot,_⟩ := (fieldResult_spec .ignore width input afterSlot).mp hslot
  unfold controlThenResult at h
  obtain ⟨⟨key,afterControl⟩,hcontrol,h⟩ := Option.bind_eq_some_iff.mp h
  obtain ⟨hcontrol,hkey⟩ := controlResult_sound width key afterSlot afterControl hcontrol
  unfold adjResult at h
  obtain ⟨afterAdj,hadj,h⟩ := Option.bind_eq_some_iff.mp h
  obtain ⟨flag,hadj,hflag⟩ := (fieldResult_spec .flag width afterControl afterAdj).mp hadj
  change flag≤1 at hflag
  unfold countResult at h
  obtain ⟨⟨count,afterCount⟩,hcount,h⟩ := Option.bind_eq_some_iff.mp h
  obtain ⟨⟨wires,rest,left',keys⟩,hwires,h⟩ := Option.bind_eq_some_iff.mp h
  simp only [pure,Option.some.injEq,Prod.mk.injEq] at h
  rcases h with ⟨rfl,rfl⟩
  obtain ⟨hlen,hbounds,hinput,hfuel,hkeys,hnd⟩ :=
      ValidatorSemantics.readWires_sound fuel count width
      [key] afterCount wires rest left' keys hwires
  let control := optionNatEquiv key
  let adjoint : Bool := decide (flag=1)
  have hk : controlKey control=key := key_roundtrip key
  have ha : (if adjoint then 1 else 0 : ℕ)=flag := by
    by_cases he : flag=1
    · simp [adjoint,he]
    · simp [adjoint,he]
      omega
  have hnodup : (controlKey control::wires.map Nat.succ).Nodup := by
    have hs := hnd (by simp)
    simpa only [hkeys,List.singleton_append,hk] using hs
  refine ⟨slot,control,adjoint,wires,(oracle_legal_keys width slot control adjoint wires).mpr ⟨hbounds,by simpa only [hk] using hkey,hnodup⟩,?_,hfuel⟩
  rw [readNat_sound input slot afterSlot hslot,readNat_sound afterSlot key afterControl hcontrol,
    readNat_sound afterControl flag afterAdj hadj,readNat_sound afterAdj count afterCount hcount,hinput]
  simp only [queryBody,List.flatMap_cons,List.flatMap_nil,List.append_nil,hk,ha,hlen,List.append_assoc]
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.WordValidator

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.WordValidator
open Turing Qatlib.Concepts.BitWordCompiler.CanonicalCodec

def opcodeTag : Opcode → ℕ
  | .hadamard _ => 0
  | .phase _ _ _ _ => 1
  | .swap _ _ => 2
  | .oracle _ _ _ _ => 3

def bodyBits (op : Opcode) : Bits := (fields op).tail.flatMap natBits

theorem opBits_tag_body (op : Opcode) : opBits op=natBits (opcodeTag op)++bodyBits op := by
  cases op <;> rfl

def bodyResult (fuel width : ℕ) : ℕ → Bits → QueryResult
  | 0,input => (scriptResult width hStages input).map (fun rest => (rest,fuel))
  | 1,input => (scriptResult width phaseStages input).map (fun rest => (rest,fuel))
  | 2,input => (scriptResult width swapStages input).map (fun rest => (rest,fuel))
  | 3,input => queryResult fuel width input
  | _,_ => none

theorem bodyResult_complete (op : Opcode) (tail : Bits) (fuel width : ℕ)
    (hlegal : legalOpcode width op) (hfuel : ValidatorSemantics.opFuel op≤fuel) :
    bodyResult fuel width (opcodeTag op) (bodyBits op++tail)=some (tail,fuel-ValidatorSemantics.opFuel op) := by
  cases op with
  | hadamard a =>
    simp [bodyResult,opcodeTag,bodyBits,fields,scriptResult,hStages,fieldResult,FieldRule.accepts,
      readNat_complete,show a<width from hlegal,ValidatorSemantics.opFuel]
  | phase a b k adjoint =>
    obtain ⟨ha,hb⟩ := hlegal
    cases adjoint <;>
      simp [bodyResult,opcodeTag,bodyBits,fields,scriptResult,phaseStages,fieldResult,FieldRule.accepts,
        List.append_assoc,readNat_complete,ha,hb,ValidatorSemantics.opFuel]
  | swap a b =>
    obtain ⟨ha,hb⟩ := hlegal
    simp [bodyResult,opcodeTag,bodyBits,fields,scriptResult,swapStages,fieldResult,FieldRule.accepts,
      List.append_assoc,readNat_complete,ha,hb,ValidatorSemantics.opFuel]
  | oracle slot control adjoint wires =>
    have he : bodyBits (.oracle slot control adjoint wires)=queryBody slot control adjoint wires := by
      cases control <;> simp [bodyBits,fields,queryBody,controlKey]
    simpa only [opcodeTag,bodyResult,he,ValidatorSemantics.opFuel] using
      queryResult_complete slot control adjoint wires tail fuel width hlegal hfuel

theorem nonquery_sound (width tag : ℕ) (input tail : Bits) (htag : tag<3)
    (h : scriptResult width (if tag=0 then hStages else if tag=1 then phaseStages else swapStages) input=some tail) :
    ∃ op,opcodeTag op=tag ∧ legalOpcode width op ∧ input=bodyBits op++tail ∧ ValidatorSemantics.opFuel op=0 := by
  rcases tag with _|_|tag
  · have h' : fieldResult .address width input=some tail := by simpa [scriptResult,hStages] using h
    obtain ⟨a,ha,hlegal⟩ := (fieldResult_spec .address width input tail).mp h'
    refine ⟨.hadamard a,rfl,hlegal,?_,rfl⟩
    simpa [bodyBits,fields] using readNat_sound input a tail ha
  · have h' := h
    simp only [show (1:ℕ)≠0 by decide,if_false,if_true,phaseStages,scriptResult] at h'
    obtain ⟨afterA,ha,h'⟩ := Option.bind_eq_some_iff.mp h'
    obtain ⟨afterB,hb,h'⟩ := Option.bind_eq_some_iff.mp h'
    obtain ⟨afterK,hk,h'⟩ := Option.bind_eq_some_iff.mp h'
    have hadj : fieldResult .flag width afterK=some tail := by simpa using h'
    obtain ⟨a,ha,hla⟩ := (fieldResult_spec .address width input afterA).mp ha
    obtain ⟨b,hb,hlb⟩ := (fieldResult_spec .address width afterA afterB).mp hb
    obtain ⟨k,hk,_⟩ := (fieldResult_spec .ignore width afterB afterK).mp hk
    obtain ⟨flag,hflag,hsmall⟩ := (fieldResult_spec .flag width afterK tail).mp hadj
    change flag≤1 at hsmall
    let adjoint : Bool := decide (flag=1)
    have hflagval : (if adjoint then 1 else 0 : ℕ)=flag := by
      by_cases he : flag=1
      · simp [adjoint,he]
      · simp [adjoint,he]
        omega
    refine ⟨.phase a b k adjoint,rfl,⟨hla,hlb⟩,?_,rfl⟩
    rw [readNat_sound input a afterA ha,readNat_sound afterA b afterB hb,
      readNat_sound afterB k afterK hk,readNat_sound afterK flag tail hflag]
    simp only [bodyBits,fields,List.tail_cons,List.flatMap_cons,List.flatMap_nil,List.append_nil,hflagval,List.append_assoc]
  · have htag2 : tag=0 := by omega
    subst tag
    have h' := h
    simp only [show (2:ℕ)≠0 by decide,show (2:ℕ)≠1 by decide,if_false,swapStages,scriptResult] at h'
    obtain ⟨afterA,ha,h'⟩ := Option.bind_eq_some_iff.mp h'
    have hb : fieldResult .address width afterA=some tail := by simpa using h'
    obtain ⟨a,ha,hla⟩ := (fieldResult_spec .address width input afterA).mp ha
    obtain ⟨b,hb,hlb⟩ := (fieldResult_spec .address width afterA tail).mp hb
    refine ⟨.swap a b,rfl,⟨hla,hlb⟩,?_,rfl⟩
    rw [readNat_sound input a afterA ha,readNat_sound afterA b tail hb]
    simp only [bodyBits,fields,List.tail_cons,List.flatMap_cons,List.flatMap_nil,List.append_nil,List.append_assoc]

theorem bodyResult_sound (fuel width tag : ℕ) (input tail : Bits) (left : ℕ)
    (h : bodyResult fuel width tag input=some (tail,left)) :
    ∃ op,opcodeTag op=tag ∧ legalOpcode width op ∧ input=bodyBits op++tail ∧ ValidatorSemantics.opFuel op+left=fuel := by
  by_cases htag : tag<3
  · have hm : (scriptResult width (if tag=0 then hStages else if tag=1 then phaseStages else swapStages) input).map (fun rest => (rest,fuel))=some (tail,left) := by
      rcases tag with _|_|_|tag <;> first | exact h | omega
    obtain ⟨rest,hr,heq⟩ := Option.map_eq_some_iff.mp hm
    simp only [Prod.mk.injEq] at heq
    rcases heq with ⟨rfl,rfl⟩
    obtain ⟨op,hcode,hlegal,hbits,hzero⟩ := nonquery_sound width tag input rest htag hr
    exact ⟨op,hcode,hlegal,hbits,by omega⟩
  · by_cases he : tag=3
    · subst tag
      obtain ⟨slot,control,adjoint,wires,hlegal,hbits,hfuel⟩ :=
          queryResult_sound fuel width input tail left h
      refine ⟨.oracle slot control adjoint wires,rfl,hlegal,?_,hfuel⟩
      have hbody : bodyBits (.oracle slot control adjoint wires)=queryBody slot control adjoint wires := by
        cases control <;> simp [bodyBits,fields,queryBody,controlKey]
      simpa only [hbody] using hbits
    · have hnone : bodyResult fuel width tag input=none := by
        rcases tag with _|_|_|_|tag <;> first | rfl | omega
      rw [hnone] at h
      cases h
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.WordValidator

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.WordValidator
open Turing Qatlib.Concepts.BitWordCompiler.CanonicalCodec

def opResult (fuel width : ℕ) (input : Bits) : QueryResult := do
  let (tag,tail) ← readNat input
  bodyResult fuel width tag tail

theorem opResult_complete (op : Opcode) (tail : Bits) (fuel width : ℕ)
    (hlegal : legalOpcode width op) (hfuel : ValidatorSemantics.opFuel op≤fuel) :
    opResult fuel width (opBits op++tail)=some (tail,fuel-ValidatorSemantics.opFuel op) := by
  rw [opBits_tag_body,List.append_assoc]
  simp only [opResult,readNat_complete,Option.bind_eq_bind,Option.bind_some]
  exact bodyResult_complete op tail fuel width hlegal hfuel

theorem opResult_sound (fuel width : ℕ) (input tail : Bits) (left : ℕ)
    (h : opResult fuel width input=some (tail,left)) :
    ∃ op,legalOpcode width op ∧ input=opBits op++tail ∧ ValidatorSemantics.opFuel op+left=fuel := by
  unfold opResult at h
  obtain ⟨⟨tag,rest⟩,htag,hbody⟩ := Option.bind_eq_some_iff.mp h
  obtain ⟨op,hcode,hlegal,hinput,hfuel⟩ := bodyResult_sound fuel width tag rest tail left hbody
  refine ⟨op,hlegal,?_,hfuel⟩
  rw [readNat_sound input tag rest htag,hinput,opBits_tag_body,hcode,List.append_assoc]

theorem opResult_eq (fuel width : ℕ) (input : Bits) :
    opResult fuel width input=(ValidatorSemantics.readOp fuel width input).map (fun q => (q.2.1,q.2.2)) := by
  cases h : opResult fuel width input with
  | none =>
    cases hr : ValidatorSemantics.readOp fuel width input with
    | none => rfl
    | some triple =>
      rcases triple with ⟨op,tail,left⟩
      obtain ⟨hlegal,hinput,hfuel⟩ :=
          ValidatorSemantics.readOp_sound fuel width input op tail left hr
      have hp : ValidatorSemantics.opFuel op≤fuel := by omega
      have he := opResult_complete op tail fuel width hlegal hp
      rw [← hinput,h] at he
      cases he
  | some pair =>
    rcases pair with ⟨tail,left⟩
    obtain ⟨op,hlegal,hinput,hfuel⟩ := opResult_sound fuel width input tail left h
    have hp : ValidatorSemantics.opFuel op≤fuel := by omega
    have hl : fuel-ValidatorSemantics.opFuel op=left := by omega
    have hr := ValidatorSemantics.readOp_complete op tail fuel width hlegal hp
    rw [← hinput,hl] at hr
    rw [hr]
    rfl

end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.WordValidator

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.WordValidator
open Turing Qatlib.Concepts.BitWordCompiler.CanonicalCodec

def nonqueryStages (tag : ℕ) : List FieldStage :=
    if tag=0 then hStages else if tag=1 then phaseStages else swapStages

theorem nonqueryStages_code (tag : ℕ) (ht : tag<3) : ScriptCode .root (nonqueryStages tag) := by
  rcases tag with _|_|_|tag
  · exact hStages_code
  · exact phaseStages_code
  · exact swapStages_code
  · omega

theorem nonqueryStages_entry (tag : ℕ) (ht : tag<3) : scriptPhase .root (nonqueryStages tag)=opcodePhase tag := by
  rcases tag with _|_|_|tag <;> first | rfl | omega

theorem nonqueryStages_length (tag : ℕ) : (nonqueryStages tag).length≤4 := by
  unfold nonqueryStages
  split_ifs <;> decide

theorem nonqueryResult_eq (fuel width tag : ℕ) (ht : tag<3) (input : Bits) :
    bodyResult fuel width tag input=(scriptResult width (nonqueryStages tag) input).map (fun tail => (tail,fuel)) := by
  rcases tag with _|_|_|tag <;> first | rfl | omega

theorem body_all (fuel width height tag : ℕ) (raw reader count : Bits) (v : Local) (htag : tag<4)
    (hraw : raw.length≤height) (hwidth : width.bits.length≤height) (hcount : count.length≤height)
    (hbudget : 3*reader.length+3*fuel≤height) :
    ∃ ticks last T,
      Stacks.stackRun program ticks ⟨some (.step (opcodePhase tag)),v,rootStore raw reader width.bits.reverse count (List.replicate fuel true) []⟩=
        some ⟨some (queryEnd (bodyResult fuel width tag reader)),last,T⟩ ∧ Cap T height ∧ T none=[] ∧
      QueryPost (bodyResult fuel width tag reader) raw width.bits.reverse count T ∧
      Stacks.stackRunClock program ticks ⟨some (.step (opcodePhase tag)),v,rootStore raw reader width.bits.reverse count (List.replicate fuel true) []⟩≤
          (fuel+1)*110000*(1+3*height)^3 := by
  by_cases hs : tag<3
  · let S := rootStore raw reader width.bits.reverse count (List.replicate fuel true) []
    have hcap : Cap S height := by
      rw [rootStore_cap]
      simp only [List.length_reverse,List.length_replicate,List.length_nil]
      omega
    obtain ⟨ticks,last,T,hR,hT,hout,hpost,hC⟩ :=
        field_script (nonqueryStages tag) .root
        (nonqueryStages_code tag hs) S v width height hcap rfl rfl rfl rfl rfl rfl
    refine ⟨ticks,last,T,?_,hT,hout,?_,?_⟩
    · simpa only
        [nonqueryResult_eq fuel width tag hs reader,queryEnd,Option.isSome_map,fieldEnd,S,nonqueryStages_entry tag hs] using! hR
    · intro tail left he
      rw [nonqueryResult_eq fuel width tag hs reader] at he
      obtain ⟨rest,hrec,heq⟩ := Option.map_eq_some_iff.mp he
      simp only [Prod.mk.injEq] at heq
      rcases heq with ⟨rfl,rfl⟩
      have ht : scriptResult width (nonqueryStages tag) (S (some .reader))=some rest := hrec
      simpa only [S,rootStore_update_reader] using hpost rest ht
    · have hlen := nonqueryStages_length tag
      have hB2 : (1+height)^2≤(1+3*height)^3 := by
        have h2 := Nat.pow_le_pow_left (show 1+height≤1+3*height by omega) 2
        exact h2.trans (Nat.pow_le_pow_right (by omega) (by decide))
      have hC' : (nonqueryStages tag).length*10001*(1+height)^2≤(fuel+1)*110000*(1+3*height)^3 := by
        have hh := Nat.mul_le_mul_right (10001*(1+height)^2) hlen
        nlinarith only [hh,hB2,Nat.zero_le (fuel*(110000*(1+3*height)^3))]
      simpa only [S,nonqueryStages_entry tag hs] using hC.trans hC'
  · have ht : tag=3 := by omega
    subst tag
    exact query_all fuel width height raw reader count v hraw hwidth hcount hbudget
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.WordValidator

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.WordValidator
open Turing Qatlib.Concepts.BitWordCompiler.CanonicalCodec

theorem bodyResult_large (fuel width tag : ℕ) (input : Bits) (htag : 4≤tag) : bodyResult fuel width tag input=none := by
  rcases tag with _|_|_|_|tag <;> first | rfl | omega

theorem opcodePhase_large (tag : ℕ) (htag : 4≤tag) : opcodePhase tag=.failure := by
  rcases tag with _|_|_|_|tag <;> first | rfl | omega

theorem op_all (fuel width height : ℕ) (raw reader count : Bits) (v : Local)
    (hraw : raw.length≤height) (hwidth : width.bits.length≤height) (hcount : count.length≤height)
    (hbudget : 3*reader.length+3*fuel≤height) :
    ∃ ticks last T,
      Stacks.stackRun program ticks ⟨some (.read .field .afterOpTag .unary),v,
        rootStore raw reader width.bits.reverse count (List.replicate fuel true) []⟩=
        some ⟨some (queryEnd (opResult fuel width reader)),last,T⟩ ∧ Cap T height ∧ T none=[] ∧
      QueryPost (opResult fuel width reader) raw width.bits.reverse count T ∧
      Stacks.stackRunClock program ticks ⟨some (.read .field .afterOpTag .unary),v,
        rootStore raw reader width.bits.reverse count (List.replicate fuel true) []⟩≤
          (fuel+1)*120000*(1+3*height)^3 := by
  let S0 := rootStore raw reader width.bits.reverse count (List.replicate fuel true) []
  have hcap : Cap S0 height := by
    rw [rootStore_cap]
    simp only [List.length_reverse,List.length_nil,List.length_replicate]
    omega
  have hH2 : (1+height)^2≤(1+3*height)^3 := by
    have h2 := Nat.pow_le_pow_left (show 1+height≤1+3*height by omega) 2
    exact h2.trans (Nat.pow_le_pow_right (by omega) (by decide))
  have hR2 : (1+reader.length)^2≤(1+3*height)^3 := by
    have h2 := Nat.pow_le_pow_left (show 1+reader.length≤1+3*height by omega) 2
    exact h2.trans (Nat.pow_le_pow_right (by omega) (by decide))
  cases hn : readNat reader with
  | none =>
    obtain ⟨ticks,last,T,hR,hT,hout,hC⟩ :=
        parsed_failure .field .afterOpTag (.tag .dispatch .first) rfl S0 v height hcap rfl rfl hn
    refine ⟨ticks,last,T,?_,hT,hout,?_,hC.trans ?_⟩
    · simpa [opResult,hn,queryEnd] using hR
    · intro rest left he
      simp [opResult,hn] at he
    · nlinarith only [hH2,Nat.zero_le (fuel*(120000*(1+3*height)^3)),Nat.zero_le ((1+3*height)^3)]
  | some pair =>
    rcases pair with ⟨tag,tail⟩
    have hreader := readNat_sound reader tag tail hn
    obtain ⟨htail,hbits⟩ := parsed_lengths _ _ _ hn
    obtain ⟨tagTicks,v1,hP,hPC⟩ := opcode_canonical S0 tag tail v hreader rfl rfl
    simp only [S0,rootStore_update_reader,rootStore_update_field] at hP
    change _≤110*(1+reader.length)^2 at hPC
    by_cases ht : tag<4
    · rw [tag_drop_small tag ht] at hP
      obtain ⟨bodyTicks,v2,T,hB,hT,hout,hpost,hBC⟩ :=
          body_all fuel width height tag raw tail count v1 ht hraw hwidth hcount (by omega)
      have eP : Stacks.Execution program _ _ _ := ⟨tagTicks,hP,hPC⟩
      have eB : Stacks.Execution program _ _ _ := ⟨bodyTicks,hB,hBC⟩
      obtain ⟨ticks,hR,hC⟩ := eP.trans eB
      refine ⟨ticks,v2,T,?_,hT,hout,?_,hC.trans ?_⟩
      · simpa only [opResult,hn,Option.bind_eq_bind,Option.bind_some] using hR
      · simpa only [opResult,hn,Option.bind_eq_bind,Option.bind_some] using hpost
      · nlinarith only [hR2,Nat.zero_le (fuel*(10000*(1+3*height)^3))]
    · have hlarge : 4≤tag := by omega
      rw [opcodePhase_large tag hlarge] at hP
      let T :=
          rootStore raw tail width.bits.reverse count (List.replicate fuel true)
          (tag.bits.reverse.drop (NatTag.ticks tag.bits.reverse))
      refine ⟨tagTicks,v1,T,?_,?_,rfl,?_,hPC.trans ?_⟩
      · simpa only
          [opResult,hn,Option.bind_eq_bind,Option.bind_some,bodyResult_large fuel width tag tail hlarge,queryEnd,Option.isSome_none,Bool.false_eq_true,if_false] using hP
      · rw [rootStore_cap]
        simp only [List.length_reverse,List.length_replicate,List.length_drop]
        omega
      · intro rest left he
        simp [opResult,hn,bodyResult_large fuel width tag tail hlarge] at he
      · nlinarith only [hR2,Nat.zero_le (fuel*(120000*(1+3*height)^3)),Nat.zero_le ((1+3*height)^3)]
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.WordValidator

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.WordValidator
open Turing Qatlib.Concepts.BitWordCompiler.CanonicalCodec

def opsResult (fuel count width : ℕ) (input : Bits) : QueryResult :=
  (ValidatorSemantics.readOps fuel count width input).map (fun q => (q.2.1,q.2.2))

theorem opsResult_step (fuel count width : ℕ) (input : Bits) :
    opsResult (fuel+1) (count+1) width input=
      (opResult fuel width input).bind (fun q => opsResult q.2 count width q.1) := by
  rw [opResult_eq]
  cases hr : ValidatorSemantics.readOp fuel width input with
  | none => simp [opsResult,ValidatorSemantics.readOps,hr]
  | some triple =>
    rcases triple with ⟨op,tail,left⟩
    simp only [opsResult,ValidatorSemantics.readOps,hr,Option.bind_eq_bind,Option.bind_some,Option.map_some]
    cases ValidatorSemantics.readOps left count width tail <;> rfl

def rootEnd (result : QueryResult) : Label :=
    if result.isSome then .step .checkEnd else .step .failure

def OpsPost (result : QueryResult) (raw width : Bits) (S : Slot → Bits) : Prop :=
  ∀ rest left,result=some (rest,left) → S=rootStore raw rest width [] (List.replicate left true) []

theorem root_loop (fuel width height : ℕ) (raw reader counter : Bits) (v : Local)
    (hraw : raw.length≤height) (hwidth : width.bits.length≤height) (hcounter : counter.length≤height)
    (hbudget : 3*reader.length+3*fuel≤height) :
    ∃ ticks last T,
      Stacks.stackRun program ticks ⟨some (.step .root),v,
        rootStore raw reader width.bits.reverse counter (List.replicate fuel true) []⟩=
        some ⟨some (rootEnd (opsResult fuel (binaryValue counter) width reader)),last,T⟩ ∧
      Cap T height ∧ T none=[] ∧ OpsPost (opsResult fuel (binaryValue counter) width reader) raw width.bits.reverse T ∧
      Stacks.stackRunClock program ticks ⟨some (.step .root),v,
        rootStore raw reader width.bits.reverse counter (List.replicate fuel true) []⟩≤
          250000*(fuel+1)^2*(1+3*height)^3 := by
  induction fuel using Nat.strong_induction_on generalizing reader counter v with
  | h fuel ih =>
    let P := (1+3*height)^3
    have hP : 1≤P := Nat.one_le_pow 3 _ (by omega)
    have h23 : (1+3*height)^2≤P := Nat.pow_le_pow_right (by omega) (by decide)
    have hcf : (1+counter.length+fuel)^2≤P := by
      have hh := Nat.pow_le_pow_left (show 1+counter.length+fuel≤1+3*height by omega) 2
      exact hh.trans h23
    have hH2 : (1+height)^2≤P := by
      have hh := Nat.pow_le_pow_left (show 1+height≤1+3*height by omega) 2
      exact hh.trans h23
    cases hnum : binaryValue counter with
    | zero =>
      obtain ⟨ticks,last,hR,hC⟩ :=
          root_count_zero raw reader width.bits.reverse counter (List.replicate fuel true) v hnum
      refine ⟨ticks,last,rootStore raw reader width.bits.reverse [] (List.replicate fuel true) [],?_,?_,rfl,?_,hC.trans ?_⟩
      · simpa [rootEnd,opsResult,ValidatorSemantics.readOps,hnum] using hR
      · rw [rootStore_cap]
        simp only [List.length_reverse,List.length_nil,List.length_replicate]
        omega
      · intro rest left he
        simp only [opsResult,ValidatorSemantics.readOps,Option.map_some,Option.some.injEq,Prod.mk.injEq] at he
        rcases he with ⟨rfl,rfl⟩
        rfl
      · simp only [List.length_replicate]
        change 100*(1+counter.length+fuel)^2≤250000*(fuel+1)^2*P
        have hp : 1≤(fuel+1)^2 := Nat.one_le_pow 2 _ (by omega)
        have hh := Nat.mul_le_mul_right P hp
        nlinarith only [hcf,hh]
    | succ n =>
      cases fuel with
      | zero =>
        obtain ⟨ticks,last,output,hlen,hvalue,hR,hC⟩ :=
            root_fuel_empty raw reader width.bits.reverse counter v (by omega)
        refine ⟨ticks,last,rootStore raw reader width.bits.reverse output [] [],?_,?_,rfl,?_,hC.trans ?_⟩
        · simpa [rootEnd,opsResult,ValidatorSemantics.readOps,hnum] using hR
        · rw [rootStore_cap]
          simp only [List.length_reverse,List.length_nil,hlen]
          omega
        · intro rest left he
          simp [opsResult,ValidatorSemantics.readOps] at he
        · change _≤250000*1^2*P
          simpa only [Nat.add_zero] using
              (show 100*(1+counter.length+0)^2≤250000*1^2*P by nlinarith only [hcf,hP])
      | succ fuel =>
        obtain ⟨guardTicks,v1,output,hlen,hvalue,hG,hGC⟩ :=
            root_count_positive raw reader width.bits.reverse counter fuel v (by omega)
        have houtput : binaryValue output=n := by omega
        obtain ⟨opTicks,v2,U,hO,hU,hout,hpost,hOC⟩ :=
            op_all fuel width height raw reader output v1 hraw hwidth (by omega) (by omega)
        have eG : Stacks.Execution program _ _ _ := ⟨guardTicks,hG,hGC⟩
        have hcf' : (1+counter.length+(fuel+1))^2≤P := hcf
        cases ho : opResult fuel width reader with
        | none =>
          simp only [ho,queryEnd,Option.isSome_none,Bool.false_eq_true,if_false] at hO
          have eO : Stacks.Execution program _ _ _ := ⟨opTicks,hO,hOC⟩
          obtain ⟨ticks,hR,hC⟩ := eG.trans eO
          refine ⟨ticks,v2,U,?_,hU,hout,?_,hC.trans ?_⟩
          · simpa [opsResult_step,hnum,ho,rootEnd] using hR
          · intro rest left he
            simp [opsResult_step,ho] at he
          · change 100*(1+counter.length+(fuel+1))^2+(fuel+1)*120000*P≤250000*(fuel+1+1)^2*P
            nlinarith only [hcf',hP,Nat.zero_le (fuel*P),Nat.zero_le (fuel^2*P)]
        | some pair =>
          rcases pair with ⟨rest,left⟩
          obtain ⟨op,_,hreader,hfuel⟩ := opResult_sound fuel width reader rest left ho
          have hleft : left≤fuel := by omega
          have hrest : rest.length≤reader.length := by rw [hreader,List.length_append]; omega
          have hbudget' : 3*rest.length+3*left≤height := by omega
          rw [hpost rest left ho] at hO
          simp only [ho,queryEnd,Option.isSome_some,if_true] at hO
          obtain ⟨restTicks,v3,T,hR,hT,hout2,hpost2,hRC⟩ :=
              ih left (by omega) rest output v2 (by omega) hbudget'
          have eO : Stacks.Execution program _ _ _ := ⟨opTicks,hO,hOC⟩
          have eR : Stacks.Execution program _ _ _ := ⟨restTicks,hR,hRC⟩
          obtain ⟨ticks,hRun,hClock⟩ := (eG.trans eO).trans eR
          refine ⟨ticks,v3,T,?_,hT,hout2,?_,hClock.trans ?_⟩
          · simpa only [hnum,opsResult_step,ho,Option.bind_some,houtput] using hRun
          · intro tail remaining hh
            simp only [opsResult_step,ho,Option.bind_some] at hh
            exact hpost2 tail remaining (by simpa only [houtput] using hh)
          · have hp2 := Nat.pow_le_pow_left (Nat.succ_le_succ hleft) 2
            have hrec : 250000*(left+1)^2*P≤250000*(fuel+1)^2*P :=
                Nat.mul_le_mul_right P (Nat.mul_le_mul_left 250000 hp2)
            change 100*(1+counter.length+(fuel+1))^2+(fuel+1)*120000*P+250000*(left+1)^2*P≤250000*(fuel+1+1)^2*P
            nlinarith only [hcf',hrec,hP,Nat.zero_le (fuel*P)]
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.WordValidator

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.WordValidator
open Turing Qatlib.Concepts.BitWordCompiler.CanonicalCodec

def output (input : Bits) : Bits :=
    match decodeWord input with | none => [false] | some w => true::wordBits w

theorem finish (raw : Bits) (S : Slot → Bits) (v : Local) (height : ℕ)
    (hout : S none=[]) (horiginal : S (some .original)=raw) (hcap : Cap S height) :
    ∃ ticks last,
      Stacks.stackRun program ticks ⟨some (.step .checkEnd),v,S⟩=
        some ⟨none,last,Function.update (fun _ => []) none (if S (some .reader)=[] then (true::raw).reverse else [false])⟩ ∧
      Stacks.stackRunClock program ticks ⟨some (.step .checkEnd),v,S⟩≤
        2*(S (some .reader)).length+3+300*(1+height)^2 := by
  obtain ⟨hE,hEC⟩ := check_end S v
  let v1 := putIO v (S (some .reader)).head?
  by_cases he : S (some .reader)=[]
  · simp only [if_pos he] at hE
    obtain ⟨cleanTicks,hC,hCC⟩ := success_output raw S v1 height hout horiginal hcap
    have eE : Stacks.Execution program _ _ _ := ⟨1,hE,hEC.le⟩
    have eC : Stacks.Execution program _ _ _ := ⟨cleanTicks,hC,hCC⟩
    obtain ⟨ticks,hr,hc⟩ := eE.trans eC
    exact ⟨ticks,_,by simpa only [if_pos he] using hr,hc⟩
  · simp only [if_neg he] at hE
    obtain ⟨cleanTicks,hC,hCC⟩ := failure_output S v1 height hout hcap
    have eE : Stacks.Execution program _ _ _ := ⟨1,hE,hEC.le⟩
    have eC : Stacks.Execution program _ _ _ := ⟨cleanTicks,hC,hCC⟩
    obtain ⟨ticks,hr,hc⟩ := eE.trans eC
    exact ⟨ticks,_,by simpa only [if_neg he] using hr,hc.trans (by omega)⟩

theorem source_cost_bound (length : ℕ) :
    1000*(1+length)^2+250000*(length+1)^2*(1+18*length)^3+(12*length+3)+300*(1+6*length)^2≤
      10000000000*(1+length)^5 := by
  let B := 1+length
  have hB : 1≤B := by dsimp [B]; omega
  have h25 : B^2≤B^5 := Nat.pow_le_pow_right hB (by decide)
  have h15 : B≤B^5 := Nat.le_pow (by decide)
  have hroot : 250000*(length+1)^2*(1+18*length)^3≤1714750000*B^5 := by
    calc
      _ ≤ 250000*B^2*(19*B)^3 := by
        rw [show length+1=B by dsimp [B]; omega]
        exact Nat.mul_le_mul_left _
            (Nat.pow_le_pow_left (show 1+18*length≤19*B by dsimp [B]; omega) 3)
      _ = _ := by ring
  have hclean : 300*(1+6*length)^2≤14700*B^5 := by
    calc
      _ ≤ 300*(7*B)^2 := Nat.mul_le_mul_left _ (Nat.pow_le_pow_left (by dsimp [B]; omega) 2)
      _ = 14700*B^2 := by ring
      _ ≤ _ := Nat.mul_le_mul_left _ h25
  have heof : 12*length+3≤15*B^5 := by
    have hh : 12*length+3≤15*B := by dsimp [B]; omega
    exact hh.trans (Nat.mul_le_mul_left 15 h15)
  change 1000*B^2+_+_+_≤10000000000*B^5
  nlinarith only [h25,hroot,hclean,heof,Nat.zero_le (B^5)]

theorem complete (input : Bits) (v : Local) :
    ∃ ticks last,
      Stacks.stackRun program ticks ⟨some (.prepare 0),v,initialStore input⟩=
        some ⟨none,last,Function.update (fun _ => []) none (output input).reverse⟩ ∧
      Stacks.stackRunClock program ticks ⟨some (.prepare 0),v,initialStore input⟩≤10000000000*(1+input.length)^5 := by
  have htotal := source_cost_bound input.length
  cases hw : readNat input with
  | none =>
    have hd : decodeWord input=none := by
      rw [← ValidatorSemantics.decode_eq]
      simp [ValidatorSemantics.decode,ValidatorSemantics.decodeAt,hw]
    obtain ⟨ticks,last,hr,hc⟩ := header_width_reject input v hw
    refine ⟨ticks,last,?_,hc.trans ?_⟩
    · simpa only [output,hd,List.reverse_cons,List.reverse_nil,List.nil_append] using hr
    · nlinarith only [htotal,Nat.zero_le (250000*(input.length+1)^2*(1+18*input.length)^3),Nat.zero_le (300*(1+6*input.length)^2),Nat.zero_le input.length]
  | some pair =>
    rcases pair with ⟨width,afterWidth⟩
    have hwidthInput := readNat_sound input width afterWidth hw
    obtain ⟨hwTail,hwBits⟩ := parsed_lengths _ _ _ hw
    cases hn : readNat afterWidth with
    | none =>
      have hd : decodeWord input=none := by
        rw [← ValidatorSemantics.decode_eq]
        simp [ValidatorSemantics.decode,ValidatorSemantics.decodeAt,hw,hn]
      obtain ⟨ticks,last,hr,hc⟩ := header_count_reject input width afterWidth v hwidthInput hn
      refine ⟨ticks,last,?_,hc.trans ?_⟩
      · simpa only [output,hd,List.reverse_cons,List.reverse_nil,List.nil_append] using hr
      · nlinarith only [htotal,Nat.zero_le (250000*(input.length+1)^2*(1+18*input.length)^3),Nat.zero_le (300*(1+6*input.length)^2),Nat.zero_le input.length]
    | some pair =>
      rcases pair with ⟨count,reader⟩
      have hcountInput := readNat_sound afterWidth count reader hn
      obtain ⟨hnTail,hnBits⟩ := parsed_lengths _ _ _ hn
      have hinput : input=natBits width++(natBits count++reader) := by rw [hwidthInput,hcountInput]
      obtain ⟨headerTicks,v1,hH,hHC⟩ := header_valid input width count reader v hinput
      obtain ⟨rootTicks,v2,T,hR,hT,hout,hpost,hRC⟩ :=
          root_loop input.length width (6*input.length) input reader count.bits v1 (by omega)
          (by omega) (by omega) (by omega)
      simp only [binaryValue_bits] at hR hpost
      have eH : Stacks.Execution program _ _ _ := ⟨headerTicks,hH,hHC⟩
      cases hread : ValidatorSemantics.readOps input.length count width reader with
      | none =>
        have hd : decodeWord input=none := by
          rw [← ValidatorSemantics.decode_eq]
          simp [ValidatorSemantics.decode,ValidatorSemantics.decodeAt,hw,hn,hread]
        simp only [opsResult,hread,Option.map_none,rootEnd,Option.isSome_none,Bool.false_eq_true,if_false] at hR
        obtain ⟨cleanTicks,hC,hCC⟩ := failure_output T v2 (6*input.length) hout hT
        have eR : Stacks.Execution program _ _ _ := ⟨rootTicks,hR,hRC⟩
        have eC : Stacks.Execution program _ _ _ := ⟨cleanTicks,hC,hCC⟩
        obtain ⟨ticks,hr,hc⟩ := (eH.trans eR).trans eC
        refine ⟨ticks,putIO v2 none,?_,hc.trans ?_⟩
        · simpa only [output,hd,List.reverse_cons,List.reverse_nil,List.nil_append] using hr
        · change 1000*(1+input.length)^2+250000*(input.length+1)^2*(1+3*(6*input.length))^3+210*(1+6*input.length)^2≤_
          nlinarith only [htotal,Nat.zero_le (300*(1+6*input.length)^2),Nat.zero_le input.length,Nat.zero_le (input.length^2)]
      | some triple =>
        rcases triple with ⟨ops,rest,left⟩
        have hres : opsResult input.length count width reader=some (rest,left) := by
          simp only [opsResult,hread,Option.map_some]
        have hTeq := hpost rest left hres
        rw [hTeq] at hR hT hout
        simp only [hres,rootEnd,Option.isSome_some,if_true] at hR
        obtain ⟨finishTicks,last,hF,hFC⟩ :=
            finish input
            (rootStore input rest width.bits.reverse [] (List.replicate left true) []) v2
            (6*input.length) hout rfl hT
        have eR : Stacks.Execution program _ _ _ := ⟨rootTicks,hR,hRC⟩
        have eF : Stacks.Execution program _ _ _ := ⟨finishTicks,hF,hFC⟩
        obtain ⟨ticks,hr,hc⟩ := (eH.trans eR).trans eF
        have hd : decodeWord input=(if rest=[] then some ⟨width,ops⟩ else none) := by
          rw [← ValidatorSemantics.decode_eq]
          simp [ValidatorSemantics.decode,ValidatorSemantics.decodeAt,hw,hn,hread]
        refine ⟨ticks,last,?_,hc.trans ?_⟩
        · by_cases he : rest=[]
          · have hbits := (decodeWord_eq_some_iff input ⟨width,ops⟩).mp (by simpa only [if_pos he] using hd)
            simpa only [rootStore,if_pos he,output,hd,if_pos he,← hbits.2] using hr
          · simpa only
              [rootStore,if_neg he,output,hd,if_neg he,List.reverse_cons,List.reverse_nil,List.nil_append] using hr
        · have hrest : rest.length≤6*input.length := hT .reader
          change 1000*(1+input.length)^2+250000*(input.length+1)^2*(1+3*(6*input.length))^3+(2*rest.length+3+300*(1+6*input.length)^2)≤_
          nlinarith only [htotal,hrest]
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.WordValidator

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.WordValidator
open Turing Qatlib.Concepts.BitWordCompiler.CanonicalCodec

theorem output_length (input : Bits) : (output input).length≤1+input.length := by
  cases hd : decodeWord input with
  | none => simp [output,hd]
  | some w =>
    have hi := ((decodeWord_eq_some_iff input w).mp hd).2
    simp only [output,hd,List.length_cons]
    rw [← hi]
    omega

theorem raw_machine : ∃ (q : ℕ) (M : TM0.Machine (Option Bool) (Fin (q+1))) (C : ℕ),0<C ∧
    ∀ input,Runs M input (output input) (C*(1+input.length)^8) (C*(1+input.length)^8) := by
  obtain ⟨q,M,C,hC,hM⟩ := Stacks.raw_compiler program (some Work.input) none
  refine ⟨q,M,10000000005*C,Nat.mul_pos (by decide) hC,?_⟩
  intro input
  obtain ⟨steps,last,hr,hc⟩ := complete input default
  have hrun : Stacks.stackRun program steps (TM2.init (some Work.input) input.reverse)=
      some ⟨none,last,Function.update (fun _ => []) none (output input).reverse⟩ := by
    rw [initial_eq]
    exact hr
  have hclock : Stacks.stackRunClock program steps (TM2.init (some Work.input) input.reverse)≤10000000000*(1+input.length)^5 := by
    rw [initial_eq]
    exact hc
  have hR := hM input (output input) steps last hrun
  let B := 1+input.length
  have hB : 1≤B := by dsimp [B]; omega
  have h28 : B^2≤B^8 := Nat.pow_le_pow_right hB (by decide)
  have h58 : B^5≤B^8 := Nat.pow_le_pow_right hB (by decide)
  have ho : 1+(output input).length≤2*B := by
    have hh := output_length input
    dsimp [B]
    omega
  have ho2 := Nat.pow_le_pow_left ho 2
  have hb : (1+input.length)^2+Stacks.stackRunClock program steps (TM2.init (some Work.input) input.reverse)+(1+(output input).length)^2≤10000000005*B^8 := by
    change _≤10000000000*B^5 at hclock
    change B^2+_+_≤10000000005*B^8
    nlinarith only [hclock,h28,h58,ho2]
  have hbudget : C*((1+input.length)^2+Stacks.stackRunClock program steps (TM2.init (some Work.input) input.reverse)+(1+(output input).length)^2)≤
      (10000000005*C)*(1+input.length)^8 := by
    calc
      _ ≤ C*(10000000005*B^8) := Nat.mul_le_mul_left C hb
      _ = _ := by dsimp [B]; ring
  exact TM.runs_mono hR hbudget hbudget
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.WordValidator

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.BitWordCompiler
open Qatlib.Concepts.BitWordCompiler.CanonicalCodec

theorem canonical_codec_and_validator :
  ∃ (parse : Bits → Option (Word×Bits)) (decode : Bits → Option Word),
    (∀ w suffix,Legal w → parse (wordBits w++suffix)=some (w,suffix)) ∧
    (∀ input w suffix,parse input=some (w,suffix) ↔ Legal w ∧ input=wordBits w++suffix) ∧
    (∀ input w,decode input=some w ↔ Legal w ∧ input=wordBits w) ∧
    (∀ w,(wordBits w).length=(([w.width,w.ops.length]++w.ops.flatMap fields).map (fun n => 2*n.bits.length+1)).sum) ∧
    ∃ (q : ℕ) (M : Turing.TM0.Machine (Option Bool) (Fin (q+1))) (C : ℕ),0<C ∧
      ∀ input,Runs M input (match decode input with | none => [false] | some w => true::wordBits w)
        (C*(1+input.length)^8) (C*(1+input.length)^8) := by
  refine ⟨parseWord,decodeWord,parseWord_complete,parseWord_eq_some_iff,decodeWord_eq_some_iff,wordBits_length,?_⟩
  simpa only [TM.WordValidator.output] using TM.WordValidator.raw_machine
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.BitWordCompiler

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.CountedTake
open Turing Qatlib.Concepts.BitWordCompiler.CanonicalCodec
abbrev Local := Counter.Local×Symbol
inductive Label where | counter (l : Counter.Label) | branch | take | drain deriving DecidableEq,Fintype
instance : Inhabited Label := ⟨.counter .borrow⟩

def program : Label → TM2.Stmt (fun _ : Fin 4 => Bool) Label Local
  | .counter l => StackCall.stmt (Fin.castAdd 2) Label.counter .branch Prod.fst (fun v s => (s,v.2)) (Counter.program l)
  | .branch => .branch (fun v => v.1.1) (.goto (fun _ => .take)) (.goto (fun _ => .drain))
  | .take => .pop 2 (fun v bit => (v.1,bit))
      (.push 3 (fun v => v.2.getD false) (.goto (fun _ => .counter .borrow)))
  | .drain => .pop 0 (fun v bit => (v.1,bit)) (.branch (fun v => v.2.isSome) (.goto (fun _ => .drain)) .halt)

def padded : ℕ → Bits → Bits
  | 0,_ => []
  | n+1,bits => bits.head?.getD false::padded n bits.tail

theorem padded_length (n : ℕ) (bits : Bits) : (padded n bits).length=n := by
  induction n generalizing bits with
  | zero => rfl
  | succ n ih => simp [padded,ih]

theorem padded_prefix (bits tail : Bits) : padded bits.length (bits++tail)=bits := by
  induction bits with
  | nil => rfl
  | cons bit bits ih => simpa only [List.length_cons,padded,List.head?_cons,Option.getD_some,List.tail_cons,List.cons_append] using congrArg (bit::·) ih

theorem padded_testBit (n width : ℕ) : padded width n.bits=List.ofFn (fun i : Fin width => n.testBit i.val) := by
  apply List.ext_getElem
  · simp [padded_length]
  · intro i hi hj
    have hp : ∀ (w i : ℕ) (bits : Bits),i<w → (padded w bits)[i]?.getD false=bits[i]?.getD false := by
      intro w
      induction w with
      | zero => intro i bits h; omega
      | succ w ih =>
        intro i bits hi
        cases i with
        | zero => simp [padded,List.head?_eq_getElem?]
        | succ i =>
          simp only [padded,List.getElem?_cons_succ]
          simpa only [List.getElem?_tail] using ih i bits.tail (by omega)
    have hh := hp width i n.bits (by simpa only [padded_length] using hi)
    simp only [List.getElem?_eq_getElem hi,Option.getD_some] at hh
    rw [List.getElem_ofFn]
    rw [hh]
    simpa only [List.getI_eq_getElem?_getD] using! (Nat.testBit_eq_inth n i).symm

theorem counter_zero (counter reader out : Bits) (v : Local) (hz : binaryValue counter=0) :
    Stacks.stackRun program (2*counter.length+2) ⟨some (.counter .borrow),v,Preparation.quad counter [] reader out⟩=
      some ⟨some .branch,((false,none),v.2),Preparation.quad (List.replicate counter.length true) [] reader out⟩ ∧
    Stacks.stackRunClock program (2*counter.length+2) ⟨some (.counter .borrow),v,Preparation.quad counter [] reader out⟩≤10*(1+counter.length)^2 := by
  obtain ⟨hr,hc⟩ := Counter.decrement_zero counter v.1 hz
  obtain ⟨hN,hNC⟩ := StackCall.execution (Fin.castAdd 2) Label.counter .branch Prod.fst (fun v s => (s,v.2))
    (Preparation.transferFrame reader out) (Preparation.transferFrame_at reader out)
    (Preparation.transferFrame_update reader out) (fun _ _ => rfl) (fun _ _ _ => rfl)
    Counter.program program (fun _ => rfl) v (2*counter.length+2) _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,
    Preparation.transferFrame,Stacks.stackPair_zero,Stacks.stackPair_one] at hN hNC
  exact ⟨hN,hNC.trans_le hc⟩

theorem counter_positive (counter reader out : Bits) (v : Local) (hp : 0<binaryValue counter) :
    ∃ ticks next,next.length=counter.length ∧ binaryValue next+1=binaryValue counter ∧
      Stacks.stackRun program ticks ⟨some (.counter .borrow),v,Preparation.quad counter [] reader out⟩=
        some ⟨some .branch,((true,none),v.2),Preparation.quad next [] reader out⟩ ∧
      Stacks.stackRunClock program ticks ⟨some (.counter .borrow),v,Preparation.quad counter [] reader out⟩≤10*(1+counter.length)^2 := by
  obtain ⟨ticks,next,_,hlen,hvalue,hr,hc⟩ := Counter.decrement_positive counter v.1 hp
  obtain ⟨hN,hNC⟩ := StackCall.execution (Fin.castAdd 2) Label.counter .branch Prod.fst (fun v s => (s,v.2))
    (Preparation.transferFrame reader out) (Preparation.transferFrame_at reader out)
    (Preparation.transferFrame_update reader out) (fun _ _ => rfl) (fun _ _ _ => rfl)
    Counter.program program (fun _ => rfl) v ticks _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,
    Preparation.transferFrame,Stacks.stackPair_zero,Stacks.stackPair_one] at hN hNC
  exact ⟨ticks,next,hlen,hvalue,hN,hNC.trans_le hc⟩

theorem branch_step (counter reader out : Bits) (flag : Bool) (saved : Symbol) :
    Stacks.stackRun program 1 ⟨some .branch,((flag,none),saved),Preparation.quad counter [] reader out⟩=
      some ⟨some (if flag then .take else .drain),((flag,none),saved),Preparation.quad counter [] reader out⟩ ∧
    Stacks.stackRunClock program 1 ⟨some .branch,((flag,none),saved),Preparation.quad counter [] reader out⟩=1 := by
  cases flag <;> constructor <;> rfl

theorem take_step (counter reader out : Bits) (v : Local) :
    Stacks.stackRun program 1 ⟨some .take,v,Preparation.quad counter [] reader out⟩=
      some ⟨some (.counter .borrow),(v.1,reader.head?),Preparation.quad counter [] reader.tail (reader.head?.getD false::out)⟩ ∧
    Stacks.stackRunClock program 1 ⟨some .take,v,Preparation.quad counter [] reader out⟩=reader.length+reader.tail.length+2*out.length+6 := by
  constructor
  · simp [Stacks.run_one,TM2.step,program,TM2.stepAux]
  · simp [Stacks.stackRunClock,program,Stacks.stackClock]
    omega

theorem drain_all (counter reader out : Bits) (v : Local) :
    Stacks.stackRun program (counter.length+1) ⟨some .drain,v,Preparation.quad counter [] reader out⟩=
      some ⟨none,(v.1,none),Preparation.quad [] [] reader out⟩ ∧
    Stacks.stackRunClock program (counter.length+1) ⟨some .drain,v,Preparation.quad counter [] reader out⟩=
      counter.length^2+3*counter.length+3 := by
  induction counter generalizing v with
  | nil => constructor <;> simp [Stacks.stackRun,TM2.step,program,TM2.stepAux,Stacks.stackRunClock,Stacks.stackClock]
  | cons bit bits ih =>
    have hs : TM2.step program ⟨some .drain,v,Preparation.quad (bit::bits) [] reader out⟩=
        some ⟨some .drain,(v.1,some bit),Preparation.quad bits [] reader out⟩ := by
      simp [TM2.step,program,TM2.stepAux]
    obtain ⟨hr,hc⟩ := ih (v.1,some bit)
    constructor
    · simpa only [List.length_cons,Stacks.stackRun,hs,Option.bind_some] using hr
    · simp only [List.length_cons]
      rw [Stacks.stackRunClock,hs]
      change 1+Stacks.stackClock (program .drain) v (Preparation.quad (bit::bits) [] reader out)+
        Stacks.stackRunClock program (bits.length+1) ⟨some .drain,(v.1,some bit),Preparation.quad bits [] reader out⟩=_
      rw [hc]
      simp [program,Stacks.stackClock]
      ring

theorem complete (n : ℕ) (counter reader out : Bits) (v : Local) (hnum : binaryValue counter=n) :
    ∃ ticks,
      Stacks.stackRun program ticks ⟨some (.counter .borrow),v,Preparation.quad counter [] reader out⟩=
        some ⟨none,((false,none),none),Preparation.quad [] [] (reader.drop n) ((padded n reader).reverse++out)⟩ ∧
      Stacks.stackRunClock program ticks ⟨some (.counter .borrow),v,Preparation.quad counter [] reader out⟩≤
        150*(n+1)*(1+counter.length+reader.length+out.length+n)^2 := by
  induction n generalizing counter reader out v with
  | zero =>
    obtain ⟨hC,hCC⟩ := counter_zero counter reader out v hnum
    obtain ⟨hB,hBC⟩ := branch_step (List.replicate counter.length true) reader out false v.2
    obtain ⟨hD,hDC⟩ := drain_all (List.replicate counter.length true) reader out ((false,none),v.2)
    have eC : Stacks.Execution program _ _ _ := ⟨2*counter.length+2,hC,hCC⟩
    have eB : Stacks.Execution program _ _ 1 := ⟨1,hB,hBC.le⟩
    have eD : Stacks.Execution program _ _ _ :=
        ⟨(List.replicate counter.length true).length+1,hD,hDC.le⟩
    obtain ⟨ticks,hr,hc⟩ := (eC.trans eB).trans eD
    refine ⟨ticks,?_,hc.trans ?_⟩
    · simpa only [List.drop_zero,padded,List.reverse_nil,List.nil_append] using hr
    · let B := 1+counter.length+reader.length+out.length
      have hB : 1≤B := by dsimp [B]; omega
      have hB2 : B≤B^2 := Nat.le_pow (by decide)
      have hcounter : counter.length≤B := by dsimp [B]; omega
      have hcounter2 := Nat.mul_le_mul hcounter hcounter
      have hcp : 1+counter.length≤B := by dsimp [B]; omega
      have hcp2 := Nat.pow_le_pow_left hcp 2
      simp only [List.length_replicate,Nat.add_zero]
      change 10*(1+counter.length)^2+1+(counter.length^2+3*counter.length+3)≤150*B^2
      nlinarith only [hB,hB2,hcounter,hcounter2,hcp2]
  | succ n ih =>
    obtain ⟨counterTicks,next,hlen,hvalue,hC,hCC⟩ :=
        counter_positive counter reader out v (by omega)
    obtain ⟨hB,hBC⟩ := branch_step next reader out true v.2
    obtain ⟨hT,hTC⟩ := take_step next reader out ((true,none),v.2)
    obtain ⟨restTicks,hR,hRC⟩ :=
        ih next reader.tail (reader.head?.getD false::out) ((true,none),reader.head?) (by omega)
    have eC : Stacks.Execution program _ _ _ := ⟨counterTicks,hC,hCC⟩
    have eB : Stacks.Execution program _ _ 1 := ⟨1,hB,hBC.le⟩
    have eT : Stacks.Execution program _ _ _ := ⟨1,hT,hTC.le⟩
    have eR : Stacks.Execution program _ _ _ := ⟨restTicks,hR,hRC⟩
    obtain ⟨ticks,hr,hc⟩ := ((eC.trans eB).trans eT).trans eR
    refine ⟨ticks,?_,hc.trans ?_⟩
    · simpa only
        [padded,List.reverse_cons,List.append_assoc,List.singleton_append,List.drop_tail] using hr
    · let B := 1+counter.length+reader.length+out.length+(n+1)
      have hB : 1≤B := by dsimp [B]; omega
      have hB2 : B≤B^2 := Nat.le_pow (by decide)
      have hcp : 1+counter.length≤B := by dsimp [B]; omega
      have hcp2 := Nat.pow_le_pow_left hcp 2
      have hrlen : reader.length≤B := by dsimp [B]; omega
      have htlen : reader.tail.length≤B := by simp only [List.length_tail]; dsimp [B]; omega
      have holen : out.length≤B := by dsimp [B]; omega
      have hrest : 1+next.length+reader.tail.length+(reader.head?.getD false::out).length+n≤B := by
        simp only [hlen,List.length_cons,List.length_tail]
        dsimp [B]
        omega
      have hrec := Nat.mul_le_mul_left (150*(n+1)) (Nat.pow_le_pow_left hrest 2)
      change 10*(1+counter.length)^2+1+(reader.length+reader.tail.length+2*out.length+6)+
        150*(n+1)*(1+next.length+reader.tail.length+(reader.head?.getD false::out).length+n)^2≤150*(n+1+1)*B^2
      nlinarith only [hrec,hcp2,hrlen,htlen,holen,hB,hB2]

theorem complete_prefix (bits tail out counter : Bits) (v : Local) (hnum : binaryValue counter=bits.length) :
    ∃ ticks,
      Stacks.stackRun program ticks ⟨some (.counter .borrow),v,Preparation.quad counter [] (bits++tail) out⟩=
        some ⟨none,((false,none),none),Preparation.quad [] [] tail (bits.reverse++out)⟩ ∧
      Stacks.stackRunClock program ticks ⟨some (.counter .borrow),v,Preparation.quad counter [] (bits++tail) out⟩≤
        150*(bits.length+1)*(1+counter.length+(bits++tail).length+out.length+bits.length)^2 := by
  obtain ⟨ticks,hr,hc⟩ := complete bits.length counter (bits++tail) out v hnum
  exact ⟨ticks,by simpa only [padded_prefix,List.drop_left] using hr,hc⟩

theorem fixed_count (width n : ℕ) (out : Bits) (v : Local) : ∃ ticks,
    Stacks.stackRun program ticks ⟨some (.counter .borrow),v,Preparation.quad width.bits [] n.bits out⟩=
      some ⟨none,((false,none),none),Preparation.quad [] [] (n.bits.drop width)
        ((List.ofFn (fun i : Fin width => n.testBit i.val)).reverse++out)⟩ ∧
    Stacks.stackRunClock program ticks ⟨some (.counter .borrow),v,Preparation.quad width.bits [] n.bits out⟩≤
      150*(width+1)*(1+width.bits.length+n.bits.length+out.length+width)^2 := by
  simpa only [padded_testBit] using complete width width.bits n.bits out v (binaryValue_bits width)

end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.CountedTake

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.BinaryNormalize
open Turing Qatlib.Concepts.BitWordCompiler.CanonicalCodec

def trim : Bits → Bits
  | [] => []
  | false::bits => trim bits
  | true::bits => true::bits

def program (_ : Fin 1) : TM2.Stmt (fun _ : Fin 1 => Bool) (Fin 1) Symbol :=
  .pop 0 (fun _ bit => bit) (.branch (fun bit => decide (bit=some false)) (.goto (fun _ => 0))
    (.branch (fun bit => bit.isSome) (.push 0 (fun bit => bit.getD false) .halt) .halt))

theorem binary_append_zero (bits : Bits) : binaryValue (bits++[false])=binaryValue bits := by
  induction bits with
  | nil => rfl
  | cons bit bits ih => simp only [List.cons_append,CheckedNat.binary_cons,ih]

theorem trim_value (bits : Bits) : binaryValue (trim bits).reverse=binaryValue bits.reverse := by
  induction bits with
  | nil => rfl
  | cons bit bits ih =>
    cases bit with
    | false => simpa only [trim,List.reverse_cons,binary_append_zero] using ih
    | true => rfl

theorem trim_head (bits : Bits) : (trim bits).head?≠some false := by
  induction bits with
  | nil => decide
  | cons bit bits ih => cases bit <;> simp [trim,ih]

theorem trim_canonical (bits : Bits) : trim bits=(binaryValue bits.reverse).bits.reverse := by
  have hcanon : (binaryValue (trim bits).reverse).bits=(trim bits).reverse :=
    (CheckedNat.canonical_iff (trim bits).reverse).mpr (by simpa only [List.reverse_reverse] using trim_head bits)
  rw [trim_value] at hcanon
  have hh := congrArg List.reverse hcanon
  simpa only [List.reverse_reverse] using hh.symm

theorem trim_length (bits : Bits) : (trim bits).length≤bits.length := by
  induction bits with
  | nil => rfl
  | cons bit bits ih => cases bit <;> simp [trim]; omega

theorem complete (bits : Bits) (v : Symbol) :
    ∃ ticks last,
      Stacks.stackRun program ticks ⟨some 0,v,Normalization.singleStack bits⟩=
        some ⟨none,last,Normalization.singleStack (binaryValue bits.reverse).bits.reverse⟩ ∧
      Stacks.stackRunClock program ticks ⟨some 0,v,Normalization.singleStack bits⟩≤20*(1+bits.length)^2 := by
  suffices h : ∃ ticks last,
      Stacks.stackRun program ticks ⟨some 0,v,Normalization.singleStack bits⟩=
        some ⟨none,last,Normalization.singleStack (trim bits)⟩ ∧
      Stacks.stackRunClock program ticks ⟨some 0,v,Normalization.singleStack bits⟩≤20*(1+bits.length)^2 by
    simpa only [trim_canonical] using h
  induction bits generalizing v with
  | nil =>
    refine ⟨1,none,?_,?_⟩
    · simp [Stacks.run_one,TM2.step,program,TM2.stepAux,trim]
    · simp [Stacks.stackRunClock,program,Stacks.stackClock]
  | cons bit bits ih =>
    cases bit with
    | true =>
      refine ⟨1,some true,?_,?_⟩
      · simp [Stacks.run_one,TM2.step,program,TM2.stepAux,trim]
      · simp [Stacks.stackRunClock,program,Stacks.stackClock]
        nlinarith only [Nat.zero_le bits.length,Nat.zero_le (bits.length^2)]
    | false =>
      obtain ⟨ticks,last,hr,hc⟩ := ih (some false)
      have hs : TM2.step program ⟨some 0,v,Normalization.singleStack (false::bits)⟩=
          some ⟨some 0,some false,Normalization.singleStack bits⟩ := by
        simp [TM2.step,program,TM2.stepAux]
      refine ⟨ticks+1,last,?_,?_⟩
      · simpa only [Stacks.stackRun,hs,Option.bind_some,trim] using hr
      · rw [Stacks.stackRunClock,hs]
        change 1+Stacks.stackClock (program 0) v (Normalization.singleStack (false::bits))+
          Stacks.stackRunClock program ticks ⟨some 0,some false,Normalization.singleStack bits⟩≤_
        have hfirst : Stacks.stackClock (program 0) v (Normalization.singleStack (false::bits))=2*bits.length+3 := by
          simp [program,Stacks.stackClock]
          omega
        rw [hfirst]
        simp only [List.length_cons]
        nlinarith only [hc,Nat.zero_le bits.length]
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.BinaryNormalize

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.NatReadEmit
open Turing Qatlib.Concepts.BitWordCompiler.CanonicalCodec
inductive Slot where | reader | markers | payload | value | temporary | output deriving DecidableEq,Fintype
inductive Label where | read (l : CheckedNat.Label) | transfer (l : Fin 1) | emit (l : NatEmit.Label) | done deriving DecidableEq,Fintype
instance : Inhabited Label := ⟨.read .unary⟩
abbrev Local := CheckedNat.Local×Symbol

def store (reader markers payload value temporary output : Bits) : Slot → Bits
  | .reader => reader
  | .markers => markers
  | .payload => payload
  | .value => value
  | .temporary => temporary
  | .output => output

def readCode : Fin 3 → Slot | 0 => .reader | 1 => .markers | _ => .payload
def transferCode : Fin 2 → Slot | 0 => .payload | _ => .value
def emitCode : Fin 3 → Slot | 0 => .value | 1 => .temporary | _ => .output

def program : Label → TM2.Stmt (fun _ : Slot => Bool) Label Local
  | .read l => StackCall.stmt readCode Label.read (.transfer 0) Prod.fst (fun v s => (s,v.2)) (CheckedNat.program l)
  | .transfer l => StackCall.stmt transferCode Label.transfer (.emit .count) Prod.snd (fun v s => (v.1,s)) (Stacks.transferProgram l)
  | .emit l => StackCall.stmt emitCode Label.emit .done Prod.snd (fun v s => (v.1,s)) (NatEmit.program l)
  | .done => .halt

def readFrame (value temporary output : Bits) (S : Fin 3 → Bits) : Slot → Bits :=
  store (S 0) (S 1) (S 2) value temporary output

def transferFrame (reader markers temporary output : Bits) (S : Fin 2 → Bits) : Slot → Bits :=
  store reader markers (S 0) (S 1) temporary output

def emitFrame (reader markers payload : Bits) (S : Fin 3 → Bits) : Slot → Bits :=
  store reader markers payload (S 0) (S 1) (S 2)

theorem readFrame_at (value temporary output : Bits) (S : Fin 3 → Bits) (k : Fin 3) :
    readFrame value temporary output S (readCode k)=S k := by fin_cases k <;> rfl

theorem readFrame_update (value temporary output : Bits) (S : Fin 3 → Bits) (k : Fin 3) (bits : Bits) :
    readFrame value temporary output (Function.update S k bits)=Function.update (readFrame value temporary output S) (readCode k) bits := by
  funext j
  fin_cases k <;> cases j <;> rfl

theorem transferFrame_at (reader markers temporary output : Bits) (S : Fin 2 → Bits) (k : Fin 2) :
    transferFrame reader markers temporary output S (transferCode k)=S k := by fin_cases k <;> rfl

theorem transferFrame_update (reader markers temporary output : Bits) (S : Fin 2 → Bits) (k : Fin 2) (bits : Bits) :
    transferFrame reader markers temporary output (Function.update S k bits)=Function.update (transferFrame reader markers temporary output S) (transferCode k) bits := by
  funext j
  fin_cases k <;> cases j <;> rfl

theorem emitFrame_at (reader markers payload : Bits) (S : Fin 3 → Bits) (k : Fin 3) :
    emitFrame reader markers payload S (emitCode k)=S k := by fin_cases k <;> rfl

theorem emitFrame_update (reader markers payload : Bits) (S : Fin 3 → Bits) (k : Fin 3) (bits : Bits) :
    emitFrame reader markers payload (Function.update S k bits)=Function.update (emitFrame reader markers payload S) (emitCode k) bits := by
  funext j
  fin_cases k <;> cases j <;> rfl

theorem read_call (n : ℕ) (tail out : Bits) (v : Local) : ∃ ticks,
    Stacks.stackRun program ticks ⟨some (.read .unary),v,store (natBits n++tail) [] [] [] [] out⟩=
      some ⟨some (.transfer 0),((true,CheckedNat.lastField n.bits none),v.2),store tail [] n.bits.reverse [] [] out⟩ ∧
    Stacks.stackRunClock program ticks ⟨some (.read .unary),v,store (natBits n++tail) [] [] [] [] out⟩≤
      50*(1+(natBits n++tail).length)^2 := by
  obtain ⟨ticks,hr,hc⟩ := CheckedNat.valid_execution n tail [] v.1
  simp only [List.append_nil,List.length_nil,Nat.add_zero] at hr hc
  obtain ⟨hN,hNC⟩ := StackCall.execution readCode Label.read (.transfer 0) Prod.fst (fun v s => (s,v.2))
    (readFrame [] [] out) (readFrame_at [] [] out) (readFrame_update [] [] out)
    (fun _ _ => rfl) (fun _ _ _ => rfl) CheckedNat.program program (fun _ => rfl) v ticks _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,readFrame,
    Parsing.triple_zero,Parsing.triple_one,Parsing.triple_two] at hN hNC
  exact ⟨ticks,hN,hNC.trans_le hc⟩

theorem transfer_call (n : ℕ) (tail out : Bits) (v : Local) :
    Stacks.stackRun program (n.bits.length+1) ⟨some (.transfer 0),v,store tail [] n.bits.reverse [] [] out⟩=
      some ⟨some (.emit .count),(v.1,none),store tail [] [] n.bits [] out⟩ ∧
    Stacks.stackRunClock program (n.bits.length+1) ⟨some (.transfer 0),v,store tail [] n.bits.reverse [] [] out⟩=
      n.bits.length*(2*n.bits.length+5)+3 := by
  obtain ⟨hN,hNC⟩ := StackCall.execution transferCode Label.transfer (.emit .count) Prod.snd (fun v s => (v.1,s))
    (transferFrame tail [] [] out) (transferFrame_at tail [] [] out) (transferFrame_update tail [] [] out)
    (fun _ _ => rfl) (fun _ _ _ => rfl) Stacks.transferProgram program (fun _ => rfl) v (n.bits.reverse.length+1) _ _ (Stacks.transfer_run n.bits.reverse [] v.2)
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,transferFrame,
    Stacks.stackPair_zero,Stacks.stackPair_one,List.reverse_reverse,List.append_nil,List.length_reverse] at hN hNC
  refine ⟨hN,?_⟩
  have hc := Stacks.transfer_clock n.bits.reverse [] v.2
  simp only [List.length_reverse,List.length_nil,Nat.add_zero] at hc
  exact hNC.trans hc

theorem emit_call (n : ℕ) (tail out : Bits) (v : Local) :
    Stacks.stackRun program (4*n.bits.length+5) ⟨some (.emit .count),v,store tail [] [] n.bits [] out⟩=
      some ⟨some .done,(v.1,none),store tail [] [] n.bits [] ((natBits n).reverse++out)⟩ ∧
    Stacks.stackRunClock program (4*n.bits.length+5) ⟨some (.emit .count),v,store tail [] [] n.bits [] out⟩=
      n.bits.length*(12*n.bits.length+4*out.length+28)+2*out.length+16 := by
  obtain ⟨hr,hc⟩ := NatEmit.complete n out v.2
  obtain ⟨hN,hNC⟩ := StackCall.execution emitCode Label.emit .done Prod.snd (fun v s => (v.1,s))
    (emitFrame tail [] []) (emitFrame_at tail [] []) (emitFrame_update tail [] [])
    (fun _ _ => rfl) (fun _ _ _ => rfl) NatEmit.program program (fun _ => rfl) v (4*n.bits.length+5) _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,emitFrame,
    Parsing.triple_zero,Parsing.triple_one,Parsing.triple_two] at hN hNC
  exact ⟨hN,hNC.trans hc⟩

theorem complete (n : ℕ) (tail out : Bits) (v : Local) : ∃ ticks,
    Stacks.stackRun program ticks ⟨some (.read .unary),v,store (natBits n++tail) [] [] [] [] out⟩=
      some ⟨none,((true,CheckedNat.lastField n.bits none),none),store tail [] [] n.bits [] ((natBits n).reverse++out)⟩ ∧
    Stacks.stackRunClock program ticks ⟨some (.read .unary),v,store (natBits n++tail) [] [] [] [] out⟩≤
      500*(1+(natBits n++tail).length+out.length)^2 := by
  obtain ⟨readTicks,hR,hRC⟩ := read_call n tail out v
  let v1 : Local := ((true,CheckedNat.lastField n.bits none),v.2)
  let v2 : Local := (v1.1,none)
  obtain ⟨hT,hTC⟩ := transfer_call n tail out v1
  obtain ⟨hE,hEC⟩ := emit_call n tail out v2
  have hD : Stacks.stackRun program 1 ⟨some .done,v2,store tail [] [] n.bits [] ((natBits n).reverse++out)⟩=
      some ⟨none,v2,store tail [] [] n.bits [] ((natBits n).reverse++out)⟩ := rfl
  have hDC :
      Stacks.stackRunClock program 1 ⟨some .done,v2,store tail [] [] n.bits [] ((natBits n).reverse++out)⟩=1 := rfl
  have eR : Stacks.Execution program _ _ _ := ⟨readTicks,hR,hRC⟩
  have eT : Stacks.Execution program _ _ _ := ⟨n.bits.length+1,hT,hTC.le⟩
  have eE : Stacks.Execution program _ _ _ := ⟨4*n.bits.length+5,hE,hEC.le⟩
  have eD : Stacks.Execution program _ _ 1 := ⟨1,hD,hDC.le⟩
  obtain ⟨ticks,hr,hc⟩ := ((eR.trans eT).trans eE).trans eD
  refine ⟨ticks,hr,hc.trans ?_⟩
  let B := 1+(natBits n++tail).length+out.length
  have hB : 1≤B := by dsimp [B]; omega
  have hB2 : B≤B^2 := Nat.le_pow (by decide)
  have hn : n.bits.length≤B := by dsimp [B]; simp only [List.length_append,natBits_length]; omega
  have hn2 := Nat.mul_le_mul hn hn
  have ho : out.length≤B := by dsimp [B]; omega
  have hno := Nat.mul_le_mul hn ho
  have hraw : 1+(natBits n++tail).length≤B := by dsimp [B]; omega
  have hraw2 := Nat.pow_le_pow_left hraw 2
  change 50*(1+(natBits n++tail).length)^2+(n.bits.length*(2*n.bits.length+5)+3)+
    (n.bits.length*(12*n.bits.length+4*out.length+28)+2*out.length+16)+1≤500*B^2
  nlinarith only [hB,hB2,hn,hn2,ho,hno,hraw2]
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.NatReadEmit

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.TinyTag
open Turing Qatlib.Concepts.BitWordCompiler.CanonicalCodec
abbrev Local := Fin 8×Symbol
inductive Label where | start | read (k : Fin 4) deriving DecidableEq,Fintype
instance : Inhabited Label := ⟨.start⟩

def next (a : Fin 8) (bit : Bool) : Fin 8 :=
  ⟨(2*a.val+if bit then 1 else 0)%8,Nat.mod_lt _ (by decide)⟩

def program : Label → TM2.Stmt (fun _ : Fin 1 => Bool) Label Local
  | .start => .load (fun v => (0,v.2)) (.goto (fun _ => .read 0))
  | .read k => .pop 0 (fun v bit => (v.1,bit))
      (if h : k.val<3 then
        .branch (fun v => v.2.isSome)
          (.load (fun v => (next v.1 (v.2.getD false),v.2))
            (.goto (fun _ => .read ⟨k.val+1,by omega⟩))) .halt
       else .load (fun v => (if v.2.isSome then 7 else v.1,v.2)) .halt)

theorem complete (n : Fin 8) (v : Local) :
    Stacks.stackRun program (n.val.bits.length+2) ⟨some .start,v,Normalization.singleStack n.val.bits.reverse⟩=
      some ⟨none,(n,none),Normalization.singleStack []⟩ ∧
    Stacks.stackRunClock program (n.val.bits.length+2) ⟨some .start,v,Normalization.singleStack n.val.bits.reverse⟩≤
      30*(1+n.val.bits.length)^2 := by
  fin_cases n <;>
    constructor <;>
    simp [show (2:ℕ).bits=[false,true] by rfl,show (3:ℕ).bits=[true,true] by rfl,
      show (4:ℕ).bits=[false,false,true] by rfl,show (5:ℕ).bits=[true,false,true] by rfl,
      show (6:ℕ).bits=[false,true,true] by rfl,show (7:ℕ).bits=[true,true,true] by rfl,
      Stacks.stackRun,Stacks.stackRunClock,TM2.step,program,TM2.stepAux,Stacks.stackClock,next]
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.TinyTag

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.PlanCopy
open Turing Qatlib.Concepts.BitWordCompiler.CanonicalCodec

inductive Slot where | reader | pending | markers | payload | value | temporary | output deriving DecidableEq,Fintype
abbrev Local := NatReadEmit.Local×TinyTag.Local×CountedTake.Local×Symbol

def getRead (v : Local) := v.1
def putRead (v : Local) (s : NatReadEmit.Local) : Local := (s,v.2)
def getTag (v : Local) := v.2.1
def putTag (v : Local) (s : TinyTag.Local) : Local := (v.1,s,v.2.2)
def getTake (v : Local) := v.2.2.1
def putTake (v : Local) (s : CountedTake.Local) : Local := (v.1,v.2.1,s,v.2.2.2)
def getIO (v : Local) := v.2.2.2
def putIO (v : Local) (s : Symbol) : Local := (v.1,v.2.1,v.2.2.1,s)

inductive Phase where
  | loop | planReady | dispatchPlan | literalReady | ignoredDone | readScalar | scalarReady | dispatchScalar
  | widthDone | pairFirstDone | readPairSecond
  deriving DecidableEq,Fintype
inductive Label where
  | read (ret : Phase) (l : NatReadEmit.Label)
  | transfer (ret : Phase) (l : Fin 1)
  | tag (ret : Phase) (l : TinyTag.Label)
  | take (ret : Phase) (l : CountedTake.Label)
  | drain (ret : Phase) (l : Fin 1)
  | step (phase : Phase)
  deriving DecidableEq,Fintype
instance : Inhabited Label := ⟨.step .loop⟩

def readCode : NatReadEmit.Slot → Slot
  | .reader => .reader | .markers => .markers | .payload => .payload
  | .value => .value | .temporary => .temporary | .output => .output

def transferCode : Fin 2 → Slot | 0 => .value | _ => .payload
def tagCode (_ : Fin 1) : Slot := .payload
def takeCode : Fin 4 → Slot | 0 => .value | 1 => .temporary | 2 => .reader | _ => .output
def drainCode (_ : Fin 1) : Slot := .value

def go (phase : Phase) : TM2.Stmt (fun _ : Slot => Bool) Label Local := .goto (fun _ => .step phase)
def readField (ret : Phase) : TM2.Stmt (fun _ : Slot => Bool) Label Local :=
    .goto (fun _ => .read ret (.read .unary))

def phaseProgram : Phase → TM2.Stmt (fun _ : Slot => Bool) Label Local
  | .loop => .pop .pending (fun v bit => putIO v bit) (.branch (fun v => (getIO v).isSome) (readField .planReady) .halt)
  | .planReady => .goto (fun _ => .transfer .dispatchPlan 0)
  | .dispatchPlan =>
      .branch (fun v => decide ((getTag v).1.val=0)) (readField .literalReady)
      (.branch (fun v => decide ((getTag v).1.val=1)) (readField .ignoredDone)
      (.branch (fun v => decide ((getTag v).1.val=2)) (readField .scalarReady)
      (.branch (fun v => decide ((getTag v).1.val=3)) (readField .widthDone)
      (.branch (fun v => decide ((getTag v).1.val=4)) (readField .pairFirstDone)
      (.branch (fun v => decide ((getTag v).1.val=5)) (.push .pending (fun _ => true) (.push .pending (fun _ => true) (go .loop)))
      (.branch (fun v => decide ((getTag v).1.val=6)) (.push .pending (fun _ => true) (readField .scalarReady)) .halt))))))
  | .literalReady => .goto (fun _ => .take .loop (.counter .borrow))
  | .ignoredDone => .goto (fun _ => .drain .loop 0)
  | .readScalar => readField .scalarReady
  | .scalarReady => .goto (fun _ => .transfer .dispatchScalar 0)
  | .dispatchScalar => .branch (fun v => decide ((getTag v).1.val=2)) (go .loop)
      (.branch (fun v => decide ((getTag v).1.val=0 ∨ (getTag v).1.val=1 ∨ (getTag v).1.val=3))
        (readField .ignoredDone) .halt)
  | .widthDone => .goto (fun _ => .drain .readScalar 0)
  | .pairFirstDone => .goto (fun _ => .drain .readPairSecond 0)
  | .readPairSecond => readField .ignoredDone

def program : Label → TM2.Stmt (fun _ : Slot => Bool) Label Local
  | .read ret l => StackCall.stmt readCode (Label.read ret) (.step ret) getRead putRead (NatReadEmit.program l)
  | .transfer ret l => StackCall.stmt transferCode (Label.transfer ret) (.tag ret .start) getIO putIO (Stacks.transferProgram l)
  | .tag ret l => StackCall.stmt tagCode (Label.tag ret) (.step ret) getTag putTag (TinyTag.program l)
  | .take ret l => StackCall.stmt takeCode (Label.take ret) (.step ret) getTake putTake (CountedTake.program l)
  | .drain ret l => StackCall.stmt drainCode (Label.drain ret) (.step ret) getIO putIO (Normalization.drainProgram l)
  | .step phase => phaseProgram phase

def store (reader pending value payload out : Bits) : Slot → Bits
  | .reader => reader | .pending => pending | .value => value | .payload => payload | .output => out | _ => []

theorem readCode_injective : Function.Injective readCode := by
    intro a b h; cases a <;> cases b <;> simp [readCode] at h ⊢

theorem transferCode_injective : Function.Injective transferCode := by
    intro a b h; fin_cases a <;> fin_cases b <;> simp [transferCode] at h ⊢

theorem takeCode_injective : Function.Injective takeCode := by
    intro a b h; fin_cases a <;> fin_cases b <;> simp [takeCode] at h ⊢

theorem read_call (ret : Phase) (n : ℕ) (tail pending out : Bits) (v : Local) : ∃ ticks,
    Stacks.stackRun program ticks ⟨some (.read ret (.read .unary)),v,store (natBits n++tail) pending [] [] out⟩=
      some ⟨some (.step ret),putRead v ((true,CheckedNat.lastField n.bits none),none),
        store tail pending n.bits [] ((natBits n).reverse++out)⟩ ∧
    Stacks.stackRunClock program ticks ⟨some (.read ret (.read .unary)),v,store (natBits n++tail) pending [] [] out⟩≤
      500*(1+(natBits n++tail).length+out.length)^2 := by
  let S := store (natBits n++tail) pending [] [] out
  let data := NatReadEmit.store (natBits n++tail) [] [] [] [] out
  have hsame : StackCall.frame readCode S data=S := by
    apply StackCall.frame_same _ _ _ readCode_injective
    intro k
    cases k <;> rfl
  dsimp only [data] at hsame
  obtain ⟨ticks,hr,hc⟩ := NatReadEmit.complete n tail out (getRead v)
  obtain ⟨hN,hNC⟩ := StackCall.execution readCode (Label.read ret) (.step ret) getRead putRead
    (StackCall.frame readCode S)
    (fun data k => StackCall.frame_at _ _ data readCode_injective k)
    (fun data k bits => StackCall.frame_update _ _ data readCode_injective k bits)
    (fun _ _ => rfl) (fun _ _ _ => rfl) NatReadEmit.program program (fun _ => rfl) v ticks _ _ hr
  have hfinal : StackCall.frame readCode S (NatReadEmit.store tail [] [] n.bits [] ((natBits n).reverse++out))=
      store tail pending n.bits [] ((natBits n).reverse++out) := by
    funext bank
    cases bank
    all_goals first
    | exact StackCall.frame_at readCode S _ readCode_injective NatReadEmit.Slot.reader
    | exact StackCall.frame_at readCode S _ readCode_injective NatReadEmit.Slot.markers
    | exact StackCall.frame_at readCode S _ readCode_injective NatReadEmit.Slot.payload
    | exact StackCall.frame_at readCode S _ readCode_injective NatReadEmit.Slot.value
    | exact StackCall.frame_at readCode S _ readCode_injective NatReadEmit.Slot.temporary
    | exact StackCall.frame_at readCode S _ readCode_injective NatReadEmit.Slot.output
    | (rw [WordValidator.frame_outside readCode S _ _ (by intro k; cases k <;> simp [readCode])]; rfl)
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,
    getRead,putRead,hsame,hfinal] at hN hNC
  exact ⟨ticks,hN,hNC.trans_le hc⟩

theorem transfer_call (ret : Phase) (n : ℕ) (reader pending out : Bits) (v : Local) :
    Stacks.stackRun program (n.bits.length+1) ⟨some (.transfer ret 0),v,store reader pending n.bits [] out⟩=
      some ⟨some (.tag ret .start),putIO v none,store reader pending [] n.bits.reverse out⟩ ∧
    Stacks.stackRunClock program (n.bits.length+1) ⟨some (.transfer ret 0),v,store reader pending n.bits [] out⟩=
      n.bits.length*(2*n.bits.length+5)+3 := by
  let S := store reader pending n.bits [] out
  have hsame : StackCall.frame transferCode S (Stacks.stackPair n.bits [])=S := by
    apply StackCall.frame_same _ _ _ transferCode_injective
    intro k
    fin_cases k <;> rfl
  have hfinal : StackCall.frame transferCode S (Stacks.stackPair [] n.bits.reverse)=store reader pending [] n.bits.reverse out := by
    funext bank
    cases bank
    all_goals first
    | exact StackCall.frame_at transferCode S _ transferCode_injective 0
    | exact StackCall.frame_at transferCode S _ transferCode_injective 1
    | (rw [WordValidator.frame_outside transferCode S _ _ (by intro k; fin_cases k <;> simp [transferCode])]; rfl)
  obtain ⟨hN,hNC⟩ := StackCall.execution transferCode (Label.transfer ret) (.tag ret .start) getIO putIO
    (StackCall.frame transferCode S)
    (fun data k => StackCall.frame_at _ _ data transferCode_injective k)
    (fun data k bits => StackCall.frame_update _ _ data transferCode_injective k bits)
    (fun _ _ => rfl) (fun _ _ _ => rfl) Stacks.transferProgram program (fun _ => rfl) v (n.bits.length+1) _ _ (Stacks.transfer_run n.bits [] (getIO v))
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,getIO,putIO,hsame,hfinal,List.append_nil] at hN hNC
  have hc := Stacks.transfer_clock n.bits [] (getIO v)
  simp only [List.length_nil,Nat.add_zero] at hc
  exact ⟨hN,hNC.trans hc⟩

theorem tag_call (ret : Phase) (n : Fin 8) (reader pending out : Bits) (v : Local) :
    Stacks.stackRun program (n.val.bits.length+2) ⟨some (.tag ret .start),v,store reader pending [] n.val.bits.reverse out⟩=
      some ⟨some (.step ret),putTag v (n,none),store reader pending [] [] out⟩ ∧
    Stacks.stackRunClock program (n.val.bits.length+2) ⟨some (.tag ret .start),v,store reader pending [] n.val.bits.reverse out⟩≤
      30*(1+n.val.bits.length)^2 := by
  let S := store reader pending [] n.val.bits.reverse out
  have hinj : Function.Injective tagCode := fun _ _ _ => Subsingleton.elim _ _
  have hsame : StackCall.frame tagCode S (Normalization.singleStack n.val.bits.reverse)=S := by
    apply StackCall.frame_same _ _ _ hinj
    intro k
    rfl
  have hfinal : StackCall.frame tagCode S (Normalization.singleStack [])=store reader pending [] [] out := by
    funext bank
    cases bank
    all_goals first
    | exact StackCall.frame_at tagCode S _ hinj 0
    | (rw [WordValidator.frame_outside tagCode S _ _ (by intro k; simp [tagCode])]; rfl)
  obtain ⟨hr,hc⟩ := TinyTag.complete n (getTag v)
  obtain ⟨hN,hNC⟩ := StackCall.execution tagCode (Label.tag ret) (.step ret) getTag putTag
    (StackCall.frame tagCode S)
    (fun data k => StackCall.frame_at _ _ data hinj k)
    (fun data k bits => StackCall.frame_update _ _ data hinj k bits)
    (fun _ _ => rfl) (fun _ _ _ => rfl) TinyTag.program program (fun _ => rfl) v (n.val.bits.length+2) _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,getTag,putTag,hsame,hfinal] at hN hNC
  exact ⟨hN,hNC.trans_le hc⟩

theorem classify_call (ret : Phase) (n : Fin 8) (reader pending out : Bits) (v : Local) : ∃ ticks last,
    Stacks.stackRun program ticks ⟨some (.transfer ret 0),v,store reader pending n.val.bits [] out⟩=
      some ⟨some (.step ret),last,store reader pending [] [] out⟩ ∧ (getTag last).1=n ∧
    Stacks.stackRunClock program ticks ⟨some (.transfer ret 0),v,store reader pending n.val.bits [] out⟩≤100*(1+n.val.bits.length)^2 := by
  obtain ⟨hT,hTC⟩ := transfer_call ret n.val reader pending out v
  obtain ⟨hC,hCC⟩ := tag_call ret n reader pending out (putIO v none)
  have eT : Stacks.Execution program _ _ _ := ⟨n.val.bits.length+1,hT,hTC.le⟩
  have eC : Stacks.Execution program _ _ _ := ⟨n.val.bits.length+2,hC,hCC⟩
  obtain ⟨ticks,hr,hc⟩ := eT.trans eC
  refine ⟨ticks,putTag (putIO v none) (n,none),hr,rfl,hc.trans ?_⟩
  nlinarith only [Nat.zero_le n.val.bits.length,Nat.zero_le (n.val.bits.length^2)]

theorem drain_call (ret : Phase) (reader pending value payload out : Bits) (v : Local) :
    Stacks.stackRun program (value.length+1) ⟨some (.drain ret 0),v,store reader pending value payload out⟩=
      some ⟨some (.step ret),putIO v none,store reader pending [] payload out⟩ ∧
    Stacks.stackRunClock program (value.length+1) ⟨some (.drain ret 0),v,store reader pending value payload out⟩=
      value.length^2+3*value.length+3 := by
  let S := store reader pending value payload out
  have hinj : Function.Injective drainCode := fun _ _ _ => Subsingleton.elim _ _
  have hsame : StackCall.frame drainCode S (Normalization.singleStack value)=S := by
    apply StackCall.frame_same _ _ _ hinj
    intro k
    rfl
  have hfinal : StackCall.frame drainCode S (Normalization.singleStack [])=store reader pending [] payload out := by
    funext bank
    cases bank
    all_goals first
    | exact StackCall.frame_at drainCode S _ hinj 0
    | (rw [WordValidator.frame_outside drainCode S _ _ (by intro k; simp [drainCode])]; rfl)
  have hr := Normalization.drain_run value (getIO v)
  obtain ⟨hN,hNC⟩ := StackCall.execution drainCode (Label.drain ret) (.step ret) getIO putIO
    (StackCall.frame drainCode S)
    (fun data k => StackCall.frame_at _ _ data hinj k)
    (fun data k bits => StackCall.frame_update _ _ data hinj k bits)
    (fun _ _ => rfl) (fun _ _ _ => rfl) Normalization.drainProgram program (fun _ => rfl) v (value.length+1) _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,getIO,putIO,hsame,hfinal] at hN hNC
  exact ⟨hN,hNC.trans (Normalization.drain_clock value (getIO v))⟩

theorem take_call (ret : Phase) (bits tail pending out : Bits) (v : Local) : ∃ ticks last,
    Stacks.stackRun program ticks ⟨some (.take ret (.counter .borrow)),v,store (bits++tail) pending bits.length.bits [] out⟩=
      some ⟨some (.step ret),last,store tail pending [] [] (bits.reverse++out)⟩ ∧
    Stacks.stackRunClock program ticks ⟨some (.take ret (.counter .borrow)),v,store (bits++tail) pending bits.length.bits [] out⟩≤
      150*(bits.length+1)*(1+bits.length.bits.length+(bits++tail).length+out.length+bits.length)^2 := by
  let S := store (bits++tail) pending bits.length.bits [] out
  have hsame : StackCall.frame takeCode S (Preparation.quad bits.length.bits [] (bits++tail) out)=S := by
    apply StackCall.frame_same _ _ _ takeCode_injective
    intro k
    fin_cases k <;> rfl
  have hfinal : StackCall.frame takeCode S (Preparation.quad [] [] tail (bits.reverse++out))=store tail pending [] [] (bits.reverse++out) := by
    funext bank
    cases bank
    all_goals first
    | exact StackCall.frame_at takeCode S _ takeCode_injective 0
    | exact StackCall.frame_at takeCode S _ takeCode_injective 1
    | exact StackCall.frame_at takeCode S _ takeCode_injective 2
    | exact StackCall.frame_at takeCode S _ takeCode_injective 3
    | (rw [WordValidator.frame_outside takeCode S _ _ (by intro k; fin_cases k <;> simp [takeCode])]; rfl)
  obtain ⟨ticks,hr,hc⟩ :=
      CountedTake.complete_prefix bits tail out bits.length.bits (getTake v)
      (binaryValue_bits bits.length)
  obtain ⟨hN,hNC⟩ := StackCall.execution takeCode (Label.take ret) (.step ret) getTake putTake
    (StackCall.frame takeCode S)
    (fun data k => StackCall.frame_at _ _ data takeCode_injective k)
    (fun data k bits => StackCall.frame_update _ _ data takeCode_injective k bits)
    (fun _ _ => rfl) (fun _ _ _ => rfl) CountedTake.program program (fun _ => rfl) v ticks _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,getTake,putTake,hsame,hfinal] at hN hNC
  exact ⟨ticks,putTake v ((false,none),none),hN,hNC.trans_le hc⟩

@[simp] theorem store_update_pending (reader pending value payload out next : Bits) :
    Function.update (store reader pending value payload out) .pending next=store reader next value payload out := by
  funext bank
  cases bank <;> rfl

theorem phase_step (phase : Phase) (S : Slot → Bits) (v : Local) :
    Stacks.stackRun program 1 ⟨some (.step phase),v,S⟩=some (TM2.stepAux (phaseProgram phase) v S) := rfl

theorem goto_phase (phase : Phase) (after : Label) (hcode : phaseProgram phase=.goto (fun _ => after))
    (S : Slot → Bits) (v : Local) :
    Stacks.stackRun program 1 ⟨some (.step phase),v,S⟩=some ⟨some after,v,S⟩ ∧
    Stacks.stackRunClock program 1 ⟨some (.step phase),v,S⟩=1 := by
  constructor
  · rw [phase_step,hcode]
    rfl
  · simp [Stacks.stackRunClock,program,hcode,Stacks.stackClock]

theorem ignored_field (ret next : Phase) (hcode : phaseProgram ret=.goto (fun _ => .drain next 0))
    (n : ℕ) (tail pending out : Bits) (v : Local) : ∃ ticks last,
    Stacks.stackRun program ticks ⟨some (.read ret (.read .unary)),v,store (natBits n++tail) pending [] [] out⟩=
      some ⟨some (.step next),last,store tail pending [] [] ((natBits n).reverse++out)⟩ ∧
    Stacks.stackRunClock program ticks ⟨some (.read ret (.read .unary)),v,store (natBits n++tail) pending [] [] out⟩≤
      1000*(1+(natBits n++tail).length+out.length)^2 := by
  obtain ⟨readTicks,hR,hRC⟩ := read_call ret n tail pending out v
  let v1 := putRead v ((true,CheckedNat.lastField n.bits none),none)
  let S1 := store tail pending n.bits [] ((natBits n).reverse++out)
  obtain ⟨hB,hBC⟩ := goto_phase ret (.drain next 0) hcode S1 v1
  obtain ⟨hD,hDC⟩ := drain_call next tail pending n.bits [] ((natBits n).reverse++out) v1
  have eR : Stacks.Execution program _ _ _ := ⟨readTicks,hR,hRC⟩
  have eB : Stacks.Execution program _ _ 1 := ⟨1,hB,hBC.le⟩
  have eD : Stacks.Execution program _ _ _ := ⟨n.bits.length+1,hD,hDC.le⟩
  obtain ⟨ticks,hr,hc⟩ := (eR.trans eB).trans eD
  refine ⟨ticks,putIO v1 none,hr,hc.trans ?_⟩
  let B := 1+(natBits n++tail).length+out.length
  have hB : 1≤B := by dsimp [B]; omega
  have hB2 : B≤B^2 := Nat.le_pow (by decide)
  have hn : n.bits.length≤B := by dsimp [B]; simp only [List.length_append,natBits_length]; omega
  have hn2 := Nat.mul_le_mul hn hn
  change 500*B^2+1+(n.bits.length^2+3*n.bits.length+3)≤1000*B^2
  nlinarith only [hB,hB2,hn,hn2]

theorem classified_field (ret next : Phase) (hcode : phaseProgram ret=.goto (fun _ => .transfer next 0))
    (n : Fin 8) (tail pending out : Bits) (v : Local) : ∃ ticks last,
    Stacks.stackRun program ticks ⟨some (.read ret (.read .unary)),v,store (natBits n.val++tail) pending [] [] out⟩=
      some ⟨some (.step next),last,store tail pending [] [] ((natBits n.val).reverse++out)⟩ ∧ (getTag last).1=n ∧
    Stacks.stackRunClock program ticks ⟨some (.read ret (.read .unary)),v,store (natBits n.val++tail) pending [] [] out⟩≤
      1000*(1+(natBits n.val++tail).length+out.length)^2 := by
  obtain ⟨readTicks,hR,hRC⟩ := read_call ret n.val tail pending out v
  let v1 := putRead v ((true,CheckedNat.lastField n.val.bits none),none)
  let S1 := store tail pending n.val.bits [] ((natBits n.val).reverse++out)
  obtain ⟨hB,hBC⟩ := goto_phase ret (.transfer next 0) hcode S1 v1
  obtain ⟨classTicks,last,hC,hval,hCC⟩ :=
      classify_call next n tail pending ((natBits n.val).reverse++out) v1
  have eR : Stacks.Execution program _ _ _ := ⟨readTicks,hR,hRC⟩
  have eB : Stacks.Execution program _ _ 1 := ⟨1,hB,hBC.le⟩
  have eC : Stacks.Execution program _ _ _ := ⟨classTicks,hC,hCC⟩
  obtain ⟨ticks,hr,hc⟩ := (eR.trans eB).trans eC
  refine ⟨ticks,last,hr,hval,hc.trans ?_⟩
  let B := 1+(natBits n.val++tail).length+out.length
  have hB : 1≤B := by dsimp [B]; omega
  have hB2 : 1≤B^2 := Nat.one_le_pow 2 _ hB
  have hn : 1+n.val.bits.length≤B := by
    dsimp [B]; simp only [List.length_append,natBits_length]; omega
  have hn2 := Nat.pow_le_pow_left hn 2
  change 500*B^2+1+100*(1+n.val.bits.length)^2≤1000*B^2
  nlinarith only [hB2,hn2]

def planAfter (tag : Fin 7) : Label :=
  match tag.val with
  | 0 => .read .literalReady (.read .unary)
  | 1 => .read .ignoredDone (.read .unary)
  | 2 => .read .scalarReady (.read .unary)
  | 3 => .read .widthDone (.read .unary)
  | 4 => .read .pairFirstDone (.read .unary)
  | 5 => .step .loop
  | _ => .read .scalarReady (.read .unary)

def planExtra (tag : Fin 7) : ℕ := if tag.val=5 then 2 else if tag.val=6 then 1 else 0

theorem dispatch_plan (tag : Fin 7) (reader pending out : Bits) (v : Local) (hval : (getTag v).1=tag.castSucc) :
    Stacks.stackRun program 1 ⟨some (.step .dispatchPlan),v,store reader pending [] [] out⟩=
      some ⟨some (planAfter tag),v,store reader (List.replicate (planExtra tag) true++pending) [] [] out⟩ ∧
    Stacks.stackRunClock program 1 ⟨some (.step .dispatchPlan),v,store reader pending [] [] out⟩≤10*(1+pending.length) := by
  fin_cases tag <;> constructor <;>
    simp [phase_step,phaseProgram,go,readField,TM2.stepAux,hval,planAfter,planExtra,
      Stacks.stackRunClock,program,Stacks.stackClock,store]
  all_goals omega

theorem dispatch_scalar (tag : Fin 4) (reader pending out : Bits) (v : Local)
    (hval : (getTag v).1=⟨tag.val,by omega⟩) :
    Stacks.stackRun program 1 ⟨some (.step .dispatchScalar),v,store reader pending [] [] out⟩=
      some ⟨some (if tag.val=2 then .step .loop else .read .ignoredDone (.read .unary)),v,store reader pending [] [] out⟩ ∧
    Stacks.stackRunClock program 1 ⟨some (.step .dispatchScalar),v,store reader pending [] [] out⟩=1 := by
  fin_cases tag <;> constructor <;>
    simp [phase_step,phaseProgram,go,readField,TM2.stepAux,hval,Stacks.stackRunClock,program,Stacks.stackClock]

theorem loop_enter (reader pending out : Bits) (v : Local) :
    Stacks.stackRun program 1 ⟨some (.step .loop),v,store reader (true::pending) [] [] out⟩=
      some ⟨some (.read .planReady (.read .unary)),putIO v (some true),store reader pending [] [] out⟩ ∧
    Stacks.stackRunClock program 1 ⟨some (.step .loop),v,store reader (true::pending) [] [] out⟩=2*pending.length+4 := by
  constructor
  · simp [phase_step,phaseProgram,readField,TM2.stepAux,store,getIO,putIO]
  · simp [Stacks.stackRunClock,program,phaseProgram,Stacks.stackClock,store,getIO,putIO,readField]
    omega

theorem loop_stop (reader out : Bits) (v : Local) :
    Stacks.stackRun program 1 ⟨some (.step .loop),v,store reader [] [] [] out⟩=
      some ⟨none,putIO v none,store reader [] [] [] out⟩ ∧
    Stacks.stackRunClock program 1 ⟨some (.step .loop),v,store reader [] [] [] out⟩=3 := by
  constructor
  · simp [phase_step,phaseProgram,TM2.stepAux,store,getIO,putIO]
  · simp [Stacks.stackRunClock,program,phaseProgram,Stacks.stackClock,store,getIO,putIO]

end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.PlanCopy

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.PlanCopy
open Turing Qatlib.Concepts.BitWordCompiler.CanonicalCodec

def scalarTag8 (tag : Fin 4) : Fin 8 := ⟨tag.val,by omega⟩

theorem scalar_operand (tag : Fin 4) (htag : tag.val≠2) (n : ℕ) (tail pending out : Bits) (v : Local) : ∃ ticks last,
    Stacks.stackRun program ticks ⟨some (.read .scalarReady (.read .unary)),v,
      store (natBits tag.val++(natBits n++tail)) pending [] [] out⟩=
      some ⟨some (.step .loop),last,store tail pending [] [] ((natBits tag.val++natBits n).reverse++out)⟩ ∧
    Stacks.stackRunClock program ticks ⟨some (.read .scalarReady (.read .unary)),v,
      store (natBits tag.val++(natBits n++tail)) pending [] [] out⟩≤
      3000*(1+(natBits tag.val++(natBits n++tail)).length+out.length)^2 := by
  obtain ⟨tagTicks,v1,hC,hval,hCC⟩ :=
      classified_field .scalarReady .dispatchScalar rfl (scalarTag8 tag)
      (natBits n++tail) pending out v
  obtain ⟨hD,hDC⟩ :=
      dispatch_scalar tag (natBits n++tail) pending ((natBits tag.val).reverse++out) v1 hval
  simp only [if_neg htag] at hD
  obtain ⟨readTicks,v2,hR,hRC⟩ :=
      ignored_field .ignoredDone .loop rfl n tail pending ((natBits tag.val).reverse++out) v1
  have eC : Stacks.Execution program _ _ _ := ⟨tagTicks,hC,hCC⟩
  have eD : Stacks.Execution program _ _ 1 := ⟨1,hD,hDC.le⟩
  have eR : Stacks.Execution program _ _ _ := ⟨readTicks,hR,hRC⟩
  obtain ⟨ticks,hr,hc⟩ := (eC.trans eD).trans eR
  refine ⟨ticks,v2,?_,hc.trans ?_⟩
  · simpa only [scalarTag8,List.reverse_append,List.append_assoc] using hr
  · let B := 1+(natBits tag.val++(natBits n++tail)).length+out.length
    have hB : 1≤B := by dsimp [B]; omega
    have hB2 : 1≤B^2 := Nat.one_le_pow 2 _ hB
    have he : 1+(natBits n++tail).length+((natBits tag.val).reverse++out).length=B := by
      dsimp [B]
      simp only [List.length_append,List.length_reverse]
      omega
    change 1000*B^2+1+1000*(1+(natBits n++tail).length+((natBits tag.val).reverse++out).length)^2≤3000*B^2
    rw [he]
    omega

theorem scalar_precision (tail pending out : Bits) (v : Local) : ∃ ticks last,
    Stacks.stackRun program ticks ⟨some (.read .scalarReady (.read .unary)),v,store (natBits 2++tail) pending [] [] out⟩=
      some ⟨some (.step .loop),last,store tail pending [] [] ((natBits 2).reverse++out)⟩ ∧
    Stacks.stackRunClock program ticks ⟨some (.read .scalarReady (.read .unary)),v,store (natBits 2++tail) pending [] [] out⟩≤
      3000*(1+(natBits 2++tail).length+out.length)^2 := by
  obtain ⟨tagTicks,v1,hC,hval,hCC⟩ :=
      classified_field .scalarReady .dispatchScalar rfl 2 tail pending out v
  obtain ⟨hD,hDC⟩ := dispatch_scalar 2 tail pending ((natBits 2).reverse++out) v1 hval
  have eC : Stacks.Execution program _ _ _ := ⟨tagTicks,hC,hCC⟩
  have eD : Stacks.Execution program _ _ 1 := ⟨1,hD,hDC.le⟩
  obtain ⟨ticks,hr,hc⟩ := eC.trans eD
  refine ⟨ticks,v1,hr,hc.trans ?_⟩
  have hpos : 1≤(1+(natBits 2++tail).length+out.length)^2 := Nat.one_le_pow 2 _ (by omega)
  change 1000*(1+(natBits 2++tail).length+out.length)^2+1≤3000*(1+(natBits 2++tail).length+out.length)^2
  omega

theorem scalar_complete (s : Scalar) (tail pending out : Bits) (v : Local) : ∃ ticks last,
    Stacks.stackRun program ticks ⟨some (.read .scalarReady (.read .unary)),v,store (scalarBits s++tail) pending [] [] out⟩=
      some ⟨some (.step .loop),last,store tail pending [] [] ((scalarBits s).reverse++out)⟩ ∧
    Stacks.stackRunClock program ticks ⟨some (.read .scalarReady (.read .unary)),v,store (scalarBits s++tail) pending [] [] out⟩≤
      3000*(1+(scalarBits s++tail).length+out.length)^2 := by
  cases s with
  | literal n => simpa only [scalarBits,List.append_assoc] using! scalar_operand 0 (by decide) n tail pending out v
  | parameter i => simpa only [scalarBits,List.append_assoc] using! scalar_operand 1 (by decide) i tail pending out v
  | precision => exact scalar_precision tail pending out v
  | counter i => simpa only [scalarBits,List.append_assoc] using! scalar_operand 3 (by decide) i tail pending out v

def planTag : Plan → Fin 7
  | .literal _ => 0 | .copy _ => 1 | .emitNat _ => 2 | .fixedCount _ _ => 3
  | .pairScan _ _ => 4 | .append _ _ => 5 | .repeat _ _ => 6

def bodyHead : Plan → Bits
  | .literal bits => framed bits
  | .copy i => natBits i
  | .emitNat arg => scalarBits arg
  | .fixedCount width arg => natBits width++scalarBits arg
  | .pairScan i j => natBits i++natBits j
  | .append _ _ => []
  | .repeat bound _ => scalarBits bound

def children : Plan → List Plan
  | .append a b => [a,b] | .repeat _ body => [body] | _ => []

def headBits (p : Plan) : Bits := natBits (planTag p).val++bodyHead p

theorem planBits_parts (p : Plan) : planBits p=headBits p++(children p).flatMap planBits := by
  cases p <;> simp [headBits,planTag,bodyHead,children,planBits,List.append_assoc]

theorem body_copy (i : ℕ) (tail pending out : Bits) (v : Local) : ∃ ticks last,
    Stacks.stackRun program ticks ⟨some (planAfter (planTag (.copy i))),v,store (bodyHead (.copy i)++tail) pending [] [] out⟩=
      some ⟨some (.step .loop),last,store tail pending [] [] ((bodyHead (.copy i)).reverse++out)⟩ ∧
    Stacks.stackRunClock program ticks ⟨some (planAfter (planTag (.copy i))),v,store (bodyHead (.copy i)++tail) pending [] [] out⟩≤
      10000*(1+(bodyHead (.copy i)).length)*(1+(bodyHead (.copy i)++tail).length+out.length)^2 := by
  obtain ⟨ticks,last,hr,hc⟩ := ignored_field .ignoredDone .loop rfl i tail pending out v
  refine ⟨ticks,last,hr,hc.trans ?_⟩
  dsimp only [bodyHead]
  nlinarith only [Nat.zero_le ((natBits i).length*(1+(natBits i++tail).length+out.length)^2),Nat.zero_le ((1+(natBits i++tail).length+out.length)^2)]

theorem body_literal (bits tail pending out : Bits) (v : Local) : ∃ ticks last,
    Stacks.stackRun program ticks ⟨some (.read .literalReady (.read .unary)),v,store (framed bits++tail) pending [] [] out⟩=
      some ⟨some (.step .loop),last,store tail pending [] [] ((framed bits).reverse++out)⟩ ∧
    Stacks.stackRunClock program ticks ⟨some (.read .literalReady (.read .unary)),v,store (framed bits++tail) pending [] [] out⟩≤
      10000*(1+(framed bits).length)*(1+(framed bits++tail).length+out.length)^2 := by
  obtain ⟨readTicks,hR,hRC⟩ := read_call .literalReady bits.length (bits++tail) pending out v
  let v1 := putRead v ((true,CheckedNat.lastField bits.length.bits none),none)
  let S1 := store (bits++tail) pending bits.length.bits [] ((natBits bits.length).reverse++out)
  obtain ⟨hB,hBC⟩ := goto_phase .literalReady (.take .loop (.counter .borrow)) rfl S1 v1
  obtain ⟨takeTicks,v2,hT,hTC⟩ :=
      take_call .loop bits tail pending ((natBits bits.length).reverse++out) v1
  have eR : Stacks.Execution program _ _ _ := ⟨readTicks,hR,hRC⟩
  have eB : Stacks.Execution program _ _ 1 := ⟨1,hB,hBC.le⟩
  have eT : Stacks.Execution program _ _ _ := ⟨takeTicks,hT,hTC⟩
  obtain ⟨ticks,hr,hc⟩ := (eR.trans eB).trans eT
  refine ⟨ticks,v2,?_,?_⟩
  · simpa only [framed,List.append_assoc,List.reverse_append] using hr
  · have he : natBits bits.length++(bits++tail)=framed bits++tail := by simp only [framed,List.append_assoc]
    rw [he] at hc
    refine hc.trans ?_
    let B := 1+(framed bits++tail).length+out.length
    have hB : 1≤B := by dsimp [B]; omega
    have hB2 : 1≤B^2 := Nat.one_le_pow 2 _ hB
    have hbit : bits.length≤(framed bits).length := by simp only [framed,List.length_append]; omega
    have hargs : 1+bits.length.bits.length+(bits++tail).length+((natBits bits.length).reverse++out).length+bits.length≤2*B := by
      dsimp [B]
      simp only [framed,List.length_append,List.length_reverse,natBits_length]
      omega
    have hargs2 := Nat.pow_le_pow_left hargs 2
    have hmul := Nat.mul_le_mul_left (150*(bits.length+1)) hargs2
    change 500*B^2+1+150*(bits.length+1)*_≤10000*(1+(framed bits).length)*B^2
    nlinarith only [hmul,hB2,Nat.mul_le_mul_right (B^2) hbit,Nat.zero_le (B^2)]

theorem body_fixed (width : ℕ) (arg : Scalar) (tail pending out : Bits) (v : Local) : ∃ ticks last,
    Stacks.stackRun program ticks ⟨some (.read .widthDone (.read .unary)),v,
      store ((natBits width++scalarBits arg)++tail) pending [] [] out⟩=
      some ⟨some (.step .loop),last,store tail pending [] [] ((natBits width++scalarBits arg).reverse++out)⟩ ∧
    Stacks.stackRunClock program ticks ⟨some (.read .widthDone (.read .unary)),v,
      store ((natBits width++scalarBits arg)++tail) pending [] [] out⟩≤
      10000*(1+(natBits width++scalarBits arg).length)*(1+((natBits width++scalarBits arg)++tail).length+out.length)^2 := by
  obtain ⟨widthTicks,v1,hW,hWC⟩ :=
      ignored_field .widthDone .readScalar rfl width (scalarBits arg++tail) pending out v
  let S1 := store (scalarBits arg++tail) pending [] [] ((natBits width).reverse++out)
  obtain ⟨hB,hBC⟩ := goto_phase .readScalar (.read .scalarReady (.read .unary)) rfl S1 v1
  obtain ⟨scalarTicks,v2,hS,hSC⟩ :=
      scalar_complete arg tail pending ((natBits width).reverse++out) v1
  have eW : Stacks.Execution program _ _ _ := ⟨widthTicks,hW,hWC⟩
  have eB : Stacks.Execution program _ _ 1 := ⟨1,hB,hBC.le⟩
  have eS : Stacks.Execution program _ _ _ := ⟨scalarTicks,hS,hSC⟩
  obtain ⟨ticks,hr,hc⟩ := (eW.trans eB).trans eS
  refine ⟨ticks,v2,?_,?_⟩
  · simpa only [List.append_assoc,List.reverse_append] using hr
  · let B := 1+((natBits width++scalarBits arg)++tail).length+out.length
    have he1 : 1+(natBits width++(scalarBits arg++tail)).length+out.length=B := by
      simp only [B,List.append_assoc]
    have he2 : 1+(scalarBits arg++tail).length+((natBits width).reverse++out).length=B := by
      dsimp [B]
      simp only [List.length_append,List.length_reverse]
      omega
    rw [he1,he2] at hc
    have hB : 1≤B^2 := Nat.one_le_pow 2 _ (by dsimp [B]; omega)
    have hbound : 1000*B^2+1+3000*B^2≤10000*(1+(natBits width++scalarBits arg).length)*B^2 := by
      nlinarith only [hB,Nat.zero_le ((natBits width++scalarBits arg).length*B^2)]
    simpa only [B,List.append_assoc] using hc.trans hbound

theorem body_pair (i j : ℕ) (tail pending out : Bits) (v : Local) : ∃ ticks last,
    Stacks.stackRun program ticks ⟨some (.read .pairFirstDone (.read .unary)),v,
      store ((natBits i++natBits j)++tail) pending [] [] out⟩=
      some ⟨some (.step .loop),last,store tail pending [] [] ((natBits i++natBits j).reverse++out)⟩ ∧
    Stacks.stackRunClock program ticks ⟨some (.read .pairFirstDone (.read .unary)),v,
      store ((natBits i++natBits j)++tail) pending [] [] out⟩≤
      10000*(1+(natBits i++natBits j).length)*(1+((natBits i++natBits j)++tail).length+out.length)^2 := by
  obtain ⟨firstTicks,v1,hF,hFC⟩ :=
      ignored_field .pairFirstDone .readPairSecond rfl i (natBits j++tail) pending out v
  let S1 := store (natBits j++tail) pending [] [] ((natBits i).reverse++out)
  obtain ⟨hB,hBC⟩ := goto_phase .readPairSecond (.read .ignoredDone (.read .unary)) rfl S1 v1
  obtain ⟨secondTicks,v2,hS,hSC⟩ :=
      ignored_field .ignoredDone .loop rfl j tail pending ((natBits i).reverse++out) v1
  have eF : Stacks.Execution program _ _ _ := ⟨firstTicks,hF,hFC⟩
  have eB : Stacks.Execution program _ _ 1 := ⟨1,hB,hBC.le⟩
  have eS : Stacks.Execution program _ _ _ := ⟨secondTicks,hS,hSC⟩
  obtain ⟨ticks,hr,hc⟩ := (eF.trans eB).trans eS
  refine ⟨ticks,v2,?_,?_⟩
  · simpa only [List.append_assoc,List.reverse_append] using hr
  · let B := 1+((natBits i++natBits j)++tail).length+out.length
    have he1 : 1+(natBits i++(natBits j++tail)).length+out.length=B := by
      simp only [B,List.append_assoc]
    have he2 : 1+(natBits j++tail).length+((natBits i).reverse++out).length=B := by
      dsimp [B]
      simp only [List.length_append,List.length_reverse]
      omega
    rw [he1,he2] at hc
    have hB : 1≤B^2 := Nat.one_le_pow 2 _ (by dsimp [B]; omega)
    have hbound : 1000*B^2+1+1000*B^2≤10000*(1+(natBits i++natBits j).length)*B^2 := by
      nlinarith only [hB,Nat.zero_le ((natBits i++natBits j).length*B^2)]
    simpa only [B,List.append_assoc] using hc.trans hbound

theorem body_complete (p : Plan) (tail pending out : Bits) (v : Local) : ∃ ticks last,
    Stacks.stackRun program ticks ⟨some (planAfter (planTag p)),v,store (bodyHead p++tail) pending [] [] out⟩=
      some ⟨some (.step .loop),last,store tail pending [] [] ((bodyHead p).reverse++out)⟩ ∧
    Stacks.stackRunClock program ticks ⟨some (planAfter (planTag p)),v,store (bodyHead p++tail) pending [] [] out⟩≤
      10000*(1+(bodyHead p).length)*(1+(bodyHead p++tail).length+out.length)^2 := by
  cases p with
  | literal bits => exact body_literal bits tail pending out v
  | copy i => exact body_copy i tail pending out v
  | emitNat arg =>
    obtain ⟨ticks,last,hr,hc⟩ := scalar_complete arg tail pending out v
    refine ⟨ticks,last,hr,hc.trans ?_⟩
    change 3000*(1+(scalarBits arg++tail).length+out.length)^2≤
      10000*(1+(scalarBits arg).length)*(1+(scalarBits arg++tail).length+out.length)^2
    nlinarith only [Nat.zero_le ((scalarBits arg).length*(1+(scalarBits arg++tail).length+out.length)^2),Nat.zero_le ((1+(scalarBits arg++tail).length+out.length)^2)]
  | fixedCount width arg => exact body_fixed width arg tail pending out v
  | pairScan i j => exact body_pair i j tail pending out v
  | append a b => exact ⟨0,v,rfl,Nat.zero_le _⟩
  | «repeat» bound body =>
    obtain ⟨ticks,last,hr,hc⟩ := scalar_complete bound tail pending out v
    refine ⟨ticks,last,hr,hc.trans ?_⟩
    change 3000*(1+(scalarBits bound++tail).length+out.length)^2≤
      10000*(1+(scalarBits bound).length)*(1+(scalarBits bound++tail).length+out.length)^2
    nlinarith only [Nat.zero_le ((scalarBits bound).length*(1+(scalarBits bound++tail).length+out.length)^2),Nat.zero_le ((1+(scalarBits bound++tail).length+out.length)^2)]

def scanSize (reader out : Bits) (pending : ℕ) : ℕ := 1+3*reader.length+out.length+2*pending

theorem head_positive (p : Plan) : 1≤(headBits p).length := by
  simp only [headBits,List.length_append,natBits_length]
  omega

theorem extra_children (p : Plan) : planExtra (planTag p)=(children p).length := by cases p <;> rfl

theorem children_length (p : Plan) : (children p).length≤2 := by cases p <;> simp [children]

theorem replicate_extra (n m : ℕ) : List.replicate n true++List.replicate m true=List.replicate (m+n) true := by
  rw [← List.replicate_add,Nat.add_comm n m]

theorem root_step (p : Plan) (tail out : Bits) (pending : ℕ) (v : Local) : ∃ ticks last,
    Stacks.stackRun program ticks ⟨some (.step .loop),v,store (planBits p++tail) (List.replicate (pending+1) true) [] [] out⟩=
      some ⟨some (.step .loop),last,store ((children p).flatMap planBits++tail)
        (List.replicate (pending+(children p).length) true) [] [] ((headBits p).reverse++out)⟩ ∧
    Stacks.stackRunClock program ticks ⟨some (.step .loop),v,store (planBits p++tail) (List.replicate (pending+1) true) [] [] out⟩≤
      20000*(headBits p).length*(scanSize (planBits p++tail) out (pending+1))^2 := by
  let input := planBits p++tail
  let rest := bodyHead p++((children p).flatMap planBits++tail)
  let tag := planTag p
  let afterTag := (natBits tag.val).reverse++out
  have hi : input=natBits tag.val++rest := by
    dsimp [input,tag,rest]
    rw [planBits_parts]
    simp only [headBits,List.append_assoc]
  obtain ⟨hL,hLC⟩ := loop_enter input (List.replicate pending true) out v
  simp only [← List.replicate_succ,List.length_replicate] at hL hLC
  let v1 := putIO v (some true)
  obtain ⟨tagTicks,v2,hC,hval,hCC⟩ :=
      classified_field .planReady .dispatchPlan rfl tag.castSucc rest
      (List.replicate pending true) out v1
  change Stacks.stackRunClock program tagTicks ⟨some (.read .planReady (.read .unary)),v1,
    store (natBits tag.val++rest) (List.replicate pending true) [] [] out⟩≤
    1000*(1+(natBits tag.val++rest).length+out.length)^2 at hCC
  change Stacks.stackRun program tagTicks ⟨some (.read .planReady (.read .unary)),v1,store (natBits tag.val++rest) (List.replicate pending true) [] [] out⟩=
    some ⟨some (.step .dispatchPlan),v2,store rest (List.replicate pending true) [] [] afterTag⟩ at hC
  rw [← hi] at hC hCC
  obtain ⟨hD,hDC⟩ := dispatch_plan tag rest (List.replicate pending true) afterTag v2 hval
  rw [show planExtra tag=(children p).length from extra_children p,replicate_extra] at hD
  simp only [List.length_replicate] at hDC
  obtain ⟨bodyTicks,v3,hB,hBC⟩ := body_complete p ((children p).flatMap planBits++tail)
    (List.replicate (pending+(children p).length) true) afterTag v2
  have eL : Stacks.Execution program _ _ _ := ⟨1,hL,hLC.le⟩
  have eC : Stacks.Execution program _ _ _ := ⟨tagTicks,hC,hCC⟩
  have eD : Stacks.Execution program _ _ _ := ⟨1,hD,hDC⟩
  have eB : Stacks.Execution program _ _ _ := ⟨bodyTicks,hB,hBC⟩
  obtain ⟨ticks,hr,hc⟩ := ((eL.trans eC).trans eD).trans eB
  refine ⟨ticks,v3,?_,hc.trans ?_⟩
  · simpa only [input,afterTag,tag,headBits,List.reverse_append,List.append_assoc] using hr
  · let B := scanSize input out (pending+1)
    let A := 1+input.length+out.length
    have hB : 1≤B := by dsimp [B,scanSize]; omega
    have hB2 : B≤B^2 := Nat.le_pow (by decide)
    have hm : pending+1≤B := by dsimp [B,scanSize]; omega
    have hA : A≤B := by dsimp [A,B,scanSize]; omega
    have hA2 := Nat.pow_le_pow_left hA 2
    have he : 1+(bodyHead p++((children p).flatMap planBits++tail)).length+afterTag.length=A := by
      dsimp [A,afterTag]
      rw [hi]
      dsimp [rest]
      simp only [List.length_append,List.length_reverse]
      omega
    rw [he]
    have hhead : 1+ (bodyHead p).length≤(headBits p).length := by
      simp only [headBits,List.length_append,natBits_length]
      omega
    have hmulC := Nat.mul_le_mul_left 1000 hA2
    have hmulB := Nat.mul_le_mul_left (10000*(1+(bodyHead p).length)) hA2
    have hheadMul := Nat.mul_le_mul_right (B^2) hhead
    have hposMul := Nat.mul_le_mul_right (B^2) (head_positive p)
    have hsmall : 2*pending+4+10*(1+pending)≤14*B^2 := by omega
    change (2*pending+4)+1000*A^2+10*(1+pending)+10000*(1+(bodyHead p).length)*A^2≤20000*(headBits p).length*B^2
    nlinarith only [hmulC,hmulB,hheadMul,hposMul,hsmall]

theorem one_leaf (p : Plan) (hleaf : children p=[]) (tail out : Bits) (pending : ℕ) (v : Local) : ∃ ticks last,
    Stacks.stackRun program ticks ⟨some (.step .loop),v,store (planBits p++tail) (List.replicate (pending+1) true) [] [] out⟩=
      some ⟨some (.step .loop),last,store tail (List.replicate pending true) [] [] ((planBits p).reverse++out)⟩ ∧
    Stacks.stackRunClock program ticks ⟨some (.step .loop),v,store (planBits p++tail) (List.replicate (pending+1) true) [] [] out⟩≤
      20000*(planBits p).length*(scanSize (planBits p++tail) out (pending+1))^2 := by
  have hp : planBits p=headBits p := by
    rw [planBits_parts,hleaf,List.flatMap_nil,List.append_nil]
  simpa only [hleaf,List.flatMap_nil,List.nil_append,List.length_nil,Nat.add_zero,← hp] using
      root_step p tail out pending v

theorem one (p : Plan) (tail out : Bits) (pending : ℕ) (v : Local) : ∃ ticks last,
    Stacks.stackRun program ticks ⟨some (.step .loop),v,store (planBits p++tail) (List.replicate (pending+1) true) [] [] out⟩=
      some ⟨some (.step .loop),last,store tail (List.replicate pending true) [] [] ((planBits p).reverse++out)⟩ ∧
    Stacks.stackRunClock program ticks ⟨some (.step .loop),v,store (planBits p++tail) (List.replicate (pending+1) true) [] [] out⟩≤
      20000*(planBits p).length*(scanSize (planBits p++tail) out (pending+1))^2 := by
  induction p generalizing tail out pending v with
  | literal bits => exact one_leaf (.literal bits) rfl tail out pending v
  | copy i => exact one_leaf (.copy i) rfl tail out pending v
  | emitNat arg => exact one_leaf (.emitNat arg) rfl tail out pending v
  | fixedCount width arg => exact one_leaf (.fixedCount width arg) rfl tail out pending v
  | pairScan i j => exact one_leaf (.pairScan i j) rfl tail out pending v
  | append a b iha ihb =>
    obtain ⟨rootTicks,v1,hR,hRC⟩ := root_step (.append a b) tail out pending v
    simp only [children,List.flatMap_cons,List.flatMap_nil,List.append_nil,List.length_cons,List.length_nil,List.append_assoc] at hR
    let out1 := (headBits (.append a b)).reverse++out
    obtain ⟨firstTicks,v2,hA,hAC⟩ := iha (planBits b++tail) out1 (pending+1) v1
    let out2 := (planBits a).reverse++out1
    obtain ⟨secondTicks,v3,hB,hBC⟩ := ihb tail out2 pending v2
    have eR : Stacks.Execution program _ _ _ := ⟨rootTicks,hR,hRC⟩
    have eA : Stacks.Execution program _ _ _ := ⟨firstTicks,hA,hAC⟩
    have eB : Stacks.Execution program _ _ _ := ⟨secondTicks,hB,hBC⟩
    obtain ⟨ticks,hr,hc⟩ := (eR.trans eA).trans eB
    refine ⟨ticks,v3,?_,hc.trans ?_⟩
    · simpa only
        [planBits,headBits,planTag,bodyHead,List.append_nil,List.reverse_append,List.append_assoc,out1,out2] using! hr
    · let B := scanSize (planBits (.append a b)++tail) out (pending+1)
      let A := scanSize (planBits a++(planBits b++tail)) out1 (pending+1+1)
      let D := scanSize (planBits b++tail) out2 (pending+1)
      have hlen : (planBits (.append a b)).length=(headBits (.append a b)).length+(planBits a).length+(planBits b).length := by
        rw [planBits_parts (.append a b)]
        simp only [children,List.flatMap_cons,List.flatMap_nil,List.append_nil,List.length_append]
        omega
      have hhead := head_positive (.append a b)
      have hA : A≤B := by
        dsimp [A,B,scanSize,out1]
        simp only [List.length_append,List.length_reverse]
        omega
      have hD : D≤B := by
        dsimp [D,B,scanSize,out1,out2]
        simp only [List.length_append,List.length_reverse]
        omega
      have hA2 := Nat.mul_le_mul_left (20000*(planBits a).length) (Nat.pow_le_pow_left hA 2)
      have hD2 := Nat.mul_le_mul_left (20000*(planBits b).length) (Nat.pow_le_pow_left hD 2)
      change 20000*(headBits (.append a b)).length*B^2+20000*(planBits a).length*A^2+20000*(planBits b).length*D^2≤20000*(planBits (.append a b)).length*B^2
      rw [hlen]
      nlinarith only [hA2,hD2]
  | «repeat» bound body ih =>
    obtain ⟨rootTicks,v1,hR,hRC⟩ := root_step (.repeat bound body) tail out pending v
    simp only [children,List.flatMap_cons,List.flatMap_nil,List.append_nil,List.length_cons,List.length_nil] at hR
    let out1 := (headBits (.repeat bound body)).reverse++out
    obtain ⟨bodyTicks,v2,hB,hBC⟩ := ih tail out1 pending v1
    have eR : Stacks.Execution program _ _ _ := ⟨rootTicks,hR,hRC⟩
    have eB : Stacks.Execution program _ _ _ := ⟨bodyTicks,hB,hBC⟩
    obtain ⟨ticks,hr,hc⟩ := eR.trans eB
    refine ⟨ticks,v2,?_,hc.trans ?_⟩
    · simpa only
        [planBits,headBits,planTag,bodyHead,List.reverse_append,List.append_assoc,out1] using! hr
    · let B := scanSize (planBits (.repeat bound body)++tail) out (pending+1)
      let A := scanSize (planBits body++tail) out1 (pending+1)
      have hlen : (planBits (.repeat bound body)).length=(headBits (.repeat bound body)).length+(planBits body).length := by
        rw [planBits_parts (.repeat bound body)]
        simp only [children,List.flatMap_cons,List.flatMap_nil,List.append_nil,List.length_append]
      have hA : A≤B := by
        dsimp [A,B,scanSize,out1]
        simp only [List.length_append,List.length_reverse]
        omega
      have hA2 := Nat.mul_le_mul_left (20000*(planBits body).length) (Nat.pow_le_pow_left hA 2)
      change 20000*(headBits (.repeat bound body)).length*B^2+20000*(planBits body).length*A^2≤20000*(planBits (.repeat bound body)).length*B^2
      rw [hlen]
      nlinarith only [hA2]

theorem complete (p : Plan) (tail out : Bits) (v : Local) : ∃ ticks last,
    Stacks.stackRun program ticks ⟨some (.step .loop),v,store (planBits p++tail) [true] [] [] out⟩=
      some ⟨none,last,store tail [] [] [] ((planBits p).reverse++out)⟩ ∧
    Stacks.stackRunClock program ticks ⟨some (.step .loop),v,store (planBits p++tail) [true] [] [] out⟩≤
      30000*(1+(planBits p).length)*(scanSize (planBits p++tail) out 1)^2 := by
  obtain ⟨scanTicks,v1,hS,hSC⟩ := one p tail out 0 v
  obtain ⟨hH,hHC⟩ := loop_stop tail ((planBits p).reverse++out) v1
  have eS : Stacks.Execution program _ _ _ := ⟨scanTicks,hS,hSC⟩
  have eH : Stacks.Execution program _ _ 3 := ⟨1,hH,hHC.le⟩
  obtain ⟨ticks,hr,hc⟩ := eS.trans eH
  refine ⟨ticks,putIO v1 none,hr,hc.trans ?_⟩
  have hB : 1≤(scanSize (planBits p++tail) out 1)^2 :=
      Nat.one_le_pow 2 _ (by dsimp [scanSize]; omega)
  nlinarith only [hB,Nat.zero_le ((planBits p).length*(scanSize (planBits p++tail) out 1)^2)]

end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.PlanCopy

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.FramedTake
open Turing Qatlib.Concepts.BitWordCompiler.CanonicalCodec
inductive Slot where | reader | markers | payload | count | temporary | header | output deriving DecidableEq,Fintype
abbrev Local := NatReadEmit.Local×CountedTake.Local×Symbol
inductive Label where | read (l : NatReadEmit.Label) | take (l : CountedTake.Label) | drain (l : Fin 1) | done deriving DecidableEq,Fintype
instance : Inhabited Label := ⟨.read (.read .unary)⟩
def getRead (v : Local) := v.1
def putRead (v : Local) (s : NatReadEmit.Local) : Local := (s,v.2)
def getTake (v : Local) := v.2.1
def putTake (v : Local) (s : CountedTake.Local) : Local := (v.1,s,v.2.2)
def getIO (v : Local) := v.2.2
def putIO (v : Local) (s : Symbol) : Local := (v.1,v.2.1,s)

def readCode : NatReadEmit.Slot → Slot
  | .reader => .reader | .markers => .markers | .payload => .payload
  | .value => .count | .temporary => .temporary | .output => .header
def takeCode : Fin 4 → Slot | 0 => .count | 1 => .temporary | 2 => .reader | _ => .output
def drainCode (_ : Fin 1) : Slot := .header

def program : Label → TM2.Stmt (fun _ : Slot => Bool) Label Local
  | .read l => StackCall.stmt readCode Label.read (.take (.counter .borrow)) getRead putRead (NatReadEmit.program l)
  | .take l => StackCall.stmt takeCode Label.take (.drain 0) getTake putTake (CountedTake.program l)
  | .drain l => StackCall.stmt drainCode Label.drain .done getIO putIO (Normalization.drainProgram l)
  | .done => .halt

def store (reader count header output : Bits) : Slot → Bits
  | .reader => reader | .count => count | .header => header | .output => output | _ => []

theorem readCode_injective : Function.Injective readCode := by
    intro a b h; cases a <;> cases b <;> simp [readCode] at h ⊢

theorem takeCode_injective : Function.Injective takeCode := by
    intro a b h; fin_cases a <;> fin_cases b <;> simp [takeCode] at h ⊢

theorem read_call (n : ℕ) (tail out : Bits) (v : Local) : ∃ ticks last,
    Stacks.stackRun program ticks ⟨some (.read (.read .unary)),v,store (natBits n++tail) [] [] out⟩=
      some ⟨some (.take (.counter .borrow)),last,store tail n.bits (natBits n).reverse out⟩ ∧
    Stacks.stackRunClock program ticks ⟨some (.read (.read .unary)),v,store (natBits n++tail) [] [] out⟩≤
      500*(1+(natBits n++tail).length)^2 := by
  let S := store (natBits n++tail) [] [] out
  have hsame : StackCall.frame readCode S (NatReadEmit.store (natBits n++tail) [] [] [] [] [])=S := by
    apply StackCall.frame_same _ _ _ readCode_injective
    intro k
    cases k <;> rfl
  have hfinal : StackCall.frame readCode S (NatReadEmit.store tail [] [] n.bits [] (natBits n).reverse)=store tail n.bits (natBits n).reverse out := by
    funext bank
    cases bank
    all_goals first
    | exact StackCall.frame_at readCode S _ readCode_injective NatReadEmit.Slot.reader
    | exact StackCall.frame_at readCode S _ readCode_injective NatReadEmit.Slot.markers
    | exact StackCall.frame_at readCode S _ readCode_injective NatReadEmit.Slot.payload
    | exact StackCall.frame_at readCode S _ readCode_injective NatReadEmit.Slot.value
    | exact StackCall.frame_at readCode S _ readCode_injective NatReadEmit.Slot.temporary
    | exact StackCall.frame_at readCode S _ readCode_injective NatReadEmit.Slot.output
    | (rw [WordValidator.frame_outside readCode S _ _ (by intro k; cases k <;> simp [readCode])]; rfl)
  obtain ⟨ticks,hr,hc⟩ := NatReadEmit.complete n tail [] (getRead v)
  simp only [List.append_nil,List.length_nil,Nat.add_zero] at hr hc
  obtain ⟨hN,hNC⟩ := StackCall.execution readCode Label.read (.take (.counter .borrow)) getRead putRead
    (StackCall.frame readCode S)
    (fun data k => StackCall.frame_at _ _ data readCode_injective k)
    (fun data k bits => StackCall.frame_update _ _ data readCode_injective k bits)
    (fun _ _ => rfl) (fun _ _ _ => rfl) NatReadEmit.program program (fun _ => rfl) v ticks _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,getRead,putRead,hsame,hfinal] at hN hNC
  exact ⟨ticks,_,hN,hNC.trans_le hc⟩

theorem take_call (bits tail header out : Bits) (v : Local) : ∃ ticks last,
    Stacks.stackRun program ticks ⟨some (.take (.counter .borrow)),v,store (bits++tail) bits.length.bits header out⟩=
      some ⟨some (.drain 0),last,store tail [] header (bits.reverse++out)⟩ ∧
    Stacks.stackRunClock program ticks ⟨some (.take (.counter .borrow)),v,store (bits++tail) bits.length.bits header out⟩≤
      150*(bits.length+1)*(1+bits.length.bits.length+(bits++tail).length+out.length+bits.length)^2 := by
  let S := store (bits++tail) bits.length.bits header out
  have hsame : StackCall.frame takeCode S (Preparation.quad bits.length.bits [] (bits++tail) out)=S := by
    apply StackCall.frame_same _ _ _ takeCode_injective
    intro k
    fin_cases k <;> rfl
  have hfinal : StackCall.frame takeCode S (Preparation.quad [] [] tail (bits.reverse++out))=store tail [] header (bits.reverse++out) := by
    funext bank
    cases bank
    all_goals first
    | exact StackCall.frame_at takeCode S _ takeCode_injective 0
    | exact StackCall.frame_at takeCode S _ takeCode_injective 1
    | exact StackCall.frame_at takeCode S _ takeCode_injective 2
    | exact StackCall.frame_at takeCode S _ takeCode_injective 3
    | (rw [WordValidator.frame_outside takeCode S _ _ (by intro k; fin_cases k <;> simp [takeCode])]; rfl)
  obtain ⟨ticks,hr,hc⟩ :=
      CountedTake.complete_prefix bits tail out bits.length.bits (getTake v)
      (binaryValue_bits bits.length)
  obtain ⟨hN,hNC⟩ := StackCall.execution takeCode Label.take (.drain 0) getTake putTake
    (StackCall.frame takeCode S)
    (fun data k => StackCall.frame_at _ _ data takeCode_injective k)
    (fun data k bits => StackCall.frame_update _ _ data takeCode_injective k bits)
    (fun _ _ => rfl) (fun _ _ _ => rfl) CountedTake.program program (fun _ => rfl) v ticks _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,getTake,putTake,hsame,hfinal] at hN hNC
  exact ⟨ticks,_,hN,hNC.trans_le hc⟩

theorem drain_call (reader header out : Bits) (v : Local) :
    Stacks.stackRun program (header.length+1) ⟨some (.drain 0),v,store reader [] header out⟩=
      some ⟨some .done,putIO v none,store reader [] [] out⟩ ∧
    Stacks.stackRunClock program (header.length+1) ⟨some (.drain 0),v,store reader [] header out⟩=
      header.length^2+3*header.length+3 := by
  let S := store reader [] header out
  have hinj : Function.Injective drainCode := fun _ _ _ => Subsingleton.elim _ _
  have hsame : StackCall.frame drainCode S (Normalization.singleStack header)=S := by
    apply StackCall.frame_same _ _ _ hinj
    intro k
    rfl
  have hfinal : StackCall.frame drainCode S (Normalization.singleStack [])=store reader [] [] out := by
    funext bank
    cases bank
    all_goals first
    | exact StackCall.frame_at drainCode S _ hinj 0
    | (rw [WordValidator.frame_outside drainCode S _ _ (by intro k; simp [drainCode])]; rfl)
  have hr := Normalization.drain_run header (getIO v)
  obtain ⟨hN,hNC⟩ := StackCall.execution drainCode Label.drain .done getIO putIO
    (StackCall.frame drainCode S)
    (fun data k => StackCall.frame_at _ _ data hinj k)
    (fun data k bits => StackCall.frame_update _ _ data hinj k bits)
    (fun _ _ => rfl) (fun _ _ _ => rfl) Normalization.drainProgram program (fun _ => rfl) v (header.length+1) _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,getIO,putIO,hsame,hfinal] at hN hNC
  exact ⟨hN,hNC.trans (Normalization.drain_clock header (getIO v))⟩

theorem complete (bits tail out : Bits) (v : Local) : ∃ ticks last,
    Stacks.stackRun program ticks ⟨some (.read (.read .unary)),v,store (framed bits++tail) [] [] out⟩=
      some ⟨none,last,store tail [] [] (bits.reverse++out)⟩ ∧
    Stacks.stackRunClock program ticks ⟨some (.read (.read .unary)),v,store (framed bits++tail) [] [] out⟩≤
      5000*(bits.length+1)*(1+(framed bits++tail).length+out.length)^2 := by
  obtain ⟨readTicks,v1,hR,hRC⟩ := read_call bits.length (bits++tail) out v
  obtain ⟨takeTicks,v2,hT,hTC⟩ := take_call bits tail (natBits bits.length).reverse out v1
  obtain ⟨hD,hDC⟩ := drain_call tail (natBits bits.length).reverse (bits.reverse++out) v2
  let v3 := putIO v2 none
  have hH : Stacks.stackRun program 1 ⟨some .done,v3,store tail [] [] (bits.reverse++out)⟩=
      some ⟨none,v3,store tail [] [] (bits.reverse++out)⟩ := rfl
  have hHC :
      Stacks.stackRunClock program 1 ⟨some .done,v3,store tail [] [] (bits.reverse++out)⟩=1 := rfl
  have eR : Stacks.Execution program _ _ _ := ⟨readTicks,hR,hRC⟩
  have eT : Stacks.Execution program _ _ _ := ⟨takeTicks,hT,hTC⟩
  have eD : Stacks.Execution program _ _ _ := ⟨(natBits bits.length).reverse.length+1,hD,hDC.le⟩
  have eH : Stacks.Execution program _ _ 1 := ⟨1,hH,hHC.le⟩
  obtain ⟨ticks,hr,hc⟩ := ((eR.trans eT).trans eD).trans eH
  refine ⟨ticks,v3,?_,?_⟩
  · simpa only [framed,List.append_assoc] using hr
  · let B := 1+(framed bits++tail).length+out.length
    have he : natBits bits.length++(bits++tail)=framed bits++tail := by
      simp only [framed,List.append_assoc]
    rw [he] at hc
    refine hc.trans ?_
    have hB : 1≤B := by dsimp [B]; omega
    have hB2 : B≤B^2 := Nat.le_pow (by decide)
    have hn : (natBits bits.length).length≤B := by
      dsimp [B]; simp only [framed,List.length_append]; omega
    have hn2 := Nat.mul_le_mul hn hn
    have ht : 1+bits.length.bits.length+(bits++tail).length+out.length+bits.length≤2*B := by
      dsimp [B]
      simp only [framed,List.length_append,natBits_length]
      omega
    have ht2 := Nat.mul_le_mul_left (150*(bits.length+1)) (Nat.pow_le_pow_left ht 2)
    simp only [List.length_reverse]
    change 500*(1+(framed bits++tail).length)^2+150*(bits.length+1)*_+((natBits bits.length).length^2+3*(natBits bits.length).length+3)+1≤5000*(bits.length+1)*B^2
    have hr2 := Nat.pow_le_pow_left (show 1+(framed bits++tail).length≤B by dsimp [B]; omega) 2
    nlinarith only [hB,hB2,hn,hn2,ht2,hr2,Nat.zero_le (bits.length*B^2)]
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.FramedTake

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.TableGet
open Turing Qatlib.Concepts.BitWordCompiler.CanonicalCodec
inductive Slot where | reader | index | indexTemp | markers | payload | count | temporary | header | scratch | output deriving DecidableEq,Fintype
inductive DrainBank where | reader | index | scratch deriving DecidableEq,Fintype
inductive Phase where | loop | decideIndex | selected | skip | clearIndex | done deriving DecidableEq,Fintype
inductive Label where
  | counter (l : Counter.Label)
  | frame (selected : Bool) (l : FramedTake.Label)
  | drain (bank : DrainBank) (ret : Phase) (l : Fin 1)
  | step (phase : Phase)
  deriving DecidableEq,Fintype
instance : Inhabited Label := ⟨.step .loop⟩
abbrev Local := Counter.Local×FramedTake.Local×Symbol

def getCounter (v : Local) := v.1
def putCounter (v : Local) (s : Counter.Local) : Local := (s,v.2)
def getFrame (v : Local) := v.2.1
def putFrame (v : Local) (s : FramedTake.Local) : Local := (v.1,s,v.2.2)
def getIO (v : Local) := v.2.2
def putIO (v : Local) (s : Symbol) : Local := (v.1,v.2.1,s)

def counterCode : Fin 2 → Slot | 0 => .index | _ => .indexTemp

def frameCode (selected : Bool) : FramedTake.Slot → Slot
  | .reader => .reader | .markers => .markers | .payload => .payload | .count => .count
  | .temporary => .temporary | .header => .header | .output => if selected then .output else .scratch

def drainKey : DrainBank → Slot | .reader => .reader | .index => .index | .scratch => .scratch
def drainCode (bank : DrainBank) (_ : Fin 1) : Slot := drainKey bank

def phaseProgram : Phase → TM2.Stmt (fun _ : Slot => Bool) Label Local
  | .loop => .peek .reader (fun v bit => putIO v bit) (.branch (fun v => (getIO v).isSome)
      (.goto (fun _ => .counter .borrow)) (.goto (fun _ => .drain .index .done 0)))
  | .decideIndex => .branch (fun v => (getCounter v).1)
      (.goto (fun _ => .frame false (.read (.read .unary)))) (.goto (fun _ => .frame true (.read (.read .unary))))
  | .selected => .goto (fun _ => .drain .reader .clearIndex 0)
  | .skip => .goto (fun _ => .drain .scratch .loop 0)
  | .clearIndex => .goto (fun _ => .drain .index .done 0)
  | .done => .halt

def program : Label → TM2.Stmt (fun _ : Slot => Bool) Label Local
  | .counter l => StackCall.stmt counterCode Label.counter (.step .decideIndex) getCounter putCounter (Counter.program l)
  | .frame selected l => StackCall.stmt (frameCode selected) (Label.frame selected) (.step (if selected then .selected else .skip)) getFrame putFrame (FramedTake.program l)
  | .drain bank ret l => StackCall.stmt (drainCode bank) (Label.drain bank ret) (.step ret) getIO putIO (Normalization.drainProgram l)
  | .step phase => phaseProgram phase

def store (reader index scratch out : Bits) : Slot → Bits
  | .reader => reader | .index => index | .scratch => scratch | .output => out | _ => []

def stream (values : List Bits) : Bits := values.flatMap framed

theorem counterCode_injective : Function.Injective counterCode := by
    intro a b h; fin_cases a <;> fin_cases b <;> simp [counterCode] at h ⊢

theorem frameCode_injective (selected : Bool) : Function.Injective (frameCode selected) := by
  intro a b h
  cases selected <;> cases a <;> cases b <;> simp [frameCode] at h ⊢

theorem counter_frame (S : Slot → Bits) (counter next : Bits) (hc : S .index=counter) (ht : S .indexTemp=[]) :
    StackCall.frame counterCode S (Stacks.stackPair next [])=Function.update S .index next := by
  have hinj := counterCode_injective
  have hsame : StackCall.frame counterCode S (Stacks.stackPair counter [])=S := by
    apply StackCall.frame_same _ _ _ hinj
    intro k
    fin_cases k <;> simp [counterCode,Stacks.stackPair,hc,ht]
  have h := StackCall.frame_update counterCode S (Stacks.stackPair counter []) hinj 0 next
  simpa only [Stacks.stackPair_update_zero,hsame] using! h

@[simp] theorem store_update_reader (reader index scratch out next : Bits) :
    Function.update (store reader index scratch out) .reader next=store next index scratch out := by funext k; cases k <;> rfl

@[simp] theorem store_update_index (reader index scratch out next : Bits) :
    Function.update (store reader index scratch out) .index next=store reader next scratch out := by funext k; cases k <;> rfl

@[simp] theorem store_update_scratch (reader index scratch out next : Bits) :
    Function.update (store reader index scratch out) .scratch next=store reader index next out := by funext k; cases k <;> rfl

theorem counter_zero (counter reader out : Bits) (v : Local) (hz : binaryValue counter=0) :
    Stacks.stackRun program (2*counter.length+2) ⟨some (.counter .borrow),v,store reader counter [] out⟩=
      some ⟨some (.step .decideIndex),putCounter v (false,none),store reader (List.replicate counter.length true) [] out⟩ ∧
    Stacks.stackRunClock program (2*counter.length+2) ⟨some (.counter .borrow),v,store reader counter [] out⟩≤10*(1+counter.length)^2 := by
  let S := store reader counter [] out
  have hsame : StackCall.frame counterCode S (Stacks.stackPair counter [])=S := by
    rw [counter_frame S counter counter rfl rfl]
    exact Function.update_eq_self .index S
  obtain ⟨hr,hc⟩ := Counter.decrement_zero counter (getCounter v) hz
  obtain ⟨hN,hNC⟩ := StackCall.execution counterCode Label.counter (.step .decideIndex) getCounter putCounter
    (StackCall.frame counterCode S)
    (fun data k => StackCall.frame_at _ _ data counterCode_injective k)
    (fun data k bits => StackCall.frame_update _ _ data counterCode_injective k bits)
    (fun _ _ => rfl) (fun _ _ _ => rfl) Counter.program program (fun _ => rfl) v (2*counter.length+2) _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,getCounter,putCounter,
    hsame,counter_frame S counter _ rfl rfl,S,store_update_index] at hN hNC
  exact ⟨hN,hNC.trans_le hc⟩

theorem counter_positive (counter reader out : Bits) (v : Local) (hp : 0<binaryValue counter) :
    ∃ ticks next,next.length=counter.length ∧ binaryValue next+1=binaryValue counter ∧
      Stacks.stackRun program ticks ⟨some (.counter .borrow),v,store reader counter [] out⟩=
        some ⟨some (.step .decideIndex),putCounter v (true,none),store reader next [] out⟩ ∧
      Stacks.stackRunClock program ticks ⟨some (.counter .borrow),v,store reader counter [] out⟩≤10*(1+counter.length)^2 := by
  let S := store reader counter [] out
  have hsame : StackCall.frame counterCode S (Stacks.stackPair counter [])=S := by
    rw [counter_frame S counter counter rfl rfl]
    exact Function.update_eq_self .index S
  obtain ⟨ticks,next,_,hlen,hvalue,hr,hc⟩ := Counter.decrement_positive counter (getCounter v) hp
  obtain ⟨hN,hNC⟩ := StackCall.execution counterCode Label.counter (.step .decideIndex) getCounter putCounter
    (StackCall.frame counterCode S)
    (fun data k => StackCall.frame_at _ _ data counterCode_injective k)
    (fun data k bits => StackCall.frame_update _ _ data counterCode_injective k bits)
    (fun _ _ => rfl) (fun _ _ _ => rfl) Counter.program program (fun _ => rfl) v ticks _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,getCounter,putCounter,
    hsame,counter_frame S counter next rfl rfl,S,store_update_index] at hN hNC
  exact ⟨ticks,next,hlen,hvalue,hN,hNC.trans_le hc⟩

theorem frame_call (selected : Bool) (bits tail counter out : Bits) (v : Local) : ∃ ticks last,
    Stacks.stackRun program ticks ⟨some (.frame selected (.read (.read .unary))),v,store (framed bits++tail) counter [] out⟩=
      some ⟨some (.step (if selected then .selected else .skip)),last,
        store tail counter (if selected then [] else bits.reverse) (if selected then bits.reverse++out else out)⟩ ∧
    Stacks.stackRunClock program ticks ⟨some (.frame selected (.read (.read .unary))),v,store (framed bits++tail) counter [] out⟩≤
      5000*(bits.length+1)*(1+(framed bits++tail).length+(if selected then out.length else 0))^2 := by
  let S := store (framed bits++tail) counter [] out
  have hinj := frameCode_injective selected
  let prior := if selected then out else []
  have hsame : StackCall.frame (frameCode selected) S (FramedTake.store (framed bits++tail) [] [] prior)=S := by
    apply StackCall.frame_same _ _ _ hinj
    intro k
    cases selected <;> cases k <;> rfl
  have hfinal : StackCall.frame (frameCode selected) S (FramedTake.store tail [] [] (bits.reverse++prior))=
      store tail counter (if selected then [] else bits.reverse) (if selected then bits.reverse++out else out) := by
    cases selected with
    | false =>
      have hout : (StackCall.frame (frameCode false) S (FramedTake.store tail [] [] (bits.reverse++prior))) .scratch=bits.reverse := by
        have hh :=
            StackCall.frame_at (frameCode false) S
            (FramedTake.store tail [] [] (bits.reverse++prior)) hinj FramedTake.Slot.output
        change (StackCall.frame (frameCode false) S (FramedTake.store tail [] [] (bits.reverse++prior))) .scratch=bits.reverse++[] at hh
        simpa only [List.append_nil] using hh
      funext bank
      cases bank
      all_goals first
      | exact StackCall.frame_at (frameCode false) S _ hinj FramedTake.Slot.reader
      | exact StackCall.frame_at (frameCode false) S _ hinj FramedTake.Slot.markers
      | exact StackCall.frame_at (frameCode false) S _ hinj FramedTake.Slot.payload
      | exact StackCall.frame_at (frameCode false) S _ hinj FramedTake.Slot.count
      | exact StackCall.frame_at (frameCode false) S _ hinj FramedTake.Slot.temporary
      | exact StackCall.frame_at (frameCode false) S _ hinj FramedTake.Slot.header
      | exact hout
      | (rw [WordValidator.frame_outside (frameCode false) S _ _ (by intro k; cases k <;> simp [frameCode])]; rfl)
    | true =>
      funext bank
      cases bank
      all_goals first
      | exact StackCall.frame_at (frameCode true) S _ hinj FramedTake.Slot.reader
      | exact StackCall.frame_at (frameCode true) S _ hinj FramedTake.Slot.markers
      | exact StackCall.frame_at (frameCode true) S _ hinj FramedTake.Slot.payload
      | exact StackCall.frame_at (frameCode true) S _ hinj FramedTake.Slot.count
      | exact StackCall.frame_at (frameCode true) S _ hinj FramedTake.Slot.temporary
      | exact StackCall.frame_at (frameCode true) S _ hinj FramedTake.Slot.header
      | exact StackCall.frame_at (frameCode true) S _ hinj FramedTake.Slot.output
      | (rw [WordValidator.frame_outside (frameCode true) S _ _ (by intro k; cases k <;> simp [frameCode])]; rfl)
  obtain ⟨ticks,last,hr,hc⟩ := FramedTake.complete bits tail prior (getFrame v)
  obtain ⟨hN,hNC⟩ := StackCall.execution (frameCode selected) (Label.frame selected) (.step (if selected then .selected else .skip)) getFrame putFrame
    (StackCall.frame (frameCode selected) S)
    (fun data k => StackCall.frame_at _ _ data hinj k)
    (fun data k bits => StackCall.frame_update _ _ data hinj k bits)
    (fun _ _ => rfl) (fun _ _ _ => rfl) FramedTake.program program (fun _ => rfl) v ticks _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,getFrame,putFrame,hsame,hfinal] at hN hNC
  refine ⟨ticks,putFrame v last,hN,?_⟩
  have hlen : prior.length=(if selected then out.length else 0) := by cases selected <;> rfl
  rw [hlen] at hc
  exact hNC.trans_le hc

theorem drain_call (bank : DrainBank) (ret : Phase) (S : Slot → Bits) (v : Local) :
    Stacks.stackRun program ((S (drainKey bank)).length+1) ⟨some (.drain bank ret 0),v,S⟩=
      some ⟨some (.step ret),putIO v none,Function.update S (drainKey bank) []⟩ ∧
    Stacks.stackRunClock program ((S (drainKey bank)).length+1) ⟨some (.drain bank ret 0),v,S⟩=
      (S (drainKey bank)).length^2+3*(S (drainKey bank)).length+3 := by
  have hinj : Function.Injective (drainCode bank) := fun _ _ _ => Subsingleton.elim _ _
  have hsame : StackCall.frame (drainCode bank) S (Normalization.singleStack (S (drainKey bank)))=S := by
    apply StackCall.frame_same _ _ _ hinj
    intro k
    rfl
  have hfinal : StackCall.frame (drainCode bank) S (Normalization.singleStack [])=Function.update S (drainKey bank) [] := by
    have h :=
        StackCall.frame_update (drainCode bank) S
        (Normalization.singleStack (S (drainKey bank))) hinj 0 []
    simpa only [Normalization.singleStack_update,hsame] using! h
  have hr := Normalization.drain_run (S (drainKey bank)) (getIO v)
  obtain ⟨hN,hNC⟩ := StackCall.execution (drainCode bank) (Label.drain bank ret) (.step ret) getIO putIO
    (StackCall.frame (drainCode bank) S)
    (fun data k => StackCall.frame_at _ _ data hinj k)
    (fun data k bits => StackCall.frame_update _ _ data hinj k bits)
    (fun _ _ => rfl) (fun _ _ _ => rfl) Normalization.drainProgram program (fun _ => rfl) v ((S (drainKey bank)).length+1) _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,getIO,putIO,hsame,hfinal] at hN hNC
  exact ⟨hN,hNC.trans (Normalization.drain_clock (S (drainKey bank)) (getIO v))⟩

theorem phase_step (phase : Phase) (S : Slot → Bits) (v : Local) :
    Stacks.stackRun program 1 ⟨some (.step phase),v,S⟩=some (TM2.stepAux (phaseProgram phase) v S) := rfl

theorem goto_phase (phase : Phase) (after : Label) (hcode : phaseProgram phase=.goto (fun _ => after)) (S : Slot → Bits) (v : Local) :
    Stacks.stackRun program 1 ⟨some (.step phase),v,S⟩=some ⟨some after,v,S⟩ ∧
    Stacks.stackRunClock program 1 ⟨some (.step phase),v,S⟩=1 := by
  constructor
  · rw [phase_step,hcode]
    rfl
  · simp [Stacks.stackRunClock,program,hcode,Stacks.stackClock]

theorem loop_peek (S : Slot → Bits) (v : Local) :
    Stacks.stackRun program 1 ⟨some (.step .loop),v,S⟩=
      some ⟨some (if S .reader=[] then .drain .index .done 0 else .counter .borrow),putIO v (S .reader).head?,S⟩ ∧
    Stacks.stackRunClock program 1 ⟨some (.step .loop),v,S⟩=2*(S .reader).length+3 := by
  cases he : S .reader with
  | nil => constructor <;> simp [phase_step,phaseProgram,TM2.stepAux,getIO,putIO,he,Stacks.stackRunClock,program,Stacks.stackClock]
  | cons bit bits =>
    constructor <;> simp [phase_step,phaseProgram,TM2.stepAux,getIO,putIO,he,Stacks.stackRunClock,program,Stacks.stackClock]
    omega

theorem index_branch (flag : Bool) (S : Slot → Bits) (v : Local) (hv : (getCounter v).1=flag) :
    Stacks.stackRun program 1 ⟨some (.step .decideIndex),v,S⟩=
      some ⟨some (.frame (!flag) (.read (.read .unary))),v,S⟩ ∧
    Stacks.stackRunClock program 1 ⟨some (.step .decideIndex),v,S⟩=1 := by
  cases flag <;> constructor <;> simp
      [phase_step,phaseProgram,TM2.stepAux,hv,Stacks.stackRunClock,program,Stacks.stackClock]

theorem index_finish (counter out : Bits) (v : Local) : ∃ ticks last,
    Stacks.stackRun program ticks ⟨some (.drain .index .done 0),v,store [] counter [] out⟩=
      some ⟨none,last,store [] [] [] out⟩ ∧
    Stacks.stackRunClock program ticks ⟨some (.drain .index .done 0),v,store [] counter [] out⟩≤10*(1+counter.length)^2 := by
  obtain ⟨hD,hDC⟩ := drain_call .index .done (store [] counter [] out) v
  change Stacks.stackRun program (counter.length+1) ⟨some (.drain .index .done 0),v,store [] counter [] out⟩=
    some ⟨some (.step .done),putIO v none,Function.update (store [] counter [] out) .index []⟩ at hD
  change _=counter.length^2+3*counter.length+3 at hDC
  rw [store_update_index] at hD
  have hH : Stacks.stackRun program 1 ⟨some (.step .done),putIO v none,store [] [] [] out⟩=
      some ⟨none,putIO v none,store [] [] [] out⟩ := rfl
  have hHC :
      Stacks.stackRunClock program 1 ⟨some (.step .done),putIO v none,store [] [] [] out⟩=1 := rfl
  have eD : Stacks.Execution program _ _ _ := ⟨counter.length+1,hD,hDC.le⟩
  have eH : Stacks.Execution program _ _ 1 := ⟨1,hH,hHC.le⟩
  obtain ⟨ticks,hr,hc⟩ := eD.trans eH
  exact ⟨ticks,_,hr,hc.trans (by nlinarith only [Nat.zero_le counter.length,Nat.zero_le (counter.length^2)])⟩

theorem selected_finish (reader counter out : Bits) (v : Local) : ∃ ticks last,
    Stacks.stackRun program ticks ⟨some (.step .selected),v,store reader counter [] out⟩=
      some ⟨none,last,store [] [] [] out⟩ ∧
    Stacks.stackRunClock program ticks ⟨some (.step .selected),v,store reader counter [] out⟩≤20*(1+reader.length+counter.length)^2 := by
  let S := store reader counter [] out
  obtain ⟨hB,hBC⟩ := goto_phase .selected (.drain .reader .clearIndex 0) rfl S v
  obtain ⟨hD,hDC⟩ := drain_call .reader .clearIndex S v
  change Stacks.stackRun program (reader.length+1) ⟨some (.drain .reader .clearIndex 0),v,S⟩=
    some ⟨some (.step .clearIndex),putIO v none,Function.update S .reader []⟩ at hD
  change _=reader.length^2+3*reader.length+3 at hDC
  simp only [S,store_update_reader] at hD
  obtain ⟨hG,hGC⟩ :=
      goto_phase .clearIndex (.drain .index .done 0) rfl (store [] counter [] out) (putIO v none)
  obtain ⟨cleanTicks,last,hC,hCC⟩ := index_finish counter out (putIO v none)
  have eB : Stacks.Execution program _ _ 1 := ⟨1,hB,hBC.le⟩
  have eD : Stacks.Execution program _ _ _ := ⟨reader.length+1,hD,hDC.le⟩
  have eG : Stacks.Execution program _ _ 1 := ⟨1,hG,hGC.le⟩
  have eC : Stacks.Execution program _ _ _ := ⟨cleanTicks,hC,hCC⟩
  obtain ⟨ticks,hr,hc⟩ := ((eB.trans eD).trans eG).trans eC
  exact ⟨ticks,last,hr,hc.trans (by nlinarith only [Nat.zero_le reader.length,Nat.zero_le (reader.length^2),Nat.zero_le counter.length,Nat.zero_le (counter.length^2),Nat.zero_le (reader.length*counter.length)])⟩

theorem skip_finish (reader counter scratch out : Bits) (v : Local) : ∃ ticks last,
    Stacks.stackRun program ticks ⟨some (.step .skip),v,store reader counter scratch out⟩=
      some ⟨some (.step .loop),last,store reader counter [] out⟩ ∧
    Stacks.stackRunClock program ticks ⟨some (.step .skip),v,store reader counter scratch out⟩≤10*(1+scratch.length)^2 := by
  let S := store reader counter scratch out
  obtain ⟨hB,hBC⟩ := goto_phase .skip (.drain .scratch .loop 0) rfl S v
  obtain ⟨hD,hDC⟩ := drain_call .scratch .loop S v
  change Stacks.stackRun program (scratch.length+1) ⟨some (.drain .scratch .loop 0),v,S⟩=
    some ⟨some (.step .loop),putIO v none,Function.update S .scratch []⟩ at hD
  change _=scratch.length^2+3*scratch.length+3 at hDC
  simp only [S,store_update_scratch] at hD
  have eB : Stacks.Execution program _ _ 1 := ⟨1,hB,hBC.le⟩
  have eD : Stacks.Execution program _ _ _ := ⟨scratch.length+1,hD,hDC.le⟩
  obtain ⟨ticks,hr,hc⟩ := eB.trans eD
  exact ⟨ticks,_,hr,hc.trans (by nlinarith only [Nat.zero_le scratch.length,Nat.zero_le (scratch.length^2)])⟩

theorem empty (counter out : Bits) (v : Local) : ∃ ticks last,
    Stacks.stackRun program ticks ⟨some (.step .loop),v,store [] counter [] out⟩=
      some ⟨none,last,store [] [] [] out⟩ ∧
    Stacks.stackRunClock program ticks ⟨some (.step .loop),v,store [] counter [] out⟩≤20*(1+counter.length)^2 := by
  obtain ⟨hE,hEC⟩ := loop_peek (store [] counter [] out) v
  change Stacks.stackRun program 1 ⟨some (.step .loop),v,store [] counter [] out⟩=
    some ⟨some (.drain .index .done 0),putIO v none,store [] counter [] out⟩ at hE
  change _=3 at hEC
  obtain ⟨cleanTicks,last,hC,hCC⟩ := index_finish counter out (putIO v none)
  have eE : Stacks.Execution program _ _ 3 := ⟨1,hE,hEC.le⟩
  have eC : Stacks.Execution program _ _ _ := ⟨cleanTicks,hC,hCC⟩
  obtain ⟨ticks,hr,hc⟩ := eE.trans eC
  have hp : 1≤(1+counter.length)^2 := Nat.one_le_pow 2 _ (by omega)
  exact ⟨ticks,last,hr,hc.trans (by omega)⟩

theorem framed_length_ge (bits : Bits) : bits.length+1≤(framed bits).length := by
  simp only [framed,List.length_append,natBits_length]
  omega

theorem framed_nonempty (bits tail : Bits) : framed bits++tail≠[] := by
  have hh := framed_length_ge bits
  intro he
  have hl := congrArg List.length he
  simp only [List.length_append,List.length_nil] at hl
  omega

theorem complete (values : List Bits) (counter out : Bits) (v : Local) : ∃ ticks last,
    Stacks.stackRun program ticks ⟨some (.step .loop),v,store (stream values) counter [] out⟩=
      some ⟨none,last,store [] [] [] ((values.getD (binaryValue counter) []).reverse++out)⟩ ∧
    Stacks.stackRunClock program ticks ⟨some (.step .loop),v,store (stream values) counter [] out⟩≤
      20000*(1+(stream values).length)*(1+(stream values).length+counter.length+out.length)^2 := by
  induction values generalizing counter out v with
  | nil =>
    obtain ⟨ticks,last,hr,hc⟩ := empty counter out v
    refine ⟨ticks,last,by simpa only [stream,List.flatMap_nil,List.getD_nil,List.reverse_nil,List.nil_append] using hr,hc.trans ?_⟩
    have hpos : 1≤(1+counter.length+out.length)^2 := Nat.one_le_pow 2 _ (by omega)
    have hpow := Nat.pow_le_pow_left (show 1+counter.length≤1+counter.length+out.length by omega) 2
    simp only [stream,List.flatMap_nil,List.length_nil,Nat.add_zero,Nat.mul_one]
    nlinarith only [hpow,hpos]
  | cons bits values ih =>
    let reader := framed bits++stream values
    have hne : reader≠[] := framed_nonempty bits (stream values)
    obtain ⟨hL,hLC⟩ := loop_peek (store reader counter [] out) v
    change Stacks.stackRun program 1 ⟨some (.step .loop),v,store reader counter [] out⟩=
      some ⟨some (if reader=[] then .drain .index .done 0 else .counter .borrow),putIO v reader.head?,store reader counter [] out⟩ at hL
    rw [if_neg hne] at hL
    change _=2*reader.length+3 at hLC
    let v1 := putIO v reader.head?
    have eL : Stacks.Execution program _ _ _ := ⟨1,hL,hLC.le⟩
    let B := 1+reader.length+counter.length+out.length
    have hB : 1≤B := by dsimp [B]; omega
    have hB2 : B≤B^2 := Nat.le_pow (by decide)
    have hhead := framed_length_ge bits
    have hreader : reader.length=(framed bits).length+(stream values).length := by
      simp only [reader,List.length_append]
    have hcp : 1+counter.length≤B := by dsimp [B]; omega
    have hcp2 := Nat.pow_le_pow_left hcp 2
    have hrlen : reader.length≤B := by dsimp [B]; omega
    cases hnum : binaryValue counter with
    | zero =>
      obtain ⟨hC,hCC⟩ := counter_zero counter reader out v1 hnum
      let v2 := putCounter v1 (false,none)
      let counter1 := List.replicate counter.length true
      obtain ⟨hD,hDC⟩ := index_branch false (store reader counter1 [] out) v2 rfl
      obtain ⟨frameTicks,v3,hF,hFC⟩ := frame_call true bits (stream values) counter1 out v2
      obtain ⟨cleanTicks,last,hQ,hQC⟩ :=
          selected_finish (stream values) counter1 (bits.reverse++out) v3
      have eC : Stacks.Execution program _ _ _ := ⟨2*counter.length+2,hC,hCC⟩
      have eD : Stacks.Execution program _ _ 1 := ⟨1,hD,hDC.le⟩
      have eF : Stacks.Execution program _ _ _ := ⟨frameTicks,hF,hFC⟩
      have eQ : Stacks.Execution program _ _ _ := ⟨cleanTicks,hQ,hQC⟩
      obtain ⟨ticks,hr,hc⟩ := (((eL.trans eC).trans eD).trans eF).trans eQ
      refine ⟨ticks,last,?_,?_⟩
      · simpa only [stream,List.flatMap_cons,hnum,List.getD_cons_zero] using! hr
      · have hfp : 1+reader.length+out.length≤B := by dsimp [B]; omega
        have hfp2 := Nat.mul_le_mul_left (5000*(bits.length+1)) (Nat.pow_le_pow_left hfp 2)
        have hqp : 1+(stream values).length+counter1.length≤B := by
          simp only [counter1,List.length_replicate]
          dsimp [B]
          omega
        have hqp2 := Nat.mul_le_mul_left 20 (Nat.pow_le_pow_left hqp 2)
        have hbmul := Nat.mul_le_mul_right (B^2) (show bits.length+1≤reader.length by omega)
        have hsmall : 2*reader.length+3+1≤6*B^2 := by omega
        have hbound : (2*reader.length+3)+10*(1+counter.length)^2+1+
            5000*(bits.length+1)*(1+reader.length+out.length)^2+20*(1+(stream values).length+counter1.length)^2≤
            20000*(1+reader.length)*B^2 := by
          nlinarith only [hfp2,hqp2,hcp2,hbmul,hsmall,Nat.zero_le (B^2)]
        simpa only [reader,stream,List.flatMap_cons,B] using hc.trans hbound
    | succ n =>
      obtain ⟨counterTicks,next,hlen,hvalue,hC,hCC⟩ :=
          counter_positive counter reader out v1 (by omega)
      have hn : binaryValue next=n := by omega
      let v2 := putCounter v1 (true,none)
      obtain ⟨hD,hDC⟩ := index_branch true (store reader next [] out) v2 rfl
      obtain ⟨frameTicks,v3,hF,hFC⟩ := frame_call false bits (stream values) next out v2
      obtain ⟨skipTicks,v4,hS,hSC⟩ := skip_finish (stream values) next bits.reverse out v3
      obtain ⟨restTicks,last,hR,hRC⟩ := ih next out v4
      have eC : Stacks.Execution program _ _ _ := ⟨counterTicks,hC,hCC⟩
      have eD : Stacks.Execution program _ _ 1 := ⟨1,hD,hDC.le⟩
      have eF : Stacks.Execution program _ _ _ := ⟨frameTicks,hF,hFC⟩
      have eS : Stacks.Execution program _ _ _ := ⟨skipTicks,hS,hSC⟩
      have eR : Stacks.Execution program _ _ _ := ⟨restTicks,hR,hRC⟩
      obtain ⟨ticks,hr,hc⟩ := ((((eL.trans eC).trans eD).trans eF).trans eS).trans eR
      refine ⟨ticks,last,?_,?_⟩
      · simpa only [stream,List.flatMap_cons,hnum,List.getD_cons_succ,hn] using! hr
      · have hfp : 1+reader.length≤B := by dsimp [B]; omega
        have hfp2 := Nat.mul_le_mul_left (5000*(bits.length+1)) (Nat.pow_le_pow_left hfp 2)
        have hsp : 1+bits.reverse.length≤B := by simp only [List.length_reverse]; dsimp [B]; omega
        have hsp2 := Nat.mul_le_mul_left 10 (Nat.pow_le_pow_left hsp 2)
        have hrp : 1+(stream values).length+next.length+out.length≤B := by dsimp [B]; omega
        have hrp2 :=
            Nat.mul_le_mul_left (20000*(1+(stream values).length)) (Nat.pow_le_pow_left hrp 2)
        have hbmul := Nat.mul_le_mul_right (B^2) hhead
        have hpositive := Nat.mul_le_mul_right (B^2) (show 1≤(framed bits).length by omega)
        have hsmall : 2*reader.length+3+1≤6*B^2 := by omega
        have hbound : (2*reader.length+3)+10*(1+counter.length)^2+1+
            5000*(bits.length+1)*(1+reader.length+0)^2+10*(1+bits.reverse.length)^2+
            20000*(1+(stream values).length)*(1+(stream values).length+next.length+out.length)^2≤
            20000*(1+reader.length)*B^2 := by
          have hlenmul := congrArg (fun x : ℕ => x*B^2) hreader
          nlinarith only [hfp2,hsp2,hrp2,hcp2,hbmul,hpositive,hsmall,hlenmul]
        simpa only [reader,stream,List.flatMap_cons,B] using hc.trans hbound

end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.TableGet

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.ReadonlyTableGet
open Turing Qatlib.Concepts.BitWordCompiler.CanonicalCodec
abbrev Slot := Sum (Fin 2) TableGet.Slot
abbrev Local := Symbol×TableGet.Local
inductive Label where | copy (l : NatEmit.Label) | get (l : TableGet.Label) | done deriving DecidableEq,Fintype
instance : Inhabited Label := ⟨.copy .emit⟩
def getCopy (v : Local) := v.1
def putCopy (v : Local) (s : Symbol) : Local := (s,v.2)
def getTable (v : Local) := v.2
def putTable (v : Local) (s : TableGet.Local) : Local := (v.1,s)
def copyCode : Fin 3 → Slot | 0 => .inl 0 | 1 => .inl 1 | _ => .inr .reader
def tableCode (k : TableGet.Slot) : Slot := .inr k

def program : Label → TM2.Stmt (fun _ : Slot => Bool) Label Local
  | .copy l => StackCall.stmt copyCode Label.copy (.get (.step .loop)) getCopy putCopy (NatEmit.program l)
  | .get l => StackCall.stmt tableCode Label.get .done getTable putTable (TableGet.program l)
  | .done => .halt

def store (table reader index out : Bits) : Slot → Bits
  | .inl 0 => table | .inl _ => [] | .inr k => TableGet.store reader index [] out k

theorem copyCode_injective : Function.Injective copyCode := by
    intro a b h; fin_cases a <;> fin_cases b <;> simp [copyCode] at h ⊢

theorem tableCode_injective : Function.Injective tableCode := by intro a b h; exact Sum.inr.inj h

theorem copy_call (table index out : Bits) (v : Local) :
    Stacks.stackRun program (2*table.length+3) ⟨some (.copy .emit),v,store table [] index out⟩=
      some ⟨some (.get (.step .loop)),putCopy v none,store table table.reverse index out⟩ ∧
    Stacks.stackRunClock program (2*table.length+3) ⟨some (.copy .emit),v,store table [] index out⟩≤25*(1+table.length)^2 := by
  let S := store table [] index out
  have hsame : StackCall.frame copyCode S (Parsing.triple table [] [])=S := by
    apply StackCall.frame_same _ _ _ copyCode_injective
    intro k
    fin_cases k <;> rfl
  have hfinal : StackCall.frame copyCode S (Parsing.triple table [] table.reverse)=store table table.reverse index out := by
    funext bank
    cases bank with
    | inl k =>
      fin_cases k
      · exact StackCall.frame_at copyCode S _ copyCode_injective 0
      · exact StackCall.frame_at copyCode S _ copyCode_injective 1
    | inr k =>
      cases k
      all_goals first
      | exact StackCall.frame_at copyCode S _ copyCode_injective 2
      | (rw [WordValidator.frame_outside copyCode S _ _ (by intro k; fin_cases k <;> simp [copyCode])]; rfl)
  obtain ⟨hr,_⟩ := NatEmit.copy_complete table [] (getCopy v)
  simp only [List.append_nil] at hr
  obtain ⟨hN,hNC⟩ := StackCall.execution copyCode Label.copy (.get (.step .loop)) getCopy putCopy
    (StackCall.frame copyCode S)
    (fun data k => StackCall.frame_at _ _ data copyCode_injective k)
    (fun data k bits => StackCall.frame_update _ _ data copyCode_injective k bits)
    (fun _ _ => rfl) (fun _ _ _ => rfl) NatEmit.program program (fun _ => rfl) v (2*table.length+3) _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,getCopy,putCopy,hsame,hfinal] at hN hNC
  have hc := NatEmit.copy_clock_bound table [] (getCopy v)
  simp only [List.length_nil,Nat.add_zero] at hc
  exact ⟨hN,hNC.trans_le hc⟩

theorem get_call (values : List Bits) (counter out : Bits) (v : Local) : ∃ ticks last,
    Stacks.stackRun program ticks ⟨some (.get (.step .loop)),v,store (TableGet.stream values).reverse (TableGet.stream values) counter out⟩=
      some ⟨some .done,last,store (TableGet.stream values).reverse [] [] ((values.getD (binaryValue counter) []).reverse++out)⟩ ∧
    Stacks.stackRunClock program ticks ⟨some (.get (.step .loop)),v,store (TableGet.stream values).reverse (TableGet.stream values) counter out⟩≤
      20000*(1+(TableGet.stream values).length)*(1+(TableGet.stream values).length+counter.length+out.length)^2 := by
  let S := store (TableGet.stream values).reverse (TableGet.stream values) counter out
  have hsame : StackCall.frame tableCode S (TableGet.store (TableGet.stream values) counter [] out)=S := by
    apply StackCall.frame_same _ _ _ tableCode_injective
    intro k
    rfl
  have hfinal : StackCall.frame tableCode S (TableGet.store [] [] [] ((values.getD (binaryValue counter) []).reverse++out))=
      store (TableGet.stream values).reverse [] [] ((values.getD (binaryValue counter) []).reverse++out) := by
    funext bank
    cases bank with
    | inl k =>
      rw [WordValidator.frame_outside tableCode S _ _ (by intro j; simp [tableCode])]
      fin_cases k <;> rfl
    | inr k => exact StackCall.frame_at tableCode S _ tableCode_injective k
  obtain ⟨ticks,last,hr,hc⟩ := TableGet.complete values counter out (getTable v)
  obtain ⟨hN,hNC⟩ := StackCall.execution tableCode Label.get .done getTable putTable
    (StackCall.frame tableCode S)
    (fun data k => StackCall.frame_at _ _ data tableCode_injective k)
    (fun data k bits => StackCall.frame_update _ _ data tableCode_injective k bits)
    (fun _ _ => rfl) (fun _ _ _ => rfl) TableGet.program program (fun _ => rfl) v ticks _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,getTable,putTable,hsame,hfinal] at hN hNC
  exact ⟨ticks,putTable v last,hN,hNC.trans_le hc⟩

theorem complete (values : List Bits) (counter out : Bits) (v : Local) : ∃ ticks last,
    Stacks.stackRun program ticks ⟨some (.copy .emit),v,store (TableGet.stream values).reverse [] counter out⟩=
      some ⟨none,last,store (TableGet.stream values).reverse [] [] ((values.getD (binaryValue counter) []).reverse++out)⟩ ∧
    Stacks.stackRunClock program ticks ⟨some (.copy .emit),v,store (TableGet.stream values).reverse [] counter out⟩≤
      30000*(1+(TableGet.stream values).length)*(1+(TableGet.stream values).length+counter.length+out.length)^2 := by
  obtain ⟨hC,hCC⟩ := copy_call (TableGet.stream values).reverse counter out v
  simp only [List.reverse_reverse,List.length_reverse] at hC hCC
  let v1 := putCopy v none
  obtain ⟨getTicks,v2,hG,hGC⟩ := get_call values counter out v1
  let S2 :=
      store (TableGet.stream values).reverse [] []
      ((values.getD (binaryValue counter) []).reverse++out)
  have hH : Stacks.stackRun program 1 ⟨some .done,v2,S2⟩=some ⟨none,v2,S2⟩ := rfl
  have hHC : Stacks.stackRunClock program 1 ⟨some .done,v2,S2⟩=1 := rfl
  have eC : Stacks.Execution program _ _ _ := ⟨2*(TableGet.stream values).length+3,hC,hCC⟩
  have eG : Stacks.Execution program _ _ _ := ⟨getTicks,hG,hGC⟩
  have eH : Stacks.Execution program _ _ 1 := ⟨1,hH,hHC.le⟩
  obtain ⟨ticks,hr,hc⟩ := (eC.trans eG).trans eH
  refine ⟨ticks,v2,hr,hc.trans ?_⟩
  let B := 1+(TableGet.stream values).length+counter.length+out.length
  have hB : 1≤B^2 := Nat.one_le_pow 2 _ (by dsimp [B]; omega)
  have hh : (1+(TableGet.stream values).length)^2≤B^2 := Nat.pow_le_pow_left (by dsimp [B]; omega) 2
  change 25*(1+(TableGet.stream values).length)^2+20000*(1+(TableGet.stream values).length)*B^2+1≤30000*(1+(TableGet.stream values).length)*B^2
  nlinarith only [hB,hh,Nat.zero_le ((TableGet.stream values).length*B^2)]
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.ReadonlyTableGet

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.BinaryNormalize
open Qatlib.Concepts.BitWordCompiler.CanonicalCodec

theorem canonical_length (bits : Bits) : (binaryValue bits).bits.length≤bits.length := by
  have hh := trim_length bits.reverse
  rw [trim_canonical,List.reverse_reverse,List.length_reverse,List.length_reverse] at hh
  exact hh
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.BinaryNormalize

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.ReadonlyTableGet
open Turing Qatlib.Concepts.BitWordCompiler.CanonicalCodec

theorem counter_table_value (cs : List ℕ) (depth : ℕ) :
    (cs.map Nat.bits).getD depth []=(cs.getD depth 0).bits := by
  induction cs generalizing depth with
  | nil => simp
  | cons n cs ih =>
    cases depth with
    | zero => rfl
    | succ depth => simpa only [List.map_cons,List.getD_cons_succ] using ih depth

theorem counter_complete (cs : List ℕ) (depth : ℕ) (out : Bits) (v : Local) : ∃ ticks last,
    Stacks.stackRun program ticks ⟨some (.copy .emit),v,store (TableGet.stream (cs.map Nat.bits)).reverse [] depth.bits out⟩=
      some ⟨none,last,store (TableGet.stream (cs.map Nat.bits)).reverse [] [] ((cs.getD depth 0).bits.reverse++out)⟩ ∧
    Stacks.stackRunClock program ticks ⟨some (.copy .emit),v,store (TableGet.stream (cs.map Nat.bits)).reverse [] depth.bits out⟩≤
      30000*(1+(TableGet.stream (cs.map Nat.bits)).length)*(1+(TableGet.stream (cs.map Nat.bits)).length+depth.bits.length+out.length)^2 := by
  simpa only [binaryValue_bits,counter_table_value] using
      complete (cs.map Nat.bits) depth.bits out v
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.ReadonlyTableGet

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Scheduler
open Qatlib.Concepts.BitWordCompiler.CanonicalCodec

theorem work_positive (params : List Bits) (k : ℕ) (cs : List ℕ) (p : Plan) : 1≤work params k cs p := by
  cases p <;> simp only [work] <;> omega

theorem pendingWork_cons (params : List Bits) (k : ℕ) (job : Job) (rest : List Job) :
    pendingWork params k (job::rest)=work params k job.counters job.plan+pendingWork params k rest := rfl

theorem pendingWork_append (params : List Bits) (k : ℕ) (a b : List Job) :
    pendingWork params k (a++b)=pendingWork params k a+pendingWork params k b := by simp [pendingWork]

theorem pendingWork_length (params : List Bits) (k : ℕ) (jobs : List Job) : jobs.length≤pendingWork params k jobs := by
  induction jobs with
  | nil => rfl
  | cons job rest ih =>
    have hp := work_positive params k job.counters job.plan
    rw [List.length_cons,pendingWork_cons]
    omega

def pendingBudget (params : List Bits) (k : ℕ) (jobs : List Job) : ℕ :=
  2*pendingWork params k jobs-jobs.length

theorem pendingBudget_step (params : List Bits) (k : ℕ) (job : Job) (rest : List Job) :
    2*(stepOne params k job).1.length+(stepOne params k job).2.length+1+
      pendingBudget params k ((stepOne params k job).2++rest)≤pendingBudget params k (job::rest) := by
  have hs := stepOne_work params k job
  have ho := pendingWork_length params k (job::rest)
  have hn := pendingWork_length params k ((stepOne params k job).2++rest)
  simp only [pendingBudget,pendingWork_append,pendingWork_cons,List.length_append,List.length_cons] at ho hn ⊢
  omega

theorem pendingBudget_single (params : List Bits) (k : ℕ) (cs : List ℕ) (p : Plan) :
    pendingBudget params k [⟨cs,p⟩]≤2*work params k cs p := by
  simp [pendingBudget,pendingWork]

theorem child_count_le_work (params : List Bits) (k : ℕ) (job : Job) :
    (stepOne params k job).2.length≤work params k job.counters job.plan := by
  have hl := pendingWork_length params k (stepOne params k job).2
  have hs := stepOne_work params k job
  omega
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Scheduler

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.PlanCopy
open Turing Qatlib.Concepts.BitWordCompiler.CanonicalCodec

theorem framed_complete (bits tail out : Bits) (v : Local) : ∃ ticks last,
    Stacks.stackRun program ticks ⟨some (.read .literalReady (.read .unary)),v,store (framed bits++tail) [] [] [] out⟩=
      some ⟨none,last,store tail [] [] [] ((framed bits).reverse++out)⟩ ∧
    Stacks.stackRunClock program ticks ⟨some (.read .literalReady (.read .unary)),v,store (framed bits++tail) [] [] [] out⟩≤
      20000*(1+(framed bits).length)*(1+(framed bits++tail).length+out.length)^2 := by
  obtain ⟨copyTicks,v1,hC,hCC⟩ := body_literal bits tail [] out v
  obtain ⟨hH,hHC⟩ := loop_stop tail ((framed bits).reverse++out) v1
  have eC : Stacks.Execution program _ _ _ := ⟨copyTicks,hC,hCC⟩
  have eH : Stacks.Execution program _ _ 3 := ⟨1,hH,hHC.le⟩
  obtain ⟨ticks,hr,hc⟩ := eC.trans eH
  refine ⟨ticks,putIO v1 none,hr,hc.trans ?_⟩
  have hB : 1≤(1+(framed bits++tail).length+out.length)^2 := Nat.one_le_pow 2 _ (by omega)
  nlinarith only [hB,Nat.zero_le ((framed bits).length*(1+(framed bits++tail).length+out.length)^2)]
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.PlanCopy

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.TableGet
open Qatlib.Concepts.BitWordCompiler.CanonicalCodec

theorem entry_length (values : List Bits) (index : ℕ) : (values.getD index []).length≤(stream values).length := by
  induction values generalizing index with
  | nil => simp [stream]
  | cons bits values ih =>
    cases index with
    | zero =>
      have hh := framed_length_ge bits
      simp only [List.getD_cons_zero,stream,List.flatMap_cons,List.length_append]
      omega
    | succ index =>
      have hh := ih index
      simp only [stream] at hh
      simp only [List.getD_cons_succ,stream,List.flatMap_cons,List.length_append]
      omega
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.TableGet

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.ScalarEval
open Turing Qatlib.Concepts.BitWordCompiler.CanonicalCodec
inductive Slot where
  | reader | params | counters | precision | value | result | markers | payload | temporary | discard
  | tableCopy | tableReader | tableIndexTemp | tableMarkers | tablePayload | tableCount | tableTemporary | tableHeader | tableScratch | precisionTemporary
  deriving DecidableEq,Fintype
abbrev Local := NatReadEmit.Local×TinyTag.Local×ReadonlyTableGet.Local×Symbol

def getRead (v : Local) := v.1
def putRead (v : Local) (s : NatReadEmit.Local) : Local := (s,v.2)
def getTag (v : Local) := v.2.1
def putTag (v : Local) (s : TinyTag.Local) : Local := (v.1,s,v.2.2)
def getLookup (v : Local) := v.2.2.1
def putLookup (v : Local) (s : ReadonlyTableGet.Local) : Local := (v.1,v.2.1,s,v.2.2.2)
def getIO (v : Local) := v.2.2.2
def putIO (v : Local) (s : Symbol) : Local := (v.1,v.2.1,v.2.2.1,s)

inductive Phase where | afterTag | dispatch | literalDone | paramDone | counterDone | done deriving DecidableEq,Fintype
inductive Label where
  | read (ret : Phase) (l : NatReadEmit.Label)
  | transferTag (l : Fin 1)
  | tag (l : TinyTag.Label)
  | lookup (context : Bool) (l : ReadonlyTableGet.Label)
  | normalize (l : Fin 1)
  | transferValue (l : Fin 1)
  | precision (l : NatEmit.Label)
  | drain (l : Fin 1)
  | step (phase : Phase)
  deriving DecidableEq,Fintype
instance : Inhabited Label := ⟨.read .afterTag (.read .unary)⟩

def readCode : NatReadEmit.Slot → Slot
  | .reader => .reader | .markers => .markers | .payload => .payload | .value => .value | .temporary => .temporary | .output => .discard

def tagTransferCode : Fin 2 → Slot | 0 => .value | _ => .payload
def tagCode (_ : Fin 1) : Slot := .payload

def lookupCode (context : Bool) : ReadonlyTableGet.Slot → Slot
  | .inl 0 => if context then .counters else .params
  | .inl _ => .tableCopy
  | .inr .reader => .tableReader
  | .inr .index => .value
  | .inr .indexTemp => .tableIndexTemp
  | .inr .markers => .tableMarkers
  | .inr .payload => .tablePayload
  | .inr .count => .tableCount
  | .inr .temporary => .tableTemporary
  | .inr .header => .tableHeader
  | .inr .scratch => .tableScratch
  | .inr .output => .result

def normalizeCode (_ : Fin 1) : Slot := .result
def valueTransferCode : Fin 2 → Slot | 0 => .result | _ => .value
def precisionCode : Fin 3 → Slot | 0 => .precision | 1 => .precisionTemporary | _ => .value
def drainCode (_ : Fin 1) : Slot := .discard

def phaseProgram : Phase → TM2.Stmt (fun _ : Slot => Bool) Label Local
  | .afterTag => .goto (fun _ => .transferTag 0)
  | .dispatch => .branch (fun v => decide ((getTag v).1.val=0)) (.goto (fun _ => .read .literalDone (.read .unary)))
      (.branch (fun v => decide ((getTag v).1.val=1)) (.goto (fun _ => .read .paramDone (.read .unary)))
      (.branch (fun v => decide ((getTag v).1.val=2)) (.goto (fun _ => .precision .emit))
      (.branch (fun v => decide ((getTag v).1.val=3)) (.goto (fun _ => .read .counterDone (.read .unary))) .halt)))
  | .literalDone => .goto (fun _ => .drain 0)
  | .paramDone => .goto (fun _ => .lookup false (.copy .emit))
  | .counterDone => .goto (fun _ => .lookup true (.copy .emit))
  | .done => .halt

def program : Label → TM2.Stmt (fun _ : Slot => Bool) Label Local
  | .read ret l => StackCall.stmt readCode (Label.read ret) (.step ret) getRead putRead (NatReadEmit.program l)
  | .transferTag l => StackCall.stmt tagTransferCode Label.transferTag (.tag .start) getIO putIO (Stacks.transferProgram l)
  | .tag l => StackCall.stmt tagCode Label.tag (.step .dispatch) getTag putTag (TinyTag.program l)
  | .lookup context l => StackCall.stmt (lookupCode context) (Label.lookup context) (.normalize 0) getLookup putLookup (ReadonlyTableGet.program l)
  | .normalize l => StackCall.stmt normalizeCode Label.normalize (.transferValue 0) getIO putIO (BinaryNormalize.program l)
  | .transferValue l => StackCall.stmt valueTransferCode Label.transferValue (.drain 0) getIO putIO (Stacks.transferProgram l)
  | .precision l => StackCall.stmt precisionCode Label.precision (.drain 0) getIO putIO (NatEmit.program l)
  | .drain l => StackCall.stmt drainCode Label.drain (.step .done) getIO putIO (Normalization.drainProgram l)
  | .step phase => phaseProgram phase

def store (reader params counters precision value result discard payload : Bits) : Slot → Bits
  | .reader => reader | .params => params | .counters => counters | .precision => precision
  | .value => value | .result => result | .discard => discard | .payload => payload | _ => []

theorem readCode_injective : Function.Injective readCode := by
    intro a b h; cases a <;> cases b <;> simp [readCode] at h ⊢

theorem tagTransferCode_injective : Function.Injective tagTransferCode := by
    intro a b h; fin_cases a <;> fin_cases b <;> simp [tagTransferCode] at h ⊢

theorem valueTransferCode_injective : Function.Injective valueTransferCode := by
    intro a b h; fin_cases a <;> fin_cases b <;> simp [valueTransferCode] at h ⊢

theorem precisionCode_injective : Function.Injective precisionCode := by
    intro a b h; fin_cases a <;> fin_cases b <;> simp [precisionCode] at h ⊢

theorem lookupCode_injective (context : Bool) : Function.Injective (lookupCode context) := by
  intro a b h
  cases context <;> cases a with
  | inl a =>
    fin_cases a <;> cases b with
    | inl b => fin_cases b <;> simp [lookupCode] at h ⊢
    | inr b => cases b <;> simp [lookupCode] at h
  | inr a =>
    cases a <;> cases b with
    | inl b => fin_cases b <;> simp [lookupCode] at h
    | inr b => cases b <;> simp [lookupCode] at h ⊢

theorem read_call (ret : Phase) (n : ℕ) (tail params counters precision discard : Bits) (v : Local) : ∃ ticks last,
    Stacks.stackRun program ticks ⟨some (.read ret (.read .unary)),v,store (natBits n++tail) params counters precision [] [] discard []⟩=
      some ⟨some (.step ret),last,store tail params counters precision n.bits [] ((natBits n).reverse++discard) []⟩ ∧
    Stacks.stackRunClock program ticks ⟨some (.read ret (.read .unary)),v,store (natBits n++tail) params counters precision [] [] discard []⟩≤
      500*(1+(natBits n++tail).length+discard.length)^2 := by
  let S := store (natBits n++tail) params counters precision [] [] discard []
  have hsame : StackCall.frame readCode S (NatReadEmit.store (natBits n++tail) [] [] [] [] discard)=S := by
    apply StackCall.frame_same _ _ _ readCode_injective
    intro k
    cases k <;> rfl
  have hfinal : StackCall.frame readCode S (NatReadEmit.store tail [] [] n.bits [] ((natBits n).reverse++discard))=
      store tail params counters precision n.bits [] ((natBits n).reverse++discard) [] := by
    funext bank
    cases bank
    all_goals first
    | exact StackCall.frame_at readCode S _ readCode_injective NatReadEmit.Slot.reader
    | exact StackCall.frame_at readCode S _ readCode_injective NatReadEmit.Slot.markers
    | exact StackCall.frame_at readCode S _ readCode_injective NatReadEmit.Slot.payload
    | exact StackCall.frame_at readCode S _ readCode_injective NatReadEmit.Slot.value
    | exact StackCall.frame_at readCode S _ readCode_injective NatReadEmit.Slot.temporary
    | exact StackCall.frame_at readCode S _ readCode_injective NatReadEmit.Slot.output
    | (rw [WordValidator.frame_outside readCode S _ _ (by intro k; cases k <;> simp [readCode])]; rfl)
  obtain ⟨ticks,hr,hc⟩ := NatReadEmit.complete n tail discard (getRead v)
  obtain ⟨hN,hNC⟩ := StackCall.execution readCode (Label.read ret) (.step ret) getRead putRead
    (StackCall.frame readCode S)
