  obtain ⟨hN,hNC⟩ := StackCall.execution cloneCode Label.cloneWidth (.transferWidthClone 0) ReadonlyRepeat.getIO ReadonlyRepeat.putIO
    (cloneFrame counter markers [] [] []) (cloneFrame_at counter markers [] [] []) (cloneFrame_update counter markers [] [] [])
