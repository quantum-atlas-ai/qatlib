theorem parse_call (code : Fin 3 → Label) (returnTo : Label)
    (hcode : ∀ l, program (code l)=StackCall.stmt parseCode code returnTo ReadonlyRepeat.getIO ReadonlyRepeat.putIO (Parsing.natProgram l))
    (n : ℕ) (rest counter wire output : Bits) (v : Local) :
    Stacks.stackRun program (2*n.bits.length+3) ⟨some (code 0),v,store (natBits n++rest) counter [] wire [] output⟩=
      some ⟨some returnTo,ReadonlyRepeat.putIO v none,store rest counter [] wire n.bits.reverse output⟩ ∧
    Stacks.stackRunClock program (2*n.bits.length+3) ⟨some (code 0),v,store (natBits n++rest) counter [] wire [] output⟩≤
      40*(1+(natBits n++rest).length)^2 := by
  have hr := Parsing.nat_run n rest [] (ReadonlyRepeat.getIO v)
