theorem transfer_wire (code : Fin 1 → Label) (returnTo : Label)
    (hcode : ∀ l, program (code l)=StackCall.stmt wireTransferCode code returnTo ReadonlyRepeat.getIO ReadonlyRepeat.putIO (Stacks.transferProgram l))
