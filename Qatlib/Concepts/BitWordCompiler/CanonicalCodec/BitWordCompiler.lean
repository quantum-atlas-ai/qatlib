      some ⟨some .unshift,ReadonlyRepeat.putIO v none,store reader n.bits [] wire block ((natBits n).reverse++output)⟩ ∧
    Stacks.stackRunClock program (4*n.bits.length+5) ⟨some (.emitCount .count),v,store reader n.bits [] wire block output⟩≤
