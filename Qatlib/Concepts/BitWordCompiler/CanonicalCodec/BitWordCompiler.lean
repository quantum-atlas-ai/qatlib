theorem classify_call (n : Fin 8) (reader params counters precision discard : Bits) (v : Local) : ∃ ticks last,
    Stacks.stackRun program ticks ⟨some (.transferTag 0),v,store reader params counters precision n.val.bits [] discard []⟩=
      some ⟨some (.step .dispatch),last,store reader params counters precision [] [] discard []⟩ ∧ (getTag last).1=n ∧
    Stacks.stackRunClock program ticks ⟨some (.transferTag 0),v,store reader params counters precision n.val.bits [] discard []⟩≤100*(1+n.val.bits.length)^2 := by
  obtain ⟨hT,hTC⟩ := transfer_tag_call n.val reader params counters precision discard v
  obtain ⟨hC,hCC⟩ := tag_call n reader params counters precision discard (putIO v none)
  have eT : Stacks.Execution program _ _ _ := ⟨n.val.bits.length+1,hT,hTC.le⟩
  have eC : Stacks.Execution program _ _ _ := ⟨n.val.bits.length+2,hC,hCC⟩
  obtain ⟨ticks,hr,hc⟩ := eT.trans eC
  exact ⟨ticks,putTag (putIO v none) (n,none),hr,rfl,hc.trans (by nlinarith only [Nat.zero_le n.val.bits.length,Nat.zero_le (n.val.bits.length^2)])⟩

theorem lookup_call (context : Bool) (values : List Bits) (other reader precision counter discard : Bits) (v : Local) : ∃ ticks last,
    Stacks.stackRun program ticks ⟨some (.lookup context (.copy .emit)),v,
      store reader (if context then other else (TableGet.stream values).reverse)
        (if context then (TableGet.stream values).reverse else other) precision counter [] discard []⟩=
      some ⟨some (.normalize 0),last,store reader (if context then other else (TableGet.stream values).reverse)
        (if context then (TableGet.stream values).reverse else other) precision [] (values.getD (binaryValue counter) []).reverse discard []⟩ ∧
    Stacks.stackRunClock program ticks ⟨some (.lookup context (.copy .emit)),v,
      store reader (if context then other else (TableGet.stream values).reverse)
        (if context then (TableGet.stream values).reverse else other) precision counter [] discard []⟩≤
      30000*(1+(TableGet.stream values).length)*(1+(TableGet.stream values).length+counter.length)^2 := by
  let params := if context then other else (TableGet.stream values).reverse
  let counters := if context then (TableGet.stream values).reverse else other
  let S := store reader params counters precision counter [] discard []
  have hinj := lookupCode_injective context
  have hsame : StackCall.frame (lookupCode context) S (ReadonlyTableGet.store (TableGet.stream values).reverse [] counter [])=S := by
    apply StackCall.frame_same _ _ _ hinj
    intro k
    cases context <;> cases k with
    | inl k => fin_cases k <;> rfl
    | inr k => cases k <;> rfl
  have hfinal : StackCall.frame (lookupCode context) S (ReadonlyTableGet.store (TableGet.stream values).reverse [] [] (values.getD (binaryValue counter) []).reverse)=
      store reader params counters precision [] (values.getD (binaryValue counter) []).reverse discard [] := by
    funext bank
    cases context <;> cases bank
    all_goals first
    | exact StackCall.frame_at (lookupCode _) S _ hinj (Sum.inl 0)
    | exact StackCall.frame_at (lookupCode _) S _ hinj (Sum.inl 1)
    | exact StackCall.frame_at (lookupCode _) S _ hinj (Sum.inr TableGet.Slot.reader)
    | exact StackCall.frame_at (lookupCode _) S _ hinj (Sum.inr TableGet.Slot.index)
    | exact StackCall.frame_at (lookupCode _) S _ hinj (Sum.inr TableGet.Slot.indexTemp)
    | exact StackCall.frame_at (lookupCode _) S _ hinj (Sum.inr TableGet.Slot.markers)
    | exact StackCall.frame_at (lookupCode _) S _ hinj (Sum.inr TableGet.Slot.payload)
    | exact StackCall.frame_at (lookupCode _) S _ hinj (Sum.inr TableGet.Slot.count)
    | exact StackCall.frame_at (lookupCode _) S _ hinj (Sum.inr TableGet.Slot.temporary)
    | exact StackCall.frame_at (lookupCode _) S _ hinj (Sum.inr TableGet.Slot.header)
    | exact StackCall.frame_at (lookupCode _) S _ hinj (Sum.inr TableGet.Slot.scratch)
    | exact StackCall.frame_at (lookupCode _) S _ hinj (Sum.inr TableGet.Slot.output)
    | (rw [WordValidator.frame_outside (lookupCode _) S _ _ (by
         intro k
         cases k with
         | inl k => fin_cases k <;> simp [lookupCode]
         | inr k => cases k <;> simp [lookupCode])]; rfl)
  obtain ⟨ticks,last,hr,hc⟩ := ReadonlyTableGet.complete values counter [] (getLookup v)
  simp only [List.append_nil,List.length_nil,Nat.add_zero] at hr hc
  obtain ⟨hN,hNC⟩ := StackCall.execution (lookupCode context) (Label.lookup context) (.normalize 0) getLookup putLookup
    (StackCall.frame (lookupCode context) S)
    (fun data k => StackCall.frame_at _ _ data hinj k)
    (fun data k bits => StackCall.frame_update _ _ data hinj k bits)
    (fun _ _ => rfl) (fun _ _ _ => rfl) ReadonlyTableGet.program program (fun _ => rfl) v ticks _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,getLookup,putLookup,hsame,hfinal] at hN hNC
  exact ⟨ticks,putLookup v last,hN,hNC.trans_le hc⟩

