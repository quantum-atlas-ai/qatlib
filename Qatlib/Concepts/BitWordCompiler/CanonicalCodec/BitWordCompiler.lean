def initialStore (input : Bits) : Slot → Bits :=
    Function.update (fun _ => []) (some .input) input.reverse

theorem initial_eq (input : Bits) : (TM2.init (some Work.input) input.reverse : TM2.Cfg (fun _ : Slot => Bool) Label Local)=
    ⟨some (.prepare 0),default,initialStore input⟩ := rfl

theorem prepare_initial_frame (input : Bits) :
    StackCall.frame prepareCode (initialStore input)
      (ValidatorInput.store [] input input (List.replicate input.length true))=
        rootStore input input [] [] (List.replicate input.length true) [] := by
  let data := ValidatorInput.store [] input input (List.replicate input.length true)
  have hinj := prepareCode_injective
  funext j
  cases j with
  | none =>
    rw [frame_outside prepareCode (initialStore input) _ none (by intro k; cases k <;> simp [prepareCode])]
    rfl
  | some bank =>
    cases bank
    all_goals first
    | exact StackCall.frame_at prepareCode (initialStore input) data hinj ValidatorInput.Slot.input
    | exact StackCall.frame_at prepareCode (initialStore input) data hinj ValidatorInput.Slot.reader
    | exact StackCall.frame_at prepareCode (initialStore input) data hinj ValidatorInput.Slot.original
    | exact StackCall.frame_at prepareCode (initialStore input) data hinj ValidatorInput.Slot.fuel
    | (rw [frame_outside prepareCode (initialStore input) _ _ (by intro k; cases k <;> simp [prepareCode])]
       simp [initialStore,rootStore])

theorem prepare_initial (input : Bits) (v : Local) :
    Stacks.stackRun program (input.length+1) ⟨some (.prepare 0),v,initialStore input⟩=
      some ⟨some (.step .beginWidth),putIO v none,rootStore input input [] [] (List.replicate input.length true) []⟩ ∧
    Stacks.stackRunClock program (input.length+1) ⟨some (.prepare 0),v,initialStore input⟩=
      input.length*(4*input.length+9)+3 := by
  obtain ⟨hr,hc⟩ := prepare_all input (initialStore input) v (by
    intro k
    cases k <;> simp [prepareCode,initialStore,ValidatorInput.store])
  rw [prepare_initial_frame] at hr
  exact ⟨hr,hc⟩

theorem rootStore_update_width (raw reader width count fuel field next : Bits) :
    Function.update (rootStore raw reader width count fuel field) (some .width) next=rootStore raw reader next count fuel field := by
  funext k
  cases k with
  | none => rfl
  | some bank => cases bank <;> rfl

theorem rootStore_update_count (raw reader width count fuel field next : Bits) :
    Function.update (rootStore raw reader width count fuel field) (some .opCount) next=rootStore raw reader width next fuel field := by
  funext k
  cases k with
  | none => rfl
  | some bank => cases bank <;> rfl

theorem rootStore_update_fuel (raw reader width count fuel field next : Bits) :
    Function.update (rootStore raw reader width count fuel field) (some .fuel) next=rootStore raw reader width count next field := by
  funext k
  cases k with
  | none => rfl
  | some bank => cases bank <;> rfl

theorem transfer_frame_empty (job : Transfer) (S : Slot → Bits) (houtput : S (transferBanks job).2=[]) :
    StackCall.frame (transferCode job) S (Stacks.stackPair [] (S (transferBanks job).1).reverse)=
      Function.update (Function.update S (transferBanks job).1 []) (transferBanks job).2 (S (transferBanks job).1).reverse := by
  have hinj := transferCode_injective job
  let input := S (transferBanks job).1
  have hsame : StackCall.frame (transferCode job) S (Stacks.stackPair input [])=S := by
    apply StackCall.frame_same _ _ _ hinj
    intro k
    fin_cases k <;> simp [transferCode,input,houtput]
  have h0 := StackCall.frame_update (transferCode job) S (Stacks.stackPair input []) hinj 0 []
  simp only [Stacks.stackPair_update_zero,hsame] at h0
  have h1 :=
      StackCall.frame_update (transferCode job) S (Stacks.stackPair [] []) hinj 1 input.reverse
  simp only [Stacks.stackPair_update_one,h0] at h1
  exact h1

theorem increment_frame (S : Slot → Bits) (old next : Bits)
    (hvalue : S (some .value)=old) (hmarker : S (some .tempCount)=[]) :
    StackCall.frame incrementCode S (Stacks.stackPair next [])=Function.update S (some .value) next := by
  have hinj := incrementCode_injective
  have hsame : StackCall.frame incrementCode S (Stacks.stackPair old [])=S := by
    apply StackCall.frame_same _ _ _ hinj
    intro k
    fin_cases k <;> simp [incrementCode,hvalue,hmarker]
  have h0 := StackCall.frame_update incrementCode S (Stacks.stackPair old []) hinj 0 next
  simpa only [Stacks.stackPair_update_zero,hsame] using! h0

theorem insert_frame (S : Slot → Bits) (old next target : Bits)
    (hdata : ∀ k,S (insertCode k)=NatSetInsert.store old target [] [] [] [] [] [] [] k) :
    StackCall.frame insertCode S (NatSetInsert.store next target [] [] [] [] [] [] [])=Function.update S (some .seen) next := by
  have hinj := insertCode_injective
  let data := NatSetInsert.store old target [] [] [] [] [] [] []
  have hsame : StackCall.frame insertCode S data=S := StackCall.frame_same _ _ _ hinj hdata
  have hstore : Function.update data (some .seen) next=NatSetInsert.store next target [] [] [] [] [] [] [] := by
    funext k
    cases k with
    | none => rfl
    | some bank => cases bank <;> rfl
  have hs := StackCall.frame_update insertCode S data hinj (some .seen) next
  simpa only [hstore,hsame] using! hs

theorem header_valid (input : Bits) (width count : ℕ) (tail : Bits) (v : Local)
    (hinput : input=natBits width++(natBits count++tail)) :
    ∃ ticks last,
      Stacks.stackRun program ticks ⟨some (.prepare 0),v,initialStore input⟩=
        some ⟨some (.step .root),last,
          rootStore input tail width.bits.reverse count.bits (List.replicate input.length true) []⟩ ∧
      Stacks.stackRunClock program ticks ⟨some (.prepare 0),v,initialStore input⟩≤1000*(1+input.length)^2 := by
  let fuel := List.replicate input.length true
  let S0 := rootStore input input [] [] fuel []
  let S1 := rootStore input (natBits count++tail) width.bits.reverse [] fuel []
  let S2 := rootStore input tail width.bits.reverse [] fuel count.bits.reverse
  let v0 := putIO v none
  let v1 := putParse v0 (true,CheckedNat.lastField width.bits none)
  let v2 := putParse v1 (true,CheckedNat.lastField count.bits none)
  obtain ⟨hP,hPC⟩ := prepare_initial input v
  obtain ⟨hB,hBC⟩ := goto_phase .beginWidth (.read .width .afterWidth .unary) rfl S0 v0
  obtain ⟨widthTicks,hW,hWC⟩ :=
      read_valid .width .afterWidth S0 v0 width (natBits count++tail) hinput rfl rfl
  rw [read_frame .width S0 (natBits count++tail) width.bits.reverse rfl rfl] at hW
  simp only [S0,readBank,rootStore_update_reader,rootStore_update_width] at hW
  obtain ⟨hA,hAC⟩ := parsed_true .afterWidth (.read .field .afterCount .unary) rfl S1 v1 rfl
  obtain ⟨countTicks,hN,hNC⟩ := read_valid .field .afterCount S1 v1 count tail rfl rfl rfl
  rw [read_frame .field S1 tail count.bits.reverse rfl rfl] at hN
  simp only [S1,readBank,rootStore_update_reader,rootStore_update_field] at hN
  obtain ⟨hC,hCC⟩ := parsed_true .afterCount (.transfer .fieldToOpCount .root 0) rfl S2 v2 rfl
  obtain ⟨hT,hTC⟩ := transfer_all .fieldToOpCount .root S2 v2
  have hi : S2 (transferBanks .fieldToOpCount).1=count.bits.reverse := rfl
  have ho : S2 (transferBanks .fieldToOpCount).2=[] := rfl
  simp only [ho,List.append_nil] at hT
  rw [transfer_frame_empty .fieldToOpCount S2 ho] at hT
  simp only [hi,ho,List.reverse_reverse,List.length_reverse,List.length_nil,Nat.add_zero] at hT hTC
  simp only [transferBanks,S2,rootStore_update_field,rootStore_update_count] at hT
  have eP : Stacks.Execution program _ _ _ := ⟨input.length+1,hP,hPC.le⟩
  have eB : Stacks.Execution program _ _ 1 := ⟨1,hB,hBC.le⟩
  have eW : Stacks.Execution program _ _ _ := ⟨widthTicks,hW,hWC⟩
  have eA : Stacks.Execution program _ _ 1 := ⟨1,hA,hAC.le⟩
  have eN : Stacks.Execution program _ _ _ := ⟨countTicks,hN,hNC⟩
  have eC : Stacks.Execution program _ _ 1 := ⟨1,hC,hCC.le⟩
  have eT : Stacks.Execution program _ _ _ := ⟨count.bits.length+1,hT,hTC.le⟩
  obtain ⟨ticks,hr,hc⟩ := (((((eP.trans eB).trans eW).trans eA).trans eN).trans eC).trans eT
  refine ⟨ticks,_,hr,hc.trans ?_⟩
  let B := 1+input.length
  have hB : 1≤B := by dsimp [B]; omega
  have hB2 : B≤B^2 := Nat.le_pow (by decide)
  have hL : input.length≤B := by dsimp [B]; omega
  have hL2 := Nat.mul_le_mul hL hL
  have hcount : count.bits.length≤B := by
    dsimp [B]; rw [hinput]; simp only [List.length_append,natBits_length]; omega
  have hcount2 := Nat.mul_le_mul hcount hcount
  have hrest : 1+(natBits count++tail).length≤B := by
    dsimp [B]; rw [hinput]; simp only [List.length_append]; omega
  have hrest2 := Nat.pow_le_pow_left hrest 2
  change input.length*(4*input.length+9)+3+1+50*B^2+1+50*(1+(natBits count++tail).length)^2+1+
    (count.bits.length*(2*count.bits.length+5)+3)≤1000*B^2
  nlinarith only [hB,hB2,hL,hL2,hcount,hcount2,hrest2]

theorem root_count_zero (raw reader width counter fuel : Bits) (v : Local) (hz : binaryValue counter=0) :
    ∃ ticks last,
      Stacks.stackRun program ticks ⟨some (.step .root),v,rootStore raw reader width counter fuel []⟩=
        some ⟨some (.step .checkEnd),last,rootStore raw reader width [] fuel []⟩ ∧
      Stacks.stackRunClock program ticks ⟨some (.step .root),v,rootStore raw reader width counter fuel []⟩≤
        100*(1+counter.length+fuel.length)^2 := by
  let S0 := rootStore raw reader width counter fuel []
  let S1 := rootStore raw reader width (List.replicate counter.length true) fuel []
  let v1 := putGuard v (.zero,(false,none),v.guarded.2.2)
  obtain ⟨hB,hBC⟩ := goto_phase .root (.guard false .rootResult (.counter .borrow)) rfl S0 v
  obtain ⟨guardTicks,hG,hGC⟩ := guard_zero false .rootResult S0 v rfl hz
  change Stacks.stackRun program guardTicks ⟨some (.guard false .rootResult (.counter .borrow)),v,S0⟩=
    some ⟨some (.step .rootResult),v1,StackCall.frame (guardCode false) S0 (Parsing.triple (List.replicate counter.length true) [] fuel)⟩ at hG
  change _≤20*(1+counter.length+fuel.length)^2 at hGC
  rw [guard_frame false S0 (List.replicate counter.length true) fuel rfl] at hG
  simp only [Bool.false_eq_true,if_false,S0,rootStore_update_count,rootStore_update_fuel] at hG
  obtain ⟨hZ,hZC⟩ := root_zero S1 v1 rfl
  obtain ⟨hD,hDC⟩ :=
      drain_call (Label.drain .opCount .checkEnd) (.step .checkEnd) .opCount (fun _ => rfl) S1 v1
  have hcounter : S1 (some .opCount)=List.replicate counter.length true := rfl
  rw [hcounter] at hD hDC
  simp only [S1,rootStore_update_count] at hD
  have eB : Stacks.Execution program _ _ 1 := ⟨1,hB,hBC.le⟩
  have eG : Stacks.Execution program _ _ _ := ⟨guardTicks,hG,hGC⟩
  have eZ : Stacks.Execution program _ _ 1 := ⟨1,hZ,hZC.le⟩
  have eD : Stacks.Execution program _ _ _ :=
      ⟨(List.replicate counter.length true).length+1,hD,hDC.le⟩
  obtain ⟨ticks,hr,hc⟩ := ((eB.trans eG).trans eZ).trans eD
  refine ⟨ticks,_,hr,hc.trans ?_⟩
  let B := 1+counter.length+fuel.length
  have hB : 1≤B := by dsimp [B]; omega
  have hB2 : B≤B^2 := Nat.le_pow (by decide)
  have hcounter : counter.length≤B := by dsimp [B]; omega
  have hcounter2 := Nat.mul_le_mul hcounter hcounter
  simp only [List.length_replicate]
  change 1+20*B^2+1+(counter.length^2+3*counter.length+3)≤100*B^2
  nlinarith only [hB,hB2,hcounter,hcounter2]

theorem rootStore_cap (raw reader width count fuel field : Bits) (height : ℕ) :
    Cap (rootStore raw reader width count fuel field) height ↔
      raw.length≤height ∧ reader.length≤height ∧ width.length≤height ∧ count.length≤height ∧
        fuel.length≤height ∧ field.length≤height := by
  constructor
  · intro h
    exact ⟨h .original,h .reader,h .width,h .opCount,h .fuel,h .field⟩
  · rintro ⟨hr,hi,hw,hc,hf,hp⟩ bank
    cases bank <;> simp [rootStore,hr,hi,hw,hc,hf,hp]

theorem check_end (S : Slot → Bits) (v : Local) :
    Stacks.stackRun program 1 ⟨some (.step .checkEnd),v,S⟩=
      some ⟨some (.step (if S (some .reader)=[] then .success else .failure)),putIO v (S (some .reader)).head?,S⟩ ∧
    Stacks.stackRunClock program 1 ⟨some (.step .checkEnd),v,S⟩=2*(S (some .reader)).length+3 := by
  cases he : S (some .reader) with
  | nil => constructor <;> simp [Stacks.run_one,Stacks.stackRunClock,TM2.step,program,phaseProgram,go,TM2.stepAux,Stacks.stackClock,he,putIO]
  | cons bit bits =>
    constructor <;> simp [Stacks.run_one,Stacks.stackRunClock,TM2.step,program,phaseProgram,go,TM2.stepAux,Stacks.stackClock,he,putIO]
    omega

def controlKey : Option ℕ → ℕ
  | none => 0
  | some n => n+1

theorem control_key_range (control : Option ℕ) (width : ℕ) : controlKey control≤width ↔ ∀ a∈control,a<width := by
  cases control with
  | none => simp [controlKey]
  | some n => simpa [controlKey] using (show n+1≤width ↔ n<width by omega)

theorem control_keys_nodup (control : Option ℕ) (wires : List ℕ) :
    (controlKey control::wires.map Nat.succ).Nodup ↔ wires.Nodup ∧ ∀ a∈control,a∉wires := by
  cases control with
  | none => simp [controlKey,List.nodup_cons,List.nodup_map_iff Nat.succ_injective]
  | some n => simp [controlKey,List.nodup_cons,List.nodup_map_iff Nat.succ_injective,and_comm]

theorem oracle_legal_keys (width slot : ℕ) (control : Option ℕ) (adjoint : Bool) (wires : List ℕ) :
    legalOpcode width (.oracle slot control adjoint wires) ↔
      (∀ a∈wires,a<width) ∧ controlKey control≤width ∧ (controlKey control::wires.map Nat.succ).Nodup := by
  rw [control_key_range,control_keys_nodup]
  constructor
  · intro h
    exact ⟨h.1,fun a ha => (h.2.2 a ha).1,h.2.1,fun a ha => (h.2.2 a ha).2⟩
  · rintro ⟨hw,hc,hn,hd⟩
    exact ⟨hw,hn,fun a ha => ⟨hc a ha,hd a ha⟩⟩

theorem header_width_reject (input : Bits) (v : Local) (hbad : readNat input=none) :
    ∃ ticks last,
      Stacks.stackRun program ticks ⟨some (.prepare 0),v,initialStore input⟩=
        some ⟨none,last,Function.update (fun _ => []) none [false]⟩ ∧
      Stacks.stackRunClock program ticks ⟨some (.prepare 0),v,initialStore input⟩≤1000*(1+input.length)^2 := by
  let S0 := rootStore input input [] [] (List.replicate input.length true) []
  let v0 := putIO v none
  have hCap : Cap S0 input.length := by
    apply (rootStore_cap _ _ _ _ _ _ _).mpr
    simp [List.length_replicate]
  obtain ⟨hP,hPC⟩ := prepare_initial input v
  obtain ⟨hB,hBC⟩ := goto_phase .beginWidth (.read .width .afterWidth .unary) rfl S0 v0
  obtain ⟨parseTicks,parseLast,T,hR,hTcap,hTout,hRC⟩ := parsed_failure .width .afterWidth (.read .field .afterCount .unary) rfl
    S0 v0 input.length hCap rfl rfl hbad
  have hTzero : T none=[] := hTout
  obtain ⟨clearTicks,hF,hFC⟩ := failure_output T parseLast input.length hTzero hTcap
  have eP : Stacks.Execution program _ _ _ := ⟨input.length+1,hP,hPC.le⟩
  have eB : Stacks.Execution program _ _ 1 := ⟨1,hB,hBC.le⟩
  have eR : Stacks.Execution program _ _ _ := ⟨parseTicks,hR,hRC⟩
  have eF : Stacks.Execution program _ _ _ := ⟨clearTicks,hF,hFC⟩
  obtain ⟨ticks,hr,hc⟩ := ((eP.trans eB).trans eR).trans eF
  refine ⟨ticks,_,hr,hc.trans ?_⟩
  let B := 1+input.length
  have hB : 1≤B := by dsimp [B]; omega
  have hB2 : B≤B^2 := Nat.le_pow (by decide)
  have hL : input.length≤B := by dsimp [B]; omega
  have hL2 := Nat.mul_le_mul hL hL
  change input.length*(4*input.length+9)+3+1+60*B^2+210*B^2≤1000*B^2
  nlinarith only [hB,hB2,hL,hL2]

theorem header_count_reject (input : Bits) (width : ℕ) (rest : Bits) (v : Local)
    (hinput : input=natBits width++rest) (hbad : readNat rest=none) :
    ∃ ticks last,
      Stacks.stackRun program ticks ⟨some (.prepare 0),v,initialStore input⟩=
        some ⟨none,last,Function.update (fun _ => []) none [false]⟩ ∧
      Stacks.stackRunClock program ticks ⟨some (.prepare 0),v,initialStore input⟩≤1000*(1+input.length)^2 := by
  let fuel := List.replicate input.length true
  let S0 := rootStore input input [] [] fuel []
  let S1 := rootStore input rest width.bits.reverse [] fuel []
  let v0 := putIO v none
  let v1 := putParse v0 (true,CheckedNat.lastField width.bits none)
  have hlen : rest.length≤input.length := by rw [hinput,List.length_append]; omega
  have hw : width.bits.length≤input.length := by
    rw [hinput,List.length_append,natBits_length]; omega
  have hCap : Cap S1 input.length := by
    apply (rootStore_cap _ _ _ _ _ _ _).mpr
    simp only [List.length_reverse,List.length_nil,fuel,List.length_replicate]
    exact ⟨le_rfl,hlen,hw,Nat.zero_le _,le_rfl,Nat.zero_le _⟩
  obtain ⟨hP,hPC⟩ := prepare_initial input v
  obtain ⟨hB,hBC⟩ := goto_phase .beginWidth (.read .width .afterWidth .unary) rfl S0 v0
  obtain ⟨widthTicks,hW,hWC⟩ := read_valid .width .afterWidth S0 v0 width rest hinput rfl rfl
  rw [read_frame .width S0 rest width.bits.reverse rfl rfl] at hW
  simp only [S0,readBank,rootStore_update_reader,rootStore_update_width] at hW
  obtain ⟨hA,hAC⟩ := parsed_true .afterWidth (.read .field .afterCount .unary) rfl S1 v1 rfl
  obtain ⟨parseTicks,parseLast,T,hR,hTcap,hTout,hRC⟩ := parsed_failure .field .afterCount (.transfer .fieldToOpCount .root 0) rfl
    S1 v1 input.length hCap rfl rfl hbad
  have hTzero : T none=[] := hTout
  obtain ⟨clearTicks,hF,hFC⟩ := failure_output T parseLast input.length hTzero hTcap
  have eP : Stacks.Execution program _ _ _ := ⟨input.length+1,hP,hPC.le⟩
  have eB : Stacks.Execution program _ _ 1 := ⟨1,hB,hBC.le⟩
  have eW : Stacks.Execution program _ _ _ := ⟨widthTicks,hW,hWC⟩
  have eA : Stacks.Execution program _ _ 1 := ⟨1,hA,hAC.le⟩
  have eR : Stacks.Execution program _ _ _ := ⟨parseTicks,hR,hRC⟩
  have eF : Stacks.Execution program _ _ _ := ⟨clearTicks,hF,hFC⟩
  obtain ⟨ticks,hr,hc⟩ := ((((eP.trans eB).trans eW).trans eA).trans eR).trans eF
  refine ⟨ticks,_,hr,hc.trans ?_⟩
  let B := 1+input.length
  have hB : 1≤B := by dsimp [B]; omega
  have hB2 : B≤B^2 := Nat.le_pow (by decide)
  have hL : input.length≤B := by dsimp [B]; omega
  have hL2 := Nat.mul_le_mul hL hL
  change input.length*(4*input.length+9)+3+1+50*B^2+1+60*B^2+210*B^2≤1000*B^2
  nlinarith only [hB,hB2,hL,hL2]

theorem root_fuel_empty (raw reader width counter : Bits) (v : Local) (hp : 0<binaryValue counter) :
    ∃ ticks last output,output.length=counter.length ∧ binaryValue output+1=binaryValue counter ∧
      Stacks.stackRun program ticks ⟨some (.step .root),v,rootStore raw reader width counter [] []⟩=
        some ⟨some (.step .failure),last,rootStore raw reader width output [] []⟩ ∧
      Stacks.stackRunClock program ticks ⟨some (.step .root),v,rootStore raw reader width counter [] []⟩≤100*(1+counter.length)^2 := by
  let S0 := rootStore raw reader width counter [] []
  let v1 := putGuard v (.exhausted,(true,none),none)
  obtain ⟨hB,hBC⟩ := goto_phase .root (.guard false .rootResult (.counter .borrow)) rfl S0 v
  obtain ⟨guardTicks,output,hlen,hvalue,hG,hGC⟩ := guard_positive false .rootResult S0 v rfl hp
  change output.length=counter.length at hlen
  change binaryValue output+1=binaryValue counter at hvalue
  change Stacks.stackRun program guardTicks ⟨some (.guard false .rootResult (.counter .borrow)),v,S0⟩=
    some ⟨some (.step .rootResult),v1,StackCall.frame (guardCode false) S0 (Parsing.triple output [] [])⟩ at hG
  change _≤20*(1+counter.length)^2 at hGC
  rw [guard_frame false S0 output [] rfl] at hG
  simp only [Bool.false_eq_true,if_false,S0,rootStore_update_count,rootStore_update_fuel] at hG
  obtain ⟨hE,hEC⟩ := root_exhausted (rootStore raw reader width output [] []) v1 rfl
  have eB : Stacks.Execution program _ _ 1 := ⟨1,hB,hBC.le⟩
  have eG : Stacks.Execution program _ _ _ := ⟨guardTicks,hG,hGC⟩
  have eE : Stacks.Execution program _ _ 1 := ⟨1,hE,hEC.le⟩
  obtain ⟨ticks,hr,hc⟩ := (eB.trans eG).trans eE
  refine ⟨ticks,_,output,hlen,hvalue,hr,hc.trans ?_⟩
  have hp : 1≤(1+counter.length)^2 := Nat.one_le_pow 2 _ (by omega)
  omega

theorem root_count_positive (raw reader width counter : Bits) (fuel : ℕ) (v : Local) (hp : 0<binaryValue counter) :
    ∃ ticks last output,output.length=counter.length ∧ binaryValue output+1=binaryValue counter ∧
      Stacks.stackRun program ticks ⟨some (.step .root),v,rootStore raw reader width counter (List.replicate (fuel+1) true) []⟩=
        some ⟨some (.read .field .afterOpTag .unary),last,rootStore raw reader width output (List.replicate fuel true) []⟩ ∧
      Stacks.stackRunClock program ticks ⟨some (.step .root),v,rootStore raw reader width counter (List.replicate (fuel+1) true) []⟩≤
        100*(1+counter.length+(fuel+1))^2 := by
  let S0 := rootStore raw reader width counter (List.replicate (fuel+1) true) []
  let v1 := putGuard v (.next,(true,none),some true)
  obtain ⟨hB,hBC⟩ := goto_phase .root (.guard false .rootResult (.counter .borrow)) rfl S0 v
  obtain ⟨guardTicks,output,hlen,hvalue,hG,hGC⟩ := guard_positive false .rootResult S0 v rfl hp
  change output.length=counter.length at hlen
  change binaryValue output+1=binaryValue counter at hvalue
  change Stacks.stackRun program guardTicks ⟨some (.guard false .rootResult (.counter .borrow)),v,S0⟩=
    some ⟨some (.step .rootResult),v1,StackCall.frame (guardCode false) S0 (Parsing.triple output [] (List.replicate fuel true))⟩ at hG
  change _≤20*(1+counter.length+(List.replicate (fuel+1) true).length)^2 at hGC
  simp only [List.length_replicate] at hGC
  rw [guard_frame false S0 output (List.replicate fuel true) rfl] at hG
  simp only [Bool.false_eq_true,if_false,S0,rootStore_update_count,rootStore_update_fuel] at hG
  obtain ⟨hN,hNC⟩ :=
      root_next (rootStore raw reader width output (List.replicate fuel true) []) v1 rfl
  have eB : Stacks.Execution program _ _ 1 := ⟨1,hB,hBC.le⟩
  have eG : Stacks.Execution program _ _ _ := ⟨guardTicks,hG,hGC⟩
  have eN : Stacks.Execution program _ _ 1 := ⟨1,hN,hNC.le⟩
  obtain ⟨ticks,hr,hc⟩ := (eB.trans eG).trans eN
  refine ⟨ticks,_,output,hlen,hvalue,hr,hc.trans ?_⟩
  have hp : 1≤(1+counter.length+(fuel+1))^2 := Nat.one_le_pow 2 _ (by omega)
  omega
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.WordValidator

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.ValidatorSemantics
open Qatlib.Concepts.BitWordCompiler.CanonicalCodec

def readWires : ℕ → ℕ → ℕ → List ℕ → Bits → Option (List ℕ×Bits×ℕ×List ℕ)
  | fuel,0,_,seen,input => some ([],input,fuel,seen)
  | 0,_+1,_,_,_ => none
  | fuel+1,count+1,width,seen,input => do
      let (wire,tail) ← readNat input
      if wire<width ∧ wire+1∉seen then
        let (wires,rest,left,last) ← readWires fuel count width (seen++[wire+1]) tail
        pure (wire::wires,rest,left,last)
      else none

theorem readWires_complete (wires seen : List ℕ) (tail : Bits) (fuel width : ℕ)
    (hlegal : ∀ a∈wires,a<width) (hkeys : (seen++wires.map Nat.succ).Nodup) (hfuel : wires.length≤fuel) :
    readWires fuel wires.length width seen (wires.flatMap natBits++tail)=
      some (wires,tail,fuel-wires.length,seen++wires.map Nat.succ) := by
  induction wires generalizing seen fuel with
  | nil => simp [readWires]
  | cons wire wires ih =>
    have hwire : wire<width := hlegal wire (by simp)
    have hrest : ∀ a∈wires,a<width := by intro a ha; exact hlegal a (by simp [ha])
    have hn : wire+1∉seen := by
      intro hm
      have hd := (List.nodup_append.mp hkeys).2.2 (wire+1) hm (wire+1) (by simp)
      exact hd rfl
    have hk : ((seen++[wire+1])++wires.map Nat.succ).Nodup := by
      simpa only [List.append_assoc,List.singleton_append,List.map_cons,Nat.succ_eq_add_one] using
          hkeys
    cases fuel with
    | zero => simp only [List.length_cons] at hfuel; omega
    | succ fuel =>
      have hf : wires.length≤fuel := by
        simpa only [List.length_cons,Nat.succ_le_succ_iff] using hfuel
      simp only [List.length_cons,List.flatMap_cons,List.append_assoc,readWires,readNat_complete,
        Option.bind_eq_bind,Option.bind_some,if_pos (And.intro hwire hn)]
      rw [ih (seen++[wire+1]) fuel hrest hk hf]
      simp only [Option.bind_some,pure,List.map_cons,Nat.succ_eq_add_one,List.append_assoc,List.singleton_append]
      congr 4
      omega

theorem readWires_sound (fuel count width : ℕ) (seen : List ℕ) (input : Bits)
    (wires : List ℕ) (rest : Bits) (left : ℕ) (last : List ℕ)
    (h : readWires fuel count width seen input=some (wires,rest,left,last)) :
    wires.length=count ∧ (∀ a∈wires,a<width) ∧ input=wires.flatMap natBits++rest ∧
      wires.length+left=fuel ∧ last=seen++wires.map Nat.succ ∧ (seen.Nodup → last.Nodup) := by
  induction count generalizing fuel seen input wires rest left last with
  | zero =>
    simp only [readWires,Option.some.injEq,Prod.mk.injEq] at h
    rcases h with ⟨rfl,rfl,rfl,rfl⟩
    simp
  | succ count ih =>
    cases fuel with
    | zero => simp [readWires] at h
    | succ fuel =>
      simp only [readWires] at h
      cases hn : readNat input with
      | none => simp [hn] at h
      | some pair =>
        rcases pair with ⟨wire,tail⟩
        simp only [hn,Option.bind_eq_bind,Option.bind_some] at h
        split_ifs at h with hc
        cases hr : readWires fuel count width (seen++[wire+1]) tail with
        | none => simp [hr] at h
        | some quad =>
          rcases quad with ⟨ws,ret,left',last'⟩
          simp only [hr,Option.bind_some,pure,Option.some.injEq,Prod.mk.injEq] at h
          rcases h with ⟨rfl,rfl,rfl,rfl⟩
          obtain ⟨hlen,hw,hinput,hfuel,hlast,hnd⟩ :=
              ih fuel (seen++[wire+1]) tail ws ret left' last' hr
          refine ⟨by simp [hlen],?_,?_,?_,?_,?_⟩
          · intro a ha
            rcases List.mem_cons.mp ha with rfl|ha
            · exact hc.1
            · exact hw a ha
          · rw [readNat_sound input wire tail hn,hinput]
            simp only [List.flatMap_cons,List.append_assoc]
          · simp only [List.length_cons]
            omega
          · simpa only
              [List.map_cons,List.append_assoc,List.singleton_append,Nat.succ_eq_add_one] using
              hlast
          · intro hseen
            apply hnd
            simpa only [TM.NatSetInsert.inserted,if_neg hc.2] using
                TM.NatSetInsert.inserted_nodup seen (wire+1) hseen
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.ValidatorSemantics

