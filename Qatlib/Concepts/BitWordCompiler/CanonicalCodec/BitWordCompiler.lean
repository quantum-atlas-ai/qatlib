theorem drain_payload (bits counter width markers output : Bits) (v : Local) :
    Stacks.stackRun program (bits.length+1) ⟨some (.drainWidthClone 0),v,store [] counter [] width markers bits [] output⟩=
      some ⟨some (.incrementPrecision .carry),ReadonlyRepeat.putIO v none,store [] counter [] width markers [] [] output⟩ ∧
    Stacks.stackRunClock program (bits.length+1) ⟨some (.drainWidthClone 0),v,store [] counter [] width markers bits [] output⟩=
      bits.length^2+3*bits.length+3 := by
  have hr := Normalization.drain_run bits (ReadonlyRepeat.getIO v)
  obtain ⟨hN,hNC⟩ := StackCall.execution (fun _ : Fin 1 => Slot.payload) Label.drainWidthClone (.incrementPrecision .carry)
    ReadonlyRepeat.getIO ReadonlyRepeat.putIO (drainPayloadFrame [] counter [] width markers [] output)
    (drainPayloadFrame_at [] counter [] width markers [] output) (drainPayloadFrame_update [] counter [] width markers [] output)
    (fun _ _ => rfl) (fun _ _ _ => rfl) Normalization.drainProgram program (fun _ => rfl) v (bits.length+1) _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,
    drainPayloadFrame,Normalization.singleStack_zero,ReadonlyRepeat.putIO_get] at hN hNC
  exact ⟨hN,hNC.trans (Normalization.drain_clock bits (ReadonlyRepeat.getIO v))⟩

theorem shift_precision (n : ℕ) (hn : 0<n) (width markers output : Bits) (v : Local) :
    Stacks.stackRun program 1 ⟨some .shiftPrecision,v,store [] n.bits [] width markers [] [] output⟩=
      some ⟨some (.emitPrecision .count),v,store [] (2*n).bits [] width markers [] [] output⟩ ∧
    Stacks.stackRunClock program 1 ⟨some .shiftPrecision,v,store [] n.bits [] width markers [] [] output⟩=2*n.bits.length+4 := by
  rw [NativeEcho.twice_bits n hn]
  constructor
  · simp [Stacks.run_one,TM2.step,program,TM2.stepAux]
  · simp [Stacks.stackRunClock,program,Stacks.stackClock]
    omega

theorem unshift_precision (n : ℕ) (hn : 0<n) (width markers output : Bits) (v : Local) :
    Stacks.stackRun program 1 ⟨some .unshiftPrecision,v,store [] (2*n).bits [] width markers [] [] output⟩=
      some ⟨some .blockStart,v,store [] n.bits [] width markers [] [] output⟩ ∧
    Stacks.stackRunClock program 1 ⟨some .unshiftPrecision,v,store [] (2*n).bits [] width markers [] [] output⟩=2*n.bits.length+4 := by
  rw [NativeEcho.twice_bits n hn]
  constructor
  · simp [Stacks.run_one,TM2.step,program,TM2.stepAux]
  · simp [Stacks.stackRunClock,program,Stacks.stackClock]
    omega

def continuation : Option Label → TM2.Stmt (fun _ : Slot => Bool) Label Local
  | none => .halt
  | some l => .goto (fun _ => l)

theorem push_constant (state : Label) (returnTo : Option Label) (bank : Slot) (bits : Bits)
    (hcode : program state=Stacks.pushBits bank bits (continuation returnTo)) (v : Local) (S : Slot → Bits) :
    Stacks.stackRun program 1 ⟨some state,v,S⟩=
      some ⟨returnTo,v,Function.update S bank (bits.reverse++S bank)⟩ ∧
    Stacks.stackRunClock program 1 ⟨some state,v,S⟩=1+bits.length*(2*(S bank).length+bits.length+2) := by
  constructor
  · rw [Stacks.run_one]
    change some (TM2.stepAux (program state) v S)=_
    rw [hcode,Stacks.pushBits_step]
    cases returnTo <;> rfl
  · change 1+Stacks.stackClock (program state) v S+0=_
    rw [hcode,Stacks.pushBits_clock]
    cases returnTo <;> simp [continuation,Stacks.stackClock]

theorem emit_header (m k : ℕ) (markers : Bits) (v : Local) :
    ∃ ticks,
      Stacks.stackRun program ticks ⟨some (.cloneWidth .emit),v,store [] k.bits [] m.bits markers [] [] []⟩=
        some ⟨some .blockStart,(ReadonlyRepeat.getCounter v,none),store [] (k+1).bits [] m.bits markers [] [] (header m k).reverse⟩ ∧
      Stacks.stackRunClock program ticks ⟨some (.cloneWidth .emit),v,store [] k.bits [] m.bits markers [] [] []⟩≤
        90000*(1+m.bits.length+(m+1).bits.length+k.bits.length+(k+1).bits.length)^2 := by
  let v1 := ReadonlyRepeat.putIO v none
  let out0 := (natBits (m+1)).reverse
  let out1 := (natBits (2*(k+1))).reverse++out0
  obtain ⟨hC,hCC⟩ := clone_width m.bits k.bits markers v
  obtain ⟨hT,hTC⟩ := transfer_width_clone m.bits k.bits m.bits markers v1
  obtain ⟨iwTicks,hIW,hIWC⟩ := increment_width m [] k.bits m.bits markers [] [] v1
  obtain ⟨hW,hWC⟩ := emit_width (m+1) [] k.bits m.bits markers [] [] v1
  simp only [List.append_nil,List.length_nil,Nat.add_zero] at hW hWC
  obtain ⟨hD,hDC⟩ := drain_payload (m+1).bits k.bits m.bits markers out0 v1
  obtain ⟨ikTicks,hIK,hIKC⟩ := increment_precision k [] m.bits markers [] [] out0 v1
  obtain ⟨hS,hSC⟩ := shift_precision (k+1) (by omega) m.bits markers out0 v1
  obtain ⟨hP,hPC⟩ := emit_precision (2*(k+1)) [] m.bits markers [] [] out0 v1
  obtain ⟨hU,hUC⟩ := unshift_precision (k+1) (by omega) m.bits markers out1 v1
  let T := 1+m.bits.length+(m+1).bits.length+k.bits.length+(k+1).bits.length
  let Q := 10000*T^2
  have hT1 : 1≤T := by dsimp [T]; omega
  have hT2 : T≤T^2 := Nat.le_pow (by decide)
  have hm : 1+m.bits.length≤T := by dsimp [T]; omega
  have hmp : 1+(m+1).bits.length≤T := by dsimp [T]; omega
  have hk : 1+k.bits.length≤T := by dsimp [T]; omega
  have hkp : 1+(k+1).bits.length≤T := by dsimp [T]; omega
  have hm2 := Nat.mul_le_mul hm hm
  have hmp2 := Nat.mul_le_mul hmp hmp
  have hk2 := Nat.mul_le_mul hk hk
  have eC : Stacks.Execution program _ _ Q := ⟨2*m.bits.length+3,hC,hCC.trans (by
    dsimp only [Q]; nlinarith only [hm2,Nat.zero_le (T^2)])⟩
  have ht1 : m.bits.length≤T := by omega
  have ht2 : 2*m.bits.length+5≤7*T := by omega
  have htprod := Nat.mul_le_mul ht1 ht2
  have eT : Stacks.Execution program _ _ Q := ⟨m.bits.length+1,hT,by
    rw [hTC]; dsimp only [Q]; nlinarith only [htprod,hT1,hT2]⟩
  have eIW : Stacks.Execution program _ _ Q := ⟨iwTicks,hIW,hIWC.trans (by
    dsimp only [Q]; nlinarith only [hm2,Nat.zero_le (T^2)])⟩
  have eW : Stacks.Execution program _ _ Q := ⟨4*(m+1).bits.length+5,hW,hWC.trans (by
    dsimp only [Q]; nlinarith only [hmp2,Nat.zero_le (T^2)])⟩
  have eD : Stacks.Execution program _ _ Q := ⟨(m+1).bits.length+1,hD,by
    rw [hDC]; dsimp only [Q]; nlinarith only [hmp,hmp2,hT1,hT2]⟩
  have eIK : Stacks.Execution program _ _ Q := ⟨ikTicks,hIK,hIKC.trans (by
    dsimp only [Q]; nlinarith only [hk2,Nat.zero_le (T^2)])⟩
  have eS : Stacks.Execution program _ _ Q := ⟨1,hS,by rw [hSC]; dsimp only [Q]; omega⟩
  have hpArg : 1+(2*(k+1)).bits.length+out0.length≤8*T := by
    rw [NativeEcho.twice_bits (k+1) (by omega)]
    simp only [out0,List.length_cons,List.length_reverse,natBits_length]
    omega
  have hpArg2 := Nat.mul_le_mul hpArg hpArg
  have eP : Stacks.Execution program _ _ Q := ⟨4*(2*(k+1)).bits.length+5,hP,hPC.trans (by
    dsimp only [Q]; nlinarith only [hpArg2,Nat.zero_le (T^2)])⟩
  have eU : Stacks.Execution program _ _ Q := ⟨1,hU,by rw [hUC]; dsimp only [Q]; omega⟩
  obtain ⟨ticks,hr,hc⟩ :=
      ((((((((eC.trans eT).trans eIW).trans eW).trans eD).trans eIK).trans eS).trans eP).trans eU)
  refine ⟨ticks,?_,hc.trans ?_⟩
  · simpa only
      [header,out1,out0,List.flatMap_cons,List.flatMap_nil,List.append_nil,List.reverse_append] using! hr
  · change Q+Q+Q+Q+Q+Q+Q+Q+Q≤90000*T^2
    dsimp only [Q]
    omega

theorem drain_width (code : Fin 1 → Label) (returnTo : Label)
    (hcode : ∀ l,program (code l)=StackCall.stmt (fun _ : Fin 1 => Slot.width) code returnTo
      ReadonlyRepeat.getIO ReadonlyRepeat.putIO (Normalization.drainProgram l))
    (bits reader counter markers payload block output : Bits) (v : Local) :
    Stacks.stackRun program (bits.length+1) ⟨some (code 0),v,store reader counter [] bits markers payload block output⟩=
      some ⟨some returnTo,ReadonlyRepeat.putIO v none,store reader counter [] [] markers payload block output⟩ ∧
    Stacks.stackRunClock program (bits.length+1) ⟨some (code 0),v,store reader counter [] bits markers payload block output⟩=
      bits.length^2+3*bits.length+3 := by
  have hr := Normalization.drain_run bits (ReadonlyRepeat.getIO v)
  obtain ⟨hN,hNC⟩ := StackCall.execution (fun _ : Fin 1 => Slot.width) code returnTo
    ReadonlyRepeat.getIO ReadonlyRepeat.putIO (drainWidthFrame reader counter [] markers payload block output)
    (drainWidthFrame_at reader counter [] markers payload block output) (drainWidthFrame_update reader counter [] markers payload block output)
    (fun _ _ => rfl) (fun _ _ _ => rfl) Normalization.drainProgram program hcode v (bits.length+1) _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,
    drainWidthFrame,Normalization.singleStack_zero,ReadonlyRepeat.putIO_get] at hN hNC
  exact ⟨hN,hNC.trans (Normalization.drain_clock bits (ReadonlyRepeat.getIO v))⟩

theorem range_call (m : ℕ) (counter block output : Bits) (v : Local) :
    ∃ ticks,
      Stacks.stackRun program ticks ⟨some (.range .next),v,store [] counter [] [] (List.replicate m true) [] block output⟩=
        some ⟨some (.drainIndex 0),ReadonlyRepeat.putIO v none,store [] counter [] m.bits [] [] ((RangeBuilder.fields 0 m).reverse++block) output⟩ ∧
      Stacks.stackRunClock program ticks ⟨some (.range .next),v,store [] counter [] [] (List.replicate m true) [] block output⟩≤
        1000*(m+1)*(1+m+block.length+(RangeBuilder.fields 0 m).length)^2 := by
  obtain ⟨ticks,hr,hc⟩ := RangeBuilder.complete 0 m block (ReadonlyRepeat.getIO v)
  simp only [Nat.zero_add,Nat.zero_bits] at hr hc
  obtain ⟨hN,hNC⟩ := StackCall.execution rangeCode Label.range (.drainIndex 0) ReadonlyRepeat.getIO ReadonlyRepeat.putIO
    (rangeFrame [] counter [] output) (rangeFrame_at [] counter [] output) (rangeFrame_update [] counter [] output)
    (fun _ _ => rfl) (fun _ _ _ => rfl) RangeBuilder.program program (fun _ => rfl) v ticks _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,
    rangeFrame,Preparation.quad_zero,Preparation.quad_one,Preparation.quad_two,Preparation.quad_three,ReadonlyRepeat.putIO_get] at hN hNC
  exact ⟨ticks,hN,hNC.trans_le hc⟩

theorem transfer_block (bits counter output : Bits) (v : Local) :
    Stacks.stackRun program (bits.length+1) ⟨some (.transferBlock 0),v,store [] counter [] [] [] [] bits.reverse output⟩=
      some ⟨some (.repeat (.counter .borrow)),ReadonlyRepeat.putIO v none,store [] counter [] [] [] bits [] output⟩ ∧
    Stacks.stackRunClock program (bits.length+1) ⟨some (.transferBlock 0),v,store [] counter [] [] [] [] bits.reverse output⟩=
      bits.length*(2*bits.length+5)+3 := by
  have hr := Stacks.transfer_run bits.reverse [] (ReadonlyRepeat.getIO v)
  simp only [List.length_reverse,List.reverse_reverse,List.append_nil] at hr
  obtain ⟨hN,hNC⟩ := StackCall.execution blockTransferCode Label.transferBlock (.repeat (.counter .borrow)) ReadonlyRepeat.getIO ReadonlyRepeat.putIO
    (blockTransferFrame [] counter [] [] [] output) (blockTransferFrame_at [] counter [] [] [] output) (blockTransferFrame_update [] counter [] [] [] output)
    (fun _ _ => rfl) (fun _ _ _ => rfl) Stacks.transferProgram program (fun _ => rfl) v (bits.length+1) _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,
    blockTransferFrame,Stacks.stackPair_zero,Stacks.stackPair_one,ReadonlyRepeat.putIO_get] at hN hNC
  exact ⟨hN,hNC.trans (by simpa only [List.length_reverse,List.length_nil,Nat.add_zero] using Stacks.transfer_clock bits.reverse [] (ReadonlyRepeat.getIO v))⟩

def blockCost (m : ℕ) : ℕ :=
  100000*(m+1)*(1+m+(block m).length)^2

theorem build_block (m : ℕ) (counter output : Bits) (v : Local) :
    ∃ ticks,
      Stacks.stackRun program ticks ⟨some .blockStart,v,store [] counter [] m.bits (List.replicate m true) [] [] output⟩=
        some ⟨some (.repeat (.counter .borrow)),ReadonlyRepeat.putIO v none,store [] counter [] [] [] (block m) [] output⟩ ∧
      Stacks.stackRunClock program ticks ⟨some .blockStart,v,store [] counter [] m.bits (List.replicate m true) [] [] output⟩≤blockCost m := by
  let fixedBits : Bits := [0,0,3,0].flatMap natBits
  let partialBits := fixedBits++natBits m
  let v1 := ReadonlyRepeat.putIO v none
  have hfixed : fixedBits.length=8 := by decide
  have hpartial : partialBits.length=2*m.bits.length+9 := by
    simp only [partialBits,List.length_append,hfixed,natBits_length]
    omega
  have hblock : block m=partialBits++RangeBuilder.fields 0 m := by
    simp only [block,partialBits,fixedBits,RangeBuilder.fields,← List.range_eq_range',List.flatMap_append,
      List.flatMap_cons,List.flatMap_nil,List.append_nil,List.append_assoc]
  obtain ⟨hS,hSC⟩ := push_constant .blockStart (some (.emitWidthCount .count)) Slot.block fixedBits rfl v
    (store [] counter [] m.bits (List.replicate m true) [] [] output)
  simp only [store_update_block,store_block,List.append_nil,List.length_nil,Nat.mul_zero,Nat.zero_add] at hS hSC
  obtain ⟨hE,hEC⟩ :=
      emit_width_count m [] counter (List.replicate m true) [] output fixedBits.reverse v
  obtain ⟨hD,hDC⟩ :=
      drain_width Label.drainWidth (.range .next) (fun _ => rfl) m.bits [] counter
      (List.replicate m true) [] partialBits.reverse output v1
  obtain ⟨rangeTicks,hR,hRC⟩ := range_call m counter partialBits.reverse output v1
  obtain ⟨hI,hIC⟩ :=
      drain_width Label.drainIndex (.transferBlock 0) (fun _ => rfl) m.bits [] counter [] []
      (block m).reverse output v1
  obtain ⟨hT,hTC⟩ := transfer_block (block m) counter output v1
  rw [← List.reverse_append] at hE
  rw [← List.reverse_append,← hblock] at hR
  have eS : Stacks.Execution program _ _ _ := ⟨1,hS,hSC.le⟩
  have eE : Stacks.Execution program _ _ _ := ⟨4*m.bits.length+5,hE,hEC⟩
  have eD : Stacks.Execution program _ _ _ := ⟨m.bits.length+1,hD,hDC.le⟩
  have eR : Stacks.Execution program _ _ _ := ⟨rangeTicks,hR,hRC⟩
  have eI : Stacks.Execution program _ _ _ := ⟨m.bits.length+1,hI,hIC.le⟩
  have eT : Stacks.Execution program _ _ _ := ⟨(block m).length+1,hT,hTC.le⟩
  obtain ⟨ticks,hr,hc⟩ := ((((eS.trans eE).trans eD).trans eR).trans eI).trans eT
  refine ⟨ticks,hr,hc.trans ?_⟩
  let B := 1+m+(block m).length
  have hB1 : 1≤B := by dsimp [B]; omega
  have hm := Counter.bits_length_le m
  have hpart : partialBits.length≤(block m).length := by
    calc
      _ ≤ (partialBits++RangeBuilder.fields 0 m).length := by simp only [List.length_append]; omega
      _ = _ := congrArg List.length hblock.symm
  have hfixedle : 8≤(block m).length := by omega
  have harg : 1+m+partialBits.reverse.length+(RangeBuilder.fields 0 m).length=B := by
    dsimp [B]
    rw [hblock,List.length_append,List.length_reverse]
    omega
  have heArg : 1+m.bits.length+fixedBits.reverse.length≤10*B := by
    simp only [List.length_reverse,hfixed]
    dsimp [B]
    omega
  have heArg2 := Nat.mul_le_mul heArg heArg
  have hmB : m.bits.length≤B := by dsimp [B]; omega
  have hmB2 := Nat.mul_le_mul hmB hmB
  have hblB : (block m).length≤B := by dsimp [B]; omega
  have hblB2 := Nat.mul_le_mul hblB hblB
  have hB2 : B≤B^2 := Nat.le_pow (by decide)
  have hbig : B^2≤(m+1)*B^2 := Nat.le_mul_of_pos_left _ (by omega)
  rw [harg]
  simp only [List.length_reverse,hfixed]
  change _≤100000*(m+1)*B^2
  nlinarith only [heArg2,hmB,hmB2,hblB,hblB2,hB1,hB2,hbig]

theorem repeat_call (n : ℕ) (counter bits output : Bits) (v : Local) (hnum : binaryValue counter=n) :
    ∃ ticks,
      Stacks.stackRun program ticks ⟨some (.repeat (.counter .borrow)),v,store [] counter [] [] [] bits [] output⟩=
        some ⟨some .done,((false,none),none),store [] [] [] [] [] [] [] ((List.replicate n bits).flatten.reverse++output)⟩ ∧
      Stacks.stackRunClock program ticks ⟨some (.repeat (.counter .borrow)),v,store [] counter [] [] [] bits [] output⟩≤
        20*(n+1)*(1+counter.length)^2+50*(n+1)*(1+bits.length+output.length+n*bits.length)^2 := by
  obtain ⟨ticks,hr,hc⟩ := ReadonlyRepeat.complete n counter bits output v hnum
  obtain ⟨hN,hNC⟩ := StackCall.execution repeatCode Label.repeat .done id (fun _ v => v)
    (repeatFrame [] [] [] []) (repeatFrame_at [] [] [] []) (repeatFrame_update [] [] [] [])
    (fun _ _ => rfl) (fun _ _ _ => rfl) ReadonlyRepeat.program program (fun _ => rfl) v ticks _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,
    repeatFrame,Preparation.quad_zero,Preparation.quad_one,Preparation.quad_two,Preparation.quad_three] at hN hNC
  exact ⟨ticks,hN,hNC.trans_le hc⟩

def repeatCost (m k : ℕ) : ℕ :=
  20*(k+1+1)*(1+(k+1).bits.length)^2+
    50*(k+1+1)*(1+(block m).length+(header m k).length+(k+1)*(block m).length)^2

def executionCost (k count dimension addresses alphabet : ℕ) (tail : Bits) : ℕ :=
  10000*(1+(input k count dimension addresses alphabet tail).length)^3+
    90000*(1+(width addresses alphabet).bits.length+(width addresses alphabet+1).bits.length+k.bits.length+(k+1).bits.length)^2+
    blockCost (width addresses alphabet)+repeatCost (width addresses alphabet) k+1

theorem execution (k count dimension addresses alphabet : ℕ) (tail : Bits) (v : Local) :
    ∃ ticks,
      Stacks.stackRun program ticks ⟨some (.start 0),v,store [] [] [] [] [] (input k count dimension addresses alphabet tail).reverse [] []⟩=
        some ⟨none,((false,none),none),store [] [] [] [] [] [] [] (output (width addresses alphabet) k).reverse⟩ ∧
      Stacks.stackRunClock program ticks ⟨some (.start 0),v,store [] [] [] [] [] (input k count dimension addresses alphabet tail).reverse [] []⟩≤
        executionCost k count dimension addresses alphabet tail := by
  let m := width addresses alphabet
  let v1 : Local := (ReadonlyRepeat.getCounter v,none)
  obtain ⟨frontTicks,hF,hFC⟩ := frontend k count dimension addresses alphabet tail v
  obtain ⟨headTicks,hH,hHC⟩ := emit_header m k (List.replicate m true) v1
  obtain ⟨blockTicks,hB,hBC⟩ := build_block m (k+1).bits (header m k).reverse v1
  obtain ⟨repeatTicks,hR,hRC⟩ :=
      repeat_call (k+1) (k+1).bits (block m) (header m k).reverse v1 (binaryValue_bits (k+1))
  have hD : Stacks.stackRun program 1 ⟨some .done,((false,none),none),store [] [] [] [] [] [] []
      ((List.replicate (k+1) (block m)).flatten.reverse++(header m k).reverse)⟩=
        some ⟨none,((false,none),none),store [] [] [] [] [] [] []
          ((List.replicate (k+1) (block m)).flatten.reverse++(header m k).reverse)⟩ := rfl
  have hDC : Stacks.stackRunClock program 1 ⟨some .done,((false,none),none),store [] [] [] [] [] [] []
      ((List.replicate (k+1) (block m)).flatten.reverse++(header m k).reverse)⟩=1 := rfl
  have eF : Stacks.Execution program _ _ _ := ⟨frontTicks,hF,hFC⟩
  have eH : Stacks.Execution program _ _ _ := ⟨headTicks,hH,hHC⟩
  have eB : Stacks.Execution program _ _ _ := ⟨blockTicks,hB,hBC⟩
  have eR : Stacks.Execution program _ _ (repeatCost m k) := ⟨repeatTicks,hR,by
    simpa only [repeatCost,List.length_reverse] using hRC⟩
  have eD : Stacks.Execution program _ _ _ := ⟨1,hD,hDC.le⟩
  obtain ⟨ticks,hr,hc⟩ := ((((eF.trans eH).trans eB).trans eR).trans eD)
  refine ⟨ticks,?_,?_⟩
  · simpa only [output,List.reverse_append] using hr
  · simpa only [executionCost] using hc

def size (k count dimension addresses alphabet : ℕ) (tail : Bits) : ℕ :=
  1+(input k count dimension addresses alphabet tail).length+k

theorem block_length_bound (m : ℕ) : (block m).length≤2*m^2+3*m+9 := by
  have hf := RangeBuilder.fields_length_bound 0 m
  have hm := Counter.bits_length_le m
  have he : block m=([0,0,3,0].flatMap natBits)++natBits m++RangeBuilder.fields 0 m := by
    simp only [block,RangeBuilder.fields,← List.range_eq_range',List.flatMap_append,
      List.flatMap_cons,List.flatMap_nil,List.append_nil,List.append_assoc]
  rw [he,List.length_append,List.length_append,natBits_length]
  have hc : ([0,0,3,0].flatMap natBits).length=8 := by decide
  rw [hc]
  nlinarith

theorem header_length (m k : ℕ) : (header m k).length=2*(m+1).bits.length+2*(k+1).bits.length+4 := by
  simp only [header,List.flatMap_cons,List.flatMap_nil,List.append_nil,List.length_append,natBits_length,
    NativeEcho.twice_bits (k+1) (by omega),List.length_cons]
  omega

theorem data_bounds (k count dimension addresses alphabet : ℕ) (tail : Bits) :
    let B := size k count dimension addresses alphabet tail
    let m := width addresses alphabet
    1≤B ∧ m+1≤B ∧ m.bits.length≤B ∧ (m+1).bits.length≤B ∧
      k.bits.length≤B ∧ (k+1).bits.length≤B ∧ k+1≤B ∧ k+1+1≤2*B ∧
      (block m).length≤14*B^2 ∧ (header m k).length≤8*B ∧
      1+(block m).length+(header m k).length+(k+1)*(block m).length≤37*B^3 ∧
      (output m k).length≤22*B^3 := by
  let B := size k count dimension addresses alphabet tail
  let m := width addresses alphabet
  have hB : 1≤B := by dsimp [B,size]; omega
  have h12 : B≤B^2 := Nat.le_pow (by decide)
  have h13 : B≤B^3 := Nat.le_pow (by decide)
  have h23 : B^2≤B^3 := Nat.pow_le_pow_right (by omega) (by decide)
  have hmRaw : m≤(input k count dimension addresses alphabet tail).length := by
    dsimp only [m,width]
    simp only [input,List.length_append,natBits_length]
    omega
  have hm1 : m+1≤B := by dsimp [B,size]; omega
  have hm : m≤B := by omega
  have hmB : m.bits.length≤B := (Counter.bits_length_le m).trans hm
  have hmp : (m+1).bits.length≤B := (Counter.bits_length_le (m+1)).trans hm1
  have hk1 : k+1≤B := by dsimp [B,size]; omega
  have hk : k.bits.length≤B := (Counter.bits_length_le k).trans (by omega)
  have hkp : (k+1).bits.length≤B := (Counter.bits_length_le (k+1)).trans hk1
  have hn : k+1+1≤2*B := by omega
  have hmsq := Nat.mul_le_mul hm hm
  have hblock : (block m).length≤14*B^2 := by
    have hb := block_length_bound m
    nlinarith only [hb,hmsq,hm,h12,hB]
  have hhead : (header m k).length≤8*B := by rw [header_length]; omega
  have hprod : (k+1)*(block m).length≤14*B^3 := by
    calc
      _ ≤ B*(14*B^2) := Nat.mul_le_mul hk1 hblock
      _ = _ := by ring
  have hz : 1+(block m).length+(header m k).length+(k+1)*(block m).length≤37*B^3 := by omega
  have hout : (output m k).length≤22*B^3 := by
    simp only [output,List.length_append,List.length_flatten,List.map_replicate,List.sum_replicate_nat]
    omega
  exact ⟨hB,hm1,hmB,hmp,hk,hkp,hk1,hn,hblock,hhead,hz,hout⟩

theorem cost_bound (k count dimension addresses alphabet : ℕ) (tail : Bits) :
    executionCost k count dimension addresses alphabet tail≤30000000*(size k count dimension addresses alphabet tail)^7 := by
  obtain ⟨hB,hm1,hm,hmp,hk,hkp,_,hn,hbl,_,hz,_⟩ :=
      data_bounds k count dimension addresses alphabet tail
  let B := size k count dimension addresses alphabet tail
  let m := width addresses alphabet
  change m+1≤B at hm1
  change m.bits.length≤B at hm
  change (m+1).bits.length≤B at hmp
  change (block m).length≤14*B^2 at hbl
  change 1+(block m).length+(header m k).length+(k+1)*(block m).length≤37*B^3 at hz
  have hraw : 1+(input k count dimension addresses alphabet tail).length≤B := by
    dsimp [B,size]; omega
  have hf : 10000*(1+(input k count dimension addresses alphabet tail).length)^3≤10000*B^3 :=
    Nat.mul_le_mul_left 10000 (Nat.pow_le_pow_left hraw 3)
  have hheadarg : 1+m.bits.length+(m+1).bits.length+k.bits.length+(k+1).bits.length≤5*B := by omega
  have hh : 90000*(1+m.bits.length+(m+1).bits.length+k.bits.length+(k+1).bits.length)^2≤2250000*B^2 := by
    calc
      _ ≤ 90000*(5*B)^2 := Nat.mul_le_mul_left 90000 (Nat.pow_le_pow_left hheadarg 2)
      _ = _ := by ring
  have hB12 : B≤B^2 := Nat.le_pow (by decide)
  have hblockarg : 1+m+(block m).length≤15*B^2 := by omega
  have hb : blockCost m≤22500000*B^5 := by
    dsimp only [blockCost]
    calc
      _ ≤ (100000*B)*(15*B^2)^2 := Nat.mul_le_mul (Nat.mul_le_mul_left 100000 hm1)
        (Nat.pow_le_pow_left hblockarg 2)
      _ = _ := by ring
  have hcarg : 1+(k+1).bits.length≤2*B := by omega
  have hc : 20*(k+1+1)*(1+(k+1).bits.length)^2≤160*B^3 := by
    calc
      _ ≤ (20*(2*B))*(2*B)^2 := Nat.mul_le_mul (Nat.mul_le_mul_left 20 hn) (Nat.pow_le_pow_left hcarg 2)
      _ = _ := by ring
  have hr : 50*(k+1+1)*(1+(block m).length+(header m k).length+(k+1)*(block m).length)^2≤136900*B^7 := by
    calc
      _ ≤ (50*(2*B))*(37*B^3)^2 := Nat.mul_le_mul (Nat.mul_le_mul_left 50 hn) (Nat.pow_le_pow_left hz 2)
      _ = _ := by ring
  have h27 : B^2≤B^7 := Nat.pow_le_pow_right (by omega) (by decide)
  have h37 : B^3≤B^7 := Nat.pow_le_pow_right (by omega) (by decide)
  have h57 : B^5≤B^7 := Nat.pow_le_pow_right (by omega) (by decide)
  have hB7 : 1≤B^7 := Nat.one_le_pow 7 B hB
  change executionCost k count dimension addresses alphabet tail≤30000000*B^7
  dsimp only [executionCost,repeatCost]
  nlinarith only [hf,hh,hb,hc,hr,h27,h37,h57,hB7]

theorem output_store (word : Bits) : store [] [] [] [] [] [] [] word=Function.update (fun _ => []) Slot.output word := by
  funext k
  cases k <;> rfl

theorem init_eq (word : Bits) : (TM2.init Slot.payload word : TM2.Cfg (fun _ : Slot => Bool) Label Local)=
    ⟨some (.start 0),default,store [] [] [] [] [] word [] []⟩ := by
  have he : (fun _ : Slot => ([] : Bits))=store [] [] [] [] [] [] [] [] := by
    funext k; cases k <;> rfl
  simp only [TM2.init,he,store_update_payload]
  rfl

theorem raw_machine :
    ∃ (q : ℕ) (M : TM0.Machine Symbol (Fin (q+1))) (C : ℕ), 0<C ∧
      ∀ (k count dimension addresses alphabet : ℕ) (tail : Bits),
        Runs M (input k count dimension addresses alphabet tail) (output (width addresses alphabet) k)
          (C*(size k count dimension addresses alphabet tail)^7) (C*(size k count dimension addresses alphabet tail)^7) := by
  obtain ⟨q,M,C,hC,hM⟩ := Stacks.raw_compiler program Slot.payload Slot.output
  refine ⟨q,M,40000000*C,Nat.mul_pos (by decide) hC,?_⟩
  intro k count dimension addresses alphabet tail
  let m := width addresses alphabet
  obtain ⟨steps,hr,hc⟩ := execution k count dimension addresses alphabet tail default
  have hrun : Stacks.stackRun program steps (TM2.init Slot.payload (input k count dimension addresses alphabet tail).reverse)=
      some ⟨none,((false,none),none),Function.update (fun _ => []) Slot.output (output m k).reverse⟩ := by
    rw [init_eq,← output_store]
    exact hr
  have hraw :=
      hM (input k count dimension addresses alphabet tail) (output m k) steps
      ((false,none),none) hrun
  let B := size k count dimension addresses alphabet tail
  have hB : 1≤B := by dsimp [B,size]; omega
  have hB3 : 1≤B^3 := Nat.one_le_pow 3 B hB
  obtain ⟨_,_,_,_,_,_,_,_,_,_,_,ho⟩ := data_bounds k count dimension addresses alphabet tail
  change (output m k).length≤22*B^3 at ho
  have hi : 1+(input k count dimension addresses alphabet tail).length≤B := by dsimp [B,size]; omega
  have hi2 : (1+(input k count dimension addresses alphabet tail).length)^2≤B^2 :=
      Nat.pow_le_pow_left hi 2
  have ho1 : 1+(output m k).length≤23*B^3 := by omega
  have ho2 : (1+(output m k).length)^2≤529*B^6 := by
    calc
      _ ≤ (23*B^3)^2 := Nat.pow_le_pow_left ho1 2
      _ = _ := by ring
  have ht : Stacks.stackRunClock program steps (TM2.init Slot.payload (input k count dimension addresses alphabet tail).reverse)≤30000000*B^7 := by
    rw [init_eq]
    exact hc.trans (cost_bound k count dimension addresses alphabet tail)
  have h27 : B^2≤B^7 := Nat.pow_le_pow_right (by omega) (by decide)
  have h67 : B^6≤B^7 := Nat.pow_le_pow_right (by omega) (by decide)
  have hsum : (1+(input k count dimension addresses alphabet tail).length)^2+
      Stacks.stackRunClock program steps (TM2.init Slot.payload (input k count dimension addresses alphabet tail).reverse)+
      (1+(output m k).length)^2≤40000000*B^7 := by
    nlinarith only [hi2,ho2,ht,h27,h67,Nat.zero_le (B^7)]
  have hbound : C*((1+(input k count dimension addresses alphabet tail).length)^2+
      Stacks.stackRunClock program steps (TM2.init Slot.payload (input k count dimension addresses alphabet tail).reverse)+
      (1+(output m k).length)^2)≤(40000000*C)*B^7 := by
    calc
      _ ≤ C*(40000000*B^7) := Nat.mul_le_mul_left C hsum
      _ = _ := by ring
  exact runs_mono hraw hbound hbound
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.StateEcho

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.CheckedNat
open Turing Qatlib.Concepts.BitWordCompiler.CanonicalCodec
abbrev Local := Bool×Symbol
inductive Label where | unary | field | accept | reject deriving DecidableEq,Fintype
instance : Inhabited Label := ⟨.unary⟩
def program : Label → TM2.Stmt (fun _ : Fin 3 => Bool) Label Local
  | .unary => .pop 0 (fun _ bit => (false,bit))
      (.branch (fun v => v.2.isSome)
        (.branch (fun v => v.2.getD false)
          (.push 1 (fun _ => true) (.goto (fun _ => .unary)))
          (.load (fun _ => (false,none)) (.goto (fun _ => .field))))
        (.goto (fun _ => .reject)))
  | .field => .pop 1 (fun v bit => (bit.isSome,v.2))
      (.branch Prod.fst
        (.pop 0 (fun v bit => (v.1,bit))
          (.branch (fun v => v.2.isSome)
            (.push 2 (fun v => v.2.getD false) (.goto (fun _ => .field)))
            (.goto (fun _ => .reject))))
        (.branch (fun v => decide (v.2 ≠ some false))
          (.goto (fun _ => .accept)) (.goto (fun _ => .reject))))
  | .accept => .load (fun v => (true,v.2)) .halt
  | .reject => .load (fun v => (false,v.2)) .halt

def unaryFinish (input markers output : Bits) : TM2.Cfg (fun _ : Fin 3 => Bool) Label Local :=
  match readSize input with
  | none => ⟨some .reject,(false,none),Parsing.triple [] (List.replicate input.length true++markers) output⟩
  | some (n,rest) => ⟨some .field,(false,none),Parsing.triple rest (List.replicate n true++markers) output⟩

theorem unary_step (bits markers output : Bits) (v : Local) :
    Stacks.stackRun program 1 ⟨some .unary,v,Parsing.triple (true::bits) markers output⟩=
      some ⟨some .unary,(false,some true),Parsing.triple bits (true::markers) output⟩ := by
  simp [Stacks.run_one,TM2.step,program,TM2.stepAux]

theorem unary_stop (bits markers output : Bits) (v : Local) :
    Stacks.stackRun program 1 ⟨some .unary,v,Parsing.triple (false::bits) markers output⟩=
      some ⟨some .field,(false,none),Parsing.triple bits markers output⟩ := by
  simp [Stacks.run_one,TM2.step,program,TM2.stepAux]

theorem unary_empty (markers output : Bits) (v : Local) :
    Stacks.stackRun program 1 ⟨some .unary,v,Parsing.triple [] markers output⟩=
      some ⟨some .reject,(false,none),Parsing.triple [] markers output⟩ := by
  simp [Stacks.run_one,TM2.step,program,TM2.stepAux]

theorem unaryFinish_cons (bits markers output : Bits) :
    unaryFinish (true::bits) markers output=unaryFinish bits (true::markers) output := by
  unfold unaryFinish
  cases h : readSize bits with
  | none => simp only [readSize,h,Option.bind_eq_bind,Option.bind_none,List.length_cons,List.replicate_succ,List.cons_append]
            rw [Parsing.marker_cons]
  | some pair =>
    rcases pair with ⟨n,rest⟩
    simp only [readSize,h,Option.bind_eq_bind,Option.bind_some,pure,List.replicate_succ,List.cons_append]
    rw [Parsing.marker_cons]

theorem unary_complete (input markers output : Bits) (v : Local) :
    ∃ ticks,
      Stacks.stackRun program ticks ⟨some .unary,v,Parsing.triple input markers output⟩=
        some (unaryFinish input markers output) ∧
      Stacks.stackRunClock program ticks ⟨some .unary,v,Parsing.triple input markers output⟩≤
        20*(input.length+1)*(1+input.length+markers.length) := by
  induction input generalizing markers v with
  | nil =>
    refine ⟨1,?_,?_⟩
    · simpa only [unaryFinish,readSize,List.length_nil,List.replicate_zero,List.nil_append] using
        unary_empty markers output v
    · simp [Stacks.stackRunClock,program,Stacks.stackClock]
      omega
  | cons bit bits ih =>
    cases bit with
    | false =>
      refine ⟨1,?_,?_⟩
      · simpa only [unaryFinish,readSize,List.replicate_zero,List.nil_append] using
          unary_stop bits markers output v
      · simp [Stacks.stackRunClock,program,Stacks.stackClock]
        nlinarith
    | true =>
      obtain ⟨ticks,hr,hc⟩ := ih (true::markers) (false,some true)
      have hS := unary_step bits markers output v
      have hSC : Stacks.stackRunClock program 1 ⟨some .unary,v,Parsing.triple (true::bits) markers output⟩=
          2*bits.length+2*markers.length+7 := by
        simp [Stacks.stackRunClock,program,Stacks.stackClock]
        omega
      have eS : Stacks.Execution program _ _ _ := ⟨1,hS,hSC.le⟩
      have eR : Stacks.Execution program _ _ _ := ⟨ticks,hr,hc⟩
      obtain ⟨total,hR,hC⟩ := eS.trans eR
      refine ⟨total,?_,hC.trans ?_⟩
      · rw [unaryFinish_cons]
        exact hR
      · simp only [List.length_cons]
        nlinarith

def fieldFinish : ℕ → Bits → Bits → Symbol → TM2.Cfg (fun _ : Fin 3 => Bool) Label Local
  | 0,input,output,last =>
      ⟨some (if last ≠ some false then .accept else .reject),(false,last),Parsing.triple input [] output⟩
  | n+1,[],output,_ => ⟨some .reject,(true,none),Parsing.triple [] (List.replicate n true) output⟩
  | n+1,bit::rest,output,_ => fieldFinish n rest (bit::output) (some bit)

theorem field_step (bit : Bool) (bits markers output : Bits) (v : Local) :
    Stacks.stackRun program 1 ⟨some .field,v,Parsing.triple (bit::bits) (true::markers) output⟩=
      some ⟨some .field,(true,some bit),Parsing.triple bits markers (bit::output)⟩ := by
  cases bit <;> simp [Stacks.run_one,TM2.step,program,TM2.stepAux]

theorem field_complete (n : ℕ) (input output : Bits) (v : Local) :
    ∃ ticks,
      Stacks.stackRun program ticks ⟨some .field,v,Parsing.triple input (List.replicate n true) output⟩=
        some (fieldFinish n input output v.2) ∧
      Stacks.stackRunClock program ticks ⟨some .field,v,Parsing.triple input (List.replicate n true) output⟩≤
        20*(n+1)*(1+input.length+n+output.length) := by
  induction n generalizing input output v with
  | zero =>
    refine ⟨1,?_,?_⟩
    · cases v with | mk flag last =>
        cases last with
        | none => simp [Stacks.run_one,TM2.step,program,TM2.stepAux,fieldFinish]
        | some bit => cases bit <;> simp [Stacks.run_one,TM2.step,program,TM2.stepAux,fieldFinish]
    · have hc : Stacks.stackRunClock program 1 ⟨some .field,v,Parsing.triple input [] output⟩=3 := by
        simp [Stacks.stackRunClock,program,Stacks.stackClock]
      simpa only [List.replicate_zero,hc,Nat.zero_add,Nat.add_zero,Nat.mul_one] using
        (show 3≤20*(1+input.length+output.length) by omega)
  | succ n ih =>
    cases input with
    | nil =>
      refine ⟨1,?_,?_⟩
      · simp [Stacks.run_one,TM2.step,program,TM2.stepAux,fieldFinish,List.replicate_succ]
      · simp [Stacks.stackRunClock,program,Stacks.stackClock,List.replicate_succ]
        nlinarith
    | cons bit bits =>
      obtain ⟨ticks,hr,hc⟩ := ih bits (bit::output) (true,some bit)
      have hS := field_step bit bits (List.replicate n true) output v
      have hSC : Stacks.stackRunClock program 1 ⟨some .field,v,Parsing.triple (bit::bits) (List.replicate (n+1) true) output⟩=
          2*n+2*bits.length+2*output.length+10 := by
        cases bit <;> simp
            [Stacks.stackRunClock,program,Stacks.stackClock,List.replicate_succ] <;> omega
      have eS : Stacks.Execution program _ _ _ :=
          ⟨1,by simpa only [List.replicate_succ] using hS,hSC.le⟩
      have eR : Stacks.Execution program _ _ _ := ⟨ticks,hr,hc⟩
      obtain ⟨total,hR,hC⟩ := eS.trans eR
      refine ⟨total,hR,hC.trans ?_⟩
      simp only [List.length_cons]
      nlinarith

def lastField (bits : Bits) (saved : Symbol) : Symbol :=
    match bits.reverse.head? with | none => saved | some b => some b

theorem lastField_cons (bit : Bool) (bits : Bits) (saved : Symbol) :
    lastField (bit::bits) saved=lastField bits (some bit) := by
  simp only [lastField,List.reverse_cons,List.head?_append,List.head?_cons]
  cases bits.reverse.head? <;> rfl

theorem field_data (bits rest output : Bits) (saved : Symbol) :
    fieldFinish bits.length (bits++rest) output saved=
      ⟨some (if lastField bits saved ≠ some false then .accept else .reject),
        (false,lastField bits saved),Parsing.triple rest [] (bits.reverse++output)⟩ := by
  induction bits generalizing output saved with
  | nil => rfl
  | cons bit bits ih =>
    simp only [List.length_cons,List.cons_append,fieldFinish]
    rw [ih,lastField_cons]
    simp only [List.reverse_cons,List.append_assoc,List.singleton_append]

theorem field_short (extra : ℕ) (bits output : Bits) (saved : Symbol) :
    fieldFinish (bits.length+extra+1) bits output saved=
      ⟨some .reject,(true,none),Parsing.triple [] (List.replicate extra true) (bits.reverse++output)⟩ := by
  induction bits generalizing output saved with
  | nil => simp only [List.length_nil,Nat.zero_add,fieldFinish,List.reverse_nil,List.nil_append]
  | cons bit bits ih =>
    have he : (bit::bits).length+extra+1=(bits.length+extra+1)+1 := by simp; omega
    rw [he,fieldFinish,ih]
    simp only [List.reverse_cons,List.append_assoc,List.singleton_append]

theorem binary_cons (b : Bool) (bits : Bits) : binaryValue (b::bits)=Nat.bit b (binaryValue bits) := by
  cases b <;> rfl

theorem canonical_tail (b : Bool) (bits : Bits) (h : (binaryValue (b::bits)).bits=b::bits) :
    (binaryValue bits).bits=bits := by
  have ht := congrArg List.tail h
  rw [← Nat.div2_bits_eq_tail,binary_cons,Nat.div2_bit] at ht
  exact ht

theorem canonical_iff (bits : Bits) : (binaryValue bits).bits=bits ↔ bits.reverse.head?≠some false := by
  induction bits with
  | nil => simp [binaryValue]
  | cons b bits ih =>
    by_cases he : bits=[]
    · subst bits
      cases b <;> decide
    · have hrev : (b::bits).reverse.head?=bits.reverse.head? := by
        rw [List.reverse_cons,List.head?_append]
        have hn : bits.reverse≠[] := by
          intro hz
          have hr := congrArg List.reverse hz
          exact he (by simpa only [List.reverse_reverse,List.reverse_nil] using hr)
        cases hh : bits.reverse.head? with
        | none => exact (hn (List.head?_eq_none_iff.mp hh)).elim
        | some bit => rfl
      rw [hrev]
      constructor
      · intro h
        exact ih.mp (canonical_tail b bits h)
      · intro h
        have ht := ih.mpr h
        have hp : binaryValue bits≠0 := by
          intro hz
          rw [hz,Nat.zero_bits] at ht
          exact he ht.symm
        rw [binary_cons,Nat.bits_append_bit _ _ (fun hz => (hp hz).elim),ht]

def parseResult (input output : Bits) : TM2.Cfg (fun _ : Fin 3 => Bool) Label Local :=
  match readSize input with
  | none => unaryFinish input [] output
  | some (n,rest) => fieldFinish n rest output none

theorem to_result (input output : Bits) (v : Local) :
    ∃ ticks,
      Stacks.stackRun program ticks ⟨some .unary,v,Parsing.triple input [] output⟩=
        some (parseResult input output) ∧
      Stacks.stackRunClock program ticks ⟨some .unary,v,Parsing.triple input [] output⟩≤
        40*(1+input.length+output.length)^2 := by
  obtain ⟨unaryTicks,hU,hUC⟩ := unary_complete input [] output v
  simp only [List.length_nil,Nat.add_zero] at hUC
  let B := 1+input.length+output.length
  have hu1 : input.length+1≤B := by dsimp [B]; omega
  have hu2 : 1+input.length≤B := by dsimp [B]; omega
  have hu : 20*(input.length+1)*(1+input.length)≤20*B^2 := by
    have hp := Nat.mul_le_mul (Nat.mul_le_mul_left 20 hu1) hu2
    nlinarith only [hp]
  cases hs : readSize input with
  | none =>
    refine ⟨unaryTicks,?_,hUC.trans ?_⟩
    · simpa only [parseResult,hs] using hU
    · change _≤40*B^2
      nlinarith only [hu,Nat.zero_le (B^2)]
  | some pair =>
    rcases pair with ⟨n,rest⟩
    obtain ⟨fieldTicks,hF,hFC⟩ := field_complete n rest output (false,none)
    have hU' : Stacks.stackRun program unaryTicks ⟨some .unary,v,Parsing.triple input [] output⟩=
        some ⟨some .field,(false,none),Parsing.triple rest (List.replicate n true) output⟩ := by
      simpa only [unaryFinish,hs,List.append_nil] using hU
    have eU : Stacks.Execution program _ _ _ := ⟨unaryTicks,hU',hUC⟩
    have eF : Stacks.Execution program _ _ _ := ⟨fieldTicks,hF,hFC⟩
    obtain ⟨ticks,hr,hc⟩ := eU.trans eF
    refine ⟨ticks,?_,hc.trans ?_⟩
    · simpa only [parseResult,hs] using hr
    · have hshape := congrArg List.length (readSize_sound input n rest hs)
      simp only [List.length_append,List.length_replicate,List.length_cons] at hshape
      have hn : n+1≤B := by dsimp [B]; omega
      have hf : 1+rest.length+n+output.length≤B := by dsimp [B]; omega
      have hp := Nat.mul_le_mul (Nat.mul_le_mul_left 20 hn) hf
      change _≤40*B^2
      nlinarith only [hu,hp]

theorem lastField_none (bits : Bits) : lastField bits none=bits.reverse.head? := by
  unfold lastField
  cases bits.reverse.head? <;> rfl

theorem success_iff (input output : Bits) :
    (parseResult input output).l=some .accept ↔ readNat input≠none := by
  cases hs : readSize input with
  | none => simp [parseResult,unaryFinish,readNat,hs]
  | some pair =>
    rcases pair with ⟨n,rest⟩
    by_cases hlen : n≤rest.length
    · have hf := field_data (rest.take n) (rest.drop n) output none
      rw [List.take_append_drop,List.length_take,Nat.min_eq_left hlen] at hf
      simp only [parseResult,hs,hf,readNat,Option.bind_eq_bind,Option.bind_some,if_pos hlen]
      simp only [lastField_none,← canonical_iff]
      by_cases hc : (binaryValue (rest.take n)).bits=rest.take n <;> simp [hc]
    · have he : rest.length+(n-rest.length-1)+1=n := by omega
      have hf := field_short (n-rest.length-1) rest output none
      rw [he] at hf
      simp only [parseResult,hs,hf,readNat,Option.bind_eq_bind,Option.bind_some,if_neg hlen]
      simp

theorem field_labels (n : ℕ) (input output : Bits) (saved : Symbol) :
    (fieldFinish n input output saved).l=some .accept ∨ (fieldFinish n input output saved).l=some .reject := by
  induction n generalizing input output saved with
  | zero => simp only [fieldFinish]; split_ifs <;> simp
  | succ n ih =>
    cases input with
    | nil => exact Or.inr rfl
    | cons bit bits => exact ih bits (bit::output) (some bit)

theorem result_labels (input output : Bits) :
    (parseResult input output).l=some .accept ∨ (parseResult input output).l=some .reject := by
  cases hs : readSize input with
  | none => exact Or.inr (by simp [parseResult,unaryFinish,hs])
  | some pair =>
    rcases pair with ⟨n,rest⟩
    simpa only [parseResult,hs] using field_labels n rest output none

def haltedResult (input output : Bits) : TM2.Cfg (fun _ : Fin 3 => Bool) Label Local :=
  let result := parseResult input output
  ⟨none,(decide (result.l=some .accept),result.var.2),result.stk⟩

theorem result_halt (input output : Bits) :
    Stacks.stackRun program 1 (parseResult input output)=some (haltedResult input output) ∧
      Stacks.stackRunClock program 1 (parseResult input output)=1 := by
  have hl := result_labels input output
  generalize he : parseResult input output=cfg at hl ⊢
  rcases cfg with ⟨l,⟨flag,last⟩,S⟩
  rcases hl with hl|hl
  · change l=some .accept at hl
    subst l
    constructor
    · simp only [haltedResult,he]
      rfl
    · rfl
  · change l=some .reject at hl
    subst l
    constructor
    · simp only [haltedResult,he]
      rfl
    · rfl

theorem complete (input output : Bits) (v : Local) :
    ∃ ticks,
      Stacks.stackRun program ticks ⟨some .unary,v,Parsing.triple input [] output⟩=
        some (haltedResult input output) ∧
      Stacks.stackRunClock program ticks ⟨some .unary,v,Parsing.triple input [] output⟩≤
        50*(1+input.length+output.length)^2 := by
  obtain ⟨ticks,hr,hc⟩ := to_result input output v
  obtain ⟨hh,hclock⟩ := result_halt input output
  have eR : Stacks.Execution program _ _ _ := ⟨ticks,hr,hc⟩
  have eH : Stacks.Execution program _ _ 1 := ⟨1,hh,hclock.le⟩
  obtain ⟨total,hR,hC⟩ := eR.trans eH
  refine ⟨total,hR,hC.trans ?_⟩
  have hp : 1≤(1+input.length+output.length)^2 := Nat.one_le_pow 2 _ (by omega)
  omega

theorem result_valid (n : ℕ) (rest output : Bits) :
    parseResult (natBits n++rest) output=
      ⟨some .accept,(false,lastField n.bits none),Parsing.triple rest [] (n.bits.reverse++output)⟩ := by
  have hsize : readSize (natBits n++rest)=some (n.bits.length,n.bits++rest) := by
    simpa only [natBits,List.append_assoc,List.cons_append,List.nil_append] using
        readSize_complete n.bits.length (n.bits++rest)
  have hcan : (binaryValue n.bits).bits=n.bits := by rw [binaryValue_bits]
  have hlast : lastField n.bits none≠some false := by
    rw [lastField_none]
    exact (canonical_iff n.bits).mp hcan
  simp only [parseResult,hsize,field_data,if_pos hlast]

theorem halted_valid (n : ℕ) (rest output : Bits) :
    haltedResult (natBits n++rest) output=
      ⟨none,(true,lastField n.bits none),Parsing.triple rest [] (n.bits.reverse++output)⟩ := by
  simp only [haltedResult,result_valid,decide_true]

theorem valid_execution (n : ℕ) (rest output : Bits) (v : Local) :
    ∃ ticks,
      Stacks.stackRun program ticks ⟨some .unary,v,Parsing.triple (natBits n++rest) [] output⟩=
        some ⟨none,(true,lastField n.bits none),Parsing.triple rest [] (n.bits.reverse++output)⟩ ∧
      Stacks.stackRunClock program ticks ⟨some .unary,v,Parsing.triple (natBits n++rest) [] output⟩≤
        50*(1+(natBits n++rest).length+output.length)^2 := by
  simpa only [halted_valid] using complete (natBits n++rest) output v

theorem success_flag (input output : Bits) :
    (haltedResult input output).var.1=true ↔ readNat input≠none := by
  simp only [haltedResult,decide_eq_true_eq,success_iff]
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.CheckedNat

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.BinaryCompare
open Turing Qatlib.Concepts.BitWordCompiler.CanonicalCodec
inductive Tag where | lt | eq | gt deriving DecidableEq,Fintype
abbrev Local := Tag×Symbol×Symbol

def update (order : Tag) (a b : Symbol) : Tag :=
  if a.getD false=b.getD false then order else if a.getD false then .gt else .lt

def compareAux : Tag → Bits → Bits → Tag
  | order,[],[] => order
  | order,a::as,[] => compareAux (update order (some a) none) as []
  | order,[],b::bs => compareAux (update order none (some b)) [] bs
  | order,a::as,b::bs => compareAux (update order (some a) (some b)) as bs

def program (_ : Fin 1) : TM2.Stmt (fun _ : Fin 2 => Bool) (Fin 1) Local :=
  .pop 0 (fun v bit => (v.1,bit,v.2.2))
    (.pop 1 (fun v bit => (v.1,v.2.1,bit))
      (.branch (fun v => v.2.1.isSome || v.2.2.isSome)
        (.load (fun v => (update v.1 v.2.1 v.2.2,v.2.1,v.2.2)) (.goto (fun _ => 0))) .halt))

theorem numeric_aux (order : Tag) (a b : Bits) :
    compareAux order a b=if binaryValue a<binaryValue b then .lt else if binaryValue b<binaryValue a then .gt else order := by
  induction a generalizing b order with
  | nil =>
    induction b generalizing order with
    | nil => simp [compareAux,binaryValue]
    | cons bit bits ih =>
      rw [compareAux,ih]
      cases bit <;> simp [binaryValue,update]
  | cons bit bits ih =>
    cases b with
    | nil =>
      rw [compareAux,ih]
      cases bit <;> simp [binaryValue,update]
    | cons bit' bits' =>
      rw [compareAux,ih]
      cases bit <;> cases bit' <;>
        simp [binaryValue,update]
      all_goals split_ifs <;> first | rfl | omega

theorem step (a b : Bits) (v : Local) :
    Stacks.stackRun program 1 ⟨some 0,v,Stacks.stackPair a b⟩=
      some ⟨if a=[] ∧ b=[] then none else some 0,
        (update v.1 a.head? b.head?,a.head?,b.head?),Stacks.stackPair a.tail b.tail⟩ := by
  cases a <;> cases b <;> simp [Stacks.run_one,TM2.step,program,TM2.stepAux,update]
  all_goals rfl

theorem clock (a b : Bits) (v : Local) :
    Stacks.stackRunClock program 1 ⟨some 0,v,Stacks.stackPair a b⟩=
      a.length+a.tail.length+b.length+b.tail.length+5 := by
  simp [Stacks.stackRunClock,program,Stacks.stackClock]
  omega

theorem complete (a b : Bits) (v : Local) :
    ∃ ticks,
      Stacks.stackRun program ticks ⟨some 0,v,Stacks.stackPair a b⟩=
        some ⟨none,(compareAux v.1 a b,none,none),Stacks.stackPair [] []⟩ ∧
      Stacks.stackRunClock program ticks ⟨some 0,v,Stacks.stackPair a b⟩≤
        20*(1+a.length+b.length)^2 := by
  induction a generalizing b v with
  | nil =>
    induction b generalizing v with
    | nil =>
      refine ⟨1,?_,?_⟩
      · simpa [compareAux,update] using step [] [] v
      · rw [clock]
        simp
    | cons bit bits ih =>
      obtain ⟨ticks,hr,hc⟩ := ih (update v.1 none (some bit),none,some bit)
      have hS := step [] (bit::bits) v
      simp at hS
      have hSC := clock [] (bit::bits) v
      have eS : Stacks.Execution program _ _ _ := ⟨1,hS,hSC.le⟩
      have eR : Stacks.Execution program _ _ _ := ⟨ticks,hr,hc⟩
      obtain ⟨total,hR,hC⟩ := eS.trans eR
      refine ⟨total,?_,hC.trans ?_⟩
      · simpa only [compareAux] using hR
      simp only [List.length_nil,List.tail_nil,List.length_cons,List.tail_cons]
      nlinarith
  | cons bit bits ih =>
    cases b with
    | nil =>
      obtain ⟨ticks,hr,hc⟩ := ih [] (update v.1 (some bit) none,some bit,none)
      have hS := step (bit::bits) [] v
      simp at hS
      have hSC := clock (bit::bits) [] v
      have eS : Stacks.Execution program _ _ _ := ⟨1,hS,hSC.le⟩
      have eR : Stacks.Execution program _ _ _ := ⟨ticks,hr,hc⟩
      obtain ⟨total,hR,hC⟩ := eS.trans eR
      refine ⟨total,?_,hC.trans ?_⟩
      · simpa only [compareAux] using hR
      simp only [List.length_nil,List.tail_nil,List.length_cons,List.tail_cons]
      nlinarith
    | cons bit' bits' =>
      obtain ⟨ticks,hr,hc⟩ := ih bits' (update v.1 (some bit) (some bit'),some bit,some bit')
      have hS := step (bit::bits) (bit'::bits') v
      simp at hS
      have hSC := clock (bit::bits) (bit'::bits') v
      have eS : Stacks.Execution program _ _ _ := ⟨1,hS,hSC.le⟩
      have eR : Stacks.Execution program _ _ _ := ⟨ticks,hr,hc⟩
      obtain ⟨total,hR,hC⟩ := eS.trans eR
      refine ⟨total,?_,hC.trans ?_⟩
      · simpa only [compareAux] using hR
      simp only [List.length_cons,List.tail_cons]
      nlinarith

end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.BinaryCompare

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.ValidatorInput
open Turing Qatlib.Concepts.BitWordCompiler.CanonicalCodec
inductive Slot where | input | reader | original | fuel deriving DecidableEq,Fintype

def store (input reader original fuel : Bits) : Slot → Bits
  | .input => input
  | .reader => reader
  | .original => original
  | .fuel => fuel

@[simp] theorem store_input (a b c d : Bits) : store a b c d Slot.input=a := rfl

@[simp] theorem store_reader (a b c d : Bits) : store a b c d Slot.reader=b := rfl

@[simp] theorem store_original (a b c d : Bits) : store a b c d Slot.original=c := rfl

@[simp] theorem store_fuel (a b c d : Bits) : store a b c d Slot.fuel=d := rfl

@[simp] theorem update_input (a b c d x : Bits) : Function.update (store a b c d) Slot.input x=store x b c d := by
  funext k; cases k <;> rfl

@[simp] theorem update_reader (a b c d x : Bits) : Function.update (store a b c d) Slot.reader x=store a x c d := by
  funext k; cases k <;> rfl

@[simp] theorem update_original (a b c d x : Bits) : Function.update (store a b c d) Slot.original x=store a b x d := by
  funext k; cases k <;> rfl

@[simp] theorem update_fuel (a b c d x : Bits) : Function.update (store a b c d) Slot.fuel x=store a b c x := by
  funext k; cases k <;> rfl

def program (_ : Fin 1) : TM2.Stmt (fun _ : Slot => Bool) (Fin 1) Symbol :=
  .pop .input (fun _ bit => bit) (.branch (fun bit => bit.isSome)
    (.push .reader (fun bit => bit.getD false)
      (.push .original (fun bit => bit.getD false)
        (.push .fuel (fun _ => true) (.goto (fun _ => 0))))) .halt)

theorem step (bit : Bool) (bits reader original fuel : Bits) (saved : Symbol) :
    Stacks.stackRun program 1 ⟨some 0,saved,store (bit::bits) reader original fuel⟩=
      some ⟨some 0,some bit,store bits (bit::reader) (bit::original) (true::fuel)⟩ := by
  simp [Stacks.run_one,TM2.step,program,TM2.stepAux]

theorem complete (bits reader original fuel : Bits) (saved : Symbol) :
    Stacks.stackRun program (bits.length+1) ⟨some 0,saved,store bits reader original fuel⟩=
      some ⟨none,none,store [] (bits.reverse++reader) (bits.reverse++original) (List.replicate bits.length true++fuel)⟩ := by
  induction bits generalizing reader original fuel saved with
  | nil => simp [Stacks.run_one,TM2.step,program,TM2.stepAux]
  | cons bit bits ih =>
    have hS := step bit bits reader original fuel saved
    have hr := ih (bit::reader) (bit::original) (true::fuel) (some bit)
    rw [show (bit::bits).length+1=1+(bits.length+1) by simp; omega,Stacks.run_add,hS,Option.bind_some]
    simpa only [List.reverse_cons,List.append_assoc,List.singleton_append,List.length_cons,List.replicate_succ,List.cons_append,Parsing.marker_cons] using! hr

theorem clock (bits reader original fuel : Bits) (saved : Symbol) :
    Stacks.stackRunClock program (bits.length+1) ⟨some 0,saved,store bits reader original fuel⟩=
      bits.length*(4*bits.length+2*(reader.length+original.length+fuel.length)+9)+3 := by
  induction bits generalizing reader original fuel saved with
  | nil => simp [Stacks.stackRunClock,program,Stacks.stackClock]
  | cons bit bits ih =>
    rw [show (bit::bits).length+1=1+(bits.length+1) by simp; omega]
    rw [Stacks.clock_add program 1 (bits.length+1) _ _ (step bit bits reader original fuel saved),ih]
    simp [Stacks.stackRunClock,program,Stacks.stackClock]
    ring
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.ValidatorInput

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.NatTag
open Turing Qatlib.Concepts.BitWordCompiler.CanonicalCodec
abbrev Local := Fin 5×Symbol
inductive Label where | first | second | third deriving DecidableEq,Fintype
instance : Inhabited Label := ⟨.first⟩
def program : Label → TM2.Stmt (fun _ : Fin 1 => Bool) Label Local
  | .first => .pop 0 (fun _ bit => (0,bit))
      (.branch (fun v => v.2.isSome)
        (.branch (fun v => v.2.getD false)
          (.load (fun v => (1,v.2)) (.goto (fun _ => .second)))
          (.load (fun v => (4,v.2)) .halt)) .halt)
  | .second => .pop 0 (fun v bit => (v.1,bit))
      (.branch (fun v => v.2.isSome)
        (.load (fun v => (if v.2.getD false then 3 else 2,v.2)) (.goto (fun _ => .third))) .halt)
  | .third => .pop 0 (fun v bit => (v.1,bit))
      (.branch (fun v => v.2.isSome) (.load (fun v => (4,v.2)) .halt) .halt)

def ticks : Bits → ℕ
  | [] => 1
  | false::_ => 1
  | [true] => 2
  | true::_::_ => 3

def tag : Bits → Fin 5
  | [] => 0
  | [true] => 1
  | [true,false] => 2
  | [true,true] => 3
  | _ => 4

def final (bits : Bits) : TM2.Cfg (fun _ : Fin 1 => Bool) Label Local :=
  let n := ticks bits
  ⟨none,(tag bits,bits[n-1]?),Normalization.singleStack (bits.drop n)⟩

theorem complete (bits : Bits) (saved : Local) :
    Stacks.stackRun program (ticks bits) ⟨some .first,saved,Normalization.singleStack bits⟩=some (final bits) ∧
    Stacks.stackRunClock program (ticks bits) ⟨some .first,saved,Normalization.singleStack bits⟩≤20*(1+bits.length)^2 := by
  cases bits with
  | nil => constructor <;> simp [Stacks.stackRun,Stacks.stackRunClock,TM2.step,program,TM2.stepAux,Stacks.stackClock,ticks,final,tag]
  | cons bit bits =>
    cases bit with
    | false =>
      constructor <;> simp [Stacks.stackRun,Stacks.stackRunClock,TM2.step,program,TM2.stepAux,Stacks.stackClock,ticks,final,tag]
      nlinarith
    | true =>
      cases bits with
      | nil => constructor <;> simp [Stacks.stackRun,Stacks.stackRunClock,TM2.step,program,TM2.stepAux,Stacks.stackClock,ticks,final,tag]
      | cons bit bits =>
        cases bits with
        | nil => cases bit <;> constructor <;> simp [Stacks.stackRun,Stacks.stackRunClock,TM2.step,program,TM2.stepAux,Stacks.stackClock,ticks,final,tag]
        | cons bit' bits =>
          cases bit <;> cases bit' <;> constructor <;>
            simp [Stacks.stackRun,Stacks.stackRunClock,TM2.step,program,TM2.stepAux,Stacks.stackClock,ticks,final,tag]
          all_goals nlinarith

theorem tag_spec (bits : Bits) :
    ((tag bits).val=0 ↔ bits=[]) ∧ ((tag bits).val=1 ↔ bits=[true]) ∧
      ((tag bits).val=2 ↔ bits=[true,false]) ∧ ((tag bits).val=3 ↔ bits=[true,true]) := by
  cases bits with
  | nil => simp [tag]
  | cons bit bits =>
    cases bit with
    | false => simp [tag]
    | true =>
      cases bits with
      | nil => simp [tag]
      | cons bit bits =>
        cases bits with
        | nil => cases bit <;> simp [tag]
        | cons bit' bits => cases bit <;> cases bit' <;> simp [tag]
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.NatTag

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.CheckedNat
open Turing Qatlib.Concepts.BitWordCompiler.CanonicalCodec

def size (cfg : TM2.Cfg (fun _ : Fin 3 => Bool) Label Local) : ℕ :=
  (cfg.stk 0).length+(cfg.stk 1).length+(cfg.stk 2).length

theorem field_size (n : ℕ) (input output : Bits) (saved : Symbol) :
    size (fieldFinish n input output saved)≤n+input.length+output.length := by
  induction n generalizing input output saved with
  | zero => simp [fieldFinish,size]
  | succ n ih =>
    cases input with
    | nil => simp [fieldFinish,size]
    | cons bit bits =>
      have hi := ih bits (bit::output) (some bit)
      simp only [fieldFinish,List.length_cons] at hi ⊢
      omega

theorem result_size (input output : Bits) : size (haltedResult input output)≤input.length+output.length := by
  change size (parseResult input output)≤input.length+output.length
  cases hs : readSize input with
  | none => simp [parseResult,unaryFinish,hs,size]
  | some pair =>
    rcases pair with ⟨n,rest⟩
    have hshape := congrArg List.length (readSize_sound input n rest hs)
    simp only [List.length_append,List.length_replicate,List.length_cons] at hshape
    have hi := field_size n rest output none
    simp only [parseResult,hs]
    omega

end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.CheckedNat

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.ReadonlyCompare
open Turing Qatlib.Concepts.BitWordCompiler.CanonicalCodec
inductive Slot where | first | second | temp | left | right deriving DecidableEq,Fintype
abbrev Local := BinaryCompare.Local×Symbol

def store (first second temp left right : Bits) : Slot → Bits
  | .first => first
  | .second => second
  | .temp => temp
  | .left => left
  | .right => right

def getIO (v : Local) : Symbol := v.2
def putIO (v : Local) (bit : Symbol) : Local := (v.1,bit)
def getCmp (v : Local) : BinaryCompare.Local := v.1
def putCmp (v : Local) (order : BinaryCompare.Local) : Local := (order,v.2)

def firstCode (k : Fin 3) : Slot := if k=0 then .first else if k=1 then .temp else .left
def secondCode (k : Fin 3) : Slot := if k=0 then .second else if k=1 then .temp else .right
def compareCode (k : Fin 2) : Slot := if k=0 then .left else .right
inductive Label where | start | copyFirst (l : NatEmit.Label) | copySecond (l : NatEmit.Label) | compare (l : Fin 1) | done deriving DecidableEq,Fintype
instance : Inhabited Label := ⟨.start⟩
def program : Label → TM2.Stmt (fun _ : Slot => Bool) Label Local
  | .start => .load (fun v => ((.eq,none,none),v.2)) (.goto (fun _ => .copyFirst .emit))
  | .copyFirst l => StackCall.stmt firstCode Label.copyFirst (.copySecond .emit) getIO putIO (NatEmit.program l)
  | .copySecond l => StackCall.stmt secondCode Label.copySecond (.compare 0) getIO putIO (NatEmit.program l)
  | .compare l => StackCall.stmt compareCode Label.compare .done getCmp putCmp (BinaryCompare.program l)
  | .done => .halt

def firstFrame (second right : Bits) (S : Fin 3 → Bits) : Slot → Bits :=
    store (S 0) second (S 1) (S 2) right

theorem firstFrame_at (second right : Bits) (S : Fin 3 → Bits) (k : Fin 3) : firstFrame second right S (firstCode k)=S k := by
  fin_cases k <;> rfl

theorem firstFrame_update (second right : Bits) (S : Fin 3 → Bits) (k : Fin 3) (bits : Bits) :
    firstFrame second right (Function.update S k bits)=Function.update (firstFrame second right S) (firstCode k) bits := by
  funext j; fin_cases k <;> cases j <;> simp [firstFrame,firstCode,store]

def secondFrame (first left : Bits) (S : Fin 3 → Bits) : Slot → Bits :=
    store first (S 0) (S 1) left (S 2)

theorem secondFrame_at (first left : Bits) (S : Fin 3 → Bits) (k : Fin 3) : secondFrame first left S (secondCode k)=S k := by
  fin_cases k <;> rfl

theorem secondFrame_update (first left : Bits) (S : Fin 3 → Bits) (k : Fin 3) (bits : Bits) :
    secondFrame first left (Function.update S k bits)=Function.update (secondFrame first left S) (secondCode k) bits := by
  funext j; fin_cases k <;> cases j <;> simp [secondFrame,secondCode,store]

def compareFrame (first second temp : Bits) (S : Fin 2 → Bits) : Slot → Bits :=
    store first second temp (S 0) (S 1)

theorem compareFrame_at (first second temp : Bits) (S : Fin 2 → Bits) (k : Fin 2) : compareFrame first second temp S (compareCode k)=S k := by
  fin_cases k <;> rfl

theorem compareFrame_update (first second temp : Bits) (S : Fin 2 → Bits) (k : Fin 2) (bits : Bits) :
    compareFrame first second temp (Function.update S k bits)=Function.update (compareFrame first second temp S) (compareCode k) bits := by
  funext j; fin_cases k <;> cases j <;> simp [compareFrame,compareCode,store]

def order (first second : Bits) : BinaryCompare.Tag :=
  if binaryValue first.reverse<binaryValue second.reverse then .lt else if binaryValue second.reverse<binaryValue first.reverse then .gt else .eq

theorem complete (first second : Bits) (saved : Local) :
    ∃ ticks,
      Stacks.stackRun program ticks ⟨some .start,saved,store first second [] [] []⟩=
        some ⟨none,((order first second,none,none),none),store first second [] [] []⟩ ∧
      Stacks.stackRunClock program ticks ⟨some .start,saved,store first second [] [] []⟩≤100*(1+first.length+second.length)^2 := by
  let v0 : Local := ((.eq,none,none),saved.2)
  let v1 : Local := ((.eq,none,none),none)
  have hS : Stacks.stackRun program 1 ⟨some .start,saved,store first second [] [] []⟩=
      some ⟨some (.copyFirst .emit),v0,store first second [] [] []⟩ := rfl
  have hSC : Stacks.stackRunClock program 1 ⟨some .start,saved,store first second [] [] []⟩=1 := rfl
  obtain ⟨hA,_⟩ := NatEmit.copy_complete first [] (getIO v0)
  have hAC := NatEmit.copy_clock_bound first [] (getIO v0)
  simp only [List.append_nil,List.length_nil,Nat.add_zero] at hA hAC
  obtain ⟨hF,hFC⟩ := StackCall.execution firstCode Label.copyFirst (.copySecond .emit) getIO putIO
    (firstFrame second []) (firstFrame_at second []) (firstFrame_update second [])
    (fun _ _ => rfl) (fun _ _ _ => rfl) NatEmit.program program (fun _ => rfl) v0 (2*first.length+3) _ _ hA
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,
    firstFrame,Parsing.triple_zero,Parsing.triple_one,Parsing.triple_two] at hF hFC
  obtain ⟨hB,_⟩ := NatEmit.copy_complete second [] (getIO v1)
  have hBC := NatEmit.copy_clock_bound second [] (getIO v1)
  simp only [List.append_nil,List.length_nil,Nat.add_zero] at hB hBC
  obtain ⟨hG,hGC⟩ := StackCall.execution secondCode Label.copySecond (.compare 0) getIO putIO
    (secondFrame first first.reverse) (secondFrame_at first first.reverse) (secondFrame_update first first.reverse)
    (fun _ _ => rfl) (fun _ _ _ => rfl) NatEmit.program program (fun _ => rfl) v1 (2*second.length+3) _ _ hB
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,
    secondFrame,Parsing.triple_zero,Parsing.triple_one,Parsing.triple_two] at hG hGC
  obtain ⟨compareTicks,hC,hCC⟩ := BinaryCompare.complete first.reverse second.reverse (getCmp v1)
  obtain ⟨hN,hNC⟩ := StackCall.execution compareCode Label.compare .done getCmp putCmp
    (compareFrame first second []) (compareFrame_at first second []) (compareFrame_update first second [])
    (fun _ _ => rfl) (fun _ _ _ => rfl) BinaryCompare.program program (fun _ => rfl) v1 compareTicks _ _ hC
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,
    compareFrame,Stacks.stackPair_zero,Stacks.stackPair_one] at hN hNC
  have hD : Stacks.stackRun program 1 ⟨some .done,((order first second,none,none),none),store first second [] [] []⟩=
      some ⟨none,((order first second,none,none),none),store first second [] [] []⟩ := rfl
  have hDC :
      Stacks.stackRunClock program 1 ⟨some .done,((order first second,none,none),none),store first second [] [] []⟩=1 := rfl
  have eS : Stacks.Execution program _ _ 1 := ⟨1,hS,hSC.le⟩
  have eF : Stacks.Execution program _ _ _ := ⟨2*first.length+3,hF,hFC.trans_le hAC⟩
  have eG : Stacks.Execution program _ _ _ := ⟨2*second.length+3,hG,hGC.trans_le hBC⟩
  have eN : Stacks.Execution program _ _ _ := ⟨compareTicks,by
    simpa only [order,getCmp,v1,BinaryCompare.numeric_aux,putCmp] using hN,hNC.trans_le hCC⟩
  have eD : Stacks.Execution program _ _ 1 := ⟨1,hD,hDC.le⟩
  obtain ⟨ticks,hr,hc⟩ := (((eS.trans eF).trans eG).trans eN).trans eD
  refine ⟨ticks,hr,hc.trans ?_⟩
  let B := 1+first.length+second.length
  have hfirst : 1+first.length≤B := by dsimp [B]; omega
  have hsecond : 1+second.length≤B := by dsimp [B]; omega
  have ha := Nat.pow_le_pow_left hfirst 2
  have hb := Nat.pow_le_pow_left hsecond 2
  have hp : 1≤B^2 := Nat.one_le_pow 2 _ (by dsimp [B]; omega)
  simp only [List.length_reverse]
  change 1+25*(1+first.length)^2+25*(1+second.length)^2+20*B^2+1≤100*B^2
  nlinarith only [ha,hb,hp]
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.ReadonlyCompare

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.NatListFind
open Turing Qatlib.Concepts.BitWordCompiler.CanonicalCodec
inductive Slot where | seen | target | reader | markers | payload | cmpTemp | cmpLeft | cmpRight deriving DecidableEq,Fintype
structure Local where
  found : Bool
  checked : CheckedNat.Local
  compared : ReadonlyCompare.Local
  io : Symbol
  deriving DecidableEq,Fintype
instance : Inhabited Local := ⟨⟨false,(false,none),((.eq,none,none),none),none⟩⟩

def store (seen target reader markers payload cmpTemp cmpLeft cmpRight : Bits) : Slot → Bits
  | .seen => seen
  | .target => target
  | .reader => reader
  | .markers => markers
  | .payload => payload
  | .cmpTemp => cmpTemp
  | .cmpLeft => cmpLeft
  | .cmpRight => cmpRight

def getParse (v : Local) : CheckedNat.Local := v.checked
def putParse (v : Local) (value : CheckedNat.Local) : Local := {v with checked:=value}

@[simp] theorem putParse_get (v : Local) : putParse v (getParse v)=v := by cases v; rfl

def getCompare (v : Local) : ReadonlyCompare.Local := v.compared
def putCompare (v : Local) (value : ReadonlyCompare.Local) : Local := {v with compared:=value}

@[simp] theorem putCompare_get (v : Local) : putCompare v (getCompare v)=v := by cases v; rfl

def getIO (v : Local) : Symbol := v.io
def putIO (v : Local) (value : Symbol) : Local := {v with io:=value}

@[simp] theorem putIO_get (v : Local) : putIO v (getIO v)=v := by cases v; rfl

inductive Label where
  | start
  | copy (l : NatEmit.Label)
  | peek
  | parse (l : CheckedNat.Label)
  | branchParse
  | compare (l : ReadonlyCompare.Label)
  | branchCompare
  | loopDrain (l : Fin 1)
  | found
  | missing
  | finishPayload (l : Fin 1)
  | finishReader (l : Fin 1)
  | finishMarkers (l : Fin 1)
  | done
  deriving DecidableEq,Fintype
instance : Inhabited Label := ⟨.start⟩

def copyCode : Fin 3 → Slot
  | 0 => .seen
  | 1 => .markers
  | 2 => .reader

def copyFrame (target payload cmpTemp cmpLeft cmpRight : Bits) (S : Fin 3 → Bits) : Slot → Bits :=
    store (S 0) target (S 2) (S 1) payload cmpTemp cmpLeft cmpRight

theorem copyFrame_at (target payload cmpTemp cmpLeft cmpRight : Bits) (S : Fin 3 → Bits) (k : Fin 3) :
    copyFrame target payload cmpTemp cmpLeft cmpRight S (copyCode k)=S k := by
  fin_cases k <;> rfl

theorem copyFrame_update (target payload cmpTemp cmpLeft cmpRight : Bits) (S : Fin 3 → Bits) (k : Fin 3) (bits : Bits) :
    copyFrame target payload cmpTemp cmpLeft cmpRight (Function.update S k bits)=Function.update (copyFrame target payload cmpTemp cmpLeft cmpRight S) (copyCode k) bits := by
  funext j
  fin_cases k <;> cases j <;> simp [copyFrame,copyCode,store]

def parseCode : Fin 3 → Slot
  | 0 => .reader
  | 1 => .markers
  | 2 => .payload

def parseFrame (seen target cmpTemp cmpLeft cmpRight : Bits) (S : Fin 3 → Bits) : Slot → Bits :=
    store seen target (S 0) (S 1) (S 2) cmpTemp cmpLeft cmpRight

theorem parseFrame_at (seen target cmpTemp cmpLeft cmpRight : Bits) (S : Fin 3 → Bits) (k : Fin 3) :
    parseFrame seen target cmpTemp cmpLeft cmpRight S (parseCode k)=S k := by
  fin_cases k <;> rfl

theorem parseFrame_update (seen target cmpTemp cmpLeft cmpRight : Bits) (S : Fin 3 → Bits) (k : Fin 3) (bits : Bits) :
    parseFrame seen target cmpTemp cmpLeft cmpRight (Function.update S k bits)=Function.update (parseFrame seen target cmpTemp cmpLeft cmpRight S) (parseCode k) bits := by
  funext j
  fin_cases k <;> cases j <;> simp [parseFrame,parseCode,store]

def compareCode : ReadonlyCompare.Slot → Slot
  | .first => .payload
  | .second => .target
  | .temp => .cmpTemp
  | .left => .cmpLeft
  | .right => .cmpRight

def compareFrame (seen reader markers : Bits) (S : ReadonlyCompare.Slot → Bits) : Slot → Bits :=
    store seen (S .second) reader markers (S .first) (S .temp) (S .left) (S .right)

theorem compareFrame_at (seen reader markers : Bits) (S : ReadonlyCompare.Slot → Bits) (k : ReadonlyCompare.Slot) :
    compareFrame seen reader markers S (compareCode k)=S k := by
  cases k <;> rfl

theorem compareFrame_update (seen reader markers : Bits) (S : ReadonlyCompare.Slot → Bits) (k : ReadonlyCompare.Slot) (bits : Bits) :
    compareFrame seen reader markers (Function.update S k bits)=Function.update (compareFrame seen reader markers S) (compareCode k) bits := by
  funext j
  cases k <;> cases j <;> simp [compareFrame,compareCode,store]

def payloadDrainFrame (seen target reader markers cmpTemp cmpLeft cmpRight : Bits)
    (S : Fin 1 → Bits) : Slot → Bits :=
    store seen target reader markers (S 0) cmpTemp cmpLeft cmpRight

theorem payloadDrainFrame_at (seen target reader markers cmpTemp cmpLeft cmpRight : Bits) (S : Fin 1 → Bits) (k : Fin 1) :
    payloadDrainFrame seen target reader markers cmpTemp cmpLeft cmpRight S Slot.payload=S k := by fin_cases k; rfl

theorem payloadDrainFrame_update (seen target reader markers cmpTemp cmpLeft cmpRight : Bits) (S : Fin 1 → Bits) (k : Fin 1) (bits : Bits) :
    payloadDrainFrame seen target reader markers cmpTemp cmpLeft cmpRight (Function.update S k bits)=Function.update (payloadDrainFrame seen target reader markers cmpTemp cmpLeft cmpRight S) Slot.payload bits := by
  funext j
  fin_cases k
  cases j <;> simp [payloadDrainFrame,store]

def readerDrainFrame (seen target markers payload cmpTemp cmpLeft cmpRight : Bits)
    (S : Fin 1 → Bits) : Slot → Bits :=
    store seen target (S 0) markers payload cmpTemp cmpLeft cmpRight

theorem readerDrainFrame_at (seen target markers payload cmpTemp cmpLeft cmpRight : Bits) (S : Fin 1 → Bits) (k : Fin 1) :
    readerDrainFrame seen target markers payload cmpTemp cmpLeft cmpRight S Slot.reader=S k := by fin_cases k; rfl

theorem readerDrainFrame_update (seen target markers payload cmpTemp cmpLeft cmpRight : Bits) (S : Fin 1 → Bits) (k : Fin 1) (bits : Bits) :
    readerDrainFrame seen target markers payload cmpTemp cmpLeft cmpRight (Function.update S k bits)=Function.update (readerDrainFrame seen target markers payload cmpTemp cmpLeft cmpRight S) Slot.reader bits := by
  funext j
  fin_cases k
  cases j <;> simp [readerDrainFrame,store]

def markersDrainFrame (seen target reader payload cmpTemp cmpLeft cmpRight : Bits)
    (S : Fin 1 → Bits) : Slot → Bits :=
    store seen target reader (S 0) payload cmpTemp cmpLeft cmpRight

theorem markersDrainFrame_at (seen target reader payload cmpTemp cmpLeft cmpRight : Bits) (S : Fin 1 → Bits) (k : Fin 1) :
    markersDrainFrame seen target reader payload cmpTemp cmpLeft cmpRight S Slot.markers=S k := by fin_cases k; rfl

theorem markersDrainFrame_update (seen target reader payload cmpTemp cmpLeft cmpRight : Bits) (S : Fin 1 → Bits) (k : Fin 1) (bits : Bits) :
    markersDrainFrame seen target reader payload cmpTemp cmpLeft cmpRight (Function.update S k bits)=Function.update (markersDrainFrame seen target reader payload cmpTemp cmpLeft cmpRight S) Slot.markers bits := by
  funext j
  fin_cases k
  cases j <;> simp [markersDrainFrame,store]

def program : Label → TM2.Stmt (fun _ : Slot => Bool) Label Local
  | .start => .load (fun v => {v with found:=false}) (.goto (fun _ => .copy .emit))
  | .copy l => StackCall.stmt copyCode Label.copy .peek getIO putIO (NatEmit.program l)
  | .peek => .peek .reader (fun v bit => {v with io:=bit})
      (.branch (fun v => v.io.isSome) (.goto (fun _ => .parse .unary)) (.goto (fun _ => .missing)))
  | .parse l => StackCall.stmt parseCode Label.parse .branchParse getParse putParse (CheckedNat.program l)
  | .branchParse => .branch (fun v => v.checked.1) (.goto (fun _ => .compare .start)) (.goto (fun _ => .missing))
  | .compare l => StackCall.stmt compareCode Label.compare .branchCompare getCompare putCompare (ReadonlyCompare.program l)
  | .branchCompare => .branch (fun v => decide (v.compared.1.1=.eq)) (.goto (fun _ => .found)) (.goto (fun _ => .loopDrain 0))
  | .loopDrain l => StackCall.stmt (fun _ : Fin 1 => Slot.payload) Label.loopDrain .peek getIO putIO (Normalization.drainProgram l)
  | .found => .load (fun v => {v with found:=true}) (.goto (fun _ => .finishPayload 0))
  | .missing => .load (fun v => {v with found:=false}) (.goto (fun _ => .finishPayload 0))
  | .finishPayload l => StackCall.stmt (fun _ : Fin 1 => Slot.payload) Label.finishPayload (.finishReader 0) getIO putIO (Normalization.drainProgram l)
  | .finishReader l => StackCall.stmt (fun _ : Fin 1 => Slot.reader) Label.finishReader (.finishMarkers 0) getIO putIO (Normalization.drainProgram l)
  | .finishMarkers l => StackCall.stmt (fun _ : Fin 1 => Slot.markers) Label.finishMarkers .done getIO putIO (Normalization.drainProgram l)
  | .done => .halt

theorem parse_valid (n : ℕ) (rest seen target : Bits) (v : Local) :
    ∃ ticks,
      Stacks.stackRun program ticks ⟨some (.parse .unary),v,store seen target (natBits n++rest) [] [] [] [] []⟩=
        some ⟨some .branchParse,putParse v (true,CheckedNat.lastField n.bits none),store seen target rest [] n.bits.reverse [] [] []⟩ ∧
      Stacks.stackRunClock program ticks ⟨some (.parse .unary),v,store seen target (natBits n++rest) [] [] [] [] []⟩≤
        50*(1+(natBits n++rest).length)^2 := by
  obtain ⟨ticks,hr,hc⟩ := CheckedNat.valid_execution n rest [] (getParse v)
  simp only [List.append_nil,List.length_nil,Nat.add_zero] at hr hc
  obtain ⟨hN,hNC⟩ := StackCall.execution parseCode Label.parse .branchParse getParse putParse
    (parseFrame seen target [] [] []) (parseFrame_at seen target [] [] []) (parseFrame_update seen target [] [] [])
    (fun _ _ => rfl) (fun _ _ _ => rfl) CheckedNat.program program (fun _ => rfl) v ticks _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,
    parseFrame,Parsing.triple_zero,Parsing.triple_one,Parsing.triple_two,putParse_get] at hN hNC
  exact ⟨ticks,hN,hNC.trans_le hc⟩

theorem compare_call (payload target seen reader : Bits) (v : Local) :
    ∃ ticks,
      Stacks.stackRun program ticks ⟨some (.compare .start),v,store seen target reader [] payload [] [] []⟩=
        some ⟨some .branchCompare,putCompare v ((ReadonlyCompare.order payload target,none,none),none),store seen target reader [] payload [] [] []⟩ ∧
      Stacks.stackRunClock program ticks ⟨some (.compare .start),v,store seen target reader [] payload [] [] []⟩≤
        100*(1+payload.length+target.length)^2 := by
  obtain ⟨ticks,hr,hc⟩ := ReadonlyCompare.complete payload target (getCompare v)
  obtain ⟨hN,hNC⟩ := StackCall.execution compareCode Label.compare .branchCompare getCompare putCompare
    (compareFrame seen reader []) (compareFrame_at seen reader []) (compareFrame_update seen reader [])
    (fun _ _ => rfl) (fun _ _ _ => rfl) ReadonlyCompare.program program (fun _ => rfl) v ticks _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,
    compareFrame,ReadonlyCompare.store,putCompare_get] at hN hNC
  exact ⟨ticks,hN,hNC.trans_le hc⟩

theorem payload_drain (code : Fin 1 → Label) (returnTo : Label)
    (hcode : ∀ l,program (code l)=StackCall.stmt (fun _ : Fin 1 => Slot.payload) code returnTo getIO putIO (Normalization.drainProgram l))
    (seen target reader markers payload : Bits) (v : Local) :
    Stacks.stackRun program (payload.length+1) ⟨some (code 0),v,store seen target reader markers payload [] [] []⟩=
      some ⟨some returnTo,putIO v none,store seen target reader markers [] [] [] []⟩ ∧
    Stacks.stackRunClock program (payload.length+1) ⟨some (code 0),v,store seen target reader markers payload [] [] []⟩=
      payload.length^2+3*payload.length+3 := by
  have hr := Normalization.drain_run payload (getIO v)
  obtain ⟨hN,hNC⟩ := StackCall.execution (fun _ : Fin 1 => Slot.payload) code returnTo getIO putIO
    (payloadDrainFrame seen target reader markers [] [] []) (payloadDrainFrame_at seen target reader markers [] [] []) (payloadDrainFrame_update seen target reader markers [] [] [])
    (fun _ _ => rfl) (fun _ _ _ => rfl) Normalization.drainProgram program hcode v (payload.length+1) _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,
    payloadDrainFrame,Normalization.singleStack_zero,putIO_get] at hN hNC
  exact ⟨hN,hNC.trans (Normalization.drain_clock payload (getIO v))⟩

theorem reader_drain (seen target reader markers : Bits) (v : Local) :
    Stacks.stackRun program (reader.length+1) ⟨some (.finishReader 0),v,store seen target reader markers [] [] [] []⟩=
      some ⟨some (.finishMarkers 0),putIO v none,store seen target [] markers [] [] [] []⟩ ∧
    Stacks.stackRunClock program (reader.length+1) ⟨some (.finishReader 0),v,store seen target reader markers [] [] [] []⟩=
      reader.length^2+3*reader.length+3 := by
  have hr := Normalization.drain_run reader (getIO v)
  obtain ⟨hN,hNC⟩ := StackCall.execution (fun _ : Fin 1 => Slot.reader) Label.finishReader (.finishMarkers 0) getIO putIO
    (readerDrainFrame seen target markers [] [] [] []) (readerDrainFrame_at seen target markers [] [] [] []) (readerDrainFrame_update seen target markers [] [] [] [])
    (fun _ _ => rfl) (fun _ _ _ => rfl) Normalization.drainProgram program (fun _ => rfl) v (reader.length+1) _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,
    readerDrainFrame,Normalization.singleStack_zero,putIO_get] at hN hNC
  exact ⟨hN,hNC.trans (Normalization.drain_clock reader (getIO v))⟩

theorem markers_drain (seen target markers : Bits) (v : Local) :
    Stacks.stackRun program (markers.length+1) ⟨some (.finishMarkers 0),v,store seen target [] markers [] [] [] []⟩=
      some ⟨some .done,putIO v none,store seen target [] [] [] [] [] []⟩ ∧
    Stacks.stackRunClock program (markers.length+1) ⟨some (.finishMarkers 0),v,store seen target [] markers [] [] [] []⟩=
      markers.length^2+3*markers.length+3 := by
  have hr := Normalization.drain_run markers (getIO v)
  obtain ⟨hN,hNC⟩ := StackCall.execution (fun _ : Fin 1 => Slot.markers) Label.finishMarkers .done getIO putIO
    (markersDrainFrame seen target [] [] [] [] []) (markersDrainFrame_at seen target [] [] [] [] []) (markersDrainFrame_update seen target [] [] [] [] [])
    (fun _ _ => rfl) (fun _ _ _ => rfl) Normalization.drainProgram program (fun _ => rfl) v (markers.length+1) _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,
    markersDrainFrame,Normalization.singleStack_zero,putIO_get] at hN hNC
  exact ⟨hN,hNC.trans (Normalization.drain_clock markers (getIO v))⟩

theorem finish (seen target reader markers payload : Bits) (v : Local) :
    ∃ ticks,
      Stacks.stackRun program ticks ⟨some (.finishPayload 0),v,store seen target reader markers payload [] [] []⟩=
        some ⟨none,putIO v none,store seen target [] [] [] [] [] []⟩ ∧
      Stacks.stackRunClock program ticks ⟨some (.finishPayload 0),v,store seen target reader markers payload [] [] []⟩≤
        40*(1+reader.length+markers.length+payload.length)^2 := by
  obtain ⟨hP,hPC⟩ :=
      payload_drain Label.finishPayload (.finishReader 0)
      (fun _ => rfl) seen target reader markers payload v
  obtain ⟨hR,hRC⟩ := reader_drain seen target reader markers (putIO v none)
  obtain ⟨hM,hMC⟩ := markers_drain seen target markers (putIO v none)
  have hD : Stacks.stackRun program 1 ⟨some .done,putIO v none,store seen target [] [] [] [] [] []⟩=
      some ⟨none,putIO v none,store seen target [] [] [] [] [] []⟩ := rfl
  have hDC :
      Stacks.stackRunClock program 1 ⟨some .done,putIO v none,store seen target [] [] [] [] [] []⟩=1 := rfl
  have eP : Stacks.Execution program _ _ _ := ⟨payload.length+1,hP,hPC.le⟩
  have eR : Stacks.Execution program _ _ _ := ⟨reader.length+1,hR,hRC.le⟩
  have eM : Stacks.Execution program _ _ _ := ⟨markers.length+1,hM,hMC.le⟩
  have eD : Stacks.Execution program _ _ 1 := ⟨1,hD,hDC.le⟩
  obtain ⟨ticks,hr,hc⟩ := ((eP.trans eR).trans eM).trans eD
  refine ⟨ticks,hr,hc.trans ?_⟩
  let B := 1+reader.length+markers.length+payload.length
  have hp : payload.length≤B := by dsimp [B]; omega
  have hr : reader.length≤B := by dsimp [B]; omega
  have hm : markers.length≤B := by dsimp [B]; omega
  have hp2 := Nat.mul_le_mul hp hp
  have hr2 := Nat.mul_le_mul hr hr
  have hm2 := Nat.mul_le_mul hm hm
  have hB2 : B≤B^2 := Nat.le_pow (by decide)
  have hB : 1≤B := by dsimp [B]; omega
  change _≤40*B^2
  nlinarith only [hp,hr,hm,hp2,hr2,hm2,hB,hB2]

theorem peek (seen target reader : Bits) (v : Local) :
    Stacks.stackRun program 1 ⟨some .peek,v,store seen target reader [] [] [] [] []⟩=
      some ⟨some (if reader=[] then .missing else .parse .unary),putIO v reader.head?,store seen target reader [] [] [] [] []⟩ ∧
    Stacks.stackRunClock program 1 ⟨some .peek,v,store seen target reader [] [] [] [] []⟩=2*reader.length+3 := by
  cases reader <;> constructor <;> simp
      [Stacks.run_one,Stacks.stackRunClock,TM2.step,program,TM2.stepAux,Stacks.stackClock,store,putIO]
  all_goals omega

theorem branch_parse (S : Slot → Bits) (v : Local) (hv : v.checked.1=true) :
    Stacks.stackRun program 1 ⟨some .branchParse,v,S⟩=some ⟨some (.compare .start),v,S⟩ ∧
      Stacks.stackRunClock program 1 ⟨some .branchParse,v,S⟩=1 := by
  constructor <;> simp [Stacks.run_one,Stacks.stackRunClock,TM2.step,program,TM2.stepAux,Stacks.stackClock,hv]

theorem branch_compare (S : Slot → Bits) (v : Local) :
    Stacks.stackRun program 1 ⟨some .branchCompare,v,S⟩=
      some ⟨some (if v.compared.1.1=.eq then .found else .loopDrain 0),v,S⟩ ∧
    Stacks.stackRunClock program 1 ⟨some .branchCompare,v,S⟩=1 := by
  constructor
  · by_cases he : v.compared.1.1=.eq <;> simp [Stacks.run_one,TM2.step,program,TM2.stepAux,he]
  · simp [Stacks.stackRunClock,program,Stacks.stackClock]

theorem finish_flag (flag : Bool) (seen target reader markers payload : Bits) (v : Local) :
    ∃ ticks,
      Stacks.stackRun program ticks ⟨some (if flag then .found else .missing),v,store seen target reader markers payload [] [] []⟩=
        some ⟨none,putIO {v with found:=flag} none,store seen target [] [] [] [] [] []⟩ ∧
      Stacks.stackRunClock program ticks ⟨some (if flag then .found else .missing),v,store seen target reader markers payload [] [] []⟩≤
        50*(1+reader.length+markers.length+payload.length)^2 := by
  have hS : Stacks.stackRun program 1 ⟨some (if flag then .found else .missing),v,store seen target reader markers payload [] [] []⟩=
      some ⟨some (.finishPayload 0),{v with found:=flag},store seen target reader markers payload [] [] []⟩ := by
    cases flag <;> rfl
  have hSC : Stacks.stackRunClock program 1 ⟨some (if flag then .found else .missing),v,store seen target reader markers payload [] [] []⟩=1 := by
    cases flag <;> rfl
  obtain ⟨ticks,hr,hc⟩ := finish seen target reader markers payload {v with found:=flag}
  have eS : Stacks.Execution program _ _ 1 := ⟨1,hS,hSC.le⟩
  have eR : Stacks.Execution program _ _ _ := ⟨ticks,hr,hc⟩
  obtain ⟨total,hR,hC⟩ := eS.trans eR
  refine ⟨total,hR,hC.trans ?_⟩
  have hp : 1≤(1+reader.length+markers.length+payload.length)^2 := Nat.one_le_pow 2 _ (by omega)
  omega

theorem compare_nat_eq (m n : ℕ) : ReadonlyCompare.order m.bits.reverse n.bits.reverse=.eq ↔ m=n := by
  simp only [ReadonlyCompare.order,List.reverse_reverse,binaryValue_bits]
  split_ifs <;> simp_all <;> omega

def stream (values : List ℕ) : Bits := values.flatMap natBits

theorem inspect_head (m n : ℕ) (tail seen : Bits) (v : Local) :
    let v0 := putIO v (natBits m++tail).head?
    let v1 := putParse v0 (true,CheckedNat.lastField m.bits none)
    let v2 := putCompare v1 ((ReadonlyCompare.order m.bits.reverse n.bits.reverse,none,none),none)
    ∃ ticks,
      Stacks.stackRun program ticks ⟨some .peek,v,store seen n.bits.reverse (natBits m++tail) [] [] [] [] []⟩=
        some ⟨some .branchCompare,v2,store seen n.bits.reverse tail [] m.bits.reverse [] [] []⟩ ∧
      Stacks.stackRunClock program ticks ⟨some .peek,v,store seen n.bits.reverse (natBits m++tail) [] [] [] [] []⟩≤
        200*(1+(natBits m++tail).length+n.bits.length)^2 := by
  let v0 := putIO v (natBits m++tail).head?
  let v1 := putParse v0 (true,CheckedNat.lastField m.bits none)
  obtain ⟨hP,hPC⟩ := peek seen n.bits.reverse (natBits m++tail) v
  have hne : natBits m++tail≠[] := by
    intro he
    have hl := congrArg List.length he
    simp only [List.length_append,natBits_length,List.length_nil] at hl
    omega
  rw [if_neg hne] at hP
  obtain ⟨parseTicks,hR,hRC⟩ := parse_valid m tail seen n.bits.reverse v0
  obtain ⟨hB,hBC⟩ := branch_parse (store seen n.bits.reverse tail [] m.bits.reverse [] [] []) v1 rfl
  obtain ⟨cmpTicks,hC,hCC⟩ := compare_call m.bits.reverse n.bits.reverse seen tail v1
  have eP : Stacks.Execution program _ _ _ := ⟨1,hP,hPC.le⟩
  have eR : Stacks.Execution program _ _ _ := ⟨parseTicks,hR,hRC⟩
  have eB : Stacks.Execution program _ _ 1 := ⟨1,hB,hBC.le⟩
  have eC : Stacks.Execution program _ _ _ := ⟨cmpTicks,hC,hCC⟩
  obtain ⟨ticks,hr,hc⟩ := ((eP.trans eR).trans eB).trans eC
  refine ⟨ticks,hr,hc.trans ?_⟩
  let B := 1+(natBits m++tail).length+n.bits.length
  have hB : 1≤B := by dsimp [B]; omega
  have hB2 : B≤B^2 := Nat.le_pow (by decide)
  have hraw : 1+(natBits m++tail).length≤B := by dsimp [B]; omega
  have harg : 1+m.bits.length+n.bits.length≤B := by
    dsimp [B]
    simp only [List.length_append,natBits_length]
    omega
  have hraw2 := Nat.pow_le_pow_left hraw 2
  have harg2 := Nat.pow_le_pow_left harg 2
  simp only [List.length_reverse]
  change _≤200*B^2
  nlinarith only [hB,hB2,hraw,hraw2,harg2]

theorem loop_complete (values : List ℕ) (seen : Bits) (n : ℕ) (v : Local) :
    ∃ ticks last,
      Stacks.stackRun program ticks ⟨some .peek,v,store seen n.bits.reverse (stream values) [] [] [] [] []⟩=
        some ⟨none,last,store seen n.bits.reverse [] [] [] [] [] []⟩ ∧
      last.found=decide (n∈values) ∧
      Stacks.stackRunClock program ticks ⟨some .peek,v,store seen n.bits.reverse (stream values) [] [] [] [] []⟩≤
        1000*(values.length+1)*(1+(stream values).length+n.bits.length)^2 := by
  induction values generalizing v with
  | nil =>
    obtain ⟨hP,hPC⟩ := peek seen n.bits.reverse [] v
    simp only [List.head?_nil,List.length_nil,Nat.mul_zero,Nat.zero_add] at hP hPC
    obtain ⟨ticks,hF,hFC⟩ := finish_flag false seen n.bits.reverse [] [] [] (putIO v none)
    have eP : Stacks.Execution program _ _ 3 := ⟨1,hP,hPC.le⟩
    have eF : Stacks.Execution program _ _ _ := ⟨ticks,hF,hFC⟩
    obtain ⟨total,hr,hc⟩ := eP.trans eF
    refine ⟨total,_,hr,rfl,hc.trans ?_⟩
    simp only [stream,List.flatMap_nil,List.length_nil,Nat.zero_add,Nat.add_zero,Nat.mul_one,Nat.one_pow]
    have hp : 1≤(1+n.bits.length)^2 := Nat.one_le_pow 2 _ (by omega)
    omega
  | cons m values ih =>
    let rest := stream values
    let v0 := putIO v (natBits m++rest).head?
    let v1 := putParse v0 (true,CheckedNat.lastField m.bits none)
    let v2 := putCompare v1 ((ReadonlyCompare.order m.bits.reverse n.bits.reverse,none,none),none)
    let T := 1+(stream (m::values)).length+n.bits.length
    have hT : 1≤T := by dsimp [T]; omega
    have hT2 : T≤T^2 := Nat.le_pow (by decide)
    have hTpos : 1≤T^2 := hT.trans hT2
    have hraw : (stream (m::values)).length=(natBits m).length+rest.length := by
      simp only [stream,List.flatMap_cons,List.length_append]
      rfl
    have hm : m.bits.length≤T := by dsimp [T]; rw [hraw,natBits_length]; omega
    have hm2 := Nat.mul_le_mul hm hm
    have harg : 1+rest.length+m.bits.length≤T := by dsimp [T]; rw [hraw,natBits_length]; omega
    have harg2 := Nat.pow_le_pow_left harg 2
    have hTail : 1+rest.length+n.bits.length≤T := by dsimp [T]; rw [hraw]; omega
    have hTail2 := Nat.pow_le_pow_left hTail 2
    obtain ⟨headTicks,hH,hHC⟩ := inspect_head m n rest seen v
    have eH : Stacks.Execution program _ _ (200*T^2) := ⟨headTicks,hH,hHC⟩
    obtain ⟨hB,hBC⟩ := branch_compare (store seen n.bits.reverse rest [] m.bits.reverse [] [] []) v2
    by_cases he : m=n
    · have hcmp : v2.compared.1.1=.eq := by
        change ReadonlyCompare.order m.bits.reverse n.bits.reverse=.eq
        exact (compare_nat_eq m n).mpr he
      rw [if_pos hcmp] at hB
      obtain ⟨finishTicks,hF,hFC⟩ := finish_flag true seen n.bits.reverse rest [] m.bits.reverse v2
      have eB : Stacks.Execution program _ _ 1 := ⟨1,hB,hBC.le⟩
      have eF : Stacks.Execution program _ _ (50*T^2) := ⟨finishTicks,hF,hFC.trans (by
        simp only [List.length_nil,Nat.add_zero,List.length_reverse]
        exact Nat.mul_le_mul_left 50 harg2)⟩
      obtain ⟨ticks,hr,hc⟩ := (eH.trans eB).trans eF
      refine ⟨ticks,_,hr,?_,hc.trans ?_⟩
      · simp only [putIO,List.mem_cons,he,true_or,decide_true]
      · have hp : T^2≤(values.length+1+1)*T^2 := Nat.le_mul_of_pos_left _ (by omega)
        change 200*T^2+1+50*T^2≤1000*(values.length+1+1)*T^2
        nlinarith only [hp,hTpos]
    · have hcmp : v2.compared.1.1≠.eq := by
        change ReadonlyCompare.order m.bits.reverse n.bits.reverse≠.eq
        exact mt (compare_nat_eq m n).mp he
      rw [if_neg hcmp] at hB
      obtain ⟨hD,hDC⟩ :=
          payload_drain Label.loopDrain .peek (fun _ => rfl) seen n.bits.reverse rest
          [] m.bits.reverse v2
      obtain ⟨tailTicks,last,hR,hfound,hRC⟩ := ih (putIO v2 none)
      have eB : Stacks.Execution program _ _ 1 := ⟨1,hB,hBC.le⟩
      have eD : Stacks.Execution program _ _ (10*T^2) := ⟨m.bits.reverse.length+1,hD,by
        rw [hDC]
        simp only [List.length_reverse]
        nlinarith only [hm,hm2,hT,hT2]⟩
      have eR : Stacks.Execution program _ _ (1000*(values.length+1)*T^2) := ⟨tailTicks,hR,hRC.trans
        (Nat.mul_le_mul_left (1000*(values.length+1)) hTail2)⟩
      obtain ⟨ticks,hr,hc⟩ := ((eH.trans eB).trans eD).trans eR
      refine ⟨ticks,last,hr,?_,hc.trans ?_⟩
      · simpa only [List.mem_cons,show n≠m from Ne.symm he,false_or] using hfound
      · change 200*T^2+1+10*T^2+1000*(values.length+1)*T^2≤1000*(values.length+1+1)*T^2
        nlinarith only [hTpos]

theorem copy_call (seen target : Bits) (v : Local) :
    Stacks.stackRun program (2*seen.length+3) ⟨some (.copy .emit),v,store seen target [] [] [] [] [] []⟩=
      some ⟨some .peek,putIO v none,store seen target seen.reverse [] [] [] [] []⟩ ∧
    Stacks.stackRunClock program (2*seen.length+3) ⟨some (.copy .emit),v,store seen target [] [] [] [] [] []⟩≤25*(1+seen.length)^2 := by
  obtain ⟨hr,_⟩ := NatEmit.copy_complete seen [] (getIO v)
  have hc := NatEmit.copy_clock_bound seen [] (getIO v)
  simp only [List.append_nil,List.length_nil,Nat.add_zero] at hr hc
  obtain ⟨hN,hNC⟩ := StackCall.execution copyCode Label.copy .peek getIO putIO
    (copyFrame target [] [] [] []) (copyFrame_at target [] [] [] []) (copyFrame_update target [] [] [] [])
    (fun _ _ => rfl) (fun _ _ _ => rfl) NatEmit.program program (fun _ => rfl) v (2*seen.length+3) _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,
    copyFrame,Parsing.triple_zero,Parsing.triple_one,Parsing.triple_two,putIO_get] at hN hNC
  exact ⟨hN,hNC.trans_le hc⟩

theorem complete (values : List ℕ) (n : ℕ) (v : Local) :
    ∃ ticks last,
      Stacks.stackRun program ticks ⟨some .start,v,store (stream values).reverse n.bits.reverse [] [] [] [] [] []⟩=
        some ⟨none,last,store (stream values).reverse n.bits.reverse [] [] [] [] [] []⟩ ∧
      last.found=decide (n∈values) ∧
      Stacks.stackRunClock program ticks ⟨some .start,v,store (stream values).reverse n.bits.reverse [] [] [] [] [] []⟩≤
        2000*(1+(stream values).length+n.bits.length)^3 := by
  let v0 : Local := {v with found:=false}
  have hS : Stacks.stackRun program 1 ⟨some .start,v,store (stream values).reverse n.bits.reverse [] [] [] [] [] []⟩=
      some ⟨some (.copy .emit),v0,store (stream values).reverse n.bits.reverse [] [] [] [] [] []⟩ := rfl
  have hSC :
      Stacks.stackRunClock program 1 ⟨some .start,v,store (stream values).reverse n.bits.reverse [] [] [] [] [] []⟩=1 := rfl
  obtain ⟨hC,hCC⟩ := copy_call (stream values).reverse n.bits.reverse v0
  simp only [List.length_reverse,List.reverse_reverse] at hC hCC
  obtain ⟨tailTicks,last,hR,hfound,hRC⟩ :=
      loop_complete values (stream values).reverse n (putIO v0 none)
  have eS : Stacks.Execution program _ _ 1 := ⟨1,hS,hSC.le⟩
  have eC : Stacks.Execution program _ _ _ := ⟨2*(stream values).length+3,hC,hCC⟩
  have eR : Stacks.Execution program _ _ _ := ⟨tailTicks,hR,hRC⟩
  obtain ⟨ticks,hr,hc⟩ := (eS.trans eC).trans eR
  refine ⟨ticks,last,hr,hfound,hc.trans ?_⟩
  let B := 1+(stream values).length+n.bits.length
  have hB : 1≤B := by dsimp [B]; omega
  have hB2 : 1≤B^2 := Nat.one_le_pow 2 _ hB
  have hn := flatNatBits_length_ge values
  have hc1 : values.length+1≤B := by dsimp [B,stream]; omega
  have hb1 : 1+(stream values).length≤B := by dsimp [B]; omega
  have hb2 := Nat.pow_le_pow_left hb1 2
  have hr1 : 1000*(values.length+1)*B^2≤1000*B^3 := by
    calc
      _ ≤ (1000*B)*B^2 := Nat.mul_le_mul_right (B^2) (Nat.mul_le_mul_left 1000 hc1)
      _ = _ := by ring
  have h23 : B^2≤B^3 := Nat.pow_le_pow_right (by omega) (by decide)
  change 1+25*(1+(stream values).length)^2+1000*(values.length+1)*B^2≤2000*B^3
  nlinarith only [hB2,hb2,hr1,h23]

end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.NatListFind

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.NatSetInsert
open Turing Qatlib.Concepts.BitWordCompiler.CanonicalCodec
abbrev Slot := Option NatListFind.Slot
abbrev Local := NatListFind.Local×Symbol

def store (seen target value reader markers payload cmpTemp cmpLeft cmpRight : Bits) : Slot → Bits
  | none => value
  | some k => NatListFind.store seen target reader markers payload cmpTemp cmpLeft cmpRight k

def getFind (v : Local) : NatListFind.Local := v.1
def putFind (v : Local) (value : NatListFind.Local) : Local := (value,v.2)
def getIO (v : Local) : Symbol := v.2
def putIO (v : Local) (value : Symbol) : Local := (v.1,value)

@[simp] theorem putFind_get (v : Local) : putFind v (getFind v)=v := rfl

@[simp] theorem putIO_get (v : Local) : putIO v (getIO v)=v := rfl

inductive Label where
  | find (l : NatListFind.Label)
  | branch
  | copy (l : NatEmit.Label)
  | emit (l : NatEmit.Label)
  | drain (l : Fin 1)
  | done
  deriving DecidableEq,Fintype
instance : Inhabited Label := ⟨.find .start⟩

def copyCode : Fin 3 → Slot
  | 0 => some .target
  | 1 => some .markers
  | _ => none

def emitCode : Fin 3 → Slot
  | 0 => none
  | 1 => some .markers
  | _ => some .seen

def program : Label → TM2.Stmt (fun _ : Slot => Bool) Label Local
  | .find l => StackCall.stmt some Label.find .branch getFind putFind (NatListFind.program l)
  | .branch => .branch (fun v => v.1.found) .halt (.goto (fun _ => .copy .emit))
  | .copy l => StackCall.stmt copyCode Label.copy (.emit .count) getIO putIO (NatEmit.program l)
  | .emit l => StackCall.stmt emitCode Label.emit (.drain 0) getIO putIO (NatEmit.program l)
  | .drain l => StackCall.stmt (fun _ : Fin 1 => (none : Slot)) Label.drain .done getIO putIO (Normalization.drainProgram l)
  | .done => .halt

def findFrame (value : Bits) (S : NatListFind.Slot → Bits) : Slot → Bits
  | none => value
  | some k => S k

theorem findFrame_at (value : Bits) (S : NatListFind.Slot → Bits) (k : NatListFind.Slot) :
    findFrame value S (some k)=S k := rfl

theorem findFrame_update (value : Bits) (S : NatListFind.Slot → Bits) (k : NatListFind.Slot) (bits : Bits) :
    findFrame value (Function.update S k bits)=Function.update (findFrame value S) (some k) bits := by
  funext j
  cases j with
  | none => simp [findFrame]
  | some j => simp [findFrame,Function.update_apply]

def copyFrame (seen reader payload cmpTemp cmpLeft cmpRight : Bits) (S : Fin 3 → Bits) : Slot →
    Bits := store seen (S 0) (S 2) reader (S 1) payload cmpTemp cmpLeft cmpRight

theorem copyFrame_at (seen reader payload cmpTemp cmpLeft cmpRight : Bits) (S : Fin 3 → Bits) (k : Fin 3) :
    copyFrame seen reader payload cmpTemp cmpLeft cmpRight S (copyCode k)=S k := by fin_cases k <;> rfl

theorem copyFrame_update (seen reader payload cmpTemp cmpLeft cmpRight : Bits) (S : Fin 3 → Bits) (k : Fin 3) (bits : Bits) :
    copyFrame seen reader payload cmpTemp cmpLeft cmpRight (Function.update S k bits)=Function.update (copyFrame seen reader payload cmpTemp cmpLeft cmpRight S) (copyCode k) bits := by
  funext j
  fin_cases k <;> cases j with
  | none => simp [copyFrame,copyCode,store]
  | some j => cases j <;> simp [copyFrame,copyCode,store,NatListFind.store]

def emitFrame (target reader payload cmpTemp cmpLeft cmpRight : Bits) (S : Fin 3 → Bits) : Slot →
    Bits := store (S 2) target (S 0) reader (S 1) payload cmpTemp cmpLeft cmpRight

theorem emitFrame_at (target reader payload cmpTemp cmpLeft cmpRight : Bits) (S : Fin 3 → Bits) (k : Fin 3) :
    emitFrame target reader payload cmpTemp cmpLeft cmpRight S (emitCode k)=S k := by fin_cases k <;> rfl

theorem emitFrame_update (target reader payload cmpTemp cmpLeft cmpRight : Bits) (S : Fin 3 → Bits) (k : Fin 3) (bits : Bits) :
    emitFrame target reader payload cmpTemp cmpLeft cmpRight (Function.update S k bits)=Function.update (emitFrame target reader payload cmpTemp cmpLeft cmpRight S) (emitCode k) bits := by
  funext j
  fin_cases k <;> cases j with
  | none => simp [emitFrame,emitCode,store]
  | some j => cases j <;> simp [emitFrame,emitCode,store,NatListFind.store]

def drainFrame (seen target reader markers payload cmpTemp cmpLeft cmpRight : Bits)
    (S : Fin 1 → Bits) : Slot → Bits :=
    store seen target (S 0) reader markers payload cmpTemp cmpLeft cmpRight

theorem drainFrame_at (seen target reader markers payload cmpTemp cmpLeft cmpRight : Bits) (S : Fin 1 → Bits) (k : Fin 1) :
    drainFrame seen target reader markers payload cmpTemp cmpLeft cmpRight S none=S k := by fin_cases k; rfl

theorem drainFrame_update (seen target reader markers payload cmpTemp cmpLeft cmpRight : Bits) (S : Fin 1 → Bits) (k : Fin 1) (bits : Bits) :
    drainFrame seen target reader markers payload cmpTemp cmpLeft cmpRight (Function.update S k bits)=
      Function.update (drainFrame seen target reader markers payload cmpTemp cmpLeft cmpRight S) none bits := by
  funext j
  fin_cases k
  cases j <;> simp [drainFrame,store]

theorem find_call (values : List ℕ) (n : ℕ) (v : Local) :
    ∃ ticks last,
      Stacks.stackRun program ticks ⟨some (.find .start),v,store (NatListFind.stream values).reverse n.bits.reverse [] [] [] [] [] [] []⟩=
        some ⟨some .branch,putFind v last,store (NatListFind.stream values).reverse n.bits.reverse [] [] [] [] [] [] []⟩ ∧
      last.found=decide (n∈values) ∧
      Stacks.stackRunClock program ticks ⟨some (.find .start),v,store (NatListFind.stream values).reverse n.bits.reverse [] [] [] [] [] [] []⟩≤
        2000*(1+(NatListFind.stream values).length+n.bits.length)^3 := by
  obtain ⟨ticks,last,hr,hfound,hc⟩ := NatListFind.complete values n (getFind v)
  obtain ⟨hN,hNC⟩ := StackCall.execution some Label.find .branch getFind putFind
    (findFrame []) (findFrame_at []) (findFrame_update [])
    (fun _ _ => rfl) (fun _ _ _ => rfl) NatListFind.program program (fun _ => rfl) v ticks _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,putFind_get] at hN hNC
  exact ⟨ticks,last,hN,hfound,hNC.trans_le hc⟩

theorem copy_call (n : ℕ) (seen : Bits) (v : Local) :
    Stacks.stackRun program (2*n.bits.length+3) ⟨some (.copy .emit),v,store seen n.bits.reverse [] [] [] [] [] [] []⟩=
      some ⟨some (.emit .count),putIO v none,store seen n.bits.reverse n.bits [] [] [] [] [] []⟩ ∧
    Stacks.stackRunClock program (2*n.bits.length+3) ⟨some (.copy .emit),v,store seen n.bits.reverse [] [] [] [] [] [] []⟩≤25*(1+n.bits.length)^2 := by
  obtain ⟨hr,_⟩ := NatEmit.copy_complete n.bits.reverse [] (getIO v)
  have hc := NatEmit.copy_clock_bound n.bits.reverse [] (getIO v)
  simp only [List.append_nil,List.length_nil,Nat.add_zero,List.length_reverse,List.reverse_reverse] at hr hc
  obtain ⟨hN,hNC⟩ := StackCall.execution copyCode Label.copy (.emit .count) getIO putIO
    (copyFrame seen [] [] [] [] []) (copyFrame_at seen [] [] [] [] []) (copyFrame_update seen [] [] [] [] [])
    (fun _ _ => rfl) (fun _ _ _ => rfl) NatEmit.program program (fun _ => rfl) v (2*n.bits.length+3) _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,
    copyFrame,Parsing.triple_zero,Parsing.triple_one,Parsing.triple_two,putIO_get] at hN hNC
  exact ⟨hN,hNC.trans_le hc⟩

theorem emit_call (n : ℕ) (seen : Bits) (v : Local) :
    Stacks.stackRun program (4*n.bits.length+5) ⟨some (.emit .count),v,store seen n.bits.reverse n.bits [] [] [] [] [] []⟩=
      some ⟨some (.drain 0),putIO v none,store ((natBits n).reverse++seen) n.bits.reverse n.bits [] [] [] [] [] []⟩ ∧
    Stacks.stackRunClock program (4*n.bits.length+5) ⟨some (.emit .count),v,store seen n.bits.reverse n.bits [] [] [] [] [] []⟩≤100*(1+n.bits.length+seen.length)^2 := by
  obtain ⟨hr,_⟩ := NatEmit.complete n seen (getIO v)
  have hc := NatEmit.clock_bound n seen (getIO v)
  obtain ⟨hN,hNC⟩ := StackCall.execution emitCode Label.emit (.drain 0) getIO putIO
    (emitFrame n.bits.reverse [] [] [] [] []) (emitFrame_at n.bits.reverse [] [] [] [] []) (emitFrame_update n.bits.reverse [] [] [] [] [])
    (fun _ _ => rfl) (fun _ _ _ => rfl) NatEmit.program program (fun _ => rfl) v (4*n.bits.length+5) _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,
    emitFrame,Parsing.triple_zero,Parsing.triple_one,Parsing.triple_two,putIO_get] at hN hNC
  exact ⟨hN,hNC.trans_le hc⟩

theorem drain_call (n : ℕ) (seen : Bits) (v : Local) :
    Stacks.stackRun program (n.bits.length+1) ⟨some (.drain 0),v,store seen n.bits.reverse n.bits [] [] [] [] [] []⟩=
      some ⟨some .done,putIO v none,store seen n.bits.reverse [] [] [] [] [] [] []⟩ ∧
    Stacks.stackRunClock program (n.bits.length+1) ⟨some (.drain 0),v,store seen n.bits.reverse n.bits [] [] [] [] [] []⟩=
      n.bits.length^2+3*n.bits.length+3 := by
  have hr := Normalization.drain_run n.bits (getIO v)
  obtain ⟨hN,hNC⟩ := StackCall.execution (fun _ : Fin 1 => (none : Slot)) Label.drain .done getIO putIO
    (drainFrame seen n.bits.reverse [] [] [] [] [] []) (drainFrame_at seen n.bits.reverse [] [] [] [] [] []) (drainFrame_update seen n.bits.reverse [] [] [] [] [] [])
    (fun _ _ => rfl) (fun _ _ _ => rfl) Normalization.drainProgram program (fun _ => rfl) v (n.bits.length+1) _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,
    drainFrame,Normalization.singleStack_zero,putIO_get] at hN hNC
  exact ⟨hN,hNC.trans (Normalization.drain_clock n.bits (getIO v))⟩

def inserted (values : List ℕ) (n : ℕ) : List ℕ := if n∈values then values else values++[n]

theorem complete (values : List ℕ) (n : ℕ) (v : Local) :
    ∃ ticks last,
      Stacks.stackRun program ticks ⟨some (.find .start),v,store (NatListFind.stream values).reverse n.bits.reverse [] [] [] [] [] [] []⟩=
        some ⟨none,last,store (NatListFind.stream (inserted values n)).reverse n.bits.reverse [] [] [] [] [] [] []⟩ ∧
      last.1.found=decide (n∈values) ∧
      Stacks.stackRunClock program ticks ⟨some (.find .start),v,store (NatListFind.stream values).reverse n.bits.reverse [] [] [] [] [] [] []⟩≤
        5000*(1+(NatListFind.stream values).length+n.bits.length)^3 := by
  obtain ⟨findTicks,lastFind,hF,hfound,hFC⟩ := find_call values n v
  let v1 := putFind v lastFind
  let oldBits := (NatListFind.stream values).reverse
  let B := 1+(NatListFind.stream values).length+n.bits.length
  have hB : 1≤B := by dsimp [B]; omega
  have hB3 : 1≤B^3 := Nat.one_le_pow 3 _ hB
  have hBC : Stacks.stackRunClock program 1 ⟨some .branch,v1,store oldBits n.bits.reverse [] [] [] [] [] [] []⟩=1 := by
    simp [Stacks.stackRunClock,program,Stacks.stackClock]
  have eF : Stacks.Execution program _ _ (2000*B^3) := ⟨findTicks,hF,hFC⟩
  by_cases hmem : n∈values
  · have hv : v1.1.found=true := by simpa only [v1,putFind,hmem,decide_true] using hfound
    have hBranch : Stacks.stackRun program 1 ⟨some .branch,v1,store oldBits n.bits.reverse [] [] [] [] [] [] []⟩=
        some ⟨none,v1,store oldBits n.bits.reverse [] [] [] [] [] [] []⟩ := by
      simp [Stacks.run_one,TM2.step,program,TM2.stepAux,hv]
    have eB : Stacks.Execution program _ _ 1 := ⟨1,hBranch,hBC.le⟩
    obtain ⟨ticks,hr,hc⟩ := eF.trans eB
    refine ⟨ticks,v1,?_,hfound,hc.trans ?_⟩
    · simpa only [inserted,if_pos hmem] using hr
    · change 2000*B^3+1≤5000*B^3
      omega
  · have hv : v1.1.found=false := by simpa only [v1,putFind,hmem,decide_false] using hfound
    have hBranch : Stacks.stackRun program 1 ⟨some .branch,v1,store oldBits n.bits.reverse [] [] [] [] [] [] []⟩=
        some ⟨some (.copy .emit),v1,store oldBits n.bits.reverse [] [] [] [] [] [] []⟩ := by
      simp [Stacks.run_one,TM2.step,program,TM2.stepAux,hv]
    obtain ⟨hC,hCC⟩ := copy_call n oldBits v1
    obtain ⟨hE,hEC⟩ := emit_call n oldBits (putIO v1 none)
    obtain ⟨hD,hDC⟩ := drain_call n ((natBits n).reverse++oldBits) (putIO v1 none)
    have hH : Stacks.stackRun program 1 ⟨some .done,putIO v1 none,store ((natBits n).reverse++oldBits) n.bits.reverse [] [] [] [] [] [] []⟩=
        some ⟨none,putIO v1 none,store ((natBits n).reverse++oldBits) n.bits.reverse [] [] [] [] [] [] []⟩ := rfl
    have hHC :
        Stacks.stackRunClock program 1 ⟨some .done,putIO v1 none,store ((natBits n).reverse++oldBits) n.bits.reverse [] [] [] [] [] [] []⟩=1 := rfl
    have eB : Stacks.Execution program _ _ 1 := ⟨1,hBranch,hBC.le⟩
    have eC : Stacks.Execution program _ _ _ := ⟨2*n.bits.length+3,hC,hCC⟩
    have eE : Stacks.Execution program _ _ _ := ⟨4*n.bits.length+5,hE,hEC⟩
    have eD : Stacks.Execution program _ _ _ := ⟨n.bits.length+1,hD,hDC.le⟩
    have eH : Stacks.Execution program _ _ 1 := ⟨1,hH,hHC.le⟩
    obtain ⟨ticks,hr,hc⟩ := ((((eF.trans eB).trans eC).trans eE).trans eD).trans eH
    refine ⟨ticks,putIO v1 none,?_,hfound,hc.trans ?_⟩
    · simpa only
        [inserted,if_neg hmem,NatListFind.stream,List.flatMap_append,List.flatMap_cons,List.flatMap_nil,List.append_nil,List.reverse_append] using! hr
    · have hn : n.bits.length≤B := by dsimp [B]; omega
      have hn1 : 1+n.bits.length≤B := by dsimp [B]; omega
      have hn2 := Nat.pow_le_pow_left hn1 2
      have hne : 1+n.bits.length+oldBits.length=B := by
        dsimp [B,oldBits]; simp only [List.length_reverse]; omega
      have h23 : B^2≤B^3 := Nat.pow_le_pow_right (by omega) (by decide)
      have hB2 : B≤B^2 := Nat.le_pow (by decide)
      have hnn := Nat.mul_le_mul hn hn
      rw [hne]
      change 2000*B^3+1+25*(1+n.bits.length)^2+100*B^2+(n.bits.length^2+3*n.bits.length+3)+1≤5000*B^3
      nlinarith only [hn,hn2,hnn,hB,hB2,h23,hB3]

theorem inserted_nodup (values : List ℕ) (n : ℕ) (h : values.Nodup) : (inserted values n).Nodup := by
  by_cases hmem : n∈values
  · simpa only [inserted,if_pos hmem] using h
  · simpa only [inserted,if_neg hmem,List.nodup_append,List.nodup_singleton,List.mem_singleton,forall_eq,
      true_and] using And.intro h (show ∀ a∈values,a≠n by intro a ha he; exact hmem (he ▸ ha))

end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.NatSetInsert

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.GuardedCounter
open Turing Qatlib.Concepts.BitWordCompiler.CanonicalCodec
inductive Status where | zero | next | exhausted deriving DecidableEq,Fintype
abbrev Local := Status×Counter.Local×Symbol
inductive Label where | counter (l : Counter.Label) | branch | fuel deriving DecidableEq,Fintype
instance : Inhabited Label := ⟨.counter .borrow⟩
def getCounter (v : Local) : Counter.Local := v.2.1
def putCounter (v : Local) (value : Counter.Local) : Local := (v.1,value,v.2.2)

@[simp] theorem putCounter_get (v : Local) : putCounter v (getCounter v)=v := rfl

def program : Label → TM2.Stmt (fun _ : Fin 3 => Bool) Label Local
  | .counter l => StackCall.stmt Fin.castSucc Label.counter .branch getCounter putCounter (Counter.program l)
  | .branch => .branch (fun v => v.2.1.1) (.goto (fun _ => .fuel))
      (.load (fun v => (.zero,v.2)) .halt)
  | .fuel => .pop 2 (fun v bit => (v.1,v.2.1,bit))
      (.branch (fun v => v.2.2.isSome)
        (.load (fun v => (.next,v.2)) .halt) (.load (fun v => (.exhausted,v.2)) .halt))

def frame (fuel : Bits) (S : Fin 2 → Bits) : Fin 3 → Bits := Parsing.triple (S 0) (S 1) fuel

theorem frame_at (fuel : Bits) (S : Fin 2 → Bits) (k : Fin 2) : frame fuel S k.castSucc=S k := by
    fin_cases k <;> rfl

theorem frame_update (fuel : Bits) (S : Fin 2 → Bits) (k : Fin 2) (bits : Bits) :
    frame fuel (Function.update S k bits)=Function.update (frame fuel S) k.castSucc bits := by
  funext j
  fin_cases k <;> fin_cases j <;> simp [frame,Parsing.triple]

theorem zero (counter fuel : Bits) (v : Local) (hz : binaryValue counter=0) :
    ∃ ticks,
      Stacks.stackRun program ticks ⟨some (.counter .borrow),v,Parsing.triple counter [] fuel⟩=
        some ⟨none,(.zero,(false,none),v.2.2),Parsing.triple (List.replicate counter.length true) [] fuel⟩ ∧
      Stacks.stackRunClock program ticks ⟨some (.counter .borrow),v,Parsing.triple counter [] fuel⟩≤20*(1+counter.length+fuel.length)^2 := by
  obtain ⟨hr,hc⟩ := Counter.decrement_zero counter (getCounter v) hz
  obtain ⟨hN,hNC⟩ := StackCall.execution Fin.castSucc Label.counter .branch getCounter putCounter
    (frame fuel) (frame_at fuel) (frame_update fuel) (fun _ _ => rfl) (fun _ _ _ => rfl)
    Counter.program program (fun _ => rfl) v (2*counter.length+2) _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,
    frame,Stacks.stackPair_zero,Stacks.stackPair_one,putCounter_get] at hN hNC
  have hB : Stacks.stackRun program 1 ⟨some .branch,putCounter v (false,none),Parsing.triple (List.replicate counter.length true) [] fuel⟩=
      some ⟨none,(.zero,(false,none),v.2.2),Parsing.triple (List.replicate counter.length true) [] fuel⟩ := rfl
  have hBC :
      Stacks.stackRunClock program 1 ⟨some .branch,putCounter v (false,none),Parsing.triple (List.replicate counter.length true) [] fuel⟩=1 := rfl
  have eN : Stacks.Execution program _ _ _ := ⟨2*counter.length+2,hN,hNC.trans_le hc⟩
  have eB : Stacks.Execution program _ _ 1 := ⟨1,hB,hBC.le⟩
  obtain ⟨ticks,hR,hC⟩ := eN.trans eB
  refine ⟨ticks,hR,hC.trans ?_⟩
  let B := 1+counter.length+fuel.length
  have harg : 1+counter.length≤B := by dsimp [B]; omega
  have harg2 := Nat.pow_le_pow_left harg 2
  have hB : 1≤B^2 := Nat.one_le_pow 2 _ (by dsimp [B]; omega)
  change _≤20*B^2
  omega

theorem positive (counter fuel : Bits) (v : Local) (hp : 0<binaryValue counter) :
    ∃ ticks output,output.length=counter.length ∧ binaryValue output+1=binaryValue counter ∧
      Stacks.stackRun program ticks ⟨some (.counter .borrow),v,Parsing.triple counter [] fuel⟩=
        some ⟨none,(if fuel=[] then .exhausted else .next,(true,none),fuel.head?),Parsing.triple output [] fuel.tail⟩ ∧
      Stacks.stackRunClock program ticks ⟨some (.counter .borrow),v,Parsing.triple counter [] fuel⟩≤20*(1+counter.length+fuel.length)^2 := by
  obtain ⟨decTicks,output,_,hlen,hvalue,hr,hc⟩ :=
      Counter.decrement_positive counter (getCounter v) hp
  obtain ⟨hN,hNC⟩ := StackCall.execution Fin.castSucc Label.counter .branch getCounter putCounter
    (frame fuel) (frame_at fuel) (frame_update fuel) (fun _ _ => rfl) (fun _ _ _ => rfl)
    Counter.program program (fun _ => rfl) v decTicks _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,
    frame,Stacks.stackPair_zero,Stacks.stackPair_one,putCounter_get] at hN hNC
  have hB : Stacks.stackRun program 1 ⟨some .branch,putCounter v (true,none),Parsing.triple output [] fuel⟩=
      some ⟨some .fuel,putCounter v (true,none),Parsing.triple output [] fuel⟩ := rfl
  have hBC :
      Stacks.stackRunClock program 1 ⟨some .branch,putCounter v (true,none),Parsing.triple output [] fuel⟩=1 := rfl
  have hF : Stacks.stackRun program 1 ⟨some .fuel,putCounter v (true,none),Parsing.triple output [] fuel⟩=
      some ⟨none,(if fuel=[] then .exhausted else .next,(true,none),fuel.head?),Parsing.triple output [] fuel.tail⟩ := by
    cases fuel <;> simp [Stacks.run_one,TM2.step,program,TM2.stepAux,putCounter]
  have hFC : Stacks.stackRunClock program 1 ⟨some .fuel,putCounter v (true,none),Parsing.triple output [] fuel⟩=
      fuel.length+fuel.tail.length+3 := by
    simp [Stacks.stackRunClock,program,Stacks.stackClock]
    omega
  have eN : Stacks.Execution program _ _ _ := ⟨decTicks,hN,hNC.trans_le hc⟩
  have eB : Stacks.Execution program _ _ 1 := ⟨1,hB,hBC.le⟩
  have eF : Stacks.Execution program _ _ _ := ⟨1,hF,hFC.le⟩
  obtain ⟨ticks,hR,hC⟩ := (eN.trans eB).trans eF
  refine ⟨ticks,output,hlen,hvalue,hR,hC.trans ?_⟩
  let B := 1+counter.length+fuel.length
  have harg : 1+counter.length≤B := by dsimp [B]; omega
  have harg2 := Nat.pow_le_pow_left harg 2
  have hf : fuel.length≤B := by dsimp [B]; omega
  have hft : fuel.tail.length≤fuel.length := by simp only [List.length_tail]; omega
  have hB : 1≤B := by dsimp [B]; omega
  have hB2 : B≤B^2 := Nat.le_pow (by decide)
  change _≤20*B^2
  nlinarith only [harg2,hf,hft,hB,hB2]
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.GuardedCounter

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.ValidatorSemantics
open Qatlib.Concepts.BitWordCompiler.CanonicalCodec

def opFuel : Opcode → ℕ
  | .oracle _ _ _ wires => wires.length
  | _ => 0

def cost (ops : List Opcode) : ℕ := (ops.map (fun op => 1+opFuel op)).sum

def readOp (fuel width : ℕ) (input : Bits) : Option (Opcode×Bits×ℕ) := do
  let (op,tail) ← readOpcode input
  if legalOpcodeCheck width op && decide (opFuel op≤fuel) then
    pure (op,tail,fuel-opFuel op)
  else none

def readOps : ℕ → ℕ → ℕ → Bits → Option (List Opcode×Bits×ℕ)
  | fuel,0,_,input => some ([],input,fuel)
  | 0,_+1,_,_ => none
  | fuel+1,count+1,width,input => do
      let (op,tail,remaining) ← readOp fuel width input
      let (ops,rest,left) ← readOps remaining count width tail
      pure (op::ops,rest,left)

@[simp] theorem cost_nil : cost []=0 := rfl

@[simp] theorem cost_cons (op : Opcode) (ops : List Opcode) : cost (op::ops)=1+opFuel op+cost ops := rfl

theorem opFuel_fields (op : Opcode) : 1+opFuel op≤(fields op).length := by
  cases op <;> simp [opFuel,fields]
  omega

theorem cost_length (ops : List Opcode) : cost ops≤(ops.flatMap opBits).length := by
  induction ops with
  | nil => simp [cost]
  | cons op ops ih =>
    have hf := opFuel_fields op
    have hn := flatNatBits_length_ge (fields op)
    have he : opBits op=(fields op).flatMap natBits := rfl
    rw [cost_cons,List.flatMap_cons,List.length_append,he]
    omega

theorem cost_word (w : Word) : cost w.ops≤(wordBits w).length := by
  have hc := cost_length w.ops
  have he : wordBits w=natBits w.width++natBits w.ops.length++w.ops.flatMap opBits := by
    simp only [wordBits,List.flatMap_append,List.flatMap_cons,List.flatMap_nil,List.append_nil]
    rw [List.flatMap_assoc]
    rfl
  rw [he,List.length_append,List.length_append]
  omega

theorem readOp_complete (op : Opcode) (tail : Bits) (fuel width : ℕ)
    (hlegal : legalOpcode width op) (hfuel : opFuel op≤fuel) :
    readOp fuel width (opBits op++tail)=some (op,tail,fuel-opFuel op) := by
  simp [readOp,readOpcode_complete,(legalOpcodeCheck_spec width op).mpr hlegal,hfuel]

theorem readOps_complete (ops : List Opcode) (tail : Bits) (fuel width : ℕ)
    (hlegal : ∀ op∈ops,legalOpcode width op) (hfuel : cost ops≤fuel) :
    readOps fuel ops.length width (ops.flatMap opBits++tail)=some (ops,tail,fuel-cost ops) := by
  induction ops generalizing fuel with
  | nil => simp [readOps]
  | cons op ops ih =>
    have hop : legalOpcode width op := hlegal op (by simp)
    have hrest : ∀ p∈ops,legalOpcode width p := by intro p hp; exact hlegal p (by simp [hp])
    rw [cost_cons] at hfuel
    cases fuel with
    | zero => omega
    | succ fuel =>
      have hf : opFuel op≤fuel := by omega
      have ht : cost ops≤fuel-opFuel op := by omega
      simp only [List.length_cons,List.flatMap_cons,List.append_assoc,readOps]
      rw [readOp_complete op (ops.flatMap opBits++tail) fuel width hop hf]
      simp only [Option.bind_eq_bind,Option.bind_some]
      rw [ih (fuel-opFuel op) hrest ht]
      simp only [Option.bind_some,pure]
      congr 3
      rw [cost_cons]
      omega

theorem readOp_sound (fuel width : ℕ) (input : Bits) (op : Opcode) (tail : Bits) (left : ℕ)
    (h : readOp fuel width input=some (op,tail,left)) :
    legalOpcode width op ∧ input=opBits op++tail ∧ opFuel op+left=fuel := by
  unfold readOp at h
  cases hr : readOpcode input with
  | none => simp [hr] at h
  | some pair =>
    rcases pair with ⟨p,rest⟩
    simp only [hr,Option.bind_eq_bind,Option.bind_some] at h
    split_ifs at h with hc
    simp only [Bool.and_eq_true,decide_eq_true_eq] at hc
    simp only [pure,Option.some.injEq,Prod.mk.injEq] at h
    rcases h with ⟨rfl,rfl,rfl⟩
    refine ⟨(legalOpcodeCheck_spec width p).mp hc.1,readOpcode_sound input p rest hr,?_⟩
    omega

theorem readOps_sound (fuel count width : ℕ) (input : Bits) (ops : List Opcode) (rest : Bits) (left : ℕ)
    (h : readOps fuel count width input=some (ops,rest,left)) :
    ops.length=count ∧ (∀ op∈ops,legalOpcode width op) ∧
      input=ops.flatMap opBits++rest ∧ cost ops+left=fuel := by
  induction count generalizing fuel input ops rest left with
  | zero =>
    simp only [readOps,Option.some.injEq,Prod.mk.injEq] at h
    rcases h with ⟨rfl,rfl,rfl⟩
    simp
  | succ count ih =>
    cases fuel with
    | zero => simp [readOps] at h
    | succ fuel =>
      simp only [readOps] at h
      cases ho : readOp fuel width input with
      | none => simp [ho] at h
      | some triple =>
        rcases triple with ⟨p,tail,remaining⟩
        simp only [ho,Option.bind_eq_bind,Option.bind_some] at h
        cases ht : readOps remaining count width tail with
        | none => simp [ht] at h
        | some triple =>
          rcases triple with ⟨ps,last,remaining'⟩
          simp only [ht,Option.bind_some,pure,Option.some.injEq,Prod.mk.injEq] at h
          rcases h with ⟨rfl,rfl,rfl⟩
          obtain ⟨hp,hinput,hfuel⟩ := readOp_sound fuel width input p tail remaining ho
          obtain ⟨hlen,hlegal,htail,hleft⟩ := ih remaining tail ps last remaining' ht
          refine ⟨by simp [hlen],?_,?_,?_⟩
          · intro op hop
            rcases List.mem_cons.mp hop with rfl|hop
            · exact hp
            · exact hlegal op hop
          · rw [hinput,htail]
            simp only [List.flatMap_cons,List.append_assoc]
          · rw [cost_cons]
            omega

theorem wordBits_parts (w : Word) :
    wordBits w=natBits w.width++natBits w.ops.length++w.ops.flatMap opBits := by
  simp only [wordBits,List.flatMap_append,List.flatMap_cons,List.flatMap_nil,List.append_nil]
  rw [List.flatMap_assoc]
  rfl

def decodeAt (fuel : ℕ) (input : Bits) : Option Word := do
  let (width,afterWidth) ← readNat input
  let (count,opInput) ← readNat afterWidth
  let (ops,tail,_) ← readOps fuel count width opInput
  if tail=[] then pure ⟨width,ops⟩ else none

def decode (input : Bits) : Option Word := decodeAt input.length input

theorem decodeAt_complete (fuel : ℕ) (w : Word) (hlegal : Legal w) (hfuel : cost w.ops≤fuel) :
    decodeAt fuel (wordBits w)=some w := by
  rw [decodeAt,wordBits_parts,List.append_assoc]
  simp only [readNat_complete,Option.bind_eq_bind,Option.bind_some]
  have h := readOps_complete w.ops [] fuel w.width hlegal hfuel
  simp only [List.append_nil] at h
  rw [h]
  simp only [Option.bind_some,pure,if_true]

theorem decode_complete (w : Word) (hlegal : Legal w) : decode (wordBits w)=some w :=
  decodeAt_complete (wordBits w).length w hlegal (cost_word w)

theorem decodeAt_sound (fuel : ℕ) (input : Bits) (w : Word) (h : decodeAt fuel input=some w) :
    Legal w ∧ input=wordBits w := by
  unfold decodeAt at h
  cases hw : readNat input with
  | none => simp [hw] at h
  | some widthPair =>
    rcases widthPair with ⟨width,afterWidth⟩
    simp only [hw,Option.bind_eq_bind,Option.bind_some] at h
    cases hn : readNat afterWidth with
    | none => simp [hn] at h
    | some countPair =>
      rcases countPair with ⟨count,opInput⟩
      simp only [hn,Option.bind_some] at h
      cases hr : readOps fuel count width opInput with
      | none => simp [hr] at h
      | some triple =>
        rcases triple with ⟨ops,tail,left⟩
        simp only [hr,Option.bind_some] at h
        split_ifs at h with htail
        subst tail
        simp only [pure,Option.some.injEq] at h
        subst w
        obtain ⟨hlen,hlegal,hinput,_⟩ := readOps_sound fuel count width opInput ops [] left hr
        refine ⟨hlegal,?_⟩
        rw [readNat_sound input width afterWidth hw,readNat_sound afterWidth count opInput hn,hinput,wordBits_parts]
        simp only [List.append_nil,hlen,List.append_assoc]

theorem decode_sound (input : Bits) (w : Word) (h : decode input=some w) : Legal w ∧ input=wordBits w :=
  decodeAt_sound input.length input w h

theorem decode_eq (input : Bits) : decode input=decodeWord input := by
  cases hc : decode input with
  | none =>
    cases ho : decodeWord input with
    | none => rfl
    | some w =>
      obtain ⟨hlegal,hinput⟩ := (decodeWord_eq_some_iff input w).mp ho
      rw [hinput,decode_complete w hlegal] at hc
      contradiction
  | some w =>
    have hw := decode_sound input w hc
    exact ((decodeWord_eq_some_iff input w).mpr hw).symm
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.ValidatorSemantics

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.WordValidator
open Turing Qatlib.Concepts.BitWordCompiler.CanonicalCodec
inductive Work where | input | reader | original | fuel | width | opCount | wireCount | seen | field | tempCount | value | target | workReader | workMarkers | workPayload | workCmpTemp | workCmpLeft | workCmpRight deriving DecidableEq,Fintype
abbrev Slot := Option Work
structure Local where
  checked : CheckedNat.Local
  tagged : NatTag.Local
  guarded : GuardedCounter.Local
  compared : ReadonlyCompare.Local
  inserted : NatSetInsert.Local
  io : Symbol
  deriving DecidableEq
noncomputable instance : Fintype Local := Fintype.ofEquiv
    (CheckedNat.Local×NatTag.Local×GuardedCounter.Local×ReadonlyCompare.Local×NatSetInsert.Local×Symbol)
    { toFun := fun v => ⟨v.1,v.2.1,v.2.2.1,v.2.2.2.1,v.2.2.2.2.1,v.2.2.2.2.2⟩
      invFun := fun v => (v.checked,v.tagged,v.guarded,v.compared,v.inserted,v.io)
      left_inv := fun _ => rfl
      right_inv := fun v => by cases v; rfl }
instance : Inhabited Local :=
    ⟨⟨(false,none),(4,none),(.zero,(false,none),none),((.eq,none,none),none),(default,none),none⟩⟩

def getParse (v : Local) : CheckedNat.Local := v.checked
def putParse (v : Local) (value : CheckedNat.Local) : Local := {v with checked:=value}

@[simp] theorem putParse_get (v : Local) : putParse v (getParse v)=v := by cases v; rfl

def getTag (v : Local) : NatTag.Local := v.tagged
def putTag (v : Local) (value : NatTag.Local) : Local := {v with tagged:=value}

@[simp] theorem putTag_get (v : Local) : putTag v (getTag v)=v := by cases v; rfl

def getGuard (v : Local) : GuardedCounter.Local := v.guarded
def putGuard (v : Local) (value : GuardedCounter.Local) : Local := {v with guarded:=value}

@[simp] theorem putGuard_get (v : Local) : putGuard v (getGuard v)=v := by cases v; rfl

def getCompare (v : Local) : ReadonlyCompare.Local := v.compared
def putCompare (v : Local) (value : ReadonlyCompare.Local) : Local := {v with compared:=value}

@[simp] theorem putCompare_get (v : Local) : putCompare v (getCompare v)=v := by cases v; rfl

def getInsert (v : Local) : NatSetInsert.Local := v.inserted
def putInsert (v : Local) (value : NatSetInsert.Local) : Local := {v with inserted:=value}

@[simp] theorem putInsert_get (v : Local) : putInsert v (getInsert v)=v := by cases v; rfl

def getIO (v : Local) : Symbol := v.io
def putIO (v : Local) (value : Symbol) : Local := {v with io:=value}

@[simp] theorem putIO_get (v : Local) : putIO v (getIO v)=v := by cases v; rfl

inductive ReadDest where | width | field | target deriving DecidableEq,Fintype
inductive CompareFirst where | field | target deriving DecidableEq,Fintype
inductive Transfer where | fieldToOpCount | fieldToWireCount | fieldToValue | valueToTarget | originalToOutput deriving DecidableEq,Fintype
inductive Phase where | beginWidth | afterWidth | afterCount | root | rootResult | afterOpTag | dispatch | hAddress | hResult | hCompared | pFirst | pFirstResult | pFirstCompared | pSecond | pSecondResult | pSecondCompared | pPrecision | pPrecisionResult | pAdj | pAdjResult | pAdjCheck | sFirst | sFirstResult | sFirstCompared | sSecond | sSecondResult | sSecondCompared | qSlot | qSlotResult | qControl | qControlResult | qControlCompare | qControlInserted | qAdj | qAdjResult | qAdjCheck | qCount | qCountResult | qLoop | qLoopResult | qWireRead | qWireCompare | qWireIncrement | qWireIncremented | qWireInsert | qWireInserted | qFinish | checkEnd | success | failure | cleanupStart deriving DecidableEq,Fintype

inductive Label where
  | prepare (l : Fin 1)
  | read (dest : ReadDest) (ret : Phase) (l : CheckedNat.Label)
  | tag (ret : Phase) (l : NatTag.Label)
  | guard (wire : Bool) (ret : Phase) (l : GuardedCounter.Label)
  | compare (first : CompareFirst) (ret : Phase) (l : ReadonlyCompare.Label)
  | insert (ret : Phase) (l : NatSetInsert.Label)
  | transfer (job : Transfer) (ret : Phase) (l : Fin 1)
  | increment (ret : Phase) (l : Increment.Label)
  | drain (bank : Work) (ret : Phase) (l : Fin 1)
  | clear (bank : Work) (l : Fin 1)
  | step (phase : Phase)
  | halt
  deriving DecidableEq,Fintype
instance : Inhabited Label := ⟨.prepare 0⟩

def prepareCode : ValidatorInput.Slot → Slot
  | .input => some .input
  | .reader => some .reader
  | .original => some .original
  | .fuel => some .fuel

def readBank : ReadDest → Work
  | .width => .width
  | .field => .field
  | .target => .target

def readCode (dest : ReadDest) : Fin 3 → Slot
  | 0 => some .reader
  | 1 => some .tempCount
  | _ => some (readBank dest)

def guardCode (wire : Bool) : Fin 3 → Slot
  | 0 => some (if wire then .wireCount else .opCount)
  | 1 => some .tempCount
  | _ => some .fuel

def compareCode (first : CompareFirst) : ReadonlyCompare.Slot → Slot
  | .first => some (match first with | .field => .field | .target => .target)
  | .second => some .width
  | .temp => some .workCmpTemp
  | .left => some .workCmpLeft
  | .right => some .workCmpRight

def insertCode : NatSetInsert.Slot → Slot
  | none => some .value
  | some .seen => some .seen
  | some .target => some .target
  | some .reader => some .workReader
  | some .markers => some .workMarkers
  | some .payload => some .workPayload
  | some .cmpTemp => some .workCmpTemp
  | some .cmpLeft => some .workCmpLeft
  | some .cmpRight => some .workCmpRight

def transferBanks : Transfer → Slot×Slot
  | .fieldToOpCount => (some .field,some .opCount)
  | .fieldToWireCount => (some .field,some .wireCount)
  | .fieldToValue => (some .field,some .value)
  | .valueToTarget => (some .value,some .target)
  | .originalToOutput => (some .original,none)

def transferCode (job : Transfer) (k : Fin 2) : Slot :=
    if k=0 then (transferBanks job).1 else (transferBanks job).2

def incrementCode (k : Fin 2) : Slot := if k=0 then some .value else some .tempCount

def nextWork : Work → Option Work
  | .input => some .reader
  | .reader => some .original
  | .original => some .fuel
  | .fuel => some .width
  | .width => some .opCount
  | .opCount => some .wireCount
  | .wireCount => some .seen
  | .seen => some .field
  | .field => some .tempCount
  | .tempCount => some .value
  | .value => some .target
  | .target => some .workReader
  | .workReader => some .workMarkers
  | .workMarkers => some .workPayload
  | .workPayload => some .workCmpTemp
  | .workCmpTemp => some .workCmpLeft
  | .workCmpLeft => some .workCmpRight
  | .workCmpRight => none

def go (phase : Phase) : TM2.Stmt (fun _ : Slot => Bool) Label Local := .goto (fun _ => .step phase)
def parsed (after : Label) : TM2.Stmt (fun _ : Slot => Bool) Label Local :=
  .branch (fun v => v.checked.1) (.goto (fun _ => after)) (go .failure)
def less (after : Label) : TM2.Stmt (fun _ : Slot => Bool) Label Local :=
  .branch (fun v => decide (v.compared.1.1=.lt)) (.goto (fun _ => after)) (go .failure)
def boolTag : TM2.Stmt (fun _ : Slot => Bool) Label Local :=
  .branch (fun v => decide (v.tagged.1.val≤1)) (go .root) (go .failure)

def phaseProgram : Phase → TM2.Stmt (fun _ : Slot => Bool) Label Local
  | .beginWidth => .goto (fun _ => .read .width .afterWidth .unary)
  | .afterWidth => parsed (.read .field .afterCount .unary)
  | .afterCount => parsed (.transfer .fieldToOpCount .root 0)
  | .root => .goto (fun _ => .guard false .rootResult (.counter .borrow))
  | .rootResult => .branch (fun v => decide (v.guarded.1=.zero))
      (.goto (fun _ => .drain .opCount .checkEnd 0))
      (.branch (fun v => decide (v.guarded.1=.next)) (.goto (fun _ => .read .field .afterOpTag .unary)) (go .failure))
  | .afterOpTag => parsed (.tag .dispatch .first)
  | .dispatch => .branch (fun v => decide (v.tagged.1.val=0)) (go .hAddress)
      (.branch (fun v => decide (v.tagged.1.val=1)) (go .pFirst)
        (.branch (fun v => decide (v.tagged.1.val=2)) (go .sFirst)
          (.branch (fun v => decide (v.tagged.1.val=3)) (go .qSlot) (go .failure))))
  | .hAddress => .goto (fun _ => .read .field .hResult .unary)
  | .hResult => parsed (.compare .field .hCompared .start)
  | .hCompared => less (.drain .field .root 0)
  | .pFirst => .goto (fun _ => .read .field .pFirstResult .unary)
  | .pFirstResult => parsed (.compare .field .pFirstCompared .start)
  | .pFirstCompared => less (.drain .field .pSecond 0)
  | .pSecond => .goto (fun _ => .read .field .pSecondResult .unary)
  | .pSecondResult => parsed (.compare .field .pSecondCompared .start)
  | .pSecondCompared => less (.drain .field .pPrecision 0)
  | .pPrecision => .goto (fun _ => .read .field .pPrecisionResult .unary)
  | .pPrecisionResult => parsed (.drain .field .pAdj 0)
  | .pAdj => .goto (fun _ => .read .field .pAdjResult .unary)
  | .pAdjResult => parsed (.tag .pAdjCheck .first)
  | .pAdjCheck => boolTag
  | .sFirst => .goto (fun _ => .read .field .sFirstResult .unary)
  | .sFirstResult => parsed (.compare .field .sFirstCompared .start)
  | .sFirstCompared => less (.drain .field .sSecond 0)
  | .sSecond => .goto (fun _ => .read .field .sSecondResult .unary)
  | .sSecondResult => parsed (.compare .field .sSecondCompared .start)
  | .sSecondCompared => less (.drain .field .root 0)
  | .qSlot => .goto (fun _ => .read .field .qSlotResult .unary)
  | .qSlotResult => parsed (.drain .field .qControl 0)
  | .qControl => .goto (fun _ => .read .target .qControlResult .unary)
  | .qControlResult => parsed (.compare .target .qControlCompare .start)
  | .qControlCompare => .branch (fun v => decide (v.compared.1.1=.gt)) (go .failure)
      (.goto (fun _ => .insert .qControlInserted (.find .start)))
  | .qControlInserted => .branch (fun v => v.inserted.1.found) (go .failure) (.goto (fun _ => .drain .target .qAdj 0))
  | .qAdj => .goto (fun _ => .read .field .qAdjResult .unary)
  | .qAdjResult => parsed (.tag .qAdjCheck .first)
  | .qAdjCheck => .branch (fun v => decide (v.tagged.1.val≤1)) (go .qCount) (go .failure)
  | .qCount => .goto (fun _ => .read .field .qCountResult .unary)
  | .qCountResult => parsed (.transfer .fieldToWireCount .qLoop 0)
  | .qLoop => .goto (fun _ => .guard true .qLoopResult (.counter .borrow))
  | .qLoopResult => .branch (fun v => decide (v.guarded.1=.zero))
      (.goto (fun _ => .drain .wireCount .qFinish 0))
      (.branch (fun v => decide (v.guarded.1=.next)) (.goto (fun _ => .read .field .qWireRead .unary)) (go .failure))
  | .qWireRead => parsed (.compare .field .qWireCompare .start)
  | .qWireCompare => less (.transfer .fieldToValue .qWireIncrement 0)
  | .qWireIncrement => .goto (fun _ => .increment .qWireIncremented .carry)
  | .qWireIncremented => .goto (fun _ => .transfer .valueToTarget .qWireInsert 0)
  | .qWireInsert => .goto (fun _ => .insert .qWireInserted (.find .start))
  | .qWireInserted => .branch (fun v => v.inserted.1.found) (go .failure) (.goto (fun _ => .drain .target .qLoop 0))
  | .qFinish => .goto (fun _ => .drain .seen .root 0)
  | .checkEnd => .peek (some .reader) (fun v bit => {v with io:=bit})
      (.branch (fun v => v.io.isSome) (go .failure) (go .success))
  | .success => .push none (fun _ => true) (.goto (fun _ => .transfer .originalToOutput .cleanupStart 0))
  | .failure => .push none (fun _ => false) (.goto (fun _ => .clear .input 0))
  | .cleanupStart => .goto (fun _ => .clear .input 0)

def program : Label → TM2.Stmt (fun _ : Slot => Bool) Label Local
  | .prepare l => StackCall.stmt prepareCode Label.prepare (.step .beginWidth) getIO putIO (ValidatorInput.program l)
  | .read dest ret l => StackCall.stmt (readCode dest) (Label.read dest ret) (.step ret) getParse putParse (CheckedNat.program l)
  | .tag ret l => StackCall.stmt (fun _ : Fin 1 => some Work.field) (Label.tag ret) (.step ret) getTag putTag (NatTag.program l)
  | .guard wire ret l => StackCall.stmt (guardCode wire) (Label.guard wire ret) (.step ret) getGuard putGuard (GuardedCounter.program l)
  | .compare first ret l => StackCall.stmt (compareCode first) (Label.compare first ret) (.step ret) getCompare putCompare (ReadonlyCompare.program l)
  | .insert ret l => StackCall.stmt insertCode (Label.insert ret) (.step ret) getInsert putInsert (NatSetInsert.program l)
  | .transfer job ret l => StackCall.stmt (transferCode job) (Label.transfer job ret) (.step ret) getIO putIO (Stacks.transferProgram l)
  | .increment ret l => StackCall.stmt incrementCode (Label.increment ret) (.step ret) getIO putIO (Increment.program l)
  | .drain bank ret l => StackCall.stmt (fun _ : Fin 1 => some bank) (Label.drain bank ret) (.step ret) getIO putIO (Normalization.drainProgram l)
  | .clear bank l => StackCall.stmt (fun _ : Fin 1 => some bank) (Label.clear bank)
      (match nextWork bank with | none => .halt | some next => .clear next 0) getIO putIO (Normalization.drainProgram l)
  | .step phase => phaseProgram phase
  | .halt => .halt

theorem readCode_injective (dest : ReadDest) : Function.Injective (readCode dest) := by
  intro a b he
  fin_cases a <;> fin_cases b <;> cases dest <;> simp [readCode,readBank] at he ⊢

theorem read_all (dest : ReadDest) (ret : Phase) (S : Slot → Bits) (v : Local)
    (hmarker : S (some .tempCount)=[]) (hvalue : S (some (readBank dest))=[]) :
    ∃ ticks,
      Stacks.stackRun program ticks ⟨some (.read dest ret .unary),v,S⟩=
        some ⟨some (.step ret),putParse v (CheckedNat.haltedResult (S (some .reader)) []).var,
          StackCall.frame (readCode dest) S (CheckedNat.haltedResult (S (some .reader)) []).stk⟩ ∧
      Stacks.stackRunClock program ticks ⟨some (.read dest ret .unary),v,S⟩≤50*(1+(S (some .reader)).length)^2 := by
  obtain ⟨ticks,hr,hc⟩ := CheckedNat.complete (S (some .reader)) [] (getParse v)
  simp only [List.length_nil,Nat.add_zero] at hc
  have hinj := readCode_injective dest
  have hsame : StackCall.frame (readCode dest) S (Parsing.triple (S (some .reader)) [] [])=S := by
    apply StackCall.frame_same _ _ _ hinj
    intro k
    fin_cases k <;> simp [readCode,Parsing.triple,hmarker,hvalue]
  obtain ⟨hN,hNC⟩ := StackCall.execution (readCode dest) (Label.read dest ret) (.step ret) getParse putParse
    (StackCall.frame (readCode dest) S)
    (fun data k => StackCall.frame_at _ _ data hinj k)
    (fun data k bits => StackCall.frame_update _ _ data hinj k bits)
    (fun _ _ => rfl) (fun _ _ _ => rfl) CheckedNat.program program (fun _ => rfl) v ticks _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,CheckedNat.haltedResult,Option.map_none,Option.getD_none,
    putParse_get,hsame] at hN hNC
  exact ⟨ticks,hN,hNC.trans_le hc⟩

theorem read_valid (dest : ReadDest) (ret : Phase) (S : Slot → Bits) (v : Local) (n : ℕ) (tail : Bits)
    (hreader : S (some .reader)=natBits n++tail)
    (hmarker : S (some .tempCount)=[]) (hvalue : S (some (readBank dest))=[]) :
    ∃ ticks,
      Stacks.stackRun program ticks ⟨some (.read dest ret .unary),v,S⟩=
        some ⟨some (.step ret),putParse v (true,CheckedNat.lastField n.bits none),
          StackCall.frame (readCode dest) S (Parsing.triple tail [] n.bits.reverse)⟩ ∧
      Stacks.stackRunClock program ticks ⟨some (.read dest ret .unary),v,S⟩≤50*(1+(S (some .reader)).length)^2 := by
  obtain ⟨ticks,hr,hc⟩ := read_all dest ret S v hmarker hvalue
  rw [hreader,CheckedNat.halted_valid] at hr
  refine ⟨ticks,?_,hc⟩
  simpa only [List.append_nil] using hr

theorem transferCode_injective (job : Transfer) : Function.Injective (transferCode job) := by
  intro a b he
  cases job <;> fin_cases a <;> fin_cases b <;> simp [transferCode,transferBanks] at he ⊢

theorem transfer_all (job : Transfer) (ret : Phase) (S : Slot → Bits) (v : Local) :
    let input := S (transferBanks job).1
    let output := S (transferBanks job).2
    Stacks.stackRun program (input.length+1) ⟨some (.transfer job ret 0),v,S⟩=
      some ⟨some (.step ret),putIO v none,
        StackCall.frame (transferCode job) S (Stacks.stackPair [] (input.reverse++output))⟩ ∧
    Stacks.stackRunClock program (input.length+1) ⟨some (.transfer job ret 0),v,S⟩=
      input.length*(2*(input.length+output.length)+5)+3 := by
  let input := S (transferBanks job).1
  let output := S (transferBanks job).2
  have hinj := transferCode_injective job
  have hsame : StackCall.frame (transferCode job) S (Stacks.stackPair input output)=S := by
    apply StackCall.frame_same _ _ _ hinj
    intro k
    fin_cases k <;> simp [transferCode,input,output]
  have hr := Stacks.transfer_run input output (getIO v)
  have hc := Stacks.transfer_clock input output (getIO v)
  obtain ⟨hN,hNC⟩ := StackCall.execution (transferCode job) (Label.transfer job ret) (.step ret) getIO putIO
    (StackCall.frame (transferCode job) S)
    (fun data k => StackCall.frame_at _ _ data hinj k)
    (fun data k bits => StackCall.frame_update _ _ data hinj k bits)
    (fun _ _ => rfl) (fun _ _ _ => rfl) Stacks.transferProgram program (fun _ => rfl) v (input.length+1) _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,putIO_get,hsame] at hN hNC
  exact ⟨hN,hNC.trans hc⟩

theorem guardCode_injective (wire : Bool) : Function.Injective (guardCode wire) := by
  intro a b he
  cases wire <;> fin_cases a <;> fin_cases b <;> simp [guardCode] at he ⊢

theorem guard_zero (wire : Bool) (ret : Phase) (S : Slot → Bits) (v : Local)
    (hmarker : S (some .tempCount)=[]) (hz : binaryValue (S (some (if wire then .wireCount else .opCount)))=0) :
    let counter := S (some (if wire then .wireCount else .opCount))
    let fuel := S (some .fuel)
    ∃ ticks,
      Stacks.stackRun program ticks ⟨some (.guard wire ret (.counter .borrow)),v,S⟩=
        some ⟨some (.step ret),putGuard v (.zero,(false,none),v.guarded.2.2),
          StackCall.frame (guardCode wire) S (Parsing.triple (List.replicate counter.length true) [] fuel)⟩ ∧
      Stacks.stackRunClock program ticks ⟨some (.guard wire ret (.counter .borrow)),v,S⟩≤20*(1+counter.length+fuel.length)^2 := by
  let counter := S (some (if wire then .wireCount else .opCount))
  let fuel := S (some .fuel)
  have hinj := guardCode_injective wire
  have hsame : StackCall.frame (guardCode wire) S (Parsing.triple counter [] fuel)=S := by
    apply StackCall.frame_same _ _ _ hinj
    intro k
    fin_cases k <;> simp [guardCode,Parsing.triple,counter,fuel,hmarker]
  obtain ⟨ticks,hr,hc⟩ := GuardedCounter.zero counter fuel (getGuard v) hz
  obtain ⟨hN,hNC⟩ := StackCall.execution (guardCode wire) (Label.guard wire ret) (.step ret) getGuard putGuard
    (StackCall.frame (guardCode wire) S)
    (fun data k => StackCall.frame_at _ _ data hinj k)
    (fun data k bits => StackCall.frame_update _ _ data hinj k bits)
    (fun _ _ => rfl) (fun _ _ _ => rfl) GuardedCounter.program program (fun _ => rfl) v ticks _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,putGuard_get,hsame] at hN hNC
  exact ⟨ticks,hN,hNC.trans_le hc⟩

theorem guard_positive (wire : Bool) (ret : Phase) (S : Slot → Bits) (v : Local)
    (hmarker : S (some .tempCount)=[]) (hp : 0<binaryValue (S (some (if wire then .wireCount else .opCount)))) :
    let counter := S (some (if wire then .wireCount else .opCount))
    let fuel := S (some .fuel)
    ∃ ticks output,output.length=counter.length ∧ binaryValue output+1=binaryValue counter ∧
      Stacks.stackRun program ticks ⟨some (.guard wire ret (.counter .borrow)),v,S⟩=
        some ⟨some (.step ret),putGuard v (if fuel=[] then .exhausted else .next,(true,none),fuel.head?),
          StackCall.frame (guardCode wire) S (Parsing.triple output [] fuel.tail)⟩ ∧
      Stacks.stackRunClock program ticks ⟨some (.guard wire ret (.counter .borrow)),v,S⟩≤20*(1+counter.length+fuel.length)^2 := by
  let counter := S (some (if wire then .wireCount else .opCount))
  let fuel := S (some .fuel)
  have hinj := guardCode_injective wire
  have hsame : StackCall.frame (guardCode wire) S (Parsing.triple counter [] fuel)=S := by
    apply StackCall.frame_same _ _ _ hinj
    intro k
    fin_cases k <;> simp [guardCode,Parsing.triple,counter,fuel,hmarker]
  obtain ⟨ticks,output,hlen,hvalue,hr,hc⟩ := GuardedCounter.positive counter fuel (getGuard v) hp
  obtain ⟨hN,hNC⟩ := StackCall.execution (guardCode wire) (Label.guard wire ret) (.step ret) getGuard putGuard
    (StackCall.frame (guardCode wire) S)
    (fun data k => StackCall.frame_at _ _ data hinj k)
    (fun data k bits => StackCall.frame_update _ _ data hinj k bits)
    (fun _ _ => rfl) (fun _ _ _ => rfl) GuardedCounter.program program (fun _ => rfl) v ticks _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,putGuard_get,hsame] at hN hNC
  exact ⟨ticks,output,hlen,hvalue,hN,hNC.trans_le hc⟩

theorem compareCode_injective (first : CompareFirst) : Function.Injective (compareCode first) := by
  intro a b he
  cases first <;> cases a <;> cases b <;> simp [compareCode] at he ⊢

theorem compare_all (first : CompareFirst) (ret : Phase) (S : Slot → Bits) (v : Local)
    (htemp : S (some .workCmpTemp)=[]) (hleft : S (some .workCmpLeft)=[]) (hright : S (some .workCmpRight)=[]) :
    let field := S (some (match first with | .field => .field | .target => .target))
    let width := S (some .width)
    ∃ ticks,
      Stacks.stackRun program ticks ⟨some (.compare first ret .start),v,S⟩=
        some ⟨some (.step ret),putCompare v ((ReadonlyCompare.order field width,none,none),none),S⟩ ∧
      Stacks.stackRunClock program ticks ⟨some (.compare first ret .start),v,S⟩≤100*(1+field.length+width.length)^2 := by
  let field := S (some (match first with | .field => .field | .target => .target))
  let width := S (some .width)
  have hinj := compareCode_injective first
  have hsame : StackCall.frame (compareCode first) S (ReadonlyCompare.store field width [] [] [])=S := by
    apply StackCall.frame_same _ _ _ hinj
    intro k
    cases k <;> simp [compareCode,ReadonlyCompare.store,field,width,htemp,hleft,hright]
  obtain ⟨ticks,hr,hc⟩ := ReadonlyCompare.complete field width (getCompare v)
  obtain ⟨hN,hNC⟩ := StackCall.execution (compareCode first) (Label.compare first ret) (.step ret) getCompare putCompare
    (StackCall.frame (compareCode first) S)
    (fun data k => StackCall.frame_at _ _ data hinj k)
    (fun data k bits => StackCall.frame_update _ _ data hinj k bits)
    (fun _ _ => rfl) (fun _ _ _ => rfl) ReadonlyCompare.program program (fun _ => rfl) v ticks _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,putCompare_get,hsame] at hN hNC
  exact ⟨ticks,hN,hNC.trans_le hc⟩

theorem incrementCode_injective : Function.Injective incrementCode := by
  intro a b he
  fin_cases a <;> fin_cases b <;> simp [incrementCode] at he ⊢

theorem increment_valid (ret : Phase) (S : Slot → Bits) (v : Local) (n : ℕ)
    (hinput : S (some .value)=n.bits) (hmarker : S (some .tempCount)=[]) :
    ∃ ticks,
      Stacks.stackRun program ticks ⟨some (.increment ret .carry),v,S⟩=
        some ⟨some (.step ret),putIO v none,StackCall.frame incrementCode S (Stacks.stackPair (n+1).bits [])⟩ ∧
      Stacks.stackRunClock program ticks ⟨some (.increment ret .carry),v,S⟩≤50*(1+n.bits.length)^2 := by
  have hinj := incrementCode_injective
  have hsame : StackCall.frame incrementCode S (Stacks.stackPair n.bits [])=S := by
    apply StackCall.frame_same _ _ _ hinj
    intro k
    fin_cases k <;> simp [incrementCode,hinput,hmarker]
  obtain ⟨ticks,_,hr,hc⟩ := Increment.complete n.bits [] (getIO v)
  simp only [List.reverse_nil,List.nil_append,Increment.word_bits,List.length_nil,Nat.add_zero] at hr hc
  obtain ⟨hN,hNC⟩ := StackCall.execution incrementCode (Label.increment ret) (.step ret) getIO putIO
    (StackCall.frame incrementCode S)
    (fun data k => StackCall.frame_at _ _ data hinj k)
    (fun data k bits => StackCall.frame_update _ _ data hinj k bits)
    (fun _ _ => rfl) (fun _ _ _ => rfl) Increment.program program (fun _ => rfl) v ticks _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,putIO_get,hsame] at hN hNC
  exact ⟨ticks,hN,hNC.trans_le hc⟩

theorem drain_call (code : Fin 1 → Label) (returnTo : Label) (bank : Work)
    (hcode : ∀ l,program (code l)=StackCall.stmt (fun _ : Fin 1 => some bank) code returnTo getIO putIO (Normalization.drainProgram l))
    (S : Slot → Bits) (v : Local) :
    Stacks.stackRun program ((S (some bank)).length+1) ⟨some (code 0),v,S⟩=
      some ⟨some returnTo,putIO v none,Function.update S (some bank) []⟩ ∧
    Stacks.stackRunClock program ((S (some bank)).length+1) ⟨some (code 0),v,S⟩=
      (S (some bank)).length^2+3*(S (some bank)).length+3 := by
  let index : Fin 1 → Slot := fun _ => some bank
  have hinj : Function.Injective index := fun _ _ _ => Subsingleton.elim _ _
  have hsame : StackCall.frame index S (Normalization.singleStack (S (some bank)))=S := by
    apply StackCall.frame_same _ _ _ hinj
    intro k
    rfl
  have hfinal : StackCall.frame index S (Normalization.singleStack [])=Function.update S (some bank) [] := by
    have hu := StackCall.frame_update index S (Normalization.singleStack (S (some bank))) hinj 0 []
    simpa only [Normalization.singleStack_update,hsame] using hu
  have hr := Normalization.drain_run (S (some bank)) (getIO v)
  obtain ⟨hN,hNC⟩ := StackCall.execution index code returnTo getIO putIO (StackCall.frame index S)
    (fun data k => StackCall.frame_at _ _ data hinj k)
    (fun data k bits => StackCall.frame_update _ _ data hinj k bits)
    (fun _ _ => rfl) (fun _ _ _ => rfl) Normalization.drainProgram program hcode v ((S (some bank)).length+1) _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,putIO_get,hsame,hfinal] at hN hNC
  exact ⟨hN,hNC.trans (Normalization.drain_clock (S (some bank)) (getIO v))⟩

def clearStart : List Work → Label
  | [] => .halt
  | bank::_ => .clear bank 0

def clearVar (v : Local) (banks : List Work) : Local := if banks=[] then v else putIO v none

def cleared : (Slot → Bits) → List Work → (Slot → Bits)
  | S,[] => S
  | S,bank::banks => cleared (Function.update S (some bank) []) banks

def clearCost : (Slot → Bits) → List Work → ℕ
  | _,[] => 1
  | S,bank::banks => (S (some bank)).length^2+3*(S (some bank)).length+3+
      clearCost (Function.update S (some bank) []) banks

def clearRoute : List Work → Prop
  | [] => True
  | bank::banks => nextWork bank=banks.head? ∧ clearRoute banks

theorem clearVar_after (v : Local) (banks : List Work) : clearVar (putIO v none) banks=putIO v none := by
  cases banks <;> rfl

theorem clear_list (banks : List Work) (hroute : clearRoute banks) (S : Slot → Bits) (v : Local) :
    ∃ ticks,
      Stacks.stackRun program ticks ⟨some (clearStart banks),v,S⟩=
        some ⟨none,clearVar v banks,cleared S banks⟩ ∧
      Stacks.stackRunClock program ticks ⟨some (clearStart banks),v,S⟩≤clearCost S banks := by
  induction banks generalizing S v with
  | nil => exact ⟨1,rfl,le_rfl⟩
  | cons bank banks ih =>
    obtain ⟨hnext,hrest⟩ := hroute
    have hcode : ∀ l,program (.clear bank l)=StackCall.stmt (fun _ : Fin 1 => some bank) (Label.clear bank)
        (clearStart banks) getIO putIO (Normalization.drainProgram l) := by
      intro l
      rw [program,hnext]
      cases banks <;> rfl
    obtain ⟨hD,hDC⟩ := drain_call (Label.clear bank) (clearStart banks) bank hcode S v
    obtain ⟨tailTicks,hR,hRC⟩ := ih hrest (Function.update S (some bank) []) (putIO v none)
    have eD : Stacks.Execution program _ _ _ := ⟨(S (some bank)).length+1,hD,hDC.le⟩
    have eR : Stacks.Execution program _ _ _ := ⟨tailTicks,hR,hRC⟩
    obtain ⟨ticks,hr,hc⟩ := eD.trans eR
    refine ⟨ticks,?_,hc⟩
    simpa only [clearVar_after] using! hr

def workList : List Work := [.input,.reader,.original,.fuel,.width,.opCount,.wireCount,.seen,.field,.tempCount,
  .value,.target,.workReader,.workMarkers,.workPayload,.workCmpTemp,.workCmpLeft,.workCmpRight]

theorem workList_route : clearRoute workList := by simp [clearRoute,workList,nextWork]

theorem cleared_workList (S : Slot → Bits) : cleared S workList=Function.update (fun _ => []) none (S none) := by
  funext k
  cases k with
  | none => simp [cleared,workList]
  | some bank => cases bank <;> simp [cleared,workList]

theorem clearCost_bound (banks : List Work) (S : Slot → Bits) (height : ℕ)
    (hS : ∀ bank,(S (some bank)).length≤height) :
    clearCost S banks≤(banks.length+1)*(height^2+3*height+4) := by
  induction banks generalizing S with
  | nil => simp [clearCost]
  | cons bank banks ih =>
    have hnew : ∀ k,((Function.update S (some bank) []) (some k)).length≤height := by
      intro k
      by_cases he : k=bank
      · subst k
        simp
      · rw [Function.update_of_ne (fun h => he (Option.some.inj h))]
        exact hS k
    have ht := ih (Function.update S (some bank) []) hnew
    have hb := hS bank
    have hb2 := Nat.mul_le_mul hb hb
    simp only [clearCost,List.length_cons]
    nlinarith

theorem cleanup (S : Slot → Bits) (v : Local) (height : ℕ) (hS : ∀ bank,(S (some bank)).length≤height) :
    ∃ ticks,
      Stacks.stackRun program ticks ⟨some (.clear .input 0),v,S⟩=
        some ⟨none,putIO v none,Function.update (fun _ => []) none (S none)⟩ ∧
      Stacks.stackRunClock program ticks ⟨some (.clear .input 0),v,S⟩≤200*(1+height)^2 := by
  obtain ⟨ticks,hr,hc⟩ := clear_list workList workList_route S v
  refine ⟨ticks,?_,hc.trans ?_⟩
  · rw [cleared_workList] at hr
    exact hr
  · have hb := clearCost_bound workList S height hS
    change clearCost S workList≤200*(1+height)^2
    have hlen : workList.length=18 := rfl
    rw [hlen] at hb
    nlinarith only [hb,Nat.zero_le (height^2),Nat.zero_le height]

theorem insertCode_injective : Function.Injective insertCode := by
  intro a b he
  cases a with
  | none =>
    cases b with
    | none => rfl
    | some b => cases b <;> simp [insertCode] at he
  | some a =>
    cases b with
    | none => cases a <;> simp [insertCode] at he
    | some b => cases a <;> cases b <;> simp [insertCode] at he ⊢

theorem insert_valid (ret : Phase) (S : Slot → Bits) (v : Local) (values : List ℕ) (n : ℕ)
    (hdata : ∀ k,S (insertCode k)=NatSetInsert.store (NatListFind.stream values).reverse n.bits.reverse [] [] [] [] [] [] [] k) :
    ∃ ticks last,
      Stacks.stackRun program ticks ⟨some (.insert ret (.find .start)),v,S⟩=
        some ⟨some (.step ret),putInsert v last,
          StackCall.frame insertCode S (NatSetInsert.store (NatListFind.stream (NatSetInsert.inserted values n)).reverse n.bits.reverse [] [] [] [] [] [] [])⟩ ∧
      last.1.found=decide (n∈values) ∧
      Stacks.stackRunClock program ticks ⟨some (.insert ret (.find .start)),v,S⟩≤
        5000*(1+(NatListFind.stream values).length+n.bits.length)^3 := by
  have hinj := insertCode_injective
  have hsame := StackCall.frame_same insertCode S _ hinj hdata
  obtain ⟨ticks,last,hr,hfound,hc⟩ := NatSetInsert.complete values n (getInsert v)
  obtain ⟨hN,hNC⟩ := StackCall.execution insertCode (Label.insert ret) (.step ret) getInsert putInsert
    (StackCall.frame insertCode S)
    (fun data k => StackCall.frame_at _ _ data hinj k)
    (fun data k bits => StackCall.frame_update _ _ data hinj k bits)
    (fun _ _ => rfl) (fun _ _ _ => rfl) NatSetInsert.program program (fun _ => rfl) v ticks _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,putInsert_get,hsame] at hN hNC
  exact ⟨ticks,last,hN,hfound,hNC.trans_le hc⟩

theorem tag_all (ret : Phase) (S : Slot → Bits) (v : Local) :
    Stacks.stackRun program (NatTag.ticks (S (some .field))) ⟨some (.tag ret .first),v,S⟩=
      some ⟨some (.step ret),putTag v (NatTag.final (S (some .field))).var,
        StackCall.frame (fun _ : Fin 1 => some Work.field) S (NatTag.final (S (some .field))).stk⟩ ∧
    Stacks.stackRunClock program (NatTag.ticks (S (some .field))) ⟨some (.tag ret .first),v,S⟩≤20*(1+(S (some .field)).length)^2 := by
  let code : Fin 1 → Slot := fun _ => some .field
  have hinj : Function.Injective code := fun _ _ _ => Subsingleton.elim _ _
  have hsame : StackCall.frame code S (Normalization.singleStack (S (some .field)))=S := by
    apply StackCall.frame_same _ _ _ hinj
    intro k
    rfl
  obtain ⟨hr,hc⟩ := NatTag.complete (S (some .field)) (getTag v)
  obtain ⟨hN,hNC⟩ := StackCall.execution code (Label.tag ret) (.step ret) getTag putTag
    (StackCall.frame code S)
    (fun data k => StackCall.frame_at _ _ data hinj k)
    (fun data k bits => StackCall.frame_update _ _ data hinj k bits)
    (fun _ _ => rfl) (fun _ _ _ => rfl) NatTag.program program (fun _ => rfl) v (NatTag.ticks (S (some .field))) _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,NatTag.final,Option.map_none,Option.getD_none,putTag_get,hsame] at hN hNC
  exact ⟨hN,hNC.trans_le hc⟩

theorem prepareCode_injective : Function.Injective prepareCode := by
  intro a b he
  cases a <;> cases b <;> simp [prepareCode] at he ⊢

theorem prepare_all (input : Bits) (S : Slot → Bits) (v : Local)
    (hdata : ∀ k,S (prepareCode k)=ValidatorInput.store input.reverse [] [] [] k) :
    Stacks.stackRun program (input.length+1) ⟨some (.prepare 0),v,S⟩=
      some ⟨some (.step .beginWidth),putIO v none,
        StackCall.frame prepareCode S (ValidatorInput.store [] input input (List.replicate input.length true))⟩ ∧
    Stacks.stackRunClock program (input.length+1) ⟨some (.prepare 0),v,S⟩=
      input.length*(4*input.length+9)+3 := by
  have hinj := prepareCode_injective
  have hsame := StackCall.frame_same prepareCode S _ hinj hdata
  have hr := ValidatorInput.complete input.reverse [] [] [] (getIO v)
  have hc := ValidatorInput.clock input.reverse [] [] [] (getIO v)
  simp only [List.length_reverse,List.reverse_reverse,List.append_nil,List.length_nil,Nat.add_zero] at hr hc
  obtain ⟨hN,hNC⟩ := StackCall.execution prepareCode Label.prepare (.step .beginWidth) getIO putIO
    (StackCall.frame prepareCode S)
    (fun data k => StackCall.frame_at _ _ data hinj k)
    (fun data k bits => StackCall.frame_update _ _ data hinj k bits)
    (fun _ _ => rfl) (fun _ _ _ => rfl) ValidatorInput.program program (fun _ => rfl) v (input.length+1) _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,putIO_get,hsame] at hN hNC
  exact ⟨hN,hNC.trans hc⟩

theorem phase_step (phase : Phase) (S : Slot → Bits) (v : Local) :
    Stacks.stackRun program 1 ⟨some (.step phase),v,S⟩=some (TM2.stepAux (phaseProgram phase) v S) := by
  rw [Stacks.run_one]
  rfl

theorem phase_clock (phase : Phase) (S : Slot → Bits) (v : Local) :
    Stacks.stackRunClock program 1 ⟨some (.step phase),v,S⟩≤
      2*(S (some .reader)).length+2*(S none).length+5 := by
  cases phase <;> simp
      [Stacks.stackRunClock,program,phaseProgram,go,parsed,less,boolTag,Stacks.stackClock]
  all_goals omega

theorem frame_outside {K J : Type} [DecidableEq K] [DecidableEq J]
    (code : K → J) (S : J → Bits) (data : K → Bits) (j : J) (hj : ∀ k,code k≠j) :
    StackCall.frame code S data j=S j := by
  classical
  have hn : ¬∃ k,code k=j := by rintro ⟨k,hk⟩; exact hj k hk
  simp only [StackCall.frame,dif_neg hn]

theorem failure_output (S : Slot → Bits) (v : Local) (height : ℕ)
    (houtput : S none=[]) (hS : ∀ bank,(S (some bank)).length≤height) :
    ∃ ticks,
      Stacks.stackRun program ticks ⟨some (.step .failure),v,S⟩=
        some ⟨none,putIO v none,Function.update (fun _ => []) none [false]⟩ ∧
      Stacks.stackRunClock program ticks ⟨some (.step .failure),v,S⟩≤210*(1+height)^2 := by
  let S1 := Function.update S none [false]
  have hF : Stacks.stackRun program 1 ⟨some (.step .failure),v,S⟩=some ⟨some (.clear .input 0),v,S1⟩ := by
    rw [phase_step]
    simp only [phaseProgram,TM2.stepAux,houtput]
    rfl
  have hFC : Stacks.stackRunClock program 1 ⟨some (.step .failure),v,S⟩=4 := by
    simp [Stacks.stackRunClock,program,phaseProgram,Stacks.stackClock,houtput]
  have hS1 : ∀ bank,(S1 (some bank)).length≤height := by
    intro bank
    simpa only [S1,Function.update_of_ne (Option.some_ne_none _)] using hS bank
  obtain ⟨clearTicks,hC,hCC⟩ := cleanup S1 v height hS1
  have eF : Stacks.Execution program _ _ 4 := ⟨1,hF,hFC.le⟩
  have eC : Stacks.Execution program _ _ _ := ⟨clearTicks,hC,hCC⟩
  obtain ⟨ticks,hr,hc⟩ := eF.trans eC
  refine ⟨ticks,?_,hc.trans ?_⟩
  · simpa only [S1,Function.update_self] using hr
  · have hp : 1≤(1+height)^2 := Nat.one_le_pow 2 _ (by omega)
    omega

theorem success_output (input : Bits) (S : Slot → Bits) (v : Local) (height : ℕ)
    (houtput : S none=[]) (horiginal : S (some .original)=input)
    (hS : ∀ bank,(S (some bank)).length≤height) :
    ∃ ticks,
      Stacks.stackRun program ticks ⟨some (.step .success),v,S⟩=
        some ⟨none,putIO v none,Function.update (fun _ => []) none (true::input).reverse⟩ ∧
      Stacks.stackRunClock program ticks ⟨some (.step .success),v,S⟩≤300*(1+height)^2 := by
  let S1 := Function.update S none [true]
  let code := transferCode .originalToOutput
  let S2 := StackCall.frame code S1 (Stacks.stackPair [] (input.reverse++[true]))
  let v1 := putIO v none
  have hF : Stacks.stackRun program 1 ⟨some (.step .success),v,S⟩=
      some ⟨some (.transfer .originalToOutput .cleanupStart 0),v,S1⟩ := by
    rw [phase_step]
    simp only [phaseProgram,TM2.stepAux,houtput]
    rfl
  have hFC : Stacks.stackRunClock program 1 ⟨some (.step .success),v,S⟩=4 := by
    simp [Stacks.stackRunClock,program,phaseProgram,Stacks.stackClock,houtput]
  obtain ⟨hT,hTC⟩ := transfer_all .originalToOutput .cleanupStart S1 v
  have hIn : S1 (transferBanks .originalToOutput).1=input := by
    simpa only [S1,transferBanks,Function.update_of_ne (Option.some_ne_none _)] using horiginal
  have hOut : S1 (transferBanks .originalToOutput).2=[true] := by simp [S1,transferBanks]
  simp only [hIn,hOut,List.length_cons,List.length_nil] at hT hTC
  have hinj := transferCode_injective .originalToOutput
  have hS2 : ∀ bank,(S2 (some bank)).length≤height := by
    intro bank
    by_cases he : bank=.original
    · subst bank
      have hz := StackCall.frame_at code S1 (Stacks.stackPair [] (input.reverse++[true])) hinj 0
      change S2 (some .original)=[] at hz
      rw [hz]
      exact Nat.zero_le _
    · have hne : ∀ k,code k≠some bank := by
        intro k
        fin_cases k <;> simp [code,transferCode,transferBanks,Ne.symm he]
      rw [show S2 (some bank)=S1 (some bank) from frame_outside code S1 _ _ hne]
      simpa only [S1,Function.update_of_ne (Option.some_ne_none _)] using hS bank
  have hS2out : S2 none=input.reverse++[true] := by
    have hh := StackCall.frame_at code S1 (Stacks.stackPair [] (input.reverse++[true])) hinj 1
    exact hh
  have hB : Stacks.stackRun program 1 ⟨some (.step .cleanupStart),v1,S2⟩=
      some ⟨some (.clear .input 0),v1,S2⟩ := rfl
  have hBC : Stacks.stackRunClock program 1 ⟨some (.step .cleanupStart),v1,S2⟩=1 := rfl
  obtain ⟨clearTicks,hC,hCC⟩ := cleanup S2 v1 height hS2
  have eF : Stacks.Execution program _ _ 4 := ⟨1,hF,hFC.le⟩
  have eT : Stacks.Execution program _ _ _ := ⟨input.length+1,hT,hTC.le⟩
  have eB : Stacks.Execution program _ _ 1 := ⟨1,hB,hBC.le⟩
  have eC : Stacks.Execution program _ _ _ := ⟨clearTicks,hC,hCC⟩
  obtain ⟨ticks,hr,hc⟩ := ((eF.trans eT).trans eB).trans eC
  refine ⟨ticks,?_,hc.trans ?_⟩
  · simpa only [hS2out,List.reverse_cons] using! hr
  · have hi := hS .original
    rw [horiginal] at hi
    have hi2 := Nat.mul_le_mul hi hi
    have hp : 1≤(1+height)^2 := Nat.one_le_pow 2 _ (by omega)
    nlinarith only [hi,hi2,hp,Nat.zero_le height,Nat.zero_le (height^2)]

end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.WordValidator

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.WordValidator
open Turing Qatlib.Concepts.BitWordCompiler.CanonicalCodec

def Cap (S : Slot → Bits) (height : ℕ) : Prop := ∀ bank,(S (some bank)).length≤height

theorem cap_frame {K : Type} [DecidableEq K] (code : K → Slot) (S : Slot → Bits) (data : K → Bits)
    (height : ℕ) (hS : Cap S height) (hdata : ∀ k,(data k).length≤height) :
    Cap (StackCall.frame code S data) height := by
  classical
  intro bank
  by_cases hj : ∃ k,code k=some bank
  · simp only [StackCall.frame,dif_pos hj]
    exact hdata _
  · simp only [StackCall.frame,dif_neg hj]
    exact hS bank

theorem checked_cap (input : Bits) (height : ℕ) (hi : input.length≤height) :
    ∀ k,((CheckedNat.haltedResult input []).stk k).length≤height := by
  have hc := CheckedNat.result_size input []
  simp only [List.length_nil,Nat.add_zero] at hc
  intro k
  dsimp only [CheckedNat.size] at hc
  fin_cases k
  · change ((CheckedNat.haltedResult input []).stk 0).length≤height
    omega
  · change ((CheckedNat.haltedResult input []).stk 1).length≤height
    omega
  · change ((CheckedNat.haltedResult input []).stk 2).length≤height
    omega

theorem read_cap (dest : ReadDest) (S : Slot → Bits) (height : ℕ) (hS : Cap S height) :
    Cap (StackCall.frame (readCode dest) S (CheckedNat.haltedResult (S (some .reader)) []).stk) height :=
  cap_frame _ _ _ _ hS (checked_cap _ _ (hS .reader))

theorem word_increment_length (bits : Bits) : (Increment.word bits).length≤bits.length+1 := by
  induction bits with
  | nil => decide
  | cons bit bits ih => cases bit <;> simp only [Increment.word,List.length_cons] <;> omega

theorem bits_succ_length (n : ℕ) : (n+1).bits.length≤n.bits.length+1 := by
  rw [← Increment.word_bits]
  exact word_increment_length n.bits

theorem frame_preserves {K : Type} [DecidableEq K] (code : K → Slot) (S : Slot → Bits) (data : K → Bits)
    (hout : ∀ k,code k≠none) (horiginal : ∀ k,code k≠some .original) :
    StackCall.frame code S data none=S none ∧
      StackCall.frame code S data (some .original)=S (some .original) :=
  ⟨frame_outside code S data none hout,frame_outside code S data (some .original) horiginal⟩

theorem read_frame (dest : ReadDest) (S : Slot → Bits) (tail field : Bits)
    (hmarker : S (some .tempCount)=[]) (hvalue : S (some (readBank dest))=[]) :
    StackCall.frame (readCode dest) S (Parsing.triple tail [] field)=
      Function.update (Function.update S (some .reader) tail) (some (readBank dest)) field := by
  have hinj := readCode_injective dest
  have hsame : StackCall.frame (readCode dest) S (Parsing.triple (S (some .reader)) [] [])=S := by
    apply StackCall.frame_same _ _ _ hinj
    intro k
    fin_cases k <;> simp [readCode,Parsing.triple,hmarker,hvalue]
  have h0 :=
      StackCall.frame_update (readCode dest) S (Parsing.triple (S (some .reader)) [] []) hinj 0 tail
  simp only [Parsing.triple_update_zero,hsame] at h0
  have h2 := StackCall.frame_update (readCode dest) S (Parsing.triple tail [] []) hinj 2 field
  simp only [Parsing.triple_update_two,h0] at h2
  exact h2

theorem guard_frame (wire : Bool) (S : Slot → Bits) (counter fuel : Bits) (hmarker : S (some .tempCount)=[]) :
    StackCall.frame (guardCode wire) S (Parsing.triple counter [] fuel)=
      Function.update (Function.update S (some (if wire then .wireCount else .opCount)) counter) (some .fuel) fuel := by
  have hinj := guardCode_injective wire
  let oldCounter := S (some (if wire then .wireCount else .opCount))
  let oldFuel := S (some .fuel)
  have hsame : StackCall.frame (guardCode wire) S (Parsing.triple oldCounter [] oldFuel)=S := by
    apply StackCall.frame_same _ _ _ hinj
    intro k
    fin_cases k <;> simp [guardCode,Parsing.triple,oldCounter,oldFuel,hmarker]
  have h0 :=
      StackCall.frame_update (guardCode wire) S
      (Parsing.triple oldCounter [] oldFuel) hinj 0 counter
  simp only [Parsing.triple_update_zero,hsame] at h0
  have h2 :=
      StackCall.frame_update (guardCode wire) S (Parsing.triple counter [] oldFuel) hinj 2 fuel
  simp only [Parsing.triple_update_two,h0] at h2
  exact h2

def rootStore (raw reader width count fuel field : Bits) : Slot → Bits
  | none => []
  | some .original => raw
  | some .reader => reader
  | some .width => width
  | some .opCount => count
  | some .fuel => fuel
  | some .field => field
  | _ => []

theorem rootStore_update_reader (raw reader width count fuel field next : Bits) :
    Function.update (rootStore raw reader width count fuel field) (some .reader) next=rootStore raw next width count fuel field := by
  funext k
  cases k with
  | none => rfl
  | some bank => cases bank <;> rfl

theorem rootStore_update_field (raw reader width count fuel field next : Bits) :
    Function.update (rootStore raw reader width count fuel field) (some .field) next=rootStore raw reader width count fuel next := by
  funext k
  cases k with
  | none => rfl
  | some bank => cases bank <;> rfl

theorem order_nat_lt (a width : ℕ) : ReadonlyCompare.order a.bits.reverse width.bits.reverse=.lt ↔ a<width := by
  simp only [ReadonlyCompare.order,List.reverse_reverse,binaryValue_bits]
  split_ifs <;> simp_all

theorem address_valid (readRet compareRet : Phase) (after : Label)
    (hread : phaseProgram readRet=parsed (.compare .field compareRet .start))
    (hcompare : phaseProgram compareRet=less after)
    (raw tail count fuel : Bits) (a width : ℕ) (v : Local) (hlegal : a<width) :
    ∃ ticks last,
      Stacks.stackRun program ticks ⟨some (.read .field readRet .unary),v,
        rootStore raw (natBits a++tail) width.bits.reverse count fuel []⟩=
        some ⟨some after,last,rootStore raw tail width.bits.reverse count fuel a.bits.reverse⟩ ∧
      Stacks.stackRunClock program ticks ⟨some (.read .field readRet .unary),v,
        rootStore raw (natBits a++tail) width.bits.reverse count fuel []⟩≤
          1000*(1+(natBits a++tail).length+width.bits.length)^2 := by
  let S0 := rootStore raw (natBits a++tail) width.bits.reverse count fuel []
  let S1 := rootStore raw tail width.bits.reverse count fuel a.bits.reverse
  let v1 := putParse v (true,CheckedNat.lastField a.bits none)
  let v2 := putCompare v1 ((ReadonlyCompare.order a.bits.reverse width.bits.reverse,none,none),none)
  obtain ⟨readTicks,hR,hRC⟩ := read_valid .field readRet S0 v a tail rfl rfl rfl
  have hframe := read_frame .field S0 tail a.bits.reverse rfl rfl
  rw [hframe] at hR
  simp only [S0,readBank,rootStore_update_reader,rootStore_update_field] at hR
  have hB : Stacks.stackRun program 1 ⟨some (.step readRet),v1,S1⟩=
      some ⟨some (.compare .field compareRet .start),v1,S1⟩ := by
    rw [phase_step,hread]
    simp [parsed,TM2.stepAux,v1,putParse]
  have hBC : Stacks.stackRunClock program 1 ⟨some (.step readRet),v1,S1⟩=1 := by
    simp [Stacks.stackRunClock,program,hread,parsed,go,Stacks.stackClock]
  obtain ⟨compareTicks,hC,hCC⟩ := compare_all .field compareRet S1 v1 rfl rfl rfl
  have hDone : Stacks.stackRun program 1 ⟨some (.step compareRet),v2,S1⟩=some ⟨some after,v2,S1⟩ := by
    rw [phase_step,hcompare]
    have he := (order_nat_lt a width).mpr hlegal
    simp [less,TM2.stepAux,v2,putCompare,he]
  have hDC : Stacks.stackRunClock program 1 ⟨some (.step compareRet),v2,S1⟩=1 := by
    simp [Stacks.stackRunClock,program,hcompare,less,go,Stacks.stackClock]
  have eR : Stacks.Execution program _ _ _ := ⟨readTicks,hR,hRC⟩
  have eB : Stacks.Execution program _ _ 1 := ⟨1,hB,hBC.le⟩
  have eC : Stacks.Execution program _ _ _ := ⟨compareTicks,hC,hCC⟩
  have eD : Stacks.Execution program _ _ 1 := ⟨1,hDone,hDC.le⟩
  obtain ⟨ticks,hr,hc⟩ := ((eR.trans eB).trans eC).trans eD
  refine ⟨ticks,v2,hr,hc.trans ?_⟩
  let B := 1+(natBits a++tail).length+width.bits.length
  have hB : 1≤B := by dsimp [B]; omega
  have hB2 : 1≤B^2 := Nat.one_le_pow 2 _ hB
  have hraw : 1+(natBits a++tail).length≤B := by dsimp [B]; omega
  have hraw2 := Nat.pow_le_pow_left hraw 2
  have hargs : 1+a.bits.length+width.bits.length≤B := by
    dsimp [B]
    simp only [List.length_append,natBits_length]
    omega
  have hargs2 := Nat.pow_le_pow_left hargs 2
  change 50*(1+(natBits a++tail).length)^2+1+100*(1+a.bits.reverse.length+width.bits.reverse.length)^2+1≤1000*B^2
  simp only [List.length_reverse]
  nlinarith only [hB2,hraw2,hargs2]

theorem small_tag_final (n : Fin 4) : NatTag.final n.val.bits.reverse=
    ⟨none,(⟨n.val,by omega⟩,none),Normalization.singleStack []⟩ := by
  fin_cases n <;> rfl

theorem tag_frame (S : Slot → Bits) (field : Bits) :
    StackCall.frame (fun _ : Fin 1 => some Work.field) S (Normalization.singleStack field)=Function.update S (some .field) field := by
  let code : Fin 1 → Slot := fun _ => some .field
  have hinj : Function.Injective code := fun _ _ _ => Subsingleton.elim _ _
  have hsame : StackCall.frame code S (Normalization.singleStack (S (some .field)))=S := by
    apply StackCall.frame_same _ _ _ hinj
    intro k
    rfl
  have hu :=
      StackCall.frame_update code S (Normalization.singleStack (S (some .field))) hinj 0 field
  simpa only [Normalization.singleStack_update,hsame] using hu

theorem small_tag_valid (readRet tagRet : Phase)
    (hread : phaseProgram readRet=parsed (.tag tagRet .first))
    (raw tail width count fuel : Bits) (n : Fin 4) (v : Local) :
    ∃ ticks last,
      Stacks.stackRun program ticks ⟨some (.read .field readRet .unary),v,
        rootStore raw (natBits n.val++tail) width count fuel []⟩=
        some ⟨some (.step tagRet),last,rootStore raw tail width count fuel []⟩ ∧
      last.tagged.1.val=n.val ∧
      Stacks.stackRunClock program ticks ⟨some (.read .field readRet .unary),v,
        rootStore raw (natBits n.val++tail) width count fuel []⟩≤
          100*(1+(natBits n.val++tail).length)^2 := by
  let S0 := rootStore raw (natBits n.val++tail) width count fuel []
  let S1 := rootStore raw tail width count fuel n.val.bits.reverse
  let v1 := putParse v (true,CheckedNat.lastField n.val.bits none)
  obtain ⟨readTicks,hR,hRC⟩ := read_valid .field readRet S0 v n.val tail rfl rfl rfl
  have hframe := read_frame .field S0 tail n.val.bits.reverse rfl rfl
  rw [hframe] at hR
  simp only [S0,readBank,rootStore_update_reader,rootStore_update_field] at hR
  have hB : Stacks.stackRun program 1 ⟨some (.step readRet),v1,S1⟩=
      some ⟨some (.tag tagRet .first),v1,S1⟩ := by
    rw [phase_step,hread]
    simp [parsed,TM2.stepAux,v1,putParse]
  have hBC : Stacks.stackRunClock program 1 ⟨some (.step readRet),v1,S1⟩=1 := by
    simp [Stacks.stackRunClock,program,hread,parsed,go,Stacks.stackClock]
  obtain ⟨hT,hTC⟩ := tag_all tagRet S1 v1
  change Stacks.stackRun program
      (NatTag.ticks n.val.bits.reverse) ⟨some (.tag tagRet .first),v1,S1⟩=_ at hT
  simp only [S1,rootStore,small_tag_final,tag_frame,rootStore_update_field] at hT
  have eR : Stacks.Execution program _ _ _ := ⟨readTicks,hR,hRC⟩
  have eB : Stacks.Execution program _ _ 1 := ⟨1,hB,hBC.le⟩
  have eT : Stacks.Execution program _ _ _ := ⟨NatTag.ticks n.val.bits.reverse,hT,hTC⟩
  obtain ⟨ticks,hr,hc⟩ := (eR.trans eB).trans eT
  refine ⟨ticks,_,hr,rfl,hc.trans ?_⟩
  let B := 1+(natBits n.val++tail).length
  have hB2 : 1≤B^2 := Nat.one_le_pow 2 _ (by dsimp [B]; omega)
  have harg : 1+n.val.bits.length≤B := by
    dsimp [B]; simp only [List.length_append,natBits_length]; omega
  have harg2 := Nat.pow_le_pow_left harg 2
  change 50*B^2+1+20*(1+n.val.bits.reverse.length)^2≤100*B^2
  simp only [List.length_reverse]
  nlinarith only [harg2,hB2]

theorem parsed_failure (dest : ReadDest) (ret : Phase) (after : Label)
    (hret : phaseProgram ret=parsed after) (S : Slot → Bits) (v : Local) (height : ℕ)
    (hS : Cap S height) (hmarker : S (some .tempCount)=[]) (hvalue : S (some (readBank dest))=[])
    (hbad : readNat (S (some .reader))=none) :
    ∃ ticks last T,
      Stacks.stackRun program ticks ⟨some (.read dest ret .unary),v,S⟩=some ⟨some (.step .failure),last,T⟩ ∧
      Cap T height ∧ T none=S none ∧
      Stacks.stackRunClock program ticks ⟨some (.read dest ret .unary),v,S⟩≤60*(1+height)^2 := by
  let result := CheckedNat.haltedResult (S (some .reader)) []
  let T := StackCall.frame (readCode dest) S result.stk
  let last := putParse v result.var
  have hflag : result.var.1=false := by
    cases he : result.var.1 with
    | false => rfl
    | true =>
      have hc := (CheckedNat.success_flag (S (some .reader)) []).mp he
      exact (hc hbad).elim
  obtain ⟨ticks,hr,hc⟩ := read_all dest ret S v hmarker hvalue
  have hF : Stacks.stackRun program 1 ⟨some (.step ret),last,T⟩=some ⟨some (.step .failure),last,T⟩ := by
    rw [phase_step,hret]
    simp [parsed,go,TM2.stepAux,last,putParse,hflag]
  have hFC : Stacks.stackRunClock program 1 ⟨some (.step ret),last,T⟩=1 := by
    simp [Stacks.stackRunClock,program,hret,parsed,go,Stacks.stackClock]
  have eR : Stacks.Execution program _ _ _ := ⟨ticks,hr,hc⟩
  have eF : Stacks.Execution program _ _ 1 := ⟨1,hF,hFC.le⟩
  obtain ⟨total,hR,hC⟩ := eR.trans eF
  refine ⟨total,last,T,hR,read_cap dest S height hS,?_,hC.trans ?_⟩
  · apply frame_outside
    intro k
    fin_cases k <;> simp [readCode]
  · have hi : (S (some .reader)).length≤height := hS .reader
    have hp := Nat.pow_le_pow_left (Nat.succ_le_succ hi) 2
    have hpos : 1≤(1+height)^2 := Nat.one_le_pow 2 _ (by omega)
    change _≤60*(1+height)^2
    nlinarith only [hp,hpos]

theorem bits_reverse_injective : Function.Injective (fun n : ℕ => n.bits.reverse) := by
  intro m n he
  have hv := congrArg (fun bits : Bits => binaryValue bits.reverse) he
  simpa only [List.reverse_reverse,binaryValue_bits] using hv

theorem tag_nat_spec (n : ℕ) :
    ((NatTag.tag n.bits.reverse).val=0 ↔ n=0) ∧ ((NatTag.tag n.bits.reverse).val=1 ↔ n=1) ∧
      ((NatTag.tag n.bits.reverse).val=2 ↔ n=2) ∧ ((NatTag.tag n.bits.reverse).val=3 ↔ n=3) := by
  have ht := NatTag.tag_spec n.bits.reverse
  have h0 : n.bits.reverse=[] ↔ n=0 := by
    change n.bits.reverse=(0 : ℕ).bits.reverse ↔ n=0
    exact bits_reverse_injective.eq_iff
  have h1 : n.bits.reverse=[true] ↔ n=1 := by
    change n.bits.reverse=(1 : ℕ).bits.reverse ↔ n=1
    exact bits_reverse_injective.eq_iff
  have h2 : n.bits.reverse=[true,false] ↔ n=2 := by
    change n.bits.reverse=(2 : ℕ).bits.reverse ↔ n=2
    exact bits_reverse_injective.eq_iff
  have h3 : n.bits.reverse=[true,true] ↔ n=3 := by
    change n.bits.reverse=(3 : ℕ).bits.reverse ↔ n=3
    exact bits_reverse_injective.eq_iff
  exact ⟨ht.1.trans h0,ht.2.1.trans h1,ht.2.2.1.trans h2,ht.2.2.2.trans h3⟩

theorem tag_nat_large (n : ℕ) (hn : 4≤n) : NatTag.tag n.bits.reverse=4 := by
  obtain ⟨h0,h1,h2,h3⟩ := tag_nat_spec n
  apply Fin.ext
  have ht := (NatTag.tag n.bits.reverse).isLt
  change (NatTag.tag n.bits.reverse).val=4
  omega

theorem bool_tag_spec (n : ℕ) : (NatTag.tag n.bits.reverse).val≤1 ↔ n≤1 := by
  obtain ⟨h0,h1,_,_⟩ := tag_nat_spec n
  omega

theorem address_canonical (readRet compareRet : Phase) (after : Label)
    (hread : phaseProgram readRet=parsed (.compare .field compareRet .start))
    (hcompare : phaseProgram compareRet=less after)
    (S : Slot → Bits) (a width : ℕ) (tail : Bits) (v : Local)
    (hreader : S (some .reader)=natBits a++tail) (hwidth : S (some .width)=width.bits.reverse)
    (hmarker : S (some .tempCount)=[]) (hfield : S (some .field)=[])
    (htemp : S (some .workCmpTemp)=[]) (hleft : S (some .workCmpLeft)=[]) (hright : S (some .workCmpRight)=[]) :
    ∃ ticks last,
      Stacks.stackRun program ticks ⟨some (.read .field readRet .unary),v,S⟩=
        some ⟨some (if a<width then after else .step .failure),last,
          Function.update (Function.update S (some .reader) tail) (some .field) a.bits.reverse⟩ ∧
      Stacks.stackRunClock program ticks ⟨some (.read .field readRet .unary),v,S⟩≤
        1000*(1+(S (some .reader)).length+width.bits.length)^2 := by
  let T := Function.update (Function.update S (some .reader) tail) (some .field) a.bits.reverse
  let v1 := putParse v (true,CheckedNat.lastField a.bits none)
  let v2 := putCompare v1 ((ReadonlyCompare.order a.bits.reverse width.bits.reverse,none,none),none)
  obtain ⟨readTicks,hR,hRC⟩ := read_valid .field readRet S v a tail hreader hmarker hfield
  rw [read_frame .field S tail a.bits.reverse hmarker hfield] at hR
  have hB : Stacks.stackRun program 1 ⟨some (.step readRet),v1,T⟩=
      some ⟨some (.compare .field compareRet .start),v1,T⟩ := by
    rw [phase_step,hread]
    simp [parsed,TM2.stepAux,v1,putParse]
  have hBC : Stacks.stackRunClock program 1 ⟨some (.step readRet),v1,T⟩=1 := by
    simp [Stacks.stackRunClock,program,hread,parsed,go,Stacks.stackClock]
  obtain ⟨compareTicks,hC,hCC⟩ := compare_all .field compareRet T v1
    (by simpa [T] using htemp) (by simpa [T] using hleft) (by simpa [T] using hright)
  have hTfield : T (some .field)=a.bits.reverse := by simp [T]
  have hTwidth : T (some .width)=width.bits.reverse := by simpa [T] using hwidth
  simp only [hTfield,hTwidth] at hC hCC
  have hDone : Stacks.stackRun program 1 ⟨some (.step compareRet),v2,T⟩=
      some ⟨some (if a<width then after else .step .failure),v2,T⟩ := by
    rw [phase_step,hcompare]
    by_cases he : a<width
    · have hc := (order_nat_lt a width).mpr he
      simp [less,go,TM2.stepAux,v2,putCompare,hc,he]
    · have hc : ReadonlyCompare.order a.bits.reverse width.bits.reverse≠.lt := mt (order_nat_lt a width).mp he
      simp [less,go,TM2.stepAux,v2,putCompare,hc,he]
  have hDC : Stacks.stackRunClock program 1 ⟨some (.step compareRet),v2,T⟩=1 := by
    simp [Stacks.stackRunClock,program,hcompare,less,go,Stacks.stackClock]
  have eR : Stacks.Execution program _ _ _ := ⟨readTicks,hR,hRC⟩
  have eB : Stacks.Execution program _ _ 1 := ⟨1,hB,hBC.le⟩
  have eC : Stacks.Execution program _ _ _ := ⟨compareTicks,hC,hCC⟩
  have eD : Stacks.Execution program _ _ 1 := ⟨1,hDone,hDC.le⟩
  obtain ⟨ticks,hr,hc⟩ := ((eR.trans eB).trans eC).trans eD
  refine ⟨ticks,v2,hr,hc.trans ?_⟩
  let B := 1+(S (some .reader)).length+width.bits.length
  have hB2 : 1≤B^2 := Nat.one_le_pow 2 _ (by dsimp [B]; omega)
  have hraw : 1+(S (some .reader)).length≤B := by dsimp [B]; omega
  have hraw2 := Nat.pow_le_pow_left hraw 2
  have harg : 1+a.bits.length+width.bits.length≤B := by
    dsimp [B]
    rw [hreader,List.length_append,natBits_length]
    omega
  have harg2 := Nat.pow_le_pow_left harg 2
  change 50*(1+(S (some .reader)).length)^2+1+100*(1+a.bits.reverse.length+width.bits.reverse.length)^2+1≤1000*B^2
  simp only [List.length_reverse]
  nlinarith only [hB2,hraw2,harg2]

theorem update_twice (S : Slot → Bits) (key : Slot) (first second : Bits) :
    Function.update (Function.update S key first) key second=Function.update S key second := by
  funext j
  by_cases he : j=key <;> simp [Function.update_apply,he]

theorem skip_canonical (ret next : Phase)
    (hret : phaseProgram ret=parsed (.drain .field next 0))
    (S : Slot → Bits) (n : ℕ) (tail : Bits) (v : Local)
    (hreader : S (some .reader)=natBits n++tail) (hmarker : S (some .tempCount)=[]) (hfield : S (some .field)=[]) :
    ∃ ticks last,
      Stacks.stackRun program ticks ⟨some (.read .field ret .unary),v,S⟩=
        some ⟨some (.step next),last,Function.update S (some .reader) tail⟩ ∧
      Stacks.stackRunClock program ticks ⟨some (.read .field ret .unary),v,S⟩≤100*(1+(S (some .reader)).length)^2 := by
  let S1 := Function.update (Function.update S (some .reader) tail) (some .field) n.bits.reverse
  let v1 := putParse v (true,CheckedNat.lastField n.bits none)
  obtain ⟨readTicks,hR,hRC⟩ := read_valid .field ret S v n tail hreader hmarker hfield
  rw [read_frame .field S tail n.bits.reverse hmarker hfield] at hR
  have hB : Stacks.stackRun program 1 ⟨some (.step ret),v1,S1⟩=
      some ⟨some (.drain .field next 0),v1,S1⟩ := by
    rw [phase_step,hret]
    simp [parsed,TM2.stepAux,v1,putParse]
  have hBC : Stacks.stackRunClock program 1 ⟨some (.step ret),v1,S1⟩=1 := by
    simp [Stacks.stackRunClock,program,hret,parsed,go,Stacks.stackClock]
  obtain ⟨hD,hDC⟩ := drain_call (Label.drain .field next) (.step next) .field (fun _ => rfl) S1 v1
  have hS1 : S1 (some .field)=n.bits.reverse := by simp [S1]
  rw [hS1] at hD hDC
  have hfinal : Function.update S1 (some .field) []=Function.update S (some .reader) tail := by
    dsimp only [S1]
    rw [update_twice]
    have he : (Function.update S (some .reader) tail) (some .field)=[] := by simpa using hfield
    rw [← he,Function.update_eq_self]
  rw [hfinal] at hD
  have eR : Stacks.Execution program _ _ _ := ⟨readTicks,hR,hRC⟩
  have eB : Stacks.Execution program _ _ 1 := ⟨1,hB,hBC.le⟩
  have eD : Stacks.Execution program _ _ _ := ⟨n.bits.reverse.length+1,hD,hDC.le⟩
  obtain ⟨ticks,hr,hc⟩ := (eR.trans eB).trans eD
  refine ⟨ticks,_,hr,hc.trans ?_⟩
  let B := 1+(S (some .reader)).length
  have hB : 1≤B := by dsimp [B]; omega
  have hn : n.bits.length≤B := by dsimp [B]; rw [hreader,List.length_append,natBits_length]; omega
  have hn2 := Nat.mul_le_mul hn hn
  have hB2 : B≤B^2 := Nat.le_pow (by decide)
  simp only [List.length_reverse]
  change 50*B^2+1+(n.bits.length^2+3*n.bits.length+3)≤100*B^2
  nlinarith only [hn,hn2,hB,hB2]

theorem classify_canonical (readRet tagRet : Phase)
    (hread : phaseProgram readRet=parsed (.tag tagRet .first))
    (S : Slot → Bits) (n : ℕ) (tail : Bits) (v : Local)
    (hreader : S (some .reader)=natBits n++tail) (hmarker : S (some .tempCount)=[]) (hfield : S (some .field)=[]) :
    ∃ ticks last,
      Stacks.stackRun program ticks ⟨some (.read .field readRet .unary),v,S⟩=
        some ⟨some (.step tagRet),last,
          Function.update (Function.update S (some .reader) tail) (some .field) (n.bits.reverse.drop (NatTag.ticks n.bits.reverse))⟩ ∧
      last.tagged.1=NatTag.tag n.bits.reverse ∧
      Stacks.stackRunClock program ticks ⟨some (.read .field readRet .unary),v,S⟩≤100*(1+(S (some .reader)).length)^2 := by
  let T := Function.update (Function.update S (some .reader) tail) (some .field) n.bits.reverse
  let v1 := putParse v (true,CheckedNat.lastField n.bits none)
  obtain ⟨readTicks,hR,hRC⟩ := read_valid .field readRet S v n tail hreader hmarker hfield
  rw [read_frame .field S tail n.bits.reverse hmarker hfield] at hR
  have hB : Stacks.stackRun program 1 ⟨some (.step readRet),v1,T⟩=
      some ⟨some (.tag tagRet .first),v1,T⟩ := by
    rw [phase_step,hread]
    simp [parsed,TM2.stepAux,v1,putParse]
  have hBC : Stacks.stackRunClock program 1 ⟨some (.step readRet),v1,T⟩=1 := by
    simp [Stacks.stackRunClock,program,hread,parsed,go,Stacks.stackClock]
  obtain ⟨hT,hTC⟩ := tag_all tagRet T v1
  have hfieldT : T (some .field)=n.bits.reverse := by simp [T]
  rw [hfieldT] at hT hTC
  change Stacks.stackRun program (NatTag.ticks n.bits.reverse) ⟨some (.tag tagRet .first),v1,T⟩=
    some ⟨some (.step tagRet),putTag v1 (NatTag.final n.bits.reverse).var,
      StackCall.frame (fun _ : Fin 1 => some Work.field) T (Normalization.singleStack (n.bits.reverse.drop (NatTag.ticks n.bits.reverse)))⟩ at hT
  rw [tag_frame] at hT
  simp only [T,update_twice] at hT
  have eR : Stacks.Execution program _ _ _ := ⟨readTicks,hR,hRC⟩
  have eB : Stacks.Execution program _ _ 1 := ⟨1,hB,hBC.le⟩
  have eT : Stacks.Execution program _ _ _ := ⟨NatTag.ticks n.bits.reverse,hT,hTC⟩
  obtain ⟨ticks,hr,hc⟩ := (eR.trans eB).trans eT
  refine ⟨ticks,_,hr,rfl,hc.trans ?_⟩
  let B := 1+(S (some .reader)).length
  have hB2 : 1≤B^2 := Nat.one_le_pow 2 _ (by dsimp [B]; omega)
  have harg : 1+n.bits.length≤B := by
    dsimp [B]; rw [hreader,List.length_append,natBits_length]; omega
  have harg2 := Nat.pow_le_pow_left harg 2
  change 50*B^2+1+20*(1+n.bits.reverse.length)^2≤100*B^2
  simp only [List.length_reverse]
  nlinarith only [harg2,hB2]

theorem bool_canonical (readRet tagRet next : Phase)
    (hread : phaseProgram readRet=parsed (.tag tagRet .first))
    (hbool : phaseProgram tagRet=.branch (fun v => decide (v.tagged.1.val≤1)) (go next) (go .failure))
    (S : Slot → Bits) (n : ℕ) (tail : Bits) (v : Local)
    (hreader : S (some .reader)=natBits n++tail) (hmarker : S (some .tempCount)=[]) (hfield : S (some .field)=[]) :
    ∃ ticks last,
      Stacks.stackRun program ticks ⟨some (.read .field readRet .unary),v,S⟩=
        some ⟨some (.step (if n≤1 then next else .failure)),last,
          Function.update (Function.update S (some .reader) tail) (some .field) (n.bits.reverse.drop (NatTag.ticks n.bits.reverse))⟩ ∧
      Stacks.stackRunClock program ticks ⟨some (.read .field readRet .unary),v,S⟩≤110*(1+(S (some .reader)).length)^2 := by
  obtain ⟨tagTicks,last,hT,hTag,hTC⟩ :=
      classify_canonical readRet tagRet hread S n tail v hreader hmarker hfield
  let T :=
      Function.update (Function.update S (some .reader) tail) (some .field)
      (n.bits.reverse.drop (NatTag.ticks n.bits.reverse))
  have hB : Stacks.stackRun program 1 ⟨some (.step tagRet),last,T⟩=
      some ⟨some (.step (if n≤1 then next else .failure)),last,T⟩ := by
    rw [phase_step,hbool]
    by_cases he : n≤1
    · have hc : last.tagged.1.val≤1 := by rw [hTag]; exact (bool_tag_spec n).mpr he
      simp [TM2.stepAux,go,he,hc]
    · have hc : ¬last.tagged.1.val≤1 := by rw [hTag]; exact mt (bool_tag_spec n).mp he
      simp [TM2.stepAux,go,he,hc]
  have hBC : Stacks.stackRunClock program 1 ⟨some (.step tagRet),last,T⟩=1 := by
    simp [Stacks.stackRunClock,program,hbool,go,Stacks.stackClock]
  have eT : Stacks.Execution program _ _ _ := ⟨tagTicks,hT,hTC⟩
  have eB : Stacks.Execution program _ _ 1 := ⟨1,hB,hBC.le⟩
  obtain ⟨ticks,hr,hc⟩ := eT.trans eB
  refine ⟨ticks,last,hr,hc.trans ?_⟩
  have hp : 1≤(1+(S (some .reader)).length)^2 := Nat.one_le_pow 2 _ (by omega)
  omega

theorem restore_empty_field (S : Slot → Bits) (tail field : Bits) (hfield : S (some .field)=[]) :
    Function.update (Function.update (Function.update S (some .reader) tail) (some .field) field) (some .field) []=
      Function.update S (some .reader) tail := by
  rw [update_twice]
  have he : (Function.update S (some .reader) tail) (some .field)=[] := by simpa using hfield
  rw [← he,Function.update_eq_self]

theorem address_drained (readRet compareRet next : Phase)
    (hread : phaseProgram readRet=parsed (.compare .field compareRet .start))
    (hcompare : phaseProgram compareRet=less (.drain .field next 0))
    (S : Slot → Bits) (a width : ℕ) (tail : Bits) (v : Local)
    (hreader : S (some .reader)=natBits a++tail) (hwidth : S (some .width)=width.bits.reverse)
    (hmarker : S (some .tempCount)=[]) (hfield : S (some .field)=[])
    (htemp : S (some .workCmpTemp)=[]) (hleft : S (some .workCmpLeft)=[]) (hright : S (some .workCmpRight)=[])
    (hlegal : a<width) :
    ∃ ticks last,
      Stacks.stackRun program ticks ⟨some (.read .field readRet .unary),v,S⟩=
        some ⟨some (.step next),last,Function.update S (some .reader) tail⟩ ∧
      Stacks.stackRunClock program ticks ⟨some (.read .field readRet .unary),v,S⟩≤
        2000*(1+(S (some .reader)).length+width.bits.length)^2 := by
  obtain ⟨addrTicks,last,hA,hAC⟩ := address_canonical readRet compareRet (.drain .field next 0) hread hcompare
    S a width tail v hreader hwidth hmarker hfield htemp hleft hright
  rw [if_pos hlegal] at hA
  let T := Function.update (Function.update S (some .reader) tail) (some .field) a.bits.reverse
  obtain ⟨hD,hDC⟩ := drain_call (Label.drain .field next) (.step next) .field (fun _ => rfl) T last
  have hT : T (some .field)=a.bits.reverse := by simp [T]
  rw [hT] at hD hDC
  have hfinal := restore_empty_field S tail a.bits.reverse hfield
  change Function.update T (some .field) []=Function.update S (some .reader) tail at hfinal
  rw [hfinal] at hD
  have eA : Stacks.Execution program _ _ _ := ⟨addrTicks,hA,hAC⟩
  have eD : Stacks.Execution program _ _ _ := ⟨a.bits.reverse.length+1,hD,hDC.le⟩
  obtain ⟨ticks,hr,hc⟩ := eA.trans eD
  refine ⟨ticks,_,hr,hc.trans ?_⟩
  let B := 1+(S (some .reader)).length+width.bits.length
  have hB : 1≤B := by dsimp [B]; omega
  have hB2 : B≤B^2 := Nat.le_pow (by decide)
  have ha : a.bits.length≤B := by dsimp [B]; rw [hreader,List.length_append,natBits_length]; omega
  have ha2 := Nat.mul_le_mul ha ha
  simp only [List.length_reverse]
  change 1000*B^2+(a.bits.length^2+3*a.bits.length+3)≤2000*B^2
  nlinarith only [hB,hB2,ha,ha2]

theorem tag_drop_small (n : ℕ) (hn : n<4) : n.bits.reverse.drop (NatTag.ticks n.bits.reverse)=[] := by
  have hc := congrArg (fun cfg : TM2.Cfg (fun _ : Fin 1 => Bool) NatTag.Label NatTag.Local => cfg.stk 0)
    (small_tag_final ⟨n,hn⟩)
  exact hc

theorem bool_valid (readRet tagRet next : Phase)
    (hread : phaseProgram readRet=parsed (.tag tagRet .first))
    (hbool : phaseProgram tagRet=.branch (fun v => decide (v.tagged.1.val≤1)) (go next) (go .failure))
    (S : Slot → Bits) (n : ℕ) (tail : Bits) (v : Local)
    (hreader : S (some .reader)=natBits n++tail) (hmarker : S (some .tempCount)=[]) (hfield : S (some .field)=[])
    (hn : n≤1) :
    ∃ ticks last,
      Stacks.stackRun program ticks ⟨some (.read .field readRet .unary),v,S⟩=
        some ⟨some (.step next),last,Function.update S (some .reader) tail⟩ ∧
      Stacks.stackRunClock program ticks ⟨some (.read .field readRet .unary),v,S⟩≤110*(1+(S (some .reader)).length)^2 := by
  obtain ⟨ticks,last,hr,hc⟩ :=
      bool_canonical readRet tagRet next hread hbool S n tail v hreader hmarker hfield
  rw [if_pos hn,tag_drop_small n (by omega)] at hr
  have hfinal : Function.update (Function.update S (some .reader) tail) (some .field) []=Function.update S (some .reader) tail := by
    have he : (Function.update S (some .reader) tail) (some .field)=[] := by simpa using hfield
    rw [← he,Function.update_eq_self]
  rw [hfinal] at hr
  exact ⟨ticks,last,hr,hc⟩

def opcodePhase : ℕ → Phase
  | 0 => .hAddress
  | 1 => .pFirst
  | 2 => .sFirst
  | 3 => .qSlot
  | _ => .failure

theorem dispatch (S : Slot → Bits) (v : Local) (n : ℕ) (htag : v.tagged.1=NatTag.tag n.bits.reverse) :
    Stacks.stackRun program 1 ⟨some (.step .dispatch),v,S⟩=some ⟨some (.step (opcodePhase n)),v,S⟩ ∧
      Stacks.stackRunClock program 1 ⟨some (.step .dispatch),v,S⟩=1 := by
  constructor
  · rw [phase_step]
    rcases n with _|_|_|_|n
    · have hv : v.tagged.1=(0 : Fin 5) := by rw [htag]; rfl
      simp [phaseProgram,TM2.stepAux,go,opcodePhase,hv]
    · have hv : v.tagged.1=(1 : Fin 5) := by rw [htag]; rfl
      simp [phaseProgram,TM2.stepAux,go,opcodePhase,hv]
    · have hv : v.tagged.1=(2 : Fin 5) := by rw [htag]; rfl
      simp [phaseProgram,TM2.stepAux,go,opcodePhase,hv]
    · have hv : v.tagged.1=(3 : Fin 5) := by rw [htag]; rfl
      simp [phaseProgram,TM2.stepAux,go,opcodePhase,hv]
    · have hv : v.tagged.1=(4 : Fin 5) := by rw [htag,tag_nat_large _ (by omega)]
      simp [phaseProgram,TM2.stepAux,go,opcodePhase,hv]
  · simp [Stacks.stackRunClock,program,phaseProgram,go,Stacks.stackClock]

theorem opcode_canonical (S : Slot → Bits) (n : ℕ) (tail : Bits) (v : Local)
    (hreader : S (some .reader)=natBits n++tail) (hmarker : S (some .tempCount)=[]) (hfield : S (some .field)=[]) :
    ∃ ticks last,
      Stacks.stackRun program ticks ⟨some (.read .field .afterOpTag .unary),v,S⟩=
        some ⟨some (.step (opcodePhase n)),last,
          Function.update (Function.update S (some .reader) tail) (some .field) (n.bits.reverse.drop (NatTag.ticks n.bits.reverse))⟩ ∧
      Stacks.stackRunClock program ticks ⟨some (.read .field .afterOpTag .unary),v,S⟩≤110*(1+(S (some .reader)).length)^2 := by
  obtain ⟨tagTicks,last,hT,hTag,hTC⟩ :=
      classify_canonical .afterOpTag .dispatch rfl S n tail v hreader hmarker hfield
  let T :=
      Function.update (Function.update S (some .reader) tail) (some .field)
      (n.bits.reverse.drop (NatTag.ticks n.bits.reverse))
  obtain ⟨hD,hDC⟩ := dispatch T last n hTag
  have eT : Stacks.Execution program _ _ _ := ⟨tagTicks,hT,hTC⟩
  have eD : Stacks.Execution program _ _ 1 := ⟨1,hD,hDC.le⟩
  obtain ⟨ticks,hr,hc⟩ := eT.trans eD
  refine ⟨ticks,last,hr,hc.trans ?_⟩
  have hp : 1≤(1+(S (some .reader)).length)^2 := Nat.one_le_pow 2 _ (by omega)
  omega

theorem goto_phase (phase : Phase) (after : Label)
    (hcode : phaseProgram phase=.goto (fun _ => after)) (S : Slot → Bits) (v : Local) :
    Stacks.stackRun program 1 ⟨some (.step phase),v,S⟩=some ⟨some after,v,S⟩ ∧
      Stacks.stackRunClock program 1 ⟨some (.step phase),v,S⟩=1 := by
  constructor
  · rw [phase_step,hcode]
    rfl
  · simp [Stacks.stackRunClock,program,hcode,Stacks.stackClock]

theorem parsed_true (phase : Phase) (after : Label) (hcode : phaseProgram phase=parsed after)
    (S : Slot → Bits) (v : Local) (hv : v.checked.1=true) :
    Stacks.stackRun program 1 ⟨some (.step phase),v,S⟩=some ⟨some after,v,S⟩ ∧
      Stacks.stackRunClock program 1 ⟨some (.step phase),v,S⟩=1 := by
  constructor
  · rw [phase_step,hcode]
    simp [parsed,TM2.stepAux,hv]
