def input (flag : Bool) (k wire : ℕ) (tail : Bits) : Bits := flag::(natBits k++(natBits wire++tail))

theorem frontend (bit : Bool) (k wire : ℕ) (tail : Bits) (v : Local) :
    ∃ ticks,
      Stacks.stackRun program ticks ⟨some (.start 0),v,store [] [] [] [] (input bit k wire tail).reverse []⟩=
        some ⟨some (.emitWire .count),(ReadonlyRepeat.getCounter v,none),store [] k.bits [] wire.bits [] []⟩ ∧
      Stacks.stackRunClock program ticks ⟨some (.start 0),v,store [] [] [] [] (input bit k wire tail).reverse []⟩≤
        700*(1+(input bit k wire tail).length)^2 := by
  let raw := input bit k wire tail
  let rest := natBits k++(natBits wire++tail)
  let v1 := ReadonlyRepeat.putIO v none
  let v2 := ReadonlyRepeat.putIO v1 (some bit)
  let v3 := ReadonlyRepeat.putIO v2 none
  let v4 := ReadonlyRepeat.putIO v3 none
  let v5 := ReadonlyRepeat.putIO v4 none
  let v6 := ReadonlyRepeat.putIO v5 none
  obtain ⟨hS,hSC⟩ := start raw v
  obtain ⟨hF,hFC⟩ := flag bit rest [] [] [] [] [] v1
  obtain ⟨hK,hKC⟩ :=
      parse_call Label.parseCount (.transferCount 0) (fun _ => rfl) k (natBits wire++tail) [] []
      [] v2
  obtain ⟨hT,hTC⟩ := transfer_count k.bits (natBits wire++tail) [] [] [] v3
  obtain ⟨hH,hHC⟩ :=
      parse_call Label.parseWire (.transferWire 0) (fun _ => rfl) wire tail k.bits [] [] v4
  obtain ⟨hU,hUC⟩ :=
      transfer_wire Label.transferWire (.drainReader 0) (fun _ => rfl) wire.bits tail k.bits []
      [] v5
  obtain ⟨hD,hDC⟩ := drain_reader tail k.bits [] wire.bits [] [] v6
  have hrest : rest.length≤raw.length := by dsimp [raw,input,rest]; omega
  have hHrest : (natBits wire++tail).length≤raw.length := by
    dsimp [raw,input]; simp only [List.length_append]; omega
  have hk : k.bits.length≤raw.length := by
    dsimp [raw,input]; simp only [List.length_append,natBits_length]; omega
  have hh : wire.bits.length≤raw.length := by
    dsimp [raw,input]; simp only [List.length_append,natBits_length]; omega
  have htail : tail.length≤raw.length := by
    dsimp [raw,input]; simp only [List.length_append]; omega
  have hk2 := Nat.mul_le_mul hk hk
  have hh2 := Nat.mul_le_mul hh hh
  have ht2 := Nat.mul_le_mul htail htail
  have hr1 : 1+rest.length≤1+raw.length := by omega
  have hr2 := Nat.mul_le_mul hr1 hr1
  have hh1 : 1+(natBits wire++tail).length≤1+raw.length := by omega
  have hhr2 := Nat.mul_le_mul hh1 hh1
  let B := 100*(1+raw.length)^2
  have eS : Stacks.Execution program _ _ B := ⟨raw.length+1,hS,by
    rw [hSC]; dsimp [B]; nlinarith only [Nat.zero_le raw.length,Nat.zero_le (raw.length^2)]⟩
  have eF : Stacks.Execution program _ _ B := ⟨1,hF,by
    rw [hFC]; dsimp [B]; nlinarith only [hrest,Nat.zero_le raw.length,Nat.zero_le (raw.length^2)]⟩
  have eK : Stacks.Execution program _ _ B := ⟨2*k.bits.length+3,hK,hKC.trans (by
    dsimp [B]; change 40*(1+rest.length)^2≤_; nlinarith only [hr2,Nat.zero_le ((1+raw.length)^2)])⟩
  have eT : Stacks.Execution program _ _ B := ⟨k.bits.length+1,hT,by
    rw [hTC]; dsimp [B]; nlinarith only [hk,hk2,Nat.zero_le raw.length,Nat.zero_le (raw.length^2)]⟩
  have eH : Stacks.Execution program _ _ B := ⟨2*wire.bits.length+3,hH,hHC.trans (by
    dsimp [B]; nlinarith only [hhr2,Nat.zero_le ((1+raw.length)^2)])⟩
  have eU : Stacks.Execution program _ _ B := ⟨wire.bits.length+1,hU,by
    rw [hUC]; dsimp [B]; nlinarith only [hh,hh2,Nat.zero_le raw.length,Nat.zero_le (raw.length^2)]⟩
  have eD : Stacks.Execution program _ _ B := ⟨tail.length+1,hD,by
    rw [hDC]; dsimp [B]; nlinarith only
        [htail,ht2,Nat.zero_le raw.length,Nat.zero_le (raw.length^2)]⟩
  obtain ⟨steps,hr,hc⟩ := ((((((eS.trans eF).trans eK).trans eT).trans eH).trans eU).trans eD)
  refine ⟨steps,hr,hc.trans ?_⟩
  change B+B+B+B+B+B+B≤700*(1+raw.length)^2
  dsimp only [B]
  omega

theorem emit_wire (n : ℕ) (reader counter block output : Bits) (v : Local) :
    Stacks.stackRun program (4*n.bits.length+5) ⟨some (.emitWire .count),v,store reader counter [] n.bits block output⟩=
      some ⟨some .ancilla,ReadonlyRepeat.putIO v none,store reader counter [] n.bits block ((natBits n).reverse++output)⟩ ∧
    Stacks.stackRunClock program (4*n.bits.length+5) ⟨some (.emitWire .count),v,store reader counter [] n.bits block output⟩≤
      100*(1+n.bits.length+output.length)^2 := by
  obtain ⟨hr,_⟩ := NatEmit.complete n output (ReadonlyRepeat.getIO v)
  have hc := NatEmit.clock_bound n output (ReadonlyRepeat.getIO v)
  obtain ⟨hN,hNC⟩ := StackCall.execution wireEmitCode Label.emitWire .ancilla ReadonlyRepeat.getIO ReadonlyRepeat.putIO
    (wireEmitFrame reader counter block) (wireEmitFrame_at reader counter block) (wireEmitFrame_update reader counter block)
    (fun _ _ => rfl) (fun _ _ _ => rfl) NatEmit.program program (fun _ => rfl) v (4*n.bits.length+5) _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,
    wireEmitFrame,Parsing.triple_zero,Parsing.triple_one,Parsing.triple_two,ReadonlyRepeat.putIO_get] at hN hNC
  exact ⟨hN,hNC.trans_le hc⟩

