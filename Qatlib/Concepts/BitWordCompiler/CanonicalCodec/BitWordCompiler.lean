theorem twice_bits (n : ℕ) (hn : 0<n) : (2*n).bits=false::n.bits := by
  simpa only [Nat.bit_false] using Nat.bits_append_bit n false (by omega)

theorem shift (n : ℕ) (hn : 0<n) (reader wire block output : Bits) (v : Local) :
    Stacks.stackRun program 1 ⟨some .shift,v,store reader n.bits [] wire block output⟩=
      some ⟨some (.emitCount .count),v,store reader (2*n).bits [] wire block output⟩ ∧
    Stacks.stackRunClock program 1 ⟨some .shift,v,store reader n.bits [] wire block output⟩=2*n.bits.length+4 := by
  rw [twice_bits n hn]
  constructor
  · simp [Stacks.run_one,TM2.step,program,TM2.stepAux]
  · simp [Stacks.stackRunClock,program,Stacks.stackClock]
    omega

theorem unshift (n : ℕ) (hn : 0<n) (reader wire block output : Bits) (v : Local) :
    Stacks.stackRun program 1 ⟨some .unshift,v,store reader (2*n).bits [] wire block output⟩=
      some ⟨some .blockStart,v,store reader n.bits [] wire block output⟩ ∧
    Stacks.stackRunClock program 1 ⟨some .unshift,v,store reader (2*n).bits [] wire block output⟩=2*n.bits.length+4 := by
  rw [twice_bits n hn]
  constructor
  · simp [Stacks.run_one,TM2.step,program,TM2.stepAux]
  · simp [Stacks.stackRunClock,program,Stacks.stackClock]
    omega

def continuation : Option Label → TM2.Stmt (fun _ : Slot => Bool) Label Local
  | none => .halt
  | some l => .goto (fun _ => l)

theorem push_constant (state : Label) (returnTo : Option Label) (bank : Slot) (bits : Bits)
    (hcode : program state=Stacks.pushBits bank bits (continuation returnTo)) (v : Local) (S : Slot → Bits) :
    Stacks.stackRun program 1 ⟨some state,v,S⟩=
      some ⟨returnTo,v,Function.update S bank (bits.reverse++S bank)⟩ ∧
    Stacks.stackRunClock program 1 ⟨some state,v,S⟩=
      1+bits.length*(2*(S bank).length+bits.length+2) := by
  constructor
  · rw [Stacks.run_one]
    change some (TM2.stepAux (program state) v S)=_
    rw [hcode,Stacks.pushBits_step]
    cases returnTo <;> rfl
  · change 1+Stacks.stackClock (program state) v S+0=_
    rw [hcode,Stacks.pushBits_clock]
    cases returnTo <;> simp [continuation,Stacks.stackClock]

theorem block_length (wire : ℕ) : (block wire).length=2*wire.bits.length+11 := by
  simp only [block,List.flatMap_cons,List.flatMap_nil,List.length_append,List.length_nil,natBits_length]
  change (2*0+1)+((2*wire.bits.length+1)+((2*2+1)+((2*0+1)+((2*0+1)+((2*0+1)+((2*0+1)+0))))))=_
  omega

theorem header_length (wire k : ℕ) : ([wire,1,2*(k+1)].flatMap natBits).length=
    2*wire.bits.length+2*(k+1).bits.length+7 := by
  simp only [List.flatMap_cons,List.flatMap_nil,List.length_append,List.length_nil,natBits_length,
    twice_bits (k+1) (by omega),List.length_cons]
  change (2*wire.bits.length+1)+((2*1+1)+(2*((k+1).bits.length+1)+1+0))=_
  omega

theorem output_length (wire k : ℕ) : (output wire k).length=
    2*wire.bits.length+2*(k+1).bits.length+7+(k+1)*(2*wire.bits.length+11)+4 := by
  simp only [output,List.length_append,header_length,List.length_flatten,List.map_replicate,
    List.sum_replicate_nat,block_length]
  change _+(2*1+1)+1=_
  omega

def header (wire k : ℕ) : Bits := [wire,1,2*(k+1)].flatMap natBits

theorem emit_header (wire k : ℕ) (v : Local) :
    ∃ ticks,
      Stacks.stackRun program ticks ⟨some (.emitWire .count),v,store [] k.bits [] wire.bits [] []⟩=
        some ⟨some .blockStart,(ReadonlyRepeat.getCounter v,none),store [] (k+1).bits [] wire.bits [] (header wire k).reverse⟩ ∧
      Stacks.stackRunClock program ticks ⟨some (.emitWire .count),v,store [] k.bits [] wire.bits [] []⟩≤
        60000*(1+wire.bits.length+k.bits.length+(k+1).bits.length)^2 := by
  let out0 := (natBits wire).reverse
  let out1 := (natBits 1).reverse++out0
  let out2 := (natBits (2*(k+1))).reverse++out1
  let v1 := ReadonlyRepeat.putIO v none
  let v2 := ReadonlyRepeat.putIO v1 none
  let v3 := ReadonlyRepeat.putIO v2 none
  obtain ⟨hW,hWC⟩ := emit_wire wire [] k.bits [] [] v
  simp only [List.append_nil,List.length_nil,Nat.add_zero] at hW hWC
  obtain ⟨hA,hAC⟩ := push_constant .ancilla (some (.increment .carry)) .output (natBits 1) rfl v1
    (store [] k.bits [] wire.bits [] out0)
  simp only [store_output,store_update_output] at hA hAC
  obtain ⟨incTicks,hI,hIC⟩ := increment k [] wire.bits [] out1 v1
  obtain ⟨hS,hSC⟩ := shift (k+1) (by omega) [] wire.bits [] out1 v2
  obtain ⟨hC,hCC⟩ := emit_count (2*(k+1)) [] wire.bits [] out1 v2
  obtain ⟨hU,hUC⟩ := unshift (k+1) (by omega) [] wire.bits [] out2 v3
  let T := 1+wire.bits.length+k.bits.length+(k+1).bits.length
  let B := 10000*T^2
  have hT : 1≤T := by dsimp [T]; omega
  have hT2 : T≤T^2 := Nat.le_pow (by decide)
  have hw : 1+wire.bits.length≤T := by dsimp [T]; omega
  have hk : 1+k.bits.length≤T := by dsimp [T]; omega
  have hp : 1+(k+1).bits.length≤T := by dsimp [T]; omega
  have hw2 := Nat.mul_le_mul hw hw
  have hk2 := Nat.mul_le_mul hk hk
  have eW : Stacks.Execution program _ _ B := ⟨4*wire.bits.length+5,hW,hWC.trans (by
    dsimp only [B]; nlinarith only [hw2,Nat.zero_le (T^2)])⟩
  have eA : Stacks.Execution program _ _ B := ⟨1,hA,by
    rw [hAC]
    change 1+3*(2*(natBits wire).reverse.length+3+2)≤B
    simp only [List.length_reverse,natBits_length]
    dsimp only [B]
    omega⟩
  have eI : Stacks.Execution program _ _ B := ⟨incTicks,hI,hIC.trans (by
    dsimp only [B]; nlinarith only [hk2,Nat.zero_le (T^2)])⟩
  have eS : Stacks.Execution program _ _ B := ⟨1,hS,by rw [hSC]; dsimp only [B]; omega⟩
  have harg : 1+(2*(k+1)).bits.length+out1.length≤9*T := by
    rw [twice_bits (k+1) (by omega)]
    simp only [out1,out0,List.length_cons,List.length_append,List.length_reverse,natBits_length]
    change 1+((k+1).bits.length+1)+((2*1+1)+(2*wire.bits.length+1))≤9*T
    omega
  have harg2 := Nat.mul_le_mul harg harg
  have eC : Stacks.Execution program _ _ B := ⟨4*(2*(k+1)).bits.length+5,hC,hCC.trans (by
    dsimp only [B]; nlinarith only [harg2,Nat.zero_le (T^2)])⟩
  have eU : Stacks.Execution program _ _ B := ⟨1,hU,by rw [hUC]; dsimp only [B]; omega⟩
  obtain ⟨ticks,hr,hc⟩ := (((((eW.trans eA).trans eI).trans eS).trans eC).trans eU)
  refine ⟨ticks,?_,hc.trans ?_⟩
  · simpa only [header,out2,out1,out0,List.flatMap_cons,List.flatMap_nil,List.append_nil,
      List.reverse_append,List.append_assoc] using! hr
  · change B+B+B+B+B+B≤60000*T^2
    dsimp only [B]
    omega

theorem drain_wire (bits reader counter temp block output : Bits) (v : Local) :
    Stacks.stackRun program (bits.length+1) ⟨some (.drainWire 0),v,store reader counter temp bits block output⟩=
      some ⟨some (.transferBlock 0),ReadonlyRepeat.putIO v none,store reader counter temp [] block output⟩ ∧
    Stacks.stackRunClock program (bits.length+1) ⟨some (.drainWire 0),v,store reader counter temp bits block output⟩=
      bits.length^2+3*bits.length+3 := by
  have hr := Normalization.drain_run bits (ReadonlyRepeat.getIO v)
  obtain ⟨hN,hNC⟩ := StackCall.execution (fun _ : Fin 1 => Slot.wire) Label.drainWire (.transferBlock 0)
    ReadonlyRepeat.getIO ReadonlyRepeat.putIO (drainWireFrame reader counter temp block output)
    (drainWireFrame_at reader counter temp block output) (drainWireFrame_update reader counter temp block output)
    (fun _ _ => rfl) (fun _ _ _ => rfl) Normalization.drainProgram program (fun _ => rfl) v (bits.length+1) _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,
    drainWireFrame,Normalization.singleStack_zero,ReadonlyRepeat.putIO_get] at hN hNC
  exact ⟨hN,hNC.trans (Normalization.drain_clock bits (ReadonlyRepeat.getIO v))⟩

theorem build_block (wire : ℕ) (counter output : Bits) (v : Local) :
    ∃ ticks,
      Stacks.stackRun program ticks ⟨some .blockStart,v,store [] counter [] wire.bits [] output⟩=
        some ⟨some (.repeat (.counter .borrow)),(ReadonlyRepeat.getCounter v,none),
          store [] counter [] (block wire) [] output⟩ ∧
      Stacks.stackRunClock program ticks ⟨some .blockStart,v,store [] counter [] wire.bits [] output⟩≤
        50000*(1+wire.bits.length)^2 := by
  let out0 := (natBits 0).reverse
  let out1 := (natBits wire).reverse++out0
  let tailFields := [3,0,0,0,0].flatMap natBits
  let out2 := tailFields.reverse++out1
  let v1 := ReadonlyRepeat.putIO v none
  let v2 := ReadonlyRepeat.putIO v1 none
  obtain ⟨hS,hSC⟩ := push_constant .blockStart (some (.emitBlockWire .count)) .block (natBits 0) rfl v
    (store [] counter [] wire.bits [] output)
  simp only [store_block,store_update_block,List.append_nil] at hS hSC
  obtain ⟨hE,hEC⟩ := emit_block_wire wire [] counter output out0 v
  obtain ⟨hC,hCC⟩ := push_constant .blockEnd (some (.drainWire 0)) .block tailFields rfl v1
    (store [] counter [] wire.bits out1 output)
  simp only [store_block,store_update_block] at hC hCC
  have hblock : out2=(block wire).reverse := by
    simp [block,out2,out1,out0,tailFields,List.reverse_append,List.append_assoc]
  change Stacks.stackRun program 1 ⟨some .blockEnd,v1,store [] counter [] wire.bits out1 output⟩=
    some ⟨some (.drainWire 0),v1,store [] counter [] wire.bits out2 output⟩ at hC
  rw [hblock] at hC
  obtain ⟨hD,hDC⟩ := drain_wire wire.bits [] counter [] (block wire).reverse output v1
  obtain ⟨hT,hTC⟩ := transfer_wire Label.transferBlock (.repeat (.counter .borrow)) (fun _ => rfl)
    (block wire) [] counter [] output v2
  let T := 1+wire.bits.length
  let B := 10000*T^2
  have hTpos : 1≤T := by dsimp [T]; omega
  have hT2 : T≤T^2 := Nat.le_pow (by decide)
  have hh : wire.bits.length≤T := by dsimp [T]; omega
  have hh2 := Nat.mul_le_mul hh hh
  have eS : Stacks.Execution program _ _ B := ⟨1,hS,by
    rw [hSC]; change 1+1*(2*0+1+2)≤B; dsimp only [B]; omega⟩
  have harg : 1+wire.bits.length+out0.length≤2*T := by
    change 1+wire.bits.length+1≤2*T; dsimp [T]; omega
  have harg2 := Nat.mul_le_mul harg harg
  have eE : Stacks.Execution program _ _ B := ⟨4*wire.bits.length+5,hE,hEC.trans (by
    dsimp only [B]; nlinarith only [harg2,Nat.zero_le (T^2)])⟩
  have eC : Stacks.Execution program _ _ B := ⟨1,hC,by
    rw [hCC]
    change 1+9*(2*out1.length+9+2)≤B
    simp only [out1,out0,List.length_append,List.length_reverse,natBits_length]
    change 1+9*(2*((2*wire.bits.length+1)+(2*0+1))+9+2)≤B
    dsimp only [B]
    omega⟩
  have eD : Stacks.Execution program _ _ B := ⟨wire.bits.length+1,hD,by
    rw [hDC]; dsimp only [B]; nlinarith only [hh,hh2,hTpos,hT2]⟩
  have hbl : (block wire).length≤13*T := by rw [block_length]; dsimp [T]; omega
  have hbi : 2*(block wire).length+5≤31*T := by omega
  have hprod := Nat.mul_le_mul hbl hbi
  have eT : Stacks.Execution program _ _ B := ⟨(block wire).length+1,hT,by
    rw [hTC]; dsimp only [B]; nlinarith only [hprod,hT2,hTpos]⟩
  obtain ⟨ticks,hr,hc⟩ := ((((eS.trans eE).trans eC).trans eD).trans eT)
  refine ⟨ticks,hr,hc.trans ?_⟩
  change B+B+B+B+B≤50000*T^2
  dsimp only [B]
  omega

theorem repeat_call (n : ℕ) (counter bits output : Bits) (v : Local) (hnum : binaryValue counter=n) :
    ∃ ticks,
      Stacks.stackRun program ticks ⟨some (.repeat (.counter .borrow)),v,store [] counter [] bits [] output⟩=
        some ⟨some .suffix,((false,none),none),store [] [] [] [] [] ((List.replicate n bits).flatten.reverse++output)⟩ ∧
      Stacks.stackRunClock program ticks ⟨some (.repeat (.counter .borrow)),v,store [] counter [] bits [] output⟩≤
        20*(n+1)*(1+counter.length)^2+50*(n+1)*(1+bits.length+output.length+n*bits.length)^2 := by
  obtain ⟨ticks,hr,hc⟩ := ReadonlyRepeat.complete n counter bits output v hnum
  obtain ⟨hN,hNC⟩ := StackCall.execution repeatCode Label.repeat .suffix id (fun _ v => v)
    (repeatFrame [] []) (repeatFrame_at [] []) (repeatFrame_update [] [])
    (fun _ _ => rfl) (fun _ _ _ => rfl) ReadonlyRepeat.program program (fun _ => rfl) v ticks _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,
    repeatFrame,Preparation.quad_zero,Preparation.quad_one,Preparation.quad_two,Preparation.quad_three] at hN hNC
  exact ⟨ticks,hN,hNC.trans_le hc⟩

def repeatCost (wire k : ℕ) : ℕ :=
  20*(k+1+1)*(1+(k+1).bits.length)^2+
    50*(k+1+1)*(1+(block wire).length+(header wire k).length+(k+1)*(block wire).length)^2

def executionCost (bit : Bool) (k wire : ℕ) (tail : Bits) : ℕ :=
  700*(1+(input bit k wire tail).length)^2+
    60000*(1+wire.bits.length+k.bits.length+(k+1).bits.length)^2+
    50000*(1+wire.bits.length)^2+repeatCost wire k+
    (1+4*(2*(((List.replicate (k+1) (block wire)).flatten.reverse++(header wire k).reverse).length)+4+2))

theorem execution (bit : Bool) (k wire : ℕ) (tail : Bits) (v : Local) :
    ∃ ticks,
      Stacks.stackRun program ticks ⟨some (.start 0),v,store [] [] [] [] (input bit k wire tail).reverse []⟩=
        some ⟨none,((false,none),none),store [] [] [] [] [] (output wire k).reverse⟩ ∧
      Stacks.stackRunClock program ticks ⟨some (.start 0),v,store [] [] [] [] (input bit k wire tail).reverse []⟩≤
        executionCost bit k wire tail := by
  let v1 : Local := (ReadonlyRepeat.getCounter v,none)
  obtain ⟨frontTicks,hF,hFC⟩ := frontend bit k wire tail v
  obtain ⟨headTicks,hH,hHC⟩ := emit_header wire k v1
  obtain ⟨blockTicks,hB,hBC⟩ := build_block wire (k+1).bits (header wire k).reverse v1
  obtain ⟨repeatTicks,hR,hRC⟩ :=
      repeat_call (k+1) (k+1).bits (block wire) (header wire k).reverse v1 (binaryValue_bits (k+1))
  obtain ⟨hS,hSC⟩ := push_constant .suffix none .output (natBits 1++[false]) rfl ((false,none),none)
    (store [] [] [] [] [] ((List.replicate (k+1) (block wire)).flatten.reverse++(header wire k).reverse))
  simp only [store_output,store_update_output] at hS hSC
  have eF : Stacks.Execution program _ _ _ := ⟨frontTicks,hF,hFC⟩
  have eH : Stacks.Execution program _ _ _ := ⟨headTicks,hH,hHC⟩
  have eB : Stacks.Execution program _ _ _ := ⟨blockTicks,hB,hBC⟩
  have eR : Stacks.Execution program _ _ (repeatCost wire k) := ⟨repeatTicks,hR,by
    simpa only [repeatCost,List.length_reverse] using hRC⟩
  have eS : Stacks.Execution program _ _ _ := ⟨1,hS,hSC.le⟩
  obtain ⟨ticks,hr,hc⟩ := ((((eF.trans eH).trans eB).trans eR).trans eS)
  refine ⟨ticks,?_,?_⟩
  · simpa only [output,header,List.reverse_append,List.append_assoc] using hr
  · simpa only [executionCost] using! hc

def size (bit : Bool) (k wire : ℕ) (tail : Bits) : ℕ := 1+(input bit k wire tail).length+k

theorem data_bounds (bit : Bool) (k wire : ℕ) (tail : Bits) :
    let B := size bit k wire tail
    1≤B ∧ 1+wire.bits.length≤B ∧ k.bits.length≤B ∧ (k+1).bits.length≤B ∧ k+1≤B ∧
      k+1+1≤2*B ∧ (block wire).length≤13*B ∧ (header wire k).length≤11*B ∧
      (k+1)*(block wire).length≤13*B^2 ∧
      1+(block wire).length+(header wire k).length+(k+1)*(block wire).length≤38*B^2 ∧
      ((List.replicate (k+1) (block wire)).flatten.reverse++(header wire k).reverse).length≤24*B^2 ∧
      (output wire k).length≤30*B^2 := by
  let B := size bit k wire tail
  have hB : 1≤B := by dsimp [B,size]; omega
  have hBB : B≤B^2 := Nat.le_pow (by decide)
  have hB2 : 1≤B^2 := hB.trans hBB
  have hw : wire.bits.length≤(input bit k wire tail).length := by
    simp only [input,List.length_cons,List.length_append,natBits_length]
    omega
  have hW : 1+wire.bits.length≤B := by dsimp [B,size]; omega
  have hK : k.bits.length≤B := by have hk := Counter.bits_length_le k; dsimp [B,size]; omega
  have hn : k+1≤B := by dsimp [B,size]; omega
  have hP : (k+1).bits.length≤B := (Counter.bits_length_le (k+1)).trans hn
  have hn1 : k+1+1≤2*B := by omega
  have hb : (block wire).length≤13*B := by rw [block_length]; omega
  have hh : (header wire k).length≤11*B := by simp only [header,header_length]; omega
  have hp : (k+1)*(block wire).length≤13*B^2 := by
    calc
      _ ≤ B*(13*B) := Nat.mul_le_mul hn hb
      _ = _ := by ring
  have hz : 1+(block wire).length+(header wire k).length+(k+1)*(block wire).length≤38*B^2 := by
    omega
  have hbefore : ((List.replicate (k+1) (block wire)).flatten.reverse++(header wire k).reverse).length≤24*B^2 := by
    simp only [List.length_append,List.length_reverse,List.length_flatten,List.map_replicate,List.sum_replicate_nat]
    omega
  have ho : (output wire k).length≤30*B^2 := by
    have hhead := header_length wire k
    rw [output_length,← hhead,← block_length wire]
    change (header wire k).length+(k+1)*(block wire).length+4≤30*B^2
    omega
  exact ⟨hB,hW,hK,hP,hn,hn1,hb,hh,hp,hz,hbefore,ho⟩

theorem cost_bound (bit : Bool) (k wire : ℕ) (tail : Bits) :
    executionCost bit k wire tail≤2000000*(size bit k wire tail)^5 := by
  obtain ⟨hB,hW,hK,hP,_,hn1,_,_,_,hz,hbefore,_⟩ := data_bounds bit k wire tail
  let B := size bit k wire tail
  let Z := 1+(block wire).length+(header wire k).length+(k+1)*(block wire).length
  change _≤38*B^2 at hz
  change _≤24*B^2 at hbefore
  have hraw : 1+(input bit k wire tail).length≤B := by dsimp [B,size]; omega
  have hfront : 700*(1+(input bit k wire tail).length)^2≤700*B^2 :=
    Nat.mul_le_mul_left 700 (by simpa only [pow_two] using Nat.mul_le_mul hraw hraw)
  have hheadarg : 1+wire.bits.length+k.bits.length+(k+1).bits.length≤4*B := by omega
  have hhead : 60000*(1+wire.bits.length+k.bits.length+(k+1).bits.length)^2≤960000*B^2 := by
    calc
      _ ≤ 60000*(4*B)^2 := Nat.mul_le_mul_left 60000 (by simpa only [pow_two] using Nat.mul_le_mul hheadarg hheadarg)
      _ = _ := by ring
  have hblock : 50000*(1+wire.bits.length)^2≤50000*B^2 :=
    Nat.mul_le_mul_left 50000 (by simpa only [pow_two] using Nat.mul_le_mul hW hW)
  have hw : 1+(k+1).bits.length≤2*B := by omega
  have hc : 20*(k+1+1)*(1+(k+1).bits.length)^2≤160*B^3 := by
    calc
      _ ≤ (20*(2*B))*(2*B)^2 := Nat.mul_le_mul (Nat.mul_le_mul_left 20 hn1)
        (by simpa only [pow_two] using Nat.mul_le_mul hw hw)
      _ = _ := by ring
  have hr : 50*(k+1+1)*Z^2≤144400*B^5 := by
    calc
      _ ≤ (50*(2*B))*(38*B^2)^2 := Nat.mul_le_mul (Nat.mul_le_mul_left 50 hn1)
        (by simpa only [pow_two] using Nat.mul_le_mul hz hz)
      _ = _ := by ring
  have hs : 1+4*(2*(((List.replicate (k+1) (block wire)).flatten.reverse++(header wire k).reverse).length)+4+2)≤217*B^2 := by
    have hB2 : 1≤B^2 := hB.trans (Nat.le_pow (by decide))
    omega
  have h25 : B^2≤B^5 := Nat.pow_le_pow_right (by omega) (by decide)
  have h35 : B^3≤B^5 := Nat.pow_le_pow_right (by omega) (by decide)
  change executionCost bit k wire tail≤2000000*B^5
  dsimp only [executionCost,repeatCost]
  dsimp only [Z] at hr
  nlinarith only [hfront,hhead,hblock,hc,hr,hs,h25,h35,Nat.zero_le (B^5)]

theorem output_store (word : Bits) : store [] [] [] [] [] word=Function.update (fun _ => []) Slot.output word := by
  funext k
  cases k <;> rfl

theorem init_eq (word : Bits) : (TM2.init Slot.block word : TM2.Cfg (fun _ : Slot => Bool) Label Local)=
    ⟨some (.start 0),default,store [] [] [] [] word []⟩ := by
  have he : (fun _ : Slot => ([] : Bits))=store [] [] [] [] [] [] := by funext k; cases k <;> rfl
  simp only [TM2.init,he,store_update_block]
  rfl

theorem raw_machine :
    ∃ (q : ℕ) (M : TM0.Machine Symbol (Fin (q+1))) (C : ℕ), 0<C ∧
      ∀ (bit : Bool) (k wire : ℕ) (tail : Bits), Runs M (input bit k wire tail) (output wire k)
        (C*(size bit k wire tail)^5) (C*(size bit k wire tail)^5) := by
  obtain ⟨q,M,C,hC,hM⟩ := Stacks.raw_compiler program Slot.block Slot.output
  refine ⟨q,M,3000000*C,Nat.mul_pos (by decide) hC,?_⟩
  intro bit k wire tail
  obtain ⟨steps,hr,hc⟩ := execution bit k wire tail default
  have hrun : Stacks.stackRun program steps (TM2.init Slot.block (input bit k wire tail).reverse)=
      some ⟨none,((false,none),none),Function.update (fun _ => []) Slot.output (output wire k).reverse⟩ := by
    rw [init_eq,← output_store]
    exact hr
  have hraw := hM (input bit k wire tail) (output wire k) steps ((false,none),none) hrun
  let B := size bit k wire tail
  have hB : 1≤B := by dsimp [B,size]; omega
  have hB2 : 1≤B^2 := hB.trans (Nat.le_pow (by decide))
  obtain ⟨_,_,_,_,_,_,_,_,_,_,_,ho⟩ := data_bounds bit k wire tail
  change _≤30*B^2 at ho
  have hi : 1+(input bit k wire tail).length≤B := by dsimp [B,size]; omega
  have hi2 : (1+(input bit k wire tail).length)^2≤B^2 := by
    simpa only [pow_two] using Nat.mul_le_mul hi hi
  have ho1 : 1+(output wire k).length≤31*B^2 := by omega
  have ho2 : (1+(output wire k).length)^2≤961*B^4 := by
    calc
      _ ≤ (31*B^2)^2 := by simpa only [pow_two] using Nat.mul_le_mul ho1 ho1
      _ = _ := by ring
  have ht : Stacks.stackRunClock program steps (TM2.init Slot.block (input bit k wire tail).reverse)≤2000000*B^5 := by
    rw [init_eq]
    exact hc.trans (cost_bound bit k wire tail)
  have h25 : B^2≤B^5 := Nat.pow_le_pow_right (by omega) (by decide)
  have h45 : B^4≤B^5 := Nat.pow_le_pow_right (by omega) (by decide)
  have hsum : (1+(input bit k wire tail).length)^2+
      Stacks.stackRunClock program steps (TM2.init Slot.block (input bit k wire tail).reverse)+
      (1+(output wire k).length)^2≤3000000*B^5 := by
    nlinarith only [hi2,ho2,ht,h25,h45,Nat.zero_le (B^5)]
  have hbound : C*((1+(input bit k wire tail).length)^2+
      Stacks.stackRunClock program steps (TM2.init Slot.block (input bit k wire tail).reverse)+
      (1+(output wire k).length)^2)≤(3000000*C)*B^5 := by
    calc
      _ ≤ C*(3000000*B^5) := Nat.mul_le_mul_left C hsum
      _ = _ := by ring
  exact runs_mono hraw hbound hbound
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.NativeEcho

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.Preparation

@[simp] theorem quad_update_two (reader temp markers source bits : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) :
    Function.update (quad reader temp markers source) 2 bits=quad reader temp bits source := by
  funext k
  fin_cases k <;> rfl
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.Preparation

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.LengthCounter
open Turing Qatlib.Concepts.BitWordCompiler.CanonicalCodec
inductive Label where | count | increment (l : Increment.Label) deriving DecidableEq,Fintype
instance : Inhabited Label := ⟨.count⟩

def program : Label → TM2.Stmt (fun _ : Fin 4 => Bool) Label Symbol
  | .count => .pop 3 (fun _ bit => bit) (.branch (fun bit => bit.isSome)
      (.push 2 (fun _ => true) (.goto (fun _ => .increment .carry))) .halt)
  | .increment l => StackCall.stmt (Fin.castAdd 2) Label.increment .count id (fun _ v => v) (Increment.program l)

theorem count_step (n : ℕ) (bits markers : Bits) (bit : Bool) (v : Symbol) :
    Stacks.stackRun program 1 ⟨some .count,v,Preparation.quad n.bits [] markers (bit::bits)⟩=
      some ⟨some (.increment .carry),some bit,Preparation.quad n.bits [] (true::markers) bits⟩ := by
  simp [Stacks.run_one,TM2.step,program,TM2.stepAux]

theorem count_clock (n : ℕ) (bits markers : Bits) (bit : Bool) (v : Symbol) :
    Stacks.stackRunClock program 1 ⟨some .count,v,Preparation.quad n.bits [] markers (bit::bits)⟩=
      2*bits.length+2*markers.length+7 := by
  simp [Stacks.stackRunClock,program,Stacks.stackClock]
  omega

theorem increment (n : ℕ) (markers bits : Bits) (v : Symbol) :
    ∃ ticks,
      Stacks.stackRun program ticks ⟨some (.increment .carry),v,Preparation.quad n.bits [] markers bits⟩=
        some ⟨some .count,none,Preparation.quad (n+1).bits [] markers bits⟩ ∧
      Stacks.stackRunClock program ticks ⟨some (.increment .carry),v,Preparation.quad n.bits [] markers bits⟩≤
        50*(1+n.bits.length)^2 := by
  obtain ⟨ticks,_,hr,hc⟩ := Increment.complete n.bits [] v
  simp only [List.reverse_nil,List.nil_append,Increment.word_bits,List.length_nil,Nat.add_zero] at hr hc
  obtain ⟨hN,hNC⟩ := StackCall.execution (Fin.castAdd 2) Label.increment .count id (fun _ v => v)
    (Preparation.transferFrame markers bits) (Preparation.transferFrame_at markers bits)
    (Preparation.transferFrame_update markers bits) (fun _ _ => rfl) (fun _ _ _ => rfl)
    Increment.program program (fun _ => rfl) v ticks _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,
    Preparation.transferFrame,Stacks.stackPair_zero,Stacks.stackPair_one] at hN hNC
  exact ⟨ticks,hN,hNC.trans_le hc⟩

theorem complete (n : ℕ) (bits markers : Bits) (v : Symbol) :
    ∃ ticks,
      Stacks.stackRun program ticks ⟨some .count,v,Preparation.quad n.bits [] markers bits⟩=
        some ⟨none,none,Preparation.quad (n+bits.length).bits [] (List.replicate bits.length true++markers) []⟩ ∧
      Stacks.stackRunClock program ticks ⟨some .count,v,Preparation.quad n.bits [] markers bits⟩≤
        100*(bits.length+1)*(1+n+2*bits.length+markers.length)^2 := by
  induction bits generalizing n markers v with
  | nil =>
    refine ⟨1,?_,?_⟩
    · simp [Stacks.run_one,TM2.step,program,TM2.stepAux]
    · have hc : Stacks.stackRunClock program 1 ⟨some .count,v,Preparation.quad n.bits [] markers []⟩=3 := by
        simp [Stacks.stackRunClock,program,Stacks.stackClock]
      rw [hc]
      simp only [List.length_nil,Nat.zero_add,Nat.mul_zero,Nat.add_zero,Nat.mul_one]
      have hp : 1≤(1+n+markers.length)^2 :=
          (show 1≤1+n+markers.length by omega).trans (Nat.le_pow (by decide))
      omega
  | cons bit bits ih =>
    have hS := count_step n bits markers bit v
    obtain ⟨incTicks,hI,hIC⟩ := increment n (true::markers) bits (some bit)
    obtain ⟨tailTicks,hR,hRC⟩ := ih (n+1) (true::markers) none
    have hSI : Stacks.stackRun program (1+incTicks) ⟨some .count,v,Preparation.quad n.bits [] markers (bit::bits)⟩=
        some ⟨some .count,none,Preparation.quad (n+1).bits [] (true::markers) bits⟩ := by
      rw [Stacks.run_add,hS,Option.bind_some,hI]
    refine ⟨(1+incTicks)+tailTicks,?_,?_⟩
    · rw [Stacks.run_add,hSI,Option.bind_some]
      have he : n+1+bits.length=n+(bit::bits).length := by simp; omega
      rw [he] at hR
      simpa only [List.length_cons,List.replicate_succ,List.cons_append,Parsing.marker_cons] using
          hR
    · rw [Stacks.clock_add _ _ _ _ _ hSI,Stacks.clock_add _ 1 _ _ _ hS,count_clock]
      let B := 1+n+2*(bit::bits).length+markers.length
      have hb : 1+(n+1)+2*bits.length+(true::markers).length=B := by dsimp [B]; omega
      rw [hb] at hRC
      have hn := Counter.bits_length_le n
      have hna : 1+n.bits.length≤B := by dsimp [B]; omega
      have hnsq := Nat.mul_le_mul hna hna
      have hl : 2*bits.length+2*markers.length+7≤10*B := by dsimp [B]; omega
      have hp : B≤B^2 := Nat.le_pow (by decide)
      change _≤100*((bit::bits).length+1)*B^2
      simp only [List.length_cons]
      nlinarith only [hIC,hRC,hnsq,hl,hp,Nat.zero_le (B^2)]
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.LengthCounter
namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.RangeBuilder
open Turing Qatlib.Concepts.BitWordCompiler.CanonicalCodec
inductive Label where | next | emit (l : NatEmit.Label) | increment (l : Increment.Label) deriving DecidableEq,Fintype
instance : Inhabited Label := ⟨.next⟩
def emitCode (k : Fin 3) : Fin 4 := if k=0 then 0 else if k=1 then 1 else 3

def program : Label → TM2.Stmt (fun _ : Fin 4 => Bool) Label Symbol
  | .next => .pop 2 (fun _ bit => bit) (.branch (fun bit => bit.isSome) (.goto (fun _ => .emit .count)) .halt)
  | .emit l => StackCall.stmt emitCode Label.emit (.increment .carry) id (fun _ v => v) (NatEmit.program l)
  | .increment l => StackCall.stmt (Fin.castAdd 2) Label.increment .next id (fun _ v => v) (Increment.program l)

def fields (first count : ℕ) : Bits := (List.range' first count).flatMap natBits

theorem fields_succ (first count : ℕ) : fields first (count+1)=natBits first++fields (first+1) count := by
  simp only [fields,List.range'_succ,List.flatMap_cons]

def emitFrame (markers : Bits) (S : Fin 3 → Bits) : Fin 4 → Bits :=
    Preparation.quad (S 0) (S 1) markers (S 2)

theorem emitFrame_at (markers : Bits) (S : Fin 3 → Bits) (k : Fin 3) : emitFrame markers S (emitCode k)=S k := by
  fin_cases k <;> rfl

theorem emitFrame_update (markers : Bits) (S : Fin 3 → Bits) (k : Fin 3) (bits : Bits) :
    emitFrame markers (Function.update S k bits)=Function.update (emitFrame markers S) (emitCode k) bits := by
  funext j
  fin_cases k <;> fin_cases j <;> simp [emitFrame,emitCode,Preparation.quad]

theorem next_step (first : ℕ) (markers output : Bits) (v : Symbol) :
    Stacks.stackRun program 1 ⟨some .next,v,Preparation.quad first.bits [] (true::markers) output⟩=
      some ⟨some (.emit .count),some true,Preparation.quad first.bits [] markers output⟩ ∧
    Stacks.stackRunClock program 1 ⟨some .next,v,Preparation.quad first.bits [] (true::markers) output⟩=
      2*markers.length+4 := by
  constructor
  · simp [Stacks.run_one,TM2.step,program,TM2.stepAux]
  · simp [Stacks.stackRunClock,program,Stacks.stackClock]
    omega

theorem emit (first : ℕ) (markers output : Bits) (v : Symbol) :
    Stacks.stackRun program (4*first.bits.length+5) ⟨some (.emit .count),v,Preparation.quad first.bits [] markers output⟩=
      some ⟨some (.increment .carry),none,Preparation.quad first.bits [] markers ((natBits first).reverse++output)⟩ ∧
    Stacks.stackRunClock program (4*first.bits.length+5) ⟨some (.emit .count),v,Preparation.quad first.bits [] markers output⟩≤
      100*(1+first.bits.length+output.length)^2 := by
  obtain ⟨hr,_⟩ := NatEmit.complete first output v
  have hc := NatEmit.clock_bound first output v
  obtain ⟨hN,hNC⟩ := StackCall.execution emitCode Label.emit (.increment .carry) id (fun _ v => v)
    (emitFrame markers) (emitFrame_at markers) (emitFrame_update markers) (fun _ _ => rfl) (fun _ _ _ => rfl)
    NatEmit.program program (fun _ => rfl) v (4*first.bits.length+5) _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,
    emitFrame,Parsing.triple_zero,Parsing.triple_one,Parsing.triple_two] at hN hNC
  exact ⟨hN,hNC.trans_le hc⟩

theorem increment (first : ℕ) (markers output : Bits) (v : Symbol) :
    ∃ ticks,
      Stacks.stackRun program ticks ⟨some (.increment .carry),v,Preparation.quad first.bits [] markers output⟩=
        some ⟨some .next,none,Preparation.quad (first+1).bits [] markers output⟩ ∧
      Stacks.stackRunClock program ticks ⟨some (.increment .carry),v,Preparation.quad first.bits [] markers output⟩≤
        50*(1+first.bits.length)^2 := by
  obtain ⟨ticks,_,hr,hc⟩ := Increment.complete first.bits [] v
  simp only [List.reverse_nil,List.nil_append,Increment.word_bits,List.length_nil,Nat.add_zero] at hr hc
  obtain ⟨hN,hNC⟩ := StackCall.execution (Fin.castAdd 2) Label.increment .next id (fun _ v => v)
    (Preparation.transferFrame markers output) (Preparation.transferFrame_at markers output)
    (Preparation.transferFrame_update markers output) (fun _ _ => rfl) (fun _ _ _ => rfl)
    Increment.program program (fun _ => rfl) v ticks _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,
    Preparation.transferFrame,Stacks.stackPair_zero,Stacks.stackPair_one] at hN hNC
  exact ⟨ticks,hN,hNC.trans_le hc⟩

theorem complete (first count : ℕ) (output : Bits) (v : Symbol) :
    ∃ ticks,
      Stacks.stackRun program ticks ⟨some .next,v,Preparation.quad first.bits [] (List.replicate count true) output⟩=
        some ⟨none,none,Preparation.quad (first+count).bits [] [] ((fields first count).reverse++output)⟩ ∧
      Stacks.stackRunClock program ticks ⟨some .next,v,Preparation.quad first.bits [] (List.replicate count true) output⟩≤
        1000*(count+1)*(1+first+count+output.length+(fields first count).length)^2 := by
  induction count generalizing first output v with
  | zero =>
    refine ⟨1,?_,?_⟩
    · simp [Stacks.run_one,TM2.step,program,TM2.stepAux,fields]
    · have hc : Stacks.stackRunClock program 1 ⟨some .next,v,Preparation.quad first.bits [] [] output⟩=3 := by
        simp [Stacks.stackRunClock,program,Stacks.stackClock]
      simp only [List.replicate_zero] at hc ⊢
      rw [hc]
      simp only [Nat.zero_add,Nat.add_zero,Nat.mul_one,fields,List.range'_zero,List.flatMap_nil,List.length_nil]
      have hp : 1≤(1+first+output.length)^2 :=
          (show 1≤1+first+output.length by omega).trans (Nat.le_pow (by decide))
      omega
  | succ count ih =>
    obtain ⟨hN,hNC⟩ := next_step first (List.replicate count true) output v
    obtain ⟨hE,hEC⟩ := emit first (List.replicate count true) output (some true)
    obtain ⟨incTicks,hI,hIC⟩ :=
        increment first (List.replicate count true) ((natBits first).reverse++output) none
    obtain ⟨tailTicks,hR,hRC⟩ := ih (first+1) ((natBits first).reverse++output) none
    have eN : Stacks.Execution program _ _ _ :=
        ⟨1,by simpa only [List.replicate_succ] using hN,hNC.le⟩
    have eE : Stacks.Execution program _ _ _ := ⟨4*first.bits.length+5,hE,hEC⟩
    have eI : Stacks.Execution program _ _ _ := ⟨incTicks,hI,hIC⟩
    have eR : Stacks.Execution program _ _ _ := ⟨tailTicks,hR,hRC⟩
    obtain ⟨ticks,hr,hc⟩ := ((eN.trans eE).trans eI).trans eR
    refine ⟨ticks,?_,hc.trans ?_⟩
    · have he : first+1+count=first+(count+1) := by omega
      rw [he] at hr
      simpa only [fields_succ,List.reverse_append,List.append_assoc] using! hr
    · let B := 1+first+(count+1)+output.length+(fields first (count+1)).length
      have hb : 1+(first+1)+count+((natBits first).reverse++output).length+(fields (first+1) count).length=B := by
        dsimp [B]
        simp only [fields_succ,List.length_append,List.length_reverse]
        omega
      rw [hb]
      have hf := Counter.bits_length_le first
      have ha : 1+first.bits.length+output.length≤B := by dsimp [B]; omega
      have ha2 := Nat.mul_le_mul ha ha
      have hi : 1+first.bits.length≤B := by omega
      have hi2 := Nat.mul_le_mul hi hi
      have hl : 2*(List.replicate count true).length+4≤6*B := by
        simp only [List.length_replicate]
        dsimp [B]
        omega
      have hp : B≤B^2 := Nat.le_pow (by decide)
      change _≤1000*(count+1+1)*B^2
      nlinarith only [ha2,hi2,hl,hp,Nat.zero_le (B^2)]

theorem fields_length_bound (first count : ℕ) : (fields first count).length≤count*(2*(first+count)+1) := by
  induction count generalizing first with
  | zero => simp [fields]
  | succ count ih =>
    rw [fields_succ,List.length_append,natBits_length]
    have ht := ih (first+1)
    have hl := Counter.bits_length_le first
    nlinarith
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.RangeBuilder
namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.StateEcho
open Turing Qatlib.Concepts.BitWordCompiler.CanonicalCodec
abbrev Local := ReadonlyRepeat.Local
inductive Slot where | reader | counter | temp | width | markers | payload | block | output deriving DecidableEq,Fintype

def store (reader counter temp width markers payload block output : Bits) : Slot → Bits
  | .reader => reader
  | .counter => counter
  | .temp => temp
  | .width => width
  | .markers => markers
  | .payload => payload
  | .block => block
  | .output => output

def startCode (k : Fin 2) : Slot := if k=0 then .payload else .reader
def parseCode (k : Fin 3) : Slot := if k=0 then .reader else if k=1 then .temp else .payload
def precisionTransferCode (k : Fin 2) : Slot := if k=0 then .payload else .counter
def skipCode (k : Fin 2) : Slot := if k=0 then .reader else .temp
def lengthCode (k : Fin 4) : Slot :=
    if k=0 then .width else if k=1 then .temp else if k=2 then .markers else .payload
def cloneCode (k : Fin 3) : Slot := if k=0 then .width else if k=1 then .temp else .reader
def cloneTransferCode (k : Fin 2) : Slot := if k=0 then .reader else .payload
def widthCode (k : Fin 2) : Slot := if k=0 then .payload else .temp
def emitWidthCode (k : Fin 3) : Slot := if k=0 then .payload else if k=1 then .temp else .output
def precisionCode (k : Fin 2) : Slot := if k=0 then .counter else .temp
def emitPrecisionCode (k : Fin 3) : Slot := if k=0 then .counter else if k=1 then .temp else .output
def emitCountCode (k : Fin 3) : Slot := if k=0 then .width else if k=1 then .temp else .block
def rangeCode (k : Fin 4) : Slot :=
    if k=0 then .width else if k=1 then .temp else if k=2 then .markers else .block
def blockTransferCode (k : Fin 2) : Slot := if k=0 then .block else .payload
def repeatCode (k : Fin 4) : Slot :=
    if k=0 then .counter else if k=1 then .temp else if k=2 then .payload else .output

inductive Label where
  | start (l : Fin 1)
  | parsePrecision (l : Fin 3)
  | transferPrecision (l : Fin 1)
  | skipCount (l : Fin 3)
  | skipDimension (l : Fin 3)
  | parseAddress (l : Fin 3)
  | countAddress (l : LengthCounter.Label)
  | parseAlphabet (l : Fin 3)
  | countAlphabet (l : LengthCounter.Label)
  | drainReader (l : Fin 1)
  | cloneWidth (l : NatEmit.Label)
  | transferWidthClone (l : Fin 1)
  | incrementWidth (l : Increment.Label)
  | emitWidth (l : NatEmit.Label)
  | drainWidthClone (l : Fin 1)
  | incrementPrecision (l : Increment.Label)
  | shiftPrecision
  | emitPrecision (l : NatEmit.Label)
  | unshiftPrecision
  | blockStart
  | emitWidthCount (l : NatEmit.Label)
  | drainWidth (l : Fin 1)
  | range (l : RangeBuilder.Label)
  | drainIndex (l : Fin 1)
  | transferBlock (l : Fin 1)
  | repeat (l : ReadonlyRepeat.Label)
  | done
  deriving DecidableEq,Fintype
instance : Inhabited Label := ⟨.start 0⟩

def program : Label → TM2.Stmt (fun _ : Slot => Bool) Label Local
  | .start l => StackCall.stmt startCode Label.start (.parsePrecision 0) ReadonlyRepeat.getIO ReadonlyRepeat.putIO (Stacks.transferProgram l)
  | .parsePrecision l => StackCall.stmt parseCode Label.parsePrecision (.transferPrecision 0) ReadonlyRepeat.getIO ReadonlyRepeat.putIO (Parsing.natProgram l)
  | .transferPrecision l => StackCall.stmt precisionTransferCode Label.transferPrecision (.skipCount 0) ReadonlyRepeat.getIO ReadonlyRepeat.putIO (Stacks.transferProgram l)
  | .skipCount l => StackCall.stmt skipCode Label.skipCount (.skipDimension 0) ReadonlyRepeat.getIO ReadonlyRepeat.putIO (Parsing.skipNatProgram l)
  | .skipDimension l => StackCall.stmt skipCode Label.skipDimension (.parseAddress 0) ReadonlyRepeat.getIO ReadonlyRepeat.putIO (Parsing.skipNatProgram l)
  | .parseAddress l => StackCall.stmt parseCode Label.parseAddress (.countAddress .count) ReadonlyRepeat.getIO ReadonlyRepeat.putIO (Parsing.natProgram l)
  | .countAddress l => StackCall.stmt lengthCode Label.countAddress (.parseAlphabet 0) ReadonlyRepeat.getIO ReadonlyRepeat.putIO (LengthCounter.program l)
  | .parseAlphabet l => StackCall.stmt parseCode Label.parseAlphabet (.countAlphabet .count) ReadonlyRepeat.getIO ReadonlyRepeat.putIO (Parsing.natProgram l)
  | .countAlphabet l => StackCall.stmt lengthCode Label.countAlphabet (.drainReader 0) ReadonlyRepeat.getIO ReadonlyRepeat.putIO (LengthCounter.program l)
  | .drainReader l => StackCall.stmt (fun _ : Fin 1 => Slot.reader) Label.drainReader (.cloneWidth .emit) ReadonlyRepeat.getIO ReadonlyRepeat.putIO (Normalization.drainProgram l)
  | .cloneWidth l => StackCall.stmt cloneCode Label.cloneWidth (.transferWidthClone 0) ReadonlyRepeat.getIO ReadonlyRepeat.putIO (NatEmit.program l)
  | .transferWidthClone l => StackCall.stmt cloneTransferCode Label.transferWidthClone (.incrementWidth .carry) ReadonlyRepeat.getIO ReadonlyRepeat.putIO (Stacks.transferProgram l)
  | .incrementWidth l => StackCall.stmt widthCode Label.incrementWidth (.emitWidth .count) ReadonlyRepeat.getIO ReadonlyRepeat.putIO (Increment.program l)
  | .emitWidth l => StackCall.stmt emitWidthCode Label.emitWidth (.drainWidthClone 0) ReadonlyRepeat.getIO ReadonlyRepeat.putIO (NatEmit.program l)
  | .drainWidthClone l => StackCall.stmt (fun _ : Fin 1 => Slot.payload) Label.drainWidthClone (.incrementPrecision .carry) ReadonlyRepeat.getIO ReadonlyRepeat.putIO (Normalization.drainProgram l)
  | .incrementPrecision l => StackCall.stmt precisionCode Label.incrementPrecision .shiftPrecision ReadonlyRepeat.getIO ReadonlyRepeat.putIO (Increment.program l)
  | .shiftPrecision => .push .counter (fun _ => false) (.goto (fun _ => .emitPrecision .count))
  | .emitPrecision l => StackCall.stmt emitPrecisionCode Label.emitPrecision .unshiftPrecision ReadonlyRepeat.getIO ReadonlyRepeat.putIO (NatEmit.program l)
  | .unshiftPrecision => .pop .counter (fun v _ => v) (.goto (fun _ => .blockStart))
  | .blockStart => Stacks.pushBits Slot.block ([0,0,3,0].flatMap natBits) (.goto (fun _ => .emitWidthCount .count))
  | .emitWidthCount l => StackCall.stmt emitCountCode Label.emitWidthCount (.drainWidth 0) ReadonlyRepeat.getIO ReadonlyRepeat.putIO (NatEmit.program l)
  | .drainWidth l => StackCall.stmt (fun _ : Fin 1 => Slot.width) Label.drainWidth (.range .next) ReadonlyRepeat.getIO ReadonlyRepeat.putIO (Normalization.drainProgram l)
  | .range l => StackCall.stmt rangeCode Label.range (.drainIndex 0) ReadonlyRepeat.getIO ReadonlyRepeat.putIO (RangeBuilder.program l)
  | .drainIndex l => StackCall.stmt (fun _ : Fin 1 => Slot.width) Label.drainIndex (.transferBlock 0) ReadonlyRepeat.getIO ReadonlyRepeat.putIO (Normalization.drainProgram l)
  | .transferBlock l => StackCall.stmt blockTransferCode Label.transferBlock (.repeat (.counter .borrow)) ReadonlyRepeat.getIO ReadonlyRepeat.putIO (Stacks.transferProgram l)
  | .repeat l => StackCall.stmt repeatCode Label.repeat .done id (fun _ v => v) (ReadonlyRepeat.program l)
  | .done => .halt

def input (k count dimension addresses alphabet : ℕ) (tail : Bits) : Bits :=
  natBits k++(natBits count++(natBits dimension++(natBits addresses++(natBits alphabet++tail))))
def width (addresses alphabet : ℕ) : ℕ := addresses.bits.length+alphabet.bits.length
def header (m k : ℕ) : Bits := [m+1,2*(k+1)].flatMap natBits
def block (m : ℕ) : Bits := ([0,0,3,0,m]++List.range m).flatMap natBits
def output (m k : ℕ) : Bits := header m k++(List.replicate (k+1) (block m)).flatten

def startFrame (counter temp width markers block output : Bits) (S : Fin 2 → Bits) : Slot → Bits :=
    store (S 1) counter temp width markers (S 0) block output

theorem startFrame_at (counter temp width markers block output : Bits) (S : Fin 2 → Bits) (k : Fin 2) :
    startFrame counter temp width markers block output S (startCode k)=S k := by fin_cases k <;> rfl

theorem startFrame_update (counter temp width markers block output : Bits) (S : Fin 2 → Bits) (k : Fin 2) (bits : Bits) :
    startFrame counter temp width markers block output (Function.update S k bits)=Function.update (startFrame counter temp width markers block output S) (startCode k) bits := by
  funext j
  fin_cases k <;> cases j <;> simp [startFrame,startCode,store]

def parseFrame (counter width markers block output : Bits) (S : Fin 3 → Bits) : Slot → Bits :=
    store (S 0) counter (S 1) width markers (S 2) block output

theorem parseFrame_at (counter width markers block output : Bits) (S : Fin 3 → Bits) (k : Fin 3) :
    parseFrame counter width markers block output S (parseCode k)=S k := by fin_cases k <;> rfl

theorem parseFrame_update (counter width markers block output : Bits) (S : Fin 3 → Bits) (k : Fin 3) (bits : Bits) :
    parseFrame counter width markers block output (Function.update S k bits)=Function.update (parseFrame counter width markers block output S) (parseCode k) bits := by
  funext j
  fin_cases k <;> cases j <;> simp [parseFrame,parseCode,store]

def precisionTransferFrame (reader temp width markers block output : Bits) (S : Fin 2 → Bits) :
    Slot → Bits := store reader (S 1) temp width markers (S 0) block output

theorem precisionTransferFrame_at (reader temp width markers block output : Bits) (S : Fin 2 → Bits) (k : Fin 2) :
    precisionTransferFrame reader temp width markers block output S (precisionTransferCode k)=S k := by fin_cases k <;> rfl

theorem precisionTransferFrame_update (reader temp width markers block output : Bits) (S : Fin 2 → Bits) (k : Fin 2) (bits : Bits) :
    precisionTransferFrame reader temp width markers block output (Function.update S k bits)=Function.update (precisionTransferFrame reader temp width markers block output S) (precisionTransferCode k) bits := by
  funext j
