theorem start (raw : Bits) (v : Local) :
    Stacks.stackRun program (raw.length+1) ⟨some (.start 0),v,store [] [] [] [] [] raw.reverse [] []⟩=
      some ⟨some (.parsePrecision 0),ReadonlyRepeat.putIO v none,store raw [] [] [] [] [] [] []⟩ ∧
    Stacks.stackRunClock program (raw.length+1) ⟨some (.start 0),v,store [] [] [] [] [] raw.reverse [] []⟩=
      raw.length*(2*raw.length+5)+3 := by
  have hr := Stacks.transfer_run raw.reverse [] (ReadonlyRepeat.getIO v)
  simp only [List.length_reverse,List.reverse_reverse,List.append_nil] at hr
  obtain ⟨hN,hNC⟩ := StackCall.execution startCode Label.start (.parsePrecision 0) ReadonlyRepeat.getIO ReadonlyRepeat.putIO
    (startFrame [] [] [] [] [] []) (startFrame_at [] [] [] [] [] []) (startFrame_update [] [] [] [] [] [])
    (fun _ _ => rfl) (fun _ _ _ => rfl) Stacks.transferProgram program (fun _ => rfl) v (raw.length+1) _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,
    startFrame,Stacks.stackPair_zero,Stacks.stackPair_one,ReadonlyRepeat.putIO_get] at hN hNC
  exact ⟨hN,hNC.trans (by simpa only [List.length_reverse,List.length_nil,Nat.add_zero] using Stacks.transfer_clock raw.reverse [] (ReadonlyRepeat.getIO v))⟩

theorem parse_call (code : Fin 3 → Label) (returnTo : Label)
    (hcode : ∀ l, program (code l)=StackCall.stmt parseCode code returnTo ReadonlyRepeat.getIO ReadonlyRepeat.putIO (Parsing.natProgram l))
    (n : ℕ) (rest counter width markers block output : Bits) (v : Local) :
    Stacks.stackRun program (2*n.bits.length+3) ⟨some (code 0),v,store (natBits n++rest) counter [] width markers [] block output⟩=
      some ⟨some returnTo,ReadonlyRepeat.putIO v none,store rest counter [] width markers n.bits.reverse block output⟩ ∧
    Stacks.stackRunClock program (2*n.bits.length+3) ⟨some (code 0),v,store (natBits n++rest) counter [] width markers [] block output⟩≤
      40*(1+(natBits n++rest).length)^2 := by
  have hr := Parsing.nat_run n rest [] (ReadonlyRepeat.getIO v)
  have hc := Parsing.nat_clock_bound n rest [] (ReadonlyRepeat.getIO v)
  simp only [List.append_nil,List.length_nil,Nat.add_zero] at hr hc
  obtain ⟨hN,hNC⟩ := StackCall.execution parseCode code returnTo ReadonlyRepeat.getIO ReadonlyRepeat.putIO
    (parseFrame counter width markers block output) (parseFrame_at counter width markers block output) (parseFrame_update counter width markers block output)
    (fun _ _ => rfl) (fun _ _ _ => rfl) Parsing.natProgram program hcode v (2*n.bits.length+3) _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,
    parseFrame,Parsing.triple_zero,Parsing.triple_one,Parsing.triple_two,ReadonlyRepeat.putIO_get] at hN hNC
  exact ⟨hN,hNC.trans_le hc⟩

theorem transfer_precision (bits reader width markers : Bits) (v : Local) :
    Stacks.stackRun program (bits.length+1) ⟨some (.transferPrecision 0),v,store reader [] [] width markers bits.reverse [] []⟩=
      some ⟨some (.skipCount 0),ReadonlyRepeat.putIO v none,store reader bits [] width markers [] [] []⟩ ∧
    Stacks.stackRunClock program (bits.length+1) ⟨some (.transferPrecision 0),v,store reader [] [] width markers bits.reverse [] []⟩=
      bits.length*(2*bits.length+5)+3 := by
  have hr := Stacks.transfer_run bits.reverse [] (ReadonlyRepeat.getIO v)
  simp only [List.length_reverse,List.reverse_reverse,List.append_nil] at hr
  obtain ⟨hN,hNC⟩ := StackCall.execution precisionTransferCode Label.transferPrecision (.skipCount 0) ReadonlyRepeat.getIO ReadonlyRepeat.putIO
    (precisionTransferFrame reader [] width markers [] []) (precisionTransferFrame_at reader [] width markers [] [])
    (precisionTransferFrame_update reader [] width markers [] []) (fun _ _ => rfl) (fun _ _ _ => rfl)
    Stacks.transferProgram program (fun _ => rfl) v (bits.length+1) _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,
    precisionTransferFrame,Stacks.stackPair_zero,Stacks.stackPair_one,ReadonlyRepeat.putIO_get] at hN hNC
  exact ⟨hN,hNC.trans (by simpa only [List.length_reverse,List.length_nil,Nat.add_zero] using Stacks.transfer_clock bits.reverse [] (ReadonlyRepeat.getIO v))⟩

theorem skip_call (code : Fin 3 → Label) (returnTo : Label)
    (hcode : ∀ l, program (code l)=StackCall.stmt skipCode code returnTo ReadonlyRepeat.getIO ReadonlyRepeat.putIO (Parsing.skipNatProgram l))
    (n : ℕ) (rest counter width markers : Bits) (v : Local) :
