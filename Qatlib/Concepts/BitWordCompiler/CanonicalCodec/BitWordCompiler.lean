theorem binaryValue_bits (n : ℕ) : binaryValue n.bits = n := by
  induction n using Nat.binaryRec' with
  | zero => rfl
  | bit b n h ih =>
    rw [Nat.bits_append_bit n b h]
    simp only [binaryValue, List.foldr_cons] at ih ⊢
    rw [ih]
    cases b <;> simp [Nat.bit]

def readSize : Bits → Option (ℕ × Bits)
  | [] => none
  | false :: rest => some (0,rest)
  | true :: rest => do
      let (n,tail) ← readSize rest
      pure (n+1,tail)

theorem readSize_complete (n : ℕ) (rest : Bits) :
    readSize (List.replicate n true ++ false::rest) = some (n,rest) := by
  induction n with
  | zero => rfl
  | succ n ih => simp [List.replicate_succ, readSize, ih]

theorem readSize_sound (input : Bits) (n : ℕ) (rest : Bits)
    (h : readSize input = some (n,rest)) :
    input = List.replicate n true ++ false::rest := by
  induction input generalizing n rest with
  | nil => simp [readSize] at h
  | cons b xs ih =>
    cases b with
    | false =>
      simp only [readSize, Option.some.injEq, Prod.mk.injEq] at h
      rcases h with ⟨rfl,rfl⟩
      rfl
    | true =>
      cases he : readSize xs with
      | none => simp [readSize, he] at h
      | some pair =>
        rcases pair with ⟨k,tail⟩
        simp only [readSize, he, Option.bind_eq_bind, Option.bind_some, pure, Option.some.injEq,
            Prod.mk.injEq] at h
        rcases h with ⟨rfl,rfl⟩
        rw [ih k tail he]
        simp [List.replicate_succ]

def readNat (input : Bits) : Option (ℕ × Bits) := do
  let (n,rest) ← readSize input
  if n ≤ rest.length then
    let payload := rest.take n
    let value := binaryValue payload
    if value.bits = payload then
      pure (value,rest.drop n)
    else none
  else none

theorem readNat_complete (n : ℕ) (tail : Bits) :
    readNat (natBits n ++ tail) = some (n,tail) := by
  have he : natBits n ++ tail = List.replicate n.bits.length true ++ false::(n.bits++tail) := by
    simp [natBits, List.append_assoc]
  rw [he, readNat, readSize_complete]
  simp [binaryValue_bits]

theorem readNat_sound (input : Bits) (n : ℕ) (tail : Bits)
    (h : readNat input = some (n,tail)) : input = natBits n ++ tail := by
  unfold readNat at h
  cases he : readSize input with
  | none => simp [he] at h
  | some pair =>
    rcases pair with ⟨k,rest⟩
    simp only [he, Option.bind_eq_bind, Option.bind_some] at h
    split_ifs at h with hlen hcanonical
    · simp only [pure, Option.some.injEq, Prod.mk.injEq] at h
      rcases h with ⟨rfl,rfl⟩
      have hk : (binaryValue (rest.take k)).bits.length = k := by
        rw [hcanonical, List.length_take, Nat.min_eq_left hlen]
      rw [readSize_sound input k rest he, natBits, hk, hcanonical]
      simp only [List.append_assoc, List.cons_append, List.nil_append, List.take_append_drop]

theorem readNat_eq_some_iff (input : Bits) (n : ℕ) (tail : Bits) :
    readNat input = some (n,tail) ↔ input = natBits n ++ tail := by
  constructor
  · exact readNat_sound input n tail
  · rintro rfl
    exact readNat_complete n tail

theorem wordBits_length (w : Word) :
    (wordBits w).length =
      (([w.width,w.ops.length] ++ w.ops.flatMap fields).map
        (fun n => 2*n.bits.length+1)).sum := by
  simp only [wordBits, List.length_flatMap]
  congr 1
  apply List.map_congr_left
  intro n _
  simp only [natBits, List.length_append, List.length_replicate, List.length_singleton]
  omega

structure PrefixCodec (α : Type) where
  encode : α → Bits
  parse : Bits → Option (α × Bits)
  complete : ∀ a tail, parse (encode a ++ tail) = some (a,tail)
  sound : ∀ input a tail, parse input = some (a,tail) → input = encode a ++ tail

def natCodec : PrefixCodec ℕ :=
  ⟨natBits, readNat, readNat_complete, readNat_sound⟩

def PrefixCodec.prod {α β : Type} (C : PrefixCodec α) (D : PrefixCodec β) :
    PrefixCodec (α × β) where
  encode p := C.encode p.1 ++ D.encode p.2
  parse input := do
    let (a,rest) ← C.parse input
    let (b,tail) ← D.parse rest
    pure ((a,b),tail)
  complete := by
    rintro ⟨a,b⟩ tail
    simp [List.append_assoc, C.complete, D.complete]
  sound := by
    rintro input ⟨a,b⟩ tail h
    cases hc : C.parse input with
    | none => simp [hc] at h
    | some pair =>
      rcases pair with ⟨a',rest⟩
      cases hd : D.parse rest with
      | none => simp [hc, hd] at h
      | some pair =>
        rcases pair with ⟨b',tail'⟩
        simp only [hc, hd, Option.bind_eq_bind, Option.bind_some, pure, Option.some.injEq,
            Prod.mk.injEq] at h
        rcases h with ⟨⟨rfl,rfl⟩,rfl⟩
        rw [C.sound input a' rest hc, D.sound rest b' tail' hd]
        exact (List.append_assoc _ _ _).symm

def PrefixCodec.map {α β : Type} (C : PrefixCodec α) (e : α ≃ β) : PrefixCodec β where
  encode b := C.encode (e.symm b)
  parse input := (C.parse input).map (fun p => (e p.1,p.2))
  complete := by
    intro b tail
    simp [C.complete]
  sound := by
    intro input b tail h
    cases hc : C.parse input with
    | none => simp [hc] at h
    | some pair =>
      rcases pair with ⟨a,rest⟩
      simp only [hc, Option.map_some, Option.some.injEq, Prod.mk.injEq] at h
      rcases h with ⟨rfl,rfl⟩
      simpa only [Equiv.symm_apply_apply] using C.sound input a rest hc

def readMany {α : Type} (C : PrefixCodec α) : ℕ → Bits → Option (List α × Bits)
  | 0,input => some ([],input)
  | n+1,input => do
      let (a,rest) ← C.parse input
      let (xs,tail) ← readMany C n rest
      pure (a::xs,tail)

theorem readMany_complete {α : Type} (C : PrefixCodec α) (xs : List α) (tail : Bits) :
    readMany C xs.length (xs.flatMap C.encode ++ tail) = some (xs,tail) := by
  induction xs with
  | nil => rfl
  | cons a xs ih => simp [readMany, List.append_assoc, C.complete, ih]

theorem readMany_sound {α : Type} (C : PrefixCodec α) (n : ℕ) (input : Bits)
    (xs : List α) (tail : Bits) (h : readMany C n input = some (xs,tail)) :
    xs.length = n ∧ input = xs.flatMap C.encode ++ tail := by
  induction n generalizing input xs tail with
  | zero =>
    simp only [readMany, Option.some.injEq, Prod.mk.injEq] at h
    rcases h with ⟨rfl,rfl⟩
    exact ⟨rfl,rfl⟩
  | succ n ih =>
    cases hc : C.parse input with
    | none => simp [readMany, hc] at h
    | some pair =>
      rcases pair with ⟨a,rest⟩
      cases hr : readMany C n rest with
      | none => simp [readMany, hc, hr] at h
      | some pair =>
        rcases pair with ⟨ys,suffix⟩
        simp only [readMany, hc, hr, Option.bind_eq_bind, Option.bind_some, pure,
            Option.some.injEq, Prod.mk.injEq] at h
        rcases h with ⟨rfl,rfl⟩
        obtain ⟨hlen,hbits⟩ := ih rest ys suffix hr
        refine ⟨congrArg Nat.succ hlen, ?_⟩
        rw [C.sound input a rest hc, hbits]
        simp [List.append_assoc]

def PrefixCodec.list {α : Type} (C : PrefixCodec α) : PrefixCodec (List α) where
  encode xs := natBits xs.length ++ xs.flatMap C.encode
  parse input := do
    let (n,rest) ← readNat input
    readMany C n rest
  complete := by
    intro xs tail
    simp [List.append_assoc, readNat_complete, readMany_complete]
  sound := by
    intro input xs tail h
    cases hn : readNat input with
    | none => simp [hn] at h
    | some pair =>
      rcases pair with ⟨n,rest⟩
      simp only [hn, Option.bind_eq_bind, Option.bind_some] at h
      obtain ⟨hlen,hbits⟩ := readMany_sound C n rest xs tail h
      rw [readNat_sound input n rest hn, ← hlen, hbits, List.append_assoc]

def boolCodec : PrefixCodec Bool where
  encode b := natBits (if b then 1 else 0)
  parse input := do
    let (n,rest) ← readNat input
    match n with
    | 0 => some (false,rest)
    | 1 => some (true,rest)
    | _ => none
  complete := by
    intro b tail
    cases b <;> simp only [Bool.false_eq_true, ↓reduceIte, readNat_complete,
      Option.bind_eq_bind, Option.bind_some]
  sound := by
    intro input b tail h
    cases hn : readNat input with
    | none => simp [hn] at h
    | some pair =>
      rcases pair with ⟨n,rest⟩
      simp only [hn, Option.bind_eq_bind, Option.bind_some] at h
      rcases n with _|_|n
      · simp only [Option.some.injEq, Prod.mk.injEq] at h
        rcases h with ⟨rfl,rfl⟩
        exact readNat_sound input 0 rest hn
      · simp only [Option.some.injEq, Prod.mk.injEq] at h
        rcases h with ⟨rfl,rfl⟩
        exact readNat_sound input 1 rest hn
      · simp at h

def optionNatEquiv : ℕ ≃ Option ℕ where
  toFun n := match n with | 0 => none | n+1 => some n
  invFun n := match n with | none => 0 | some n => n+1
  left_inv := by intro n; cases n <;> rfl
  right_inv := by intro n; cases n <;> rfl

def optionNatCodec : PrefixCodec (Option ℕ) := natCodec.map optionNatEquiv

def parseMap {α β : Type} (C : PrefixCodec α) (f : α → β) (input : Bits) :
    Option (β × Bits) := (C.parse input).map (fun p => (f p.1,p.2))

theorem parseMap_complete {α β : Type} (C : PrefixCodec α) (f : α → β) (a : α) (tail : Bits) :
    parseMap C f (C.encode a ++ tail) = some (f a,tail) := by
  simp [parseMap, C.complete]

theorem parseMap_sound {α β : Type} (C : PrefixCodec α) (f : α → β)
    (input : Bits) (b : β) (tail : Bits) (h : parseMap C f input = some (b,tail)) :
    ∃ a, C.parse input = some (a,tail) ∧ f a = b := by
  unfold parseMap at h
  cases hc : C.parse input with
  | none => simp [hc] at h
  | some pair =>
    rcases pair with ⟨a,rest⟩
    simp only [hc, Option.map_some, Option.some.injEq, Prod.mk.injEq] at h
    rcases h with ⟨rfl,rfl⟩
    exact ⟨a,rfl,rfl⟩

def phaseBody : PrefixCodec (ℕ × ℕ × ℕ × Bool) :=
  natCodec.prod (natCodec.prod (natCodec.prod boolCodec))

def swapBody : PrefixCodec (ℕ × ℕ) := natCodec.prod natCodec

def oracleBody : PrefixCodec (ℕ × Option ℕ × Bool × List ℕ) :=
  natCodec.prod (optionNatCodec.prod (boolCodec.prod natCodec.list))

def opBits (op : Opcode) : Bits := (fields op).flatMap natBits

def phaseOf (p : ℕ × ℕ × ℕ × Bool) : Opcode := .phase p.1 p.2.1 p.2.2.1 p.2.2.2
def swapOf (p : ℕ × ℕ) : Opcode := .swap p.1 p.2
def oracleOf (p : ℕ × Option ℕ × Bool × List ℕ) : Opcode :=
  .oracle p.1 p.2.1 p.2.2.1 p.2.2.2

def readOpcode (input : Bits) : Option (Opcode × Bits) := do
  let (tag,rest) ← readNat input
  match tag with
  | 0 => parseMap natCodec Opcode.hadamard rest
  | 1 => parseMap phaseBody phaseOf rest
  | 2 => parseMap swapBody swapOf rest
  | 3 => parseMap oracleBody oracleOf rest
  | _ => none

theorem opBits_hadamard (a : ℕ) : opBits (.hadamard a) = natBits 0 ++ natCodec.encode a := by
  simp [opBits, fields, natCodec]

theorem opBits_phase (p : ℕ × ℕ × ℕ × Bool) :
    opBits (phaseOf p) = natBits 1 ++ phaseBody.encode p := by
  simp [opBits, phaseOf, fields, phaseBody, PrefixCodec.prod, natCodec, boolCodec]

theorem opBits_swap (p : ℕ × ℕ) : opBits (swapOf p) = natBits 2 ++ swapBody.encode p := by
  simp [opBits, swapOf, fields, swapBody, PrefixCodec.prod, natCodec]

theorem opBits_oracle (p : ℕ × Option ℕ × Bool × List ℕ) :
    opBits (oracleOf p) = natBits 3 ++ oracleBody.encode p := by
  rcases p with ⟨slot, control, adj, ws⟩
  cases control <;> simp [opBits, oracleOf, fields, oracleBody, PrefixCodec.prod,
    PrefixCodec.list, PrefixCodec.map, optionNatCodec, optionNatEquiv, natCodec, boolCodec]

theorem readOpcode_complete (op : Opcode) (tail : Bits) :
    readOpcode (opBits op ++ tail) = some (op,tail) := by
  cases op with
  | hadamard a =>
    rw [opBits_hadamard, List.append_assoc]
    simp only [readOpcode, readNat_complete, Option.bind_eq_bind, Option.bind_some]
    exact parseMap_complete natCodec Opcode.hadamard a tail
  | phase a b k adj =>
    change readOpcode (opBits (phaseOf (a,b,k,adj)) ++ tail) = _
    rw [opBits_phase, List.append_assoc]
    simp only [readOpcode, readNat_complete, Option.bind_eq_bind, Option.bind_some]
    exact parseMap_complete phaseBody phaseOf (a,b,k,adj) tail
  | swap a b =>
    change readOpcode (opBits (swapOf (a,b)) ++ tail) = _
    rw [opBits_swap, List.append_assoc]
    simp only [readOpcode, readNat_complete, Option.bind_eq_bind, Option.bind_some]
    exact parseMap_complete swapBody swapOf (a,b) tail
  | oracle slot control adj ws =>
    change readOpcode (opBits (oracleOf (slot,control,adj,ws)) ++ tail) = _
    rw [opBits_oracle, List.append_assoc]
    simp only [readOpcode, readNat_complete, Option.bind_eq_bind, Option.bind_some]
    exact parseMap_complete oracleBody oracleOf (slot,control,adj,ws) tail

theorem tagged_sound {α : Type} (C : PrefixCodec α) (f : α → Opcode) (tag : ℕ)
    (hencode : ∀ a, opBits (f a) = natBits tag ++ C.encode a)
    (input rest : Bits) (op : Opcode) (tail : Bits)
    (hn : readNat input = some (tag,rest)) (h : parseMap C f rest = some (op,tail)) :
    input = opBits op ++ tail := by
  obtain ⟨a,hC,rfl⟩ := parseMap_sound C f rest op tail h
  rw [readNat_sound input tag rest hn, C.sound rest a tail hC, hencode, List.append_assoc]

theorem readOpcode_sound (input : Bits) (op : Opcode) (tail : Bits)
    (h : readOpcode input = some (op,tail)) : input = opBits op ++ tail := by
  unfold readOpcode at h
  cases hn : readNat input with
  | none => simp [hn] at h
  | some pair =>
    rcases pair with ⟨tag,rest⟩
    simp only [hn, Option.bind_eq_bind, Option.bind_some] at h
    rcases tag with _|_|_|_|tag
    · exact tagged_sound natCodec Opcode.hadamard 0 opBits_hadamard input rest op tail hn h
    · exact tagged_sound phaseBody phaseOf 1 opBits_phase input rest op tail hn h
    · exact tagged_sound swapBody swapOf 2 opBits_swap input rest op tail hn h
    · exact tagged_sound oracleBody oracleOf 3 opBits_oracle input rest op tail hn h
    · simp at h

def opcodeCodec : PrefixCodec Opcode := ⟨opBits, readOpcode, readOpcode_complete, readOpcode_sound⟩

def wordEquiv : (ℕ × List Opcode) ≃ Word where
  toFun p := ⟨p.1,p.2⟩
  invFun w := (w.width,w.ops)
  left_inv := by intro p; cases p; rfl
  right_inv := by intro w; cases w; rfl

def wordCodec : PrefixCodec Word := (natCodec.prod opcodeCodec.list).map wordEquiv

theorem wordCodec_encode (w : Word) : wordCodec.encode w = wordBits w := by
  simp [wordCodec, PrefixCodec.map, wordEquiv, PrefixCodec.prod, PrefixCodec.list,
    natCodec, opcodeCodec, wordBits, List.flatMap_assoc]
  rfl

def legalOpcodeCheck (width : ℕ) : Opcode → Bool
  | .hadamard a => decide (a < width)
  | .phase a b _ _ => decide (a < width) && decide (b < width)
  | .swap a b => decide (a < width) && decide (b < width)
  | .oracle _ c _ ws => ws.all (fun a => decide (a < width)) &&
      (decide ws.Nodup && match c with
        | none => true
        | some a => decide (a < width ∧ a ∉ ws))

theorem legalOpcodeCheck_spec (width : ℕ) (op : Opcode) :
    legalOpcodeCheck width op = true ↔ legalOpcode width op := by
  cases op with
  | hadamard a => simp [legalOpcodeCheck, legalOpcode]
  | phase a b k adj => simp [legalOpcodeCheck, legalOpcode]
  | swap a b => simp [legalOpcodeCheck, legalOpcode]
  | oracle slot control adj ws =>
    cases control <;> simp [legalOpcodeCheck, legalOpcode, List.all_eq_true]

def legalWordCheck (w : Word) : Bool := w.ops.all (legalOpcodeCheck w.width)

theorem legalWordCheck_spec (w : Word) : legalWordCheck w = true ↔ Legal w := by
  simp only [legalWordCheck, List.all_eq_true, legalOpcodeCheck_spec, Legal]

def parseWord (input : Bits) : Option (Word × Bits) := do
  let (w,tail) ← wordCodec.parse input
  if legalWordCheck w = true then pure (w,tail) else none

theorem parseWord_complete (w : Word) (tail : Bits) (h : Legal w) :
    parseWord (wordBits w ++ tail) = some (w,tail) := by
  rw [← wordCodec_encode]
  simp [parseWord, wordCodec.complete, (legalWordCheck_spec w).mpr h]

theorem parseWord_sound (input : Bits) (w : Word) (tail : Bits)
    (h : parseWord input = some (w,tail)) : Legal w ∧ input = wordBits w ++ tail := by
  unfold parseWord at h
  cases hp : wordCodec.parse input with
  | none => simp [hp] at h
  | some pair =>
    rcases pair with ⟨w',tail'⟩
    simp only [hp, Option.bind_eq_bind, Option.bind_some] at h
    split_ifs at h with hlegal
    simp only [pure, Option.some.injEq, Prod.mk.injEq] at h
    rcases h with ⟨rfl,rfl⟩
    exact ⟨(legalWordCheck_spec _).mp hlegal, by
      simpa only [wordCodec_encode] using wordCodec.sound input w' tail' hp⟩

theorem parseWord_eq_some_iff (input : Bits) (w : Word) (tail : Bits) :
    parseWord input = some (w,tail) ↔ Legal w ∧ input = wordBits w ++ tail := by
  constructor
  · exact parseWord_sound input w tail
  · rintro ⟨hw,rfl⟩
    exact parseWord_complete w tail hw

def decodeWord (input : Bits) : Option Word := do
  let (w,tail) ← parseWord input
  if tail = [] then pure w else none

theorem decodeWord_eq_some_iff (input : Bits) (w : Word) :
    decodeWord input = some w ↔ Legal w ∧ input = wordBits w := by
  constructor
  · intro h
    unfold decodeWord at h
    cases hp : parseWord input with
    | none => simp [hp] at h
    | some pair =>
      rcases pair with ⟨w',tail⟩
      simp only [hp, Option.bind_eq_bind, Option.bind_some] at h
      split_ifs at h with hnil
      simp only [pure, Option.some.injEq] at h
      subst w'
      obtain ⟨hw,hbits⟩ := parseWord_sound input w tail hp
      exact ⟨hw, by simpa only [hnil, List.append_nil] using hbits⟩
  · rintro ⟨hw,rfl⟩
    have hp : parseWord (wordBits w) = some (w,[]) := by
      simpa only [List.append_nil] using parseWord_complete w [] hw
    simp [decodeWord, hp]

theorem canonical_codec_data :
    ∃ (parse : Bits → Option (Word × Bits)) (decode : Bits → Option Word),
      (∀ w suffix, Legal w → parse (wordBits w ++ suffix) = some (w,suffix)) ∧
      (∀ input w suffix, parse input = some (w,suffix) ↔ Legal w ∧ input = wordBits w ++ suffix) ∧
      (∀ input w, decode input = some w ↔ Legal w ∧ input = wordBits w) ∧
      (∀ w, (wordBits w).length =
        (([w.width,w.ops.length] ++ w.ops.flatMap fields).map (fun n => 2*n.bits.length+1)).sum) :=
  ⟨parseWord,decodeWord,parseWord_complete,parseWord_eq_some_iff,decodeWord_eq_some_iff,wordBits_length⟩

theorem natBits_length (n : ℕ) : (natBits n).length = 2*n.bits.length+1 := by
  simp only [natBits, List.length_append, List.length_replicate, List.length_singleton]
  omega

theorem flatNatBits_length_ge (xs : List ℕ) : xs.length ≤ (xs.flatMap natBits).length := by
  induction xs with
  | nil => rfl
  | cons n xs ih =>
    simp only [List.length_cons, List.flatMap_cons, List.length_append, natBits_length]
    omega

theorem headPosition_bounds {q : ℕ}
    (M : Turing.TM0.Machine (Option Bool) (Fin (q+1))) (input : Bits) (t : ℕ) :
    -(t : ℤ) ≤ headPosition M input t ∧ headPosition M input t ≤ (t : ℤ) := by
  induction t with
  | zero => simp [headPosition]
  | succ t ih =>
    simp only [headPosition]
    cases hc : BitMachineAfter M (input.map some) t with
    | none => simp only []; omega
    | some cfg =>
      cases hm : M cfg.q cfg.Tape.head with
      | none => simp only [hm]; omega
      | some result =>
        rcases result with ⟨label,stmt⟩
        cases stmt with
        | write value => simp only [hm]; omega
        | move dir => cases dir <;> simp only [hm] <;> omega

end Qatlib.Concepts.BitWordCompiler.CanonicalCodec

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM
open Turing
abbrev Symbol := Option Bool

def stmtOffset : TM0.Stmt Symbol → ℤ
  | .move .left => -1
  | .move .right => 1
  | .write _ => 0

def nextOffset {Λ : Type} [Inhabited Λ] (M : TM0.Machine Symbol Λ) (cfg : TM0.Cfg Symbol Λ) : ℤ :=
  match M cfg.q cfg.Tape.head with
  | some (_,stmt) => stmtOffset stmt
  | none => 0

def run {Λ : Type} [Inhabited Λ] (M : TM0.Machine Symbol Λ)
    (t : ℕ) (cfg : TM0.Cfg Symbol Λ) : Option (TM0.Cfg Symbol Λ) :=
  (fun c : Option (TM0.Cfg Symbol Λ) => c.bind (TM0.step M))^[t] (some cfg)

theorem run_succ_last {Λ : Type} [Inhabited Λ] (M : TM0.Machine Symbol Λ)
    (n : ℕ) (cfg : TM0.Cfg Symbol Λ) :
    run M (n+1) cfg = (run M n cfg).bind (TM0.step M) := by
  unfold run
  rw [Function.iterate_succ_apply']

theorem run_succ_first {Λ : Type} [Inhabited Λ] (M : TM0.Machine Symbol Λ)
    (n : ℕ) (cfg cfg' : TM0.Cfg Symbol Λ) (h : TM0.step M cfg = some cfg') :
    run M (n+1) cfg = run M n cfg' := by
  unfold run
  rw [Function.iterate_succ_apply]
  change (fun c : Option (TM0.Cfg Symbol Λ) => c.bind (TM0.step M))^[n] (TM0.step M cfg) = _
  rw [h]

theorem run_add_some {Λ : Type} [Inhabited Λ] (M : TM0.Machine Symbol Λ)
    (n m : ℕ) (cfg cfg' : TM0.Cfg Symbol Λ) (h : run M n cfg = some cfg') :
    run M (n+m) cfg = run M m cfg' := by
  unfold run at h ⊢
  rw [Nat.add_comm n m, Function.iterate_add_apply, h]

def offset {Λ : Type} [Inhabited Λ] (M : TM0.Machine Symbol Λ) (cfg : TM0.Cfg Symbol Λ) : ℕ → ℤ
  | 0 => 0
  | n+1 => offset M cfg n + (run M n cfg).elim 0 (nextOffset M)

theorem offset_add_some {Λ : Type} [Inhabited Λ] (M : TM0.Machine Symbol Λ)
    (n m : ℕ) (cfg cfg' : TM0.Cfg Symbol Λ) (h : run M n cfg = some cfg') :
    offset M cfg (n+m) = offset M cfg n + offset M cfg' m := by
  induction m with
  | zero => simp [offset]
  | succ m ih =>
    change offset M cfg (n+m) + (run M (n+m) cfg).elim 0 (nextOffset M) =
      offset M cfg n + (offset M cfg' m + (run M m cfg').elim 0 (nextOffset M))
    rw [ih, run_add_some M n m cfg cfg' h]
    omega

theorem offset_succ_first {Λ : Type} [Inhabited Λ] (M : TM0.Machine Symbol Λ)
    (n : ℕ) (cfg cfg' : TM0.Cfg Symbol Λ) (h : TM0.step M cfg = some cfg') :
    offset M cfg (n+1) = nextOffset M cfg + offset M cfg' n := by
  induction n with
  | zero => simp [offset, run]
  | succ n ih =>
    change offset M cfg (n+1) + (run M (n+1) cfg).elim 0 (nextOffset M) =
      nextOffset M cfg + (offset M cfg' n + (run M n cfg').elim 0 (nextOffset M))
    rw [ih, run_succ_first M n cfg cfg' h]
    omega

structure Trace {Λ : Type} [Inhabited Λ] (M : TM0.Machine Symbol Λ)
    (first last : TM0.Cfg Symbol Λ) (ticks : ℕ) (displacement : ℤ) : Prop where
  reached : run M ticks first = some last
  offset_eq : offset M first ticks = displacement

theorem Trace.refl {Λ : Type} [Inhabited Λ] (M : TM0.Machine Symbol Λ) (cfg : TM0.Cfg Symbol Λ) :
    Trace M cfg cfg 0 0 := ⟨rfl,rfl⟩

theorem Trace.trans {Λ : Type} [Inhabited Λ] {M : TM0.Machine Symbol Λ}
    {a b c : TM0.Cfg Symbol Λ} {n m : ℕ} {s t : ℤ}
    (h : Trace M a b n s) (k : Trace M b c m t) : Trace M a c (n+m) (s+t) := by
  constructor
  · rw [run_add_some M n m a b h.reached]
    exact k.reached
  · rw [offset_add_some M n m a b h.reached, h.offset_eq, k.offset_eq]

theorem Trace.one {Λ : Type} [Inhabited Λ] {M : TM0.Machine Symbol Λ}
    {a b : TM0.Cfg Symbol Λ} {s : ℤ} (h : TM0.step M a = some b)
    (hs : nextOffset M a = s) : Trace M a b 1 s := by
  constructor
  · simpa only [run, Function.iterate_one, Option.bind_some] using h
  · simpa only [offset, run, Function.iterate_zero_apply, Option.elim_some, zero_add] using hs

theorem run_initial {Λ : Type} [Inhabited Λ] (M : TM0.Machine Symbol Λ)
    (input : List Symbol) (t : ℕ) : run M t (TM0.init input) = BitMachineAfter M input t := by
  induction t with
  | zero => rfl
  | succ t ih => rw [run_succ_last, ih]; rfl

theorem headPosition_eq_offset {q : ℕ} (M : TM0.Machine Symbol (Fin (q+1))) (input : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits)
    (t : ℕ) : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.headPosition M input t = offset M (TM0.init (input.map some)) t := by
  induction t with
  | zero => rfl
  | succ t ih =>
    simp only [Qatlib.Concepts.BitWordCompiler.CanonicalCodec.headPosition, offset, run_initial,
        ← ih]
    cases hc : BitMachineAfter M (input.map some) t with
    | none => rfl
    | some cfg =>
      cases hm : M cfg.q cfg.Tape.head with
      | none => simp only [nextOffset, hm, Option.elim_some]
      | some pair =>
        rcases pair with ⟨label,stmt⟩
        cases stmt with
        | write value => simp only [nextOffset, hm, stmtOffset, Option.elim_some]
        | move dir => cases dir <;> simp only [nextOffset, hm, stmtOffset, Option.elim_some]

theorem Trace.runs {q : ℕ} {M : TM0.Machine Symbol (Fin (q+1))}
    {input output : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits} {last : TM0.Cfg Symbol (Fin (q+1))} {t budget : ℕ}
    (h : Trace M (TM0.init (input.map some)) last t 0)
    (hinput : input.length ≤ budget) (ht : t ≤ budget) (hstop : TM0.step M last = none)
    (hout : ∀ i, last.Tape.right₀.nth i = (output.map some).getD i none)
    (hleft : ∀ i, last.Tape.left.nth i = none) : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Runs M input output budget budget := by
  refine ⟨hinput,t,last,ht,?_,hstop,?_,hout,hleft,?_⟩
  · simpa only [run_initial] using h.reached
  · rw [headPosition_eq_offset]
    exact h.offset_eq
  · intro u hu
    have hb := headPosition_bounds M input u
    omega

end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM
open Turing

def applyStmt (stmt : TM0.Stmt Symbol) (tape : Tape Symbol) : Tape Symbol :=
  match stmt with
  | .move d => tape.move d
  | .write b => tape.write b

def evalScript : List (TM0.Stmt Symbol) → Tape Symbol → Tape Symbol
  | [],tape => tape
  | stmt::rest,tape => evalScript rest (applyStmt stmt tape)

def scriptOffset : List (TM0.Stmt Symbol) → ℤ
  | [] => 0
  | stmt::rest => stmtOffset stmt + scriptOffset rest

theorem evalScript_append (a b : List (TM0.Stmt Symbol)) (tape : Tape Symbol) :
    evalScript (a++b) tape = evalScript b (evalScript a tape) := by
  induction a generalizing tape with
  | nil => rfl
  | cons stmt a ih => exact ih (applyStmt stmt tape)

theorem scriptOffset_append (a b : List (TM0.Stmt Symbol)) :
    scriptOffset (a++b) = scriptOffset a + scriptOffset b := by
  induction a with
  | nil => simp [scriptOffset]
  | cons stmt a ih => simp only [List.cons_append, scriptOffset, ih]; omega

def writeWord : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits → List (TM0.Stmt Symbol)
  | [] => []
  | [b] => [.write (some b)]
  | b::c::rest => .write (some b) :: .move .right :: writeWord (c::rest)

def printScript (out : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) : List (TM0.Stmt Symbol) :=
  writeWord out ++ List.replicate (out.length-1) (.move .left)

theorem eval_moves_left (n : ℕ) (tape : Tape Symbol) :
    evalScript (List.replicate n (.move .left)) tape = (Tape.move Dir.left)^[n] tape := by
  induction n generalizing tape with
  | zero => rfl
  | succ n ih =>
    rw [List.replicate_succ, evalScript, applyStmt, ih, Function.iterate_succ_apply]

theorem left_right_iterate (n : ℕ) (tape : Tape Symbol) :
    (Tape.move Dir.left)^[n] ((Tape.move Dir.right)^[n] tape) = tape := by
  induction n with
  | zero => rfl
  | succ n ih =>
    rw [Function.iterate_succ_apply, Function.iterate_succ_apply', Tape.move_right_left, ih]

theorem eval_writeWord (out : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (left : List Symbol) :
    evalScript (writeWord out) (Tape.mk₂ left []) =
      (Tape.move Dir.right)^[out.length-1] (Tape.mk₂ left (out.map some)) := by
  induction out generalizing left with
  | nil => rfl
  | cons b out ih =>
    cases out with
    | nil => rfl
    | cons c rest =>
      change evalScript (writeWord (c::rest))
        (((Tape.mk₂ left []).write (some b)).move .right) = _
      have hs : ((Tape.mk₂ left []).write (some b)).move .right = Tape.mk₂ (some b::left) [] := by
        simp [Tape.mk₂, Tape.mk', Tape.write, Tape.move, ListBlank.cons_mk]
      rw [hs, ih]
      have hn : (b::c::rest).length-1 = ((c::rest).length-1)+1 := by simp
      rw [hn, Function.iterate_succ_apply]
      congr 1

theorem eval_printScript (out : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) :
    evalScript (printScript out) (Tape.mk₁ []) = Tape.mk₁ (out.map some) := by
  rw [printScript, evalScript_append, Tape.mk₁, eval_writeWord, eval_moves_left, left_right_iterate]
  rfl

theorem writeWord_offset (out : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) : scriptOffset (writeWord out) = (out.length-1 : ℕ) := by
  induction out with
  | nil => rfl
  | cons b out ih =>
    cases out with
    | nil => rfl
    | cons c rest =>
      simp only [writeWord, scriptOffset, stmtOffset, ih, List.length_cons]
      omega

theorem moves_left_offset (n : ℕ) : scriptOffset (List.replicate n (.move .left)) = -(n : ℤ) := by
  induction n with
  | zero => rfl
  | succ n ih => simp only [List.replicate_succ, scriptOffset, stmtOffset, ih]; omega

theorem printScript_offset (out : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) : scriptOffset (printScript out) = 0 := by
  rw [printScript, scriptOffset_append, writeWord_offset, moves_left_offset]
  omega

theorem writeWord_length (out : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) : (writeWord out).length ≤ 2*out.length := by
  induction out with
  | nil => rfl
  | cons b out ih =>
    cases out with
    | nil => simp [writeWord]
    | cons c rest =>
      simp only [writeWord, List.length_cons] at ih ⊢
      omega

theorem printScript_length (out : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) : (printScript out).length ≤ 3*out.length := by
  simp only [printScript, List.length_append, List.length_replicate]
  have h := writeWord_length out
  omega

def cleanerMachine (code : List (TM0.Stmt Symbol)) : TM0.Machine Symbol (Fin (code.length+6)) :=
  fun state symbol => match state.val with
  | 0 => match symbol with
    | none => some (⟨5,by omega⟩,.write none)
    | some _ => some (⟨1,by omega⟩,.write (some false))
  | 1 => some (⟨2,by omega⟩,.move .right)
  | 2 => match symbol with
    | none => some (⟨4,by omega⟩,.write none)
    | some _ => some (⟨3,by omega⟩,.write none)
  | 3 => some (⟨2,by omega⟩,.move .right)
  | 4 => match symbol with
    | none => some (⟨4,by omega⟩,.move .left)
    | some _ => some (⟨5,by omega⟩,.write none)
  | i+5 => if hi : i < code.length then
      some (⟨i+6,by omega⟩,code.getD i (.write none))
    else none

end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM
open Turing

theorem script_trace {Λ : Type} [Inhabited Λ] (M : TM0.Machine Symbol Λ)
    (code : List (TM0.Stmt Symbol)) (label : ℕ → Λ)
    (hcode : ∀ i (hi : i < code.length) b,
      M (label i) b = some (label (i+1),code[i])) (tape : Tape Symbol) :
    Trace M ⟨label 0,tape⟩ ⟨label code.length,evalScript code tape⟩
      code.length (scriptOffset code) := by
  induction code generalizing label tape with
  | nil => exact Trace.refl M _
  | cons stmt rest ih =>
    have hs : TM0.step M ⟨label 0,tape⟩ = some ⟨label 1,applyStmt stmt tape⟩ := by
      simp only [TM0.step, hcode 0 (by simp), List.getElem_cons_zero]
      cases stmt <;> rfl
    have ho : nextOffset M ⟨label 0,tape⟩ = stmtOffset stmt := by
      simp only [nextOffset,hcode 0 (by simp),List.getElem_cons_zero]
    have ht := ih (fun i => label (i+1)) (by
      intro i hi b
      simpa only [List.length_cons,List.getElem_cons_succ,Nat.add_assoc] using!
        hcode (i+1) (by simpa using Nat.succ_lt_succ hi) b) (applyStmt stmt tape)
    convert! (Trace.one hs ho).trans ht using 1
    simp only [List.length_cons,Nat.add_comm 1]

end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM
open Turing

def pc (code : List (TM0.Stmt Symbol)) (i : ℕ) : Fin (code.length+6) :=
  ⟨min i code.length+5, by omega⟩

theorem cleaner_script_control (code : List (TM0.Stmt Symbol)) (i : ℕ)
    (hi : i < code.length) (b : Symbol) :
    cleanerMachine code (pc code i) b = some (pc code (i+1),code[i]) := by
  simp [pc, Nat.min_eq_left (Nat.le_of_lt hi), Nat.min_eq_left hi, cleanerMachine, hi]

theorem cleaner_script (code : List (TM0.Stmt Symbol)) (tape : Tape Symbol) :
    Trace (cleanerMachine code) ⟨pc code 0,tape⟩
      ⟨pc code code.length,evalScript code tape⟩ code.length (scriptOffset code) :=
  script_trace _ code (pc code) (cleaner_script_control code) tape

theorem blank_cons (left : List Symbol) : Tape.mk₂ left [none] = Tape.mk₂ left [] := by
  have he : ListBlank.mk ([none] : List Symbol) = ListBlank.mk [] :=
    Quotient.sound (Or.inr ⟨1,rfl⟩)
  simp only [Tape.mk₂,he]

theorem move_blank_left (b : Symbol) (left : List Symbol) :
    (Tape.mk₂ (b::left) []).move .left = Tape.mk₂ left [b] := by
  simp [Tape.mk₂,Tape.move_left_mk',ListBlank.cons_mk]

theorem cleaner_return (code : List (TM0.Stmt Symbol)) (n : ℕ) :
    Trace (cleanerMachine code)
      ⟨⟨4,by omega⟩,Tape.mk₂ (List.replicate n none ++ [some false]) []⟩
      ⟨pc code 0,Tape.mk₁ []⟩ (n+2) (-(n+1 : ℕ) : ℤ) := by
  induction n with
  | zero =>
    have hmove : Trace (cleanerMachine code)
        ⟨⟨4,by omega⟩,Tape.mk₂ [some false] []⟩
        ⟨⟨4,by omega⟩,Tape.mk₂ [] [some false]⟩ 1 (-1) := by
      apply Trace.one
      · change some (TM0.Cfg.mk (⟨4,by omega⟩ : Fin (code.length+6))
          ((Tape.mk₂ [some false] []).move .left)) = _
        rw [move_blank_left]
      · rfl
    have hwrite : Trace (cleanerMachine code)
        ⟨⟨4,by omega⟩,Tape.mk₂ [] [some false]⟩
        ⟨pc code 0,Tape.mk₁ []⟩ 1 0 := by
      apply Trace.one
      · change some (TM0.Cfg.mk (⟨5,by omega⟩ : Fin (code.length+6))
          ((Tape.mk₂ [] [some false]).write none)) = _
        rw [show (Tape.mk₂ [] [some false]).write none = Tape.mk₂ [] [none] from rfl,
          blank_cons]
        rfl
      · rfl
    exact hmove.trans hwrite
  | succ n ih =>
    have hmove : Trace (cleanerMachine code)
        ⟨⟨4,by omega⟩,Tape.mk₂ (none::(List.replicate n none ++ [some false])) []⟩
        ⟨⟨4,by omega⟩,Tape.mk₂ (List.replicate n none ++ [some false]) []⟩ 1 (-1) := by
      apply Trace.one
      · change some (TM0.Cfg.mk (⟨4,by omega⟩ : Fin (code.length+6))
          ((Tape.mk₂ (none::(List.replicate n none ++ [some false])) []).move .left)) = _
        rw [move_blank_left,blank_cons]
      · rfl
    simpa only [List.replicate_succ,List.cons_append,Nat.add_comm 1,Int.natCast_add,
      Int.natCast_one,neg_add_rev] using hmove.trans ih

end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM
open Turing

theorem cleaner_scan (code : List (TM0.Stmt Symbol)) (rest : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (n : ℕ) :
    Trace (cleanerMachine code)
      ⟨⟨2,by omega⟩,Tape.mk₂ (List.replicate n none ++ [some false]) (rest.map some)⟩
      ⟨pc code 0,Tape.mk₁ []⟩ (3*rest.length+n+3) (-(n+1 : ℕ) : ℤ) := by
  induction rest generalizing n with
  | nil =>
    have hwrite : Trace (cleanerMachine code)
        ⟨⟨2,by omega⟩,Tape.mk₂ (List.replicate n none ++ [some false]) []⟩
        ⟨⟨4,by omega⟩,Tape.mk₂ (List.replicate n none ++ [some false]) []⟩ 1 0 := by
      apply Trace.one
      · change some (TM0.Cfg.mk (⟨4,by omega⟩ : Fin (code.length+6))
          ((Tape.mk₂ _ []).write none)) = _
        rw [show (Tape.mk₂ (List.replicate n none ++ [some false]) []).write none =
          Tape.mk₂ (List.replicate n none ++ [some false]) [none] from rfl,blank_cons]
      · rfl
    convert! hwrite.trans (cleaner_return code n) using 1
    simp
    omega
  | cons b rest ih =>
    have hwrite : Trace (cleanerMachine code)
        ⟨⟨2,by omega⟩,Tape.mk₂ (List.replicate n none ++ [some false]) ((b::rest).map some)⟩
        ⟨⟨3,by omega⟩,Tape.mk₂ (List.replicate n none ++ [some false]) (none::rest.map some)⟩ 1 0 := by
      apply Trace.one <;> rfl
    have hmove : Trace (cleanerMachine code)
        ⟨⟨3,by omega⟩,Tape.mk₂ (List.replicate n none ++ [some false]) (none::rest.map some)⟩
        ⟨⟨2,by omega⟩,Tape.mk₂ (List.replicate (n+1) none ++ [some false]) (rest.map some)⟩ 1 1 := by
      apply Trace.one
      · change some (TM0.Cfg.mk (⟨2,by omega⟩ : Fin (code.length+6))
          ((Tape.mk₂ _ _).move .right)) = _
        simp [Tape.mk₂,Tape.move_right_mk',ListBlank.cons_mk,List.replicate_succ]
      · rfl
    convert! hwrite.trans (hmove.trans (ih (n+1))) using 1
    simp only [List.length_cons]
    omega

theorem cleaner_init (code : List (TM0.Stmt Symbol)) (input : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) :
    ∃ ticks, ticks ≤ 3*input.length+3 ∧
      Trace (cleanerMachine code) (TM0.init (input.map some))
        ⟨pc code 0,Tape.mk₁ []⟩ ticks 0 := by
  cases input with
  | nil =>
    refine ⟨1,by simp,Trace.one ?_ rfl⟩
    rfl
  | cons b rest =>
    have hwrite : Trace (cleanerMachine code) (TM0.init ((b::rest).map some))
        ⟨⟨1,by omega⟩,Tape.mk₂ [] (some false::rest.map some)⟩ 1 0 := by
      apply Trace.one <;> rfl
    have hmove : Trace (cleanerMachine code)
        ⟨⟨1,by omega⟩,Tape.mk₂ [] (some false::rest.map some)⟩
        ⟨⟨2,by omega⟩,Tape.mk₂ [some false] (rest.map some)⟩ 1 1 := by
      apply Trace.one <;> rfl
    refine ⟨1+(1+(3*rest.length+0+3)),by simp;omega,?_⟩
    exact hwrite.trans (hmove.trans (cleaner_scan code rest 0))

theorem cleaner_halts (code : List (TM0.Stmt Symbol)) (tape : Tape Symbol) :
    TM0.step (cleanerMachine code) ⟨pc code code.length,tape⟩ = none := by
  simp [TM0.step,cleanerMachine,pc]

theorem constant_loader (word : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) :
    ∃ C : ℕ, 0<C ∧ Qatlib.Concepts.BitWordCompiler.CanonicalCodec.ComputesAt (fun _ => word)
      (fun x => C*(1+x.length+word.length)^2)
      (fun x => C*(1+x.length+word.length)^2) := by
  refine ⟨6,by decide,(printScript word).length+5,cleanerMachine (printScript word),?_⟩
  intro input
  obtain ⟨ticks,hbound,ht⟩ := cleaner_init (printScript word) input
  have hs := cleaner_script (printScript word) (Tape.mk₁ [])
  rw [eval_printScript,printScript_offset] at hs
  have hall : Trace (cleanerMachine (printScript word)) (TM0.init (input.map some))
      ⟨pc (printScript word) (printScript word).length,Tape.mk₁ (word.map some)⟩
      (ticks+(printScript word).length) 0 := by
    simpa only [zero_add] using ht.trans hs
  apply hall.runs
  · change input.length ≤ 6*(1+input.length+word.length)^2
    have h : 1+input.length+word.length ≤ (1+input.length+word.length)^2 := Nat.le_pow (by decide)
    omega
  · change ticks+(printScript word).length ≤ 6*(1+input.length+word.length)^2
    have h := printScript_length word
    have hsq : 1+input.length+word.length ≤ (1+input.length+word.length)^2 := Nat.le_pow (by decide)
    omega
  · exact cleaner_halts _ _
  · intro i
    change (Tape.mk' (ListBlank.mk []) (ListBlank.mk (word.map some))).right₀.nth i = _
    rw [Tape.mk'_right₀]
    rfl
  · intro i
    rfl

end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM
open Turing

variable {a b : ℕ}

def firstLabel (q : Fin (a+1)) : Fin ((a+1)+(b+1)) := Fin.castAdd (b+1) q
def secondLabel (q : Fin (b+1)) : Fin ((a+1)+(b+1)) := Fin.natAdd (a+1) q

def firstCfg (cfg : TM0.Cfg Symbol (Fin (a+1))) : TM0.Cfg Symbol (Fin ((a+1)+(b+1))) :=
  ⟨firstLabel cfg.q,cfg.Tape⟩
def secondCfg (cfg : TM0.Cfg Symbol (Fin (b+1))) : TM0.Cfg Symbol (Fin ((a+1)+(b+1))) :=
  ⟨secondLabel cfg.q,cfg.Tape⟩

def composeMachine (M : TM0.Machine Symbol (Fin (a+1)))
    (N : TM0.Machine Symbol (Fin (b+1))) : TM0.Machine Symbol (Fin ((a+1)+(b+1))) :=
  Fin.addCases
    (fun q symbol => match M q symbol with
      | none => some (secondLabel 0,.write symbol)
      | some (q',stmt) => some (firstLabel q',stmt))
    (fun q symbol => (N q symbol).map (fun (q',stmt) => (secondLabel q',stmt)))

theorem compose_first (M : TM0.Machine Symbol (Fin (a+1)))
    (N : TM0.Machine Symbol (Fin (b+1))) (cfg : TM0.Cfg Symbol (Fin (a+1))) :
    TM0.step (composeMachine M N) (firstCfg cfg) =
      match TM0.step M cfg with
      | none => some (secondCfg ⟨0,cfg.Tape⟩)
      | some cfg' => some (firstCfg cfg') := by
  rcases cfg with ⟨q,tape⟩
  simp only [TM0.step,composeMachine,firstCfg,firstLabel,Fin.addCases_left]
  cases hm : M q tape.head with
  | none => simp only [Option.map_none,Option.map_some,secondCfg,Tape.write_self]
  | some result => rcases result with ⟨q',stmt⟩; cases stmt <;> rfl

theorem compose_second (M : TM0.Machine Symbol (Fin (a+1)))
    (N : TM0.Machine Symbol (Fin (b+1))) (cfg : TM0.Cfg Symbol (Fin (b+1))) :
    TM0.step (composeMachine M N) (secondCfg cfg) = (TM0.step N cfg).map secondCfg := by
  rcases cfg with ⟨q,tape⟩
  simp only [TM0.step,composeMachine,secondCfg,secondLabel,Fin.addCases_right]
  cases hm : N q tape.head with
  | none => rfl
  | some result => rcases result with ⟨q',stmt⟩; cases stmt <;> rfl

theorem compose_first_offset (M : TM0.Machine Symbol (Fin (a+1)))
    (N : TM0.Machine Symbol (Fin (b+1))) (cfg : TM0.Cfg Symbol (Fin (a+1))) :
    nextOffset (composeMachine M N) (firstCfg cfg) = nextOffset M cfg := by
  rcases cfg with ⟨q,tape⟩
  simp only [nextOffset,composeMachine,firstCfg,firstLabel,Fin.addCases_left]
  cases hm : M q tape.head with
  | none => rfl
  | some result => rcases result with ⟨q',stmt⟩; rfl

theorem compose_second_offset (M : TM0.Machine Symbol (Fin (a+1)))
    (N : TM0.Machine Symbol (Fin (b+1))) (cfg : TM0.Cfg Symbol (Fin (b+1))) :
    nextOffset (composeMachine M N) (secondCfg cfg) = nextOffset N cfg := by
  rcases cfg with ⟨q,tape⟩
  simp only [nextOffset,composeMachine,secondCfg,secondLabel,Fin.addCases_right]
  cases hm : N q tape.head with
  | none => rfl
  | some result => rcases result with ⟨q',stmt⟩; rfl

theorem run_prefix {Λ : Type} [Inhabited Λ] (M : TM0.Machine Symbol Λ)
    (cfg last : TM0.Cfg Symbol Λ) (n : ℕ) (h : run M n cfg = some last)
    (u : ℕ) (hu : u ≤ n) : ∃ mid, run M u cfg = some mid := by
  induction n generalizing last with
  | zero =>
    have he : u=0 := by omega
    subst u
    exact ⟨cfg,rfl⟩
  | succ n ih =>
    by_cases he : u=n+1
    · subst u; exact ⟨last,h⟩
    · rw [run_succ_last] at h
      cases hm : run M n cfg with
      | none => simp only [hm,Option.bind_none,reduceCtorEq] at h
      | some mid => exact ih mid hm (by omega)

theorem compose_first_run (M : TM0.Machine Symbol (Fin (a+1)))
    (N : TM0.Machine Symbol (Fin (b+1))) (cfg last : TM0.Cfg Symbol (Fin (a+1)))
    (n : ℕ) (h : run M n cfg = some last) :
    run (composeMachine M N) n (firstCfg cfg) = some (firstCfg last) ∧
    offset (composeMachine M N) (firstCfg cfg) n = offset M cfg n := by
  induction n generalizing last with
  | zero => cases Option.some.inj h; exact ⟨rfl,rfl⟩
  | succ n ih =>
    obtain ⟨mid,hm⟩ := run_prefix M cfg last (n+1) h n (by omega)
    obtain ⟨hr,ho⟩ := ih mid hm
    have hs : TM0.step M mid = some last := by
      simpa only [run_succ_last,hm,Option.bind_some] using h
    constructor
    · rw [run_succ_last,hr,Option.bind_some,compose_first,hs]
    · rw [offset,hr,Option.elim_some,compose_first_offset,ho,offset,hm,Option.elim_some]

theorem compose_second_run (M : TM0.Machine Symbol (Fin (a+1)))
    (N : TM0.Machine Symbol (Fin (b+1))) (cfg last : TM0.Cfg Symbol (Fin (b+1)))
    (n : ℕ) (h : run N n cfg = some last) :
    run (composeMachine M N) n (secondCfg cfg) = some (secondCfg last) ∧
    offset (composeMachine M N) (secondCfg cfg) n = offset N cfg n := by
  induction n generalizing last with
  | zero => cases Option.some.inj h; exact ⟨rfl,rfl⟩
  | succ n ih =>
    obtain ⟨mid,hm⟩ := run_prefix N cfg last (n+1) h n (by omega)
    obtain ⟨hr,ho⟩ := ih mid hm
    have hs : TM0.step N mid = some last := by
      simpa only [run_succ_last,hm,Option.bind_some] using h
    constructor
    · rw [run_succ_last,hr,Option.bind_some,compose_second,hs,Option.map_some]
    · rw [offset,hr,Option.elim_some,compose_second_offset,ho,offset,hm,Option.elim_some]

end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM
open Turing Qatlib.Concepts.BitWordCompiler.CanonicalCodec

theorem tape_eq_output (tape : Tape Symbol) (word : Bits)
    (hout : ∀ i, tape.right₀.nth i = (word.map some).getD i none)
    (hleft : ∀ i, tape.left.nth i = none) : tape = Tape.mk₁ (word.map some) := by
  rw [← Tape.mk'_left_right₀ tape]
  congr 1
  · exact ListBlank.ext hleft
  · exact ListBlank.ext hout

theorem compose_runs {a b : ℕ} (M : TM0.Machine Symbol (Fin (a+1)))
    (N : TM0.Machine Symbol (Fin (b+1))) (x y z : Bits)
    (tf sf tg sg time space : ℕ) (hf : Runs M x y tf sf) (hg : Runs N y z tg sg)
    (hclock : tf+tg+1 ≤ time) (hspacef : sf ≤ space) (hspaceg : sg ≤ space) :
    @Runs ((a+1)+b) (composeMachine M N) x z time space := by
  rcases hf with ⟨hinput,t,cf,ht,hr,hstop,hpos,hout,hleft,hvisited⟩
  rcases hg with ⟨_,s,cg,hs,hsr,hsstop,hspos,hsout,hsleft,hsvisited⟩
  have hr' : run M t (TM0.init (x.map some)) = some cf := by simpa only [run_initial] using hr
  have hsr' : run N s (TM0.init (y.map some)) = some cg := by simpa only [run_initial] using hsr
  have hpos' : offset M (TM0.init (x.map some)) t = 0 := by
    rwa [← headPosition_eq_offset]
  have hspos' : offset N (TM0.init (y.map some)) s = 0 := by
    rwa [← headPosition_eq_offset]
  have hfTrace : Trace (composeMachine M N) (TM0.init (x.map some)) (firstCfg cf) t 0 := by
    obtain ⟨h1,h2⟩ := compose_first_run M N _ cf t hr'
    exact ⟨h1,h2.trans hpos'⟩
  have hbridge : Trace (composeMachine M N) (firstCfg cf)
      (secondCfg (TM0.init (y.map some))) 1 0 := by
    apply Trace.one
    · rw [compose_first,hstop]
      change some (secondCfg (TM0.Cfg.mk 0 cf.Tape)) = _
      rw [tape_eq_output _ _ hout hleft]
      rfl
    · rw [compose_first_offset]
      unfold TM0.step at hstop
      have he : M cf.q cf.Tape.head = none := Option.map_eq_none_iff.mp hstop
      simp only [nextOffset,he]
  have hgTrace : Trace (composeMachine M N) (secondCfg (TM0.init (y.map some))) (secondCfg cg) s 0 := by
    obtain ⟨h1,h2⟩ := compose_second_run M N _ cg s hsr'
    exact ⟨h1,h2.trans hspos'⟩
  have hprefix : Trace (composeMachine M N) (TM0.init (x.map some))
      (secondCfg (TM0.init (y.map some))) (t+1) 0 := by
    simpa only [zero_add] using hfTrace.trans hbridge
  have hall : Trace (composeMachine M N) (TM0.init (x.map some)) (secondCfg cg) (t+1+s) 0 := by
    simpa only [zero_add] using hprefix.trans hgTrace
  refine ⟨hinput.trans hspacef,t+1+s,secondCfg cg,by omega,?_,?_,?_,hsout,hsleft,?_⟩
  · simpa only [run_initial] using hall.reached
  · rw [compose_second,hsstop]
    rfl
  · rw [headPosition_eq_offset]
    exact hall.offset_eq
  · intro u hu
    rw [headPosition_eq_offset]
    by_cases huf : u ≤ t
    · obtain ⟨mid,hmid⟩ := run_prefix M _ cf t hr' u huf
      obtain ⟨_,he⟩ := compose_first_run M N _ mid u hmid
      change offset (composeMachine M N) (TM0.init (x.map some)) u =
        offset M (TM0.init (x.map some)) u at he
      rw [he,← headPosition_eq_offset]
      have hb := hvisited u huf
      omega
    · let v := u-(t+1)
      have hv : v ≤ s := by dsimp [v];omega
      have heq : u=(t+1)+v := by dsimp [v];omega
      obtain ⟨mid,hmid⟩ := run_prefix N _ cg s hsr' v hv
      obtain ⟨_,he⟩ := compose_second_run M N _ mid v hmid
      rw [heq,offset_add_some _ (t+1) v _ _ hprefix.reached,hprefix.offset_eq,zero_add,he,
        ← headPosition_eq_offset]
      have hb := hsvisited v hv
      omega

theorem computesAt_comp (f g : Bits → Bits) (tf sf tg sg : Bits → ℕ)
    (hf : ComputesAt f tf sf) (hg : ComputesAt g tg sg) :
    ∃ C : ℕ, 0<C ∧ ComputesAt (fun x => g (f x))
      (fun x => C*(1+x.length+(f x).length+(g (f x)).length+tf x+tg (f x))^2)
      (fun x => C*(1+x.length+(f x).length+(g (f x)).length+sf x+sg (f x))^2) := by
  rcases hf with ⟨a,M,hf⟩
  rcases hg with ⟨b,N,hg⟩
  refine ⟨1,by decide,(a+1)+b,composeMachine M N,?_⟩
  intro x
  apply compose_runs M N x (f x) (g (f x)) (tf x) (sf x) (tg (f x)) (sg (f x))
    _ _ (hf x) (hg (f x))
  · have hb : 1+x.length+(f x).length+(g (f x)).length+tf x+tg (f x) ≤
        (1+x.length+(f x).length+(g (f x)).length+tf x+tg (f x))^2 := Nat.le_pow (by decide)
    simpa only [Nat.one_mul] using (show tf x+tg (f x)+1 ≤
      (1+x.length+(f x).length+(g (f x)).length+tf x+tg (f x))^2 by omega)
  · have hb : 1+x.length+(f x).length+(g (f x)).length+sf x+sg (f x) ≤
        (1+x.length+(f x).length+(g (f x)).length+sf x+sg (f x))^2 := Nat.le_pow (by decide)
    simpa only [Nat.one_mul] using (show sf x ≤
      (1+x.length+(f x).length+(g (f x)).length+sf x+sg (f x))^2 by omega)
  · have hb : 1+x.length+(f x).length+(g (f x)).length+sf x+sg (f x) ≤
        (1+x.length+(f x).length+(g (f x)).length+sf x+sg (f x))^2 := Nat.le_pow (by decide)
    simpa only [Nat.one_mul] using (show sg (f x) ≤
      (1+x.length+(f x).length+(g (f x)).length+sf x+sg (f x))^2 by omega)

end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Scheduler
open Qatlib.Concepts.BitWordCompiler.CanonicalCodec

structure Job where
  counters : List ℕ
  plan : Plan

def pendingOutput (params : List Bits) (k : ℕ) (jobs : List Job) : Bits :=
  jobs.flatMap (fun job => emit params k job.counters job.plan)

def pendingWork (params : List Bits) (k : ℕ) (jobs : List Job) : ℕ :=
  (jobs.map (fun job => work params k job.counters job.plan)).sum

def stepOne (params : List Bits) (k : ℕ) (job : Job) : Bits × List Job :=
  match job.plan with
  | .append a b => ([],[⟨job.counters,a⟩,⟨job.counters,b⟩])
  | .repeat bound body => ([],(List.range (value params k job.counters bound)).map
      (fun i => ⟨i::job.counters,body⟩))
  | p => (emit params k job.counters p,[])

theorem fold_add_sum {α : Type} (f : α → ℕ) (xs : List α) (acc : ℕ) :
    xs.foldl (fun sum i => sum+f i) acc = acc+(xs.map f).sum := by
  induction xs generalizing acc with
  | nil => simp
  | cons x xs ih => simp only [List.foldl_cons,List.map_cons,List.sum_cons,ih];omega

theorem pairScan_length (a b : Bits) :
    ((a.zip b).flatMap (fun p => [p.1,p.2])).length ≤ a.length+b.length := by
  induction a generalizing b with
  | nil => simp
  | cons a as ih =>
    cases b with
    | nil => simp
    | cons b bs =>
      simp only [List.zip_cons_cons,List.flatMap_cons,List.length_append,List.length_cons,List.length_nil]
      have h := ih bs
      omega

theorem stepOne_output (params : List Bits) (k : ℕ) (job : Job) :
    (stepOne params k job).1 ++ pendingOutput params k (stepOne params k job).2 =
      emit params k job.counters job.plan := by
  rcases job with ⟨cs,p⟩
  cases p <;> simp [stepOne,pendingOutput,emit,List.flatMap_map]

theorem stepOne_work (params : List Bits) (k : ℕ) (job : Job) :
    (stepOne params k job).1.length + pendingWork params k (stepOne params k job).2 + 1 ≤
      work params k job.counters job.plan := by
  rcases job with ⟨cs,p⟩
  cases p with
  | literal bits => simp [stepOne,pendingWork,work,emit]
  | copy i => simp [stepOne,pendingWork,work,emit]
  | emitNat arg => simp [stepOne,pendingWork,work,emit]
  | fixedCount width arg => simp [stepOne,pendingWork,work,emit]
  | pairScan i j =>
    simp only [stepOne,pendingWork,List.map_nil,List.sum_nil,work,emit,Nat.add_zero]
    exact Nat.add_le_add_right (pairScan_length _ _) 1
  | append a b => simp [stepOne,pendingWork,work]
  | «repeat» bound body =>
    simp [stepOne,pendingWork,work,fold_add_sum,List.map_map,Function.comp_def,Nat.add_comm]

def runJobs (params : List Bits) (k : ℕ) : ℕ → List Job → Option Bits
  | _,[] => some []
  | 0,_::_ => none
  | fuel+1,job::rest => do
      let step := stepOne params k job
      let tail ← runJobs params k fuel (step.2++rest)
      pure (step.1++tail)

theorem runJobs_complete (params : List Bits) (k fuel : ℕ) (jobs : List Job)
    (h : pendingWork params k jobs ≤ fuel) :
    runJobs params k fuel jobs = some (pendingOutput params k jobs) := by
  induction fuel generalizing jobs with
  | zero =>
    cases jobs with
    | nil => rfl
    | cons job rest =>
      have hs := stepOne_work params k job
      simp only [pendingWork,List.map_cons,List.sum_cons] at h
      omega
  | succ fuel ih =>
    cases jobs with
    | nil => rfl
    | cons job rest =>
      have hs := stepOne_work params k job
      have hcost : pendingWork params k ((stepOne params k job).2++rest) ≤ fuel := by
        simp only [pendingWork,List.map_append,List.sum_append]
        simp only [pendingWork,List.map_cons,List.sum_cons] at h
        simp only [pendingWork] at hs
        omega
      simp only [runJobs,ih _ hcost,Option.bind_eq_bind,Option.bind_some,pure]
      congr 1
      have he : pendingOutput params k ((stepOne params k job).2++rest) =
          pendingOutput params k (stepOne params k job).2 ++ pendingOutput params k rest :=
        List.flatMap_append
      rw [he,← List.append_assoc,stepOne_output]
      rfl

theorem eval_with_work (params : List Bits) (k : ℕ) (cs : List ℕ) (p : Plan) :
    runJobs params k (work params k cs p) [⟨cs,p⟩] = some (emit params k cs p) := by
  simpa only [pendingWork,List.map_cons,List.map_nil,List.sum_cons,List.sum_nil,Nat.add_zero,
    pendingOutput,List.flatMap_cons,List.flatMap_nil,List.append_nil] using
    runJobs_complete params k (work params k cs p) [⟨cs,p⟩] (by simp [pendingWork])

theorem runJobs_output_bound (params : List Bits) (k fuel : ℕ) (jobs : List Job) (output : Bits)
    (h : runJobs params k fuel jobs = some output) : output.length ≤ pendingWork params k jobs := by
  induction fuel generalizing jobs output with
  | zero =>
    cases jobs with
    | nil => cases Option.some.inj h;exact Nat.zero_le _
    | cons job rest => simp only [runJobs,reduceCtorEq] at h
  | succ fuel ih =>
    cases jobs with
    | nil => cases Option.some.inj h;exact Nat.zero_le _
    | cons job rest =>
      cases hr : runJobs params k fuel ((stepOne params k job).2++rest) with
      | none => simp only [runJobs,hr,Option.bind_eq_bind,Option.bind_none,reduceCtorEq] at h
      | some tail =>
        have hb := ih _ tail hr
        simp only [runJobs,hr,Option.bind_eq_bind,Option.bind_some,pure,Option.some.injEq] at h
        subst output
        have hs := stepOne_work params k job
        simp only [pendingWork,List.map_append,List.sum_append] at hb
        simp only [pendingWork] at hs
        simp only [List.length_append,pendingWork,List.map_cons,List.sum_cons]
        omega

theorem emit_length_le_work (params : List Bits) (k : ℕ) (cs : List ℕ) (p : Plan) :
    (emit params k cs p).length ≤ work params k cs p := by
  have h := runJobs_output_bound params k (work params k cs p) [⟨cs,p⟩] _
    (eval_with_work params k cs p)
  simpa only [pendingWork,List.map_cons,List.map_nil,List.sum_cons,List.sum_nil,Nat.add_zero] using
      h

end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Scheduler

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM
open Turing Qatlib.Concepts.BitWordCompiler.CanonicalCodec

def iterSum (f : Bits → Bits) (cost : Bits → ℕ) (n : ℕ) (x : Bits) : ℕ :=
  ((List.range n).map (fun j => cost ((f^[j]) x))).sum

theorem iterSum_succ (f : Bits → Bits) (cost : Bits → ℕ) (n : ℕ) (x : Bits) :
    iterSum f cost (n+1) x = iterSum f cost n x+cost ((f^[n]) x) := by
  simp [iterSum,List.range_succ,List.map_append,List.sum_append]

def identityMachine : TM0.Machine Symbol (Fin 1) := fun _ _ => none

theorem identity_runs (input : Bits) : Runs identityMachine input input 0 input.length := by
  refine ⟨le_rfl,0,TM0.init (input.map some),le_rfl,rfl,rfl,rfl,?_,?_,?_⟩
  · intro i
    change (Tape.mk' (ListBlank.mk []) (ListBlank.mk (input.map some))).right₀.nth i = _
    rw [Tape.mk'_right₀]
    rfl
  · intro i
    rfl
  · intro u hu
    have he : u=0 := by omega
    subst u
    simp [headPosition]

theorem fixed_iterates (f : Bits → Bits) (tf sf : Bits → ℕ) (hf : ComputesAt f tf sf) :
    ∀ n, ComputesAt (f^[n]) (fun x => n+iterSum f tf n x)
      (fun x => x.length+iterSum f sf n x) := by
  rcases hf with ⟨a,M,hf⟩
  intro n
  induction n with
  | zero =>
    refine ⟨0,identityMachine,?_⟩
    intro x
    simpa only [iterSum,List.range_zero,List.map_nil,List.sum_nil,Nat.add_zero,
      Function.iterate_zero_apply] using identity_runs x
  | succ n ih =>
    rcases ih with ⟨b,N,hN⟩
    refine ⟨(b+1)+a,composeMachine N M,?_⟩
    intro x
    change Runs _ x _ (n+1+iterSum f tf (n+1) x) (x.length+iterSum f sf (n+1) x)
    rw [Function.iterate_succ_apply',iterSum_succ,iterSum_succ]
    apply compose_runs N M x ((f^[n]) x) (f ((f^[n]) x))
      (n+iterSum f tf n x) (x.length+iterSum f sf n x) (tf ((f^[n]) x)) (sf ((f^[n]) x))
      _ _ (hN x) (hf ((f^[n]) x)) <;> omega

end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM
open Turing

theorem run_eq_of_step_eq {Λ : Type} [Inhabited Λ] (M : TM0.Machine Symbol Λ)
    (c d : TM0.Cfg Symbol Λ) (h : TM0.step M c = TM0.step M d) (n : ℕ) :
    run M (n+1) c = run M (n+1) d := by
  simp only [run,Function.iterate_succ_apply,Option.bind_some]
  rw [h]

theorem offset_eq_of_step_eq {Λ : Type} [Inhabited Λ] (M : TM0.Machine Symbol Λ)
    (c d : TM0.Cfg Symbol Λ) (h : TM0.step M c = TM0.step M d)
    (ho : nextOffset M c = nextOffset M d) (n : ℕ) : offset M c n = offset M d n := by
  induction n with
  | zero => rfl
  | succ n ih =>
    cases n with
    | zero => simpa only [offset,run,Function.iterate_zero_apply,Option.elim_some,zero_add] using ho
    | succ n =>
      change offset M c (n+1) + (run M (n+1) c).elim 0 (nextOffset M) =
        offset M d (n+1) + (run M (n+1) d).elim 0 (nextOffset M)
      rw [ih,run_eq_of_step_eq M c d h n]

theorem Trace.transfer {Λ : Type} [Inhabited Λ] {M : TM0.Machine Symbol Λ}
    {c d last : TM0.Cfg Symbol Λ} {n : ℕ} {s : ℤ}
    (ht : Trace M d last n s) (hn : 0<n)
    (hstep : TM0.step M c = TM0.step M d) (ho : nextOffset M c = nextOffset M d) :
    Trace M c last n s := by
  constructor
  · obtain ⟨t,rfl⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.ne_of_gt hn)
    rw [run_eq_of_step_eq M c d hstep,ht.reached]
  · rw [offset_eq_of_step_eq M c d hstep ho,ht.offset_eq]

variable {Λ σ : Type} [Inhabited Λ] [Inhabited σ]

def stmtTicks {Γ : Type} : TM1.Stmt Γ Λ σ → ℕ
  | .move _ rest => 1+stmtTicks rest
  | .write _ rest => 1+stmtTicks rest
  | .load _ rest => stmtTicks rest
  | .branch _ left right => max (stmtTicks left) (stmtTicks right)
  | .goto _ => 1
  | .halt => 1

def stmtShift {Γ : Type} [Inhabited Γ] : TM1.Stmt Γ Λ σ → σ → Tape Γ → ℤ
  | .move d rest,v,tape => stmtOffset (.move d)+stmtShift rest v (tape.move d)
  | .write f rest,v,tape => stmtShift rest v (tape.write (f tape.head v))
  | .load f rest,v,tape => stmtShift rest (f tape.head v) tape
  | .branch p left right,v,tape => if p tape.head v then stmtShift left v tape else stmtShift right v tape
  | .goto _,_,_ => 0
  | .halt,_,_ => 0

theorem tm1_statement_trace (M : Λ → TM1.Stmt Symbol Λ σ)
    (stmt : TM1.Stmt Symbol Λ σ) (v : σ) (tape : Tape Symbol) :
    ∃ ticks, 0<ticks ∧ ticks≤stmtTicks stmt ∧
      Trace (TM1to0.tr M) ⟨(some stmt,v),tape⟩
        (TM1to0.trCfg M (TM1.stepAux stmt v tape)) ticks (stmtShift stmt v tape) := by
  induction stmt generalizing v tape with
  | move d rest ih =>
    obtain ⟨ticks,hpos,hbound,ht⟩ := ih v (tape.move d)
    have hone : Trace (TM1to0.tr M) ⟨(some (.move d rest),v),tape⟩
        ⟨(some rest,v),tape.move d⟩ 1 (stmtOffset (.move d)) := by
      apply Trace.one <;> rfl
    exact ⟨1+ticks,by omega,by simpa only [stmtTicks] using Nat.add_le_add_left hbound 1,
      hone.trans ht⟩
  | write f rest ih =>
    obtain ⟨ticks,hpos,hbound,ht⟩ := ih v (tape.write (f tape.head v))
    have hone : Trace (TM1to0.tr M) ⟨(some (.write f rest),v),tape⟩
        ⟨(some rest,v),tape.write (f tape.head v)⟩ 1 0 := by
      apply Trace.one <;> rfl
    refine ⟨1+ticks,by omega,by simpa only [stmtTicks] using Nat.add_le_add_left hbound 1,?_⟩
    simpa only [zero_add] using! hone.trans ht
  | load f rest ih =>
    obtain ⟨ticks,hpos,hbound,ht⟩ := ih (f tape.head v) tape
    exact ⟨ticks,hpos,hbound,ht.transfer hpos rfl rfl⟩
  | branch p left right ihLeft ihRight =>
    cases hp : p tape.head v with
    | false =>
      obtain ⟨ticks,hpos,hbound,ht⟩ := ihRight v tape
      refine ⟨ticks,hpos,hbound.trans (Nat.le_max_right _ _),?_⟩
      simp only [stmtShift,TM1.stepAux,hp,Bool.false_eq_true,if_false,cond_false]
      apply ht.transfer hpos
      · simp only [TM0.step,TM1to0.tr,TM1to0.trAux,hp,cond_false]
      · simp only [nextOffset,TM1to0.tr,TM1to0.trAux,hp,cond_false]
    | true =>
      obtain ⟨ticks,hpos,hbound,ht⟩ := ihLeft v tape
      refine ⟨ticks,hpos,hbound.trans (Nat.le_max_left _ _),?_⟩
      simp only [stmtShift,TM1.stepAux,hp,if_true,cond_true]
      apply ht.transfer hpos
      · simp only [TM0.step,TM1to0.tr,TM1to0.trAux,hp,cond_true]
      · simp only [nextOffset,TM1to0.tr,TM1to0.trAux,hp,cond_true]
  | goto f =>
    refine ⟨1,by decide,le_rfl,Trace.one ?_ rfl⟩
    change some (TM0.Cfg.mk (some (M (f tape.head v)),v) (tape.write tape.head)) = _
    rw [Tape.write_self]
    rfl
  | halt =>
    refine ⟨1,by decide,le_rfl,Trace.one ?_ rfl⟩
    change some (TM0.Cfg.mk (none,v) (tape.write tape.head)) = _
    rw [Tape.write_self]
    rfl

end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM
open Turing

section FiniteTM1
variable {Λ σ : Type} [Inhabited Λ] [Inhabited σ] [Fintype Λ] [Fintype σ]

def tm1Run {Γ : Type} [Inhabited Γ] (M : Λ → TM1.Stmt Γ Λ σ) :
    ℕ → TM1.Cfg Γ Λ σ → Option (TM1.Cfg Γ Λ σ)
  | 0, c => some c
  | n+1, c => (TM1.step M c).bind (tm1Run M n)

def tm1Displacement {Γ : Type} [Inhabited Γ] (M : Λ → TM1.Stmt Γ Λ σ) :
    ℕ → TM1.Cfg Γ Λ σ → ℤ
  | 0, _ => 0
  | n+1, c =>
    match TM1.step M c, c.l with
    | some c', some l => stmtShift (M l) c.var c.Tape + tm1Displacement M n c'
    | _, _ => 0

def tm1TickBound {Γ : Type} (M : Λ → TM1.Stmt Γ Λ σ) : ℕ :=
  Finset.univ.sup (fun l => stmtTicks (M l))

omit [Inhabited Λ] [Inhabited σ] [Fintype σ] in

theorem tm1TickBound_le {Γ : Type} (M : Λ → TM1.Stmt Γ Λ σ) (l : Λ) :
    stmtTicks (M l) ≤ tm1TickBound M := by
  exact Finset.le_sup (f := fun l => stmtTicks (M l)) (Finset.mem_univ l)

omit [Fintype σ] in

theorem tm1_execution_trace (M : Λ → TM1.Stmt Symbol Λ σ) (n : ℕ)
    (first last : TM1.Cfg Symbol Λ σ) (h : tm1Run M n first = some last) :
    ∃ ticks, n ≤ ticks ∧ ticks ≤ n * tm1TickBound M ∧
      Trace (TM1to0.tr M) (TM1to0.trCfg M first) (TM1to0.trCfg M last)
        ticks (tm1Displacement M n first) := by
  induction n generalizing first with
  | zero =>
    simp only [tm1Run, Option.some.injEq] at h
    subst last
    exact ⟨0, le_rfl, Nat.zero_le _, Trace.refl _ _⟩
  | succ n ih =>
    cases hs : TM1.step M first with
    | none => simp only [tm1Run, hs, Option.bind_none, reduceCtorEq] at h
    | some next =>
      have hn : tm1Run M n next = some last := by
        simpa only [tm1Run, hs, Option.bind_some] using h
      obtain ⟨ticks, hlo, hhi, ht⟩ := ih next hn
      rcases first with ⟨l,v,tape⟩
      cases l with
      | none => simp only [TM1.step, reduceCtorEq] at hs
      | some l =>
        have he : TM1.stepAux (M l) v tape = next := Option.some.inj hs
        obtain ⟨s, hspos, hsbound, hsTrace⟩ := tm1_statement_trace M (M l) v tape
        rw [he] at hsTrace
        have hsmax := hsbound.trans (tm1TickBound_le M l)
        refine ⟨s+ticks, by omega, ?_, ?_⟩
        · simpa only [Nat.succ_mul, Nat.add_comm] using Nat.add_le_add hsmax hhi
        · simpa only [tm1Displacement, hs] using! hsTrace.trans ht

end FiniteTM1
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM
open Turing

section FiniteControl
variable {Λ : Type} [Inhabited Λ]

noncomputable def controlCode (S : Finset Λ) (l : Λ) : Fin (S.card+1) := by
  classical
  exact if l=default then 0 else if h : l∈S then (S.equivFin ⟨l,h⟩).succ else 0

noncomputable def controlLabel (S : Finset Λ) : Fin (S.card+1) → Λ :=
  Fin.cases default (fun i => (S.equivFin.symm i).val)

@[simp] theorem controlCode_default (S : Finset Λ) : controlCode S default = 0 := by
  classical
  simp [controlCode]

theorem controlLabel_code (S : Finset Λ) (l : Λ) (hl : l∈S) :
    controlLabel S (controlCode S l) = l := by
  classical
  by_cases h : l=default
  · subst l
    simp [controlCode,controlLabel]
  · simp [controlCode,h,hl,controlLabel]

noncomputable def finiteMachine (S : Finset Λ) (M : TM0.Machine Symbol Λ) :
    TM0.Machine Symbol (Fin (S.card+1)) :=
  fun l a => (M (controlLabel S l) a).map (fun p => (controlCode S p.1,p.2))

noncomputable def finiteCfg (S : Finset Λ) (c : TM0.Cfg Symbol Λ) :
    TM0.Cfg Symbol (Fin (S.card+1)) := ⟨controlCode S c.q,c.Tape⟩

theorem finite_step (S : Finset Λ) (M : TM0.Machine Symbol Λ)
    (c : TM0.Cfg Symbol Λ) (hc : c.q∈S) :
    TM0.step (finiteMachine S M) (finiteCfg S c) = (TM0.step M c).map (finiteCfg S) := by
  simp only [TM0.step,finiteMachine,finiteCfg,controlLabel_code S c.q hc]
  cases M c.q c.Tape.head with
  | none => rfl
  | some p => cases p.2 <;> rfl

theorem finite_nextOffset (S : Finset Λ) (M : TM0.Machine Symbol Λ)
    (c : TM0.Cfg Symbol Λ) (hc : c.q∈S) :
    nextOffset (finiteMachine S M) (finiteCfg S c) = nextOffset M c := by
  simp only [nextOffset,finiteMachine,finiteCfg,controlLabel_code S c.q hc]
  cases M c.q c.Tape.head <;> rfl

theorem run_supports (M : TM0.Machine Symbol Λ) (S : Finset Λ)
    (hs : TM0.Supports M (S : Set Λ)) (n : ℕ) (first last : TM0.Cfg Symbol Λ)
    (hf : first.q∈S) (h : run M n first = some last) : last.q∈S := by
  induction n generalizing first last with
  | zero =>
    have he : first=last := Option.some.inj h
    simpa only [← he] using hf
  | succ n ih =>
    rw [run_succ_last] at h
    cases ht : run M n first with
    | none => simp only [ht,Option.bind_none,reduceCtorEq] at h
    | some next =>
      have hn : TM0.step M next = some last := by
        simpa only [ht,Option.bind_some] using h
      exact TM0.step_supports M hs hn (ih first next hf ht)

theorem finite_run (S : Finset Λ) (M : TM0.Machine Symbol Λ)
    (hs : TM0.Supports M (S : Set Λ)) (n : ℕ) (c : TM0.Cfg Symbol Λ) (hc : c.q∈S) :
    run (finiteMachine S M) n (finiteCfg S c) = (run M n c).map (finiteCfg S) := by
  induction n with
  | zero => rfl
  | succ n ih =>
    rw [run_succ_last,ih,run_succ_last]
    cases hr : run M n c with
    | none => rfl
    | some next =>
      simp only [Option.map_some,Option.bind_some]
      exact finite_step S M next (run_supports M S hs n c next hc hr)

theorem finite_offset (S : Finset Λ) (M : TM0.Machine Symbol Λ)
    (hs : TM0.Supports M (S : Set Λ)) (n : ℕ) (c : TM0.Cfg Symbol Λ) (hc : c.q∈S) :
    offset (finiteMachine S M) (finiteCfg S c) n = offset M c n := by
  induction n with
  | zero => rfl
  | succ n ih =>
    simp only [offset,ih,finite_run S M hs n c hc]
    cases hr : run M n c with
    | none => rfl
    | some next =>
      simp only [Option.map_some,Option.elim_some]
      rw [finite_nextOffset S M next (run_supports M S hs n c next hc hr)]

theorem Trace.finite {S : Finset Λ} {M : TM0.Machine Symbol Λ}
    (hs : TM0.Supports M (S : Set Λ)) {first last : TM0.Cfg Symbol Λ}
    {n : ℕ} {d : ℤ} (h : Trace M first last n d) (hf : first.q∈S) :
    Trace (finiteMachine S M) (finiteCfg S first) (finiteCfg S last) n d := by
  constructor
  · rw [finite_run S M hs n first hf,h.reached]
    rfl
  · rw [finite_offset S M hs n first hf,h.offset_eq]

@[simp] theorem finiteCfg_init (S : Finset Λ) (input : List Symbol) :
    finiteCfg S (TM0.init input) = TM0.init input := by
  simp [finiteCfg,TM0.init]

end FiniteControl
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM
open Turing
section FiniteTM1Machine
variable {Λ σ : Type} [Inhabited Λ] [Inhabited σ] [Fintype Λ] [Fintype σ]

noncomputable def tm1Support (M : Λ → TM1.Stmt Symbol Λ σ) : Finset (TM1to0.Λ' M) :=
  TM1to0.trStmts M Finset.univ

omit [Inhabited σ] [Fintype σ] in

theorem tm1_univ_supports {Γ : Type} (M : Λ → TM1.Stmt Γ Λ σ) : TM1.Supports M Finset.univ := by
  refine ⟨Finset.mem_univ _,?_⟩
  intro l _
  induction M l with
  | move _ _ ih | write _ _ ih | load _ _ ih => exact ih
  | branch _ _ _ ih₁ ih₂ => exact ⟨ih₁,ih₂⟩
  | goto _ => intro a v; exact Finset.mem_univ _
  | halt => trivial

theorem tm1Support_supports (M : Λ → TM1.Stmt Symbol Λ σ) :
    TM0.Supports (TM1to0.tr M) (tm1Support M : Set (TM1to0.Λ' M)) :=
  TM1to0.tr_supports M (tm1_univ_supports M)

omit [Inhabited Λ] [Inhabited σ] in

theorem tm1Support_cfg (M : Λ → TM1.Stmt Symbol Λ σ) (c : TM1.Cfg Symbol Λ σ) :
    (TM1to0.trCfg M c).q∈tm1Support M := by
  classical
  rcases c with ⟨l,v,tape⟩
  change (l.map M,v) ∈ (TM1.stmts M Finset.univ).product (Finset.univ : Finset σ)
  apply Finset.mem_product.mpr
  refine ⟨?_,Finset.mem_univ _⟩
  cases l with
  | none => exact Finset.mem_insertNone.mpr (by simp)
  | some l =>
    apply Finset.mem_insertNone.mpr
    simp only [Option.map_some,Option.mem_def,Option.some.injEq,forall_eq',Finset.mem_biUnion]
    exact ⟨l,Finset.mem_univ _,TM1.stmts₁_self⟩

noncomputable def tm1Machine (M : Λ → TM1.Stmt Symbol Λ σ) :
    TM0.Machine Symbol (Fin ((tm1Support M).card+1)) :=
  finiteMachine (tm1Support M) (TM1to0.tr M)

noncomputable def tm1Cfg (M : Λ → TM1.Stmt Symbol Λ σ) (c : TM1.Cfg Symbol Λ σ) :
    TM0.Cfg Symbol (Fin ((tm1Support M).card+1)) :=
  finiteCfg (tm1Support M) (TM1to0.trCfg M c)

theorem tm1_finite_trace (M : Λ → TM1.Stmt Symbol Λ σ) (n : ℕ)
    (first last : TM1.Cfg Symbol Λ σ) (h : tm1Run M n first = some last) :
    ∃ ticks, n≤ticks ∧ ticks≤n*tm1TickBound M ∧
      Trace (tm1Machine M) (tm1Cfg M first) (tm1Cfg M last)
        ticks (tm1Displacement M n first) := by
  obtain ⟨ticks,hlo,hhi,ht⟩ := tm1_execution_trace M n first last h
  exact ⟨ticks,hlo,hhi,ht.finite (tm1Support_supports M) (tm1Support_cfg M first)⟩

@[simp] theorem tm1Cfg_init (M : Λ → TM1.Stmt Symbol Λ σ) (input : List Symbol) :
    tm1Cfg M (TM1.init input) = TM0.init input := by
  change finiteCfg (tm1Support M) (TM0.init input) = _
  exact finiteCfg_init _ _

theorem tm1_finite_halt (M : Λ → TM1.Stmt Symbol Λ σ) (c : TM1.Cfg Symbol Λ σ)
    (h : TM1.step M c=none) : TM0.step (tm1Machine M) (tm1Cfg M c)=none := by
  change TM0.step (finiteMachine _ _) (finiteCfg _ _)=none
  rw [finite_step _ _ _ (tm1Support_cfg M c)]
  rcases c with ⟨l,v,tape⟩
  cases l with
  | none => rfl
  | some l => simp only [TM1.step,reduceCtorEq] at h

theorem tm1_finite_runs (M : Λ → TM1.Stmt Symbol Λ σ)
    (input output : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (n budget : ℕ) (last : TM1.Cfg Symbol Λ σ)
    (h : tm1Run M n (TM1.init (input.map some))=some last)
    (hstop : TM1.step M last=none)
    (hzero : tm1Displacement M n (TM1.init (input.map some))=0)
    (hinput : input.length≤budget) (htime : n*tm1TickBound M≤budget)
    (hout : ∀ i, last.Tape.right₀.nth i=(output.map some).getD i none)
    (hleft : ∀ i, last.Tape.left.nth i=none) :
    Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Runs (tm1Machine M) input output budget budget := by
  obtain ⟨ticks,_,hb,ht⟩ := tm1_finite_trace M n _ last h
  rw [tm1Cfg_init,hzero] at ht
  exact ht.runs hinput (hb.trans htime) (tm1_finite_halt M last hstop) hout hleft

end FiniteTM1Machine
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM
open Turing

structure SourceTrace {Γ Λ σ : Type} [Inhabited Γ] (M : Λ → TM1.Stmt Γ Λ σ)
    (first last : TM1.Cfg Γ Λ σ) (steps : ℕ) (displacement : ℤ) : Prop where
  reached : tm1Run M steps first=some last
  shift_eq : tm1Displacement M steps first=displacement

theorem SourceTrace.prepend {Γ Λ σ : Type} [Inhabited Γ] {M : Λ → TM1.Stmt Γ Λ σ}
    {l : Λ} {v : σ} {tape : Tape Γ} {next last : TM1.Cfg Γ Λ σ}
    {n : ℕ} {d s : ℤ} (tail : SourceTrace M next last n d)
    (hs : TM1.step M ⟨some l,v,tape⟩=some next)
    (hd : stmtShift (M l) v tape=s) :
    SourceTrace M ⟨some l,v,tape⟩ last (n+1) (s+d) := by
  constructor
  · simpa only [tm1Run,hs,Option.bind_some] using tail.reached
  · simp only [tm1Displacement,hs,hd,tail.shift_eq]

theorem SourceTrace.one {Γ Λ σ : Type} [Inhabited Γ] {M : Λ → TM1.Stmt Γ Λ σ}
    {l : Λ} {v : σ} {tape : Tape Γ} {last : TM1.Cfg Γ Λ σ} {s : ℤ}
    (hs : TM1.step M ⟨some l,v,tape⟩=some last)
    (hd : stmtShift (M l) v tape=s) :
    SourceTrace M ⟨some l,v,tape⟩ last 1 s := by
  constructor
  · simpa only [tm1Run,Option.bind_some] using! hs
  · simp only [tm1Displacement,hs,hd,add_zero]

def mapProgram (f : Bool → Bool) (l : Fin 2) : TM1.Stmt Symbol (Fin 2) Unit :=
  if l=0 then
    .branch (fun a _ => a.isSome)
      (.write (fun a _ => a.map f) (.move .right (.goto (fun _ _ => 0))))
      (.goto (fun _ _ => 1))
  else
    .move .left (.branch (fun a _ => a.isSome)
      (.goto (fun _ _ => 1)) (.move .right .halt))

theorem mapProgram_return (f : Bool → Bool) (left right : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) :
    SourceTrace (mapProgram f) ⟨some 1,(),Tape.mk₂ (left.map some) (right.map some)⟩
      ⟨none,(),Tape.mk₁ ((left.reverse++right).map some)⟩ (left.length+1) (-(left.length : ℤ)) := by
  induction left generalizing right with
  | nil =>
    apply SourceTrace.one
    · simp only [TM1.step,mapProgram,show (1 : Fin 2)≠0 by decide,if_false,TM1.stepAux]
      rw [show ((Tape.mk₂ ([].map some) (right.map some)).move .left).head=none by rfl]
      simp only [Option.isSome_none,cond_false,Tape.move_left_right,
        List.reverse_nil,List.nil_append,List.map_nil,Tape.mk₁]
    · simp [mapProgram,stmtShift,stmtOffset,Tape.mk₂,Tape.move_left_mk',show (default : Symbol)=none from rfl]
  | cons b left ih =>
    have ht := (ih (b::right)).prepend (l := (1 : Fin 2))
      (tape := Tape.mk₂ ((b::left).map some) (right.map some))
      (by
        simp only [TM1.step,mapProgram,show (1 : Fin 2)≠0 by decide,if_false,TM1.stepAux]
        have hm : (Tape.mk₂ ((b::left).map some) (right.map some)).move .left =
            Tape.mk₂ (left.map some) ((b::right).map some) := by
          simp [Tape.mk₂,Tape.move_left_mk',ListBlank.cons_mk]
        rw [hm]
        rfl)
      (s := -1) (by
        simp [mapProgram,stmtShift,stmtOffset,Tape.mk₂,Tape.move_left_mk'])
    convert! ht using 1 <;> simp [List.reverse_cons,List.append_assoc,Int.add_comm]

theorem mapProgram_scan (f : Bool → Bool) (rest left : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) :
    SourceTrace (mapProgram f) ⟨some 0,(),Tape.mk₂ (left.map some) (rest.map some)⟩
      ⟨none,(),Tape.mk₁ ((left.reverse++rest.map f).map some)⟩
      (left.length+2*rest.length+2) (-(left.length : ℤ)) := by
  induction rest generalizing left with
  | nil =>
    have ht := (mapProgram_return f left []).prepend (l := (0 : Fin 2))
      (tape := Tape.mk₂ (left.map some) []) (by rfl) (s := 0) (by rfl)
    simpa using ht
  | cons b rest ih =>
    have hm : ((Tape.mk₂ (left.map some) ((b::rest).map some)).write (some (f b))).move .right =
        Tape.mk₂ ((f b::left).map some) (rest.map some) := by
      simp [Tape.mk₂,Tape.write_mk',Tape.move_right_mk',ListBlank.cons_mk]
    have ht := (ih (f b::left)).prepend (l := (0 : Fin 2))
      (tape := Tape.mk₂ (left.map some) ((b::rest).map some))
      (by
        change some (TM1.stepAux (mapProgram f 0) () (Tape.mk₂ _ _))=_
        change some (TM1.Cfg.mk (some 0) ()
          (((Tape.mk₂ (left.map some) ((b::rest).map some)).write (some (f b))).move .right))=_
        rw [hm])
      (s := 1) (by simp [mapProgram,stmtShift,stmtOffset,Tape.mk₂])
    convert! ht using 1 <;> simp [List.reverse_cons,List.append_assoc]
    omega

theorem mapProgram_tickBound (f : Bool → Bool) : tm1TickBound (mapProgram f)≤3 := by
  apply Finset.sup_le
  intro l _
  by_cases h : l=0 <;> simp [mapProgram,h,stmtTicks]

theorem bit_map_runs (f : Bool → Bool) (input : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) :
    Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Runs (tm1Machine (mapProgram f)) input (input.map f)
      (6*input.length+6) (6*input.length+6) := by
  have ht := mapProgram_scan f input []
  apply tm1_finite_runs (mapProgram f) input (input.map f) (2*input.length+2)
    (6*input.length+6) ⟨none,(),Tape.mk₁ ((input.map f).map some)⟩
  · simpa only [List.length_nil,List.reverse_nil,List.nil_append,Nat.zero_add,Tape.mk₁,TM1.init]
      using! ht.reached
  · rfl
  · simpa only
      [List.length_nil,Nat.zero_add,List.map_nil,Int.natCast_zero,neg_zero,Tape.mk₁,TM1.init] using! ht.shift_eq
  · omega
  · have hb := Nat.mul_le_mul_left (2*input.length+2) (mapProgram_tickBound f)
    omega
  · intro i
    simp [Tape.mk₁,Tape.mk₂,Tape.mk'_right₀,ListBlank.nth_mk,List.getI_eq_getElem?_getD,show (default : Symbol)=none from rfl]
  · intro i
    rfl

end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM
open Turing
section SourceExecution
variable {Γ Λ σ : Type} [Inhabited Γ]

theorem tm1Run_add (M : Λ → TM1.Stmt Γ Λ σ) (n m : ℕ)
    (first mid : TM1.Cfg Γ Λ σ) (h : tm1Run M n first=some mid) :
    tm1Run M (n+m) first=tm1Run M m mid := by
  induction n generalizing first with
  | zero =>
    have he : first=mid := Option.some.inj h
    subst mid
    simp only [Nat.zero_add]
  | succ n ih =>
    cases hs : TM1.step M first with
    | none => simp only [tm1Run,hs,Option.bind_none,reduceCtorEq] at h
    | some next =>
      have hn : tm1Run M n next=some mid := by simpa only [tm1Run,hs,Option.bind_some] using h
      simpa only [Nat.succ_add,tm1Run,hs,Option.bind_some] using ih next hn

theorem tm1Displacement_add (M : Λ → TM1.Stmt Γ Λ σ) (n m : ℕ)
    (first mid : TM1.Cfg Γ Λ σ) (h : tm1Run M n first=some mid) :
    tm1Displacement M (n+m) first=tm1Displacement M n first+tm1Displacement M m mid := by
  induction n generalizing first with
  | zero =>
    have he : first=mid := Option.some.inj h
    subst mid
    simp only [tm1Displacement,zero_add]
  | succ n ih =>
    cases hs : TM1.step M first with
    | none => simp only [tm1Run,hs,Option.bind_none,reduceCtorEq] at h
    | some next =>
      have hn : tm1Run M n next=some mid := by simpa only [tm1Run,hs,Option.bind_some] using h
      rcases first with ⟨l,v,tape⟩
      cases l with
      | none => simp only [TM1.step,reduceCtorEq] at hs
      | some l =>
        rw [Nat.succ_add]
        simp only [tm1Displacement,hs]
        change stmtShift (M l) v tape+tm1Displacement M (n+m) next =
          (stmtShift (M l) v tape+tm1Displacement M n next)+tm1Displacement M m mid
        rw [ih next hn,add_assoc]

theorem SourceTrace.trans {M : Λ → TM1.Stmt Γ Λ σ} {first mid last : TM1.Cfg Γ Λ σ}
    {n m : ℕ} {d e : ℤ} (h : SourceTrace M first mid n d) (k : SourceTrace M mid last m e) :
    SourceTrace M first last (n+m) (d+e) := by
  constructor
  · rw [tm1Run_add M n m first mid h.reached]
    exact k.reached
  · rw [tm1Displacement_add M n m first mid h.reached,h.shift_eq,k.shift_eq]

theorem SourceTrace.refl (M : Λ → TM1.Stmt Γ Λ σ) (c : TM1.Cfg Γ Λ σ) :
    SourceTrace M c c 0 0 := ⟨rfl,rfl⟩
end SourceExecution
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.Stacks
open Turing Turing.TM2to1
variable {K : Type} [DecidableEq K] {Γ : K → Type} {Λ σ : Type}
variable (M : Λ → TM2.Stmt Γ Λ σ)

theorem go_trace {k : K} (o : StAct K Γ σ k) (q : TM2.Stmt Γ Λ σ) (v : σ)
    {S : List (Γ k)} {L : ListBlank (∀ k, Option (Γ k))}
    (hL : L.map (proj k)=ListBlank.mk (S.map some).reverse)
    (n : ℕ) (hn : n≤S.length) :
    SourceTrace (tr M) ⟨some (.go k o q),v,Tape.mk' ∅ (addBottom L)⟩
      ⟨some (.go k o q),v,(Tape.move .right)^[n] (Tape.mk' ∅ (addBottom L))⟩ n n := by
  induction n with
  | zero => exact SourceTrace.refl _ _
  | succ n ih =>
    have hsome : (((Tape.move .right)^[n] (Tape.mk' ∅ (addBottom L))).head.2 k).isNone=false := by
      rw [Tape.move_right_n_head,Tape.mk'_nth_nat,addBottom_nth_snd,stk_nth_val n hL,
        List.getElem?_eq_getElem (by simpa using (show n<S.length by omega))]
      rfl
    have hone : SourceTrace (tr M)
        ⟨some (.go k o q),v,(Tape.move .right)^[n] (Tape.mk' ∅ (addBottom L))⟩
        ⟨some (.go k o q),v,(Tape.move .right)^[n+1] (Tape.mk' ∅ (addBottom L))⟩ 1 1 := by
      apply SourceTrace.one
      · simp only [TM1.step,tr,TM1.stepAux,hsome,cond_false,Function.iterate_succ_apply']
      · simp only [tr,stmtShift,hsome,Bool.false_eq_true,if_false,stmtOffset,add_zero]
    simpa only [Int.natCast_add,Int.natCast_one] using (ih (by omega)).trans hone

theorem return_trace (q : TM2.Stmt Γ Λ σ) (v : σ)
    (L : ListBlank (∀ k, Option (Γ k))) (n : ℕ) :
    SourceTrace (tr M)
      ⟨some (.ret q),v,(Tape.move .right)^[n] (Tape.mk' ∅ (addBottom L))⟩
      ⟨some (.ret q),v,Tape.mk' ∅ (addBottom L)⟩ n (-(n : ℤ)) := by
  induction n with
  | zero => exact SourceTrace.refl _ _
  | succ n ih =>
    have ht := ih.prepend (l := .ret q) (v := v)
      (tape := (Tape.move .right)^[n+1] (Tape.mk' ∅ (addBottom L)))
      (by
        simp only [TM1.step]
        rw [Option.some_inj,tr,TM1.stepAux,Tape.move_right_n_head,Tape.mk'_nth_nat,
          addBottom_nth_succ_fst,cond_false,TM1.stepAux,Function.iterate_succ_apply',
          Tape.move_right_left]
        rfl)
      (s := -1) (by
        simp only [tr,stmtShift,Tape.move_right_n_head,Tape.mk'_nth_nat,
          addBottom_nth_succ_fst,Bool.false_eq_true,if_false,stmtOffset,add_zero])
    simpa only [Int.natCast_add,Int.natCast_one,neg_add_rev] using ht

theorem action_shift {k : K} (o : StAct K Γ σ k) (q : TM2.Stmt Γ Λ σ) (v : σ)
    (S : List (Γ k)) (L : ListBlank (∀ k, Option (Γ k))) :
    stmtShift (trStAct (.goto (fun _ _ => .ret q)) o) v
      ((Tape.move .right)^[S.length] (Tape.mk' ∅ (addBottom L))) =
      ((stWrite v S o).length : ℤ)-(S.length : ℤ) := by
  cases o with
  | push f => simp [trStAct,stmtShift,stmtOffset,stWrite]
  | peek f => simp [trStAct,stmtShift,stmtOffset,stWrite]
  | pop f =>
    cases S with
    | nil => simp [trStAct,stmtShift,stWrite,Tape.mk'_head,addBottom_head_fst]
    | cons a S =>
      have hb : (((Tape.move .right)^[(a::S).length] (Tape.mk' ∅ (addBottom L))).head).1=false := by
        rw [Tape.move_right_n_head,Tape.mk'_nth_nat]
        exact addBottom_nth_succ_fst L S.length
      change (if (((Tape.move .right)^[(a::S).length] (Tape.mk' ∅ (addBottom L))).head.1) then
        (0 : ℤ) else -1) = (S.length : ℤ)-((a::S).length : ℤ)
      rw [hb]
      simp

end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.Stacks

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.Stacks
open Turing Turing.TM2to1
variable {K : Type} [DecidableEq K] {Γ : K → Type} {Λ σ : Type}
variable (M : Λ → TM2.Stmt Γ Λ σ)

def stackClock : TM2.Stmt Γ Λ σ → σ → (∀ k, List (Γ k)) → ℕ
  | .push k f q,v,S => 2*(S k).length+3+stackClock q v (Function.update S k (f v::S k))
  | .peek k f q,v,S => 2*(S k).length+2+stackClock q (f v (S k).head?) S
  | .pop k f q,v,S => (S k).length+(S k).tail.length+2+
      stackClock q (f v (S k).head?) (Function.update S k (S k).tail)
  | .load f q,v,S => stackClock q (f v) S
  | .branch f a b,v,S => if f v then stackClock a v S else stackClock b v S
  | .goto _,_,_ => 0
  | .halt,_,_ => 0

theorem stackClock_run {k : K} (o : StAct K Γ σ k) (q : TM2.Stmt Γ Λ σ)
    (v : σ) (S : ∀ k, List (Γ k)) :
    stackClock (stRun o q) v S = (S k).length+(stWrite v (S k) o).length+2+
      stackClock q (stVar v (S k) o) (Function.update S k (stWrite v (S k) o)) := by
  cases o <;> simp [stackClock,stRun,stVar,stWrite,Function.update_eq_self] <;> omega

omit [DecidableEq K] in

theorem trNormal_shift (q : TM2.Stmt Γ Λ σ) (v : σ) (tape : Tape (Γ' K Γ)) :
    stmtShift (trNormal q) v tape=0 := by
  induction q generalizing v with
  | push _ _ _ | peek _ _ _ | pop _ _ _ | goto _ | halt => rfl
  | load f q ih => exact ih (f v)
  | branch p a b iha ihb =>
    simp only [trNormal,stmtShift]
    split
    · exact iha v
    · exact ihb v

theorem action_trace {k : K} (o : StAct K Γ σ k) (q : TM2.Stmt Γ Λ σ) (v : σ)
    (S : ∀ k, List (Γ k)) (L : ListBlank (∀ k, Option (Γ k)))
    (hL : ∀ k, L.map (proj k)=ListBlank.mk ((S k).map some).reverse) :
    ∃ L' : ListBlank (∀ k, Option (Γ k)),
      (∀ k', L'.map (proj k')=ListBlank.mk
        (((Function.update S k (stWrite v (S k) o)) k').map some).reverse) ∧
      SourceTrace (tr M)
        ⟨some (.go k o q),v,(Tape.move .right)^[(S k).length] (Tape.mk' ∅ (addBottom L))⟩
        ⟨some (.ret q),stVar v (S k) o,
          (Tape.move .right)^[(stWrite v (S k) o).length] (Tape.mk' ∅ (addBottom L'))⟩
        1 (((stWrite v (S k) o).length : ℤ)-(S k).length) := by
  obtain ⟨L',hL',hr⟩ := tr_respects_aux₂
    (q := TM1.Stmt.goto (fun _ _ => TM2to1.Λ'.ret q)) hL o
  refine ⟨L',hL',?_⟩
  have hnone : (((Tape.move .right)^[(S k).length] (Tape.mk' ∅ (addBottom L))).head.2 k).isNone=true := by
    rw [Tape.move_right_n_head,Tape.mk'_nth_nat,addBottom_nth_snd,stk_nth_val _ (hL k),
      List.getElem?_eq_none (le_of_eq List.length_reverse)]
    rfl
  apply SourceTrace.one
  · simp only [TM1.step,tr,TM1.stepAux,hnone,cond_true]
    rw [hr]
    simp only [Function.update_self,TM1.stepAux]
  · simp only [tr,stmtShift,hnone,if_true]
    exact action_shift o q v (S k) L

theorem stack_statement_trace (stmt : TM2.Stmt Γ Λ σ) (v : σ)
    (S : ∀ k, List (Γ k)) (L : ListBlank (∀ k, Option (Γ k)))
    (hL : ∀ k, L.map (proj k)=ListBlank.mk ((S k).map some).reverse) :
    ∃ last, TrCfg (TM2.stepAux stmt v S) last ∧
      SourceTrace (tr M) (TM1.stepAux (trNormal stmt) v (Tape.mk' ∅ (addBottom L)))
        last (stackClock stmt v S) 0 := by
  induction stmt using stmtStRec generalizing v S L with
  | run k o q ih =>
    obtain ⟨L',hL',ha⟩ := action_trace M o q v S L hL
    obtain ⟨last,hl,ht⟩ := ih (stVar v (S k) o)
      (Function.update S k (stWrite v (S k) o)) L' hL'
    have hr := return_trace M q (stVar v (S k) o) L' (stWrite v (S k) o).length
    have hd : SourceTrace (tr M)
        ⟨some (.ret q),stVar v (S k) o,Tape.mk' ∅ (addBottom L')⟩
        (TM1.stepAux (trNormal q) (stVar v (S k) o) (Tape.mk' ∅ (addBottom L'))) 1 0 := by
      apply SourceTrace.one
      · simp only [TM1.step,tr,TM1.stepAux,Tape.mk'_head,addBottom_head_fst,cond_true]
      · simp only [tr,stmtShift,Tape.mk'_head,addBottom_head_fst,if_true,trNormal_shift]
    have hall :=
        (((go_trace M o q v (hL k) (S k).length le_rfl).trans ha).trans hr).trans (hd.trans ht)
    refine ⟨last,?_,?_⟩
    · simpa only [step_run] using hl
    · rw [trNormal_run,TM1.stepAux,stackClock_run]
      convert! hall using 1 <;> omega
  | load f q ih => exact ih (f v) S L hL
  | branch p a b iha ihb =>
    cases hp : p v with
    | false => simpa only [TM2.stepAux,trNormal,TM1.stepAux,stackClock,hp,cond_false,
        Bool.false_eq_true,if_false] using ihb v S L hL
    | true => simpa only [TM2.stepAux,trNormal,TM1.stepAux,stackClock,hp,cond_true,if_true]
        using iha v S L hL
  | goto f => exact ⟨_,TrCfg.mk L hL,SourceTrace.refl _ _⟩
  | halt => exact ⟨_,TrCfg.mk L hL,SourceTrace.refl _ _⟩

end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.Stacks

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.Stacks
open Turing Turing.TM2to1
variable {K : Type} [DecidableEq K] {Γ : K → Type} {Λ σ : Type}

def stackNodes : TM2.Stmt Γ Λ σ → ℕ
  | .push _ _ q | .peek _ _ q | .pop _ _ q => stackNodes q+1
  | .load _ q => stackNodes q
  | .branch _ a b => max (stackNodes a) (stackNodes b)
  | .goto _ | .halt => 0

omit [DecidableEq K] in

theorem stackNodes_run {k : K} (o : StAct K Γ σ k) (q : TM2.Stmt Γ Λ σ) :
    stackNodes (stRun o q)=stackNodes q+1 := by cases o <;> rfl

theorem stackClock_bound (stmt : TM2.Stmt Γ Λ σ) (v : σ) (S : ∀ k, List (Γ k))
    (height : ℕ) (hS : ∀ k, (S k).length≤height) :
    stackClock stmt v S≤2*stackNodes stmt*(height+stackNodes stmt+1) := by
  induction stmt using stmtStRec generalizing v S height with
  | run k o q ih =>
    have hlen : (stWrite v (S k) o).length≤(S k).length+1 := by
      cases o <;> simp [stWrite]
      omega
    have hnew : ∀ j, ((Function.update S k (stWrite v (S k) o)) j).length≤height+1 := by
      intro j
      by_cases h : j=k
      · subst j
        rw [Function.update_self]
        exact hlen.trans (Nat.succ_le_succ (hS k))
      · rw [Function.update_of_ne h]
        exact (hS j).trans (Nat.le_succ height)
    have hi := ih (stVar v (S k) o) (Function.update S k (stWrite v (S k) o)) (height+1) hnew
    rw [stackClock_run,stackNodes_run]
    have hs := hS k
    nlinarith
  | load f q ih => exact ih (f v) S height hS
  | branch p a b iha ihb =>
    simp only [stackClock,stackNodes]
    split
    · exact (iha v S height hS).trans
        (Nat.mul_le_mul (Nat.mul_le_mul_left 2 (Nat.le_max_left _ _))
          (Nat.add_le_add_right (Nat.add_le_add_left (Nat.le_max_left _ _) height) 1))
    · exact (ihb v S height hS).trans
        (Nat.mul_le_mul (Nat.mul_le_mul_left 2 (Nat.le_max_right _ _))
          (Nat.add_le_add_right (Nat.add_le_add_left (Nat.le_max_right _ _) height) 1))
  | goto _ | halt => simp [stackClock,stackNodes]

def stackRun (M : Λ → TM2.Stmt Γ Λ σ) : ℕ → TM2.Cfg Γ Λ σ → Option (TM2.Cfg Γ Λ σ)
  | 0,c => some c
  | n+1,c => (TM2.step M c).bind (stackRun M n)

def stackRunClock (M : Λ → TM2.Stmt Γ Λ σ) : ℕ → TM2.Cfg Γ Λ σ → ℕ
  | 0,_ => 0
  | n+1,c => match TM2.step M c,c.l with
    | some next,some l => 1+stackClock (M l) c.var c.stk+stackRunClock M n next
    | _,_ => 0

theorem stack_step_trace (M : Λ → TM2.Stmt Γ Λ σ)
    (first next : TM2.Cfg Γ Λ σ) (first' : TM1.Cfg (Γ' K Γ) (Λ' K Γ Λ σ) σ)
    (hf : TrCfg first first') (hs : TM2.step M first=some next) :
    ∃ next', TrCfg next next' ∧
      SourceTrace (tr M) first' next' (stackRunClock M 1 first) 0 := by
  rcases hf with @⟨l,v,S,L,hL⟩
  cases l with
  | none => simp only [TM2.step,reduceCtorEq] at hs
  | some l =>
    have he : TM2.stepAux (M l) v S=next := Option.some.inj hs
    obtain ⟨last,hl,ht⟩ := stack_statement_trace M (M l) v S L hL
    rw [he] at hl
    have hone : SourceTrace (tr M)
        ⟨some (.normal l),v,Tape.mk' ∅ (addBottom L)⟩
        (TM1.stepAux (trNormal (M l)) v (Tape.mk' ∅ (addBottom L))) 1 0 := by
      apply SourceTrace.one
      · rfl
      · exact trNormal_shift _ _ _
    refine ⟨last,hl,?_⟩
    simpa only [stackRunClock,hs,Nat.add_zero,zero_add] using! hone.trans ht

theorem stack_execution_trace (M : Λ → TM2.Stmt Γ Λ σ) (n : ℕ)
    (first last : TM2.Cfg Γ Λ σ) (first' : TM1.Cfg (Γ' K Γ) (Λ' K Γ Λ σ) σ)
    (hf : TrCfg first first') (h : stackRun M n first=some last) :
    ∃ last', TrCfg last last' ∧
      SourceTrace (tr M) first' last' (stackRunClock M n first) 0 := by
  induction n generalizing first first' with
  | zero =>
    have he : first=last := Option.some.inj h
    subst last
    exact ⟨first',hf,SourceTrace.refl _ _⟩
  | succ n ih =>
    cases hs : TM2.step M first with
    | none => simp only [stackRun,hs,Option.bind_none,reduceCtorEq] at h
    | some next =>
      have hn : stackRun M n next=some last := by simpa only [stackRun,hs,Option.bind_some] using h
      obtain ⟨next',hm,ht⟩ := stack_step_trace M first next first' hf hs
      obtain ⟨last',hl,hu⟩ := ih next next' hm hn
      refine ⟨last',hl,?_⟩
      rcases first with ⟨l,v,S⟩
      cases l with
      | none => simp only [TM2.step,reduceCtorEq] at hs
      | some l =>
        simpa only [stackRunClock,hs,Nat.add_zero,zero_add] using ht.trans hu

end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.Stacks

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.Stacks
open Turing Turing.TM2to1

def stackPair (input output : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) : Fin 2 → List Bool :=
  fun i => if i=0 then input else output

@[simp] theorem stackPair_zero (input output : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) : stackPair input output 0=input := by
  simp [stackPair]

@[simp] theorem stackPair_one (input output : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) : stackPair input output 1=output := by
  simp [stackPair]

@[simp] theorem stackPair_update_zero (input output input' : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) :
    Function.update (stackPair input output) 0 input'=stackPair input' output := by
  funext i
  by_cases h : i=0 <;> simp [stackPair,Function.update_apply,h]

@[simp] theorem stackPair_update_one (input output output' : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) :
    Function.update (stackPair input output) 1 output'=stackPair input output' := by
  funext i
  by_cases h : i=0
  · subst i
    simp [stackPair]
  · have h₁ : i=1 := by
      apply Fin.ext
      have hi := i.isLt
      have hn : i.val≠0 := by
        intro he
        exact h (Fin.ext he)
      omega
    subst i
    simp [stackPair]

def transferProgram (_ : Fin 1) : TM2.Stmt (fun _ : Fin 2 => Bool) (Fin 1) (Option Bool) :=
  .pop 0 (fun _ bit => bit) (.branch (fun bit => bit.isSome)
    (.push 1 (fun bit => bit.getD false) (.goto (fun _ => 0))) .halt)

theorem transfer_step (b : Bool) (input output : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (v : Option Bool) :
    TM2.step transferProgram ⟨some 0,v,stackPair (b::input) output⟩=
      some ⟨some 0,some b,stackPair input (b::output)⟩ := by
  simp [TM2.step,transferProgram,TM2.stepAux]

theorem transfer_empty_step (output : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (v : Option Bool) :
    TM2.step transferProgram ⟨some 0,v,stackPair [] output⟩=
      some ⟨none,none,stackPair [] output⟩ := by
  simp [TM2.step,transferProgram,TM2.stepAux]

theorem transfer_run (input output : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (v : Option Bool) :
    stackRun transferProgram (input.length+1) ⟨some 0,v,stackPair input output⟩=
      some ⟨none,none,stackPair [] (input.reverse++output)⟩ := by
  induction input generalizing output v with
  | nil => simp only [List.length_nil,stackRun,transfer_empty_step,Option.bind_some,
      List.reverse_nil,List.nil_append]
  | cons b input ih =>
    simpa only [List.length_cons,stackRun,transfer_step,Option.bind_some,List.reverse_cons,
      List.append_assoc,List.singleton_append] using ih (b::output) (some b)

theorem transfer_clock (input output : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (v : Option Bool) :
    stackRunClock transferProgram (input.length+1) ⟨some 0,v,stackPair input output⟩=
      input.length*(2*(input.length+output.length)+5)+3 := by
  induction input generalizing output v with
  | nil => simp [stackRunClock,transferProgram,stackClock]
  | cons b input ih =>
    rw [stackRunClock,transfer_step]
    change 1+stackClock (transferProgram 0) v (stackPair (b::input) output)+
      stackRunClock transferProgram (input.length+1) ⟨some 0,some b,stackPair input (b::output)⟩=_
    rw [ih]
    simp only [transferProgram,stackClock,stackPair_zero,stackPair_update_zero,
      List.head?_cons,List.tail_cons,Option.isSome_some,if_true,stackPair_one,List.length_cons]
    nlinarith

theorem transfer_emulated (input output : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (v : Option Bool)
    (first : TM1.Cfg (Γ' (Fin 2) (fun _ => Bool))
      (Λ' (Fin 2) (fun _ => Bool) (Fin 1) (Option Bool)) (Option Bool))
    (hfirst : TrCfg (TM2.Cfg.mk (some 0) v (stackPair input output)) first) :
    ∃ last, TrCfg (TM2.Cfg.mk none none (stackPair [] (input.reverse++output))) last ∧
      SourceTrace (tr transferProgram) first last
        (input.length*(2*(input.length+output.length)+5)+3) 0 := by
  simpa only [transfer_clock] using stack_execution_trace transferProgram (input.length+1)
    _ _ first hfirst (transfer_run input output v)

end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.Stacks

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM
open Turing
section LabelRestriction
variable {Γ Λ σ : Type} [Inhabited Γ] [Inhabited Λ]

def relabelStmt {Λ' : Type} (code : Λ → Λ') : TM1.Stmt Γ Λ σ → TM1.Stmt Γ Λ' σ
  | .move d q => .move d (relabelStmt code q)
  | .write f q => .write f (relabelStmt code q)
  | .load f q => .load f (relabelStmt code q)
  | .branch f a b => .branch f (relabelStmt code a) (relabelStmt code b)
  | .goto f => .goto (fun a v => code (f a v))
  | .halt => .halt

def relabelCfg {Λ' : Type} (code : Λ → Λ') (c : TM1.Cfg Γ Λ σ) : TM1.Cfg Γ Λ' σ :=
  ⟨c.l.map code,c.var,c.Tape⟩

omit [Inhabited Λ] in

theorem relabel_stepAux {Λ' : Type} (code : Λ → Λ') (stmt : TM1.Stmt Γ Λ σ)
    (v : σ) (tape : Tape Γ) :
    TM1.stepAux (relabelStmt code stmt) v tape=relabelCfg code (TM1.stepAux stmt v tape) := by
  induction stmt generalizing v tape with
  | move _ _ ih | write _ _ ih | load _ _ ih => exact ih _ _
  | branch p _ _ iha ihb =>
    cases hp : p tape.head v <;> simp only [relabelStmt,TM1.stepAux,hp,cond_false,cond_true]
    · exact ihb _ _
    · exact iha _ _
  | goto _ | halt => rfl

omit [Inhabited Γ] [Inhabited Λ] in

theorem relabel_ticks {Λ' : Type} (code : Λ → Λ') (stmt : TM1.Stmt Γ Λ σ) :
    stmtTicks (relabelStmt code stmt)=stmtTicks stmt := by
  induction stmt <;> simp_all only [relabelStmt,stmtTicks]

omit [Inhabited Λ] in

theorem relabel_shift {Λ' : Type} (code : Λ → Λ') (stmt : TM1.Stmt Γ Λ σ)
    (v : σ) (tape : Tape Γ) : stmtShift (relabelStmt code stmt) v tape=stmtShift stmt v tape := by
  induction stmt generalizing v tape with
  | move _ _ ih => simpa only [relabelStmt,stmtShift] using congrArg (fun z => _+z) (ih v _)
  | write _ _ ih | load _ _ ih => exact ih _ _
  | branch p _ _ iha ihb =>
    simp only [relabelStmt,stmtShift]
    split
    · exact iha _ _
    · exact ihb _ _
  | goto _ | halt => rfl

noncomputable def restrictedProgram (S : Finset Λ) (M : Λ → TM1.Stmt Γ Λ σ) :
    Fin (S.card+1) → TM1.Stmt Γ (Fin (S.card+1)) σ :=
  fun l => relabelStmt (controlCode S) (M (controlLabel S l))

noncomputable def restrictedCfg (S : Finset Λ) (c : TM1.Cfg Γ Λ σ) :
    TM1.Cfg Γ (Fin (S.card+1)) σ := relabelCfg (controlCode S) c

theorem restricted_step (S : Finset Λ) (M : Λ → TM1.Stmt Γ Λ σ)
    (c : TM1.Cfg Γ Λ σ) (hc : c.l∈Finset.insertNone S) :
    TM1.step (restrictedProgram S M) (restrictedCfg S c)=
      (TM1.step M c).map (restrictedCfg S) := by
  rcases c with ⟨l,v,tape⟩
  cases l with
  | none => rfl
  | some l =>
    have hl := Finset.some_mem_insertNone.mp hc
    simp only [TM1.step,restrictedCfg,relabelCfg,Option.map_some,restrictedProgram,
      controlLabel_code S l hl,Option.map_some]
    exact congrArg some (relabel_stepAux _ _ _ _)

theorem restricted_run (S : Finset Λ) (M : Λ → TM1.Stmt Γ Λ σ)
    (hs : TM1.Supports M S) (n : ℕ) (c : TM1.Cfg Γ Λ σ) (hc : c.l∈Finset.insertNone S) :
    tm1Run (restrictedProgram S M) n (restrictedCfg S c)=
      (tm1Run M n c).map (restrictedCfg S) := by
  induction n generalizing c with
  | zero => rfl
  | succ n ih =>
    rw [tm1Run,restricted_step S M c hc]
    cases ht : TM1.step M c with
    | none => simp only [tm1Run,ht,Option.map_none,Option.bind_none]
    | some next =>
      simpa only [tm1Run,ht,Option.map_some,Option.bind_some] using
        ih next (TM1.step_supports M hs ht hc)

theorem restricted_displacement (S : Finset Λ) (M : Λ → TM1.Stmt Γ Λ σ)
    (hs : TM1.Supports M S) (n : ℕ) (c : TM1.Cfg Γ Λ σ) (hc : c.l∈Finset.insertNone S) :
    tm1Displacement (restrictedProgram S M) n (restrictedCfg S c)=tm1Displacement M n c := by
  induction n generalizing c with
  | zero => rfl
  | succ n ih =>
    have hstep := restricted_step S M c hc
    rcases c with ⟨l,v,tape⟩
    cases l with
    | none => rfl
    | some l =>
      have hl := Finset.some_mem_insertNone.mp hc
      dsimp only [restrictedCfg,relabelCfg,Option.map_some] at hstep
      cases ht : TM1.step M ⟨some l,v,tape⟩ with
      | none =>
        rw [ht] at hstep
        change tm1Displacement (restrictedProgram S M) (n+1)
          ⟨some (controlCode S l),v,tape⟩=_
        simp only [tm1Displacement,hstep,Option.map_none,ht]
      | some next =>
        rw [ht] at hstep
        change tm1Displacement (restrictedProgram S M) (n+1)
          ⟨some (controlCode S l),v,tape⟩=_
        simp only [tm1Displacement,hstep,Option.map_some,ht,restrictedProgram,
          controlLabel_code S l hl,relabel_shift]
        exact congrArg (fun z => stmtShift (M l) v tape+z)
          (ih next (TM1.step_supports M hs ht hc))

theorem SourceTrace.restrict {S : Finset Λ} {M : Λ → TM1.Stmt Γ Λ σ}
    (hs : TM1.Supports M S) {first last : TM1.Cfg Γ Λ σ} {n : ℕ} {d : ℤ}
    (h : SourceTrace M first last n d) (hf : first.l∈Finset.insertNone S) :
    SourceTrace (restrictedProgram S M) (restrictedCfg S first) (restrictedCfg S last) n d := by
  constructor
  · rw [restricted_run S M hs n first hf,h.reached]
    rfl
  · rw [restricted_displacement S M hs n first hf,h.shift_eq]

@[simp] theorem restrictedCfg_init [Inhabited σ] (S : Finset Λ) (input : List Γ) :
    restrictedCfg S (TM1.init input)= (TM1.init input : TM1.Cfg Γ (Fin (S.card+1)) σ) := by
  simp [restrictedCfg,relabelCfg,TM1.init]
end LabelRestriction
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM
open Turing

def boolSymbol : PointedMap Bool Symbol := ⟨fun b => if b then some true else none,rfl⟩
def symbolBool (a : Symbol) : Bool := a.getD false

@[simp] theorem symbolBool_boolSymbol (b : Bool) : symbolBool (boolSymbol b)=b := by
  cases b <;> rfl

section BoolWorkAlphabet
variable {Λ σ : Type}

def boolStmt : TM1.Stmt Bool Λ σ → TM1.Stmt Symbol Λ σ
  | .move d q => .move d (boolStmt q)
  | .write f q => .write (fun a v => boolSymbol (f (symbolBool a) v)) (boolStmt q)
  | .load f q => .load (fun a v => f (symbolBool a) v) (boolStmt q)
  | .branch p a b => .branch (fun a v => p (symbolBool a) v) (boolStmt a) (boolStmt b)
  | .goto f => .goto (fun a v => f (symbolBool a) v)
  | .halt => .halt

def boolCfg (c : TM1.Cfg Bool Λ σ) : TM1.Cfg Symbol Λ σ := ⟨c.l,c.var,c.Tape.map boolSymbol⟩
def boolProgram (M : Λ → TM1.Stmt Bool Λ σ) : Λ → TM1.Stmt Symbol Λ σ := fun l => boolStmt (M l)

theorem bool_stepAux (stmt : TM1.Stmt Bool Λ σ) (v : σ) (tape : Tape Bool) :
    TM1.stepAux (boolStmt stmt) v (tape.map boolSymbol)=boolCfg (TM1.stepAux stmt v tape) := by
  induction stmt generalizing v tape with
  | move d q ih =>
    simpa only [boolStmt,TM1.stepAux,Tape.map_move] using ih v (tape.move d)
  | write f q ih =>
    simpa only [boolStmt,TM1.stepAux,Tape.map_fst,symbolBool_boolSymbol,Tape.map_write]
      using ih v (tape.write (f tape.head v))
  | load f q ih =>
    simpa only [boolStmt,TM1.stepAux,Tape.map_fst,symbolBool_boolSymbol]
      using ih (f tape.head v) tape
  | branch p a b iha ihb =>
    simp only [boolStmt,TM1.stepAux,Tape.map_fst,symbolBool_boolSymbol]
    cases p tape.head v <;> simp only [cond_false,cond_true]
    · exact ihb v tape
    · exact iha v tape
  | goto f => simp only [boolStmt,TM1.stepAux,Tape.map_fst,symbolBool_boolSymbol]; rfl
  | halt => rfl

theorem bool_stmt_ticks (stmt : TM1.Stmt Bool Λ σ) : stmtTicks (boolStmt stmt)=stmtTicks stmt := by
  induction stmt <;> simp_all only [boolStmt,stmtTicks]

theorem bool_stmt_shift (stmt : TM1.Stmt Bool Λ σ) (v : σ) (tape : Tape Bool) :
    stmtShift (boolStmt stmt) v (tape.map boolSymbol)=stmtShift stmt v tape := by
  induction stmt generalizing v tape with
  | move d q ih => simpa only [boolStmt,stmtShift,Tape.map_move] using congrArg (fun z => _+z) (ih v (tape.move d))
  | write f q ih =>
    simpa only [boolStmt,stmtShift,Tape.map_fst,symbolBool_boolSymbol,Tape.map_write]
      using ih v (tape.write (f tape.head v))
  | load f q ih =>
    simpa only [boolStmt,stmtShift,Tape.map_fst,symbolBool_boolSymbol]
      using ih (f tape.head v) tape
  | branch p a b iha ihb =>
    simp only [boolStmt,stmtShift,Tape.map_fst,symbolBool_boolSymbol]
    split
    · exact iha v tape
    · exact ihb v tape
  | goto _ | halt => rfl

theorem bool_step (M : Λ → TM1.Stmt Bool Λ σ) (c : TM1.Cfg Bool Λ σ) :
    TM1.step (boolProgram M) (boolCfg c)=(TM1.step M c).map boolCfg := by
  rcases c with ⟨l,v,tape⟩
  cases l with
  | none => rfl
  | some l => exact congrArg some (bool_stepAux (M l) v tape)

theorem bool_run (M : Λ → TM1.Stmt Bool Λ σ) (n : ℕ) (c : TM1.Cfg Bool Λ σ) :
    tm1Run (boolProgram M) n (boolCfg c)=(tm1Run M n c).map boolCfg := by
  induction n generalizing c with
  | zero => rfl
  | succ n ih =>
    rw [tm1Run,bool_step]
    cases hs : TM1.step M c with
    | none => simp only [tm1Run,hs,Option.map_none,Option.bind_none]
    | some next => simpa only [tm1Run,hs,Option.map_some,Option.bind_some] using ih next

theorem bool_displacement (M : Λ → TM1.Stmt Bool Λ σ) (n : ℕ) (c : TM1.Cfg Bool Λ σ) :
    tm1Displacement (boolProgram M) n (boolCfg c)=tm1Displacement M n c := by
  induction n generalizing c with
  | zero => rfl
  | succ n ih =>
    have hstep := bool_step M c
    rcases c with ⟨l,v,tape⟩
    cases l with
    | none => rfl
    | some l =>
      change TM1.step (boolProgram M) ⟨some l,v,tape.map boolSymbol⟩=
        (TM1.step M ⟨some l,v,tape⟩).map boolCfg at hstep
      change tm1Displacement (boolProgram M) (n+1) ⟨some l,v,tape.map boolSymbol⟩=_
      simp only [tm1Displacement,hstep,boolProgram,bool_stmt_shift]
      cases hs : TM1.step M ⟨some l,v,tape⟩ with
      | none => rfl
      | some next => exact congrArg (fun z => stmtShift (M l) v tape+z) (ih next)

theorem SourceTrace.bool {M : Λ → TM1.Stmt Bool Λ σ} {first last : TM1.Cfg Bool Λ σ}
    {n : ℕ} {d : ℤ} (h : SourceTrace M first last n d) :
    SourceTrace (boolProgram M) (boolCfg first) (boolCfg last) n d := by
  constructor
  · rw [bool_run,h.reached]
    rfl
  · rw [bool_displacement,h.shift_eq]

theorem bool_supports_stmt (S : Finset Λ) (stmt : TM1.Stmt Bool Λ σ)
    (h : TM1.SupportsStmt S stmt) : TM1.SupportsStmt S (boolStmt stmt) := by
  induction stmt with
  | move _ _ ih | write _ _ ih | load _ _ ih => exact ih h
  | branch _ _ _ iha ihb => exact ⟨iha h.1,ihb h.2⟩
  | goto f => intro a v; exact h (symbolBool a) v
  | halt => trivial

theorem bool_supports [Inhabited Λ] (M : Λ → TM1.Stmt Bool Λ σ) (S : Finset Λ)
    (hs : TM1.Supports M S) : TM1.Supports (boolProgram M) S :=
  ⟨hs.1,fun l hl => bool_supports_stmt S (M l) (hs.2 l hl)⟩

end BoolWorkAlphabet
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM
open Turing
section SupportedTM1
variable {Λ σ : Type} [Inhabited Λ] [Inhabited σ] [Fintype σ]

noncomputable def supportedMachine (M : Λ → TM1.Stmt Symbol Λ σ) (S : Finset Λ) :=
  tm1Machine (restrictedProgram S M)

theorem supported_tm1_trace (M : Λ → TM1.Stmt Symbol Λ σ) (S : Finset Λ)
    (hs : TM1.Supports M S) (n : ℕ) (first last : TM1.Cfg Symbol Λ σ)
    (hf : first.l∈Finset.insertNone S) (h : SourceTrace M first last n 0) :
    ∃ ticks, n≤ticks ∧ ticks≤n*tm1TickBound (restrictedProgram S M) ∧
      Trace (supportedMachine M S)
        (tm1Cfg (restrictedProgram S M) (restrictedCfg S first))
        (tm1Cfg (restrictedProgram S M) (restrictedCfg S last)) ticks 0 := by
  have hr := h.restrict hs hf
  obtain ⟨ticks,hlo,hhi,ht⟩ := tm1_finite_trace (restrictedProgram S M) n _ _ hr.reached
  rw [hr.shift_eq] at ht
  exact ⟨ticks,hlo,hhi,ht⟩

theorem supported_tm1_runs (M : Λ → TM1.Stmt Symbol Λ σ) (S : Finset Λ)
    (hs : TM1.Supports M S) (input output : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (n budget : ℕ)
    (last : TM1.Cfg Symbol Λ σ)
    (h : SourceTrace M (TM1.init (input.map some)) last n 0)
    (hstop : TM1.step M last=none)
    (hinput : input.length≤budget) (htime : n*tm1TickBound (restrictedProgram S M)≤budget)
    (hout : ∀ i, last.Tape.right₀.nth i=(output.map some).getD i none)
    (hleft : ∀ i, last.Tape.left.nth i=none) :
    Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Runs (supportedMachine M S) input output budget budget := by
  have hf : (TM1.init (input.map some) : TM1.Cfg Symbol Λ σ).l∈Finset.insertNone S :=
    Finset.some_mem_insertNone.mpr hs.1
  have hr := h.restrict hs hf
  apply tm1_finite_runs (restrictedProgram S M) input output n budget (restrictedCfg S last)
  · simpa only [restrictedCfg_init] using hr.reached
  · rcases last with ⟨l,v,tape⟩
    cases l with
    | none => rfl
    | some l => simp only [TM1.step,reduceCtorEq] at hstop
  · simpa only [restrictedCfg_init] using hr.shift_eq
  · exact hinput
  · exact htime
  · exact hout
  · exact hleft

end SupportedTM1
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.Alphabet
open Turing
variable {Γ Λ σ : Type}

private def writeTape : List Bool → Tape Bool → Tape Bool
  | [],tape => tape
  | b::bits,tape => writeTape bits ((tape.write b).move .right)

theorem write_step (bits : List Bool) (q : TM1.Stmt Bool (TM1to1.Λ' Γ Λ σ) σ)
    (v : σ) (tape : Tape Bool) :
    TM1.stepAux (TM1to1.write bits q) v tape=TM1.stepAux q v (writeTape bits tape) := by
  induction bits generalizing tape with
  | nil => rfl
  | cons b bits ih => exact ih _

theorem write_shift (bits : List Bool) (q : TM1.Stmt Bool (TM1to1.Λ' Γ Λ σ) σ)
    (v : σ) (tape : Tape Bool) :
    stmtShift (TM1to1.write bits q) v tape=(bits.length : ℤ)+stmtShift q v (writeTape bits tape) := by
  induction bits generalizing tape with
  | nil => simp [TM1to1.write,writeTape]
  | cons b bits ih =>
    simp only [TM1to1.write,stmtShift,stmtOffset,ih,writeTape,List.length_cons,Int.natCast_add,
      Int.natCast_one]
    omega

theorem move_shift (n : ℕ) (d : Dir) (q : TM1.Stmt Bool (TM1to1.Λ' Γ Λ σ) σ)
    (v : σ) (tape : Tape Bool) :
    stmtShift (TM1to1.move n d q) v tape=
      (n : ℤ)*stmtOffset (.move d)+stmtShift q v ((Tape.move d)^[n] tape) := by
  unfold TM1to1.move
  induction n generalizing tape with
  | zero => simp
  | succ n ih =>
    rw [Function.iterate_succ_apply',stmtShift,ih,Function.iterate_succ_apply]
    cases d <;> simp only [stmtOffset,Int.natCast_add,Int.natCast_one,mul_neg,mul_one] <;> omega

private def readVector : (n : ℕ) → Tape Bool → List.Vector Bool n
  | 0,_ => List.Vector.nil
  | n+1,tape => tape.head ::ᵥ readVector n (tape.move .right)

theorem readAux_shift (n : ℕ)
    (f : List.Vector Bool n → TM1.Stmt Bool (TM1to1.Λ' Γ Λ σ) σ) (v : σ) (tape : Tape Bool) :
    stmtShift (TM1to1.readAux n f) v tape=(n : ℤ)+
      stmtShift (f (readVector n tape)) v ((Tape.move .right)^[n] tape) := by
  induction n generalizing tape with
  | zero => simp [TM1to1.readAux,readVector]
  | succ n ih =>
    rw [TM1to1.readAux,stmtShift]
    cases hb : tape.head <;> simp only [hb,Bool.false_eq_true,if_false,if_true,stmtShift,
      stmtOffset,ih,readVector,Function.iterate_succ_apply,Int.natCast_add,Int.natCast_one]
    <;> omega

theorem readVector_prefix (bits : List Bool) (left right : ListBlank Bool) :
    readVector bits.length (Tape.mk' left (ListBlank.append bits right))=⟨bits,rfl⟩ := by
  induction bits generalizing left with
  | nil => rfl
  | cons b bits ih =>
    simp only [List.length_cons,readVector,ListBlank.append,Tape.mk'_head,ListBlank.head_cons,
      Tape.move_right_mk',ListBlank.tail_cons,ih]
    rfl

theorem left_right (n : ℕ) (tape : Tape Bool) :
    (Tape.move .left)^[n] ((Tape.move .right)^[n] tape)=tape := by
  induction n with
  | zero => rfl
  | succ n ih =>
    rw [Function.iterate_succ_apply,Function.iterate_succ_apply',Tape.move_right_left,ih]

variable [Inhabited Γ] {n : ℕ} (enc : Γ → List.Vector Bool n)
    (dec : List.Vector Bool n → Γ) (enc0 : enc default=List.Vector.replicate n false)
    (encdec : ∀ a, dec (enc a)=a)

theorem readVector_encoded (L R : ListBlank Γ) :
    readVector n (TM1to1.trTape' enc0 L R)=enc R.head := by
  obtain ⟨a,R,rfl⟩ := R.exists_cons
  simp only [TM1to1.trTape',ListBlank.cons_flatMap,ListBlank.head_cons]
  apply Subtype.ext
  have hv := congrArg Subtype.val (readVector_prefix (enc a).toList
    (L.flatMap (fun x => (enc x).toList.reverse) ⟨n,by simp [enc0,List.Vector.replicate,List.Vector.toList_mk,List.reverse_replicate]⟩)
    (R.flatMap (fun x => (enc x).toList) ⟨n,by simp [enc0,List.Vector.replicate,List.Vector.toList_mk]⟩))
  change (readVector (enc a).toList.length _).toList=(enc a).toList at hv
  rw [(enc a).toList_length] at hv
  exact hv

include encdec in

theorem read_shift (f : Γ → TM1.Stmt Bool (TM1to1.Λ' Γ Λ σ) σ) (v : σ)
    (L R : ListBlank Γ) :
    stmtShift (TM1to1.read dec f) v (TM1to1.trTape' enc0 L R)=
      stmtShift (f R.head) v (TM1to1.trTape' enc0 L R) := by
  rw [TM1to1.read,readAux_shift,readVector_encoded enc enc0,move_shift,stmtOffset,
    mul_neg,mul_one,encdec,left_right]
  omega

end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.Alphabet

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.Alphabet
open Turing
variable {Γ Λ σ : Type} [Inhabited Γ] {n : ℕ}
    (enc : Γ → List.Vector Bool n) (dec : List.Vector Bool n → Γ)
    (enc0 : enc default=List.Vector.replicate n false) (encdec : ∀ a, dec (enc a)=a)

theorem write_encoded_shift (q : TM1.Stmt Bool (TM1to1.Λ' Γ Λ σ) σ)
    (v : σ) (a b : Γ) (L R : ListBlank Γ) :
    stmtShift (TM1to1.write (enc a).toList q) v (TM1to1.trTape' enc0 L (ListBlank.cons b R))=
      (n : ℤ)+stmtShift q v (TM1to1.trTape' enc0 (ListBlank.cons a L) R) := by
  have he := TM1to1.stepAux_write enc0 (TM1.Stmt.halt : TM1.Stmt Bool (TM1to1.Λ' Γ Λ σ) σ) v a b L R
  rw [write_step] at he
  have ht := congrArg TM1.Cfg.Tape he
  change writeTape (enc a).toList (TM1to1.trTape' enc0 L (ListBlank.cons b R))=
    TM1to1.trTape' enc0 (ListBlank.cons a L) R at ht
  rw [write_shift,ht,List.Vector.toList_length]

variable (M : Λ → TM1.Stmt Γ Λ σ)

theorem write_label_step (a b : Γ) (q : TM1.Stmt Γ Λ σ) (v : σ) (L R : ListBlank Γ) :
    TM1.step (TM1to1.tr enc dec M)
      ⟨some (.write a q),v,TM1to1.trTape' enc0 L (ListBlank.cons b R)⟩=
      some (TM1.stepAux (TM1to1.trNormal dec q) v (TM1to1.trTape' enc0 L (ListBlank.cons a R))) := by
  rw [TM1.step,TM1to1.tr,TM1to1.stepAux_write enc0,TM1to1.stepAux_move,
    TM1to1.trTape'_move_left enc0]
  simp only [ListBlank.head_cons,ListBlank.tail_cons]

theorem write_label_shift (a b : Γ) (q : TM1.Stmt Γ Λ σ) (v : σ) (L R : ListBlank Γ) :
    stmtShift ((TM1to1.tr enc dec M) (.write a q)) v
      (TM1to1.trTape' enc0 L (ListBlank.cons b R))=
      stmtShift (TM1to1.trNormal dec q) v (TM1to1.trTape' enc0 L (ListBlank.cons a R)) := by
  rw [TM1to1.tr,write_encoded_shift enc enc0,move_shift,stmtOffset,mul_neg,mul_one,
    TM1to1.trTape'_move_left enc0]
  simp only [ListBlank.head_cons,ListBlank.tail_cons]
  omega

def writeNodes : TM1.Stmt Γ Λ σ → ℕ
  | .move _ q | .load _ q => writeNodes q
  | .write _ q => writeNodes q+1
  | .branch _ a b => max (writeNodes a) (writeNodes b)
  | .goto _ | .halt => 0

include encdec in

theorem statement_aux (stmt : TM1.Stmt Γ Λ σ) (v : σ) (tape : Tape Γ) :
    ∃ ticks displacement, ticks≤writeNodes stmt ∧
      SourceTrace (TM1to1.tr enc dec M)
        (TM1.stepAux (TM1to1.trNormal dec stmt) v (TM1to1.trTape enc0 tape))
        (TM1to1.trCfg enc enc0 (TM1.stepAux stmt v tape)) ticks displacement ∧
      stmtShift (TM1to1.trNormal dec stmt) v (TM1to1.trTape enc0 tape)+displacement=
        (n : ℤ)*stmtShift stmt v tape := by
  induction stmt generalizing v tape with
  | move d q ih =>
    obtain ⟨ticks,diff,hbound,ht,hd⟩ := ih v (tape.move d)
    obtain ⟨L,R,rfl⟩ := tape.exists_mk'
    cases d with
    | left =>
      refine ⟨ticks,diff,hbound,?_,?_⟩
      · simpa only [TM1to1.trNormal,TM1to1.stepAux_move,Tape.move_left_mk',TM1to1.trTape_mk',
          TM1to1.trTape'_move_left,TM1.stepAux] using ht
      · simpa only [TM1to1.trNormal,move_shift,TM1to1.trTape_mk',TM1to1.trTape'_move_left,
          Tape.move_left_mk',stmtShift,stmtOffset,mul_neg,mul_one,Int.mul_add,add_assoc] using
          congrArg (fun z => -(n : ℤ)+z) hd
    | right =>
      refine ⟨ticks,diff,hbound,?_,?_⟩
      · simpa only [TM1to1.trNormal,TM1to1.stepAux_move,Tape.move_right_mk',TM1to1.trTape_mk',
          TM1to1.trTape'_move_right,TM1.stepAux] using ht
      · simpa only [TM1to1.trNormal,move_shift,TM1to1.trTape_mk',TM1to1.trTape'_move_right,
          Tape.move_right_mk',stmtShift,stmtOffset,mul_one,Int.mul_add,add_assoc] using
          congrArg (fun z => (n : ℤ)+z) hd
  | write f q ih =>
    obtain ⟨L,R,rfl⟩ := tape.exists_mk'
    obtain ⟨b,R,rfl⟩ := R.exists_cons
    obtain ⟨ticks,diff,hbound,ht,hd⟩ := ih v ((Tape.mk' L (ListBlank.cons b R)).write (f b v))
    have hone : SourceTrace (TM1to1.tr enc dec M)
        ⟨some (.write (f b v) q),v,TM1to1.trTape' enc0 L (ListBlank.cons b R)⟩
        (TM1.stepAux (TM1to1.trNormal dec q) v
          (TM1to1.trTape' enc0 L (ListBlank.cons (f b v) R))) 1
        (stmtShift (TM1to1.trNormal dec q) v (TM1to1.trTape' enc0 L (ListBlank.cons (f b v) R))) :=
      SourceTrace.one (write_label_step enc dec enc0 M _ _ _ _ _ _)
        (write_label_shift enc dec enc0 M _ _ _ _ _ _)
    simp only [Tape.write_mk',TM1to1.trTape_mk',ListBlank.tail_cons] at ht hd
    refine ⟨1+ticks,stmtShift (TM1to1.trNormal dec q) v
      (TM1to1.trTape' enc0 L (ListBlank.cons (f b v) R))+diff,
      by change 1+ticks≤writeNodes q+1; omega,?_,?_⟩
    · simpa only [TM1to1.trNormal,TM1to1.trTape_mk',TM1to1.stepAux_read dec enc0 encdec,
        TM1.stepAux,Tape.mk'_head,ListBlank.head_cons,Tape.write_mk',ListBlank.tail_cons] using hone.trans ht
    · rw [TM1to1.trNormal,TM1to1.trTape_mk',read_shift enc dec enc0 encdec]
      simpa only [stmtShift,Tape.mk'_head,ListBlank.head_cons,zero_add,Tape.write_mk',ListBlank.tail_cons] using hd
  | load f q ih =>
    obtain ⟨L,R,rfl⟩ := tape.exists_mk'
    simpa only [TM1to1.trNormal,TM1to1.trTape_mk',TM1to1.stepAux_read dec enc0 encdec,
      TM1.stepAux,read_shift enc dec enc0 encdec,stmtShift,writeNodes,Tape.mk'_head]
      using ih (f R.head v) (Tape.mk' L R)
  | branch p a b iha ihb =>
    obtain ⟨L,R,rfl⟩ := tape.exists_mk'
    cases hp : p R.head v with
    | false =>
      obtain ⟨ticks,diff,hbound,ht,hd⟩ := ihb v (Tape.mk' L R)
      refine ⟨ticks,diff,hbound.trans (Nat.le_max_right _ _),?_,?_⟩
      · simpa only [TM1to1.trNormal,TM1to1.trTape_mk',TM1to1.stepAux_read dec enc0 encdec,
          TM1.stepAux,Tape.mk'_head,hp,cond_false] using ht
      · simpa only [TM1to1.trNormal,TM1to1.trTape_mk',read_shift enc dec enc0 encdec,
          stmtShift,Tape.mk'_head,hp,Bool.false_eq_true,if_false] using hd
    | true =>
      obtain ⟨ticks,diff,hbound,ht,hd⟩ := iha v (Tape.mk' L R)
      refine ⟨ticks,diff,hbound.trans (Nat.le_max_left _ _),?_,?_⟩
      · simpa only [TM1to1.trNormal,TM1to1.trTape_mk',TM1to1.stepAux_read dec enc0 encdec,
          TM1.stepAux,Tape.mk'_head,hp,cond_true] using ht
      · simpa only [TM1to1.trNormal,TM1to1.trTape_mk',read_shift enc dec enc0 encdec,
          stmtShift,Tape.mk'_head,hp,if_true] using hd
  | goto f =>
    obtain ⟨L,R,rfl⟩ := tape.exists_mk'
    refine ⟨0,0,le_rfl,?_,?_⟩
    · simpa only [TM1to1.trNormal,TM1to1.trTape_mk',TM1to1.stepAux_read dec enc0 encdec,
        TM1.stepAux,TM1to1.trCfg,Tape.mk'_head,Option.map_some] using
        SourceTrace.refl (TM1to1.tr enc dec M)
          (TM1.Cfg.mk (some (.normal (f R.head v))) v (TM1to1.trTape' enc0 L R))
    · simp only [TM1to1.trNormal,TM1to1.trTape_mk',read_shift enc dec enc0 encdec,stmtShift,
        add_zero,mul_zero]
  | halt =>
    refine ⟨0,0,le_rfl,SourceTrace.refl _ _,?_⟩
    simp only [TM1to1.trNormal,stmtShift,add_zero,mul_zero]

end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.Alphabet

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.Alphabet
open Turing
variable {Γ Λ σ : Type} [Inhabited Γ] {n : ℕ}
    (enc : Γ → List.Vector Bool n) (dec : List.Vector Bool n → Γ)
    (enc0 : enc default=List.Vector.replicate n false) (encdec : ∀ a, dec (enc a)=a)
    (M : Λ → TM1.Stmt Γ Λ σ)

include encdec in

theorem step_trace (l : Λ) (v : σ) (tape : Tape Γ) :
    ∃ ticks, 0<ticks ∧ ticks≤1+writeNodes (M l) ∧
      SourceTrace (TM1to1.tr enc dec M) (TM1to1.trCfg enc enc0 ⟨some l,v,tape⟩)
        (TM1to1.trCfg enc enc0 (TM1.stepAux (M l) v tape)) ticks
        ((n : ℤ)*stmtShift (M l) v tape) := by
  obtain ⟨ticks,diff,hbound,ht,hd⟩ := statement_aux enc dec enc0 encdec M (M l) v tape
  have hone : SourceTrace (TM1to1.tr enc dec M)
      (TM1to1.trCfg enc enc0 ⟨some l,v,tape⟩)
      (TM1.stepAux (TM1to1.trNormal dec (M l)) v (TM1to1.trTape enc0 tape)) 1
      (stmtShift (TM1to1.trNormal dec (M l)) v (TM1to1.trTape enc0 tape)) := by
    apply SourceTrace.one <;> rfl
  have hall := hone.trans ht
  rw [hd] at hall
  exact ⟨1+ticks,by omega,by omega,hall⟩

noncomputable def tickFactor [Fintype Λ] : ℕ := 1+Finset.univ.sup (fun l => writeNodes (M l))

include encdec in

theorem execution_trace [Fintype Λ] (steps : ℕ) (first last : TM1.Cfg Γ Λ σ)
    (h : tm1Run M steps first=some last) :
    ∃ ticks, steps≤ticks ∧ ticks≤steps*tickFactor M ∧
      SourceTrace (TM1to1.tr enc dec M) (TM1to1.trCfg enc enc0 first)
        (TM1to1.trCfg enc enc0 last) ticks ((n : ℤ)*tm1Displacement M steps first) := by
  induction steps generalizing first with
  | zero =>
    have he : first=last := Option.some.inj h
    subst last
    exact ⟨0,le_rfl,Nat.zero_le _,by simpa only [tm1Displacement,mul_zero] using SourceTrace.refl _ _⟩
  | succ steps ih =>
    cases hs : TM1.step M first with
    | none => simp only [tm1Run,hs,Option.bind_none,reduceCtorEq] at h
    | some next =>
      have hn : tm1Run M steps next=some last := by simpa only [tm1Run,hs,Option.bind_some] using h
      obtain ⟨ticks,hlo,hhi,ht⟩ := ih next hn
      rcases first with ⟨l,v,tape⟩
      cases l with
      | none => simp only [TM1.step,reduceCtorEq] at hs
      | some l =>
        have he : TM1.stepAux (M l) v tape=next := Option.some.inj hs
        obtain ⟨s,hpos,hbound,hu⟩ := step_trace enc dec enc0 encdec M l v tape
        rw [he] at hu
        have hmax : 1+writeNodes (M l)≤tickFactor M :=
          Nat.add_le_add_left (Finset.le_sup (f := fun l => writeNodes (M l)) (Finset.mem_univ l)) 1
        refine ⟨s+ticks,by omega,?_,?_⟩
        · have hb := hbound.trans hmax
          rw [Nat.succ_mul]
          omega
        · simpa only [tm1Displacement,hs,Int.mul_add] using hu.trans ht

end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.Alphabet

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.Alphabet
open Turing
section PhysicalCompiler
variable {Γ Λ σ : Type} [Inhabited Γ] [Inhabited Λ] [Inhabited σ]
    [Fintype Γ] [Fintype Λ] [Fintype σ]
    {n : ℕ} (enc : Γ → List.Vector Bool n) (dec : List.Vector Bool n → Γ)
    (enc0 : enc default=List.Vector.replicate n false)
    (M : Λ → TM1.Stmt Γ Λ σ)

noncomputable def controlSupport : Finset (TM1to1.Λ' Γ Λ σ) := TM1to1.trSupp M Finset.univ

def physicalProgram : TM1to1.Λ' Γ Λ σ → TM1.Stmt Symbol (TM1to1.Λ' Γ Λ σ) σ :=
  boolProgram (TM1to1.tr enc dec M)

noncomputable def physicalMachine := supportedMachine (physicalProgram enc dec M) (controlSupport M)

noncomputable def physicalCfg (c : TM1.Cfg Γ Λ σ) :=
  tm1Cfg (restrictedProgram (controlSupport M) (physicalProgram enc dec M))
    (restrictedCfg (controlSupport M) (boolCfg (TM1to1.trCfg enc enc0 c)))

noncomputable def physicalFactor : ℕ :=
  tickFactor M*tm1TickBound (restrictedProgram (controlSupport M) (physicalProgram enc dec M))+1

omit [Inhabited Γ] [Inhabited σ] [Fintype σ] in

theorem physical_supports : TM1.Supports (physicalProgram enc dec M) (controlSupport M) :=
  bool_supports _ _ (TM1to1.tr_supports enc dec M (tm1_univ_supports M))

omit [Inhabited Λ] [Inhabited σ] [Fintype σ] in

theorem physical_label_mem (c : TM1.Cfg Γ Λ σ) :
    (boolCfg (TM1to1.trCfg enc enc0 c)).l∈Finset.insertNone (controlSupport M) := by
  classical
  rcases c with ⟨l,v,tape⟩
  cases l with
  | none => exact Finset.mem_insertNone.mpr (by simp [boolCfg,TM1to1.trCfg])
  | some l =>
    apply Finset.some_mem_insertNone.mpr
    exact Finset.mem_biUnion.mpr ⟨l,Finset.mem_univ _,Finset.mem_insert_self _ _⟩

@[simp] theorem physicalCfg_tape (c : TM1.Cfg Γ Λ σ) :
    (physicalCfg enc dec enc0 M c).Tape=(TM1to1.trTape enc0 c.Tape).map boolSymbol := rfl

theorem physical_execution (encdec : ∀ a, dec (enc a)=a) (steps : ℕ)
    (first last : TM1.Cfg Γ Λ σ) (h : tm1Run M steps first=some last) :
    ∃ ticks, steps≤ticks ∧ ticks≤steps*physicalFactor enc dec M ∧
      Trace (physicalMachine enc dec M) (physicalCfg enc dec enc0 M first)
        (physicalCfg enc dec enc0 M last) ticks ((n : ℤ)*tm1Displacement M steps first) := by
  obtain ⟨a,hlo,hhi,ht⟩ := execution_trace enc dec enc0 encdec M steps first last h
  have hb := ht.bool.restrict (physical_supports enc dec M) (physical_label_mem enc enc0 M first)
  obtain ⟨ticks,htlo,hthi,hphys⟩ := tm1_finite_trace
    (restrictedProgram (controlSupport M) (physicalProgram enc dec M)) a _ _ hb.reached
  rw [hb.shift_eq] at hphys
  refine ⟨ticks,hlo.trans htlo,?_,hphys⟩
  calc
    ticks ≤ a*tm1TickBound (restrictedProgram (controlSupport M) (physicalProgram enc dec M)) := hthi
    _ ≤ (steps*tickFactor M)*tm1TickBound (restrictedProgram (controlSupport M)
        (physicalProgram enc dec M)) := Nat.mul_le_mul_right _ hhi
    _ ≤ steps*physicalFactor enc dec M := by
      rw [Nat.mul_assoc]
      exact Nat.mul_le_mul_left steps (Nat.le_succ _)

omit [Inhabited Γ] [Inhabited σ] [Fintype σ] in

theorem physicalFactor_pos : 0<physicalFactor enc dec M := Nat.zero_lt_succ _

theorem physical_halt (c : TM1.Cfg Γ Λ σ) (h : TM1.step M c=none) :
    TM0.step (physicalMachine enc dec M) (physicalCfg enc dec enc0 M c)=none := by
  apply tm1_finite_halt
  rcases c with ⟨l,v,tape⟩
  cases l with
  | none => rfl
  | some l => simp only [TM1.step,reduceCtorEq] at h

end PhysicalCompiler
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.Alphabet

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.Stacks
open Turing Turing.TM2to1
section PhysicalStackCompiler
variable {K : Type} [DecidableEq K] [Fintype K] {Γ : K → Type} [∀ k, Fintype (Γ k)]
    {Λ σ : Type} [Inhabited Λ] [Fintype Λ] [Inhabited σ] [Fintype σ]
    {n : ℕ} (enc : Γ' K Γ → List.Vector Bool n) (dec : List.Vector Bool n → Γ' K Γ)
    (enc0 : enc default=List.Vector.replicate n false)
    (M : Λ → TM2.Stmt Γ Λ σ)

noncomputable def programSupport : Finset (Λ' K Γ Λ σ) := TM2to1.trSupp M Finset.univ
noncomputable def finiteSource := restrictedProgram (programSupport M) (tr M)
noncomputable def stackMachine := Alphabet.physicalMachine enc dec (finiteSource M)
noncomputable def stackCfg (c : TM1.Cfg (Γ' K Γ) (Λ' K Γ Λ σ) σ) :=
  Alphabet.physicalCfg enc dec enc0 (finiteSource M) (restrictedCfg (programSupport M) c)
noncomputable def stackFactor : ℕ := Alphabet.physicalFactor enc dec (finiteSource M)

omit [DecidableEq K] [Fintype K] [∀ k, Fintype (Γ k)] [Inhabited σ] [Fintype σ] in

theorem stack_univ_supports : TM2.Supports M Finset.univ := by
  refine ⟨Finset.mem_univ _,?_⟩
  intro l _
  induction M l with
  | push _ _ _ ih | peek _ _ _ ih | pop _ _ _ ih | load _ _ ih => exact ih
  | branch _ _ _ iha ihb => exact ⟨iha,ihb⟩
  | goto _ => intro v; exact Finset.mem_univ _
  | halt => trivial

omit [Fintype K] [∀ k, Fintype (Γ k)] [Inhabited σ] [Fintype σ] in

theorem programSupport_supports : TM1.Supports (tr M) (programSupport M) :=
  TM2to1.tr_supports M (stack_univ_supports M)

omit [DecidableEq K] [Fintype K] [∀ k, Fintype (Γ k)] [Inhabited Λ] [Inhabited σ] [Fintype σ] in

theorem programSupport_cfg (first : TM2.Cfg Γ Λ σ)
    (first' : TM1.Cfg (Γ' K Γ) (Λ' K Γ Λ σ) σ) (hf : TrCfg first first') :
    first'.l∈Finset.insertNone (programSupport M) := by
  classical
  rcases hf with @⟨l,v,S,L,hL⟩
  cases l with
  | none => exact Finset.mem_insertNone.mpr (by simp)
  | some l =>
    apply Finset.some_mem_insertNone.mpr
    exact Finset.mem_biUnion.mpr ⟨l,Finset.mem_univ _,Finset.mem_insert_self _ _⟩

theorem stack_physical_execution (encdec : ∀ a, dec (enc a)=a) (steps : ℕ)
    (first last : TM2.Cfg Γ Λ σ) (first' : TM1.Cfg (Γ' K Γ) (Λ' K Γ Λ σ) σ)
    (hf : TrCfg first first') (h : stackRun M steps first=some last) :
    ∃ last', TrCfg last last' ∧ ∃ ticks,
      ticks≤stackRunClock M steps first*stackFactor enc dec M ∧
      Trace (stackMachine enc dec M) (stackCfg enc dec enc0 M first')
        (stackCfg enc dec enc0 M last') ticks 0 := by
  obtain ⟨last',hl,ht⟩ := stack_execution_trace M steps first last first' hf h
  have hr := ht.restrict (programSupport_supports M) (programSupport_cfg M first first' hf)
  obtain ⟨ticks,_,hbound,hphys⟩ := Alphabet.physical_execution enc dec enc0 (finiteSource M)
    encdec (stackRunClock M steps first) _ _ hr.reached
  simp only [finiteSource,hr.shift_eq,mul_zero] at hphys
  exact ⟨last',hl,ticks,hbound,hphys⟩

end PhysicalStackCompiler
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.Stacks

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.Prefix
open Turing

def program (inserted : Symbol) (label : Fin 3) : TM1.Stmt Symbol (Fin 3) (Symbol×Symbol) :=
  if label=0 then
    .branch (fun a _ => a.isSome)
      (.load (fun a _ => (a,a)) (.write (fun _ _ => none)
        (.move .right (.goto (fun _ _ => 1)))))
      (.write (fun _ _ => inserted) .halt)
  else if label=1 then
    .load (fun a s => (s.1,a)) (.write (fun _ s => s.1)
      (.load (fun _ s => (s.2,s.2)) (.branch (fun _ s => s.1.isSome)
        (.move .right (.goto (fun _ _ => 1))) (.goto (fun _ _ => 2)))))
  else
    .move .left (.branch (fun a _ => a.isSome) (.goto (fun _ _ => 2))
      (.write (fun _ _ => inserted) .halt))

theorem return_trace (inserted : Symbol) (left right : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (v : Symbol×Symbol)
    (origin : ListBlank Symbol) :
    SourceTrace (program inserted)
      ⟨some 2,v,Tape.mk' (ListBlank.append (left.map some) (ListBlank.cons none origin))
        (ListBlank.mk (right.map some))⟩
      ⟨none,v,Tape.mk' origin (ListBlank.mk (inserted::(left.reverse++right).map some))⟩
      (left.length+1) (-((left.length : ℤ)+1)) := by
  induction left generalizing right with
  | nil =>
    apply SourceTrace.one
    · simp only [TM1.step,program,show (2 : Fin 3)≠0 by decide,
        show (2 : Fin 3)≠1 by decide,if_false,TM1.stepAux,List.map_nil,ListBlank.append,
        Tape.move_left_mk',ListBlank.head_cons,ListBlank.tail_cons,Tape.mk'_head,
        Option.isSome_none,cond_false,Tape.write_mk',ListBlank.tail_cons]
      rfl
    · simp [program,stmtShift,stmtOffset,Tape.move_left_mk']
  | cons b left ih =>
    have hm : (Tape.mk' (ListBlank.append ((b::left).map some) (ListBlank.cons none origin))
        (ListBlank.mk (right.map some))).move .left =
        Tape.mk' (ListBlank.append (left.map some) (ListBlank.cons none origin))
          (ListBlank.mk ((b::right).map some)) := by
      simp [Tape.move_left_mk',ListBlank.append,ListBlank.cons_mk]
    have ht := (ih (b::right)).prepend (l := (2 : Fin 3)) (v := v)
      (tape := Tape.mk' (ListBlank.append ((b::left).map some) (ListBlank.cons none origin))
        (ListBlank.mk (right.map some)))
      (by
        simp only [TM1.step,program,show (2 : Fin 3)≠0 by decide,
          show (2 : Fin 3)≠1 by decide,if_false,TM1.stepAux]
        rw [hm]
        rfl)
      (s := -1) (by
        simp only [program,show (2 : Fin 3)≠0 by decide,show (2 : Fin 3)≠1 by decide,
          if_false,stmtShift,hm]
        rfl)
    convert! ht using 1 <;> simp [List.reverse_cons,List.append_assoc,Int.add_comm,Int.add_left_comm]

theorem scan_trace (inserted : Symbol) (carry : Bool) (rest left : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (old : Symbol)
    (origin : ListBlank Symbol) :
    SourceTrace (program inserted)
      ⟨some 1,(some carry,old),
        Tape.mk' (ListBlank.append (left.map some) (ListBlank.cons none origin))
          (ListBlank.mk (rest.map some))⟩
      ⟨none,(none,none),Tape.mk' origin
        (ListBlank.mk (inserted::(left.reverse++carry::rest).map some))⟩
      (left.length+2*rest.length+2) (-((left.length : ℤ)+1)) := by
  induction rest generalizing left carry old with
  | nil =>
    have ht := (return_trace inserted left [carry] (none,none) origin).prepend
      (l := (1 : Fin 3)) (v := (some carry,old))
      (tape := Tape.mk' (ListBlank.append (left.map some) (ListBlank.cons none origin))
        (ListBlank.mk []))
      (by rfl)
      (s := 0) (by rfl)
    simpa using ht
  | cons b rest ih =>
    have hm : ((Tape.mk'
        (ListBlank.append (left.map some) (ListBlank.cons none origin))
        (ListBlank.mk ((b::rest).map some))).write (some carry)).move .right =
        Tape.mk' (ListBlank.append ((carry::left).map some) (ListBlank.cons none origin))
          (ListBlank.mk (rest.map some)) := by
      simp [Tape.write_mk',Tape.move_right_mk',ListBlank.append,ListBlank.cons_mk]
    have ht := (ih b (carry::left) (some b)).prepend
      (l := (1 : Fin 3)) (v := (some carry,old))
      (tape := Tape.mk' (ListBlank.append (left.map some) (ListBlank.cons none origin))
        (ListBlank.mk ((b::rest).map some)))
      (by
        change some (TM1.stepAux (program inserted 1) (some carry,old) (Tape.mk' _ _))=_
        change some (TM1.Cfg.mk (some 1) (some b,some b)
          (((Tape.mk' (ListBlank.append (left.map some) (ListBlank.cons none origin))
            (ListBlank.mk ((b::rest).map some))).write (some carry)).move .right))=_
        rw [hm])
      (s := 1) (by simp [program,stmtShift,stmtOffset])
    convert! ht using 1 <;> simp [List.reverse_cons,List.append_assoc]
    omega

theorem source_trace (inserted : Symbol) (input : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (origin : ListBlank Symbol)
    (v : Symbol×Symbol) :
    ∃ last, last.l=none ∧ last.Tape=Tape.mk' origin (ListBlank.mk (inserted::input.map some)) ∧
      SourceTrace (program inserted) ⟨some 0,v,Tape.mk' origin (ListBlank.mk (input.map some))⟩
        last (2*input.length+1) 0 := by
  cases input with
  | nil =>
    refine ⟨⟨none,v,Tape.mk' origin (ListBlank.mk [inserted])⟩,rfl,rfl,?_⟩
    apply SourceTrace.one <;> rfl
  | cons b rest =>
    have hm : ((Tape.mk' origin (ListBlank.mk ((b::rest).map some))).write none).move .right =
        Tape.mk' (ListBlank.cons none origin) (ListBlank.mk (rest.map some)) := by
      simp [Tape.write_mk',Tape.move_right_mk',ListBlank.cons_mk]
    have ht := (scan_trace inserted b rest [] (some b) origin).prepend
      (l := (0 : Fin 3)) (v := v) (tape := Tape.mk' origin (ListBlank.mk ((b::rest).map some)))
      (by
        change some (TM1.stepAux (program inserted 0) v (Tape.mk' _ _))=_
        change some (TM1.Cfg.mk (some 1) (some b,some b)
          (((Tape.mk' origin (ListBlank.mk ((b::rest).map some))).write none).move .right))=_
        rw [hm]
        rfl)
      (s := 1) (by simp [program,stmtShift,stmtOffset])
    refine ⟨⟨none,(none,none),Tape.mk' origin (ListBlank.mk (inserted::(b::rest).map some))⟩,rfl,rfl,?_⟩
    convert! ht using 1
    simp
    omega

theorem tick_bound (inserted : Symbol) : tm1TickBound (program inserted)≤3 := by
  apply Finset.sup_le
  intro l _
  by_cases h0 : l=0
  · simp [program,h0,stmtTicks]
  · by_cases h1 : l=1 <;> simp [program,h0,h1,stmtTicks]

theorem runs (inserted : Bool) (input : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) :
    Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Runs (tm1Machine (program (some inserted))) input (inserted::input)
      (6*input.length+3) (6*input.length+3) := by
  obtain ⟨last,hl,ht,hs⟩ := source_trace (some inserted) input (ListBlank.mk []) default
  apply tm1_finite_runs (program (some inserted)) input (inserted::input) (2*input.length+1)
    (6*input.length+3) last
  · exact hs.reached
  · cases last with
    | mk l v tape => cases hl; rfl
  · exact hs.shift_eq
  · omega
  · have h := Nat.mul_le_mul_left (2*input.length+1) (tick_bound (some inserted))
    omega
  · intro i
    rw [ht,Tape.mk'_right₀]
    rfl
  · intro i
    rw [ht,Tape.mk'_left]
    rfl

end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.Prefix

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.Call
open Turing
variable {Γ Λ Λ' σ τ : Type} [Inhabited Γ]

def stmt (code : Λ → Λ') (returnTo : Λ') : TM1.Stmt Γ Λ σ → TM1.Stmt Γ Λ' (σ×τ)
  | .move d q => .move d (stmt code returnTo q)
  | .write f q => .write (fun a v => f a v.1) (stmt code returnTo q)
  | .load f q => .load (fun a v => (f a v.1,v.2)) (stmt code returnTo q)
  | .branch f a b => .branch (fun a v => f a v.1) (stmt code returnTo a) (stmt code returnTo b)
  | .goto f => .goto (fun a v => code (f a v.1))
  | .halt => .goto (fun _ _ => returnTo)

def cfg (code : Λ → Λ') (returnTo : Λ') (saved : τ) (c : TM1.Cfg Γ Λ σ) : TM1.Cfg Γ Λ' (σ×τ) :=
  ⟨some (c.l.elim returnTo code),(c.var,saved),c.Tape⟩

theorem stmt_step (code : Λ → Λ') (returnTo : Λ') (saved : τ) (s : TM1.Stmt Γ Λ σ)
    (v : σ) (tape : Tape Γ) :
    TM1.stepAux (stmt code returnTo s) (v,saved) tape=cfg code returnTo saved (TM1.stepAux s v tape) := by
  induction s generalizing v tape with
  | move _ _ ih | write _ _ ih | load _ _ ih => exact ih _ _
  | branch f a b iha ihb =>
    simp only [stmt,TM1.stepAux]
    cases f tape.head v <;> simp only [cond_false,cond_true]
    · exact ihb _ _
    · exact iha _ _
  | goto _ | halt => rfl

theorem stmt_shift (code : Λ → Λ') (returnTo : Λ') (saved : τ) (s : TM1.Stmt Γ Λ σ)
    (v : σ) (tape : Tape Γ) : stmtShift (stmt code returnTo s) (v,saved) tape=stmtShift s v tape := by
  induction s generalizing v tape with
  | move _ _ ih => simpa only [stmt,stmtShift] using congrArg (fun z => _+z) (ih v _)
  | write _ _ ih | load _ _ ih => exact ih _ _
  | branch _ _ _ iha ihb =>
    simp only [stmt,stmtShift]
    split
    · exact iha _ _
    · exact ihb _ _
  | goto _ | halt => rfl

theorem execution (M : Λ → TM1.Stmt Γ Λ σ) (N : Λ' → TM1.Stmt Γ Λ' (σ×τ))
    (code : Λ → Λ') (returnTo : Λ') (saved : τ)
    (hcode : ∀ l, N (code l)=stmt code returnTo (M l))
    (steps : ℕ) (first last : TM1.Cfg Γ Λ σ) (h : tm1Run M steps first=some last) :
    tm1Run N steps (cfg code returnTo saved first)=some (cfg code returnTo saved last) ∧
      tm1Displacement N steps (cfg code returnTo saved first)=tm1Displacement M steps first := by
  induction steps generalizing first with
  | zero =>
    have he : first=last := Option.some.inj h
    subst last
    exact ⟨rfl,rfl⟩
  | succ steps ih =>
    cases hs : TM1.step M first with
    | none => simp only [tm1Run,hs,Option.bind_none,reduceCtorEq] at h
    | some next =>
      have hn : tm1Run M steps next=some last := by simpa only [tm1Run,hs,Option.bind_some] using h
      obtain ⟨hr,hd⟩ := ih next hn
      rcases first with ⟨l,v,tape⟩
      cases l with
      | none => simp only [TM1.step,reduceCtorEq] at hs
      | some l =>
        have he : TM1.stepAux (M l) v tape=next := Option.some.inj hs
        have hstep : TM1.step N (cfg code returnTo saved ⟨some l,v,tape⟩)=
            some (cfg code returnTo saved next) := by
          change some (TM1.stepAux (N (code l)) (v,saved) tape)=_
          rw [hcode,stmt_step,he]
        constructor
        · simpa only [tm1Run,hstep,Option.bind_some] using hr
        · change tm1Displacement N (steps+1) ⟨some (code l),(v,saved),tape⟩=_
          simp only [tm1Displacement,show TM1.step N ⟨some (code l),(v,saved),tape⟩=
            some (cfg code returnTo saved next) from hstep,hs,hcode,stmt_shift,hd]

theorem trace (M : Λ → TM1.Stmt Γ Λ σ) (N : Λ' → TM1.Stmt Γ Λ' (σ×τ))
    (code : Λ → Λ') (returnTo : Λ') (saved : τ)
    (hcode : ∀ l, N (code l)=stmt code returnTo (M l))
    {steps : ℕ} {d : ℤ} {first last : TM1.Cfg Γ Λ σ} (h : SourceTrace M first last steps d) :
    SourceTrace N (cfg code returnTo saved first) (cfg code returnTo saved last) steps d := by
  obtain ⟨hr,hd⟩ := execution M N code returnTo saved hcode steps first last h.reached
  exact ⟨hr,hd.trans h.shift_eq⟩
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.Call

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.Alphabet
open Turing

theorem exists_marked_codec (Γ : Type) [Inhabited Γ] [Finite Γ] :
    ∃ (extra : ℕ) (enc : Γ → List.Vector Bool (extra+1))
      (dec : List.Vector Bool (extra+1) → Γ),
      enc default=List.Vector.replicate (extra+1) false ∧
      (∀ a, dec (enc a)=a) ∧ (∀ a, a≠default → (enc a).head=true) := by
  classical
  obtain ⟨n,oldEnc,oldDec,_,hd⟩ := TM1to1.exists_enc_dec (Γ := Γ)
  let enc (a : Γ) : List.Vector Bool (n+1) :=
    if a=default then List.Vector.replicate (n+1) false else true ::ᵥ oldEnc a
  let dec (bits : List.Vector Bool (n+1)) : Γ := if bits.head then oldDec bits.tail else default
  refine ⟨n,enc,dec,?_,?_,?_⟩
  · simp [enc]
  · intro a
    by_cases h : a=default
    · subst a
      simp [enc,dec,List.Vector.replicate,List.Vector.head,List.replicate_succ]
    · simp [enc,dec,h,List.Vector.head_cons,List.Vector.tail_cons,hd]
  · intro a h
    simp [enc,h,List.Vector.head_cons]
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.Alphabet

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.Expansion
open Turing

inductive Label (extra : ℕ) where
  | boot | scan | sub (index : Fin extra) (label : Fin 3) | advance (index : Fin extra)
  | output | back
  deriving DecidableEq, Fintype
instance {extra : ℕ} : Inhabited (Label extra) := ⟨.boot⟩
abbrev Local := (Symbol×Symbol)×(Bool×Bool)

def moves {Λ σ : Type} (n : ℕ) (d : Dir) (q : TM1.Stmt Symbol Λ σ) : TM1.Stmt Symbol Λ σ :=
  (TM1.Stmt.move d)^[n] q

def writeSymbols {Λ σ : Type} : List Symbol → TM1.Stmt Symbol Λ σ → TM1.Stmt Symbol Λ σ
  | [],q => q
  | a::bits,q => .write (fun _ _ => a) (.move .right (writeSymbols bits q))

def readAux {Λ σ : Type} : (n : ℕ) →
    (List.Vector Symbol n → TM1.Stmt Symbol Λ σ) → TM1.Stmt Symbol Λ σ
  | 0,f => f List.Vector.nil
  | n+1,f => .branch (fun a _ => a.isNone)
      (.move .right (readAux n (fun bits => f (none ::ᵥ bits))))
      (.branch (fun a _ => a.getD false)
        (.move .right (readAux n (fun bits => f (some true ::ᵥ bits))))
        (.move .right (readAux n (fun bits => f (some false ::ᵥ bits)))))

def readCode {Λ σ : Type} (n : ℕ)
    (f : List.Vector Symbol n → TM1.Stmt Symbol Λ σ) : TM1.Stmt Symbol Λ σ :=
  readAux n (fun bits => moves n .left (f bits))

variable {extra : ℕ}
    (first0 first1 later0 later1 empty : List.Vector Symbol (extra+1))
    (bottom : List.Vector Symbol (extra+1) → Bool)

def program : Label extra → TM1.Stmt Symbol (Label extra) Local
  | .boot => .load (fun _ _ => (default,(false,true))) (.goto (fun _ _ => .scan))
  | .scan => .branch (fun a _ => a.isSome)
      (.load (fun a s => (s.1,(a.getD false,s.2.2)))
        (.write (fun _ _ => none) (.move .right
          (.goto (fun _ _ => if h : 0<extra then .sub ⟨0,h⟩ 0 else .output)))))
      (.branch (fun _ s => s.2.2)
        (writeSymbols empty.toList (moves (extra+1) .left .halt))
        (.goto (fun _ _ => .back)))
  | .sub i l => Call.stmt (Label.sub i) (.advance i) (Prefix.program none l)
  | .advance i => .move .right (.goto (fun _ _ =>
      if h : i.val+1<extra then .sub ⟨i.val+1,h⟩ 0 else .output))
  | .output => moves (extra+1) .left
      (.branch (fun _ s => s.2.2)
        (.branch (fun _ s => s.2.1)
          (writeSymbols first1.toList (.load (fun _ s => (s.1,(s.2.1,false))) (.goto (fun _ _ => .scan))))
          (writeSymbols first0.toList (.load (fun _ s => (s.1,(s.2.1,false))) (.goto (fun _ _ => .scan)))))
        (.branch (fun _ s => s.2.1)
          (writeSymbols later1.toList (.load (fun _ s => (s.1,(s.2.1,false))) (.goto (fun _ _ => .scan))))
          (writeSymbols later0.toList (.load (fun _ s => (s.1,(s.2.1,false))) (.goto (fun _ _ => .scan))))))
  | .back => moves (extra+1) .left (readCode (extra+1)
      (fun bits => if bottom bits then .halt else .goto (fun _ _ => .back)))

theorem gap_call (i : Fin extra) (input : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (origin : ListBlank Symbol)
    (v : Symbol×Symbol) (saved : Bool×Bool) :
    ∃ last : TM1.Cfg Symbol (Label extra) Local,
      last.l=some (.advance i) ∧ last.var.2=saved ∧
      last.Tape=Tape.mk' origin (ListBlank.mk (none::input.map some)) ∧
      SourceTrace (program first0 first1 later0 later1 empty bottom)
        ⟨some (.sub i 0),(v,saved),Tape.mk' origin (ListBlank.mk (input.map some))⟩
        last (2*input.length+1) 0 := by
  obtain ⟨last,hl,ht,hs⟩ := Prefix.source_trace none input origin v
  have hc : ∀ l : Fin 3, program first0 first1 later0 later1 empty bottom (.sub i l)=
      Call.stmt (Label.sub i) (.advance i) (Prefix.program none l) := fun _ => rfl
  refine ⟨Call.cfg (Label.sub i) (.advance i) saved last,?_,rfl,ht,?_⟩
  · simp [Call.cfg,hl]
  · exact Call.trace _ _ _ _ saved hc hs

def gapEntry (i : ℕ) : Label extra :=
  if h : i<extra then .sub ⟨i,h⟩ 0 else .output

theorem gap_chain (count i : ℕ) (hi : i+count=extra) (input : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits)
    (origin : ListBlank Symbol) (v : Symbol×Symbol) (saved : Bool×Bool) :
    ∃ last : TM1.Cfg Symbol (Label extra) Local,
      last.l=some .output ∧ last.var.2=saved ∧
      last.Tape=Tape.mk' ((ListBlank.cons none)^[count] origin) (ListBlank.mk (input.map some)) ∧
      SourceTrace (program first0 first1 later0 later1 empty bottom)
        ⟨some (gapEntry i),(v,saved),Tape.mk' origin (ListBlank.mk (input.map some))⟩
        last (count*(2*input.length+2)) count := by
  induction count generalizing i origin v with
  | zero =>
    have he : i=extra := by omega
    refine ⟨⟨some .output,(v,saved),Tape.mk' origin (ListBlank.mk (input.map some))⟩,
      rfl,rfl,rfl,?_⟩
    simpa [gapEntry,he] using SourceTrace.refl
      (program first0 first1 later0 later1 empty bottom)
      (TM1.Cfg.mk (some Label.output) (v,saved) (Tape.mk' origin (ListBlank.mk (input.map some))))
  | succ count ih =>
    have hlt : i<extra := by omega
    let index : Fin extra := ⟨i,hlt⟩
    obtain ⟨mid,hm,hv,ht,hs⟩ :=
        gap_call first0 first1 later0 later1 empty bottom index input origin v saved
    rcases mid with ⟨l,⟨w,s⟩,tape⟩
    change l=some (.advance index) at hm
    subst l
    change s=saved at hv
    subst s
    change tape=Tape.mk' origin (ListBlank.mk (none::input.map some)) at ht
    subst tape
    have ha : SourceTrace (program first0 first1 later0 later1 empty bottom)
        ⟨some (.advance index),(w,saved),Tape.mk' origin (ListBlank.mk (none::input.map some))⟩
        ⟨some (gapEntry (i+1)),(w,saved),Tape.mk' (ListBlank.cons none origin) (ListBlank.mk (input.map some))⟩
        1 1 := by
      apply SourceTrace.one
      · simp only [TM1.step,program,TM1.stepAux]
        change some (TM1.Cfg.mk (some (gapEntry (i+1))) (w,saved)
          ((Tape.mk' origin (ListBlank.mk (none::input.map some))).move .right))=_
        simp [Tape.move_right_mk']
      · rfl
    obtain ⟨last,hl,hlv,hltape,hltrace⟩ := ih (i+1) (by omega) (ListBlank.cons none origin) w
    refine ⟨last,hl,hlv,?_,?_⟩
    · simpa only [Function.iterate_succ_apply] using hltape
    · have hall := (hs.trans ha).trans hltrace
      rw [gapEntry,dif_pos hlt]
      convert! hall using 1 <;> simp only [Nat.succ_mul,Int.natCast_add,Int.natCast_one]
      · omega
      · omega

theorem moves_step {Λ σ : Type} (n : ℕ) (d : Dir) (q : TM1.Stmt Symbol Λ σ)
    (v : σ) (tape : Tape Symbol) :
    TM1.stepAux (moves n d q) v tape=TM1.stepAux q v ((Tape.move d)^[n] tape) := by
  unfold moves
  induction n generalizing tape with
  | zero => rfl
  | succ n ih =>
    rw [Function.iterate_succ_apply',TM1.stepAux,ih,Function.iterate_succ_apply]

theorem moves_shift {Λ σ : Type} (n : ℕ) (d : Dir) (q : TM1.Stmt Symbol Λ σ)
    (v : σ) (tape : Tape Symbol) :
    stmtShift (moves n d q) v tape=
      (n : ℤ)*stmtOffset (.move d)+stmtShift q v ((Tape.move d)^[n] tape) := by
  unfold moves
  induction n generalizing tape with
  | zero => simp
  | succ n ih =>
    rw [Function.iterate_succ_apply',stmtShift,ih,Function.iterate_succ_apply]
    cases d <;> simp only [stmtOffset,Int.natCast_add,Int.natCast_one,mul_neg,mul_one] <;> omega

theorem right_move (bits : List Symbol) (origin right : ListBlank Symbol) :
    (Tape.move .right)^[bits.length] (Tape.mk' origin (ListBlank.append bits right))=
      Tape.mk' (ListBlank.append bits.reverse origin) right := by
  induction bits generalizing origin with
  | nil => rfl
  | cons a bits ih =>
    rw [List.length_cons,Function.iterate_succ_apply]
    simp only [ListBlank.append,Tape.move_right_mk',ListBlank.head_cons,ListBlank.tail_cons]
    rw [ih]
    simp [List.reverse_cons,ListBlank.append_assoc]

theorem cons_replicate (n : ℕ) (origin : ListBlank Symbol) :
    (ListBlank.cons none)^[n] origin=ListBlank.append (List.replicate n none) origin := by
  induction n with
  | zero => rfl
  | succ n ih => simp only [Function.iterate_succ_apply',ih,List.replicate_succ,ListBlank.append]

theorem left_gap (n : ℕ) (origin right : ListBlank Symbol) :
    (Tape.move .left)^[n] (Tape.mk' ((ListBlank.cons none)^[n] origin) right)=
      Tape.mk' origin (ListBlank.append (List.replicate n none) right) := by
  have hr := right_move (List.replicate n none) origin right
  simp only [List.length_replicate,List.reverse_replicate] at hr
  rw [cons_replicate,← hr,left_right_iterate]

theorem write_semantics {Λ σ : Type} (bits old : List Symbol) (hlen : old.length=bits.length)
    (q : TM1.Stmt Symbol Λ σ) (v : σ) (origin right : ListBlank Symbol) :
    TM1.stepAux (writeSymbols bits q) v (Tape.mk' origin (ListBlank.append old right))=
        TM1.stepAux q v (Tape.mk' (ListBlank.append bits.reverse origin) right) ∧
      stmtShift (writeSymbols bits q) v (Tape.mk' origin (ListBlank.append old right))=
        (bits.length : ℤ)+stmtShift q v (Tape.mk' (ListBlank.append bits.reverse origin) right) := by
  induction bits generalizing origin old with
  | nil =>
    have he : old=[] := List.length_eq_zero_iff.mp hlen
    subst old
    exact ⟨rfl,by simp [writeSymbols]⟩
  | cons a bits ih =>
    cases old with
    | nil => simp only [List.length_nil,List.length_cons] at hlen; omega
    | cons b old =>
      have hm : ((Tape.mk' origin (ListBlank.append (b::old) right)).write a).move .right=
          Tape.mk' (ListBlank.cons a origin) (ListBlank.append old right) := by
        simp [ListBlank.append,Tape.write_mk',Tape.move_right_mk']
      obtain ⟨hs,hd⟩ := ih old (Nat.succ.inj hlen) (ListBlank.cons a origin)
      constructor
      · simp only [writeSymbols,TM1.stepAux]
        rw [hm,hs]
        simp [List.reverse_cons,ListBlank.append_assoc]
      · simp only [writeSymbols,stmtShift,stmtOffset]
        rw [hm,hd]
        simp only [List.length_cons,Int.natCast_add,Int.natCast_one,List.reverse_cons,
          ListBlank.append_assoc,ListBlank.append]
        omega

theorem overwrite_gap {Λ σ : Type} {n : ℕ} (bits : List.Vector Symbol n)
    (q : TM1.Stmt Symbol Λ σ) (v : σ) (origin right : ListBlank Symbol) :
    TM1.stepAux (moves n .left (writeSymbols bits.toList q)) v
        (Tape.mk' ((ListBlank.cons none)^[n] origin) right)=
      TM1.stepAux q v (Tape.mk' (ListBlank.append bits.toList.reverse origin) right) ∧
      stmtShift (moves n .left (writeSymbols bits.toList q)) v
        (Tape.mk' ((ListBlank.cons none)^[n] origin) right)=
      stmtShift q v (Tape.mk' (ListBlank.append bits.toList.reverse origin) right) := by
  have hlen : (List.replicate n (none : Symbol)).length=bits.toList.length := by simp
  obtain ⟨hs,hd⟩ := write_semantics bits.toList (List.replicate n none) hlen q v origin right
  constructor
  · rw [moves_step,left_gap,hs]
  · rw [moves_shift,left_gap,hd]
    simp only [stmtOffset,mul_neg,mul_one,List.Vector.toList_length]
    omega

def outputCode (saved : Bool×Bool) : List.Vector Symbol (extra+1) :=
  if saved.2 then (if saved.1 then first1 else first0) else (if saved.1 then later1 else later0)

private def resume : TM1.Stmt Symbol (Label extra) Local :=
  .load (fun _ s => (s.1,(s.2.1,false))) (.goto (fun _ _ => .scan))

theorem output_eval (origin : Tape Symbol) (v : Symbol×Symbol) (saved : Bool×Bool) :
    TM1.stepAux (program first0 first1 later0 later1 empty bottom .output) (v,saved) origin=
      TM1.stepAux (moves (extra+1) .left
        (writeSymbols (outputCode first0 first1 later0 later1 saved).toList (resume (extra:=extra)))) (v,saved) origin := by
  rcases saved with ⟨bit,phase⟩
  cases bit <;> cases phase <;> simp only [program,moves_step,TM1.stepAux,outputCode,
    Bool.false_eq_true,if_false,if_true,cond_false,cond_true,resume]

theorem output_shift (origin : Tape Symbol) (v : Symbol×Symbol) (saved : Bool×Bool) :
    stmtShift (program first0 first1 later0 later1 empty bottom .output) (v,saved) origin=
      stmtShift (moves (extra+1) .left
        (writeSymbols (outputCode first0 first1 later0 later1 saved).toList (resume (extra:=extra)))) (v,saved) origin := by
  rcases saved with ⟨bit,phase⟩
  cases bit <;> cases phase <;> simp only [program,moves_shift,stmtShift,outputCode,
    Bool.false_eq_true,if_false,if_true,resume]

theorem output_trace (origin right : ListBlank Symbol) (v : Symbol×Symbol) (saved : Bool×Bool) :
    SourceTrace (program first0 first1 later0 later1 empty bottom)
      ⟨some .output,(v,saved),Tape.mk' ((ListBlank.cons none)^[extra+1] origin) right⟩
      ⟨some .scan,(v,(saved.1,false)),
        Tape.mk' (ListBlank.append (outputCode first0 first1 later0 later1 saved).toList.reverse origin) right⟩
      1 0 := by
  obtain ⟨hs,hd⟩ :=
      overwrite_gap (outputCode first0 first1 later0 later1 saved) (resume (extra:=extra))
      (v,saved) origin right
  apply SourceTrace.one
  · change some (TM1.stepAux _ _ _)=_
    rw [output_eval,hs]
    rfl
  · rw [output_shift,hd]
    rfl

theorem one_cell (bit oldBit phase : Bool) (rest : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (origin : ListBlank Symbol)
    (v : Symbol×Symbol) :
    ∃ next : Symbol×Symbol,
      SourceTrace (program first0 first1 later0 later1 empty bottom)
        ⟨some .scan,(v,(oldBit,phase)),Tape.mk' origin (ListBlank.mk ((bit::rest).map some))⟩
        ⟨some .scan,(next,(bit,false)),
          Tape.mk' (ListBlank.append (outputCode first0 first1 later0 later1 (bit,phase)).toList.reverse origin)
            (ListBlank.mk (rest.map some))⟩
        (2+extra*(2*rest.length+2)) (extra+1 : ℕ) := by
  have hscan : SourceTrace (program first0 first1 later0 later1 empty bottom)
      ⟨some .scan,(v,(oldBit,phase)),Tape.mk' origin (ListBlank.mk ((bit::rest).map some))⟩
      ⟨some (gapEntry 0),(v,(bit,phase)),Tape.mk' (ListBlank.cons none origin) (ListBlank.mk (rest.map some))⟩
      1 1 := by
    apply SourceTrace.one
    · change some (TM1.stepAux (program first0 first1 later0 later1 empty bottom .scan)
        (v,(oldBit,phase)) (Tape.mk' origin (ListBlank.mk ((bit::rest).map some))))=_
      change some (TM1.Cfg.mk (some (gapEntry 0)) (v,(bit,phase))
        (((Tape.mk' origin (ListBlank.mk ((bit::rest).map some))).write none).move .right))=_
      simp [Tape.write_mk',Tape.move_right_mk',ListBlank.cons_mk]
    · simp [program,stmtShift,stmtOffset]
  obtain ⟨mid,hl,hv,ht,hs⟩ := gap_chain first0 first1 later0 later1 empty bottom extra 0 (by omega)
    rest (ListBlank.cons none origin) v (bit,phase)
  rcases mid with ⟨l,⟨w,s⟩,tape⟩
  change l=some .output at hl
  subst l
  change s=(bit,phase) at hv
  subst s
  change tape=Tape.mk' ((ListBlank.cons none)^[extra] (ListBlank.cons none origin))
      (ListBlank.mk (rest.map some)) at ht
  subst tape
  have hout :=
      output_trace first0 first1 later0 later1 empty bottom origin (ListBlank.mk (rest.map some)) w
      (bit,phase)
  rw [Function.iterate_succ_apply] at hout
  refine ⟨w,?_⟩
  have hall := (hscan.trans hs).trans hout
  convert! hall using 1 <;> omega

def cells (phase : Bool) : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits → List Symbol
  | [] => []
  | bit::rest => (outputCode first0 first1 later0 later1 (bit,phase)).toList++
      cells false rest

theorem forward_trace (input : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (origin : ListBlank Symbol)
    (v : Symbol×Symbol) (oldBit phase : Bool) :
    ∃ next : Symbol×Symbol, ∃ lastBit : Bool,
      SourceTrace (program first0 first1 later0 later1 empty bottom)
        ⟨some .scan,(v,(oldBit,phase)),Tape.mk' origin (ListBlank.mk (input.map some))⟩
        ⟨some .scan,(next,(lastBit,if input=[] then phase else false)),
          Tape.mk' (ListBlank.append (cells first0 first1 later0 later1 phase input).reverse origin) (ListBlank.mk [])⟩
        (2*input.length+extra*input.length*(input.length+1)) ((extra+1)*input.length : ℕ) := by
  induction input generalizing origin v oldBit phase with
  | nil =>
    refine ⟨v,oldBit,?_⟩
    simpa only [cells,List.map_nil,List.reverse_nil,ListBlank.append,List.length_nil,
      mul_zero,zero_add,if_pos rfl] using! SourceTrace.refl
      (program first0 first1 later0 later1 empty bottom)
      (TM1.Cfg.mk (some Label.scan) (v,(oldBit,phase)) (Tape.mk' origin (ListBlank.mk [])))
  | cons bit rest ih =>
    obtain ⟨w,hs⟩ :=
        one_cell first0 first1 later0 later1 empty bottom bit oldBit phase rest origin v
    obtain ⟨z,lastBit,ht⟩ := ih
      (ListBlank.append (outputCode first0 first1 later0 later1 (bit,phase)).toList.reverse origin) w bit false
    refine ⟨z,lastBit,?_⟩
    have hall := hs.trans ht
    simp only [ite_self] at hall
    convert! hall using 1 <;> simp only [cells,List.reverse_append,ListBlank.append_assoc,
      List.cons_ne_nil,if_false,List.length_cons]
    · ring
    · push_cast
      ring

theorem readAux_head_step {Λ σ : Type} (n : ℕ)
    (f : List.Vector Symbol (n+1) → TM1.Stmt Symbol Λ σ) (v : σ) (tape : Tape Symbol) :
    TM1.stepAux (readAux (n+1) f) v tape=
      TM1.stepAux (readAux n (fun bits => f (tape.head ::ᵥ bits))) v (tape.move .right) := by
  cases hh : tape.head with
  | none => simp only [readAux,TM1.stepAux,hh,Option.isNone_none,cond_true]
  | some bit => cases bit <;> simp only [readAux,TM1.stepAux,hh,Option.isNone_some,
      cond_false,cond_true,Option.getD_some]

theorem readAux_head_shift {Λ σ : Type} (n : ℕ)
    (f : List.Vector Symbol (n+1) → TM1.Stmt Symbol Λ σ) (v : σ) (tape : Tape Symbol) :
    stmtShift (readAux (n+1) f) v tape=
      1+stmtShift (readAux n (fun bits => f (tape.head ::ᵥ bits))) v (tape.move .right) := by
  cases hh : tape.head with
  | none => simp only [readAux,stmtShift,hh,Option.isNone_none,if_true,stmtOffset]
  | some bit => cases bit <;> simp only [readAux,stmtShift,hh,Option.isNone_some,
      Bool.false_eq_true,if_false,if_true,Option.getD_some,stmtOffset]

theorem readAux_semantics {Λ σ : Type} (bits : List Symbol)
    (f : List.Vector Symbol bits.length → TM1.Stmt Symbol Λ σ) (v : σ) (origin right : ListBlank Symbol) :
    TM1.stepAux (readAux bits.length f) v (Tape.mk' origin (ListBlank.append bits right))=
        TM1.stepAux (f ⟨bits,rfl⟩) v (Tape.mk' (ListBlank.append bits.reverse origin) right) ∧
      stmtShift (readAux bits.length f) v (Tape.mk' origin (ListBlank.append bits right))=
        (bits.length : ℤ)+stmtShift (f ⟨bits,rfl⟩) v (Tape.mk' (ListBlank.append bits.reverse origin) right) := by
  induction bits generalizing origin with
  | nil => exact ⟨rfl,(Int.zero_add _).symm⟩
  | cons a bits ih =>
    have hm : (Tape.mk' origin (ListBlank.append (a::bits) right)).move .right=
        Tape.mk' (ListBlank.cons a origin) (ListBlank.append bits right) := by
      simp [Tape.move_right_mk',ListBlank.append]
    have hh : (Tape.mk' origin (ListBlank.append (a::bits) right)).head=a := by
      simp [Tape.mk'_head,ListBlank.append]
    obtain ⟨hs,hd⟩ := ih (fun rest => f (a ::ᵥ rest)) (ListBlank.cons a origin)
    have he : (a ::ᵥ (⟨bits,rfl⟩ : List.Vector Symbol bits.length))=⟨a::bits,rfl⟩ :=
      Subtype.ext (List.Vector.cons_val a _)
    rw [he] at hs hd
    constructor
    · change TM1.stepAux (readAux (bits.length+1) f) v (Tape.mk' origin (ListBlank.append (a::bits) right))=_
      rw [readAux_head_step,hh,hm,hs]
      simp [List.reverse_cons,ListBlank.append_assoc]
    · change stmtShift (readAux (bits.length+1) f) v (Tape.mk' origin (ListBlank.append (a::bits) right))=_
      rw [readAux_head_shift,hh,hm,hd]
      simp only [List.length_cons,Int.natCast_add,Int.natCast_one,List.reverse_cons,
        ListBlank.append_assoc,ListBlank.append]
      omega

theorem left_block (bits : List Symbol) (origin right : ListBlank Symbol) :
    (Tape.move .left)^[bits.length] (Tape.mk' (ListBlank.append bits.reverse origin) right)=
      Tape.mk' origin (ListBlank.append bits right) := by
  rw [← right_move bits origin right,left_right_iterate]

theorem readCode_semantics {Λ σ : Type} {n : ℕ} (bits : List.Vector Symbol n)
    (f : List.Vector Symbol n → TM1.Stmt Symbol Λ σ) (v : σ) (origin right : ListBlank Symbol) :
    TM1.stepAux (readCode n f) v (Tape.mk' origin (ListBlank.append bits.toList right))=
        TM1.stepAux (f bits) v (Tape.mk' origin (ListBlank.append bits.toList right)) ∧
      stmtShift (readCode n f) v (Tape.mk' origin (ListBlank.append bits.toList right))=
        stmtShift (f bits) v (Tape.mk' origin (ListBlank.append bits.toList right)) := by
  rcases bits with ⟨bits,rfl⟩
  obtain ⟨hs,hd⟩ := readAux_semantics bits (fun b => moves bits.length .left (f b)) v origin right
  constructor
  · simpa only [readCode,moves_step,left_block] using! hs
  · simp only [moves_shift,stmtOffset,mul_neg,mul_one,left_block] at hd
    change stmtShift (readCode bits.length f) v (Tape.mk' origin (ListBlank.append bits right))=
      stmtShift (f ⟨bits,rfl⟩) v (Tape.mk' origin (ListBlank.append bits right))
    rw [show stmtShift (readCode bits.length f) v (Tape.mk' origin (ListBlank.append bits right))=
      stmtShift (readAux bits.length (fun b => moves bits.length .left (f b))) v
        (Tape.mk' origin (ListBlank.append bits right)) from rfl,hd]
    omega

theorem left_vector {n : ℕ} (bits : List.Vector Symbol n) (origin right : ListBlank Symbol) :
    (Tape.move .left)^[n] (Tape.mk' (ListBlank.append bits.toList.reverse origin) right)=
      Tape.mk' origin (ListBlank.append bits.toList right) := by
  have h := left_block bits.toList origin right
  rw [bits.toList_length] at h
  exact h

theorem back_one (bits : List.Vector Symbol (extra+1)) (origin right : ListBlank Symbol) (v : Local) :
    SourceTrace (program first0 first1 later0 later1 empty bottom)
      ⟨some .back,v,Tape.mk' (ListBlank.append bits.toList.reverse origin) right⟩
      ⟨if bottom bits then none else some .back,v,Tape.mk' origin (ListBlank.append bits.toList right)⟩
      1 (-((extra+1 : ℕ) : ℤ)) := by
  let stop : List.Vector Symbol (extra+1) → TM1.Stmt Symbol (Label extra) Local :=
    fun b => if bottom b then .halt else .goto (fun _ _ => .back)
  obtain ⟨hs,hd⟩ := readCode_semantics bits stop v origin right
  apply SourceTrace.one
  · change some (TM1.stepAux (moves (extra+1) .left (readCode (extra+1) stop)) v _)=_
    rw [moves_step,left_vector,hs]
    cases hb : bottom bits <;> simp [stop,TM1.stepAux,hb]
  · change stmtShift (moves (extra+1) .left (readCode (extra+1) stop)) v _=_
    rw [moves_shift,left_vector,hd]
    cases hb : bottom bits <;> simp [stop,stmtShift,stmtOffset,hb]

theorem back_many (first : List.Vector Symbol (extra+1)) (rest : List (List.Vector Symbol (extra+1)))
    (hfirst : bottom first=true) (hrest : ∀ b∈rest, bottom b=false)
    (origin right : ListBlank Symbol) (v : Local) :
    SourceTrace (program first0 first1 later0 later1 empty bottom)
      ⟨some .back,v,Tape.mk'
        (ListBlank.append (rest.flatMap (fun b => b.toList.reverse)++first.toList.reverse) origin) right⟩
      ⟨none,v,Tape.mk' origin
        (ListBlank.append (first.toList++rest.reverse.flatMap (fun b => b.toList)) right)⟩
      (rest.length+1) (-(((extra+1)*(rest.length+1) : ℕ) : ℤ)) := by
  induction rest generalizing right with
  | nil => simpa [hfirst] using back_one first0 first1 later0 later1 empty bottom first origin right v
  | cons b rest ih =>
    have hb : bottom b=false := hrest b (by simp)
    have ht := back_one first0 first1 later0 later1 empty bottom b
      (ListBlank.append (rest.flatMap (fun b => b.toList.reverse)++first.toList.reverse) origin) right v
    simp only [hb,Bool.false_eq_true,if_false] at ht
    have hr := ih (fun c hc => hrest c (by simp [hc])) (ListBlank.append b.toList right)
    have hall := ht.trans hr
    convert! hall using 1 <;> simp only [List.flatMap_cons,List.reverse_cons,List.flatMap_append,
      List.flatMap_nil,List.append_nil,ListBlank.append_assoc,List.append_assoc,List.length_cons]
    · omega
    · push_cast
      ring

theorem cells_false (input : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) :
    cells first0 first1 later0 later1 false input=
      (input.map (fun b => outputCode first0 first1 later0 later1 (b,false))).flatMap (fun b => b.toList) := by
  induction input with
  | nil => rfl
  | cons b input ih => simp only [cells,List.map_cons,List.flatMap_cons,ih]

theorem flat_reverse {n : ℕ} (blocks : List (List.Vector Symbol n)) :
    (blocks.flatMap (fun b => b.toList)).reverse=blocks.reverse.flatMap (fun b => b.toList.reverse) := by
  induction blocks with
  | nil => rfl
  | cons b blocks ih => simp [List.reverse_cons,List.flatMap_append,List.reverse_append,ih]

theorem eof_trace (origin : ListBlank Symbol) (v : Symbol×Symbol) (bit : Bool) :
    SourceTrace (program first0 first1 later0 later1 empty bottom)
      ⟨some .scan,(v,(bit,false)),Tape.mk' origin (ListBlank.mk [])⟩
      ⟨some .back,(v,(bit,false)),Tape.mk' origin (ListBlank.mk [])⟩ 1 0 := by
  apply SourceTrace.one <;> rfl

theorem rewind_cells (bit : Bool) (rest : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits)
    (hfirst : ∀ b, bottom (outputCode first0 first1 later0 later1 (b,true))=true)
    (hlater : ∀ b, bottom (outputCode first0 first1 later0 later1 (b,false))=false)
    (origin right : ListBlank Symbol) (v : Local) :
    SourceTrace (program first0 first1 later0 later1 empty bottom)
      ⟨some .back,v,Tape.mk'
        (ListBlank.append (cells first0 first1 later0 later1 true (bit::rest)).reverse origin) right⟩
      ⟨none,v,Tape.mk' origin
        (ListBlank.append (cells first0 first1 later0 later1 true (bit::rest)) right)⟩
      (rest.length+1) (-(((extra+1)*(rest.length+1) : ℕ) : ℤ)) := by
  let blocks := rest.map (fun b => outputCode first0 first1 later0 later1 (b,false))
  have hb : ∀ b∈blocks.reverse, bottom b=false := by
    intro b h
    obtain ⟨c,_,rfl⟩ := List.mem_map.mp (List.mem_reverse.mp h)
    exact hlater c
  have ht := back_many first0 first1 later0 later1 empty bottom
    (outputCode first0 first1 later0 later1 (bit,true)) blocks.reverse (hfirst bit) hb origin right v
  simpa only [blocks,cells,cells_false,List.reverse_append,flat_reverse,List.reverse_reverse,
    List.length_reverse,List.length_map] using ht

theorem empty_trace (origin : ListBlank Symbol) (v : Symbol×Symbol) (bit : Bool) :
    SourceTrace (program first0 first1 later0 later1 empty bottom)
      ⟨some .scan,(v,(bit,true)),Tape.mk' origin (ListBlank.mk [])⟩
      ⟨none,(v,(bit,true)),Tape.mk' origin (ListBlank.mk empty.toList)⟩ 1 0 := by
  have hn : ListBlank.append (List.replicate (extra+1) (none : Symbol)) (ListBlank.mk [])=
      ListBlank.mk [] := by
    rw [ListBlank.append_mk,List.append_nil]
    exact Quotient.sound (Or.inr ⟨extra+1,rfl⟩)
  let done : TM1.Stmt Symbol (Label extra) Local := moves (extra+1) .left .halt
  obtain ⟨hs,hd⟩ := write_semantics empty.toList (List.replicate (extra+1) none)
    (by simp) done (v,(bit,true)) origin (ListBlank.mk [])
  rw [hn] at hs hd
  simp only [done,moves_step,moves_shift,left_vector,stmtShift,stmtOffset,mul_neg,mul_one,
    TM1.stepAux,ListBlank.append_mk,List.append_nil,List.Vector.toList_length] at hs hd
  apply SourceTrace.one
  · change some (TM1.stepAux (writeSymbols empty.toList done) (v,(bit,true)) (Tape.mk' origin (ListBlank.mk [])))=_
    exact congrArg some hs
  · change stmtShift (writeSymbols empty.toList done) (v,(bit,true)) (Tape.mk' origin (ListBlank.mk []))=0
    dsimp only [done]
    omega

theorem source_frontend (input : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits)
    (hfirst : ∀ b, bottom (outputCode first0 first1 later0 later1 (b,true))=true)
    (hlater : ∀ b, bottom (outputCode first0 first1 later0 later1 (b,false))=false) :
    ∃ last : TM1.Cfg Symbol (Label extra) Local,
      last.l=none ∧
      last.Tape=Tape.mk₁ (if input=[] then empty.toList else cells first0 first1 later0 later1 true input) ∧
      SourceTrace (program first0 first1 later0 later1 empty bottom)
        (TM1.init (input.map some)) last (extra*input.length*(input.length+1)+3*input.length+2) 0 := by
  have hboot : SourceTrace (program first0 first1 later0 later1 empty bottom)
      (TM1.init (input.map some))
      ⟨some .scan,(default,(false,true)),Tape.mk₁ (input.map some)⟩ 1 0 := by
    apply SourceTrace.one <;> rfl
  cases input with
  | nil =>
    have ht :=
        hboot.trans (empty_trace first0 first1 later0 later1 empty bottom (ListBlank.mk []) default false)
    refine ⟨⟨none,(default,(false,true)),Tape.mk₁ empty.toList⟩,rfl,?_,?_⟩
    · simp
    · simpa using! ht
  | cons bit rest =>
    obtain ⟨v,lastBit,hs⟩ := forward_trace first0 first1 later0 later1 empty bottom
      (bit::rest) (ListBlank.mk []) default false true
    simp only [List.cons_ne_nil,if_false] at hs
    have he := eof_trace first0 first1 later0 later1 empty bottom
      (ListBlank.append (cells first0 first1 later0 later1 true (bit::rest)).reverse (ListBlank.mk [])) v lastBit
    have hr := rewind_cells first0 first1 later0 later1 empty bottom bit rest hfirst hlater
      (ListBlank.mk []) (ListBlank.mk []) (v,(lastBit,false))
    have hall := ((hboot.trans hs).trans he).trans hr
    refine ⟨⟨none,(v,(lastBit,false)),Tape.mk' (ListBlank.mk [])
      (ListBlank.append (cells first0 first1 later0 later1 true (bit::rest)) (ListBlank.mk []))⟩,rfl,?_,?_⟩
    · simp only [List.cons_ne_nil,if_false,Tape.mk₁,Tape.mk₂,ListBlank.append_mk,List.append_nil]
    · convert! hall using 1 <;> simp only [List.length_cons]
      · ring
      · push_cast
        ring

def budgetFactor : ℕ :=
  (extra+3)*tm1TickBound (program first0 first1 later0 later1 empty bottom)+1

theorem physical_frontend (input : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits)
    (hfirst : ∀ b, bottom (outputCode first0 first1 later0 later1 (b,true))=true)
    (hlater : ∀ b, bottom (outputCode first0 first1 later0 later1 (b,false))=false) :
    ∃ ticks last,
      ticks≤budgetFactor first0 first1 later0 later1 empty bottom*(1+input.length)^2 ∧
      Trace (tm1Machine (program first0 first1 later0 later1 empty bottom))
        (TM0.init (input.map some)) last ticks 0 ∧
      TM0.step (tm1Machine (program first0 first1 later0 later1 empty bottom)) last=none ∧
      last.Tape=Tape.mk₁ (if input=[] then empty.toList else cells first0 first1 later0 later1 true input) := by
  obtain ⟨last,hl,ht,hs⟩ :=
      source_frontend first0 first1 later0 later1 empty bottom input hfirst hlater
  obtain ⟨ticks,_,hb,hphys⟩ := tm1_finite_trace (program first0 first1 later0 later1 empty bottom)
    (extra*input.length*(input.length+1)+3*input.length+2) _ _ hs.reached
  rw [tm1Cfg_init,hs.shift_eq] at hphys
  refine ⟨ticks,tm1Cfg (program first0 first1 later0 later1 empty bottom) last,?_,hphys,?_,ht⟩
  · have hp : extra*input.length*(input.length+1)+3*input.length+2≤(extra+3)*(1+input.length)^2 := by
      nlinarith [Nat.zero_le (extra*input.length),Nat.zero_le (input.length*input.length)]
    calc
      ticks ≤ (extra*input.length*(input.length+1)+3*input.length+2)*
          tm1TickBound (program first0 first1 later0 later1 empty bottom) := hb
      _ ≤ ((extra+3)*(1+input.length)^2)*tm1TickBound
          (program first0 first1 later0 later1 empty bottom) := Nat.mul_le_mul_right _ hp
      _ ≤ budgetFactor first0 first1 later0 later1 empty bottom*(1+input.length)^2 := by
        rw [Nat.mul_right_comm]
        exact Nat.mul_le_mul_right _ (Nat.le_succ _)
  · apply tm1_finite_halt
    rcases last with ⟨l,v,tape⟩
    change l=none at hl
    subst l
    rfl
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.Expansion

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.Cleanup
open Turing

inductive Label where
  | boot | scan | left | seek | finish
  deriving DecidableEq, Fintype
instance : Inhabited Label := ⟨.boot⟩
abbrev Local := Bool×Bool

variable {extra : ℕ} (decode : List.Vector Symbol (extra+1) → Option Bool)

def nextBody (next : List.Vector Symbol (extra+1)) : TM1.Stmt Symbol Label Local :=
  .load (fun _ s => (s.1,(decode next).isSome)) (.goto (fun _ _ => .left))

def scanBody (bits : List.Vector Symbol (extra+1)) : TM1.Stmt Symbol Label Local :=
  match decode bits with
  | none => Expansion.writeSymbols (List.replicate (extra+1) none)
      (Expansion.moves (extra+2) .left (.write (fun _ _ => none) (.move .right .halt)))
  | some bit => .load (fun _ _ => (bit,false))
      (Expansion.writeSymbols (List.replicate (extra+1) none)
        (Expansion.readCode (extra+1) (nextBody decode)))

def program : Label → TM1.Stmt Symbol Label Local
  | .boot => .move .left (.write (fun _ _ => some false) (.move .right (.goto (fun _ _ => .scan))))
  | .scan => Expansion.readCode (extra+1) (scanBody decode)
  | .left => .move .left (.branch (fun a _ => a.isSome)
      (.move .right (.write (fun _ s => some s.1) (.move .right
        (.branch (fun _ s => s.2) (.goto (fun _ _ => .seek)) (.goto (fun _ _ => .finish))))))
      (.goto (fun _ _ => .left)))
  | .seek => .branch (fun a _ => a.isSome) (.goto (fun _ _ => .scan))
      (.move .right (.goto (fun _ _ => .seek)))
  | .finish => .move .left (.branch (fun a _ => a.isSome) (.goto (fun _ _ => .finish))
      (.move .right (.write (fun _ _ => none) (.move .right .halt))))

theorem finish_trace (left right : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (v : Local) :
    SourceTrace (program decode)
      ⟨some .finish,v,Tape.mk₂ (left.map some++[some false]) (right.map some)⟩
      ⟨none,v,Tape.mk₁ ((left.reverse++right).map some)⟩ (left.length+2) (-(left.length : ℤ)) := by
  induction left generalizing right with
  | nil =>
    have hfirst : SourceTrace (program decode)
        ⟨some .finish,v,Tape.mk₂ [some false] (right.map some)⟩
        ⟨some .finish,v,Tape.mk₂ [] (some false::right.map some)⟩ 1 (-1) := by
      apply SourceTrace.one
      · simp [TM1.step,program,TM1.stepAux,Tape.mk₂,Tape.move_left_mk',ListBlank.cons_mk]
      · rfl
    have hlast : SourceTrace (program decode)
        ⟨some .finish,v,Tape.mk₂ [] (some false::right.map some)⟩
        ⟨none,v,Tape.mk₁ (right.map some)⟩ 1 1 := by
      apply SourceTrace.one
      · simp only [TM1.step,program,TM1.stepAux]
        rw [show ((Tape.mk₂ [] (some false::right.map some)).move .left).head=none by rfl]
        simp only [Option.isSome_none,cond_false,Tape.move_left_right]
        change some (TM1.Cfg.mk none v ((Tape.mk₂ [] (none::right.map some)).move .right))=_
        simp only [Tape.mk₂,Tape.move_right_mk',ListBlank.head_mk,List.headI_cons,
          ListBlank.tail_mk,List.tail_cons]
        have he : ListBlank.mk ([none] : List Symbol)=ListBlank.mk [] :=
            Quotient.sound (Or.inr ⟨1,rfl⟩)
        simp only [Tape.mk₁,Tape.mk₂,ListBlank.cons_mk,he]
      · simp [program,stmtShift,stmtOffset,Tape.mk₂,Tape.move_left_mk',show (default : Symbol)=none from rfl]
    simpa using hfirst.trans hlast
  | cons b left ih =>
    have hm : (Tape.mk₂ ((b::left).map some++[some false]) (right.map some)).move .left=
        Tape.mk₂ (left.map some++[some false]) ((b::right).map some) := by
      simp [Tape.mk₂,Tape.move_left_mk',ListBlank.cons_mk]
    have ht := (ih (b::right)).prepend (l := Label.finish) (v := v)
      (tape := Tape.mk₂ ((b::left).map some++[some false]) (right.map some))
      (by simp only [TM1.step,program,TM1.stepAux]; rw [hm]; rfl)
      (s := -1) (by simp only [program,stmtShift,hm]; rfl)
    convert! ht using 1 <;> simp [List.reverse_cons,List.append_assoc,Int.add_comm]

theorem seek_trace (gap : ℕ) (origin right : ListBlank Symbol) (v : Local)
    (h : right.head.isSome=true) :
    SourceTrace (program decode)
      ⟨some .seek,v,Tape.mk' origin (ListBlank.append (List.replicate gap none) right)⟩
      ⟨some .scan,v,Tape.mk' ((ListBlank.cons none)^[gap] origin) right⟩ (gap+1) gap := by
  induction gap generalizing origin with
  | zero =>
    apply SourceTrace.one
    · simp [TM1.step,program,TM1.stepAux,Tape.mk'_head,h]
    · simp [program,stmtShift,Tape.mk'_head,h]
  | succ gap ih =>
    have ht := (ih (ListBlank.cons none origin)).prepend (l := Label.seek) (v := v)
      (tape := Tape.mk' origin (ListBlank.append (List.replicate (gap+1) none) right))
      (by simp [TM1.step,program,TM1.stepAux,List.replicate_succ,ListBlank.append,
        Tape.mk'_head,Tape.move_right_mk'])
      (s := 1) (by simp [program,stmtShift,stmtOffset,List.replicate_succ,ListBlank.append,Tape.mk'_head])
    simpa only [Function.iterate_succ_apply,Int.natCast_add,Int.natCast_one,Int.add_comm] using ht

theorem append_trace (gap : ℕ) (origin right : ListBlank Symbol) (bit more : Bool)
    (h : origin.head.isSome=true) :
    SourceTrace (program decode)
      ⟨some .left,(bit,more),Tape.mk' (ListBlank.append (List.replicate (gap+1) none) origin) right⟩
      ⟨some (if more then .seek else .finish),(bit,more),
        Tape.mk' (ListBlank.cons (some bit) origin) (ListBlank.append (List.replicate gap none) right)⟩
      (gap+2) (-(gap : ℤ)) := by
  induction gap generalizing right with
  | zero =>
    have hfirst : SourceTrace (program decode)
        ⟨some .left,(bit,more),Tape.mk' (ListBlank.cons none origin) right⟩
        ⟨some .left,(bit,more),Tape.mk' origin (ListBlank.cons none right)⟩ 1 (-1) := by
      apply SourceTrace.one
      · simp [TM1.step,program,TM1.stepAux,Tape.move_left_mk',Tape.mk'_head]
      · simp [program,stmtShift,stmtOffset,Tape.move_left_mk',Tape.mk'_head]
    have hlast : SourceTrace (program decode)
        ⟨some .left,(bit,more),Tape.mk' origin (ListBlank.cons none right)⟩
        ⟨some (if more then .seek else .finish),(bit,more),Tape.mk' (ListBlank.cons (some bit) origin) right⟩ 1 1 := by
      apply SourceTrace.one
      · simp only [TM1.step,program,TM1.stepAux]
        have hh : ((Tape.mk' origin (ListBlank.cons none right)).move .left).head.isSome=true := by
          simpa only [Tape.move_left_mk',Tape.mk'_head,ListBlank.head_cons] using h
        rw [hh]
        simp only [cond_true,Tape.move_left_right]
        cases more <;> simp [Tape.write_mk',Tape.move_right_mk']
      · simp [program,stmtShift,stmtOffset,Tape.move_left_mk',Tape.mk'_head,h]
    simpa using hfirst.trans hlast
  | succ gap ih =>
    have ht := (ih (ListBlank.cons none right)).prepend (l := Label.left) (v := (bit,more))
      (tape := Tape.mk' (ListBlank.append (List.replicate (gap+2) none) origin) right)
      (by simp [TM1.step,program,TM1.stepAux,List.replicate_succ,ListBlank.append,
        Tape.move_left_mk',Tape.mk'_head])
      (s := -1) (by simp [program,stmtShift,stmtOffset,List.replicate_succ,ListBlank.append,
        Tape.move_left_mk',Tape.mk'_head])
    have he : ListBlank.append (List.replicate gap (none : Symbol)) (ListBlank.cons none right)=
        ListBlank.append (List.replicate (gap+1) none) right := by
      rw [← Expansion.cons_replicate,← Expansion.cons_replicate,Function.iterate_succ_apply]
    rw [he] at ht
    convert! ht using 1
    simp only [Int.natCast_add,Int.natCast_one]
    · omega

theorem scan_some_trace (bits next : List.Vector Symbol (extra+1)) (bit : Bool)
    (h : decode bits=some bit) (origin right : ListBlank Symbol) (v : Local) :
    SourceTrace (program decode)
      ⟨some .scan,v,Tape.mk' origin (ListBlank.append bits.toList (ListBlank.append next.toList right))⟩
      ⟨some .left,(bit,(decode next).isSome),
        Tape.mk' (ListBlank.append (List.replicate (extra+1) none) origin)
          (ListBlank.append next.toList right)⟩ 1 (extra+1 : ℕ) := by
  let continuation := Expansion.readCode (extra+1) (nextBody decode)
  obtain ⟨hs,hd⟩ :=
      Expansion.readCode_semantics bits (scanBody decode) v origin
      (ListBlank.append next.toList right)
  obtain ⟨ws,wd⟩ := Expansion.write_semantics (List.replicate (extra+1) none) bits.toList
    (by simp) continuation (bit,false) origin (ListBlank.append next.toList right)
  obtain ⟨rs,rd⟩ := Expansion.readCode_semantics next (nextBody decode) (bit,false)
    (ListBlank.append (List.replicate (extra+1) none) origin) right
  simp only [List.reverse_replicate] at ws wd
  apply SourceTrace.one
  · change some (TM1.stepAux (Expansion.readCode (extra+1) (scanBody decode)) v _) = _
    rw [hs]
    simp only [scanBody,h,TM1.stepAux]
    rw [ws,show continuation=Expansion.readCode (extra+1) (nextBody decode) from rfl,rs]
    rfl
  · change stmtShift (Expansion.readCode (extra+1) (scanBody decode)) v _ = _
    rw [hd]
    simp only [scanBody,h,stmtShift]
    rw [wd,show continuation=Expansion.readCode (extra+1) (nextBody decode) from rfl,rd]
    simp [nextBody,stmtShift]

theorem blank_append (n : ℕ) :
    ListBlank.append (List.replicate n (none : Symbol)) (ListBlank.mk [])=ListBlank.mk [] := by
  rw [ListBlank.append_mk,List.append_nil]
  exact Quotient.sound (Or.inr ⟨n,rfl⟩)

def liveLeft (pre : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) : ListBlank Symbol :=
  ListBlank.mk (pre.reverse.map some++[some false])

theorem liveLeft_head (pre : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) : (liveLeft pre).head.isSome=true := by
  cases h : pre.reverse with
  | nil => simp [liveLeft,h,ListBlank.head_mk]
  | cons b bs => simp [liveLeft,h,ListBlank.head_mk]

theorem liveLeft_append (pre : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (bit : Bool) :
    liveLeft (pre++[bit])=ListBlank.cons (some bit) (liveLeft pre) := by
  simp [liveLeft,List.reverse_append,ListBlank.cons_mk]

variable (later : Bool → List.Vector Symbol (extra+1))

def encoded (bits : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) : List Symbol :=
    bits.flatMap (fun b => (later b).toList)

theorem encoded_cons (b : Bool) (bits : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) :
    encoded later (b::bits)=(later b).toList++encoded later bits := rfl

theorem append_seek_trace (pre : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (bit : Bool)
    (next : List.Vector Symbol (extra+1)) (right : ListBlank Symbol)
    (hn : next.head.isSome=true) :
    SourceTrace (program decode)
      ⟨some .left,(bit,true),
        Tape.mk' (ListBlank.append (List.replicate (extra*(pre.length+1)+1) none) (liveLeft pre))
          (ListBlank.append next.toList right)⟩
      ⟨some .scan,(bit,true),
        Tape.mk' (ListBlank.append (List.replicate (extra*(pre.length+1)) none) (liveLeft (pre++[bit])))
          (ListBlank.append next.toList right)⟩
      (2*(extra*(pre.length+1))+3) 0 := by
  have ha := append_trace decode (extra*(pre.length+1)) (liveLeft pre)
    (ListBlank.append next.toList right) bit true (liveLeft_head pre)
  have hh : (ListBlank.append next.toList right).head.isSome=true := by
    rcases next with ⟨bs,hbs⟩
    cases bs with
    | nil => simp only [List.length_nil] at hbs; omega
    | cons a bs => simpa [ListBlank.append,List.Vector.head] using hn
  have hs := seek_trace decode (extra*(pre.length+1))
    (ListBlank.cons (some bit) (liveLeft pre)) (ListBlank.append next.toList right) (bit,true) hh
  simpa [liveLeft_append,Expansion.cons_replicate,Nat.two_mul,Nat.add_assoc,Nat.add_left_comm] using ha.trans hs

theorem cell_then_next (pre : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (bit nextBit : Bool)
    (code : List.Vector Symbol (extra+1)) (tail : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (v : Local)
    (hc : decode code=some bit) (hd : decode (later nextBit)=some nextBit)
    (hh : (later nextBit).head.isSome=true) :
    SourceTrace (program decode)
      ⟨some .scan,v,
        Tape.mk' (ListBlank.append (List.replicate (extra*pre.length) none) (liveLeft pre))
          (ListBlank.mk (code.toList++encoded later (nextBit::tail)))⟩
      ⟨some .scan,(bit,true),
        Tape.mk' (ListBlank.append (List.replicate (extra*(pre.length+1)) none) (liveLeft (pre++[bit])))
          (ListBlank.mk (encoded later (nextBit::tail)))⟩
      (2*(extra*(pre.length+1))+4) (extra+1 : ℕ) := by
  have hs := scan_some_trace decode code (later nextBit) bit hc
    (ListBlank.append (List.replicate (extra*pre.length) none) (liveLeft pre))
    (ListBlank.mk (encoded later tail)) v
  rw [hd] at hs
  have hg : extra+1+extra*pre.length=extra*(pre.length+1)+1 := by ring
  simp only [← ListBlank.append_assoc,← List.replicate_add,hg] at hs
  have hn := append_seek_trace decode pre bit (later nextBit) (ListBlank.mk (encoded later tail)) hh
  have hall := hs.trans hn
  have hn : 1+(2*(extra*(pre.length+1))+3)=2*(extra*(pre.length+1))+4 := by omega
  rw [hn] at hall
  simpa only [encoded_cons,ListBlank.append_mk,List.append_assoc,Int.add_zero] using hall

theorem cell_then_finish (pre : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (bit : Bool)
    (code : List.Vector Symbol (extra+1)) (v : Local)
    (hc : decode code=some bit) (hb : decode (List.Vector.replicate (extra+1) none)=none) :
    SourceTrace (program decode)
      ⟨some .scan,v,
        Tape.mk' (ListBlank.append (List.replicate (extra*pre.length) none) (liveLeft pre))
          (ListBlank.mk code.toList)⟩
      ⟨none,(bit,false),Tape.mk₁ ((pre++[bit]).map some)⟩
      (extra*(pre.length+1)+pre.length+6) (-((extra+1)*pre.length : ℕ)) := by
  have hs := scan_some_trace decode code (List.Vector.replicate (extra+1) none) bit hc
    (ListBlank.append (List.replicate (extra*pre.length) none) (liveLeft pre))
    (ListBlank.mk []) v
  rw [hb] at hs
  have hg : extra+1+extra*pre.length=extra*(pre.length+1)+1 := by ring
  simp only [show (List.Vector.replicate (extra+1) (none : Symbol)).toList=List.replicate (extra+1) none from rfl,
    blank_append,Option.isSome_none] at hs
  simp only [← ListBlank.append_assoc,← List.replicate_add,hg] at hs
  simp only [ListBlank.append_mk,List.append_nil] at hs
  have ha := append_trace decode (extra*(pre.length+1)) (liveLeft pre)
    (ListBlank.mk []) bit false (liveLeft_head pre)
  simp only [Bool.false_eq_true,if_false,blank_append,← liveLeft_append] at ha
  have hf := finish_trace decode (pre++[bit]).reverse [] (bit,false)
  simp only [List.reverse_reverse,List.append_nil] at hf
  change SourceTrace
      (program decode) ⟨some .finish,(bit,false),Tape.mk' (liveLeft (pre++[bit])) (ListBlank.mk [])⟩ _ _ _ at hf
  have hall := (hs.trans ha).trans hf
  convert! hall using 1
  · simp only [List.length_reverse,List.length_append,List.length_singleton]
    omega
  · simp only [List.length_reverse,List.length_append,List.length_singleton]
    push_cast
    ring

theorem nonempty_trace (bit : Bool) (tail : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits)
    (pre : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (code : List.Vector Symbol (extra+1)) (v : Local)
    (hc : decode code=some bit) (hb : decode (List.Vector.replicate (extra+1) none)=none)
    (hd : ∀ b, decode (later b)=some b) (hh : ∀ b, (later b).head.isSome=true) :
    ∃ last : TM1.Cfg Symbol Label Local, last.l=none ∧
      last.Tape=Tape.mk₁ ((pre++bit::tail).map some) ∧
      SourceTrace (program decode)
        ⟨some .scan,v,
          Tape.mk' (ListBlank.append (List.replicate (extra*pre.length) none) (liveLeft pre))
            (ListBlank.mk (code.toList++encoded later tail))⟩ last
        (extra*((2*tail.length+1)*pre.length+(tail.length+1)^2)+5*(tail.length+1)+pre.length+1)
        (-((extra+1)*pre.length : ℕ)) := by
  induction tail generalizing bit code pre v with
  | nil =>
    refine ⟨⟨none,(bit,false),Tape.mk₁ ((pre++[bit]).map some)⟩,rfl,rfl,?_⟩
    have ht := cell_then_finish decode pre bit code v hc hb
    convert! ht using 1
    · simp [encoded]
    · simp only [List.length_nil]
      ring
  | cons nextBit tail ih =>
    obtain ⟨last,hl,ht,hs⟩ := ih nextBit (pre++[bit]) (later nextBit) (bit,true) (hd nextBit)
    have hf := cell_then_next decode later pre bit nextBit code tail v hc (hd nextBit) (hh nextBit)
    refine ⟨last,hl,?_,?_⟩
    · simpa [List.append_assoc] using ht
    · simp only [List.length_append,List.length_singleton] at hs
      change SourceTrace (program decode) _ last _ _ at hs
      have hi : (later nextBit).toList++encoded later tail=encoded later (nextBit::tail) := rfl
      rw [hi] at hs
      convert! hf.trans hs using 1
      · simp only [List.length_cons]
        ring
      · push_cast
        ring

theorem empty_trace (empty : List.Vector Symbol (extra+1)) (v : Local)
    (he : decode empty=none) :
    SourceTrace (program decode)
      ⟨some .scan,v,Tape.mk' (ListBlank.mk [some false]) (ListBlank.mk empty.toList)⟩
      ⟨none,v,Tape.mk₁ []⟩ 1 0 := by
  let q : TM1.Stmt Symbol Label Local :=
    Expansion.moves (extra+2) .left (.write (fun _ _ => none) (.move .right .halt))
  obtain ⟨rs,rd⟩ := Expansion.readCode_semantics empty (scanBody decode) v
    (ListBlank.mk [some false]) (ListBlank.mk [])
  simp only [ListBlank.append_mk,List.append_nil] at rs rd
  obtain ⟨ws,wd⟩ := Expansion.write_semantics (List.replicate (extra+1) none) empty.toList
    (by simp) q v (ListBlank.mk [some false]) (ListBlank.mk [])
  simp only [List.reverse_replicate,ListBlank.append_mk,List.append_nil] at ws wd
  have hm : (Tape.move .left)^[extra+2]
      (Tape.mk' (ListBlank.append (List.replicate (extra+1) none) (ListBlank.mk [some false])) (ListBlank.mk []))=
      Tape.mk₂ [] [some false] := by
    rw [← Expansion.cons_replicate,Function.iterate_succ_apply',Expansion.left_gap,blank_append]
    simp [Tape.mk₂,Tape.move_left_mk',ListBlank.cons_mk]
  simp only [ListBlank.append_mk] at hm
  have ht : TM1.stepAux (.write (fun _ _ => (none : Symbol)) (.move .right .halt)) v (Tape.mk₂ [] [some false])=
      (⟨none,v,Tape.mk₁ []⟩ : TM1.Cfg Symbol Label Local) := by
    simp only [TM1.stepAux,Tape.mk₂,Tape.write_mk',Tape.move_right_mk',
      ListBlank.head_cons,ListBlank.tail_cons]
    have hblank := blank_append 1
    change ListBlank.cons none (ListBlank.mk [])=ListBlank.mk [] at hblank
    rw [hblank]
    rfl
  apply SourceTrace.one
  · change some (TM1.stepAux (Expansion.readCode (extra+1) (scanBody decode)) v _) = _
    rw [rs]
    simp only [scanBody,he]
    rw [ws]
    change some (TM1.stepAux (Expansion.moves (extra+2) .left _) v _)=_
    rw [Expansion.moves_step,hm,ht]
  · change stmtShift (Expansion.readCode (extra+1) (scanBody decode)) v _ = _
    rw [rd]
    simp only [scanBody,he]
    rw [wd]
    dsimp only [q]
    rw [Expansion.moves_shift,hm]
    simp only [stmtShift,stmtOffset,mul_neg,mul_one,List.length_replicate,Int.natCast_add,Int.natCast_one]
    omega

variable (first : Bool → List.Vector Symbol (extra+1)) (empty : List.Vector Symbol (extra+1))

def inputCells (input : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) : List Symbol :=
  match input with
  | [] => empty.toList
  | bit::rest => (first bit).toList++encoded later rest

theorem source_cleanup (input : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits)
    (hb : decode (List.Vector.replicate (extra+1) none)=none)
    (he : decode empty=none) (hf : ∀ b, decode (first b)=some b)
    (hd : ∀ b, decode (later b)=some b) (hh : ∀ b, (later b).head.isSome=true) :
    ∃ last : TM1.Cfg Symbol Label Local, last.l=none ∧ last.Tape=Tape.mk₁ (input.map some) ∧
      SourceTrace (program decode) (TM1.init (inputCells later first empty input)) last
        (extra*input.length^2+5*input.length+2) 0 := by
  have hboot : SourceTrace (program decode) (TM1.init (inputCells later first empty input))
      ⟨some .scan,default,Tape.mk' (ListBlank.mk [some false]) (ListBlank.mk (inputCells later first empty input))⟩ 1 0 := by
    apply SourceTrace.one
    · simp [TM1.init,TM1.step,program,TM1.stepAux,Tape.mk₁,Tape.mk₂,Tape.move_left_mk',
        Tape.move_right_mk',Tape.write_mk',ListBlank.cons_mk,show (default : Label)=.boot from rfl]
    · simp [TM1.init,program,stmtShift,stmtOffset,show (default : Label)=.boot from rfl]
  cases input with
  | nil =>
    have ht := hboot.trans (empty_trace decode empty default he)
    exact ⟨_,rfl,rfl,by simpa using ht⟩
  | cons bit rest =>
    obtain ⟨last,hl,ht,hs⟩ :=
        nonempty_trace decode later bit rest [] (first bit) default (hf bit) hb hd hh
    refine ⟨last,hl,by simpa using ht,?_⟩
    simp only [List.length_nil,Nat.mul_zero,List.replicate_zero,ListBlank.append,liveLeft,
      List.reverse_nil,List.map_nil,List.nil_append] at hs
    convert! hboot.trans hs using 1
    simp only [List.length_cons]
    ring

noncomputable def budgetFactor : ℕ := (extra+5)*tm1TickBound (program decode)+1

theorem physical_cleanup (input : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits)
    (hb : decode (List.Vector.replicate (extra+1) none)=none)
    (he : decode empty=none) (hf : ∀ b, decode (first b)=some b)
    (hd : ∀ b, decode (later b)=some b) (hh : ∀ b, (later b).head.isSome=true) :
    ∃ ticks last,
      ticks≤budgetFactor decode*(1+input.length)^2 ∧
      Trace (tm1Machine (program decode)) (TM0.init (inputCells later first empty input)) last ticks 0 ∧
      TM0.step (tm1Machine (program decode)) last=none ∧ last.Tape=Tape.mk₁ (input.map some) := by
  obtain ⟨last,hl,ht,hs⟩ := source_cleanup decode later first empty input hb he hf hd hh
  obtain ⟨ticks,_,hbnd,hphys⟩ := tm1_finite_trace (program decode)
    (extra*input.length^2+5*input.length+2) _ _ hs.reached
  rw [tm1Cfg_init,hs.shift_eq] at hphys
  refine ⟨ticks,tm1Cfg (program decode) last,?_,hphys,?_,ht⟩
  · have hp : extra*input.length^2+5*input.length+2≤(extra+5)*(1+input.length)^2 := by
      nlinarith [Nat.zero_le (extra*input.length),Nat.zero_le (input.length*input.length)]
    calc
      ticks ≤ (extra*input.length^2+5*input.length+2)*tm1TickBound (program decode) := hbnd
      _ ≤ ((extra+5)*(1+input.length)^2)*tm1TickBound (program decode) := Nat.mul_le_mul_right _ hp
      _ ≤ budgetFactor decode*(1+input.length)^2 := by
        rw [Nat.mul_right_comm]
        exact Nat.mul_le_mul_right _ (Nat.le_succ _)
  · apply tm1_finite_halt
    rcases last with ⟨l,v,tape⟩
    change l=none at hl
    subst l
    rfl
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.Cleanup

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM
open Turing

theorem Trace.then_init {a b : ℕ} {M : TM0.Machine Symbol (Fin (a+1))}
    {N : TM0.Machine Symbol (Fin (b+1))} {input middle : List Symbol}
    {cf : TM0.Cfg Symbol (Fin (a+1))} {cg : TM0.Cfg Symbol (Fin (b+1))}
    {t s : ℕ} {df dg : ℤ}
    (hf : Trace M (TM0.init input) cf t df) (hstop : TM0.step M cf=none)
    (htape : cf.Tape=Tape.mk₁ middle) (hg : Trace N (TM0.init middle) cg s dg) :
    Trace (composeMachine M N) (TM0.init input) (secondCfg cg) (t+1+s) (df+dg) := by
  obtain ⟨hfr,hfo⟩ := compose_first_run M N _ cf t hf.reached
  have hfirst : Trace (composeMachine M N) (TM0.init input) (firstCfg cf) t df :=
    ⟨hfr,hfo.trans hf.offset_eq⟩
  have hbridge : Trace (composeMachine M N) (firstCfg cf) (secondCfg (TM0.init middle)) 1 0 := by
    apply Trace.one
    · rw [compose_first,hstop]
      change some (secondCfg (TM0.Cfg.mk 0 cf.Tape))=_
      rw [htape]
      rfl
    · rw [compose_first_offset]
      unfold TM0.step at hstop
      have he : M cf.q cf.Tape.head=none := Option.map_eq_none_iff.mp hstop
      simp only [nextOffset,he]
  obtain ⟨hgr,hgo⟩ := compose_second_run M N _ cg s hg.reached
  have hlast : Trace (composeMachine M N) (secondCfg (TM0.init middle)) (secondCfg cg) s dg :=
    ⟨hgr,hgo.trans hg.offset_eq⟩
  simpa only [Int.add_zero] using (hfirst.trans hbridge).trans hlast
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.Cleanup
open Turing
variable {extra : ℕ} (decode : List.Vector Symbol (extra+1) → Option Bool)
    (later first : Bool → List.Vector Symbol (extra+1)) (empty : List.Vector Symbol (extra+1))
    (bottom : List.Vector Symbol (extra+1) → Bool)

theorem encoded_cells (input : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) :
    encoded later input=Expansion.cells (first false) (first true) (later false) (later true) false input := by
  induction input with
  | nil => rfl
  | cons bit rest ih =>
    simp only [encoded_cons,Expansion.cells,Expansion.outputCode,Bool.false_eq_true,if_false,← ih]
    cases bit <;> rfl

theorem inputCells_expansion (input : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) :
    inputCells later first empty input=(if input=[] then empty.toList else
      Expansion.cells (first false) (first true) (later false) (later true) true input) := by
  cases input with
  | nil => rfl
  | cons bit rest =>
    simp only [inputCells,List.cons_ne_nil,if_false,Expansion.cells,Expansion.outputCode,if_true,
      ← encoded_cells later first rest]
    cases bit <;> rfl

theorem raw_roundtrip
    (hb : decode (List.Vector.replicate (extra+1) none)=none) (he : decode empty=none)
    (hf : ∀ b, decode (first b)=some b) (hd : ∀ b, decode (later b)=some b)
    (hh : ∀ b, (later b).head.isSome=true)
    (hbf : ∀ b, bottom (first b)=true) (hbl : ∀ b, bottom (later b)=false) :
    ∃ (q : ℕ) (M : TM0.Machine Symbol (Fin (q+1))) (C : ℕ), 0<C ∧ ∀ input : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits,
      Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Runs M input input (C*(1+input.length)^2) (C*(1+input.length)^2) := by
  let F :=
      tm1Machine (Expansion.program (first false) (first true) (later false) (later true) empty bottom)
  let G := tm1Machine (program decode)
  let C := Expansion.budgetFactor (first false) (first true) (later false) (later true) empty bottom+
    budgetFactor decode+1
  refine ⟨(tm1Support (Expansion.program (first false) (first true) (later false) (later true) empty bottom)).card+1+
    (tm1Support (program decode)).card,composeMachine F G,C,by dsimp [C]; omega,?_⟩
  intro input
  have hfirst : ∀ b, bottom (Expansion.outputCode (first false) (first true) (later false) (later true) (b,true))=true := by
    intro b
    cases b <;> exact hbf _
  have hlater : ∀ b, bottom (Expansion.outputCode (first false) (first true) (later false) (later true) (b,false))=false := by
    intro b
    cases b <;> exact hbl _
  obtain ⟨t,cf,hft,hftrace,hfstop,hftape⟩ := Expansion.physical_frontend
    (first false) (first true) (later false) (later true) empty bottom input hfirst hlater
  obtain ⟨s,cg,hgt,hgtrace,hgstop,hgtape⟩ :=
      physical_cleanup decode later first empty input hb he hf hd hh
  rw [← inputCells_expansion later first empty input] at hftape
  have hall := hftrace.then_init hfstop hftape hgtrace
  have hclock : t+1+s≤C*(1+input.length)^2 := by
    have hB : 1≤(1+input.length)^2 := by
      have hL : 1+input.length≤(1+input.length)^2 := Nat.le_pow (by decide)
      omega
    dsimp only [C]
    nlinarith
  apply hall.runs
  · have hC : 0<C := by dsimp [C]; omega
    have hL : input.length≤(1+input.length)^2 := by
      have hL : 1+input.length≤(1+input.length)^2 := Nat.le_pow (by decide)
      omega
    nlinarith
  · exact hclock
  · rw [compose_second,hgstop]
    rfl
  · intro i
    change cg.Tape.right₀.nth i=_
    rw [hgtape]
    simp [Tape.mk₁,Tape.mk₂,ListBlank.nth_mk,List.getI_eq_getElem?_getD,show (default : Symbol)=none from rfl]
  · intro i
    change cg.Tape.left.nth i=_
    rw [hgtape]
    rfl
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.Cleanup

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.Alphabet
open Turing
variable {Γ Λ σ : Type} [Inhabited Γ] [Inhabited Λ] [Inhabited σ]
    [Fintype Γ] [Fintype Λ] [Fintype σ]
    {n : ℕ} (enc : Γ → List.Vector Bool n) (dec : List.Vector Bool n → Γ)
    (enc0 : enc default=List.Vector.replicate n false) (M : Λ → TM1.Stmt Γ Λ σ)

def encodedSymbols (input : List Γ) : List Symbol :=
  input.flatMap (fun a => (enc a).toList.map boolSymbol)

@[simp] theorem physicalCfg_init (input : List Γ) :
    physicalCfg enc dec enc0 M (TM1.init input)=TM0.init (encodedSymbols enc input) := by
  have htr : TM1to1.trCfg enc enc0 (TM1.init input : TM1.Cfg Γ Λ σ)=
      TM1.init (input.flatMap (fun a => (enc a).toList)) := by
    simp only [TM1to1.trCfg,TM1.init,Tape.mk₁,Tape.mk₂,TM1to1.trTape_mk',
      TM1to1.trTape',ListBlank.flatMap_mk,List.flatMap_nil]
    rfl
  have hb (bits : List Bool) : boolCfg (TM1.init bits : TM1.Cfg Bool (TM1to1.Λ' Γ Λ σ) σ)=
      TM1.init (bits.map boolSymbol) := by
    simp only [boolCfg,TM1.init,Tape.map_mk₁]
  rw [physicalCfg,htr,hb,restrictedCfg_init,tm1Cfg_init]
  congr 1
  simp [encodedSymbols,List.map_flatMap]
omit [Fintype Γ] in

theorem encodedTape_mk₁ (input : List Γ) :
    (TM1to1.trTape enc0 (Tape.mk₁ input)).map boolSymbol=Tape.mk₁ (encodedSymbols enc input) := by
  simp only [Tape.mk₁,Tape.mk₂,TM1to1.trTape_mk',TM1to1.trTape',ListBlank.flatMap_mk,
    List.flatMap_nil,Tape.map_mk',ListBlank.map_mk,List.map_nil]
  congr 1
  simp [encodedSymbols,List.map_flatMap]

end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.Alphabet

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.Stacks
open Turing Turing.TM2to1
variable {K : Type} [DecidableEq K] {Γ : K → Type} {Λ σ : Type}

omit [DecidableEq K] in

theorem trCfg_unique {c : TM2.Cfg Γ Λ σ} {first last : TM1.Cfg (Γ' K Γ) (Λ' K Γ Λ σ) σ}
    (hf : TrCfg c first) (hl : TrCfg c last) : first=last := by
  cases hf with
  | mk L hL =>
    cases hl with
    | mk R hR =>
      have he : L=R := by
        apply ListBlank.ext
        intro n
        funext k
        have hp :=
            congrArg (fun xs : ListBlank (Option (Γ k)) => xs.nth n) ((hL k).trans (hR k).symm)
        simpa only [ListBlank.nth_map,proj,PointedMap.mk_val] using hp
      rw [he]

variable [Inhabited Λ] [Inhabited σ]

abbrev BitAlphabet (K : Type) := Γ' K (fun _ => Bool)

def cell (k : K) (mark : Bool) (b : Bool) : BitAlphabet K :=
  (mark,Function.update (fun _ => none) k (some b))

def emptyCell : BitAlphabet K := (true,fun _ => none)

variable {extra : ℕ} (enc : BitAlphabet K → List.Vector Bool (extra+1))
    (dec : List.Vector Bool (extra+1) → BitAlphabet K)
    (enc0 : enc default=List.Vector.replicate (extra+1) false)

def rawCode (a : BitAlphabet K) : List.Vector Symbol (extra+1) := (enc a).map boolSymbol

def inputCode (k : K) (mark : Bool) (b : Bool) := rawCode enc (cell k mark b)

def emptyCode := rawCode enc (emptyCell : BitAlphabet K)

def outputDecode (k : K) (v : List.Vector Symbol (extra+1)) : Option Bool :=
  (dec (v.map symbolBool)).2 k

def bottomDecode (v : List.Vector Symbol (extra+1)) : Bool := (dec (v.map symbolBool)).1

variable (encdec : ∀ a, dec (enc a)=a)

omit [DecidableEq K] in
include encdec in

theorem decode_code (a : BitAlphabet K) :
    dec ((rawCode enc a).map symbolBool)=a := by
  have hv : (rawCode enc a).map symbolBool=enc a := by
    dsimp only [rawCode]
    rcases enc a with ⟨bits,hbits⟩
    apply Subtype.ext
    simp [List.Vector.map,List.map_map,Function.comp_def,symbolBool_boolSymbol]
  rw [hv]
  exact encdec a

omit [DecidableEq K] in
include enc0 encdec in

theorem outputDecode_blank (k : K) :
    outputDecode dec k (List.Vector.replicate (extra+1) none)=none := by
  have hd := encdec default
  rw [enc0] at hd
  have he : (List.Vector.replicate (extra+1) (none : Symbol)).map symbolBool=
      List.Vector.replicate (extra+1) false := by
    apply Subtype.ext
    simp [List.Vector.map,List.Vector.replicate,symbolBool]
  rw [outputDecode,he,hd]
  rfl

include encdec in

theorem outputDecode_cell (k : K) (mark bit : Bool) :
    outputDecode dec k (inputCode enc k mark bit)=some bit := by
  simp only [outputDecode,inputCode,decode_code enc dec encdec,cell,Function.update_self]

omit [DecidableEq K] in
include encdec in

theorem outputDecode_empty (k : K) : outputDecode dec k (emptyCode enc)=none := by
  simp only [outputDecode,emptyCode,decode_code enc dec encdec,emptyCell]

include encdec in

theorem bottomDecode_cell (k : K) (mark bit : Bool) :
    bottomDecode dec (inputCode enc k mark bit)=mark := by
  simp only [bottomDecode,inputCode,decode_code enc dec encdec,cell]

theorem inputCode_head (marked : ∀ a, a≠default → (enc a).head=true)
    (k : K) (mark bit : Bool) : (inputCode enc k mark bit).head.isSome=true := by
  have hn : cell k mark bit≠(default : BitAlphabet K) := by
    intro h
    have he := congrArg (fun a : BitAlphabet K => a.2 k) h
    simp [cell] at he
  simp only [inputCode,rawCode,List.Vector.head_map,marked _ hn,boolSymbol,PointedMap.mk_val,if_true,Option.isSome_some]

omit [DecidableEq K] in

theorem rawCode_toList (a : BitAlphabet K) : (rawCode enc a).toList=(enc a).toList.map boolSymbol :=
  List.Vector.toList_map _ _

theorem encoded_trInit (k : K) (input : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) :
    Alphabet.encodedSymbols enc (trInit k input.reverse)=
      Cleanup.inputCells (inputCode enc k false) (inputCode enc k true) (emptyCode enc) input := by
  cases input with
  | nil =>
    simp [Alphabet.encodedSymbols,trInit,Cleanup.inputCells,emptyCode,emptyCell,rawCode_toList]
    rfl
  | cons bit rest =>
    simp [Alphabet.encodedSymbols,trInit,Cleanup.inputCells,Cleanup.encoded,
      inputCode,cell,rawCode_toList,List.flatMap_map]

omit [DecidableEq K] [Inhabited Λ] [Inhabited σ] in

theorem trCfg_relabel {c : TM2.Cfg Γ Λ σ} {c' : TM1.Cfg (Γ' K Γ) (Λ' K Γ Λ σ) σ}
    (h : TrCfg c c') (q : Option Λ) (v : σ) :
    TrCfg ⟨q,v,c.stk⟩ ⟨q.map Λ'.normal,v,c'.Tape⟩ := by
  cases h with
  | mk L hL => exact TrCfg.mk L hL

theorem trCfg_single (k : K) (input : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (q : Option Λ) (v : σ) :
    TrCfg (Γ := fun _ : K => Bool) ⟨q,v,Function.update (fun _ => []) k input⟩
      ⟨q.map Λ'.normal,v,Tape.mk₁ (trInit k input)⟩ := by
  have hi := @trCfg_init K (fun _ => Bool) Λ σ _ _ _ k input
  exact trCfg_relabel hi q v

variable [Fintype K] [Fintype Λ] [Fintype σ]
    (M : Λ → TM2.Stmt (fun _ : K => Bool) Λ σ)

@[simp] theorem stackCfg_init (k : K) (input : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) :
    stackCfg enc dec enc0 M (TM1.init (trInit k input.reverse))=
      TM0.init (Cleanup.inputCells (inputCode enc k false) (inputCode enc k true) (emptyCode enc) input) := by
  rw [stackCfg,restrictedCfg_init,Alphabet.physicalCfg_init,encoded_trInit]

@[simp] theorem stackCfg_tape (c : TM1.Cfg (BitAlphabet K) (Λ' K (fun _ => Bool) Λ σ) σ) :
    (stackCfg enc dec enc0 M c).Tape=(TM1to1.trTape enc0 c.Tape).map boolSymbol := rfl

theorem stackCfg_halt (c : TM1.Cfg (BitAlphabet K) (Λ' K (fun _ => Bool) Λ σ) σ) (hl : c.l=none) :
    TM0.step (stackMachine enc dec M) (stackCfg enc dec enc0 M c)=none := by
  apply Alphabet.physical_halt
  rcases c with ⟨l,v,tape⟩
  change l=none at hl
  subst l
  rfl

include enc0 encdec in

theorem physical_raw_tapes (inputStack outputStack : K) (input output : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits)
    (steps : ℕ) (v : σ)
    (h : stackRun M steps (TM2.init inputStack input.reverse)=
      some ⟨none,v,Function.update (fun _ => []) outputStack output.reverse⟩) :
    ∃ ticks last,
      ticks≤stackRunClock M steps (TM2.init inputStack input.reverse)*stackFactor enc dec M ∧
      Trace (stackMachine enc dec M)
        (TM0.init (Cleanup.inputCells (inputCode enc inputStack false) (inputCode enc inputStack true) (emptyCode enc) input))
        last ticks 0 ∧ TM0.step (stackMachine enc dec M) last=none ∧
      last.Tape=Tape.mk₁ (Cleanup.inputCells (inputCode enc outputStack false) (inputCode enc outputStack true) (emptyCode enc) output) := by
  obtain ⟨last,hr,ticks,hb,ht⟩ := stack_physical_execution enc dec enc0 M encdec steps _ _
    (TM1.init (trInit inputStack input.reverse)) (trCfg_init (Γ:=fun _ : K => Bool) (Λ:=Λ) (σ:=σ) inputStack input.reverse) h
  have he : last=⟨none,v,Tape.mk₁ (trInit outputStack output.reverse)⟩ :=
    trCfg_unique hr (trCfg_single outputStack output.reverse none v)
  rw [stackCfg_init] at ht
  refine ⟨ticks,stackCfg enc dec enc0 M last,hb,ht,?_,?_⟩
  · apply stackCfg_halt
    rw [he]
  · rw [he,stackCfg_tape,Alphabet.encodedTape_mk₁,encoded_trInit]

end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.Stacks

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.Stacks
open Turing Turing.TM2to1
variable {K Λ σ : Type} [DecidableEq K] [Fintype K] [Inhabited Λ] [Fintype Λ]
    [Inhabited σ] [Fintype σ]

set_option maxHeartbeats 2000000 in

theorem raw_compiler (M : Λ → TM2.Stmt (fun _ : K => Bool) Λ σ) (inputStack outputStack : K) :
    ∃ (q : ℕ) (N : TM0.Machine Symbol (Fin (q+1))) (C : ℕ), 0<C ∧
      ∀ (input output : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (steps : ℕ) (v : σ),
        stackRun M steps (TM2.init inputStack input.reverse)=
          some ⟨none,v,Function.update (fun _ => []) outputStack output.reverse⟩ →
        Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Runs N input output
          (C*((1+input.length)^2+stackRunClock M steps (TM2.init inputStack input.reverse)+(1+output.length)^2))
          (C*((1+input.length)^2+stackRunClock M steps (TM2.init inputStack input.reverse)+(1+output.length)^2)) := by
  classical
  obtain ⟨extra,enc,dec,h0,hinv,hmarker⟩ := Alphabet.exists_marked_codec (BitAlphabet K)
  let first := inputCode enc inputStack true
  let later := inputCode enc inputStack false
  let empty := emptyCode enc
  let bottom := bottomDecode dec
  let decode := outputDecode dec outputStack
  let FP := Expansion.program (first false) (first true) (later false) (later true) empty bottom
  let F := tm1Machine FP
  let P := stackMachine enc dec M
  let G := tm1Machine (Cleanup.program decode)
  let a := (tm1Support FP).card
  let b := (tm1Support (restrictedProgram (Alphabet.controlSupport (finiteSource M))
    (Alphabet.physicalProgram enc dec (finiteSource M)))).card
  let c := (tm1Support (Cleanup.program decode)).card
  let N := @composeMachine ((a+1)+b) c (@composeMachine a b F P) G
  let CF :=
      Expansion.budgetFactor (first false) (first true) (later false) (later true) empty bottom
  let CP := stackFactor enc dec M
  let CG := Cleanup.budgetFactor decode
  let C := CF+CP+CG+2
  refine ⟨_,N,C,by dsimp [C]; omega,?_⟩
  intro input output steps v h
  have hfirst : ∀ b, bottom (Expansion.outputCode (first false) (first true) (later false) (later true) (b,true))=true := by
    intro b
    cases b <;> exact bottomDecode_cell enc dec hinv inputStack true _
  have hlater : ∀ b, bottom (Expansion.outputCode (first false) (first true) (later false) (later true) (b,false))=false := by
    intro b
    cases b <;> exact bottomDecode_cell enc dec hinv inputStack false _
  obtain ⟨t,cf,hft,hf,hfstop,hftape⟩ := Expansion.physical_frontend
    (first false) (first true) (later false) (later true) empty bottom input hfirst hlater
  obtain ⟨u,cp,hpt,hp,hpstop,hptape⟩ :=
      physical_raw_tapes enc dec h0 hinv M inputStack outputStack input output steps v h
  rw [← Cleanup.inputCells_expansion later first empty input] at hftape
  have hfp := hf.then_init hfstop hftape hp
  have hfpstop : TM0.step (composeMachine F P) (secondCfg cp)=none := by
    rw [compose_second,hpstop]
    rfl
  obtain ⟨s,cg,hgt,hg,hgstop,hgtape⟩ := Cleanup.physical_cleanup decode
    (inputCode enc outputStack false) (inputCode enc outputStack true) empty output
    (outputDecode_blank enc dec h0 hinv outputStack) (outputDecode_empty enc dec hinv outputStack)
    (outputDecode_cell enc dec hinv outputStack true) (outputDecode_cell enc dec hinv outputStack false)
    (inputCode_head enc hmarker outputStack false)
  have hall := hfp.then_init hfpstop hptape hg
  let B :=
      (1+input.length)^2+stackRunClock M steps
      (TM2.init inputStack input.reverse)+(1+output.length)^2
  have hB : 1≤B := by
    have hi : 1+input.length≤(1+input.length)^2 := Nat.le_pow (by decide)
    dsimp [B]
    omega
  have hi : (1+input.length)^2≤B := by dsimp [B]; omega
  have hpB : stackRunClock M steps (TM2.init inputStack input.reverse)≤B := by dsimp [B]; omega
  have ho : (1+output.length)^2≤B := by dsimp [B]; omega
  have ht : t≤CF*B := hft.trans (Nat.mul_le_mul_left CF hi)
  have hu : u≤CP*B := by
    rw [Nat.mul_comm] at hpt
    exact hpt.trans (Nat.mul_le_mul_left CP hpB)
  have hs : s≤CG*B := hgt.trans (Nat.mul_le_mul_left CG ho)
  have hclock : t+1+u+1+s≤C*B := by
    calc
      t+1+u+1+s ≤ CF*B+CP*B+CG*B+2*B := by omega
      _ = C*B := by dsimp [C]; ring
  apply hall.runs
  · have hC : 0<C := by dsimp [C]; omega
    have hL : input.length≤(1+input.length)^2 := by
      have hi : 1+input.length≤(1+input.length)^2 := Nat.le_pow (by decide)
      omega
    have hIB : input.length≤B := hL.trans hi
    nlinarith
  · exact hclock
  · rw [compose_second,hgstop]
    rfl
  · intro i
    change cg.Tape.right₀.nth i=_
    rw [hgtape]
    simp [Tape.mk₁,Tape.mk₂,ListBlank.nth_mk,List.getI_eq_getElem?_getD,show (default : Symbol)=none from rfl]
  · intro i
    change cg.Tape.left.nth i=_
    rw [hgtape]
    rfl
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.Stacks

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM
open Turing Qatlib.Concepts.BitWordCompiler.CanonicalCodec

theorem runs_mono {q : ℕ} {M : TM0.Machine Symbol (Fin (q+1))}
    {input output : Bits} {time space time' space' : ℕ}
    (h : Runs M input output time space) (ht : time≤time') (hs : space≤space') :
    Runs M input output time' space' := by
  rcases h with ⟨hi,t,last,hb,hr,hh,hp,ho,hl,hv⟩
  refine ⟨hi.trans hs,t,last,hb.trans ht,hr,hh,hp,ho,hl,?_⟩
  intro u hu
  have hvisit := hv u hu
  omega
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.Stacks
open Turing

theorem stackPair_init (input : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) :
    (TM2.init (0 : Fin 2) input : TM2.Cfg (fun _ => Bool) (Fin 1) (Option Bool))=
      ⟨some 0,none,stackPair input []⟩ := by
  unfold TM2.init
  congr 1
  funext k
  by_cases hk : k=0 <;> simp [stackPair,Function.update_apply,hk]

theorem stackPair_output (output : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) :
    stackPair [] output=Function.update (fun _ : Fin 2 => []) 1 output := by
  have h0 : stackPair [] []=(fun _ : Fin 2 => []) := by funext k; simp [stackPair]
  rw [← h0,stackPair_update_one]

theorem reverse_machine :
    ∃ (q : ℕ) (M : TM0.Machine Symbol (Fin (q+1))) (C : ℕ), 0<C ∧ ∀ input : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits,
      Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Runs M input input.reverse (C*(1+input.length)^2) (C*(1+input.length)^2) := by
  obtain ⟨q,M,C,hC,hM⟩ := raw_compiler transferProgram 0 1
  refine ⟨q,M,6*C,Nat.mul_pos (by decide) hC,?_⟩
  intro input
  have hrun : stackRun transferProgram (input.length+1) (TM2.init (0 : Fin 2) input.reverse)=
      some ⟨none,none,Function.update (fun _ => []) (1 : Fin 2) input⟩ := by
    rw [stackPair_init,← List.length_reverse (as:=input),transfer_run]
    simp only [List.reverse_reverse,List.append_nil,stackPair_output]
  have hr :=
      hM input input.reverse (input.length+1) none (by simpa only [List.reverse_reverse] using hrun)
  have hclk : stackRunClock transferProgram (input.length+1)
      ⟨some 0,none,stackPair input.reverse []⟩=input.length*(2*input.length+5)+3 := by
    simpa only [List.length_reverse,List.length_nil,Nat.add_zero] using
        transfer_clock input.reverse [] none
  simp only [stackPair_init,List.length_reverse,hclk] at hr
  have hb : (1+input.length)^2+ (input.length*(2*input.length+5)+3)+(1+input.length)^2≤
      6*(1+input.length)^2 := by nlinarith
  have hm : C*((1+input.length)^2+(input.length*(2*input.length+5)+3)+(1+input.length)^2)≤
      (6*C)*(1+input.length)^2 := by
    calc
      _ ≤ C*(6*(1+input.length)^2) := Nat.mul_le_mul_left C hb
      _ = _ := by ring
  exact runs_mono hr hm hm
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.Stacks

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM
open Turing
variable {Λ : Type} [Inhabited Λ]

def Visits (M : TM0.Machine Symbol Λ) (first : TM0.Cfg Symbol Λ) (ticks space : ℕ) : Prop :=
  ∀ u, u≤ticks → -(space : ℤ)≤offset M first u ∧ offset M first u≤(space : ℤ)

theorem nextOffset_bounds (M : TM0.Machine Symbol Λ) (first : TM0.Cfg Symbol Λ) :
    -1≤nextOffset M first ∧ nextOffset M first≤1 := by
  cases h : M first.q first.Tape.head with
  | none => simp [nextOffset,h]
  | some p => rcases p with ⟨q,stmt⟩; cases stmt with
    | write b => simp [nextOffset,h,stmtOffset]
    | move d => cases d <;> simp [nextOffset,h,stmtOffset]

theorem offset_bounds (M : TM0.Machine Symbol Λ) (first : TM0.Cfg Symbol Λ) (ticks : ℕ) :
    -(ticks : ℤ)≤offset M first ticks ∧ offset M first ticks≤(ticks : ℤ) := by
  induction ticks with
  | zero => simp [offset]
  | succ n ih =>
    simp only [offset]
    cases h : run M n first with
    | none => simp only [Option.elim_none]; omega
    | some c =>
      have hb := nextOffset_bounds M c
      simp only [Option.elim_some]
      omega

theorem visits_of_clock (M : TM0.Machine Symbol Λ) (first : TM0.Cfg Symbol Λ) (ticks space : ℕ)
    (h : ticks≤space) : Visits M first ticks space := by
  intro u hu
  have hb := offset_bounds M first u
  omega

theorem Visits.mono {M : TM0.Machine Symbol Λ} {first : TM0.Cfg Symbol Λ} {ticks s s' : ℕ}
    (h : Visits M first ticks s) (hs : s≤s') : Visits M first ticks s' := by
  intro u hu
  have hb := h u hu
  omega

theorem Visits.trans_zero {M : TM0.Machine Symbol Λ} {first middle last : TM0.Cfg Symbol Λ}
    {t s a b : ℕ} {d : ℤ} (hf : Trace M first middle t 0) (_hg : Trace M middle last s d)
    (hfv : Visits M first t a) (hgv : Visits M middle s b) : Visits M first (t+s) (max a b) := by
  intro u hu
  by_cases ht : u≤t
  · have hv := hfv u ht
    have hm := Nat.le_max_left a b
    omega
  · have hs : u-t≤s := by omega
    have he : u=t+(u-t) := by omega
    rw [he,offset_add_some M t (u-t) first middle hf.reached,hf.offset_eq,Int.zero_add]
    have hv := hgv (u-t) hs
    have hm := Nat.le_max_right a b
    omega

omit [Inhabited Λ] in

theorem Trace.runs_visited {q : ℕ} {M : TM0.Machine Symbol (Fin (q+1))}
    {input output : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits} {last : TM0.Cfg Symbol (Fin (q+1))} {ticks time space : ℕ}
    (h : Trace M (TM0.init (input.map some)) last ticks 0)
    (hi : input.length≤space) (ht : ticks≤time) (hv : Visits M (TM0.init (input.map some)) ticks space)
    (hh : TM0.step M last=none) (ho : last.Tape=Tape.mk₁ (output.map some)) :
    Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Runs M input output time space := by
  refine ⟨hi,ticks,last,ht,?_,hh,?_,?_,?_,?_⟩
  · simpa only [run_initial] using h.reached
  · rw [headPosition_eq_offset]
    exact h.offset_eq
  · intro i
    rw [ho]
    simp [Tape.mk₁,Tape.mk₂,ListBlank.nth_mk,List.getI_eq_getElem?_getD,show (default : Symbol)=none from rfl]
  · intro i
    rw [ho]
    rfl
  · intro u hu
    rw [headPosition_eq_offset]
    exact hv u hu
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.Stacks
open Turing Turing.TM2to1
variable {K : Type} [DecidableEq K] [Fintype K] {Γ : K → Type} [∀ k, Fintype (Γ k)]
    {Λ σ : Type} [Inhabited Λ] [Fintype Λ] [Inhabited σ] [Fintype σ]
    {width : ℕ} (enc : Γ' K Γ → List.Vector Bool width) (dec : List.Vector Bool width → Γ' K Γ)
    (enc0 : enc default=List.Vector.replicate width false)
    (M : Λ → TM2.Stmt Γ Λ σ)

def stackRunMaxClock (M : Λ → TM2.Stmt Γ Λ σ) : ℕ → TM2.Cfg Γ Λ σ → ℕ
  | 0,_ => 0
  | n+1,c => match TM2.step M c with
    | none => 0
    | some next => max (stackRunClock M 1 c) (stackRunMaxClock M n next)

omit [Fintype K] [∀ k, Fintype (Γ k)] [Inhabited Λ] [Fintype Λ] [Inhabited σ] [Fintype σ] in

theorem stackRunClock_step (n : ℕ) (first next : TM2.Cfg Γ Λ σ) (h : TM2.step M first=some next) :
    stackRunClock M (n+1) first=stackRunClock M 1 first+stackRunClock M n next := by
  rcases first with ⟨l,v,S⟩
  cases l with
  | none => simp only [TM2.step,reduceCtorEq] at h
  | some l => simp only [stackRunClock,h,Nat.add_zero]

theorem stack_physical_visits (encdec : ∀ a, dec (enc a)=a) (steps : ℕ)
    (first last : TM2.Cfg Γ Λ σ) (first' : TM1.Cfg (Γ' K Γ) (Λ' K Γ Λ σ) σ)
    (hf : TrCfg first first') (h : stackRun M steps first=some last) :
    ∃ last', TrCfg last last' ∧ ∃ ticks,
      ticks≤stackRunClock M steps first*stackFactor enc dec M ∧
      Trace (stackMachine enc dec M) (stackCfg enc dec enc0 M first')
        (stackCfg enc dec enc0 M last') ticks 0 ∧
      Visits (stackMachine enc dec M) (stackCfg enc dec enc0 M first') ticks
        (stackRunMaxClock M steps first*stackFactor enc dec M) := by
  induction steps generalizing first first' with
  | zero =>
    have he : first=last := Option.some.inj h
    subst last
    refine ⟨first',hf,0,Nat.zero_le _,Trace.refl _ _,?_⟩
    simpa only [stackRunMaxClock,Nat.zero_mul] using
        visits_of_clock (stackMachine enc dec M) (stackCfg enc dec enc0 M first') 0 0 le_rfl
  | succ n ih =>
    cases hs : TM2.step M first with
    | none => simp only [stackRun,hs,Option.bind_none,reduceCtorEq] at h
    | some next =>
      have hn : stackRun M n next=some last := by simpa only [stackRun,hs,Option.bind_some] using h
      have hstep : stackRun M 1 first=some next := by simp only [stackRun,hs,Option.bind_some]
      obtain ⟨mid,hm,t,hbt,ht⟩ :=
          stack_physical_execution enc dec enc0 M encdec 1 first next first' hf hstep
      obtain ⟨last',hl,s,hbs,hu,hv⟩ := ih next mid hm hn
      refine ⟨last',hl,t+s,?_,?_,?_⟩
      · rw [stackRunClock_step M n first next hs,Nat.add_mul]
        omega
      · simpa only [Int.zero_add] using ht.trans hu
      · have htv := visits_of_clock (stackMachine enc dec M) (stackCfg enc dec enc0 M first') t _ hbt
        have hall := Visits.trans_zero ht hu htv hv
        apply hall.mono
        simp only [stackRunMaxClock,hs]
        exact max_le (Nat.mul_le_mul_right _ (Nat.le_max_left _ _))
          (Nat.mul_le_mul_right _ (Nat.le_max_right _ _))
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.Stacks

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.Stacks
open Turing
variable {K : Type} [DecidableEq K] [Fintype K] {Γ : K → Type}
    {Λ σ : Type} [Fintype Λ]

noncomputable def stackHeight (S : ∀ k, List (Γ k)) : ℕ := Finset.univ.sup (fun k => (S k).length)
noncomputable def programNodes (M : Λ → TM2.Stmt Γ Λ σ) : ℕ :=
    Finset.univ.sup (fun l => stackNodes (M l))
noncomputable def sweepFactor (M : Λ → TM2.Stmt Γ Λ σ) : ℕ := 1+2*programNodes M*(programNodes M+1)

noncomputable def stackRunMaxHeight (M : Λ → TM2.Stmt Γ Λ σ) : ℕ → TM2.Cfg Γ Λ σ → ℕ
  | 0,c => stackHeight c.stk
  | n+1,c => match TM2.step M c with
    | none => stackHeight c.stk
    | some next => max (stackHeight c.stk) (stackRunMaxHeight M n next)

theorem stepClock_height (M : Λ → TM2.Stmt Γ Λ σ) (first : TM2.Cfg Γ Λ σ) :
    stackRunClock M 1 first≤sweepFactor M*(stackHeight first.stk+1) := by
  rcases first with ⟨l,v,S⟩
  cases l with
  | none => simp [stackRunClock,TM2.step]
  | some l =>
    have hnodes : stackNodes (M l)≤programNodes M := by
      unfold programNodes
      exact Finset.le_sup (f:=fun l => stackNodes (M l)) (Finset.mem_univ l)
    have hS : ∀ k, (S k).length≤stackHeight S := by
      intro k
      unfold stackHeight
      exact Finset.le_sup (f:=fun k => (S k).length) (Finset.mem_univ k)
    have hb := stackClock_bound (M l) v S (stackHeight S) hS
    have hm : 2*stackNodes (M l)*(stackHeight S+stackNodes (M l)+1)≤
        2*programNodes M*(stackHeight S+programNodes M+1) :=
      Nat.mul_le_mul (Nat.mul_le_mul_left 2 hnodes) (by omega)
    simp only [stackRunClock,TM2.step,Nat.add_zero]
    dsimp only [sweepFactor]
    nlinarith [Nat.zero_le (programNodes M*programNodes M*stackHeight S)]

theorem maxClock_height (M : Λ → TM2.Stmt Γ Λ σ) (n : ℕ) (first : TM2.Cfg Γ Λ σ) :
    stackRunMaxClock M n first≤sweepFactor M*(stackRunMaxHeight M n first+1) := by
  induction n generalizing first with
  | zero => exact Nat.zero_le _
  | succ n ih =>
    cases hs : TM2.step M first with
    | none => simp [stackRunMaxClock,hs]
    | some next =>
      simp only [stackRunMaxClock,stackRunMaxHeight,hs]
      apply max_le
      · exact (stepClock_height M first).trans (Nat.mul_le_mul_left _
          (Nat.succ_le_succ (Nat.le_max_left _ _)))
      · exact (ih next).trans (Nat.mul_le_mul_left _
          (Nat.succ_le_succ (Nat.le_max_right _ _)))
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.Stacks

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM
open Turing
variable {a b : ℕ} {M : TM0.Machine Symbol (Fin (a+1))} {N : TM0.Machine Symbol (Fin (b+1))}

theorem Visits.first {cfg last : TM0.Cfg Symbol (Fin (a+1))} {ticks space : ℕ} {d : ℤ}
    (hv : Visits M cfg ticks space) (ht : Trace M cfg last ticks d) :
    Visits (composeMachine M N) (firstCfg cfg) ticks space := by
  intro u hu
  obtain ⟨mid,hm⟩ := run_prefix M cfg last ticks ht.reached u hu
  obtain ⟨_,ho⟩ := compose_first_run M N cfg mid u hm
  rw [ho]
  exact hv u hu

theorem Visits.second {cfg last : TM0.Cfg Symbol (Fin (b+1))} {ticks space : ℕ} {d : ℤ}
    (hv : Visits N cfg ticks space) (ht : Trace N cfg last ticks d) :
    Visits (composeMachine M N) (secondCfg cfg) ticks space := by
  intro u hu
  obtain ⟨mid,hm⟩ := run_prefix N cfg last ticks ht.reached u hu
  obtain ⟨_,ho⟩ := compose_second_run M N cfg mid u hm
  rw [ho]
  exact hv u hu

theorem Visits.then_init {input middle : List Symbol}
    {cf : TM0.Cfg Symbol (Fin (a+1))} {cg : TM0.Cfg Symbol (Fin (b+1))} {t s sf sg : ℕ}
    (hf : Trace M (TM0.init input) cf t 0) (hstop : TM0.step M cf=none)
    (htape : cf.Tape=Tape.mk₁ middle) (hg : Trace N (TM0.init middle) cg s 0)
    (hfv : Visits M (TM0.init input) t sf) (hgv : Visits N (TM0.init middle) s sg) :
    Visits (composeMachine M N) (TM0.init input) (t+1+s) (max (max sf 1) sg) := by
  obtain ⟨hfr,hfo⟩ := compose_first_run M N _ cf t hf.reached
  have hfirst : Trace (composeMachine M N) (TM0.init input) (firstCfg cf) t 0 :=
    ⟨hfr,hfo.trans hf.offset_eq⟩
  have hbridge : Trace (composeMachine M N) (firstCfg cf) (secondCfg (TM0.init middle)) 1 0 := by
    apply Trace.one
    · rw [compose_first,hstop]
      change some (secondCfg (TM0.Cfg.mk 0 cf.Tape))=_
      rw [htape]
      rfl
    · rw [compose_first_offset]
      unfold TM0.step at hstop
      have he : M cf.q cf.Tape.head=none := Option.map_eq_none_iff.mp hstop
      simp only [nextOffset,he]
  obtain ⟨hgr,hgo⟩ := compose_second_run M N _ cg s hg.reached
  have hlast : Trace (composeMachine M N) (secondCfg (TM0.init middle)) (secondCfg cg) s 0 :=
    ⟨hgr,hgo.trans hg.offset_eq⟩
  have hprefix : Trace (composeMachine M N) (TM0.init input) (secondCfg (TM0.init middle)) (t+1) 0 := by
    simpa only [Int.zero_add] using hfirst.trans hbridge
  have hvbridge := visits_of_clock (composeMachine M N) (firstCfg cf) 1 1 le_rfl
  have hvfirst : Visits (composeMachine M N) (TM0.init input) t sf := hfv.first hf
  have hvlast : Visits (composeMachine M N) (secondCfg (TM0.init middle)) s sg := hgv.second hg
  exact Visits.trans_zero hprefix hlast (Visits.trans_zero hfirst hbridge hvfirst hvbridge) hvlast
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.Stacks
open Turing Turing.TM2to1
variable {K Λ σ : Type} [DecidableEq K] [Fintype K] [Inhabited Λ] [Fintype Λ] [Inhabited σ] [Fintype σ]
    {extra : ℕ} (enc : BitAlphabet K → List.Vector Bool (extra+1))
    (dec : List.Vector Bool (extra+1) → BitAlphabet K)
    (enc0 : enc default=List.Vector.replicate (extra+1) false)
    (encdec : ∀ a, dec (enc a)=a) (M : Λ → TM2.Stmt (fun _ : K => Bool) Λ σ)

include enc0 encdec in

theorem physical_raw_tapes_visited (inputStack outputStack : K) (input output : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits)
    (steps : ℕ) (v : σ)
    (h : stackRun M steps (TM2.init inputStack input.reverse)=
      some ⟨none,v,Function.update (fun _ => []) outputStack output.reverse⟩) :
    ∃ ticks last,
      ticks≤stackRunClock M steps (TM2.init inputStack input.reverse)*stackFactor enc dec M ∧
      Trace (stackMachine enc dec M)
        (TM0.init (Cleanup.inputCells (inputCode enc inputStack false) (inputCode enc inputStack true) (emptyCode enc) input))
        last ticks 0 ∧ TM0.step (stackMachine enc dec M) last=none ∧
      last.Tape=Tape.mk₁ (Cleanup.inputCells (inputCode enc outputStack false) (inputCode enc outputStack true) (emptyCode enc) output) ∧
      Visits (stackMachine enc dec M)
        (TM0.init (Cleanup.inputCells (inputCode enc inputStack false) (inputCode enc inputStack true) (emptyCode enc) input))
        ticks (stackRunMaxClock M steps (TM2.init inputStack input.reverse)*stackFactor enc dec M) := by
  obtain ⟨last,hr,ticks,hb,ht,hv⟩ := stack_physical_visits enc dec enc0 M encdec steps _ _
    (TM1.init (trInit inputStack input.reverse))
    (trCfg_init (Γ:=fun _ : K => Bool) (Λ:=Λ) (σ:=σ) inputStack input.reverse) h
  have he : last=⟨none,v,Tape.mk₁ (trInit outputStack output.reverse)⟩ :=
    trCfg_unique hr (trCfg_single outputStack output.reverse none v)
  rw [stackCfg_init] at ht hv
  refine ⟨ticks,stackCfg enc dec enc0 M last,hb,ht,?_,?_,hv⟩
  · apply stackCfg_halt
    rw [he]
  · rw [he,stackCfg_tape,Alphabet.encodedTape_mk₁,encoded_trInit]
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.Stacks

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.Stacks
open Turing Turing.TM2to1
variable {K Λ σ : Type} [DecidableEq K] [Fintype K] [Inhabited Λ] [Fintype Λ]
    [Inhabited σ] [Fintype σ]
set_option maxHeartbeats 2000000 in

theorem raw_compiler_separate (M : Λ → TM2.Stmt (fun _ : K => Bool) Λ σ) (inputStack outputStack : K) :
    ∃ (q : ℕ) (N : TM0.Machine Symbol (Fin (q+1))) (C : ℕ), 0<C ∧
      ∀ (input output : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (steps : ℕ) (v : σ),
        stackRun M steps (TM2.init inputStack input.reverse)=
          some ⟨none,v,Function.update (fun _ => []) outputStack output.reverse⟩ →
        Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Runs N input output
          (C*((1+input.length)^2+stackRunClock M steps (TM2.init inputStack input.reverse)+(1+output.length)^2))
          (C*((1+input.length)^2+stackRunMaxClock M steps (TM2.init inputStack input.reverse)+(1+output.length)^2)) := by
  classical
  obtain ⟨extra,enc,dec,h0,hinv,hmarker⟩ := Alphabet.exists_marked_codec (BitAlphabet K)
  let first := inputCode enc inputStack true
  let later := inputCode enc inputStack false
  let empty := emptyCode enc
  let bottom := bottomDecode dec
  let decode := outputDecode dec outputStack
  let FP := Expansion.program (first false) (first true) (later false) (later true) empty bottom
  let F := tm1Machine FP
  let P := stackMachine enc dec M
  let G := tm1Machine (Cleanup.program decode)
  let a := (tm1Support FP).card
  let b := (tm1Support (restrictedProgram (Alphabet.controlSupport (finiteSource M))
    (Alphabet.physicalProgram enc dec (finiteSource M)))).card
  let c := (tm1Support (Cleanup.program decode)).card
  let N := @composeMachine ((a+1)+b) c (@composeMachine a b F P) G
  let CF :=
      Expansion.budgetFactor (first false) (first true) (later false) (later true) empty bottom
  let CP := stackFactor enc dec M
  let CG := Cleanup.budgetFactor decode
  let C := CF+CP+CG+2
  refine ⟨_,N,C,by dsimp [C]; omega,?_⟩
  intro input output steps v h
  have hfirst : ∀ b, bottom (Expansion.outputCode (first false) (first true) (later false) (later true) (b,true))=true := by
    intro b
    cases b <;> exact bottomDecode_cell enc dec hinv inputStack true _
  have hlater : ∀ b, bottom (Expansion.outputCode (first false) (first true) (later false) (later true) (b,false))=false := by
    intro b
    cases b <;> exact bottomDecode_cell enc dec hinv inputStack false _
  obtain ⟨t,cf,hft,hf,hfstop,hftape⟩ := Expansion.physical_frontend
    (first false) (first true) (later false) (later true) empty bottom input hfirst hlater
  obtain ⟨u,cp,hpt,hp,hpstop,hptape,hpv⟩ :=
      physical_raw_tapes_visited enc dec h0 hinv M inputStack outputStack input output steps v h
  rw [← Cleanup.inputCells_expansion later first empty input] at hftape
  have hfp := hf.then_init hfstop hftape hp
  have hfpstop : TM0.step (composeMachine F P) (secondCfg cp)=none := by
    rw [compose_second,hpstop]
    rfl
  obtain ⟨s,cg,hgt,hg,hgstop,hgtape⟩ := Cleanup.physical_cleanup decode
    (inputCode enc outputStack false) (inputCode enc outputStack true) empty output
    (outputDecode_blank enc dec h0 hinv outputStack) (outputDecode_empty enc dec hinv outputStack)
    (outputDecode_cell enc dec hinv outputStack true) (outputDecode_cell enc dec hinv outputStack false)
    (inputCode_head enc hmarker outputStack false)
  have hall := hfp.then_init hfpstop hptape hg
  let B :=
      (1+input.length)^2+stackRunClock M steps
      (TM2.init inputStack input.reverse)+(1+output.length)^2
  have hB : 1≤B := by
    have hi : 1+input.length≤(1+input.length)^2 := Nat.le_pow (by decide)
    dsimp [B]
    omega
  have hi : (1+input.length)^2≤B := by dsimp [B]; omega
  have hpB : stackRunClock M steps (TM2.init inputStack input.reverse)≤B := by dsimp [B]; omega
  have ho : (1+output.length)^2≤B := by dsimp [B]; omega
  have ht : t≤CF*B := hft.trans (Nat.mul_le_mul_left CF hi)
  have hu : u≤CP*B := by
    rw [Nat.mul_comm] at hpt
    exact hpt.trans (Nat.mul_le_mul_left CP hpB)
  have hs : s≤CG*B := hgt.trans (Nat.mul_le_mul_left CG ho)
  have hclock : t+1+u+1+s≤C*B := by
    calc
      t+1+u+1+s ≤ CF*B+CP*B+CG*B+2*B := by omega
      _ = C*B := by dsimp [C]; ring
  let S :=
      (1+input.length)^2+stackRunMaxClock M steps
      (TM2.init inputStack input.reverse)+(1+output.length)^2
  have hiS : (1+input.length)^2≤S := by dsimp [S]; omega
  have hpS : stackRunMaxClock M steps (TM2.init inputStack input.reverse)≤S := by dsimp [S]; omega
  have hoS : (1+output.length)^2≤S := by dsimp [S]; omega
  have hC : 0<C := by dsimp [C]; omega
  have hS : 1≤S := by
    have hI : 1+input.length≤(1+input.length)^2 := Nat.le_pow (by decide)
    omega
  have hfv := visits_of_clock (tm1Machine FP) (TM0.init (input.map some)) t _ hft
  have hgv := visits_of_clock (tm1Machine (Cleanup.program decode))
    (TM0.init (Cleanup.inputCells (inputCode enc outputStack false) (inputCode enc outputStack true) empty output)) s _ hgt
  have hfpv := Visits.then_init hf hfstop hftape hp hfv hpv
  have hallv := Visits.then_init hfp hfpstop hptape hg hfpv hgv
  have hfs : CF*(1+input.length)^2≤C*S := Nat.mul_le_mul (by dsimp [C]; omega) hiS
  have hps : stackRunMaxClock M steps (TM2.init inputStack input.reverse)*stackFactor enc dec M≤C*S := by
    rw [Nat.mul_comm]
    exact Nat.mul_le_mul (show CP≤C by dsimp [C]; omega) hpS
  have hgs : CG*(1+output.length)^2≤C*S := Nat.mul_le_mul (by dsimp [C]; omega) hoS
  have hbridge : 1≤C*S := by nlinarith
  apply hall.runs_visited
  · have hL : input.length≤(1+input.length)^2 := by
      have hi : 1+input.length≤(1+input.length)^2 := Nat.le_pow (by decide)
      omega
    have hIS : input.length≤S := hL.trans hiS
    nlinarith
  · exact hclock
  · exact hallv.mono (max_le (max_le (max_le (max_le hfs hbridge) hps) hbridge) hgs)
  · rw [compose_second,hgstop]
    rfl
  · exact hgtape
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.Stacks

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.Counter
open Turing

theorem bits_length_le (n : ℕ) : n.bits.length≤n := by
  induction n using Nat.binaryRec' with
  | zero => rfl
  | bit b n h ih =>
    rw [Nat.bits_append_bit n b h,List.length_cons]
    cases b with
    | false =>
      have hn : 0<n := by
        by_contra he
        have hz : n=0 := by omega
        have hf := h hz
        contradiction
      simp only [Nat.bit_false]
      omega
    | true => simp only [Nat.bit_true]; omega

theorem bits_length_sq_le (n : ℕ) : n.bits.length^2≤4*n := by
  induction n using Nat.binaryRec' with
  | zero => rfl
  | bit b n h ih =>
    rw [Nat.bits_append_bit n b h,List.length_cons]
    have hl := bits_length_le n
    cases b with
    | false =>
      have hn : 0<n := by
        by_contra he
        have hz : n=0 := by omega
        have hf := h hz
        contradiction
      simp only [Nat.bit_false]
      nlinarith
    | true => simp only [Nat.bit_true]; nlinarith

inductive Label where | borrow | restore deriving DecidableEq,Fintype
instance : Inhabited Label := ⟨.borrow⟩
abbrev Local := Bool×Option Bool

def program : Label → TM2.Stmt (fun _ : Fin 2 => Bool) Label Local
  | .borrow => .pop 0 (fun s bit => (s.1,bit))
      (.branch (fun s => s.2.isSome)
        (.branch (fun s => s.2.getD false)
          (.push 1 (fun _ => false) (.load (fun s => (true,s.2)) (.goto (fun _ => .restore))))
          (.push 1 (fun _ => true) (.goto (fun _ => .borrow))))
        (.load (fun s => (false,s.2)) (.goto (fun _ => .restore))))
  | .restore => .pop 1 (fun s bit => (s.1,bit))
      (.branch (fun s => s.2.isSome)
        (.push 0 (fun s => s.2.getD false) (.goto (fun _ => .restore))) .halt)

theorem borrow_false (rest temp : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (v : Local) :
    TM2.step program ⟨some .borrow,v,Stacks.stackPair (false::rest) temp⟩=
      some ⟨some .borrow,(v.1,some false),Stacks.stackPair rest (true::temp)⟩ := by
  simp [TM2.step,program,TM2.stepAux]

theorem borrow_true (rest temp : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (v : Local) :
    TM2.step program ⟨some .borrow,v,Stacks.stackPair (true::rest) temp⟩=
      some ⟨some .restore,(true,some true),Stacks.stackPair rest (false::temp)⟩ := by
  simp [TM2.step,program,TM2.stepAux]

theorem borrow_empty (temp : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (v : Local) :
    TM2.step program ⟨some .borrow,v,Stacks.stackPair [] temp⟩=
      some ⟨some .restore,(false,none),Stacks.stackPair [] temp⟩ := by
  simp [TM2.step,program,TM2.stepAux]

theorem restore_run (counter temp : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (flag : Bool) (saved : Option Bool) :
    Stacks.stackRun program (temp.length+1) ⟨some .restore,(flag,saved),Stacks.stackPair counter temp⟩=
      some ⟨none,(flag,none),Stacks.stackPair (temp.reverse++counter) []⟩ := by
  induction temp generalizing counter saved with
  | nil => simp [Stacks.stackRun,TM2.step,program,TM2.stepAux]
  | cons b temp ih =>
    have hs : TM2.step program ⟨some .restore,(flag,saved),Stacks.stackPair counter (b::temp)⟩=
        some ⟨some .restore,(flag,some b),Stacks.stackPair (b::counter) temp⟩ := by
      simp [TM2.step,program,TM2.stepAux]
    simpa only [List.length_cons,Stacks.stackRun,hs,Option.bind_some,List.reverse_cons,
      List.append_assoc,List.singleton_append] using ih (b::counter) (some b)

theorem decrement_run (zeros : ℕ) (rest temp : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (v : Local) :
    Stacks.stackRun program (2*zeros+temp.length+3)
      ⟨some .borrow,v,Stacks.stackPair (List.replicate zeros false++true::rest) temp⟩=
      some ⟨none,(true,none),Stacks.stackPair (temp.reverse++List.replicate zeros true++false::rest) []⟩ := by
  induction zeros generalizing temp v with
  | zero =>
    have ht := restore_run rest (false::temp) true (some true)
    simpa only [Nat.mul_zero,Nat.zero_add,List.replicate_zero,List.nil_append,List.length_cons,Stacks.stackRun,
      borrow_true,Option.bind_some,List.reverse_cons,List.append_assoc,List.singleton_append] using ht
  | succ zeros ih =>
    have ht := ih (true::temp) (v.1,some false)
    have hn : 2*(zeros+1)+temp.length+3=(2*zeros+(true::temp).length+3)+1 := by simp; omega
    rw [hn]
    simp only [Stacks.stackRun,List.replicate_succ,List.cons_append,borrow_false,Option.bind_some]
    convert! ht using 1
    simp [List.reverse_cons,List.append_assoc]

theorem underflow_run (zeros : ℕ) (temp : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (v : Local) :
    Stacks.stackRun program (2*zeros+temp.length+2)
      ⟨some .borrow,v,Stacks.stackPair (List.replicate zeros false) temp⟩=
      some ⟨none,(false,none),Stacks.stackPair (temp.reverse++List.replicate zeros true) []⟩ := by
  induction zeros generalizing temp v with
  | zero =>
    have ht := restore_run [] temp false none
    simpa only [Nat.mul_zero,Nat.zero_add,List.replicate_zero,Stacks.stackRun,borrow_empty,Option.bind_some,
      List.append_nil] using ht
  | succ zeros ih =>
    have ht := ih (true::temp) (v.1,some false)
    have hn : 2*(zeros+1)+temp.length+2=(2*zeros+(true::temp).length+2)+1 := by simp; omega
    rw [hn]
    simp only [Stacks.stackRun,List.replicate_succ,borrow_false,Option.bind_some]
    convert! ht using 1
    simp [List.reverse_cons,List.append_assoc]

theorem decrement_value (zeros : ℕ) (rest : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) :
    Qatlib.Concepts.BitWordCompiler.CanonicalCodec.binaryValue (List.replicate zeros false++true::rest)=
      Qatlib.Concepts.BitWordCompiler.CanonicalCodec.binaryValue (List.replicate zeros true++false::rest)+1 := by
  induction zeros with
  | zero => simp [Qatlib.Concepts.BitWordCompiler.CanonicalCodec.binaryValue]
  | succ zeros ih =>
    simp only [List.replicate_succ,List.cons_append,Qatlib.Concepts.BitWordCompiler.CanonicalCodec.binaryValue,List.foldr_cons,
      Bool.false_eq_true,if_false,if_true] at ih ⊢
    omega

theorem restore_clock (counter temp : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (flag : Bool) (saved : Option Bool) :
    Stacks.stackRunClock program (temp.length+1) ⟨some .restore,(flag,saved),Stacks.stackPair counter temp⟩=
      temp.length*(2*(temp.length+counter.length)+5)+3 := by
  induction temp generalizing counter saved with
  | nil => simp [Stacks.stackRunClock,program,Stacks.stackClock]
  | cons b temp ih =>
    have hs : TM2.step program ⟨some .restore,(flag,saved),Stacks.stackPair counter (b::temp)⟩=
        some ⟨some .restore,(flag,some b),Stacks.stackPair (b::counter) temp⟩ := by
      simp [TM2.step,program,TM2.stepAux]
    rw [Stacks.stackRunClock,hs]
    change 1+Stacks.stackClock (program .restore) (flag,saved) (Stacks.stackPair counter (b::temp))+
      Stacks.stackRunClock program (temp.length+1) ⟨some .restore,(flag,some b),Stacks.stackPair (b::counter) temp⟩=_
    rw [ih]
    simp only [program,Stacks.stackClock,Stacks.stackPair_one,Stacks.stackPair_update_one,
      List.head?_cons,List.tail_cons,Option.isSome_some,if_true,Stacks.stackPair_zero,List.length_cons]
    nlinarith

theorem decrement_clock (zeros : ℕ) (rest temp : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (v : Local) :
    Stacks.stackRunClock program (2*zeros+temp.length+3)
      ⟨some .borrow,v,Stacks.stackPair (List.replicate zeros false++true::rest) temp⟩=
      (2*zeros+temp.length+2)*(2*(zeros+1+rest.length+temp.length)+5)+3 := by
  induction zeros generalizing temp v with
  | zero =>
    simp only [Nat.mul_zero,Nat.zero_add,List.replicate_zero,List.nil_append]
    rw [Stacks.stackRunClock,borrow_true]
    change 1+Stacks.stackClock (program .borrow) v (Stacks.stackPair (true::rest) temp)+
      Stacks.stackRunClock program ((false::temp).length+1) ⟨some .restore,(true,some true),Stacks.stackPair rest (false::temp)⟩=_
    rw [restore_clock]
    simp [program,Stacks.stackClock]
    ring
  | succ zeros ih =>
    have hn : 2*(zeros+1)+temp.length+3=(2*zeros+(true::temp).length+3)+1 := by simp; omega
    simp only [List.replicate_succ,List.cons_append]
    rw [hn,Stacks.stackRunClock,borrow_false]
    change 1+Stacks.stackClock (program .borrow) v (Stacks.stackPair
        (false::(List.replicate zeros false++true::rest)) temp)+
      Stacks.stackRunClock program (2*zeros+(true::temp).length+3)
        ⟨some .borrow,(v.1,some false),Stacks.stackPair (List.replicate zeros false++true::rest) (true::temp)⟩=_
    rw [ih]
    simp [program,Stacks.stackClock]
    ring

theorem underflow_clock (zeros : ℕ) (temp : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (v : Local) :
    Stacks.stackRunClock program (2*zeros+temp.length+2)
      ⟨some .borrow,v,Stacks.stackPair (List.replicate zeros false) temp⟩=
      (2*zeros+temp.length)*(2*(zeros+temp.length)+5)+6 := by
  induction zeros generalizing temp v with
  | zero =>
    simp only [Nat.mul_zero,Nat.zero_add,List.replicate_zero]
    rw [Stacks.stackRunClock,borrow_empty]
    change 1+Stacks.stackClock (program .borrow) v (Stacks.stackPair [] temp)+
      Stacks.stackRunClock program (temp.length+1) ⟨some .restore,(false,none),Stacks.stackPair [] temp⟩=_
    rw [restore_clock]
    simp [program,Stacks.stackClock]
    ring
  | succ zeros ih =>
    have hn : 2*(zeros+1)+temp.length+2=(2*zeros+(true::temp).length+2)+1 := by simp; omega
    simp only [List.replicate_succ]
    rw [hn,Stacks.stackRunClock,borrow_false]
    change 1+Stacks.stackClock (program .borrow) v (Stacks.stackPair (false::List.replicate zeros false) temp)+
      Stacks.stackRunClock program (2*zeros+(true::temp).length+2)
        ⟨some .borrow,(v.1,some false),Stacks.stackPair (List.replicate zeros false) (true::temp)⟩=_
    rw [ih]
    simp [program,Stacks.stackClock]
    ring

theorem positive_split (bits : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (hp : 0<Qatlib.Concepts.BitWordCompiler.CanonicalCodec.binaryValue bits) :
    ∃ zeros rest, bits=List.replicate zeros false++true::rest := by
  induction bits with
  | nil => simp [Qatlib.Concepts.BitWordCompiler.CanonicalCodec.binaryValue] at hp
  | cons bit rest ih =>
    cases bit with
    | true => exact ⟨0,rest,rfl⟩
    | false =>
      have hrest : 0<Qatlib.Concepts.BitWordCompiler.CanonicalCodec.binaryValue rest := by
        simpa [Qatlib.Concepts.BitWordCompiler.CanonicalCodec.binaryValue] using hp
      obtain ⟨zeros,tail,he⟩ := ih hrest
      exact ⟨zeros+1,tail,by simp [List.replicate_succ,he]⟩

theorem zero_bits_shape (bits : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (h : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.binaryValue bits=0) :
    bits=List.replicate bits.length false := by
  induction bits with
  | nil => rfl
  | cons bit rest ih =>
    cases bit with
    | true => simp [Qatlib.Concepts.BitWordCompiler.CanonicalCodec.binaryValue] at h
    | false =>
      have hz : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.binaryValue rest=0 := by
        simpa [Qatlib.Concepts.BitWordCompiler.CanonicalCodec.binaryValue] using h
      simpa only [List.length_cons,List.replicate_succ] using congrArg (false::·) (ih hz)

theorem decrement_positive (input : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (v : Local) (hp : 0<Qatlib.Concepts.BitWordCompiler.CanonicalCodec.binaryValue input) :
    ∃ (ticks : ℕ) (output : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits), ticks≤2*input.length+3 ∧ output.length=input.length ∧
      Qatlib.Concepts.BitWordCompiler.CanonicalCodec.binaryValue output+1=Qatlib.Concepts.BitWordCompiler.CanonicalCodec.binaryValue input ∧
      Stacks.stackRun program ticks ⟨some .borrow,v,Stacks.stackPair input []⟩=
        some ⟨none,(true,none),Stacks.stackPair output []⟩ ∧
      Stacks.stackRunClock program ticks ⟨some .borrow,v,Stacks.stackPair input []⟩≤10*(1+input.length)^2 := by
  obtain ⟨zeros,rest,rfl⟩ := positive_split input hp
  refine ⟨2*zeros+3,List.replicate zeros true++false::rest,?_,?_,(decrement_value zeros rest).symm,?_,?_⟩
  · simp only [List.length_append,List.length_replicate,List.length_cons]
    omega
  · simp
  · simpa only [List.length_nil,Nat.add_zero,List.reverse_nil,List.nil_append] using
      decrement_run zeros rest [] v
  · have hc := decrement_clock zeros rest [] v
    simp only [List.length_nil,Nat.add_zero,List.length_append,List.length_replicate,List.length_cons] at hc ⊢
    rw [hc]
    have hm : 2*zeros+2≤2*(zeros+(rest.length+1)) := by omega
    have hmul := Nat.mul_le_mul_right (2*(zeros+(rest.length+1))+5) hm
    nlinarith

theorem decrement_zero (input : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (v : Local) (hz : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.binaryValue input=0) :
    Stacks.stackRun program (2*input.length+2) ⟨some .borrow,v,Stacks.stackPair input []⟩=
      some ⟨none,(false,none),Stacks.stackPair (List.replicate input.length true) []⟩ ∧
    Stacks.stackRunClock program (2*input.length+2) ⟨some .borrow,v,Stacks.stackPair input []⟩≤10*(1+input.length)^2 := by
  have he := zero_bits_shape input hz
  constructor
  · have hr := underflow_run input.length [] v
    simpa only [List.length_nil,Nat.add_zero,List.reverse_nil,List.nil_append,← he] using hr
  · have hc := underflow_clock input.length [] v
    simp only [List.length_nil,Nat.add_zero,← he] at hc
    rw [hc]
    nlinarith [Nat.zero_le (input.length*input.length)]

theorem repeated_counter_budget (n : ℕ) : n*(10*(1+n.bits.length)^2)≤100*(1+n)^2 := by
  have hs := Nat.mul_le_mul_left n (bits_length_sq_le n)
  have hl := Nat.mul_le_mul_left n (bits_length_le n)
  nlinarith

theorem counterStack (bits : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) :
    Stacks.stackPair bits []=Function.update (fun _ : Fin 2 => []) 0 bits := by
  funext k
  simp [Stacks.stackPair,Function.update_apply]

theorem raw_decrement_machine :
    ∃ (q : ℕ) (M : TM0.Machine Symbol (Fin (q+1))) (C : ℕ), 0<C ∧
      ∀ input : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits, 0<Qatlib.Concepts.BitWordCompiler.CanonicalCodec.binaryValue input.reverse →
        ∃ output : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits, output.length=input.length ∧
          Qatlib.Concepts.BitWordCompiler.CanonicalCodec.binaryValue output.reverse+1=Qatlib.Concepts.BitWordCompiler.CanonicalCodec.binaryValue input.reverse ∧
          Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Runs M input output (C*(1+input.length)^2) (C*(1+input.length)^2) := by
  obtain ⟨q,M,C,hC,hM⟩ := Stacks.raw_compiler program 0 0
  refine ⟨q,M,12*C,Nat.mul_pos (by decide) hC,?_⟩
  intro input hp
  obtain ⟨steps,out,_,hlen,hvalue,hr,hclock⟩ := decrement_positive input.reverse default hp
  have hs : Stacks.stackRun program steps (TM2.init (0 : Fin 2) input.reverse)=
      some ⟨none,(true,none),Function.update (fun _ => []) (0 : Fin 2) out⟩ := by
    simpa only [TM2.init,← counterStack] using! hr
  have hphys :=
      hM input out.reverse steps (true,none) (by simpa only [List.reverse_reverse] using hs)
  refine ⟨out.reverse,?_,?_,?_⟩
  · simpa only [List.length_reverse] using hlen
  · simpa only [List.reverse_reverse] using hvalue
  · have hc : Stacks.stackRunClock program steps (TM2.init (0 : Fin 2) input.reverse)≤10*(1+input.length)^2 := by
      simpa only [TM2.init,← counterStack,List.length_reverse] using! hclock
    have hl : out.length=input.length := by simpa only [List.length_reverse] using hlen
    have hb : (1+input.length)^2+Stacks.stackRunClock program steps (TM2.init (0 : Fin 2) input.reverse)+
        (1+out.reverse.length)^2≤12*(1+input.length)^2 := by
      simp only [List.length_reverse,hl]
      omega
    have hm : C*((1+input.length)^2+Stacks.stackRunClock program steps (TM2.init (0 : Fin 2) input.reverse)+
        (1+out.reverse.length)^2)≤(12*C)*(1+input.length)^2 := by
      calc
        _ ≤ C*(12*(1+input.length)^2) := Nat.mul_le_mul_left C hb
        _ = _ := by ring
    exact runs_mono hphys hm hm
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.Counter

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.Simulation
open Turing
variable {Λ : Type}

def pack : List Symbol → Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits :=
    List.flatMap (fun a => [a.isSome,a.getD false])

def pushSymbol (k : Fin 2) (q : TM2.Stmt (fun _ : Fin 2 => Bool) Λ Symbol) :
    TM2.Stmt (fun _ : Fin 2 => Bool) Λ Symbol :=
  .push k (fun h => h.getD false) (.push k (fun h => h.isSome) q)

def popSymbol (k : Fin 2) (q : TM2.Stmt (fun _ : Fin 2 => Bool) Λ Symbol) :
    TM2.Stmt (fun _ : Fin 2 => Bool) Λ Symbol :=
  .pop k (fun _ tag => if tag.getD false then some false else none)
    (.pop k (fun h value => h.map (fun _ => value.getD false)) q)

def transition : Option (Λ×TM0.Stmt Symbol) → TM2.Stmt (fun _ : Fin 2 => Bool) Λ Symbol
  | none => .halt
  | some (l,.write b) => .load (fun _ => b) (.goto (fun _ => l))
  | some (l,.move .left) => pushSymbol 1 (popSymbol 0 (.goto (fun _ => l)))
  | some (l,.move .right) => pushSymbol 0 (popSymbol 1 (.goto (fun _ => l)))

def program [Inhabited Λ] (M : TM0.Machine Symbol Λ) (l : Λ) : TM2.Stmt (fun _ : Fin 2 => Bool) Λ Symbol :=
  .branch (fun h => h.isNone) (transition (M l none))
    (.branch (fun h => h.getD false) (transition (M l (some true))) (transition (M l (some false))))

def tape (left right : List Symbol) (head : Symbol) : Tape Symbol := Tape.mk₂ left (head::right)

def cfg (l : Λ) (left right : List Symbol) (head : Symbol) : TM2.Cfg (fun _ : Fin 2 => Bool) Λ Symbol :=
  ⟨some l,head,Stacks.stackPair (pack left) (pack right)⟩

theorem program_stepAux [Inhabited Λ] (M : TM0.Machine Symbol Λ) (l : Λ) (head : Symbol) (S : Fin 2 → List Bool) :
    TM2.stepAux (program M l) head S=TM2.stepAux (transition (M l head)) head S := by
  cases head with
  | none => rfl
  | some b => cases b <;> rfl

theorem program_clock [Inhabited Λ] (M : TM0.Machine Symbol Λ) (l : Λ) (head : Symbol) (S : Fin 2 → List Bool) :
    Stacks.stackClock (program M l) head S=Stacks.stackClock (transition (M l head)) head S := by
  cases head with
  | none => rfl
  | some b => cases b <;> rfl

theorem pushSymbol_step (k : Fin 2) (q : TM2.Stmt (fun _ : Fin 2 => Bool) Λ Symbol)
    (head : Symbol) (S : Fin 2 → List Bool) :
    TM2.stepAux (pushSymbol k q) head S=
      TM2.stepAux q head (Function.update S k (head.isSome::head.getD false::S k)) := by
  simp [pushSymbol,TM2.stepAux]

theorem popSymbol_step (k : Fin 2) (q : TM2.Stmt (fun _ : Fin 2 => Bool) Λ Symbol)
    (head : Symbol) (S : Fin 2 → List Bool) (a : Symbol) (rest : List Symbol)
    (h : S k=pack (a::rest)) :
    TM2.stepAux (popSymbol k q) head S=TM2.stepAux q a (Function.update S k (pack rest)) := by
  simp only [popSymbol,TM2.stepAux,h,pack,List.flatMap_cons,List.cons_append,List.nil_append,
    List.head?_cons,List.tail_cons,Function.update_self]
  cases a with
  | none => simp
  | some b => cases b <;> simp

theorem popSymbol_empty (k : Fin 2) (q : TM2.Stmt (fun _ : Fin 2 => Bool) Λ Symbol)
    (head : Symbol) (S : Fin 2 → List Bool) (h : S k=[]) :
    TM2.stepAux (popSymbol k q) head S=TM2.stepAux q none S := by
  simp only [popSymbol,TM2.stepAux,h, List.head?_nil,List.tail_nil,Function.update_self]
  rw [← h,Function.update_eq_self]
  simp

theorem push_left (q : TM2.Stmt (fun _ : Fin 2 => Bool) Λ Symbol)
    (left right : List Symbol) (head : Symbol) :
    TM2.stepAux (pushSymbol 0 q) head (Stacks.stackPair (pack left) (pack right))=
      TM2.stepAux q head (Stacks.stackPair (pack (head::left)) (pack right)) := by
  rw [pushSymbol_step]
  simp [pack]

theorem push_right (q : TM2.Stmt (fun _ : Fin 2 => Bool) Λ Symbol)
    (left right : List Symbol) (head : Symbol) :
    TM2.stepAux (pushSymbol 1 q) head (Stacks.stackPair (pack left) (pack right))=
      TM2.stepAux q head (Stacks.stackPair (pack left) (pack (head::right))) := by
  rw [pushSymbol_step]
  simp [pack]

theorem pop_left (q : TM2.Stmt (fun _ : Fin 2 => Bool) Λ Symbol)
    (left right : List Symbol) (head : Symbol) :
    TM2.stepAux (popSymbol 0 q) head (Stacks.stackPair (pack left) (pack right))=
      TM2.stepAux q left.headI (Stacks.stackPair (pack left.tail) (pack right)) := by
  cases left with
  | nil => exact popSymbol_empty 0 q head _ (by rfl)
  | cons a left =>
    rw [popSymbol_step 0 q head _ a left (by simp)]
    simp

theorem pop_right (q : TM2.Stmt (fun _ : Fin 2 => Bool) Λ Symbol)
    (left right : List Symbol) (head : Symbol) :
    TM2.stepAux (popSymbol 1 q) head (Stacks.stackPair (pack left) (pack right))=
      TM2.stepAux q right.headI (Stacks.stackPair (pack left) (pack right.tail)) := by
  cases right with
  | nil => exact popSymbol_empty 1 q head _ (by rfl)
  | cons a right =>
    rw [popSymbol_step 1 q head _ a right (by simp)]
    simp

theorem tape_move_left (left right : List Symbol) (head : Symbol) :
    (tape left right head).move .left=tape left.tail (head::right) left.headI := by
  simp [tape,Tape.mk₂,Tape.move_left_mk',ListBlank.cons_mk]

theorem tape_move_right (left right : List Symbol) (head : Symbol) :
    (tape left right head).move .right=tape (head::left) right.tail right.headI := by
  have hr : ListBlank.mk right=ListBlank.mk (right.headI::right.tail) := by
    simpa only [ListBlank.head_mk,ListBlank.tail_mk,ListBlank.cons_mk] using
      (ListBlank.cons_head_tail (ListBlank.mk right)).symm
  simp only [tape,Tape.mk₂,Tape.move_right_mk',ListBlank.head_mk,List.headI_cons,
    ListBlank.tail_mk,List.tail_cons,ListBlank.cons_mk]
  rw [hr]

theorem tape_write (left right : List Symbol) (head bit : Symbol) :
    (tape left right head).write bit=tape left right bit := by
  simp [tape,Tape.mk₂,Tape.write_mk',ListBlank.cons_mk]

theorem machine_step [Inhabited Λ] (M : TM0.Machine Symbol Λ) (l next : Λ)
    (left right : List Symbol) (head : Symbol) (stmt : TM0.Stmt Symbol)
    (h : M l head=some (next,stmt)) :
    ∃ left' right' head', TM2.step (program M) (cfg l left right head)=
        some (cfg next left' right' head') ∧
      tape left' right' head'=applyStmt stmt (tape left right head) ∧
      left'.length+right'.length≤left.length+right.length+1 ∧
      (left'.length : ℤ)≤max ((left.length : ℤ)+stmtOffset stmt) 0 ∧
      (right'.length : ℤ)≤max ((right.length : ℤ)-stmtOffset stmt) 0 := by
  have hs : TM2.step (program M) (cfg l left right head)=
      some (TM2.stepAux (transition (some (next,stmt))) head (Stacks.stackPair (pack left) (pack right))) := by
    simp only [TM2.step,cfg,program_stepAux,h]
  cases stmt with
  | write bit =>
    refine ⟨left,right,bit,hs,(tape_write left right head bit).symm,Nat.le_succ _,?_,?_⟩
    · simp [stmtOffset]
    · simp [stmtOffset]
  | move dir =>
    cases dir with
    | left =>
      refine ⟨left.tail,head::right,left.headI,?_,(tape_move_left left right head).symm,?_,?_,?_⟩
      · rw [hs]
        simp only [transition,push_right,pop_left,TM2.stepAux]
        rfl
      · simp only [List.length_cons,List.length_tail]
        omega
      · simp only [List.length_tail,stmtOffset]
        omega
      · simp only [List.length_cons,stmtOffset,Int.natCast_add,Int.natCast_one]
        omega
    | right =>
      refine ⟨head::left,right.tail,right.headI,?_,(tape_move_right left right head).symm,?_,?_,?_⟩
      · rw [hs]
        simp only [transition,push_left,pop_right,TM2.stepAux]
        rfl
      · simp only [List.length_cons,List.length_tail]
        omega
      · simp only [List.length_cons,stmtOffset,Int.natCast_add,Int.natCast_one]
        omega
      · simp only [List.length_tail,stmtOffset]
        omega

theorem stackRun_add [Inhabited Λ] (M : Λ → TM2.Stmt (fun _ : Fin 2 => Bool) Λ Symbol)
    (n m : ℕ) (first : TM2.Cfg (fun _ : Fin 2 => Bool) Λ Symbol) :
    Stacks.stackRun M (n+m) first=(Stacks.stackRun M n first).bind (Stacks.stackRun M m) := by
  induction n generalizing first with
  | zero => simp [Stacks.stackRun]
  | succ n ih =>
    rw [Nat.succ_add,Stacks.stackRun]
    cases hs : TM2.step M first with
    | none => simp only [Option.bind_none,Stacks.stackRun,hs]
    | some next => simpa only [Option.bind_some,Stacks.stackRun,hs] using ih next

theorem execution [Inhabited Λ] (M : TM0.Machine Symbol Λ) (n : ℕ)
    (first last : TM0.Cfg Symbol Λ) (left right : List Symbol)
    (hf : first.Tape=tape left right first.Tape.head) (h : run M n first=some last) :
    ∃ left' right', last.Tape=tape left' right' last.Tape.head ∧
      Stacks.stackRun (program M) n (cfg first.q left right first.Tape.head)=
        some (cfg last.q left' right' last.Tape.head) ∧
      left'.length+right'.length≤left.length+right.length+n := by
  induction n generalizing last with
  | zero =>
    have he : first=last := Option.some.inj h
    subst last
    exact ⟨left,right,hf,rfl,by omega⟩
  | succ n ih =>
    obtain ⟨mid,hm⟩ := run_prefix M first last (n+1) h n (by omega)
    obtain ⟨ls,rs,ht,hr,hsize⟩ := ih mid hm
    have hs : TM0.step M mid=some last := by simpa only [run_succ_last,hm,Option.bind_some] using h
    cases hop : M mid.q mid.Tape.head with
    | none => simp [TM0.step,hop] at hs
    | some p =>
      rcases p with ⟨next,stmt⟩
      obtain ⟨ls',rs',head',hstep,htape,hgrow,_,_⟩ :=
          machine_step M mid.q next ls rs mid.Tape.head stmt hop
      have he : (⟨next,applyStmt stmt mid.Tape⟩ : TM0.Cfg Symbol Λ)=last := by
        cases stmt <;> simpa [TM0.step,hop,applyStmt] using hs
      have hl : last.q=next := congrArg TM0.Cfg.q he.symm
      have hlast : last.Tape=applyStmt stmt mid.Tape := congrArg TM0.Cfg.Tape he.symm
      have hT : last.Tape=tape ls' rs' head' := by rw [hlast,ht]; exact htape.symm
      have hh : last.Tape.head=head' := by rw [hT]; rfl
      refine ⟨ls',rs',?_,?_,by omega⟩
      · simpa only [hh] using hT
      · rw [stackRun_add,hr,Option.bind_some]
        change TM2.step (program M) (cfg mid.q ls rs mid.Tape.head)=_
        simpa only [hl,hh] using hstep

theorem maxHeight_le (M : Λ → TM2.Stmt (fun _ : Fin 2 => Bool) Λ Symbol)
    (n : ℕ) (first : TM2.Cfg (fun _ : Fin 2 => Bool) Λ Symbol) (height : ℕ)
    (h : ∀ u, u≤n → ∀ c, Stacks.stackRun M u first=some c → Stacks.stackHeight c.stk≤height) :
    Stacks.stackRunMaxHeight M n first≤height := by
  induction n generalizing first with
  | zero => exact h 0 (by omega) first rfl
  | succ n ih =>
    have hf := h 0 (by omega) first rfl
    cases hs : TM2.step M first with
    | none => simpa only [Stacks.stackRunMaxHeight,hs] using hf
    | some next =>
      simp only [Stacks.stackRunMaxHeight,hs]
      refine max_le hf (ih next ?_)
      intro u hu c hc
      apply h (u+1) (by omega) c
      simpa only [Stacks.stackRun,hs,Option.bind_some] using hc

theorem totalClock_le (M : Λ → TM2.Stmt (fun _ : Fin 2 => Bool) Λ Symbol)
    (n : ℕ) (first : TM2.Cfg (fun _ : Fin 2 => Bool) Λ Symbol) :
    Stacks.stackRunClock M n first≤n*Stacks.stackRunMaxClock M n first := by
  induction n generalizing first with
  | zero => simp [Stacks.stackRunClock]
  | succ n ih =>
    cases hs : TM2.step M first with
    | none => simp [Stacks.stackRunClock,Stacks.stackRunMaxClock,hs]
    | some next =>
      rw [Stacks.stackRunClock_step M n first next hs]
      simp only [Stacks.stackRunMaxClock,hs]
      have ht := (ih next).trans (Nat.mul_le_mul_left n (Nat.le_max_right
        (Stacks.stackRunClock M 1 first) (Stacks.stackRunMaxClock M n next)))
      have hl := Nat.le_max_left (Stacks.stackRunClock M 1 first) (Stacks.stackRunMaxClock M n next)
      nlinarith

theorem pack_length (bits : List Symbol) : (pack bits).length=2*bits.length := by
  induction bits with
  | nil => rfl
  | cons a bits ih => simp [pack] at ih ⊢; omega

theorem cfg_height (l : Λ) (left right : List Symbol) (head : Symbol) :
    Stacks.stackHeight (cfg l left right head).stk≤2*(left.length+right.length) := by
  apply Finset.sup_le
  intro k _
  by_cases h : k=0 <;> simp only [cfg,Stacks.stackPair,h,if_true,if_false,pack_length] <;> omega

theorem transition_nodes (e : Option (Λ×TM0.Stmt Symbol)) : Stacks.stackNodes (transition e)≤4 := by
  cases e with
  | none => simp [transition,Stacks.stackNodes]
  | some p =>
    rcases p with ⟨l,s⟩
    cases s with
    | write b => simp [transition,Stacks.stackNodes]
    | move d => cases d <;> simp [transition,pushSymbol,popSymbol,Stacks.stackNodes]

theorem program_nodes [Inhabited Λ] [Fintype Λ] (M : TM0.Machine Symbol Λ) :
    Stacks.programNodes (program M)≤4 := by
  apply Finset.sup_le
  intro l _
  simp only [program,Stacks.stackNodes]
  exact max_le (transition_nodes _) (max_le (transition_nodes _) (transition_nodes _))

theorem program_sweepFactor [Inhabited Λ] [Fintype Λ] (M : TM0.Machine Symbol Λ) :
    Stacks.sweepFactor (program M)≤41 := by
  have hn := program_nodes M
  unfold Stacks.sweepFactor
  nlinarith

theorem execution_height [Inhabited Λ] [Fintype Λ] (M : TM0.Machine Symbol Λ) (n : ℕ)
    (first last : TM0.Cfg Symbol Λ) (left right : List Symbol)
    (hf : first.Tape=tape left right first.Tape.head) (h : run M n first=some last) :
    Stacks.stackRunMaxHeight (program M) n (cfg first.q left right first.Tape.head)≤
      2*(left.length+right.length+n) := by
  apply maxHeight_le
  intro u hu c hc
  obtain ⟨mid,hm⟩ := run_prefix M first last n h u hu
  obtain ⟨ls,rs,_,hs,hbound⟩ := execution M u first mid left right hf hm
  rw [hs] at hc
  cases Option.some.inj hc
  exact (cfg_height mid.q ls rs mid.Tape.head).trans (by omega)

theorem execution_clock [Inhabited Λ] [Fintype Λ] (M : TM0.Machine Symbol Λ) (n : ℕ)
    (first last : TM0.Cfg Symbol Λ) (left right : List Symbol)
    (hf : first.Tape=tape left right first.Tape.head) (h : run M n first=some last) :
    Stacks.stackRunClock (program M) n (cfg first.q left right first.Tape.head)≤
      n*(41*(2*(left.length+right.length+n)+1)) := by
  have htime := totalClock_le (program M) n (cfg first.q left right first.Tape.head)
  have hmax := Stacks.maxClock_height (program M) n (cfg first.q left right first.Tape.head)
  have hs := program_sweepFactor M
  have hh := execution_height M n first last left right hf h
  exact htime.trans (Nat.mul_le_mul_left n (hmax.trans
    (Nat.mul_le_mul hs (Nat.succ_le_succ hh))))

theorem execution_region [Inhabited Λ] (M : TM0.Machine Symbol Λ) (n : ℕ)
    (first last : TM0.Cfg Symbol Λ) (left right : List Symbol) (radius : ℕ)
    (hf : first.Tape=tape left right first.Tape.head) (h : run M n first=some last)
    (hv : Visits M first n radius) :
    ∃ left' right', last.Tape=tape left' right' last.Tape.head ∧
      Stacks.stackRun (program M) n (cfg first.q left right first.Tape.head)=
        some (cfg last.q left' right' last.Tape.head) ∧
      (left'.length : ℤ)≤offset M first n+radius+left.length ∧
      (right'.length : ℤ)≤radius-offset M first n+right.length := by
  induction n generalizing last with
  | zero =>
    have he : first=last := Option.some.inj h
    subst last
    exact ⟨left,right,hf,rfl,by simp [offset],by simp [offset]⟩
  | succ n ih =>
    obtain ⟨mid,hm⟩ := run_prefix M first last (n+1) h n (by omega)
    obtain ⟨ls,rs,ht,hr,hleft,hright⟩ := ih mid hm (fun u hu => hv u (by omega))
    have hs : TM0.step M mid=some last := by simpa only [run_succ_last,hm,Option.bind_some] using h
    cases hop : M mid.q mid.Tape.head with
    | none => simp [TM0.step,hop] at hs
    | some p =>
      rcases p with ⟨next,stmt⟩
      obtain ⟨ls',rs',head',hstep,htape,_,hlg,hrg⟩ :=
          machine_step M mid.q next ls rs mid.Tape.head stmt hop
      have he : (⟨next,applyStmt stmt mid.Tape⟩ : TM0.Cfg Symbol Λ)=last := by
        cases stmt <;> simpa [TM0.step,hop,applyStmt] using hs
      have hl : last.q=next := congrArg TM0.Cfg.q he.symm
      have hlast : last.Tape=applyStmt stmt mid.Tape := congrArg TM0.Cfg.Tape he.symm
      have hT : last.Tape=tape ls' rs' head' := by rw [hlast,ht]; exact htape.symm
      have hh : last.Tape.head=head' := by rw [hT]; rfl
      have hoff : offset M first (n+1)=offset M first n+stmtOffset stmt := by
        simp only [offset,hm,Option.elim_some,nextOffset,hop]
      have hb := hv (n+1) le_rfl
      refine ⟨ls',rs',by simpa only [hh] using hT,?_,?_,?_⟩
      · rw [stackRun_add,hr,Option.bind_some]
        change TM2.step (program M) (cfg mid.q ls rs mid.Tape.head)=_
        simpa only [hl,hh] using hstep
      · rw [hoff] at hb ⊢
        omega
      · rw [hoff] at hb ⊢
        omega

theorem execution_height_visited [Inhabited Λ] [Fintype Λ] (M : TM0.Machine Symbol Λ) (n : ℕ)
    (first last : TM0.Cfg Symbol Λ) (left right : List Symbol) (radius : ℕ)
    (hf : first.Tape=tape left right first.Tape.head) (h : run M n first=some last)
    (hv : Visits M first n radius) :
    Stacks.stackRunMaxHeight (program M) n (cfg first.q left right first.Tape.head)≤
      2*(2*radius+left.length+right.length) := by
  apply maxHeight_le
  intro u hu c hc
  obtain ⟨mid,hm⟩ := run_prefix M first last n h u hu
  obtain ⟨ls,rs,_,hs,hl,hr⟩ :=
      execution_region M u first mid left right radius hf hm (fun t ht => hv t (by omega))
  rw [hs] at hc
  cases Option.some.inj hc
  exact (cfg_height mid.q ls rs mid.Tape.head).trans (by omega)

theorem halt_step [Inhabited Λ] (M : TM0.Machine Symbol Λ) (l : Λ)
    (left right : List Symbol) (head : Symbol) (h : M l head=none) :
    TM2.step (program M) (cfg l left right head)=
      some ⟨none,head,Stacks.stackPair (pack left) (pack right)⟩ := by
  simp only [TM2.step,cfg,program_stepAux,h,transition,TM2.stepAux]

theorem halt_clock [Inhabited Λ] (M : TM0.Machine Symbol Λ) (l : Λ)
    (left right : List Symbol) (head : Symbol) (h : M l head=none) :
    Stacks.stackRunClock (program M) 1 (cfg l left right head)=1 := by
  rw [Stacks.stackRunClock,halt_step M l left right head h]
  change 1+Stacks.stackClock (program M l) head (Stacks.stackPair (pack left) (pack right))+0=1
  rw [program_clock,h]
  rfl

theorem stackClock_add (M : Λ → TM2.Stmt (fun _ : Fin 2 => Bool) Λ Symbol)
    (n m : ℕ) (first mid : TM2.Cfg (fun _ : Fin 2 => Bool) Λ Symbol)
    (h : Stacks.stackRun M n first=some mid) :
    Stacks.stackRunClock M (n+m) first=Stacks.stackRunClock M n first+Stacks.stackRunClock M m mid := by
  induction n generalizing first with
  | zero =>
    have he : first=mid := Option.some.inj h
    subst mid
    simp [Stacks.stackRunClock]
  | succ n ih =>
    cases hs : TM2.step M first with
    | none => simp [Stacks.stackRun,hs] at h
    | some next =>
      have hn : Stacks.stackRun M n next=some mid := by
        simpa only [Stacks.stackRun,hs,Option.bind_some] using h
      rw [Nat.succ_add,Stacks.stackRunClock_step M (n+m) first next hs,
        Stacks.stackRunClock_step M n first next hs,ih next hn,Nat.add_assoc]

theorem complete [Inhabited Λ] [Fintype Λ] (M : TM0.Machine Symbol Λ) (n : ℕ)
    (first last : TM0.Cfg Symbol Λ) (left right : List Symbol)
    (hf : first.Tape=tape left right first.Tape.head) (h : run M n first=some last)
    (hh : TM0.step M last=none) :
    ∃ ls rs, last.Tape=tape ls rs last.Tape.head ∧
      Stacks.stackRun (program M) (n+1) (cfg first.q left right first.Tape.head)=
        some ⟨none,last.Tape.head,Stacks.stackPair (pack ls) (pack rs)⟩ ∧
      Stacks.stackRunClock (program M) (n+1) (cfg first.q left right first.Tape.head)≤
        n*(41*(2*(left.length+right.length+n)+1))+1 := by
  obtain ⟨ls,rs,ht,hr,_⟩ := execution M n first last left right hf h
  have hhalt : M last.q last.Tape.head=none := Option.map_eq_none_iff.mp hh
  refine ⟨ls,rs,ht,?_,?_⟩
  · rw [stackRun_add,hr,Option.bind_some]
    simp only [Stacks.stackRun,halt_step M last.q ls rs last.Tape.head hhalt,Option.bind_some]
  · rw [stackClock_add (program M) n 1 _ _ hr,halt_clock M last.q ls rs last.Tape.head hhalt]
    exact Nat.succ_le_succ (execution_clock M n first last left right hf h)

theorem initial_tape (input : List Symbol) : Tape.mk₁ input=tape [] input.tail input.headI := by
  have hr : ListBlank.mk input=ListBlank.mk (input.headI::input.tail) := by
    simpa only [ListBlank.head_mk,ListBlank.tail_mk,ListBlank.cons_mk] using
      (ListBlank.cons_head_tail (ListBlank.mk input)).symm
  simp only [Tape.mk₁,tape,Tape.mk₂]
  rw [hr]
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.Simulation

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.StackCall
open Turing
variable {K J Λ Λ' σ ρ : Type} [DecidableEq K] [DecidableEq J]
    (stackCode : K → J) (labelCode : Λ → Λ') (returnTo : Λ') (get : ρ → σ) (put : ρ → σ → ρ)

def stmt : TM2.Stmt (fun _ : K => Bool) Λ σ → TM2.Stmt (fun _ : J => Bool) Λ' ρ
  | .push k f q => .push (stackCode k) (fun s => f (get s)) (stmt q)
  | .peek k f q => .peek (stackCode k) (fun s bit => put s (f (get s) bit)) (stmt q)
  | .pop k f q => .pop (stackCode k) (fun s bit => put s (f (get s) bit)) (stmt q)
  | .load f q => .load (fun s => put s (f (get s))) (stmt q)
  | .branch p a b => .branch (fun s => p (get s)) (stmt a) (stmt b)
  | .goto f => .goto (fun s => labelCode (f (get s)))
  | .halt => .goto (fun _ => returnTo)

def cfg (E : (K → List Bool) → (J → List Bool)) (saved : ρ) (c : TM2.Cfg (fun _ : K => Bool) Λ σ) :
    TM2.Cfg (fun _ : J => Bool) Λ' ρ :=
  ⟨some ((c.l.map labelCode).getD returnTo),put saved c.var,E c.stk⟩

variable (E : (K → List Bool) → (J → List Bool))
    (hE : ∀ S k, E S (stackCode k)=S k)
    (hupdate : ∀ S k bits, E (Function.update S k bits)=Function.update (E S) (stackCode k) bits)
    (hget : ∀ saved v, get (put saved v)=v)
    (hput : ∀ saved v w, put (put saved v) w=put saved w)

include hE hupdate hget hput in

theorem stmt_step (q : TM2.Stmt (fun _ : K => Bool) Λ σ) (v : σ) (S : K → List Bool) (saved : ρ) :
    TM2.stepAux (stmt stackCode labelCode returnTo get put q) (put saved v) (E S)=
      cfg labelCode returnTo put E saved (TM2.stepAux q v S) := by
  induction q generalizing v S saved with
  | push k f q ih =>
    simpa only [stmt,TM2.stepAux,hget,hE,← hupdate] using
        ih v (Function.update S k (f v::S k)) saved
  | peek k f q ih =>
    simpa only [stmt,TM2.stepAux,hget,hE,hput] using ih (f v (S k).head?) S saved
  | pop k f q ih =>
    simpa only [stmt,TM2.stepAux,hget,hE,hput,← hupdate] using
        ih (f v (S k).head?) (Function.update S k (S k).tail) saved
  | load f q ih =>
    simpa only [stmt,TM2.stepAux,hget,hput] using ih (f v) S saved
  | branch p a b iha ihb =>
    cases h : p v
    · simpa only [stmt,TM2.stepAux,hget,h,cond_false] using ihb v S saved
    · simpa only [stmt,TM2.stepAux,hget,h,cond_true] using iha v S saved
  | goto f => simp [stmt,TM2.stepAux,hget,cfg]
  | halt => rfl

include hE hupdate hget hput in

theorem stmt_clock (q : TM2.Stmt (fun _ : K => Bool) Λ σ) (v : σ) (S : K → List Bool) (saved : ρ) :
    Stacks.stackClock (stmt stackCode labelCode returnTo get put q) (put saved v) (E S)=
      Stacks.stackClock q v S := by
  induction q generalizing v S saved with
  | push k f q ih =>
    simpa only [stmt,Stacks.stackClock,hget,hE,← hupdate] using
      congrArg (fun n => 2*(S k).length+3+n) (ih v (Function.update S k (f v::S k)) saved)
  | peek k f q ih =>
    simpa only [stmt,Stacks.stackClock,hget,hE,hput] using
      congrArg (fun n => 2*(S k).length+2+n) (ih (f v (S k).head?) S saved)
  | pop k f q ih =>
    simpa only [stmt,Stacks.stackClock,hget,hE,hput,← hupdate] using
      congrArg (fun n => (S k).length+(S k).tail.length+2+n)
        (ih (f v (S k).head?) (Function.update S k (S k).tail) saved)
  | load f q ih => simpa only [stmt,Stacks.stackClock,hget,hput] using ih (f v) S saved
  | branch p a b iha ihb =>
    cases h : p v
    · simpa only [stmt,Stacks.stackClock,hget,h,Bool.false_eq_true,if_false] using ihb v S saved
    · simpa only [stmt,Stacks.stackClock,hget,h,if_true] using iha v S saved
  | goto f => rfl
  | halt => rfl
include hE hupdate hget hput in

theorem execution (M : Λ → TM2.Stmt (fun _ : K => Bool) Λ σ)
    (N : Λ' → TM2.Stmt (fun _ : J => Bool) Λ' ρ)
    (hcode : ∀ l, N (labelCode l)=stmt stackCode labelCode returnTo get put (M l))
    (saved : ρ) (n : ℕ) (first last : TM2.Cfg (fun _ : K => Bool) Λ σ)
    (h : Stacks.stackRun M n first=some last) :
    Stacks.stackRun N n (cfg labelCode returnTo put E saved first)=some (cfg labelCode returnTo put E saved last) ∧
      Stacks.stackRunClock N n (cfg labelCode returnTo put E saved first)=Stacks.stackRunClock M n first := by
  induction n generalizing first with
  | zero =>
    have he : first=last := Option.some.inj h
    subst last
    exact ⟨rfl,rfl⟩
  | succ n ih =>
    cases hs : TM2.step M first with
    | none => simp only [Stacks.stackRun,hs,Option.bind_none,reduceCtorEq] at h
    | some next =>
      have hn : Stacks.stackRun M n next=some last := by
        simpa only [Stacks.stackRun,hs,Option.bind_some] using h
      obtain ⟨hr,hc⟩ := ih next hn
      rcases first with ⟨l,v,S⟩
      cases l with
      | none => simp only [TM2.step,reduceCtorEq] at hs
      | some l =>
        have he : TM2.stepAux (M l) v S=next := Option.some.inj hs
        have hstep : TM2.step N (cfg labelCode returnTo put E saved ⟨some l,v,S⟩)=
            some (cfg labelCode returnTo put E saved next) := by
          change some (TM2.stepAux (N (labelCode l)) (put saved v) (E S))=_
          rw [hcode,stmt_step stackCode labelCode returnTo get put E hE hupdate hget hput,he]
        have hstep' : TM2.step N ⟨some (labelCode l),put saved v,E S⟩=
            some (cfg labelCode returnTo put E saved next) := hstep
        constructor
        · simpa only [Stacks.stackRun,hstep,Option.bind_some] using hr
        · change Stacks.stackRunClock N (n+1) ⟨some (labelCode l),put saved v,E S⟩=_
          rw [Stacks.stackRunClock,hstep']
          rw [Stacks.stackRunClock,hs]
          change 1+Stacks.stackClock (N (labelCode l)) (put saved v) (E S)+
            Stacks.stackRunClock N n (cfg labelCode returnTo put E saved next)=_
          rw [hcode,stmt_clock stackCode labelCode returnTo get put E hE hupdate hget hput,hc]
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.StackCall

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.StackCall
open Turing
variable {K J : Type} [DecidableEq K] [DecidableEq J]

def leftFrame (frame : J → List Bool) (S : K → List Bool) : K⊕J → List Bool := Sum.elim S frame

omit [DecidableEq K] [DecidableEq J] in

theorem leftFrame_at (frame : J → List Bool) (S : K → List Bool) (k : K) :
    leftFrame frame S (.inl k)=S k := rfl

theorem leftFrame_update (frame : J → List Bool) (S : K → List Bool) (k : K) (bits : List Bool) :
    leftFrame frame (Function.update S k bits)=Function.update (leftFrame frame S) (.inl k) bits := by
  funext j
  cases j with
  | inl k' => by_cases h : k'=k <;> simp [leftFrame,Function.update_apply,h]
  | inr j => simp [leftFrame]

def rightFrame (frame : J → List Bool) (S : K → List Bool) : J⊕K → List Bool := Sum.elim frame S

omit [DecidableEq K] [DecidableEq J] in

theorem rightFrame_at (frame : J → List Bool) (S : K → List Bool) (k : K) :
    rightFrame frame S (.inr k)=S k := rfl

theorem rightFrame_update (frame : J → List Bool) (S : K → List Bool) (k : K) (bits : List Bool) :
    rightFrame frame (Function.update S k bits)=Function.update (rightFrame frame S) (.inr k) bits := by
  funext j
  cases j with
  | inl j => simp [rightFrame]
  | inr k' => by_cases h : k'=k <;> simp [rightFrame,Function.update_apply,h]
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.StackCall

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.Stacks
open Turing
variable {K : Type} [DecidableEq K] {Γ : K → Type} {Λ σ : Type}

theorem run_add (M : Λ → TM2.Stmt Γ Λ σ) (n m : ℕ) (first : TM2.Cfg Γ Λ σ) :
    stackRun M (n+m) first=(stackRun M n first).bind (stackRun M m) := by
  induction n generalizing first with
  | zero => simp [stackRun]
  | succ n ih =>
    rw [Nat.succ_add,stackRun]
    cases hs : TM2.step M first with
    | none => simp only [Option.bind_none,stackRun,hs]
    | some next => simpa only [Option.bind_some,stackRun,hs] using ih next

theorem clock_add (M : Λ → TM2.Stmt Γ Λ σ) (n m : ℕ) (first mid : TM2.Cfg Γ Λ σ)
    (h : stackRun M n first=some mid) :
    stackRunClock M (n+m) first=stackRunClock M n first+stackRunClock M m mid := by
  induction n generalizing first with
  | zero =>
    have he : first=mid := Option.some.inj h
    subst mid
    simp [stackRunClock]
  | succ n ih =>
    cases hs : TM2.step M first with
    | none => simp [stackRun,hs] at h
    | some next =>
      have hn : stackRun M n next=some mid := by simpa only [stackRun,hs,Option.bind_some] using h
      rw [Nat.succ_add,stackRunClock_step M (n+m) first next hs,
        stackRunClock_step M n first next hs,ih next hn,Nat.add_assoc]
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.Stacks

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.Parsing
open Turing

def unaryProgram (_ : Fin 1) : TM2.Stmt (fun _ : Fin 2 => Bool) (Fin 1) (Option Bool) :=
  .pop 0 (fun _ bit => bit) (.branch (fun bit => bit.getD false)
    (.push 1 (fun _ => true) (.goto (fun _ => 0))) .halt)

theorem unary_step (rest count : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (saved : Option Bool) :
    TM2.step unaryProgram ⟨some 0,saved,Stacks.stackPair (true::rest) count⟩=
      some ⟨some 0,some true,Stacks.stackPair rest (true::count)⟩ := by
  simp [TM2.step,unaryProgram,TM2.stepAux]

theorem unary_stop (rest count : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (saved : Option Bool) :
    TM2.step unaryProgram ⟨some 0,saved,Stacks.stackPair (false::rest) count⟩=
      some ⟨none,some false,Stacks.stackPair rest count⟩ := by
  simp [TM2.step,unaryProgram,TM2.stepAux]

theorem marker_cons (width : ℕ) (count : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) :
    true::(List.replicate width true++count)=List.replicate width true++true::count := by
  induction width with
  | zero => rfl
  | succ width ih => simpa only [List.replicate_succ,List.cons_append] using congrArg (true::·) ih

theorem unary_run (width : ℕ) (rest count : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (saved : Option Bool) :
    Stacks.stackRun unaryProgram (width+1)
      ⟨some 0,saved,Stacks.stackPair (List.replicate width true++false::rest) count⟩=
      some ⟨none,some false,Stacks.stackPair rest (List.replicate width true++count)⟩ := by
  induction width generalizing count saved with
  | zero =>
    change TM2.step unaryProgram ⟨some 0,saved,Stacks.stackPair (false::rest) count⟩=_
    exact unary_stop rest count saved
  | succ width ih =>
    have ht := ih (true::count) (some true)
    simp only [List.replicate_succ,List.cons_append,Stacks.stackRun,unary_step,Option.bind_some]
    convert! ht using 1
    rw [marker_cons]

theorem unary_clock (width : ℕ) (rest count : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (saved : Option Bool) :
    Stacks.stackRunClock unaryProgram (width+1)
      ⟨some 0,saved,Stacks.stackPair (List.replicate width true++false::rest) count⟩=
      width*(2*(width+1+rest.length+count.length)+5)+2*rest.length+4 := by
  induction width generalizing count saved with
  | zero => simp [Stacks.stackRunClock,unaryProgram,Stacks.stackClock]; omega
  | succ width ih =>
    simp only [List.replicate_succ,List.cons_append]
    rw [Stacks.stackRunClock,unary_step]
    change 1+Stacks.stackClock (unaryProgram 0) saved
      (Stacks.stackPair (true::(List.replicate width true++false::rest)) count)+
      Stacks.stackRunClock unaryProgram (width+1)
        ⟨some 0,some true,Stacks.stackPair (List.replicate width true++false::rest) (true::count)⟩=_
    rw [ih]
    simp [unaryProgram,Stacks.stackClock]
    ring

def triple (reader count output : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) : Fin 3 → Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits :=
  fun k => if k=0 then reader else if k=1 then count else output

@[simp] theorem triple_zero (r c o : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) : triple r c o 0=r := by simp [triple]

@[simp] theorem triple_one (r c o : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) : triple r c o 1=c := by simp [triple]

@[simp] theorem triple_two (r c o : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) : triple r c o 2=o := by simp [triple]

@[simp] theorem triple_update_zero (r c o r' : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) : Function.update (triple r c o) 0 r'=triple r' c o := by
  funext k
  by_cases h : k=0 <;> simp [triple,Function.update_apply,h]

@[simp] theorem triple_update_one (r c o c' : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) : Function.update (triple r c o) 1 c'=triple r c' o := by
  funext k
  by_cases h : k=1
  · subst k; simp [triple]
  · by_cases h0 : k=0 <;> simp [triple,h,h0]

@[simp] theorem triple_update_two (r c o o' : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) : Function.update (triple r c o) 2 o'=triple r c o' := by
  funext k
  by_cases h0 : k=0
  · subst k; simp [triple]
  · by_cases h1 : k=1
    · subst k; simp [triple]
    · have hk : k=2 := by
        apply Fin.ext
        have h0v : k.val≠0 := fun h => h0 (Fin.ext h)
        have h1v : k.val≠1 := fun h => h1 (Fin.ext h)
        have hbound := k.isLt
        omega
      subst k
      simp [triple]

def fieldProgram (_ : Fin 1) : TM2.Stmt (fun _ : Fin 3 => Bool) (Fin 1) (Option Bool) :=
  .pop 1 (fun _ bit => bit) (.branch (fun bit => bit.isSome)
    (.pop 0 (fun _ bit => bit) (.push 2 (fun bit => bit.getD false) (.goto (fun _ => 0)))) .halt)

theorem field_step (bit : Bool) (rest count output : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (saved : Option Bool) :
    TM2.step fieldProgram ⟨some 0,saved,triple (bit::rest) (true::count) output⟩=
      some ⟨some 0,some bit,triple rest count (bit::output)⟩ := by
  simp [TM2.step,fieldProgram,TM2.stepAux]

theorem field_stop (rest output : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (saved : Option Bool) :
    TM2.step fieldProgram ⟨some 0,saved,triple rest [] output⟩=
      some ⟨none,none,triple rest [] output⟩ := by
  simp [TM2.step,fieldProgram,TM2.stepAux]

theorem field_run (bits rest output : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (saved : Option Bool) :
    Stacks.stackRun fieldProgram (bits.length+1)
      ⟨some 0,saved,triple (bits++rest) (List.replicate bits.length true) output⟩=
      some ⟨none,none,triple rest [] (bits.reverse++output)⟩ := by
  induction bits generalizing output saved with
  | nil =>
    change TM2.step fieldProgram ⟨some 0,saved,triple rest [] output⟩=_
    exact field_stop rest output saved
  | cons bit bits ih =>
    simpa only [List.length_cons,List.replicate_succ,List.cons_append,Stacks.stackRun,field_step,
      Option.bind_some,List.reverse_cons,List.append_assoc,List.singleton_append] using! ih (bit::output) (some bit)

theorem field_clock (bits rest output : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (saved : Option Bool) :
    Stacks.stackRunClock fieldProgram (bits.length+1)
      ⟨some 0,saved,triple (bits++rest) (List.replicate bits.length true) output⟩=
      bits.length*(3*bits.length+2*(rest.length+output.length)+7)+3 := by
  induction bits generalizing output saved with
  | nil => simp [Stacks.stackRunClock,fieldProgram,Stacks.stackClock]
  | cons bit bits ih =>
    simp only [List.length_cons,List.replicate_succ,List.cons_append]
    rw [Stacks.stackRunClock,field_step]
    change 1+Stacks.stackClock (fieldProgram 0) saved
      (triple (bit::(bits++rest)) (true::List.replicate bits.length true) output)+
      Stacks.stackRunClock fieldProgram (bits.length+1)
        ⟨some 0,some bit,triple (bits++rest) (List.replicate bits.length true) (bit::output)⟩=_
    rw [ih]
    simp [fieldProgram,Stacks.stackClock]
    ring
def unaryFrame (output : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (S : Fin 2 → Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) : Fin 3 → Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits :=
  triple (S 0) (S 1) output

theorem unaryFrame_at (output : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (S : Fin 2 → Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (k : Fin 2) :
    unaryFrame output S k.castSucc=S k := by
  by_cases h : k=0
  · subst k; rfl
  · have hk : k=1 := by
      apply Fin.ext
      have h0 : k.val≠0 := fun he => h (Fin.ext he)
      have hb := k.isLt
      omega
    subst k
    rfl

theorem unaryFrame_update (output : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (S : Fin 2 → Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (k : Fin 2) (bits : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) :
    unaryFrame output (Function.update S k bits)=Function.update (unaryFrame output S) k.castSucc bits := by
  by_cases h : k=0
  · subst k; simp [unaryFrame]
  · have hk : k=1 := by
      apply Fin.ext
      have h0 : k.val≠0 := fun he => h (Fin.ext he)
      have hb := k.isLt
      omega
    subst k
    simp [unaryFrame]

def natProgram (l : Fin 3) : TM2.Stmt (fun _ : Fin 3 => Bool) (Fin 3) (Option Bool) :=
  if l=0 then StackCall.stmt Fin.castSucc (fun _ : Fin 1 => (0 : Fin 3)) 1 id (fun _ v => v) (unaryProgram 0)
  else if l=1 then StackCall.stmt id (fun _ : Fin 1 => (1 : Fin 3)) 2 id (fun _ v => v) (fieldProgram 0)
  else .halt

theorem nat_execution (n : ℕ) (rest output : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (saved : Option Bool) :
    Stacks.stackRun natProgram (2*n.bits.length+3)
      ⟨some 0,saved,triple (Qatlib.Concepts.BitWordCompiler.CanonicalCodec.natBits n++rest) [] output⟩=
      some ⟨none,none,triple rest [] (n.bits.reverse++output)⟩ ∧
    Stacks.stackRunClock natProgram (2*n.bits.length+3)
      ⟨some 0,saved,triple (Qatlib.Concepts.BitWordCompiler.CanonicalCodec.natBits n++rest) [] output⟩=
      n.bits.length*(7*n.bits.length+4*rest.length+2*output.length+16)+2*rest.length+8 := by
  have hcodeU : ∀ l : Fin 1, natProgram 0=StackCall.stmt Fin.castSucc (fun _ : Fin 1 => (0 : Fin 3)) 1
      id (fun _ v => v) (unaryProgram l) := by intro l; rfl
  have hcodeF : ∀ l : Fin 1, natProgram 1=StackCall.stmt id (fun _ : Fin 1 => (1 : Fin 3)) 2
      id (fun _ v => v) (fieldProgram l) := by intro l; rfl
  obtain ⟨hu,huc⟩ := StackCall.execution Fin.castSucc (fun _ : Fin 1 => (0 : Fin 3)) 1 id (fun _ v => v)
    (unaryFrame output) (unaryFrame_at output) (unaryFrame_update output)
    (fun _ _ => rfl) (fun _ _ _ => rfl) unaryProgram natProgram hcodeU saved (n.bits.length+1) _ _
    (unary_run n.bits.length (n.bits++rest) [] saved)
  have hU : Stacks.stackRun natProgram (n.bits.length+1)
      ⟨some 0,saved,triple (Qatlib.Concepts.BitWordCompiler.CanonicalCodec.natBits n++rest) [] output⟩=
      some ⟨some 1,some false,triple (n.bits++rest) (List.replicate n.bits.length true) output⟩ := by
    simpa only [StackCall.cfg,unaryFrame,Stacks.stackPair_zero,Stacks.stackPair_one,
      List.append_nil,Qatlib.Concepts.BitWordCompiler.CanonicalCodec.natBits,List.append_assoc,List.cons_append,List.nil_append] using! hu
  obtain ⟨hf,hfc⟩ := StackCall.execution id (fun _ : Fin 1 => (1 : Fin 3)) 2 id (fun _ v => v)
    id (fun _ _ => rfl) (fun _ _ _ => rfl) (fun _ _ => rfl) (fun _ _ _ => rfl)
    fieldProgram natProgram hcodeF (some false) (n.bits.length+1) _ _ (field_run n.bits rest output (some false))
  have hF : Stacks.stackRun natProgram (n.bits.length+1)
      ⟨some 1,some false,triple (n.bits++rest) (List.replicate n.bits.length true) output⟩=
      some ⟨some 2,none,triple rest [] (n.bits.reverse++output)⟩ := by
    simpa only [StackCall.cfg] using! hf
  have hUC : Stacks.stackRunClock natProgram (n.bits.length+1)
      ⟨some 0,saved,triple (Qatlib.Concepts.BitWordCompiler.CanonicalCodec.natBits n++rest) [] output⟩=
      n.bits.length*(2*(n.bits.length+1+(n.bits++rest).length)+5)+2*(n.bits++rest).length+4 := by
    simpa only [StackCall.cfg,unaryFrame,Stacks.stackPair_zero,Stacks.stackPair_one,
      List.append_nil,Qatlib.Concepts.BitWordCompiler.CanonicalCodec.natBits,List.append_assoc,List.cons_append,List.nil_append,List.length_nil,Nat.add_zero]
      using! huc.trans (unary_clock n.bits.length (n.bits++rest) [] saved)
  have hFC : Stacks.stackRunClock natProgram (n.bits.length+1)
      ⟨some 1,some false,triple (n.bits++rest) (List.replicate n.bits.length true) output⟩=
      n.bits.length*(3*n.bits.length+2*(rest.length+output.length)+7)+3 := by
    simpa only [StackCall.cfg] using! hfc.trans (field_clock n.bits rest output (some false))
  have hUF : Stacks.stackRun natProgram ((n.bits.length+1)+(n.bits.length+1))
      ⟨some 0,saved,triple (Qatlib.Concepts.BitWordCompiler.CanonicalCodec.natBits n++rest) [] output⟩=
      some ⟨some 2,none,triple rest [] (n.bits.reverse++output)⟩ := by
    rw [Stacks.run_add,hU,Option.bind_some,hF]
  have hD : Stacks.stackRunClock natProgram 1 ⟨some 2,none,triple rest [] (n.bits.reverse++output)⟩=1 := by
    simp [Stacks.stackRunClock,TM2.step,natProgram,TM2.stepAux,Stacks.stackClock]
  have htotal : 2*n.bits.length+3=((n.bits.length+1)+(n.bits.length+1))+1 := by omega
  constructor
  · rw [htotal,Stacks.run_add,hUF,Option.bind_some]
    simp [Stacks.stackRun,TM2.step,natProgram,TM2.stepAux]
  · rw [htotal,Stacks.clock_add natProgram _ 1 _ _ hUF,hD,
      Stacks.clock_add natProgram _ _ _ _ hU,hUC,hFC]
    simp only [List.length_append]
    ring

theorem nat_run (n : ℕ) (rest output : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (saved : Option Bool) :
    Stacks.stackRun natProgram (2*n.bits.length+3)
      ⟨some 0,saved,triple (Qatlib.Concepts.BitWordCompiler.CanonicalCodec.natBits n++rest) [] output⟩=
      some ⟨none,none,triple rest [] (n.bits.reverse++output)⟩ :=
  (nat_execution n rest output saved).1

theorem nat_clock (n : ℕ) (rest output : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (saved : Option Bool) :
    Stacks.stackRunClock natProgram (2*n.bits.length+3)
      ⟨some 0,saved,triple (Qatlib.Concepts.BitWordCompiler.CanonicalCodec.natBits n++rest) [] output⟩=
      n.bits.length*(7*n.bits.length+4*rest.length+2*output.length+16)+2*rest.length+8 :=
  (nat_execution n rest output saved).2

theorem nat_clock_bound (n : ℕ) (rest output : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (saved : Option Bool) :
    Stacks.stackRunClock natProgram (2*n.bits.length+3)
      ⟨some 0,saved,triple (Qatlib.Concepts.BitWordCompiler.CanonicalCodec.natBits n++rest) [] output⟩≤
      40*(1+(Qatlib.Concepts.BitWordCompiler.CanonicalCodec.natBits n++rest).length+output.length)^2 := by
  rw [nat_clock]
  let B :=
      1+(Qatlib.Concepts.BitWordCompiler.CanonicalCodec.natBits n++rest).length+output.length
  have hlen : (Qatlib.Concepts.BitWordCompiler.CanonicalCodec.natBits n++rest).length=2*n.bits.length+1+rest.length := by
    simp [Qatlib.Concepts.BitWordCompiler.CanonicalCodec.natBits,Nat.add_assoc]
    omega
  have hm : n.bits.length≤B := by dsimp [B]; omega
  have hr : rest.length≤B := by dsimp [B]; omega
  have ho : output.length≤B := by dsimp [B]; omega
  have hB : 1≤B := by dsimp [B]; omega
  have hinner : 7*n.bits.length+4*rest.length+2*output.length+16≤13*B+16 := by omega
  have hmul := Nat.mul_le_mul hm hinner
  have hsq : B≤B^2 := Nat.le_pow (by decide)
  change _≤40*B^2
  nlinarith

def skipProgram (_ : Fin 1) : TM2.Stmt (fun _ : Fin 2 => Bool) (Fin 1) (Option Bool) :=
  .pop 1 (fun _ bit => bit) (.branch (fun bit => bit.isSome)
    (.pop 0 (fun _ bit => bit) (.goto (fun _ => 0))) .halt)

theorem skip_step (bit : Bool) (rest count : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (saved : Option Bool) :
    TM2.step skipProgram ⟨some 0,saved,Stacks.stackPair (bit::rest) (true::count)⟩=
      some ⟨some 0,some bit,Stacks.stackPair rest count⟩ := by
  simp [TM2.step,skipProgram,TM2.stepAux]

theorem skip_run (bits rest : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (saved : Option Bool) :
    Stacks.stackRun skipProgram (bits.length+1)
      ⟨some 0,saved,Stacks.stackPair (bits++rest) (List.replicate bits.length true)⟩=
      some ⟨none,none,Stacks.stackPair rest []⟩ := by
  induction bits generalizing saved with
  | nil => simp [Stacks.stackRun,TM2.step,skipProgram,TM2.stepAux]
  | cons bit bits ih =>
    simpa only [List.length_cons,List.replicate_succ,List.cons_append,Stacks.stackRun,skip_step,Option.bind_some]
      using ih (some bit)

theorem skip_clock (bits rest : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (saved : Option Bool) :
    Stacks.stackRunClock skipProgram (bits.length+1)
      ⟨some 0,saved,Stacks.stackPair (bits++rest) (List.replicate bits.length true)⟩=
      bits.length*(2*(bits.length+rest.length)+5)+3 := by
  induction bits generalizing saved with
  | nil => simp [Stacks.stackRunClock,skipProgram,Stacks.stackClock]
  | cons bit bits ih =>
    simp only [List.length_cons,List.replicate_succ,List.cons_append]
    rw [Stacks.stackRunClock,skip_step]
    change 1+Stacks.stackClock (skipProgram 0) saved
      (Stacks.stackPair (bit::(bits++rest)) (true::List.replicate bits.length true))+
      Stacks.stackRunClock skipProgram (bits.length+1)
        ⟨some 0,some bit,Stacks.stackPair (bits++rest) (List.replicate bits.length true)⟩=_
    rw [ih]
    simp [skipProgram,Stacks.stackClock]
    ring
def skipNatProgram (l : Fin 3) : TM2.Stmt (fun _ : Fin 2 => Bool) (Fin 3) (Option Bool) :=
  if l=0 then StackCall.stmt id (fun _ : Fin 1 => (0 : Fin 3)) 1 id (fun _ v => v) (unaryProgram 0)
  else if l=1 then StackCall.stmt id (fun _ : Fin 1 => (1 : Fin 3)) 2 id (fun _ v => v) (skipProgram 0)
  else .halt

theorem skipNat_execution (n : ℕ) (rest : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (saved : Option Bool) :
    Stacks.stackRun skipNatProgram (2*n.bits.length+3)
      ⟨some 0,saved,Stacks.stackPair (Qatlib.Concepts.BitWordCompiler.CanonicalCodec.natBits n++rest) []⟩=
      some ⟨none,none,Stacks.stackPair rest []⟩ ∧
    Stacks.stackRunClock skipNatProgram (2*n.bits.length+3)
      ⟨some 0,saved,Stacks.stackPair (Qatlib.Concepts.BitWordCompiler.CanonicalCodec.natBits n++rest) []⟩=
      n.bits.length*(6*n.bits.length+4*rest.length+14)+2*rest.length+8 := by
  have hcodeU : ∀ l : Fin 1, skipNatProgram 0=StackCall.stmt id (fun _ : Fin 1 => (0 : Fin 3)) 1
      id (fun _ v => v) (unaryProgram l) := by intro l; rfl
  have hcodeS : ∀ l : Fin 1, skipNatProgram 1=StackCall.stmt id (fun _ : Fin 1 => (1 : Fin 3)) 2
      id (fun _ v => v) (skipProgram l) := by intro l; rfl
  obtain ⟨hu,huc⟩ := StackCall.execution id (fun _ : Fin 1 => (0 : Fin 3)) 1 id (fun _ v => v)
    id (fun _ _ => rfl) (fun _ _ _ => rfl) (fun _ _ => rfl) (fun _ _ _ => rfl)
    unaryProgram skipNatProgram hcodeU saved (n.bits.length+1) _ _
    (unary_run n.bits.length (n.bits++rest) [] saved)
  have hU : Stacks.stackRun skipNatProgram (n.bits.length+1)
      ⟨some 0,saved,Stacks.stackPair (Qatlib.Concepts.BitWordCompiler.CanonicalCodec.natBits n++rest) []⟩=
      some ⟨some 1,some false,Stacks.stackPair (n.bits++rest) (List.replicate n.bits.length true)⟩ := by
    simpa only [StackCall.cfg,List.append_nil,Qatlib.Concepts.BitWordCompiler.CanonicalCodec.natBits,List.append_assoc,List.cons_append,List.nil_append] using! hu
  obtain ⟨hs,hsc⟩ := StackCall.execution id (fun _ : Fin 1 => (1 : Fin 3)) 2 id (fun _ v => v)
    id (fun _ _ => rfl) (fun _ _ _ => rfl) (fun _ _ => rfl) (fun _ _ _ => rfl)
    skipProgram skipNatProgram hcodeS (some false) (n.bits.length+1) _ _ (skip_run n.bits rest (some false))
  have hS : Stacks.stackRun skipNatProgram (n.bits.length+1)
      ⟨some 1,some false,Stacks.stackPair (n.bits++rest) (List.replicate n.bits.length true)⟩=
      some ⟨some 2,none,Stacks.stackPair rest []⟩ := by simpa only [StackCall.cfg] using! hs
  have hUC : Stacks.stackRunClock skipNatProgram (n.bits.length+1)
      ⟨some 0,saved,Stacks.stackPair (Qatlib.Concepts.BitWordCompiler.CanonicalCodec.natBits n++rest) []⟩=
      n.bits.length*(2*(n.bits.length+1+(n.bits++rest).length)+5)+2*(n.bits++rest).length+4 := by
    simpa only [StackCall.cfg,List.append_nil,Qatlib.Concepts.BitWordCompiler.CanonicalCodec.natBits,List.append_assoc,List.cons_append,List.nil_append,
      List.length_nil,Nat.add_zero] using! huc.trans (unary_clock n.bits.length (n.bits++rest) [] saved)
  have hSC : Stacks.stackRunClock skipNatProgram (n.bits.length+1)
      ⟨some 1,some false,Stacks.stackPair (n.bits++rest) (List.replicate n.bits.length true)⟩=
      n.bits.length*(2*(n.bits.length+rest.length)+5)+3 := by
    simpa only [StackCall.cfg] using! hsc.trans (skip_clock n.bits rest (some false))
  have hUS : Stacks.stackRun skipNatProgram ((n.bits.length+1)+(n.bits.length+1))
      ⟨some 0,saved,Stacks.stackPair (Qatlib.Concepts.BitWordCompiler.CanonicalCodec.natBits n++rest) []⟩=
      some ⟨some 2,none,Stacks.stackPair rest []⟩ := by rw [Stacks.run_add,hU,Option.bind_some,hS]
  have hD : Stacks.stackRunClock skipNatProgram 1 ⟨some 2,none,Stacks.stackPair rest []⟩=1 := by
    simp [Stacks.stackRunClock,TM2.step,skipNatProgram,TM2.stepAux,Stacks.stackClock]
  have htotal : 2*n.bits.length+3=((n.bits.length+1)+(n.bits.length+1))+1 := by omega
  constructor
  · rw [htotal,Stacks.run_add,hUS,Option.bind_some]
    simp [Stacks.stackRun,TM2.step,skipNatProgram,TM2.stepAux]
  · rw [htotal,Stacks.clock_add skipNatProgram _ 1 _ _ hUS,hD,
      Stacks.clock_add skipNatProgram _ _ _ _ hU,hUC,hSC]
    simp only [List.length_append]
    ring

theorem skipNat_clock_bound (n : ℕ) (rest : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (saved : Option Bool) :
    Stacks.stackRunClock skipNatProgram (2*n.bits.length+3)
      ⟨some 0,saved,Stacks.stackPair (Qatlib.Concepts.BitWordCompiler.CanonicalCodec.natBits n++rest) []⟩≤40*(1+(Qatlib.Concepts.BitWordCompiler.CanonicalCodec.natBits n++rest).length)^2 := by
  have hb := nat_clock_bound n rest [] saved
  rw [(skipNat_execution n rest saved).2]
  rw [nat_clock] at hb
  simp only [List.length_nil,Nat.mul_zero,Nat.add_zero] at hb
  have hm : n.bits.length*(6*n.bits.length+4*rest.length+14)+2*rest.length+8≤
      n.bits.length*(7*n.bits.length+4*rest.length+16)+2*rest.length+8 := by nlinarith
  exact hm.trans hb
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.Parsing

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.StackCall
variable {K J : Type} [DecidableEq K] [DecidableEq J]
    (code : K → J) (saved : J → List Bool) (S : K → List Bool)

noncomputable def frame : J → List Bool := by
  classical
  exact fun j => if h : ∃ k, code k=j then S (Classical.choose h) else saved j

omit [DecidableEq K] [DecidableEq J] in

theorem frame_at (hinj : Function.Injective code) (k : K) : frame code saved S (code k)=S k := by
  classical
  have h : ∃ k', code k'=code k := ⟨k,rfl⟩
  rw [frame,dif_pos h]
  exact congrArg S (hinj (Classical.choose_spec h))

theorem frame_update (hinj : Function.Injective code) (k : K) (bits : List Bool) :
    frame code saved (Function.update S k bits)=Function.update (frame code saved S) (code k) bits := by
  classical
  have hat : ∀ S' k', frame code saved S' (code k')=S' k' :=
      fun S' k' => frame_at code saved S' hinj k'
  funext j
  by_cases hj : ∃ k', code k'=j
  · obtain ⟨k',rfl⟩ := hj
    by_cases h : k'=k
    · subst k'; simp only [hat,Function.update_self]
    · have hc : code k'≠code k := fun he => h (hinj he)
      simp only [hat,Function.update_of_ne h,Function.update_of_ne hc]
  · have hc : j≠code k := fun he => hj ⟨k,he.symm⟩
    simp only [frame,dif_neg hj,Function.update_of_ne hc]

omit [DecidableEq K] [DecidableEq J] in

theorem frame_same (hinj : Function.Injective code) (hS : ∀ k, saved (code k)=S k) :
    frame code saved S=saved := by
  classical
  funext j
  by_cases hj : ∃ k, code k=j
  · obtain ⟨k,rfl⟩ := hj
    rw [frame_at code saved S hinj,hS]
  · simp only [frame,dif_neg hj]
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.StackCall

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.Stacks
open Turing
variable {K : Type} [DecidableEq K] {Γ : K → Type} {Λ σ : Type}

theorem run_one (M : Λ → TM2.Stmt Γ Λ σ) (first : TM2.Cfg Γ Λ σ) : stackRun M 1 first=TM2.step M first := by
  simp only [stackRun]
  cases TM2.step M first <;> rfl

theorem maxClock_add (M : Λ → TM2.Stmt Γ Λ σ) (n m : ℕ) (first mid : TM2.Cfg Γ Λ σ)
    (h : stackRun M n first=some mid) :
    stackRunMaxClock M (n+m) first=max (stackRunMaxClock M n first) (stackRunMaxClock M m mid) := by
  induction n generalizing first with
  | zero =>
    have he : first=mid := Option.some.inj h
    subst mid
    simp [stackRunMaxClock]
  | succ n ih =>
    cases hs : TM2.step M first with
    | none => simp [stackRun,hs] at h
    | some next =>
      have hn : stackRun M n next=some mid := by simpa only [stackRun,hs,Option.bind_some] using h
      rw [Nat.succ_add]
      simp only [stackRunMaxClock,hs]
      rw [ih next hn,Nat.max_assoc]

theorem maxClock_le_clock (M : Λ → TM2.Stmt Γ Λ σ) (n : ℕ) (first : TM2.Cfg Γ Λ σ) :
    stackRunMaxClock M n first≤stackRunClock M n first := by
  induction n generalizing first with
  | zero => exact le_rfl
  | succ n ih =>
    cases hs : TM2.step M first with
    | none => simp [stackRunMaxClock,stackRunClock,hs]
    | some next =>
      rw [stackRunClock_step M n first next hs]
      simp only [stackRunMaxClock,hs]
      have ht := ih next
      exact max_le (by omega) (by omega)
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.Stacks

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.StackCall
open Turing
variable {K J Λ Λ' σ ρ : Type} [DecidableEq K] [DecidableEq J]
    (stackCode : K → J) (labelCode : Λ → Λ') (returnTo : Λ') (get : ρ → σ) (put : ρ → σ → ρ)
    (E : (K → List Bool) → (J → List Bool))
    (hE : ∀ S k, E S (stackCode k)=S k)
    (hupdate : ∀ S k bits, E (Function.update S k bits)=Function.update (E S) (stackCode k) bits)
    (hget : ∀ saved v, get (put saved v)=v)
    (hput : ∀ saved v w, put (put saved v) w=put saved w)

include hE hupdate hget hput in

theorem max_clock (M : Λ → TM2.Stmt (fun _ : K => Bool) Λ σ)
    (N : Λ' → TM2.Stmt (fun _ : J => Bool) Λ' ρ)
    (hcode : ∀ l, N (labelCode l)=stmt stackCode labelCode returnTo get put (M l))
    (saved : ρ) (n : ℕ) (first last : TM2.Cfg (fun _ : K => Bool) Λ σ)
    (h : Stacks.stackRun M n first=some last) :
    Stacks.stackRunMaxClock N n (cfg labelCode returnTo put E saved first)=Stacks.stackRunMaxClock M n first := by
  induction n generalizing first with
  | zero => rfl
  | succ n ih =>
    cases hs : TM2.step M first with
    | none => simp only [Stacks.stackRun,hs,Option.bind_none,reduceCtorEq] at h
    | some next =>
      have hn : Stacks.stackRun M n next=some last := by
        simpa only [Stacks.stackRun,hs,Option.bind_some] using h
      have hOne : Stacks.stackRun M 1 first=some next := by rw [Stacks.run_one,hs]
      obtain ⟨hN,hC⟩ := execution stackCode labelCode returnTo get put E hE hupdate hget hput
        M N hcode saved 1 first next hOne
      rw [Stacks.run_one] at hN
      simp only [Stacks.stackRunMaxClock,hN,hs,hC]
      rw [ih next hn]
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.StackCall

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.Normalization
open Turing

def singleStack (bits : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) : Fin 1 →
    Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits := fun _ => bits

@[simp] theorem singleStack_zero (bits : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) : singleStack bits 0=bits := rfl

@[simp] theorem singleStack_update (bits rest : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) :
    Function.update (singleStack bits) 0 rest=singleStack rest := by
  funext k
  have hk : k=0 := by apply Fin.ext; have hb := k.isLt; omega
  subst k
  simp [singleStack]

def drainProgram (_ : Fin 1) : TM2.Stmt (fun _ : Fin 1 => Bool) (Fin 1) Symbol :=
  .pop 0 (fun _ bit => bit) (.branch (fun bit => bit.isSome) (.goto (fun _ => 0)) .halt)

theorem drain_step (bit : Bool) (bits : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (saved : Symbol) :
    TM2.step drainProgram ⟨some 0,saved,singleStack (bit::bits)⟩=
      some ⟨some 0,some bit,singleStack bits⟩ := by
  simp [TM2.step,drainProgram,TM2.stepAux]

theorem drain_run (bits : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (saved : Symbol) :
    Stacks.stackRun drainProgram (bits.length+1) ⟨some 0,saved,singleStack bits⟩=
      some ⟨none,none,singleStack []⟩ := by
  induction bits generalizing saved with
  | nil => simp [Stacks.stackRun,TM2.step,drainProgram,TM2.stepAux]
  | cons bit bits ih => simpa only [List.length_cons,Stacks.stackRun,drain_step,Option.bind_some] using ih (some bit)

theorem drain_clock (bits : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (saved : Symbol) :
    Stacks.stackRunClock drainProgram (bits.length+1) ⟨some 0,saved,singleStack bits⟩=
      bits.length^2+3*bits.length+3 := by
  induction bits generalizing saved with
  | nil => simp [Stacks.stackRunClock,drainProgram,Stacks.stackClock]
  | cons bit bits ih =>
    rw [Stacks.stackRunClock,drain_step]
    change 1+Stacks.stackClock (drainProgram 0) saved (singleStack (bit::bits))+
      Stacks.stackRunClock drainProgram (bits.length+1) ⟨some 0,some bit,singleStack bits⟩=_
    rw [ih]
    simp [drainProgram,Stacks.stackClock]
    ring

theorem dense_padding (cells : List Symbol) (bits : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits)
    (h : ListBlank.mk cells=ListBlank.mk (bits.map some)) :
    ∃ padding, cells=bits.map some++List.replicate padding none := by
  have hr : BlankRel cells (bits.map some) := Quotient.exact h
  rcases hr with ⟨padding,he⟩ | ⟨padding,he⟩
  · have hp : padding=0 := by
      by_contra hn
      have hm : (none : Symbol)∈bits.map some := by
        rw [he]
        simp [List.mem_append,hn,show (default : Symbol)=none from rfl]
      simp at hm
    refine ⟨0,?_⟩
    simpa only [hp,List.replicate_zero,List.append_nil] using he.symm
  · exact ⟨padding,he⟩

inductive Label where | emit | read | drainL | drainR | done deriving DecidableEq,Fintype
instance : Inhabited Label := ⟨.emit⟩

def program : Label → TM2.Stmt (fun _ : Fin 3 => Bool) Label Symbol
  | .emit => .branch (fun head => head.isSome)
      (.push 2 (fun head => head.getD false) (.goto (fun _ => .read))) (.goto (fun _ => .drainL))
  | .read => StackCall.stmt Fin.castSucc id .drainL id (fun _ v => v)
      (Simulation.popSymbol 1 (.goto (fun _ => .emit)))
  | .drainL => StackCall.stmt (fun _ : Fin 1 => (0 : Fin 3)) (fun _ : Fin 1 => .drainL) .drainR
      id (fun _ v => v) (drainProgram 0)
  | .drainR => StackCall.stmt (fun _ : Fin 1 => (1 : Fin 3)) (fun _ : Fin 1 => .drainR) .done
      id (fun _ v => v) (drainProgram 0)
  | .done => .halt

theorem emit_some_step (left right : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (out : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (bit : Bool) :
    TM2.step program ⟨some .emit,some bit,Parsing.triple left right out⟩=
      some ⟨some .read,some bit,Parsing.triple left right (bit::out)⟩ := by
  simp [TM2.step,program,TM2.stepAux]

theorem emit_none_step (left right out : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) :
    TM2.step program ⟨some .emit,none,Parsing.triple left right out⟩=
      some ⟨some .drainL,none,Parsing.triple left right out⟩ := rfl

theorem read_step (left right : List Symbol) (head : Symbol) (out : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) :
    TM2.step program ⟨some .read,head,Parsing.triple (Simulation.pack left) (Simulation.pack right) out⟩=
      some ⟨some .emit,right.headI,Parsing.triple (Simulation.pack left) (Simulation.pack right.tail) out⟩ := by
  have hs := StackCall.stmt_step Fin.castSucc (id : Label → Label) Label.drainL id (fun _ v => v)
    (Parsing.unaryFrame out) (Parsing.unaryFrame_at out) (Parsing.unaryFrame_update out)
    (fun _ _ => rfl) (fun _ _ _ => rfl) (Simulation.popSymbol 1 (.goto (fun _ => Label.emit)))
    head (Stacks.stackPair (Simulation.pack left) (Simulation.pack right)) head
  rw [Simulation.pop_right] at hs
  simpa only [TM2.step,program,StackCall.cfg,Parsing.unaryFrame,Stacks.stackPair_zero,Stacks.stackPair_one,TM2.stepAux] using! congrArg some hs

theorem emit_clock (left right out : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (bit : Bool) :
    Stacks.stackRunClock program 1 ⟨some .emit,some bit,Parsing.triple left right out⟩=2*out.length+4 := by
  simp [Stacks.stackRunClock,program,Stacks.stackClock]
  omega

theorem read_clock (left right : List Symbol) (head : Symbol) (out : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) :
    Stacks.stackRunClock program 1
      ⟨some .read,head,Parsing.triple (Simulation.pack left) (Simulation.pack right) out⟩=
      if right=[] then 5 else 8*right.length+1 := by
  rw [Stacks.stackRunClock,read_step]
  change 1+Stacks.stackClock (program .read) head
      (Parsing.triple (Simulation.pack left) (Simulation.pack right) out)+0=_
  have hc := StackCall.stmt_clock Fin.castSucc (id : Label → Label) Label.drainL id (fun _ v => v)
    (Parsing.unaryFrame out) (Parsing.unaryFrame_at out) (Parsing.unaryFrame_update out)
    (fun _ _ => rfl) (fun _ _ _ => rfl) (Simulation.popSymbol 1 (.goto (fun _ => Label.emit)))
    head (Stacks.stackPair (Simulation.pack left) (Simulation.pack right)) head
  change Stacks.stackClock (program .read) head
      (Parsing.triple (Simulation.pack left) (Simulation.pack right) out)=_ at hc
  rw [hc]
  cases right with
  | nil => rfl
  | cons a rest =>
    simp [Simulation.popSymbol,Stacks.stackClock,Simulation.pack]
    ring

theorem emit_read (left right : List Symbol) (out : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (bit : Bool) :
    Stacks.stackRun program 2
      ⟨some .emit,some bit,Parsing.triple (Simulation.pack left) (Simulation.pack right) out⟩=
      some ⟨some .emit,right.headI,Parsing.triple (Simulation.pack left) (Simulation.pack right.tail) (bit::out)⟩ := by
  simp only [Stacks.stackRun,emit_some_step,Option.bind_some,read_step]

theorem emit_read_clock (left right : List Symbol) (out : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (bit : Bool) :
    Stacks.stackRunClock program 2
      ⟨some .emit,some bit,Parsing.triple (Simulation.pack left) (Simulation.pack right) out⟩=
      (2*out.length+4)+(if right=[] then 5 else 8*right.length+1) := by
  have hs : Stacks.stackRun program 1
      ⟨some .emit,some bit,Parsing.triple (Simulation.pack left) (Simulation.pack right) out⟩=
      some ⟨some .read,some bit,Parsing.triple (Simulation.pack left) (Simulation.pack right) (bit::out)⟩ := by
    simpa only [Stacks.stackRun,Option.bind_some] using!
        emit_some_step (Simulation.pack left) (Simulation.pack right) out bit
  rw [show 2=1+1 from rfl,Stacks.clock_add program 1 1 _ _ hs,emit_clock,read_clock]

theorem emit_word (bit : Bool) (bits : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (left : List Symbol) (padding : ℕ) (out : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) :
    Stacks.stackRun program (2*(bit::bits).length)
      ⟨some .emit,some bit,Parsing.triple (Simulation.pack left)
        (Simulation.pack (bits.map some++List.replicate padding none)) out⟩=
      some ⟨some .emit,none,Parsing.triple (Simulation.pack left)
        (Simulation.pack (List.replicate (padding-1) none)) ((bit::bits).reverse++out)⟩ := by
  induction bits generalizing bit out with
  | nil =>
    have hs := emit_read left (List.replicate padding none) out bit
    cases padding <;> simpa only [List.length_cons,List.length_nil,List.map_nil,List.nil_append,
      List.reverse_cons,List.reverse_nil,List.singleton_append,Nat.zero_add,Nat.mul_one,
      List.replicate_zero,List.replicate_succ,List.headI_cons,List.tail_cons,Nat.add_sub_cancel] using! hs
  | cons next bits ih =>
    have hs := emit_read left ((next::bits).map some++List.replicate padding none) out bit
    simp only [List.map_cons,List.cons_append,List.headI_cons,List.tail_cons] at hs
    have hn : 2*(bit::next::bits).length=2+2*(next::bits).length := by simp; omega
    rw [hn,Stacks.run_add]
    simp only [List.map_cons,List.cons_append]
    rw [hs,Option.bind_some]
    simpa only [List.reverse_cons,List.append_assoc,List.singleton_append] using! ih next (bit::out)

theorem emit_word_clock (bit : Bool) (bits : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (left : List Symbol) (padding : ℕ) (out : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) :
    Stacks.stackRunClock program (2*(bit::bits).length)
      ⟨some .emit,some bit,Parsing.triple (Simulation.pack left)
        (Simulation.pack (bits.map some++List.replicate padding none)) out⟩=
      (bit::bits).length*(2*out.length+5*(bit::bits).length+8*padding)+(if padding=0 then 4 else 0) := by
  induction bits generalizing bit out with
  | nil =>
    have hc := emit_read_clock left (List.replicate padding none) out bit
    cases padding <;> convert! hc using 1 <;> simp
    all_goals omega
  | cons next bits ih =>
    have hs := emit_read left ((next::bits).map some++List.replicate padding none) out bit
    simp only [List.map_cons,List.cons_append,List.headI_cons,List.tail_cons] at hs
    have hn : 2*(bit::next::bits).length=2+2*(next::bits).length := by simp; omega
    rw [hn]
    simp only [List.map_cons,List.cons_append]
    rw [Stacks.clock_add program 2 _ _ _ hs,emit_read_clock,ih]
    simp only [List.cons_ne_nil,if_false,List.length_cons,
      List.length_append,List.length_map,List.length_replicate]
    ring
def leftFrame (right out : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (S : Fin 1 → Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) : Fin 3 → Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits :=
  Parsing.triple (S 0) right out

def rightFrame (left out : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (S : Fin 1 → Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) : Fin 3 → Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits :=
  Parsing.triple left (S 0) out

theorem leftFrame_at (right out : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (S : Fin 1 → Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (k : Fin 1) :
    leftFrame right out S 0=S k := by
  have hk : k=0 := by apply Fin.ext; have hb := k.isLt; omega
  subst k
  rfl

theorem rightFrame_at (left out : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (S : Fin 1 → Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (k : Fin 1) :
    rightFrame left out S 1=S k := by
  have hk : k=0 := by apply Fin.ext; have hb := k.isLt; omega
  subst k
  rfl

theorem leftFrame_update (right out : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (S : Fin 1 → Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (k : Fin 1) (bits : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) :
    leftFrame right out (Function.update S k bits)=Function.update (leftFrame right out S) 0 bits := by
  have hk : k=0 := by apply Fin.ext; have hb := k.isLt; omega
  subst k
  simp [leftFrame]

theorem rightFrame_update (left out : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (S : Fin 1 → Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (k : Fin 1) (bits : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) :
    rightFrame left out (Function.update S k bits)=Function.update (rightFrame left out S) 1 bits := by
  have hk : k=0 := by apply Fin.ext; have hb := k.isLt; omega
  subst k
  simp [rightFrame]

theorem drain_left (left right out : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (saved : Symbol) :
    Stacks.stackRun program (left.length+1) ⟨some .drainL,saved,Parsing.triple left right out⟩=
      some ⟨some .drainR,none,Parsing.triple [] right out⟩ ∧
    Stacks.stackRunClock program (left.length+1) ⟨some .drainL,saved,Parsing.triple left right out⟩=
      left.length^2+3*left.length+3 := by
  have hcode : ∀ l : Fin 1, program .drainL=StackCall.stmt (fun _ : Fin 1 => (0 : Fin 3))
      (fun _ : Fin 1 => Label.drainL) .drainR id (fun _ v => v) (drainProgram l) := by intro l; rfl
  obtain ⟨hr,hc⟩ := StackCall.execution (fun _ : Fin 1 => (0 : Fin 3))
    (fun _ : Fin 1 => Label.drainL) .drainR id (fun _ v => v)
    (leftFrame right out) (leftFrame_at right out) (leftFrame_update right out)
    (fun _ _ => rfl) (fun _ _ _ => rfl) drainProgram program hcode saved (left.length+1) _ _ (drain_run left saved)
  constructor
  · simpa only [StackCall.cfg,leftFrame,singleStack] using! hr
  · exact hc.trans (drain_clock left saved)

theorem drain_right (left right out : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (saved : Symbol) :
    Stacks.stackRun program (right.length+1) ⟨some .drainR,saved,Parsing.triple left right out⟩=
      some ⟨some .done,none,Parsing.triple left [] out⟩ ∧
    Stacks.stackRunClock program (right.length+1) ⟨some .drainR,saved,Parsing.triple left right out⟩=
      right.length^2+3*right.length+3 := by
  have hcode : ∀ l : Fin 1, program .drainR=StackCall.stmt (fun _ : Fin 1 => (1 : Fin 3))
      (fun _ : Fin 1 => Label.drainR) .done id (fun _ v => v) (drainProgram l) := by intro l; rfl
  obtain ⟨hr,hc⟩ := StackCall.execution (fun _ : Fin 1 => (1 : Fin 3))
    (fun _ : Fin 1 => Label.drainR) .done id (fun _ v => v)
    (rightFrame left out) (rightFrame_at left out) (rightFrame_update left out)
    (fun _ _ => rfl) (fun _ _ _ => rfl) drainProgram program hcode saved (right.length+1) _ _ (drain_run right saved)
  constructor
  · simpa only [StackCall.cfg,rightFrame,singleStack] using! hr
  · exact hc.trans (drain_clock right saved)

theorem cleanup (left right out : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) :
    Stacks.stackRun program (left.length+right.length+4) ⟨some .emit,none,Parsing.triple left right out⟩=
      some ⟨none,none,Parsing.triple [] [] out⟩ ∧
    Stacks.stackRunClock program (left.length+right.length+4) ⟨some .emit,none,Parsing.triple left right out⟩=
      left.length^2+3*left.length+right.length^2+3*right.length+8 := by
  have hE : Stacks.stackRun program 1 ⟨some .emit,none,Parsing.triple left right out⟩=
      some ⟨some .drainL,none,Parsing.triple left right out⟩ := by
    simpa only [Stacks.stackRun,Option.bind_some] using! emit_none_step left right out
  obtain ⟨hL,hLC⟩ := drain_left left right out none
  obtain ⟨hR,hRC⟩ := drain_right [] right out none
  have hEL : Stacks.stackRun program (1+(left.length+1)) ⟨some .emit,none,Parsing.triple left right out⟩=
      some ⟨some .drainR,none,Parsing.triple [] right out⟩ := by rw [Stacks.run_add,hE,Option.bind_some,hL]
  have hELR : Stacks.stackRun program ((1+(left.length+1))+(right.length+1))
      ⟨some .emit,none,Parsing.triple left right out⟩=
      some ⟨some .done,none,Parsing.triple [] [] out⟩ := by rw [Stacks.run_add,hEL,Option.bind_some,hR]
  have hEC : Stacks.stackRunClock program 1 ⟨some .emit,none,Parsing.triple left right out⟩=1 := by
    rw [Stacks.stackRunClock,emit_none_step]
    rfl
  have hDC : Stacks.stackRunClock program 1 ⟨some .done,none,Parsing.triple [] [] out⟩=1 := rfl
  have hn : left.length+right.length+4=(((1+(left.length+1))+(right.length+1))+1) := by omega
  constructor
  · rw [hn,Stacks.run_add,hELR,Option.bind_some]
    rfl
  · rw [hn,Stacks.clock_add program _ 1 _ _ hELR,hDC,
      Stacks.clock_add program _ _ _ _ hEL,hRC,
      Stacks.clock_add program _ _ _ _ hE,hEC,hLC]
    ring

theorem complete (left right : List Symbol) (head : Symbol) (word out : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits)
    (htape : Simulation.tape left right head=Tape.mk₁ (word.map some)) :
    ∃ ticks,
      Stacks.stackRun program ticks
        ⟨some .emit,head,Parsing.triple (Simulation.pack left) (Simulation.pack right) out⟩=
        some ⟨none,none,Parsing.triple [] [] (word.reverse++out)⟩ ∧
      Stacks.stackRunClock program ticks
        ⟨some .emit,head,Parsing.triple (Simulation.pack left) (Simulation.pack right) out⟩≤
        100*(1+(Simulation.pack left).length+(Simulation.pack right).length+out.length)^2 := by
  cases word with
  | nil =>
    have hh := congrArg Tape.head htape
    change head=none at hh
    subst head
    obtain ⟨hr,hc⟩ := cleanup (Simulation.pack left) (Simulation.pack right) out
    refine ⟨(Simulation.pack left).length+(Simulation.pack right).length+4,by simpa using hr,?_⟩
    rw [hc]
    let B := 1+(Simulation.pack left).length+(Simulation.pack right).length+out.length
    have hL : (Simulation.pack left).length≤B := by dsimp [B]; omega
    have hR : (Simulation.pack right).length≤B := by dsimp [B]; omega
    have hB : 1≤B := by dsimp [B]; omega
    have hs : B≤B^2 := Nat.le_pow (by decide)
    have hL2 := Nat.mul_le_mul hL hL
    have hR2 := Nat.mul_le_mul hR hR
    change _≤100*B^2
    nlinarith
  | cons bit bits =>
    have hh := congrArg Tape.head htape
    change head=some bit at hh
    subst head
    have hright : ListBlank.mk right=ListBlank.mk (bits.map some) := by
      have hr := congrArg (fun t : Tape Symbol => t.right₀.tail) htape
      simpa only [Simulation.tape,Tape.mk₁,Tape.mk₂,Tape.mk'_right₀,ListBlank.tail_mk,
        List.tail_cons,List.map_cons] using hr
    obtain ⟨padding,hright⟩ := dense_padding right bits hright
    subst right
    have hE := emit_word bit bits left padding out
    obtain ⟨hC,hCC⟩ := cleanup (Simulation.pack left) (Simulation.pack (List.replicate (padding-1) none))
      ((bit::bits).reverse++out)
    let suffixTicks :=
        (Simulation.pack left).length+(Simulation.pack (List.replicate (padding-1) none)).length+4
    refine ⟨2*(bit::bits).length+suffixTicks,?_,?_⟩
    · rw [Stacks.run_add,hE,Option.bind_some]
      exact hC
    · rw [Stacks.clock_add program _ _ _ _ hE,emit_word_clock,hCC]
      let B := 1+(Simulation.pack left).length+
        (Simulation.pack (bits.map some++List.replicate padding none)).length+out.length
      have hL : (Simulation.pack left).length≤B := by dsimp [B]; omega
      have hR : (Simulation.pack (List.replicate (padding-1) none)).length≤B := by
        dsimp [B]
        simp only [Simulation.pack_length,List.length_append,List.length_map,List.length_replicate]
        omega
      have hN : (bit::bits).length≤B := by
        dsimp [B]
        simp only [Simulation.pack_length,List.length_append,List.length_map,List.length_replicate]
        omega
      have hP : padding≤B := by
        dsimp [B]
        simp only [Simulation.pack_length,List.length_append,List.length_map,List.length_replicate]
        omega
      have hO : out.length≤B := by dsimp [B]; omega
      have hB : 1≤B := by dsimp [B]; omega
      have hs : B≤B^2 := Nat.le_pow (by decide)
      have hinner : 2*out.length+5*(bit::bits).length+8*padding≤15*B := by omega
      have hEmul := Nat.mul_le_mul hN hinner
      have hIf : (if padding=0 then 4 else 0)≤4 := by split <;> omega
      have hL2 := Nat.mul_le_mul hL hL
      have hR2 := Nat.mul_le_mul hR hR
      change _≤100*B^2
      nlinarith
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.Normalization

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.Preparation
open Turing

def quad (reader temp left right : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) : Fin 4 → Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits :=
  fun k => if k=0 then reader else if k=1 then temp else if k=2 then left else right

@[simp] theorem quad_zero (r t l d : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) : quad r t l d 0=r := by simp [quad]

@[simp] theorem quad_one (r t l d : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) : quad r t l d 1=t := by simp [quad]

@[simp] theorem quad_two (r t l d : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) : quad r t l d 2=l := by simp [quad]

@[simp] theorem quad_three (r t l d : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) : quad r t l d 3=d := by simp [quad]

@[simp] theorem quad_update_zero (r t l d r' : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) :
    Function.update (quad r t l d) 0 r'=quad r' t l d := by
  funext k
  by_cases h : k=0 <;> simp [quad,Function.update_apply,h]

@[simp] theorem quad_update_one (r t l d t' : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) :
    Function.update (quad r t l d) 1 t'=quad r t' l d := by
  funext k
  by_cases h : k=1
  · subst k; simp [quad]
  · by_cases h0 : k=0 <;> simp [quad,h,h0]

@[simp] theorem quad_update_three (r t l d d' : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) :
    Function.update (quad r t l d) 3 d'=quad r t l d' := by
  funext k
  by_cases h0 : k=0
  · subst k; simp [quad]
  · by_cases h1 : k=1
    · subst k; simp [quad]
    · by_cases h2 : k=2
      · subst k; simp [quad]
      · have hk : k=3 := by
          apply Fin.ext
          have h0v : k.val≠0 := fun he => h0 (Fin.ext he)
          have h1v : k.val≠1 := fun he => h1 (Fin.ext he)
          have h2v : k.val≠2 := fun he => h2 (Fin.ext he)
          have hb := k.isLt
          omega
        subst k
        simp [quad]

abbrev Local := Symbol×Symbol
inductive Label where | head | transfer (l : Fin 1) | load deriving DecidableEq,Fintype
instance : Inhabited Label := ⟨.head⟩

def program : Label → TM2.Stmt (fun _ : Fin 4 => Bool) Label Local
  | .head => .pop 0 (fun _ bit => (bit,bit)) (.goto (fun _ => .transfer 0))
  | .transfer l => StackCall.stmt (Fin.castAdd 2) Label.transfer .load Prod.snd
      (fun saved v => (saved.1,v)) (Stacks.transferProgram l)
  | .load => .pop 1 (fun s bit => (s.1,bit)) (.branch (fun s => s.2.isSome)
      (.push 3 (fun s => s.2.getD false) (.push 3 (fun _ => true) (.goto (fun _ => .load)))) .halt)

theorem load_step (bit : Bool) (rest : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (right : List Symbol) (left : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (head saved : Symbol) :
    TM2.step program ⟨some .load,(head,saved),quad [] (bit::rest) left (Simulation.pack right)⟩=
      some ⟨some .load,(head,some bit),quad [] rest left (Simulation.pack (some bit::right))⟩ := by
  simp [TM2.step,program,TM2.stepAux,Simulation.pack]

theorem load_run (bits : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (right : List Symbol) (left : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (head saved : Symbol) :
    Stacks.stackRun program (bits.length+1) ⟨some .load,(head,saved),quad [] bits left (Simulation.pack right)⟩=
      some ⟨none,(head,none),quad [] [] left (Simulation.pack (bits.reverse.map some++right))⟩ := by
  induction bits generalizing right saved with
  | nil => simp [Stacks.stackRun,TM2.step,program,TM2.stepAux]
  | cons bit bits ih =>
    simpa only [List.length_cons,Stacks.stackRun,load_step,Option.bind_some,List.reverse_cons,List.map_append,
      List.map_cons,List.map_nil,List.append_assoc,List.singleton_append] using ih (some bit::right) (some bit)

theorem load_clock (bits : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (right : List Symbol) (left : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (head saved : Symbol) :
    Stacks.stackRunClock program (bits.length+1) ⟨some .load,(head,saved),quad [] bits left (Simulation.pack right)⟩=
      bits.length*(5*bits.length+8*right.length+7)+3 := by
  induction bits generalizing right saved with
  | nil => simp [Stacks.stackRunClock,program,Stacks.stackClock]
  | cons bit bits ih =>
    rw [Stacks.stackRunClock,load_step]
    change 1+Stacks.stackClock (program .load) (head,saved) (quad [] (bit::bits) left (Simulation.pack right))+
      Stacks.stackRunClock program (bits.length+1)
        ⟨some .load,(head,some bit),quad [] bits left (Simulation.pack (some bit::right))⟩=_
    rw [ih]
    simp [program,Stacks.stackClock,Simulation.pack_length]
    ring
def transferFrame (left right : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (S : Fin 2 → Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) : Fin 4 → Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits :=
  quad (S 0) (S 1) left right

theorem transferFrame_at (left right : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (S : Fin 2 → Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (k : Fin 2) :
    transferFrame left right S (Fin.castAdd 2 k)=S k := by
  by_cases h : k=0
  · subst k; rfl
  · have hk : k=1 := by
      apply Fin.ext
      have h0 : k.val≠0 := fun he => h (Fin.ext he)
      have hb := k.isLt
      omega
    subst k
    rfl

theorem transferFrame_update (left right : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (S : Fin 2 → Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (k : Fin 2) (bits : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) :
    transferFrame left right (Function.update S k bits)=Function.update (transferFrame left right S) (Fin.castAdd 2 k) bits := by
  by_cases h : k=0
  · subst k; simp [transferFrame]
  · have hk : k=1 := by
      apply Fin.ext
      have h0 : k.val≠0 := fun he => h (Fin.ext he)
      have hb := k.isLt
      omega
    subst k
    simp [transferFrame]

theorem head_step (input left right : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (saved : Local) :
    TM2.step program ⟨some .head,saved,quad input [] left right⟩=
      some ⟨some (.transfer 0),(input.head?,input.head?),quad input.tail [] left right⟩ := by
  simp [TM2.step,program,TM2.stepAux]

theorem head_clock (input left right : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (saved : Local) :
    Stacks.stackRunClock program 1 ⟨some .head,saved,quad input [] left right⟩=
      input.length+input.tail.length+3 := by
  rw [Stacks.stackRunClock,head_step]
  simp [Stacks.stackRunClock,program,Stacks.stackClock]
  omega

theorem complete (input : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (right : List Symbol) (left : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (saved : Local) :
    Stacks.stackRun program (2*input.tail.length+3)
      ⟨some .head,saved,quad input [] left (Simulation.pack right)⟩=
      some ⟨none,(input.head?,none),quad [] [] left (Simulation.pack (input.tail.map some++right))⟩ ∧
    Stacks.stackRunClock program (2*input.tail.length+3)
      ⟨some .head,saved,quad input [] left (Simulation.pack right)⟩=
      input.tail.length*(7*input.tail.length+8*right.length+13)+input.length+9 := by
  have hcode : ∀ l : Fin 1, program (.transfer l)=StackCall.stmt (Fin.castAdd 2) Label.transfer .load
      Prod.snd (fun saved v => (saved.1,v)) (Stacks.transferProgram l) := fun _ => rfl
  obtain ⟨ht,htc⟩ := StackCall.execution (Fin.castAdd 2) Label.transfer Label.load Prod.snd
    (fun saved v => (saved.1,v)) (transferFrame left (Simulation.pack right))
    (transferFrame_at left (Simulation.pack right)) (transferFrame_update left (Simulation.pack right))
    (fun _ _ => rfl) (fun _ _ _ => rfl) Stacks.transferProgram program hcode
    (input.head?,input.head?) (input.tail.length+1) _ _ (Stacks.transfer_run input.tail [] input.head?)
  have hT : Stacks.stackRun program (input.tail.length+1)
      ⟨some (.transfer 0),(input.head?,input.head?),quad input.tail [] left (Simulation.pack right)⟩=
      some ⟨some .load,(input.head?,none),quad [] input.tail.reverse left (Simulation.pack right)⟩ := by
    simpa only [StackCall.cfg,transferFrame,Stacks.stackPair_zero,Stacks.stackPair_one,List.append_nil] using! ht
  have hTC : Stacks.stackRunClock program (input.tail.length+1)
      ⟨some (.transfer 0),(input.head?,input.head?),quad input.tail [] left (Simulation.pack right)⟩=
      input.tail.length*(2*input.tail.length+5)+3 := by
    simpa only [StackCall.cfg,transferFrame,Stacks.stackPair_zero,Stacks.stackPair_one,List.length_nil,Nat.add_zero]
      using! htc.trans (Stacks.transfer_clock input.tail [] input.head?)
  have hH : Stacks.stackRun program 1 ⟨some .head,saved,quad input [] left (Simulation.pack right)⟩=
      some ⟨some (.transfer 0),(input.head?,input.head?),quad input.tail [] left (Simulation.pack right)⟩ := by
    simpa only [Stacks.stackRun,Option.bind_some] using!
        head_step input left (Simulation.pack right) saved
  have hHT : Stacks.stackRun program (1+(input.tail.length+1))
      ⟨some .head,saved,quad input [] left (Simulation.pack right)⟩=
      some ⟨some .load,(input.head?,none),quad [] input.tail.reverse left (Simulation.pack right)⟩ := by
    rw [Stacks.run_add,hH,Option.bind_some,hT]
  have hL := load_run input.tail.reverse right left input.head? none
  have hLC := load_clock input.tail.reverse right left input.head? none
  simp only [List.length_reverse,List.reverse_reverse] at hL hLC
  have hn : 2*input.tail.length+3=(1+(input.tail.length+1))+(input.tail.length+1) := by omega
  constructor
  · rw [hn,Stacks.run_add,hHT,Option.bind_some]
    exact hL
  · rw [hn,Stacks.clock_add program _ _ _ _ hHT,hLC,
      Stacks.clock_add program _ _ _ _ hH,head_clock,hTC]
    ring

theorem clock_bound (input : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (right : List Symbol) (left : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Bits) (saved : Local) :
    Stacks.stackRunClock program (2*input.tail.length+3)
      ⟨some .head,saved,quad input [] left (Simulation.pack right)⟩≤10*(1+input.length+right.length)^2 := by
  rw [(complete input right left saved).2]
  have hlen : input.tail.length ≤ input.length := by simp
  have hi : 7*input.tail.length+8*right.length+13≤7*input.length+8*right.length+13 := by omega
  have hm := Nat.mul_le_mul hlen hi
  nlinarith [Nat.zero_le (input.length*right.length)]
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.Preparation

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.Subroutine
open Turing Qatlib.Concepts.BitWordCompiler.CanonicalCodec
variable {Λ : Type} [Inhabited Λ]
inductive Label (Λ : Type) where
  | simulate (l : Λ)
  | normalize (l : Normalization.Label)
  | done
  deriving DecidableEq,Fintype
instance : Inhabited (Label Λ) := ⟨.simulate default⟩

def program (M : TM0.Machine Symbol Λ) : Label Λ → TM2.Stmt (fun _ : Fin 3 => Bool) (Label Λ) Symbol
  | .simulate l => StackCall.stmt Fin.castSucc Label.simulate (.normalize .emit) id (fun _ v => v)
      (Simulation.program M l)
  | .normalize l => StackCall.stmt id Label.normalize .done id (fun _ v => v) (Normalization.program l)
  | .done => .halt

theorem simulate (M : TM0.Machine Symbol Λ) (ticks : ℕ)
    (l : Λ) (left right : List Symbol) (head : Symbol)
    (last : TM2.Cfg (fun _ : Fin 2 => Bool) Λ Symbol) (out : Bits)
    (h : Stacks.stackRun (Simulation.program M) ticks (Simulation.cfg l left right head)=some last) :
    Stacks.stackRun (program M) ticks
      ⟨some (.simulate l),head,Parsing.triple (Simulation.pack left) (Simulation.pack right) out⟩=
      some (StackCall.cfg Label.simulate (.normalize .emit) (fun _ v : Symbol => v)
        (Parsing.unaryFrame out) head last) ∧
    Stacks.stackRunClock (program M) ticks
      ⟨some (.simulate l),head,Parsing.triple (Simulation.pack left) (Simulation.pack right) out⟩=
      Stacks.stackRunClock (Simulation.program M) ticks (Simulation.cfg l left right head) ∧
    Stacks.stackRunMaxClock (program M) ticks
      ⟨some (.simulate l),head,Parsing.triple (Simulation.pack left) (Simulation.pack right) out⟩=
      Stacks.stackRunMaxClock (Simulation.program M) ticks (Simulation.cfg l left right head) := by
  have hcode : ∀ l, program M (.simulate l)=StackCall.stmt Fin.castSucc Label.simulate (.normalize .emit)
      id (fun _ v => v) (Simulation.program M l) := fun _ => rfl
  obtain ⟨hr,hc⟩ := StackCall.execution Fin.castSucc Label.simulate (.normalize .emit) id (fun _ v => v)
    (Parsing.unaryFrame out) (Parsing.unaryFrame_at out) (Parsing.unaryFrame_update out)
    (fun _ _ => rfl) (fun _ _ _ => rfl) (Simulation.program M) (program M) hcode head ticks _ _ h
  have hm := StackCall.max_clock Fin.castSucc Label.simulate (.normalize .emit) id (fun _ v => v)
    (Parsing.unaryFrame out) (Parsing.unaryFrame_at out) (Parsing.unaryFrame_update out)
    (fun _ _ => rfl) (fun _ _ _ => rfl) (Simulation.program M) (program M) hcode head ticks _ _ h
  exact ⟨hr,hc,hm⟩

theorem normalize (M : TM0.Machine Symbol Λ) (ticks : ℕ) (head : Symbol) (S : Fin 3 → Bits)
    (last : TM2.Cfg (fun _ : Fin 3 => Bool) Normalization.Label Symbol)
    (h : Stacks.stackRun Normalization.program ticks ⟨some .emit,head,S⟩=some last) :
    Stacks.stackRun (program M) ticks ⟨some (.normalize .emit),head,S⟩=
      some (StackCall.cfg Label.normalize .done (fun _ v : Symbol => v) id head last) ∧
    Stacks.stackRunClock (program M) ticks ⟨some (.normalize .emit),head,S⟩=
      Stacks.stackRunClock Normalization.program ticks ⟨some .emit,head,S⟩ ∧
    Stacks.stackRunMaxClock (program M) ticks ⟨some (.normalize .emit),head,S⟩=
      Stacks.stackRunMaxClock Normalization.program ticks ⟨some .emit,head,S⟩ := by
  have hcode : ∀ l, program M (.normalize l)=StackCall.stmt id Label.normalize .done id
      (fun _ v => v) (Normalization.program l) := fun _ => rfl
  obtain ⟨hr,hc⟩ := StackCall.execution id Label.normalize .done id (fun _ v => v) id
    (fun _ _ => rfl) (fun _ _ _ => rfl) (fun _ _ => rfl) (fun _ _ _ => rfl)
    Normalization.program (program M) hcode head ticks _ _ h
  have hm := StackCall.max_clock id Label.normalize .done id (fun _ v => v) id
    (fun _ _ => rfl) (fun _ _ _ => rfl) (fun _ _ => rfl) (fun _ _ _ => rfl)
    Normalization.program (program M) hcode head ticks _ _ h
  exact ⟨hr,hc,hm⟩

theorem complete [Fintype Λ] (M : TM0.Machine Symbol Λ) (input output : Bits)
    (ticks radius : ℕ) (last : TM0.Cfg Symbol Λ)
    (hrun : run M ticks (TM0.init (input.map some))=some last)
    (hhalt : TM0.step M last=none)
    (htape : last.Tape=Tape.mk₁ (output.map some))
    (hvisit : Visits M (TM0.init (input.map some)) ticks radius) :
    ∃ steps,
      Stacks.stackRun (program M) steps
        ⟨some (.simulate default),(input.map some).headI,
          Parsing.triple [] (Simulation.pack (input.map some).tail) []⟩=
        some ⟨none,none,Parsing.triple [] [] output.reverse⟩ ∧
      Stacks.stackRunClock (program M) steps
        ⟨some (.simulate default),(input.map some).headI,
          Parsing.triple [] (Simulation.pack (input.map some).tail) []⟩≤
        10000*(1+input.length+ticks)^2 ∧
      Stacks.stackRunMaxClock (program M) steps
        ⟨some (.simulate default),(input.map some).headI,
          Parsing.triple [] (Simulation.pack (input.map some).tail) []⟩≤
        10000*(1+input.length+radius)^2 := by
  let first := TM0.init (input.map some) (Λ:=Λ)
  have hf : first.Tape=Simulation.tape [] (input.map some).tail first.Tape.head :=
    Simulation.initial_tape (input.map some)
  obtain ⟨left,right,hT,hS,hsize⟩ :=
      Simulation.execution M ticks first last [] (input.map some).tail hf hrun
  have hh : M last.q last.Tape.head=none := Option.map_eq_none_iff.mp hhalt
  have hSH : Stacks.stackRun (Simulation.program M) (ticks+1)
      (Simulation.cfg first.q [] (input.map some).tail first.Tape.head)=
      some ⟨none,last.Tape.head,Stacks.stackPair (Simulation.pack left) (Simulation.pack right)⟩ := by
    rw [Stacks.run_add,hS,Option.bind_some,Stacks.run_one]
    exact Simulation.halt_step M last.q left right last.Tape.head hh
  have hC := Simulation.execution_clock M ticks first last [] (input.map some).tail hf hrun
  have hCH : Stacks.stackRunClock (Simulation.program M) (ticks+1)
      (Simulation.cfg first.q [] (input.map some).tail first.Tape.head)≤
      ticks*(41*(2*((input.map some).tail.length+ticks)+1))+1 := by
    rw [Stacks.clock_add _ _ 1 _ _ hS,Simulation.halt_clock M last.q left right last.Tape.head hh]
    simpa only [List.length_nil,Nat.zero_add] using Nat.succ_le_succ hC
  have hMH :=
      Simulation.execution_height_visited M ticks first last []
      (input.map some).tail radius hf hrun hvisit
  have hMF := Stacks.maxClock_height (Simulation.program M) ticks
    (Simulation.cfg first.q [] (input.map some).tail first.Tape.head)
  have hMB := hMF.trans (Nat.mul_le_mul (Simulation.program_sweepFactor M) (Nat.succ_le_succ hMH))
  have hMhalt : Stacks.stackRunMaxClock (Simulation.program M) 1
      (Simulation.cfg last.q left right last.Tape.head)=1 := by
    simp only [Stacks.stackRunMaxClock,Simulation.halt_step M last.q left right last.Tape.head hh,
      Simulation.halt_clock M last.q left right last.Tape.head hh,Nat.max_zero]
  have hMCH : Stacks.stackRunMaxClock (Simulation.program M) (ticks+1)
      (Simulation.cfg first.q [] (input.map some).tail first.Tape.head)≤
      41*(2*(2*radius+(input.map some).tail.length)+1) := by
    rw [Stacks.maxClock_add _ _ 1 _ _ hS,hMhalt]
    apply max_le
    · simpa only [List.length_nil,Nat.add_zero] using hMB
    · omega
  obtain ⟨left',right',_,hS',hleft,hright⟩ :=
    Simulation.execution_region M ticks first last [] (input.map some).tail radius hf hrun hvisit
  have heq := Option.some.inj (hS.symm.trans hS')
  have hlen :=
      congrArg (fun c : TM2.Cfg (fun _ : Fin 2 => Bool) Λ Symbol => (c.stk 0).length+(c.stk 1).length) heq
  simp only [Simulation.cfg,Stacks.stackPair_zero,Stacks.stackPair_one,Simulation.pack_length] at hlen
  have hspace : left.length+right.length≤2*radius+(input.map some).tail.length := by
    simp only [List.length_nil,Int.natCast_zero] at hleft
    omega
  have hout : Simulation.tape left right last.Tape.head=Tape.mk₁ (output.map some) :=
      hT.symm.trans htape
  obtain ⟨normTicks,hN,hNC⟩ := Normalization.complete left right last.Tape.head output [] hout
  simp only [List.append_nil,List.length_nil,Nat.add_zero] at hN hNC
  obtain ⟨hA,hAC,hAM⟩ :=
      simulate M (ticks+1) first.q [] (input.map some).tail first.Tape.head _ [] hSH
  simp only [StackCall.cfg,Option.map_none,Option.getD_none,Parsing.unaryFrame,
    Stacks.stackPair_zero,Stacks.stackPair_one] at hA
  change Stacks.stackRun (program M) (ticks+1)
    ⟨some (.simulate default),(input.map some).headI,Parsing.triple [] (Simulation.pack (input.map some).tail) []⟩=_ at hA
  change Stacks.stackRunClock (program M) (ticks+1)
    ⟨some (.simulate default),(input.map some).headI,Parsing.triple [] (Simulation.pack (input.map some).tail) []⟩=_ at hAC
  change Stacks.stackRunMaxClock (program M) (ticks+1)
    ⟨some (.simulate default),(input.map some).headI,Parsing.triple [] (Simulation.pack (input.map some).tail) []⟩=_ at hAM
  obtain ⟨hB,hBC,hBM⟩ := normalize M normTicks last.Tape.head _ _ hN
  simp only [StackCall.cfg,Option.map_none,Option.getD_none,id_eq] at hB
  have hAB : Stacks.stackRun (program M) ((ticks+1)+normTicks)
      ⟨some (.simulate default),(input.map some).headI,
        Parsing.triple [] (Simulation.pack (input.map some).tail) []⟩=
      some ⟨some .done,none,Parsing.triple [] [] output.reverse⟩ := by
    rw [Stacks.run_add,hA,Option.bind_some,hB]
  refine ⟨((ticks+1)+normTicks)+1,?_,?_,?_⟩
  · rw [Stacks.run_add,hAB,Option.bind_some,Stacks.run_one]
    rfl
  · rw [Stacks.clock_add _ _ 1 _ _ hAB]
    have hdone : Stacks.stackRunClock (program M) 1
        ⟨some .done,none,Parsing.triple [] [] output.reverse⟩=1 := rfl
    rw [hdone,Stacks.clock_add _ _ _ _ _ hA,hAC,hBC]
    have htail : (input.map some).tail.length≤input.length := by simp
    have hSC : Stacks.stackRunClock (Simulation.program M) (ticks+1)
        (Simulation.cfg first.q [] (input.map some).tail first.Tape.head)≤
        100*(1+input.length+ticks)^2 := by
      have hprod := Nat.mul_le_mul_left ticks (show 41*(2*((input.map some).tail.length+ticks)+1)≤
        82*(1+input.length+ticks) by omega)
      nlinarith only [hCH,hprod,Nat.zero_le (input.length^2),Nat.zero_le ticks]
    have hsum : 1+(Simulation.pack left).length+(Simulation.pack right).length≤2*(1+input.length+ticks) := by
      simp only [Simulation.pack_length]
      simp only [List.length_nil,Nat.zero_add] at hsize
      omega
    have hsq := Nat.mul_le_mul hsum hsum
    nlinarith only [hSC,hNC,hsq]
  · rw [Stacks.maxClock_add _ _ 1 _ _ hAB]
    have hdone : Stacks.stackRunMaxClock (program M) 1
        ⟨some .done,none,Parsing.triple [] [] output.reverse⟩=1 := rfl
    rw [hdone,Stacks.maxClock_add _ _ _ _ _ hA,hAM,hBM]
    have htail : (input.map some).tail.length≤input.length := by simp
    have hMC : Stacks.stackRunMaxClock (Simulation.program M) (ticks+1)
        (Simulation.cfg first.q [] (input.map some).tail first.Tape.head)≤
        200*(1+input.length+radius)^2 := by
      have hlin : 41*(2*(2*radius+(input.map some).tail.length)+1)≤164*(1+input.length+radius) := by
        omega
      have hp : 1+input.length+radius≤(1+input.length+radius)^2 := Nat.le_pow (by decide)
      omega
    have hNM := Stacks.maxClock_le_clock Normalization.program normTicks
      ⟨some .emit,last.Tape.head,Parsing.triple (Simulation.pack left) (Simulation.pack right) []⟩
    have hsum : 1+(Simulation.pack left).length+(Simulation.pack right).length≤4*(1+input.length+radius) := by
      simp only [Simulation.pack_length]
      omega
    have hsq := Nat.mul_le_mul hsum hsum
    apply max_le (max_le (by omega) (by nlinarith only [hNM,hNC,hsq]))
    have hp : 1+input.length+radius≤(1+input.length+radius)^2 := Nat.le_pow (by decide)
    omega

theorem of_runs {q : ℕ} (M : TM0.Machine Symbol (Fin (q+1)))
    (input output : Bits) (time space : ℕ) (h : Runs M input output time space) :
    ∃ steps,
      Stacks.stackRun (program M) steps
        ⟨some (.simulate 0),(input.map some).headI,
          Parsing.triple [] (Simulation.pack (input.map some).tail) []⟩=
        some ⟨none,none,Parsing.triple [] [] output.reverse⟩ ∧
      Stacks.stackRunClock (program M) steps
        ⟨some (.simulate 0),(input.map some).headI,
          Parsing.triple [] (Simulation.pack (input.map some).tail) []⟩≤
        10000*(1+input.length+time)^2 ∧
      Stacks.stackRunMaxClock (program M) steps
        ⟨some (.simulate 0),(input.map some).headI,
          Parsing.triple [] (Simulation.pack (input.map some).tail) []⟩≤
        10000*(1+input.length+space)^2 := by
  rcases h with ⟨_,ticks,last,ht,hr,hh,_,ho,hl,hv⟩
  have hr' : run M ticks (TM0.init (input.map some))=some last := by
    simpa only [run_initial] using hr
  have hv' : Visits M (TM0.init (input.map some)) ticks space := by
    intro u hu
    simpa only [← headPosition_eq_offset] using hv u hu
  obtain ⟨steps,hs,hc,hm⟩ :=
      complete M input output ticks space last hr' hh (tape_eq_output _ _ ho hl) hv'
  refine ⟨steps,hs,hc.trans ?_,hm⟩
  have hb : 1+input.length+ticks≤1+input.length+time := by omega
  nlinarith only [Nat.mul_le_mul hb hb]
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.Subroutine

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.LoopCore
open Turing Qatlib.Concepts.BitWordCompiler.CanonicalCodec
variable {Λ : Type} [Inhabited Λ]
inductive Slot where
  | counter | temporary | left | right | output | reader
  deriving DecidableEq,Fintype

def store (counter temporary left right output reader : Bits) : Slot → Bits
  | .counter => counter
  | .temporary => temporary
  | .left => left
  | .right => right
  | .output => output
  | .reader => reader

abbrev Local := Symbol×Counter.Local×Symbol

def getHead (v : Local) : Symbol := v.1
def putHead (v : Local) (head : Symbol) : Local := (head,v.2)
def getCounter (v : Local) : Counter.Local := v.2.1
def putCounter (v : Local) (c : Counter.Local) : Local := (v.1,c,v.2.2)
def getIO (v : Local) : Symbol := v.2.2
def putIO (v : Local) (io : Symbol) : Local := (v.1,v.2.1,io)
def getPrep (v : Local) : Preparation.Local := (v.1,v.2.2)
def putPrep (v : Local) (p : Preparation.Local) : Local := (p.1,v.2.1,p.2)

def counterCode (k : Fin 2) : Slot := if k=0 then .counter else .temporary
def machineCode (k : Fin 3) : Slot := if k=0 then .left else if k=1 then .right else .output
def transferCode (k : Fin 2) : Slot := if k=0 then .output else .reader
def prepCode (k : Fin 4) : Slot :=
    if k=0 then .reader else if k=1 then .output else if k=2 then .left else .right
def drainCode (_ : Fin 1) : Slot := .counter

inductive Label (Λ : Type) where
  | counter (l : Counter.Label)
  | branch
  | machine (l : Subroutine.Label Λ)
  | transfer (l : Fin 1)
  | prepare (l : Preparation.Label)
  | normalize (l : Normalization.Label)
  | drain (l : Fin 1)
  | done
  deriving DecidableEq,Fintype
instance : Inhabited (Label Λ) := ⟨.counter .borrow⟩

def program (M : TM0.Machine Symbol Λ) : Label Λ → TM2.Stmt (fun _ : Slot => Bool) (Label Λ) Local
  | .counter l => StackCall.stmt counterCode Label.counter .branch getCounter putCounter (Counter.program l)
  | .branch => .branch (fun v => (getCounter v).1)
      (.goto (fun _ => .machine (.simulate default))) (.goto (fun _ => .normalize .emit))
  | .machine l => StackCall.stmt machineCode Label.machine (.transfer 0) getHead putHead (Subroutine.program M l)
  | .transfer l => StackCall.stmt transferCode Label.transfer (.prepare .head) getIO putIO (Stacks.transferProgram l)
  | .prepare l => StackCall.stmt prepCode Label.prepare (.counter .borrow) getPrep putPrep (Preparation.program l)
  | .normalize l => StackCall.stmt machineCode Label.normalize (.drain 0) getHead putHead (Normalization.program l)
  | .drain l => StackCall.stmt drainCode Label.drain .done getIO putIO (Normalization.drainProgram l)
  | .done => .halt

theorem counterCode_injective : Function.Injective counterCode := by decide

theorem machineCode_injective : Function.Injective machineCode := by decide

theorem transferCode_injective : Function.Injective transferCode := by decide

theorem prepCode_injective : Function.Injective prepCode := by decide

theorem drainCode_injective : Function.Injective drainCode := by decide

def counterFrame (left right output reader : Bits) (S : Fin 2 → Bits) : Slot → Bits :=
    store (S 0) (S 1) left right output reader

theorem counterFrame_at (left right output reader : Bits) (S : Fin 2 → Bits) (k : Fin 2) :
    counterFrame left right output reader S (counterCode k)=S k := by
  fin_cases k <;> rfl

theorem counterFrame_update (left right output reader : Bits) (S : Fin 2 → Bits) (k : Fin 2) (bits : Bits) :
    counterFrame left right output reader (Function.update S k bits)=Function.update (counterFrame left right output reader S) (counterCode k) bits := by
  funext j
  fin_cases k <;> cases j <;> simp [counterFrame,counterCode,store]

def machineFrame (counter temporary reader : Bits) (S : Fin 3 → Bits) : Slot → Bits :=
    store counter temporary (S 0) (S 1) (S 2) reader

theorem machineFrame_at (counter temporary reader : Bits) (S : Fin 3 → Bits) (k : Fin 3) :
    machineFrame counter temporary reader S (machineCode k)=S k := by
  fin_cases k <;> rfl

theorem machineFrame_update (counter temporary reader : Bits) (S : Fin 3 → Bits) (k : Fin 3) (bits : Bits) :
    machineFrame counter temporary reader (Function.update S k bits)=Function.update (machineFrame counter temporary reader S) (machineCode k) bits := by
  funext j
  fin_cases k <;> cases j <;> simp [machineFrame,machineCode,store]

def transferFrame (counter temporary left right : Bits) (S : Fin 2 → Bits) : Slot → Bits :=
    store counter temporary left right (S 0) (S 1)

theorem transferFrame_at (counter temporary left right : Bits) (S : Fin 2 → Bits) (k : Fin 2) :
    transferFrame counter temporary left right S (transferCode k)=S k := by
  fin_cases k <;> rfl

theorem transferFrame_update (counter temporary left right : Bits) (S : Fin 2 → Bits) (k : Fin 2) (bits : Bits) :
    transferFrame counter temporary left right (Function.update S k bits)=Function.update (transferFrame counter temporary left right S) (transferCode k) bits := by
  funext j
  fin_cases k <;> cases j <;> simp [transferFrame,transferCode,store]

def prepFrame (counter temporary : Bits) (S : Fin 4 → Bits) : Slot → Bits :=
    store counter temporary (S 2) (S 3) (S 1) (S 0)

theorem prepFrame_at (counter temporary : Bits) (S : Fin 4 → Bits) (k : Fin 4) :
    prepFrame counter temporary S (prepCode k)=S k := by
  fin_cases k <;> rfl

theorem prepFrame_update (counter temporary : Bits) (S : Fin 4 → Bits) (k : Fin 4) (bits : Bits) :
    prepFrame counter temporary (Function.update S k bits)=Function.update (prepFrame counter temporary S) (prepCode k) bits := by
  funext j
  fin_cases k <;> cases j <;> simp [prepFrame,prepCode,store]

def drainFrame (temporary left right output reader : Bits) (S : Fin 1 → Bits) : Slot → Bits :=
    store (S 0) temporary left right output reader

theorem drainFrame_at (temporary left right output reader : Bits) (S : Fin 1 → Bits) (k : Fin 1) :
    drainFrame temporary left right output reader S (drainCode k)=S k := by
  fin_cases k; rfl

theorem drainFrame_update (temporary left right output reader : Bits) (S : Fin 1 → Bits) (k : Fin 1) (bits : Bits) :
    drainFrame temporary left right output reader (Function.update S k bits)=Function.update (drainFrame temporary left right output reader S) (drainCode k) bits := by
  funext j
  fin_cases k
  cases j <;> simp [drainFrame,drainCode,store]

@[simp] theorem putCounter_get (v : Local) : putCounter v (getCounter v)=v := rfl

@[simp] theorem putHead_get (v : Local) : putHead v (getHead v)=v := rfl

@[simp] theorem putIO_get (v : Local) : putIO v (getIO v)=v := rfl

@[simp] theorem putPrep_get (v : Local) : putPrep v (getPrep v)=v := rfl

theorem decrement_positive (M : TM0.Machine Symbol Λ) (counter left right output reader : Bits) (v : Local)
    (hp : 0<binaryValue counter) :
    ∃ ticks next, next.length=counter.length ∧ binaryValue next+1=binaryValue counter ∧
      Stacks.stackRun (program M) ticks ⟨some (.counter .borrow),v,store counter [] left right output reader⟩=
        some ⟨some .branch,putCounter v (true,none),store next [] left right output reader⟩ ∧
      Stacks.stackRunClock (program M) ticks ⟨some (.counter .borrow),v,store counter [] left right output reader⟩≤
        10*(1+counter.length)^2 := by
  obtain ⟨ticks,next,_,hlen,hval,hr,hc⟩ := Counter.decrement_positive counter (getCounter v) hp
  obtain ⟨hN,hNC⟩ := StackCall.execution counterCode Label.counter Label.branch getCounter putCounter
    (counterFrame left right output reader) (counterFrame_at left right output reader)
    (counterFrame_update left right output reader) (fun _ _ => rfl) (fun _ _ _ => rfl)
    Counter.program (program M) (fun _ => rfl) v ticks _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,
    putCounter_get,counterFrame,Stacks.stackPair_zero,Stacks.stackPair_one] at hN hNC
  exact ⟨ticks,next,hlen,hval,hN,hNC.trans_le hc⟩

theorem decrement_zero (M : TM0.Machine Symbol Λ) (counter left right output reader : Bits) (v : Local)
    (hz : binaryValue counter=0) :
    Stacks.stackRun (program M) (2*counter.length+2)
      ⟨some (.counter .borrow),v,store counter [] left right output reader⟩=
        some ⟨some .branch,putCounter v (false,none),store (List.replicate counter.length true) [] left right output reader⟩ ∧
      Stacks.stackRunClock (program M) (2*counter.length+2)
        ⟨some (.counter .borrow),v,store counter [] left right output reader⟩≤10*(1+counter.length)^2 := by
  obtain ⟨hr,hc⟩ := Counter.decrement_zero counter (getCounter v) hz
  obtain ⟨hN,hNC⟩ := StackCall.execution counterCode Label.counter Label.branch getCounter putCounter
    (counterFrame left right output reader) (counterFrame_at left right output reader)
    (counterFrame_update left right output reader) (fun _ _ => rfl) (fun _ _ _ => rfl)
    Counter.program (program M) (fun _ => rfl) v (2*counter.length+2) _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,
    putCounter_get,counterFrame,Stacks.stackPair_zero,Stacks.stackPair_one] at hN hNC
  exact ⟨hN,hNC.trans_le hc⟩

theorem machine_call {q : ℕ} (M : TM0.Machine Symbol (Fin (q+1)))
    (counter temporary reader input output : Bits) (v : Local) (time space : ℕ)
    (hhead : getHead v=(input.map some).headI) (h : Runs M input output time space) :
    ∃ ticks,
      Stacks.stackRun (program M) ticks
        ⟨some (.machine (.simulate 0)),v,store counter temporary [] (Simulation.pack (input.map some).tail) [] reader⟩=
        some ⟨some (.transfer 0),putHead v none,store counter temporary [] [] output.reverse reader⟩ ∧
      Stacks.stackRunClock (program M) ticks
        ⟨some (.machine (.simulate 0)),v,store counter temporary [] (Simulation.pack (input.map some).tail) [] reader⟩≤
        10000*(1+input.length+time)^2 ∧
      Stacks.stackRunMaxClock (program M) ticks
        ⟨some (.machine (.simulate 0)),v,store counter temporary [] (Simulation.pack (input.map some).tail) [] reader⟩≤
        10000*(1+input.length+space)^2 := by
  obtain ⟨ticks,hr,hc,hm⟩ := Subroutine.of_runs M input output time space h
  obtain ⟨hN,hNC⟩ := StackCall.execution machineCode Label.machine (.transfer 0) getHead putHead
    (machineFrame counter temporary reader) (machineFrame_at counter temporary reader)
    (machineFrame_update counter temporary reader) (fun _ _ => rfl) (fun _ _ _ => rfl)
    (Subroutine.program M) (program M) (fun _ => rfl) v ticks _ _ hr
  have hNM := StackCall.max_clock machineCode Label.machine (.transfer 0) getHead putHead
    (machineFrame counter temporary reader) (machineFrame_at counter temporary reader)
    (machineFrame_update counter temporary reader) (fun _ _ => rfl) (fun _ _ _ => rfl)
    (Subroutine.program M) (program M) (fun _ => rfl) v ticks _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,
    machineFrame,Parsing.triple_zero,Parsing.triple_one,Parsing.triple_two,← hhead,putHead_get] at hN hNC hNM
  exact ⟨ticks,hN,hNC.trans_le (by simpa only [← hhead] using hc),hNM.trans_le (by simpa only [← hhead] using hm)⟩

theorem transfer_call (M : TM0.Machine Symbol Λ) (counter temporary left right word : Bits) (v : Local) :
    Stacks.stackRun (program M) (word.length+1)
      ⟨some (.transfer 0),v,store counter temporary left right word.reverse []⟩=
      some ⟨some (.prepare .head),putIO v none,store counter temporary left right [] word⟩ ∧
    Stacks.stackRunClock (program M) (word.length+1)
      ⟨some (.transfer 0),v,store counter temporary left right word.reverse []⟩=
      word.length*(2*word.length+5)+3 := by
  have hr := Stacks.transfer_run word.reverse [] (getIO v)
  simp only [List.length_reverse,List.reverse_reverse,List.append_nil] at hr
  obtain ⟨hN,hNC⟩ := StackCall.execution transferCode Label.transfer (.prepare .head) getIO putIO
    (transferFrame counter temporary left right) (transferFrame_at counter temporary left right)
    (transferFrame_update counter temporary left right) (fun _ _ => rfl) (fun _ _ _ => rfl)
    Stacks.transferProgram (program M) (fun _ => rfl) v (word.length+1) _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,
    putIO_get,transferFrame,Stacks.stackPair_zero,Stacks.stackPair_one] at hN hNC
  refine ⟨hN,hNC.trans ?_⟩
  simpa only [List.length_reverse,List.length_nil,Nat.add_zero] using
      Stacks.transfer_clock word.reverse [] (getIO v)

theorem preparation_call (M : TM0.Machine Symbol Λ) (counter temporary word : Bits) (v : Local) :
    Stacks.stackRun (program M) (2*word.tail.length+3)
      ⟨some (.prepare .head),v,store counter temporary [] [] [] word⟩=
      some ⟨some (.counter .borrow),putPrep v (word.head?,none),
        store counter temporary [] (Simulation.pack (word.tail.map some)) [] []⟩ ∧
    Stacks.stackRunClock (program M) (2*word.tail.length+3)
      ⟨some (.prepare .head),v,store counter temporary [] [] [] word⟩≤10*(1+word.length)^2 := by
  obtain ⟨hr,_⟩ := Preparation.complete word [] [] (getPrep v)
  have hc := Preparation.clock_bound word [] [] (getPrep v)
  simp only [List.append_nil,List.length_nil,Nat.add_zero,Simulation.pack] at hr hc
  obtain ⟨hN,hNC⟩ := StackCall.execution prepCode Label.prepare (.counter .borrow) getPrep putPrep
    (prepFrame counter temporary) (prepFrame_at counter temporary) (prepFrame_update counter temporary)
    (fun _ _ => rfl) (fun _ _ _ => rfl) Preparation.program (program M) (fun _ => rfl) v
    (2*word.tail.length+3) _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,
    putPrep_get,prepFrame,Preparation.quad_zero,Preparation.quad_one,Preparation.quad_two,
    Preparation.quad_three] at hN hNC
  exact ⟨hN,hNC.trans_le hc⟩

@[simp] theorem head_map_some (word : Bits) : (word.map some).headI=word.head? := by
  cases word <;> rfl

theorem apply_call {q : ℕ} (M : TM0.Machine Symbol (Fin (q+1)))
    (counter input output : Bits) (v : Local) (time space : ℕ)
    (hhead : getHead v=input.head?) (h : Runs M input output time space) :
    ∃ ticks,
      Stacks.stackRun (program M) ticks
        ⟨some (.machine (.simulate 0)),v,store counter [] [] (Simulation.pack (input.tail.map some)) [] []⟩=
        some ⟨some (.counter .borrow),(output.head?,getCounter v,none),
          store counter [] [] (Simulation.pack (output.tail.map some)) [] []⟩ ∧
      Stacks.stackRunClock (program M) ticks
        ⟨some (.machine (.simulate 0)),v,store counter [] [] (Simulation.pack (input.tail.map some)) [] []⟩≤
        20000*(1+input.length+output.length+time)^2 ∧
      Stacks.stackRunMaxClock (program M) ticks
        ⟨some (.machine (.simulate 0)),v,store counter [] [] (Simulation.pack (input.tail.map some)) [] []⟩≤
        20000*(1+input.length+output.length+space)^2 := by
  obtain ⟨ticks,hM,hMC,hMM⟩ := machine_call M counter [] [] input output v time space
    (hhead.trans (head_map_some input).symm) h
  simp only [← List.map_tail] at hM hMC hMM
  obtain ⟨hT,hTC⟩ := transfer_call M counter [] [] [] output (putHead v none)
  obtain ⟨hP,hPC⟩ := preparation_call M counter [] output (putIO (putHead v none) none)
  have hMT : Stacks.stackRun (program M) (ticks+(output.length+1))
      ⟨some (.machine (.simulate 0)),v,store counter [] [] (Simulation.pack (input.tail.map some)) [] []⟩=
      some ⟨some (.prepare .head),putIO (putHead v none) none,store counter [] [] [] [] output⟩ := by
    rw [Stacks.run_add,hM,Option.bind_some,hT]
  refine ⟨(ticks+(output.length+1))+(2*output.tail.length+3),?_,?_,?_⟩
  · rw [Stacks.run_add,hMT,Option.bind_some]
    exact hP
  · rw [Stacks.clock_add _ _ _ _ _ hMT,Stacks.clock_add _ _ _ _ _ hM,hTC]
    have h1 : 1+input.length+time≤1+input.length+output.length+time := by omega
    have h2 : 1+output.length≤1+input.length+output.length+time := by omega
    have h1sq := Nat.mul_le_mul h1 h1
    have h2sq := Nat.mul_le_mul h2 h2
    nlinarith only [hMC,hPC,h1sq,h2sq,Nat.zero_le (output.length^2)]
  · rw [Stacks.maxClock_add _ _ _ _ _ hMT,Stacks.maxClock_add _ _ _ _ _ hM]
    have hTM := Stacks.maxClock_le_clock (program M) (output.length+1)
      ⟨some (.transfer 0),putHead v none,store counter [] [] [] output.reverse []⟩
    rw [hTC] at hTM
    have hPM := Stacks.maxClock_le_clock (program M) (2*output.tail.length+3)
      ⟨some (.prepare .head),putIO (putHead v none) none,store counter [] [] [] [] output⟩
    have h1 : 1+input.length+space≤1+input.length+output.length+space := by omega
    have h2 : 1+output.length≤1+input.length+output.length+space := by omega
    have h1sq := Nat.mul_le_mul h1 h1
    have h2sq := Nat.mul_le_mul h2 h2
    apply max_le
        (max_le (by nlinarith only [hMM,h1sq]) (by nlinarith only [hTM,h2sq,Nat.zero_le (output.length^2)]))
    nlinarith only [hPM,hPC,h2sq]

theorem normalize_call (M : TM0.Machine Symbol Λ) (counter input : Bits) (v : Local)
    (hhead : getHead v=input.head?) :
    ∃ ticks,
      Stacks.stackRun (program M) ticks
        ⟨some (.normalize .emit),v,store counter [] [] (Simulation.pack (input.tail.map some)) [] []⟩=
        some ⟨some (.drain 0),putHead v none,store counter [] [] [] input.reverse []⟩ ∧
      Stacks.stackRunClock (program M) ticks
        ⟨some (.normalize .emit),v,store counter [] [] (Simulation.pack (input.tail.map some)) [] []⟩≤
        400*(1+input.length)^2 := by
  have htape : Simulation.tape [] (input.tail.map some) input.head?=Tape.mk₁ (input.map some) := by
    simpa only [← List.map_tail,head_map_some] using (Simulation.initial_tape (input.map some)).symm
  obtain ⟨ticks,hr,hc⟩ := Normalization.complete [] (input.tail.map some) input.head? input [] htape
  simp only [Simulation.pack,List.append_nil,List.length_nil,Nat.add_zero] at hr hc
  obtain ⟨hN,hNC⟩ := StackCall.execution machineCode Label.normalize (.drain 0) getHead putHead
    (machineFrame counter [] []) (machineFrame_at counter [] []) (machineFrame_update counter [] [])
    (fun _ _ => rfl) (fun _ _ _ => rfl) Normalization.program (program M) (fun _ => rfl) v ticks _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,
    machineFrame,Parsing.triple_zero,Parsing.triple_one,Parsing.triple_two,← hhead,putHead_get] at hN hNC
  rw [hhead] at hNC
  refine ⟨ticks,hN,hNC.trans_le (hc.trans ?_)⟩
  have hlen : input.tail.length≤input.length := by simp
  change 100*(1+(Simulation.pack (input.tail.map some)).length)^2≤400*(1+input.length)^2
  rw [Simulation.pack_length,List.length_map]
  nlinarith only [hlen,Nat.mul_le_mul hlen hlen,Nat.zero_le input.length]

theorem drain_call (M : TM0.Machine Symbol Λ) (counter output : Bits) (v : Local) :
    Stacks.stackRun (program M) (counter.length+1)
      ⟨some (.drain 0),v,store counter [] [] [] output []⟩=
      some ⟨some .done,putIO v none,store [] [] [] [] output []⟩ ∧
    Stacks.stackRunClock (program M) (counter.length+1)
      ⟨some (.drain 0),v,store counter [] [] [] output []⟩=
      counter.length^2+3*counter.length+3 := by
  have hr := Normalization.drain_run counter (getIO v)
  obtain ⟨hN,hNC⟩ := StackCall.execution drainCode Label.drain .done getIO putIO
    (drainFrame [] [] [] output []) (drainFrame_at [] [] [] output [])
    (drainFrame_update [] [] [] output []) (fun _ _ => rfl) (fun _ _ _ => rfl)
    Normalization.drainProgram (program M) (fun _ => rfl) v (counter.length+1) _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,
    drainFrame,Normalization.singleStack_zero,putIO_get] at hN hNC
  exact ⟨hN,hNC.trans (Normalization.drain_clock counter (getIO v))⟩

theorem finish_call (M : TM0.Machine Symbol Λ) (counter input : Bits) (v : Local)
    (hhead : getHead v=input.head?) :
    ∃ ticks,
      Stacks.stackRun (program M) ticks
        ⟨some (.normalize .emit),v,store counter [] [] (Simulation.pack (input.tail.map some)) [] []⟩=
        some ⟨none,(none,getCounter v,none),store [] [] [] [] input.reverse []⟩ ∧
      Stacks.stackRunClock (program M) ticks
        ⟨some (.normalize .emit),v,store counter [] [] (Simulation.pack (input.tail.map some)) [] []⟩≤
        500*(1+input.length)^2+5*(1+counter.length)^2 := by
  obtain ⟨ticks,hN,hNC⟩ := normalize_call M counter input v hhead
  obtain ⟨hD,hDC⟩ := drain_call M counter input.reverse (putHead v none)
  have hND : Stacks.stackRun (program M) (ticks+(counter.length+1))
      ⟨some (.normalize .emit),v,store counter [] [] (Simulation.pack (input.tail.map some)) [] []⟩=
      some ⟨some .done,putIO (putHead v none) none,store [] [] [] [] input.reverse []⟩ := by
    rw [Stacks.run_add,hN,Option.bind_some,hD]
  refine ⟨(ticks+(counter.length+1))+1,?_,?_⟩
  · rw [Stacks.run_add,hND,Option.bind_some,Stacks.run_one]
    rfl
  · rw [Stacks.clock_add _ _ 1 _ _ hND,Stacks.clock_add _ _ _ _ _ hN,hDC]
    have hd : Stacks.stackRunClock (program M) 1
        ⟨some .done,putIO (putHead v none) none,store [] [] [] [] input.reverse []⟩=1 := rfl
    rw [hd]
    nlinarith only [hNC,Nat.zero_le (input.length^2),Nat.zero_le (counter.length^2)]

theorem branch_positive (M : TM0.Machine Symbol Λ) (v : Local) (S : Slot → Bits) :
    Stacks.stackRun (program M) 1 ⟨some .branch,putCounter v (true,none),S⟩=
      some ⟨some (.machine (.simulate default)),putCounter v (true,none),S⟩ := rfl

theorem branch_zero (M : TM0.Machine Symbol Λ) (v : Local) (S : Slot → Bits) :
    Stacks.stackRun (program M) 1 ⟨some .branch,putCounter v (false,none),S⟩=
      some ⟨some (.normalize .emit),putCounter v (false,none),S⟩ := rfl

theorem branch_clock (M : TM0.Machine Symbol Λ) (v : Local) (S : Slot → Bits) :
    Stacks.stackRunClock (program M) 1 ⟨some .branch,v,S⟩=1 := by
  simp [Stacks.stackRunClock,program,Stacks.stackClock]

theorem iterSum_succ_left (f : Bits → Bits) (cost : Bits → ℕ) (n : ℕ) (x : Bits) :
    iterSum f cost (n+1) x=cost x+iterSum f cost n (f x) := by
  induction n with
  | zero => simp [iterSum]
  | succ n ih => rw [iterSum_succ,ih,iterSum_succ,Function.iterate_succ_apply]; omega

def charge (f : Bits → Bits) (cost : Bits → ℕ) (n : ℕ) (x : Bits) : ℕ :=
  1+((f^[n]) x).length+iterSum f (fun y => 1+y.length+(f y).length+cost y) n x

@[simp] theorem charge_zero (f : Bits → Bits) (cost : Bits → ℕ) (x : Bits) :
    charge f cost 0 x=1+x.length := rfl

theorem charge_succ (f : Bits → Bits) (cost : Bits → ℕ) (n : ℕ) (x : Bits) :
    charge f cost (n+1) x=charge f cost n (f x)+(1+x.length+(f x).length+cost x) := by
  simp only [charge,iterSum_succ_left,Function.iterate_succ_apply]
  omega

theorem complete {q : ℕ} (M : TM0.Machine Symbol (Fin (q+1)))
    (f : Bits → Bits) (tf sf : Bits → ℕ) (h : ∀ x, Runs M x (f x) (tf x) (sf x))
    (n : ℕ) (counter input : Bits) (v : Local)
    (hnum : binaryValue counter=n) (hhead : getHead v=input.head?) :
    ∃ ticks,
      Stacks.stackRun (program M) ticks
        ⟨some (.counter .borrow),v,store counter [] [] (Simulation.pack (input.tail.map some)) [] []⟩=
        some ⟨none,(none,(false,none),none),store [] [] [] [] ((f^[n]) input).reverse []⟩ ∧
      Stacks.stackRunClock (program M) ticks
        ⟨some (.counter .borrow),v,store counter [] [] (Simulation.pack (input.tail.map some)) [] []⟩≤
        20*(n+1)*(1+counter.length)^2+20000*(charge f tf n input)^2 ∧
      Stacks.stackRunMaxClock (program M) ticks
        ⟨some (.counter .borrow),v,store counter [] [] (Simulation.pack (input.tail.map some)) [] []⟩≤
        20*(n+1)*(1+counter.length)^2+20000*(charge f sf n input)^2 := by
  induction n generalizing counter input v with
  | zero =>
    obtain ⟨hD,hDC⟩ :=
        decrement_zero M counter [] (Simulation.pack (input.tail.map some)) [] [] v hnum
    have hB :=
        branch_zero M v
        (store (List.replicate counter.length true) [] [] (Simulation.pack (input.tail.map some)) [] [])
    obtain ⟨finishTicks,hF,hFC⟩ :=
        finish_call M (List.replicate counter.length true) input (putCounter v (false,none)) hhead
    have hDB : Stacks.stackRun (program M) ((2*counter.length+2)+1)
        ⟨some (.counter .borrow),v,store counter [] [] (Simulation.pack (input.tail.map some)) [] []⟩=
        some ⟨some (.normalize .emit),putCounter v (false,none),
          store (List.replicate counter.length true) [] [] (Simulation.pack (input.tail.map some)) [] []⟩ := by
      rw [Stacks.run_add,hD,Option.bind_some,hB]
    have hfull : Stacks.stackRun (program M) (((2*counter.length+2)+1)+finishTicks)
        ⟨some (.counter .borrow),v,store counter [] [] (Simulation.pack (input.tail.map some)) [] []⟩=
        some ⟨none,(none,(false,none),none),store [] [] [] [] input.reverse []⟩ := by
      rw [Stacks.run_add,hDB,Option.bind_some]
      exact hF
    have hc : Stacks.stackRunClock (program M) (((2*counter.length+2)+1)+finishTicks)
        ⟨some (.counter .borrow),v,store counter [] [] (Simulation.pack (input.tail.map some)) [] []⟩≤
        20*(1+counter.length)^2+20000*(1+input.length)^2 := by
      rw [Stacks.clock_add _ _ _ _ _ hDB,Stacks.clock_add _ _ 1 _ _ hD,branch_clock]
      simp only [List.length_replicate] at hFC
      have hw : 1≤(1+counter.length)^2 := by
        have hp : 1+counter.length≤(1+counter.length)^2 := Nat.le_pow (by decide)
        omega
      nlinarith only [hDC,hFC,hw,Nat.zero_le ((1+input.length)^2)]
    refine ⟨((2*counter.length+2)+1)+finishTicks,hfull,?_,?_⟩
    · simpa only [charge_zero,Nat.zero_add,Nat.mul_one] using hc
    · exact (Stacks.maxClock_le_clock _ _ _).trans
        (by simpa only [charge_zero,Nat.zero_add,Nat.mul_one] using hc)
  | succ n ih =>
    have hp : 0<binaryValue counter := by omega
    obtain ⟨decTicks,next,hlen,hval,hD,hDC⟩ :=
        decrement_positive M counter [] (Simulation.pack (input.tail.map some)) [] [] v hp
    have hnext : binaryValue next=n := by omega
    have hB := branch_positive M v (store next [] [] (Simulation.pack (input.tail.map some)) [] [])
    obtain ⟨applyTicks,hA,hAC,hAM⟩ := apply_call M next input (f input) (putCounter v (true,none))
      (tf input) (sf input) hhead (h input)
    obtain ⟨iterTicks,hI,hIC,hIM⟩ := ih next (f input) ((f input).head?,(true,none),none) hnext rfl
    have hDB : Stacks.stackRun (program M) (decTicks+1)
        ⟨some (.counter .borrow),v,store counter [] [] (Simulation.pack (input.tail.map some)) [] []⟩=
        some ⟨some (.machine (.simulate 0)),putCounter v (true,none),
          store next [] [] (Simulation.pack (input.tail.map some)) [] []⟩ := by
      rw [Stacks.run_add,hD,Option.bind_some]
      simpa only [Fin.default_eq_zero] using hB
    have hDBA : Stacks.stackRun (program M) ((decTicks+1)+applyTicks)
        ⟨some (.counter .borrow),v,store counter [] [] (Simulation.pack (input.tail.map some)) [] []⟩=
        some ⟨some (.counter .borrow),((f input).head?,(true,none),none),
          store next [] [] (Simulation.pack ((f input).tail.map some)) [] []⟩ := by
      rw [Stacks.run_add,hDB,Option.bind_some,hA]
      rfl
    refine ⟨((decTicks+1)+applyTicks)+iterTicks,?_,?_,?_⟩
    · rw [Stacks.run_add,hDBA,Option.bind_some]
      simpa only [Function.iterate_succ_apply] using hI
    · rw [Stacks.clock_add _ _ _ _ _ hDBA,Stacks.clock_add _ _ _ _ _ hDB,
        Stacks.clock_add _ _ 1 _ _ hD,branch_clock]
      rw [hlen] at hIC
      rw [charge_succ]
      have hw : 1≤(1+counter.length)^2 := by
        have hp : 1+counter.length≤(1+counter.length)^2 := Nat.le_pow (by decide)
        omega
      have hsquare : (charge f tf n (f input))^2+(1+input.length+(f input).length+tf input)^2≤
          (charge f tf n (f input)+(1+input.length+(f input).length+tf input))^2 := by
        nlinarith only [Nat.zero_le (charge f tf n (f input)*(1+input.length+(f input).length+tf input))]
      nlinarith only [hDC,hAC,hIC,hsquare,hw]
    · rw [Stacks.maxClock_add _ _ _ _ _ hDBA,Stacks.maxClock_add _ _ _ _ _ hDB,
        Stacks.maxClock_add _ _ 1 _ _ hD]
      rw [hlen] at hIM
      have hDM := Stacks.maxClock_le_clock (program M) decTicks
        ⟨some (.counter .borrow),v,store counter [] [] (Simulation.pack (input.tail.map some)) [] []⟩
      have hBM := Stacks.maxClock_le_clock (program M) 1
        ⟨some .branch,putCounter v (true,none),store next [] [] (Simulation.pack (input.tail.map some)) [] []⟩
      rw [branch_clock] at hBM
      have hw : 1≤(1+counter.length)^2 := by
        have hp : 1+counter.length≤(1+counter.length)^2 := Nat.le_pow (by decide)
        omega
      have hbudget : 20*(1+counter.length)^2≤
          20*(n+1+1)*(1+counter.length)^2+20000*(charge f sf (n+1) input)^2 := by
        nlinarith only [Nat.zero_le (n*(1+counter.length)^2),Nat.zero_le ((charge f sf (n+1) input)^2)]
      have hpa : 1+input.length+(f input).length+sf input≤charge f sf (n+1) input := by
        rw [charge_succ]; omega
      have hpi : charge f sf n (f input)≤charge f sf (n+1) input := by rw [charge_succ]; omega
      have hsqa := Nat.mul_le_mul hpa hpa
      have hsqi := Nat.mul_le_mul hpi hpi
      apply max_le (max_le (max_le (by omega) (by omega)) ?_) ?_
      · nlinarith only [hAM,hsqa,Nat.zero_le ((n+1+1)*(1+counter.length)^2)]
      · nlinarith only [hIM,hsqi,Nat.zero_le ((1+counter.length)^2)]
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.LoopCore

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.LoopInput
open Turing Qatlib.Concepts.BitWordCompiler.CanonicalCodec LoopCore
variable {Λ : Type} [Inhabited Λ]
inductive Label (Λ : Type) where
  | reader (l : Fin 1)
  | parse (l : Fin 3)
  | counter (l : Fin 1)
  | skip (l : Fin 3)
  | prepare (l : Preparation.Label)
  | loop (l : LoopCore.Label Λ)
  | done
  deriving DecidableEq,Fintype
instance : Inhabited (Label Λ) := ⟨.reader 0⟩

def parseCode (k : Fin 3) : Slot := if k=0 then .reader else if k=1 then .counter else .temporary
def countCode (k : Fin 2) : Slot := if k=0 then .temporary else .counter
def skipCode (k : Fin 2) : Slot := if k=0 then .reader else .temporary

def program (M : TM0.Machine Symbol Λ) : Label Λ → TM2.Stmt (fun _ : Slot => Bool) (Label Λ) Local
  | .reader l => StackCall.stmt transferCode Label.reader (.parse 0) getIO putIO (Stacks.transferProgram l)
  | .parse l => StackCall.stmt parseCode Label.parse (.counter 0) getIO putIO (Parsing.natProgram l)
  | .counter l => StackCall.stmt countCode Label.counter (.skip 0) getIO putIO (Stacks.transferProgram l)
  | .skip l => StackCall.stmt skipCode Label.skip (.prepare .head) getIO putIO (Parsing.skipNatProgram l)
  | .prepare l => StackCall.stmt prepCode Label.prepare (.loop (.counter .borrow)) getPrep putPrep (Preparation.program l)
  | .loop l => StackCall.stmt id Label.loop .done id (fun _ v => v) (LoopCore.program M l)
  | .done => .halt

def parseFrame (S : Fin 3 → Bits) : Slot → Bits := store (S 1) (S 2) [] [] [] (S 0)

theorem parseFrame_at (S : Fin 3 → Bits) (k : Fin 3) : parseFrame S (parseCode k)=S k := by
  fin_cases k <;> rfl

theorem parseFrame_update (S : Fin 3 → Bits) (k : Fin 3) (bits : Bits) :
    parseFrame (Function.update S k bits)=Function.update (parseFrame S) (parseCode k) bits := by
  funext j
  fin_cases k <;> cases j <;> simp [parseFrame,parseCode,store]

def countFrame (reader : Bits) (S : Fin 2 → Bits) : Slot → Bits := store (S 1) (S 0) [] [] [] reader

theorem countFrame_at (reader : Bits) (S : Fin 2 → Bits) (k : Fin 2) : countFrame reader S (countCode k)=S k := by
  fin_cases k <;> rfl

theorem countFrame_update (reader : Bits) (S : Fin 2 → Bits) (k : Fin 2) (bits : Bits) :
    countFrame reader (Function.update S k bits)=Function.update (countFrame reader S) (countCode k) bits := by
  funext j
  fin_cases k <;> cases j <;> simp [countFrame,countCode,store]

def skipFrame (counter : Bits) (S : Fin 2 → Bits) : Slot → Bits :=
    store counter (S 1) [] [] [] (S 0)

theorem skipFrame_at (counter : Bits) (S : Fin 2 → Bits) (k : Fin 2) : skipFrame counter S (skipCode k)=S k := by
  fin_cases k <;> rfl

theorem skipFrame_update (counter : Bits) (S : Fin 2 → Bits) (k : Fin 2) (bits : Bits) :
    skipFrame counter (Function.update S k bits)=Function.update (skipFrame counter S) (skipCode k) bits := by
  funext j
  fin_cases k <;> cases j <;> simp [skipFrame,skipCode,store]

theorem reader_call (M : TM0.Machine Symbol Λ) (input : Bits) (v : Local) :
    Stacks.stackRun (program M) (input.length+1)
      ⟨some (.reader 0),v,store [] [] [] [] input.reverse []⟩=
      some ⟨some (.parse 0),putIO v none,store [] [] [] [] [] input⟩ ∧
    Stacks.stackRunClock (program M) (input.length+1)
      ⟨some (.reader 0),v,store [] [] [] [] input.reverse []⟩=
      input.length*(2*input.length+5)+3 := by
  have hr := Stacks.transfer_run input.reverse [] (getIO v)
  simp only [List.length_reverse,List.reverse_reverse,List.append_nil] at hr
  obtain ⟨hN,hNC⟩ := StackCall.execution transferCode Label.reader (.parse 0) getIO putIO
    (transferFrame [] [] [] []) (transferFrame_at [] [] [] []) (transferFrame_update [] [] [] [])
    (fun _ _ => rfl) (fun _ _ _ => rfl) Stacks.transferProgram (program M) (fun _ => rfl) v
    (input.length+1) _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,
    putIO_get,transferFrame,Stacks.stackPair_zero,Stacks.stackPair_one] at hN hNC
  exact ⟨hN,hNC.trans (by simpa only [List.length_reverse,List.length_nil,Nat.add_zero] using Stacks.transfer_clock input.reverse [] (getIO v))⟩

theorem parse_call (M : TM0.Machine Symbol Λ) (n : ℕ) (rest : Bits) (v : Local) :
    Stacks.stackRun (program M) (2*n.bits.length+3)
      ⟨some (.parse 0),v,store [] [] [] [] [] (natBits n++rest)⟩=
      some ⟨some (.counter 0),putIO v none,store [] n.bits.reverse [] [] [] rest⟩ ∧
    Stacks.stackRunClock (program M) (2*n.bits.length+3)
      ⟨some (.parse 0),v,store [] [] [] [] [] (natBits n++rest)⟩≤40*(1+(natBits n++rest).length)^2 := by
  have hr := Parsing.nat_run n rest [] (getIO v)
  have hc := Parsing.nat_clock_bound n rest [] (getIO v)
  simp only [List.append_nil,List.length_nil,Nat.add_zero] at hr hc
  obtain ⟨hN,hNC⟩ := StackCall.execution parseCode Label.parse (.counter 0) getIO putIO
    parseFrame parseFrame_at parseFrame_update (fun _ _ => rfl) (fun _ _ _ => rfl)
    Parsing.natProgram (program M) (fun _ => rfl) v (2*n.bits.length+3) _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,
    putIO_get,parseFrame,Parsing.triple_zero,Parsing.triple_one,Parsing.triple_two] at hN hNC
  exact ⟨hN,hNC.trans_le hc⟩

theorem counter_call (M : TM0.Machine Symbol Λ) (counter rest : Bits) (v : Local) :
    Stacks.stackRun (program M) (counter.length+1)
      ⟨some (.counter 0),v,store [] counter.reverse [] [] [] rest⟩=
      some ⟨some (.skip 0),putIO v none,store counter [] [] [] [] rest⟩ ∧
    Stacks.stackRunClock (program M) (counter.length+1)
      ⟨some (.counter 0),v,store [] counter.reverse [] [] [] rest⟩=
      counter.length*(2*counter.length+5)+3 := by
  have hr := Stacks.transfer_run counter.reverse [] (getIO v)
  simp only [List.length_reverse,List.reverse_reverse,List.append_nil] at hr
  obtain ⟨hN,hNC⟩ := StackCall.execution countCode Label.counter (.skip 0) getIO putIO
    (countFrame rest) (countFrame_at rest) (countFrame_update rest) (fun _ _ => rfl) (fun _ _ _ => rfl)
    Stacks.transferProgram (program M) (fun _ => rfl) v (counter.length+1) _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,
    putIO_get,countFrame,Stacks.stackPair_zero,Stacks.stackPair_one] at hN hNC
  exact ⟨hN,hNC.trans (by simpa only [List.length_reverse,List.length_nil,Nat.add_zero] using Stacks.transfer_clock counter.reverse [] (getIO v))⟩

theorem skip_call (M : TM0.Machine Symbol Λ) (counter input : Bits) (v : Local) :
    Stacks.stackRun (program M) (2*input.length.bits.length+3)
      ⟨some (.skip 0),v,store counter [] [] [] [] (framed input)⟩=
      some ⟨some (.prepare .head),putIO v none,store counter [] [] [] [] input⟩ ∧
    Stacks.stackRunClock (program M) (2*input.length.bits.length+3)
      ⟨some (.skip 0),v,store counter [] [] [] [] (framed input)⟩≤40*(1+(framed input).length)^2 := by
  obtain ⟨hr,_⟩ := Parsing.skipNat_execution input.length input (getIO v)
  have hc := Parsing.skipNat_clock_bound input.length input (getIO v)
  obtain ⟨hN,hNC⟩ := StackCall.execution skipCode Label.skip (.prepare .head) getIO putIO
    (skipFrame counter) (skipFrame_at counter) (skipFrame_update counter) (fun _ _ => rfl) (fun _ _ _ => rfl)
    Parsing.skipNatProgram (program M) (fun _ => rfl) v (2*input.length.bits.length+3) _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,
    putIO_get,skipFrame,Stacks.stackPair_zero,Stacks.stackPair_one] at hN hNC
  exact ⟨hN,hNC.trans_le hc⟩

theorem prepare_call (M : TM0.Machine Symbol Λ) (counter word : Bits) (v : Local) :
    Stacks.stackRun (program M) (2*word.tail.length+3)
      ⟨some (.prepare .head),v,store counter [] [] [] [] word⟩=
      some ⟨some (.loop (.counter .borrow)),putPrep v (word.head?,none),
        store counter [] [] (Simulation.pack (word.tail.map some)) [] []⟩ ∧
    Stacks.stackRunClock (program M) (2*word.tail.length+3)
      ⟨some (.prepare .head),v,store counter [] [] [] [] word⟩≤10*(1+word.length)^2 := by
  obtain ⟨hr,_⟩ := Preparation.complete word [] [] (getPrep v)
  have hc := Preparation.clock_bound word [] [] (getPrep v)
  simp only [List.append_nil,List.length_nil,Nat.add_zero,Simulation.pack] at hr hc
  obtain ⟨hN,hNC⟩ := StackCall.execution prepCode Label.prepare (.loop (.counter .borrow)) getPrep putPrep
    (prepFrame counter []) (prepFrame_at counter []) (prepFrame_update counter [])
    (fun _ _ => rfl) (fun _ _ _ => rfl) Preparation.program (program M) (fun _ => rfl) v
    (2*word.tail.length+3) _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,
    putPrep_get,prepFrame,Preparation.quad_zero,Preparation.quad_one,Preparation.quad_two,
    Preparation.quad_three] at hN hNC
  exact ⟨hN,hNC.trans_le hc⟩

theorem frontend (M : TM0.Machine Symbol Λ) (n : ℕ) (input : Bits) (v : Local) :
    ∃ ticks,
      Stacks.stackRun (program M) ticks
        ⟨some (.reader 0),v,store [] [] [] [] (natBits n++framed input).reverse []⟩=
        some ⟨some (.loop (.counter .borrow)),(input.head?,getCounter v,none),
          store n.bits [] [] (Simulation.pack (input.tail.map some)) [] []⟩ ∧
      Stacks.stackRunClock (program M) ticks
        ⟨some (.reader 0),v,store [] [] [] [] (natBits n++framed input).reverse []⟩≤
        200*(1+(natBits n++framed input).length)^2 := by
  let raw := natBits n++framed input
  let v1 := putIO v none
  let v2 := putIO v1 none
  let v3 := putIO v2 none
  let v4 := putIO v3 none
  obtain ⟨hR,hRC⟩ := reader_call M raw v
  obtain ⟨hN,hNC⟩ := parse_call M n (framed input) v1
  obtain ⟨hC,hCC⟩ := counter_call M n.bits (framed input) v2
  obtain ⟨hS,hSC⟩ := skip_call M n.bits input v3
  obtain ⟨hP,hPC⟩ := prepare_call M n.bits input v4
  have hRN : Stacks.stackRun (program M) ((raw.length+1)+(2*n.bits.length+3))
      ⟨some (.reader 0),v,store [] [] [] [] raw.reverse []⟩=
      some ⟨some (.counter 0),v2,store [] n.bits.reverse [] [] [] (framed input)⟩ := by
    rw [Stacks.run_add,hR,Option.bind_some]
    exact hN
  have hRNC : Stacks.stackRun (program M) (((raw.length+1)+(2*n.bits.length+3))+(n.bits.length+1))
      ⟨some (.reader 0),v,store [] [] [] [] raw.reverse []⟩=
      some ⟨some (.skip 0),v3,store n.bits [] [] [] [] (framed input)⟩ := by
    rw [Stacks.run_add,hRN,Option.bind_some]
    exact hC
  have hRNCS : Stacks.stackRun (program M)
      ((((raw.length+1)+(2*n.bits.length+3))+(n.bits.length+1))+(2*input.length.bits.length+3))
      ⟨some (.reader 0),v,store [] [] [] [] raw.reverse []⟩=
      some ⟨some (.prepare .head),v4,store n.bits [] [] [] [] input⟩ := by
    rw [Stacks.run_add,hRNC,Option.bind_some]
    exact hS
  refine ⟨((((raw.length+1)+(2*n.bits.length+3))+(n.bits.length+1))+(2*input.length.bits.length+3))+
    (2*input.tail.length+3),?_,?_⟩
  · rw [Stacks.run_add,hRNCS,Option.bind_some]
    exact hP
  · rw [Stacks.clock_add _ _ _ _ _ hRNCS,Stacks.clock_add _ _ _ _ _ hRNC,
      Stacks.clock_add _ _ _ _ _ hRN,Stacks.clock_add _ _ _ _ _ hR,hRC,hCC]
    have hx : input.length≤raw.length := by
      simp only [raw,framed,List.length_append,natBits_length]; omega
    have hn : n.bits.length≤raw.length := by
      simp only [raw,framed,List.length_append,natBits_length]; omega
    have hf : (framed input).length≤raw.length := by
      dsimp [raw]; simp only [List.length_append]; omega
    have hx1 : 1+input.length≤1+raw.length := by omega
    have hf1 : 1+(framed input).length≤1+raw.length := by omega
    have hxsq := Nat.mul_le_mul hx1 hx1
    have hfsq := Nat.mul_le_mul hf1 hf1
    have hnsq := Nat.mul_le_mul hn hn
    nlinarith only [hNC,hSC,hPC,hxsq,hfsq,hnsq,hn,Nat.zero_le raw.length,Nat.zero_le (raw.length^2)]

theorem charge_bound (f : Bits → Bits) (cost : Bits → ℕ) (n : ℕ) (input : Bits) :
    charge f cost n input≤2*(1+n+((f^[n]) input).length+iterSum f cost n input+iterSum f List.length n input) := by
  have htel : charge f cost n input+input.length=
      1+2*((f^[n]) input).length+n+2*iterSum f List.length n input+iterSum f cost n input := by
    induction n generalizing input with
    | zero => simp [charge_zero,iterSum]; omega
    | succ n ih =>
      rw [charge_succ,iterSum_succ_left,iterSum_succ_left,Function.iterate_succ_apply]
      have hi := ih (f input)
      omega
  omega

theorem counter_budget (n : ℕ) : 20*(n+1)*(1+n.bits.length)^2≤220*(1+n)^2 := by
  have hrepeat := Counter.repeated_counter_budget n
  have hw := Counter.bits_length_le n
  have hw' : 1+n.bits.length≤1+n := by omega
  have hsq := Nat.mul_le_mul hw' hw'
  nlinarith only [hrepeat,hsq]

def budgetBase (f : Bits → Bits) (cost : Bits → ℕ) (n : ℕ) (input : Bits) : ℕ :=
  1+(natBits n++framed input).length+n+((f^[n]) input).length+
    iterSum f cost n input+iterSum f List.length n input

theorem resource_bound (f : Bits → Bits) (cost : Bits → ℕ) (n : ℕ) (input : Bits) :
    200*(1+(natBits n++framed input).length)^2+20*(n+1)*(1+n.bits.length)^2+
        20000*(charge f cost n input)^2+1≤100000*(budgetBase f cost n input)^2 := by
  have hc := counter_budget n
  have hcharge := charge_bound f cost n input
  have hR : 1+(natBits n++framed input).length≤budgetBase f cost n input := by
    dsimp [budgetBase]; omega
  have hN : 1+n≤budgetBase f cost n input := by dsimp [budgetBase]; omega
  have hC : charge f cost n input≤2*budgetBase f cost n input := by dsimp [budgetBase]; omega
  have hR2 := Nat.mul_le_mul hR hR
  have hN2 := Nat.mul_le_mul hN hN
  have hC2 := Nat.mul_le_mul hC hC
  have hB : 1≤(budgetBase f cost n input)^2 := by
    have hb : budgetBase f cost n input≤(budgetBase f cost n input)^2 := Nat.le_pow (by decide)
    omega
  nlinarith only [hc,hR2,hN2,hC2,hB]

theorem output_store (word : Bits) : store [] [] [] [] word []=Function.update (fun _ => []) Slot.output word := by
  funext k
  cases k <;> rfl

omit [Inhabited Λ] in

theorem init_eq (word : Bits) :
    (TM2.init Slot.output word : TM2.Cfg (fun _ : Slot => Bool) (Label Λ) Local)=
      ⟨some (.reader 0),default,store [] [] [] [] word []⟩ := by
  rw [output_store]
  rfl

theorem complete {q : ℕ} (M : TM0.Machine Symbol (Fin (q+1)))
    (f : Bits → Bits) (tf sf : Bits → ℕ) (h : ∀ x, Runs M x (f x) (tf x) (sf x))
    (n : ℕ) (input : Bits) :
    ∃ ticks,
      Stacks.stackRun (program M) ticks (TM2.init Slot.output (natBits n++framed input).reverse)=
        some ⟨none,(none,(false,none),none),Function.update (fun _ => []) Slot.output ((f^[n]) input).reverse⟩ ∧
      Stacks.stackRunClock (program M) ticks (TM2.init Slot.output (natBits n++framed input).reverse)≤
        100000*(budgetBase f tf n input)^2 ∧
      Stacks.stackRunMaxClock (program M) ticks (TM2.init Slot.output (natBits n++framed input).reverse)≤
        100000*(budgetBase f sf n input)^2 := by
  obtain ⟨prefixTicks,hP,hPC⟩ := frontend M n input default
  let v : Local := (input.head?,getCounter default,none)
  obtain ⟨loopTicks,hL,hLC,hLM⟩ :=
      LoopCore.complete M f tf sf h n n.bits input v (binaryValue_bits n) rfl
  obtain ⟨hN,hNC⟩ := StackCall.execution id Label.loop .done id (fun _ v => v) id
    (fun _ _ => rfl) (fun _ _ _ => rfl) (fun _ _ => rfl) (fun _ _ _ => rfl)
    (LoopCore.program M) (program M) (fun _ => rfl) v loopTicks _ _ hL
  have hNM := StackCall.max_clock id Label.loop .done id (fun _ v => v) id
    (fun _ _ => rfl) (fun _ _ _ => rfl) (fun _ _ => rfl) (fun _ _ _ => rfl)
    (LoopCore.program M) (program M) (fun _ => rfl) v loopTicks _ _ hL
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,id_eq] at hN hNC hNM
  rw [init_eq]
  have hPN : Stacks.stackRun (program M) (prefixTicks+loopTicks)
      ⟨some (.reader 0),default,store [] [] [] [] (natBits n++framed input).reverse []⟩=
      some ⟨some .done,(none,(false,none),none),store [] [] [] [] ((f^[n]) input).reverse []⟩ := by
    rw [Stacks.run_add,hP,Option.bind_some]
    exact hN
  have hdone : Stacks.stackRunClock (program M) 1
      ⟨some .done,(none,(false,none),none),store [] [] [] [] ((f^[n]) input).reverse []⟩=1 := rfl
  refine ⟨(prefixTicks+loopTicks)+1,?_,?_,?_⟩
  · rw [Stacks.run_add,hPN,Option.bind_some,Stacks.run_one]
    rw [← output_store]
    rfl
  · rw [Stacks.clock_add _ _ 1 _ _ hPN,hdone,Stacks.clock_add _ _ _ _ _ hP,hNC]
    exact (Nat.add_le_add_right (Nat.add_le_add hPC hLC) 1).trans
        (by simpa only [Nat.add_assoc] using resource_bound f tf n input)
  · rw [Stacks.maxClock_add _ _ 1 _ _ hPN,Stacks.maxClock_add _ _ _ _ _ hP,hNM]
    have hd : Stacks.stackRunMaxClock (program M) 1
        ⟨some .done,(none,(false,none),none),store [] [] [] [] ((f^[n]) input).reverse []⟩=1 := rfl
    rw [hd]
    have hPM := Stacks.maxClock_le_clock (program M) prefixTicks
      ⟨some (.reader 0),default,store [] [] [] [] (natBits n++framed input).reverse []⟩
    have hb := resource_bound f sf n input
    omega
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.LoopInput

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM
open Turing Qatlib.Concepts.BitWordCompiler.CanonicalCodec

theorem uniform_iterates (f : Bits → Bits) (tf sf : Bits → ℕ) (hf : ComputesAt f tf sf) :
    ∃ (q : ℕ) (M : TM0.Machine Symbol (Fin (q+1))) (C : ℕ), 0<C ∧
      ∀ n x, Runs M (natBits n++framed x) ((f^[n]) x)
        (C*(1+(natBits n++framed x).length+n+((f^[n]) x).length+
          iterSum f tf n x+iterSum f List.length n x)^2)
        (C*(1+(natBits n++framed x).length+n+((f^[n]) x).length+
          iterSum f sf n x+iterSum f List.length n x)^2) := by
  obtain ⟨q,M,hM⟩ := hf
  obtain ⟨qN,N,C,hC,hN⟩ :=
      Stacks.raw_compiler_separate (LoopInput.program M) LoopCore.Slot.output LoopCore.Slot.output
  refine ⟨qN,N,100002*C,Nat.mul_pos (by decide) hC,?_⟩
  intro n x
  obtain ⟨steps,hr,ht,hs⟩ := LoopInput.complete M f tf sf hM n x
  have hRuns := hN (natBits n++framed x) ((f^[n]) x) steps (none,(false,none),none) hr
  have budget (cost : Bits → ℕ) :
      (1+(natBits n++framed x).length)^2+100000*(LoopInput.budgetBase f cost n x)^2+
        (1+((f^[n]) x).length)^2≤100002*(LoopInput.budgetBase f cost n x)^2 := by
    have hi : 1+(natBits n++framed x).length≤LoopInput.budgetBase f cost n x := by
      dsimp [LoopInput.budgetBase]; omega
    have ho : 1+((f^[n]) x).length≤LoopInput.budgetBase f cost n x := by
      dsimp [LoopInput.budgetBase]; omega
    nlinarith only [Nat.mul_le_mul hi hi,Nat.mul_le_mul ho ho]
  apply runs_mono hRuns
  · calc
      _ ≤ C*((1+(natBits n++framed x).length)^2+100000*(LoopInput.budgetBase f tf n x)^2+
          (1+((f^[n]) x).length)^2) := Nat.mul_le_mul_left C (by omega)
      _ ≤ C*(100002*(LoopInput.budgetBase f tf n x)^2) := Nat.mul_le_mul_left C (budget tf)
      _ = _ := by dsimp [LoopInput.budgetBase]; ring
  · calc
      _ ≤ C*((1+(natBits n++framed x).length)^2+100000*(LoopInput.budgetBase f sf n x)^2+
          (1+((f^[n]) x).length)^2) := Nat.mul_le_mul_left C (by omega)
      _ ≤ C*(100002*(LoopInput.budgetBase f sf n x)^2) := Nat.mul_le_mul_left C (budget sf)
      _ = _ := by dsimp [LoopInput.budgetBase]; ring
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.Increment
open Turing Qatlib.Concepts.BitWordCompiler.CanonicalCodec

def word : Bits → Bits
  | [] => [true]
  | false::rest => true::rest
  | true::rest => false::word rest

theorem word_value (bits : Bits) : binaryValue (word bits)=binaryValue bits+1 := by
  induction bits with
  | nil => rfl
  | cons bit bits ih =>
    cases bit <;> simp [word,binaryValue] at ih ⊢
    omega

theorem word_bits (n : ℕ) : word n.bits=(n+1).bits := by
  induction n using Nat.binaryRec' with
  | zero => rfl
  | bit b n h ih =>
    rw [Nat.bits_append_bit n b h]
    cases b with
    | false =>
      have hn : Nat.bit false n+1=Nat.bit true n := by simp [Nat.bit]
      rw [hn,Nat.bits_append_bit n true (by simp)]
      rfl
    | true =>
      have hn : Nat.bit true n+1=Nat.bit false (n+1) := by simp [Nat.bit]; omega
      rw [hn,Nat.bits_append_bit (n+1) false (by omega)]
      simp only [word,ih]

inductive Label where | carry | restore deriving DecidableEq,Fintype
instance : Inhabited Label := ⟨.carry⟩
def program : Label → TM2.Stmt (fun _ : Fin 2 => Bool) Label Symbol
  | .carry => .pop 0 (fun _ bit => bit) (.branch (fun bit => bit.getD false)
      (.push 1 (fun _ => false) (.goto (fun _ => .carry)))
      (.push 1 (fun _ => true) (.goto (fun _ => .restore))))
  | .restore => .pop 1 (fun _ bit => bit) (.branch (fun bit => bit.isSome)
      (.push 0 (fun bit => bit.getD false) (.goto (fun _ => .restore))) .halt)

theorem carry_true (bits temp : Bits) (v : Symbol) :
    TM2.step program ⟨some .carry,v,Stacks.stackPair (true::bits) temp⟩=
      some ⟨some .carry,some true,Stacks.stackPair bits (false::temp)⟩ := by
  simp [TM2.step,program,TM2.stepAux]

theorem carry_false (bits temp : Bits) (v : Symbol) :
    TM2.step program ⟨some .carry,v,Stacks.stackPair (false::bits) temp⟩=
      some ⟨some .restore,some false,Stacks.stackPair bits (true::temp)⟩ := by
  simp [TM2.step,program,TM2.stepAux]

theorem carry_empty (temp : Bits) (v : Symbol) :
    TM2.step program ⟨some .carry,v,Stacks.stackPair [] temp⟩=
      some ⟨some .restore,none,Stacks.stackPair [] (true::temp)⟩ := by
  simp [TM2.step,program,TM2.stepAux]

theorem restore_step (counter temp : Bits) (bit : Bool) (v : Symbol) :
    TM2.step program ⟨some .restore,v,Stacks.stackPair counter (bit::temp)⟩=
      some ⟨some .restore,some bit,Stacks.stackPair (bit::counter) temp⟩ := by
  simp [TM2.step,program,TM2.stepAux]

theorem restore_run (counter temp : Bits) (v : Symbol) :
    Stacks.stackRun program (temp.length+1) ⟨some .restore,v,Stacks.stackPair counter temp⟩=
      some ⟨none,none,Stacks.stackPair (temp.reverse++counter) []⟩ := by
  induction temp generalizing counter v with
  | nil => simp [Stacks.stackRun,TM2.step,program,TM2.stepAux]
  | cons bit temp ih =>
    simpa only [List.length_cons,Stacks.stackRun,restore_step,Option.bind_some,List.reverse_cons,
      List.append_assoc,List.singleton_append] using ih (bit::counter) (some bit)

theorem restore_clock (counter temp : Bits) (v : Symbol) :
    Stacks.stackRunClock program (temp.length+1) ⟨some .restore,v,Stacks.stackPair counter temp⟩=
      temp.length*(2*(temp.length+counter.length)+5)+3 := by
  induction temp generalizing counter v with
  | nil => simp [Stacks.stackRunClock,program,Stacks.stackClock]
  | cons bit temp ih =>
    rw [Stacks.stackRunClock,restore_step]
    change 1+Stacks.stackClock (program .restore) v (Stacks.stackPair counter (bit::temp))+
      Stacks.stackRunClock program (temp.length+1) ⟨some .restore,some bit,Stacks.stackPair (bit::counter) temp⟩=_
    rw [ih]
    simp [program,Stacks.stackClock]
    ring

theorem finite_carry_run (ones : ℕ) (rest temp : Bits) (v : Symbol) :
    Stacks.stackRun program (2*ones+temp.length+3)
      ⟨some .carry,v,Stacks.stackPair (List.replicate ones true++false::rest) temp⟩=
      some ⟨none,none,Stacks.stackPair (temp.reverse++List.replicate ones false++true::rest) []⟩ := by
  induction ones generalizing temp v with
  | zero =>
    have ht := restore_run rest (true::temp) (some false)
    simpa only [Nat.mul_zero,Nat.zero_add,List.replicate_zero,List.nil_append,List.length_cons,
      Stacks.stackRun,carry_false,Option.bind_some,List.reverse_cons,List.append_assoc,List.singleton_append] using ht
  | succ ones ih =>
    have ht := ih (false::temp) (some true)
    have hn : 2*(ones+1)+temp.length+3=(2*ones+(false::temp).length+3)+1 := by simp; omega
    rw [hn,Stacks.stackRun]
    simp only [List.replicate_succ,List.cons_append,carry_true,Option.bind_some]
    convert! ht using 1
    simp [List.reverse_cons,List.append_assoc]

theorem finite_carry_clock (ones : ℕ) (rest temp : Bits) (v : Symbol) :
    Stacks.stackRunClock program (2*ones+temp.length+3)
      ⟨some .carry,v,Stacks.stackPair (List.replicate ones true++false::rest) temp⟩=
      (2*ones+temp.length+2)*(2*(ones+1+rest.length+temp.length)+5)+3 := by
  induction ones generalizing temp v with
  | zero =>
    simp only [Nat.mul_zero,Nat.zero_add,List.replicate_zero,List.nil_append]
    rw [Stacks.stackRunClock,carry_false]
    change 1+Stacks.stackClock (program .carry) v (Stacks.stackPair (false::rest) temp)+
      Stacks.stackRunClock program ((true::temp).length+1) ⟨some .restore,some false,Stacks.stackPair rest (true::temp)⟩=_
    rw [restore_clock]
    simp [program,Stacks.stackClock]
    ring
  | succ ones ih =>
    have hn : 2*(ones+1)+temp.length+3=(2*ones+(false::temp).length+3)+1 := by simp; omega
    simp only [List.replicate_succ,List.cons_append]
    rw [hn,Stacks.stackRunClock,carry_true]
    change 1+Stacks.stackClock (program .carry) v
      (Stacks.stackPair (true::(List.replicate ones true++false::rest)) temp)+
      Stacks.stackRunClock program (2*ones+(false::temp).length+3)
        ⟨some .carry,some true,Stacks.stackPair (List.replicate ones true++false::rest) (false::temp)⟩=_
    rw [ih]
    simp [program,Stacks.stackClock]
    ring

theorem overflow_run (ones : ℕ) (temp : Bits) (v : Symbol) :
    Stacks.stackRun program (2*ones+temp.length+3)
      ⟨some .carry,v,Stacks.stackPair (List.replicate ones true) temp⟩=
      some ⟨none,none,Stacks.stackPair (temp.reverse++List.replicate ones false++[true]) []⟩ := by
  induction ones generalizing temp v with
  | zero =>
    have ht := restore_run [] (true::temp) none
    simpa only [Nat.mul_zero,Nat.zero_add,List.replicate_zero,List.nil_append,List.length_cons,
      Stacks.stackRun,carry_empty,Option.bind_some,List.reverse_cons,List.append_nil] using ht
  | succ ones ih =>
    have ht := ih (false::temp) (some true)
    have hn : 2*(ones+1)+temp.length+3=(2*ones+(false::temp).length+3)+1 := by simp; omega
    rw [hn,Stacks.stackRun]
    simp only [List.replicate_succ,carry_true,Option.bind_some]
    convert! ht using 1
    simp [List.reverse_cons,List.append_assoc]

theorem overflow_clock (ones : ℕ) (temp : Bits) (v : Symbol) :
    Stacks.stackRunClock program (2*ones+temp.length+3)
      ⟨some .carry,v,Stacks.stackPair (List.replicate ones true) temp⟩=
      ones*(2*(ones+temp.length)+5)+(ones+temp.length+2)*(2*(ones+temp.length)+7)+2 := by
  induction ones generalizing temp v with
  | zero =>
    simp only [Nat.mul_zero,Nat.zero_add,List.replicate_zero]
    rw [Stacks.stackRunClock,carry_empty]
    change 1+Stacks.stackClock (program .carry) v (Stacks.stackPair [] temp)+
      Stacks.stackRunClock program ((true::temp).length+1) ⟨some .restore,none,Stacks.stackPair [] (true::temp)⟩=_
    rw [restore_clock]
    simp [program,Stacks.stackClock]
    ring
  | succ ones ih =>
    have hn : 2*(ones+1)+temp.length+3=(2*ones+(false::temp).length+3)+1 := by simp; omega
    simp only [List.replicate_succ]
    rw [hn,Stacks.stackRunClock,carry_true]
    change 1+Stacks.stackClock (program .carry) v (Stacks.stackPair (true::List.replicate ones true) temp)+
      Stacks.stackRunClock program (2*ones+(false::temp).length+3)
        ⟨some .carry,some true,Stacks.stackPair (List.replicate ones true) (false::temp)⟩=_
    rw [ih]
    simp [program,Stacks.stackClock]
    ring

theorem true_split (bits : Bits) :
    (∃ (ones : ℕ) (rest : Bits),bits=List.replicate ones true++false::rest) ∨
      bits=List.replicate bits.length true := by
  induction bits with
  | nil => exact Or.inr rfl
  | cons bit bits ih =>
    cases bit with
    | false => exact Or.inl ⟨0,bits,rfl⟩
    | true =>
      rcases ih with ⟨ones,rest,rfl⟩ | hi
      · exact Or.inl ⟨ones+1,rest,by simp [List.replicate_succ]⟩
      · exact Or.inr
          (by simpa only [List.length_cons,List.replicate_succ] using congrArg (true::·) hi)

theorem finite_word (ones : ℕ) (rest : Bits) :
    word (List.replicate ones true++false::rest)=List.replicate ones false++true::rest := by
  induction ones with
  | zero => rfl
  | succ ones ih => simpa only [List.replicate_succ,List.cons_append,word] using congrArg (false::·) ih

theorem overflow_word (ones : ℕ) : word (List.replicate ones true)=List.replicate ones false++[true] := by
  induction ones with
  | zero => rfl
  | succ ones ih => simpa only [List.replicate_succ,List.cons_append,word] using congrArg (false::·) ih

theorem complete (bits temp : Bits) (v : Symbol) :
    ∃ ticks, ticks≤2*bits.length+temp.length+3 ∧
      Stacks.stackRun program ticks ⟨some .carry,v,Stacks.stackPair bits temp⟩=
        some ⟨none,none,Stacks.stackPair (temp.reverse++word bits) []⟩ ∧
      Stacks.stackRunClock program ticks ⟨some .carry,v,Stacks.stackPair bits temp⟩≤
        50*(1+bits.length+temp.length)^2 := by
  rcases true_split bits with ⟨ones,rest,rfl⟩ | he
  · refine ⟨2*ones+temp.length+3,?_,?_,?_⟩
    · simp only [List.length_append,List.length_replicate,List.length_cons]; omega
    · simpa only [finite_word,List.append_assoc] using finite_carry_run ones rest temp v
    · rw [finite_carry_clock]
      let B := 1+(List.replicate ones true++false::rest).length+temp.length
      change _≤50*B^2
      have ha : 2*ones+temp.length+2≤2*B := by
        dsimp [B]; simp only [List.length_append,List.length_replicate,List.length_cons]; omega
      have hb : 2*(ones+1+rest.length+temp.length)+5≤7*B := by
        dsimp [B]; simp only [List.length_append,List.length_replicate,List.length_cons]; omega
      have hm := Nat.mul_le_mul ha hb
      have hp : 1≤B^2 := (show 1≤B by dsimp [B]; omega).trans (Nat.le_pow (by decide))
      nlinarith only [hm,hp]
  · have hrun := overflow_run bits.length temp v
    have hclock := overflow_clock bits.length temp v
    rw [← he] at hrun hclock
    refine ⟨2*bits.length+temp.length+3,le_rfl,?_,?_⟩
    · have hi : word bits=List.replicate bits.length false++[true] := by
        calc
          word bits=word (List.replicate bits.length true) := congrArg word he
          _ = _ := overflow_word bits.length
      simpa only [hi,List.append_assoc] using hrun
    · rw [hclock]
      let B := 1+bits.length+temp.length
      change _≤50*B^2
      have h1 : bits.length≤B := by dsimp [B]; omega
      have h2 : 2*(bits.length+temp.length)+5≤5*B := by dsimp [B]; omega
      have h3 : bits.length+temp.length+2≤2*B := by dsimp [B]; omega
      have h4 : 2*(bits.length+temp.length)+7≤7*B := by dsimp [B]; omega
      have hm1 := Nat.mul_le_mul h1 h2
      have hm2 := Nat.mul_le_mul h3 h4
      have hp : 1≤B^2 := (show 1≤B by dsimp [B]; omega).trans (Nat.le_pow (by decide))
      nlinarith only [hm1,hm2,hp]

theorem clog_two_succ (n : ℕ) : Nat.clog 2 (n+1)=n.bits.length := by
  rw [Nat.size_eq_bits_len]
  apply Nat.le_antisymm
  · apply (Nat.clog_le_iff_le_pow (by decide)).2
    have h := Nat.lt_size_self n
    omega
  · apply Nat.size_le.2
    have h := Nat.le_pow_clog (b:=2) (by decide) (n+1)
    omega
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.Increment

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.NatEmit
open Turing Qatlib.Concepts.BitWordCompiler.CanonicalCodec
inductive Label where | count | restore1 (l : Fin 1) | emit | restore2 (l : Fin 1) | done deriving DecidableEq,Fintype
instance : Inhabited Label := ⟨.count⟩
def swap (k : Fin 2) : Fin 3 := if k=0 then 1 else 0

def program : Label → TM2.Stmt (fun _ : Fin 3 => Bool) Label Symbol
  | .count => .pop 0 (fun _ bit => bit) (.branch (fun bit => bit.isSome)
      (.push 1 (fun bit => bit.getD false) (.push 2 (fun _ => true) (.goto (fun _ => .count))))
      (.push 2 (fun _ => false) (.goto (fun _ => .restore1 0))))
  | .restore1 l => StackCall.stmt swap Label.restore1 .emit id (fun _ v => v) (Stacks.transferProgram l)
  | .emit => .pop 0 (fun _ bit => bit) (.branch (fun bit => bit.isSome)
      (.push 1 (fun bit => bit.getD false) (.push 2 (fun bit => bit.getD false) (.goto (fun _ => .emit))))
      (.goto (fun _ => .restore2 0)))
  | .restore2 l => StackCall.stmt swap Label.restore2 .done id (fun _ v => v) (Stacks.transferProgram l)
  | .done => .halt

theorem count_step (bit : Bool) (bits temp output : Bits) (v : Symbol) :
    TM2.step program ⟨some .count,v,Parsing.triple (bit::bits) temp output⟩=
      some ⟨some .count,some bit,Parsing.triple bits (bit::temp) (true::output)⟩ := by
  simp [TM2.step,program,TM2.stepAux]

theorem count_stop (temp output : Bits) (v : Symbol) :
    TM2.step program ⟨some .count,v,Parsing.triple [] temp output⟩=
      some ⟨some (.restore1 0),none,Parsing.triple [] temp (false::output)⟩ := by
  simp [TM2.step,program,TM2.stepAux]

theorem count_run (bits temp output : Bits) (v : Symbol) :
    Stacks.stackRun program (bits.length+1) ⟨some .count,v,Parsing.triple bits temp output⟩=
      some ⟨some (.restore1 0),none,Parsing.triple [] (bits.reverse++temp)
        (false::(List.replicate bits.length true++output))⟩ := by
  induction bits generalizing temp output v with
  | nil => simpa only [List.length_nil,List.reverse_nil,List.nil_append,List.replicate_zero] using! count_stop temp output v
  | cons bit bits ih =>
    rw [List.length_cons,Stacks.stackRun,count_step]
    simp only [Option.bind_some]
    have ht := ih (bit::temp) (true::output) (some bit)
    simpa only [List.reverse_cons,List.append_assoc,List.singleton_append,List.replicate_succ,List.cons_append,
      Parsing.marker_cons] using! ht

theorem count_clock (bits temp output : Bits) (v : Symbol) :
    Stacks.stackRunClock program (bits.length+1) ⟨some .count,v,Parsing.triple bits temp output⟩=
      bits.length*(3*bits.length+2*temp.length+2*output.length+9)+2*output.length+6 := by
  induction bits generalizing temp output v with
  | nil => simp [Stacks.stackRunClock,program,Stacks.stackClock]; omega
  | cons bit bits ih =>
    rw [List.length_cons,Stacks.stackRunClock,count_step]
    change 1+Stacks.stackClock (program .count) v (Parsing.triple (bit::bits) temp output)+
      Stacks.stackRunClock program (bits.length+1) ⟨some .count,some bit,Parsing.triple bits (bit::temp) (true::output)⟩=_
    rw [ih]
    simp [program,Stacks.stackClock]
    ring

def frame (output : Bits) (S : Fin 2 → Bits) : Fin 3 → Bits := Parsing.triple (S 1) (S 0) output

theorem frame_at (output : Bits) (S : Fin 2 → Bits) (k : Fin 2) : frame output S (swap k)=S k := by
  fin_cases k <;> rfl

theorem frame_update (output : Bits) (S : Fin 2 → Bits) (k : Fin 2) (bits : Bits) :
    frame output (Function.update S k bits)=Function.update (frame output S) (swap k) bits := by
  fin_cases k <;> simp [frame,swap]

theorem restore1 (bits output : Bits) (v : Symbol) :
    Stacks.stackRun program (bits.length+1) ⟨some (.restore1 0),v,Parsing.triple [] bits output⟩=
      some ⟨some .emit,none,Parsing.triple bits.reverse [] output⟩ ∧
    Stacks.stackRunClock program (bits.length+1) ⟨some (.restore1 0),v,Parsing.triple [] bits output⟩=
      bits.length*(2*bits.length+5)+3 := by
  have hr := Stacks.transfer_run bits [] v
  simp only [List.append_nil] at hr
  obtain ⟨hN,hNC⟩ := StackCall.execution swap Label.restore1 .emit id (fun _ v => v)
    (frame output) (frame_at output) (frame_update output) (fun _ _ => rfl) (fun _ _ _ => rfl)
    Stacks.transferProgram program (fun _ => rfl) v (bits.length+1) _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,
    frame,Stacks.stackPair_zero,Stacks.stackPair_one] at hN hNC
  exact ⟨hN,hNC.trans (by simpa only [List.length_nil,Nat.add_zero] using Stacks.transfer_clock bits [] v)⟩

theorem restore2 (bits output : Bits) (v : Symbol) :
    Stacks.stackRun program (bits.length+1) ⟨some (.restore2 0),v,Parsing.triple [] bits output⟩=
      some ⟨some .done,none,Parsing.triple bits.reverse [] output⟩ ∧
    Stacks.stackRunClock program (bits.length+1) ⟨some (.restore2 0),v,Parsing.triple [] bits output⟩=
      bits.length*(2*bits.length+5)+3 := by
  have hr := Stacks.transfer_run bits [] v
  simp only [List.append_nil] at hr
  obtain ⟨hN,hNC⟩ := StackCall.execution swap Label.restore2 .done id (fun _ v => v)
    (frame output) (frame_at output) (frame_update output) (fun _ _ => rfl) (fun _ _ _ => rfl)
    Stacks.transferProgram program (fun _ => rfl) v (bits.length+1) _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,
    frame,Stacks.stackPair_zero,Stacks.stackPair_one] at hN hNC
  exact ⟨hN,hNC.trans (by simpa only [List.length_nil,Nat.add_zero] using Stacks.transfer_clock bits [] v)⟩

theorem emit_step (bit : Bool) (bits temp output : Bits) (v : Symbol) :
    TM2.step program ⟨some .emit,v,Parsing.triple (bit::bits) temp output⟩=
      some ⟨some .emit,some bit,Parsing.triple bits (bit::temp) (bit::output)⟩ := by
  simp [TM2.step,program,TM2.stepAux]

theorem emit_stop (temp output : Bits) (v : Symbol) :
    TM2.step program ⟨some .emit,v,Parsing.triple [] temp output⟩=
      some ⟨some (.restore2 0),none,Parsing.triple [] temp output⟩ := by
  simp [TM2.step,program,TM2.stepAux]

theorem emit_run (bits temp output : Bits) (v : Symbol) :
    Stacks.stackRun program (bits.length+1) ⟨some .emit,v,Parsing.triple bits temp output⟩=
      some ⟨some (.restore2 0),none,Parsing.triple [] (bits.reverse++temp) (bits.reverse++output)⟩ := by
  induction bits generalizing temp output v with
  | nil => simpa only [List.length_nil,List.reverse_nil,List.nil_append] using! emit_stop temp output v
  | cons bit bits ih =>
    simpa only [List.length_cons,Stacks.stackRun,emit_step,Option.bind_some,List.reverse_cons,
      List.append_assoc,List.singleton_append] using ih (bit::temp) (bit::output) (some bit)

theorem emit_clock (bits temp output : Bits) (v : Symbol) :
    Stacks.stackRunClock program (bits.length+1) ⟨some .emit,v,Parsing.triple bits temp output⟩=
      bits.length*(3*bits.length+2*temp.length+2*output.length+7)+3 := by
  induction bits generalizing temp output v with
  | nil => simp [Stacks.stackRunClock,program,Stacks.stackClock]
  | cons bit bits ih =>
    rw [List.length_cons,Stacks.stackRunClock,emit_step]
    change 1+Stacks.stackClock (program .emit) v (Parsing.triple (bit::bits) temp output)+
      Stacks.stackRunClock program (bits.length+1) ⟨some .emit,some bit,Parsing.triple bits (bit::temp) (bit::output)⟩=_
    rw [ih]
    simp [program,Stacks.stackClock]
    ring

theorem complete (n : ℕ) (output : Bits) (v : Symbol) :
    Stacks.stackRun program (4*n.bits.length+5) ⟨some .count,v,Parsing.triple n.bits [] output⟩=
      some ⟨none,none,Parsing.triple n.bits [] ((natBits n).reverse++output)⟩ ∧
    Stacks.stackRunClock program (4*n.bits.length+5) ⟨some .count,v,Parsing.triple n.bits [] output⟩=
      n.bits.length*(12*n.bits.length+4*output.length+28)+2*output.length+16 := by
  let header := false::(List.replicate n.bits.length true++output)
  have hC := count_run n.bits [] output v
  have hCC := count_clock n.bits [] output v
  simp only [List.append_nil,List.length_nil,Nat.mul_zero,Nat.add_zero] at hC hCC
  obtain ⟨hR,hRC⟩ := restore1 n.bits.reverse header none
  simp only [List.length_reverse,List.reverse_reverse] at hR hRC
  have hE := emit_run n.bits [] header none
  have hEC := emit_clock n.bits [] header none
  simp only [List.append_nil,List.length_nil,Nat.mul_zero,Nat.add_zero] at hE hEC
  obtain ⟨hS,hSC⟩ := restore2 n.bits.reverse (n.bits.reverse++header) none
  simp only [List.length_reverse,List.reverse_reverse] at hS hSC
  have hCR : Stacks.stackRun program ((n.bits.length+1)+(n.bits.length+1))
      ⟨some .count,v,Parsing.triple n.bits [] output⟩=
      some ⟨some .emit,none,Parsing.triple n.bits [] header⟩ := by
    rw [Stacks.run_add,hC,Option.bind_some]
    exact hR
  have hCRE : Stacks.stackRun program (((n.bits.length+1)+(n.bits.length+1))+(n.bits.length+1))
      ⟨some .count,v,Parsing.triple n.bits [] output⟩=
      some ⟨some (.restore2 0),none,Parsing.triple [] n.bits.reverse (n.bits.reverse++header)⟩ := by
    rw [Stacks.run_add,hCR,Option.bind_some,hE]
  have hCRES : Stacks.stackRun program ((((n.bits.length+1)+(n.bits.length+1))+(n.bits.length+1))+(n.bits.length+1))
      ⟨some .count,v,Parsing.triple n.bits [] output⟩=
      some ⟨some .done,none,Parsing.triple n.bits [] (n.bits.reverse++header)⟩ := by
    rw [Stacks.run_add,hCRE,Option.bind_some,hS]
  have hn :
      4*n.bits.length+5=((((n.bits.length+1)+(n.bits.length+1))+(n.bits.length+1))+(n.bits.length+1))+1 := by omega
  constructor
  · rw [hn,Stacks.run_add,hCRES,Option.bind_some,Stacks.run_one]
    change some (⟨none,none,Parsing.triple n.bits [] (n.bits.reverse++header)⟩ : TM2.Cfg (fun _ : Fin 3 => Bool) Label Symbol)=_
    congr 3
    simp [natBits,header,List.reverse_append,List.append_assoc]
  · rw [hn,Stacks.clock_add _ _ 1 _ _ hCRES]
    have hd :
        Stacks.stackRunClock program 1 ⟨some .done,none,Parsing.triple n.bits [] (n.bits.reverse++header)⟩=1 := rfl
    rw [hd,Stacks.clock_add _ _ _ _ _ hCRE,hSC,Stacks.clock_add _ _ _ _ _ hCR,hEC,
      Stacks.clock_add _ _ _ _ _ hC,hCC,hRC]
    simp only [header,List.length_cons,List.length_append,List.length_replicate]
    ring

theorem clock_bound (n : ℕ) (output : Bits) (v : Symbol) :
    Stacks.stackRunClock program (4*n.bits.length+5) ⟨some .count,v,Parsing.triple n.bits [] output⟩≤
      100*(1+n.bits.length+output.length)^2 := by
  rw [(complete n output v).2]
  nlinarith [Nat.zero_le (n.bits.length^2),Nat.zero_le (output.length^2),Nat.zero_le (n.bits.length*output.length)]

theorem copy_complete (bits output : Bits) (v : Symbol) :
    Stacks.stackRun program (2*bits.length+3) ⟨some .emit,v,Parsing.triple bits [] output⟩=
      some ⟨none,none,Parsing.triple bits [] (bits.reverse++output)⟩ ∧
    Stacks.stackRunClock program (2*bits.length+3) ⟨some .emit,v,Parsing.triple bits [] output⟩=
      bits.length*(5*bits.length+2*output.length+12)+7 := by
  have hE := emit_run bits [] output v
  have hEC := emit_clock bits [] output v
  simp only [List.append_nil,List.length_nil,Nat.mul_zero,Nat.add_zero] at hE hEC
  obtain ⟨hR,hRC⟩ := restore2 bits.reverse (bits.reverse++output) none
  simp only [List.length_reverse,List.reverse_reverse] at hR hRC
  have hER : Stacks.stackRun program ((bits.length+1)+(bits.length+1))
      ⟨some .emit,v,Parsing.triple bits [] output⟩=
      some ⟨some .done,none,Parsing.triple bits [] (bits.reverse++output)⟩ := by
    rw [Stacks.run_add,hE,Option.bind_some,hR]
  have hn : 2*bits.length+3=((bits.length+1)+(bits.length+1))+1 := by omega
  constructor
  · rw [hn,Stacks.run_add,hER,Option.bind_some,Stacks.run_one]
    rfl
  · rw [hn,Stacks.clock_add _ _ 1 _ _ hER]
    have hd :
        Stacks.stackRunClock program 1 ⟨some .done,none,Parsing.triple bits [] (bits.reverse++output)⟩=1 := rfl
    rw [hd,Stacks.clock_add _ _ _ _ _ hE,hEC,hRC]
    ring

theorem copy_clock_bound (bits output : Bits) (v : Symbol) :
    Stacks.stackRunClock program (2*bits.length+3) ⟨some .emit,v,Parsing.triple bits [] output⟩≤
      25*(1+bits.length+output.length)^2 := by
  rw [(copy_complete bits output v).2]
  nlinarith [Nat.zero_le (bits.length^2),Nat.zero_le (output.length^2),Nat.zero_le (bits.length*output.length)]
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.NatEmit

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.Stacks
open Turing Qatlib.Concepts.BitWordCompiler.CanonicalCodec
variable {K Λ σ : Type} [DecidableEq K]

def pushBits (k : K) (bits : Bits) (after : TM2.Stmt (fun _ : K => Bool) Λ σ) : TM2.Stmt (fun _ : K => Bool) Λ σ :=
  bits.foldr (fun bit rest => .push k (fun _ => bit) rest) after

theorem pushBits_step (k : K) (bits : Bits) (after : TM2.Stmt (fun _ : K => Bool) Λ σ) (v : σ) (S : K → Bits) :
    TM2.stepAux (pushBits k bits after) v S=
      TM2.stepAux after v (Function.update S k (bits.reverse++S k)) := by
  induction bits generalizing S with
  | nil => simp [pushBits]
  | cons bit bits ih =>
    simp only [pushBits,List.foldr_cons,TM2.stepAux]
    rw [← pushBits,ih]
    simp only [Function.update_self,Function.update_idem,List.reverse_cons,List.append_assoc,List.singleton_append]

theorem pushBits_clock (k : K) (bits : Bits) (after : TM2.Stmt (fun _ : K => Bool) Λ σ) (v : σ) (S : K → Bits) :
    stackClock (pushBits k bits after) v S=
      bits.length*(2*(S k).length+bits.length+2)+stackClock after v (Function.update S k (bits.reverse++S k)) := by
  induction bits generalizing S with
  | nil => simp [pushBits]
  | cons bit bits ih =>
    simp only [pushBits,List.foldr_cons,stackClock]
    rw [← pushBits,ih]
    simp only [Function.update_self,Function.update_idem,List.reverse_cons,List.append_assoc,
      List.singleton_append,List.length_cons]
    ring
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.Stacks

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.ReadonlyRepeat
open Turing Qatlib.Concepts.BitWordCompiler.CanonicalCodec
abbrev Local := Counter.Local×Symbol

def getCounter (v : Local) : Counter.Local := v.1
def putCounter (v : Local) (w : Counter.Local) : Local := (w,v.2)
def getIO (v : Local) : Symbol := v.2
def putIO (v : Local) (w : Symbol) : Local := (v.1,w)

def copyCode (k : Fin 3) : Fin 4 := if k=0 then 2 else if k=1 then 1 else 3

def counterFrame (block output : Bits) (S : Fin 2 → Bits) : Fin 4 → Bits :=
  Preparation.quad (S 0) (S 1) block output

def copyFrame (counter : Bits) (S : Fin 3 → Bits) : Fin 4 → Bits :=
  Preparation.quad counter (S 1) (S 0) (S 2)

def drainCounterFrame (block output : Bits) (S : Fin 1 → Bits) : Fin 4 → Bits :=
  Preparation.quad (S 0) [] block output

def drainBlockFrame (output : Bits) (S : Fin 1 → Bits) : Fin 4 → Bits :=
  Preparation.quad [] [] (S 0) output

inductive Label where
  | counter (l : Counter.Label)
  | branch
  | copy (l : NatEmit.Label)
  | drainCounter (l : Fin 1)
  | drainBlock (l : Fin 1)
  | done
  deriving DecidableEq,Fintype
instance : Inhabited Label := ⟨.counter .borrow⟩

def program : Label → TM2.Stmt (fun _ : Fin 4 => Bool) Label Local
  | .counter l => StackCall.stmt (Fin.castAdd 2) Label.counter .branch getCounter putCounter (Counter.program l)
  | .branch => .branch (fun v => (getCounter v).1)
      (.goto (fun _ => .copy .emit)) (.goto (fun _ => .drainCounter 0))
  | .copy l => StackCall.stmt copyCode Label.copy (.counter .borrow) getIO putIO (NatEmit.program l)
  | .drainCounter l => StackCall.stmt (fun _ : Fin 1 => (0 : Fin 4)) Label.drainCounter (.drainBlock 0) getIO putIO (Normalization.drainProgram l)
  | .drainBlock l => StackCall.stmt (fun _ : Fin 1 => (2 : Fin 4)) Label.drainBlock .done getIO putIO (Normalization.drainProgram l)
  | .done => .halt

theorem counterFrame_at (block output : Bits) (S : Fin 2 → Bits) (k : Fin 2) :
    counterFrame block output S (Fin.castAdd 2 k)=S k := by fin_cases k <;> rfl

theorem counterFrame_update (block output : Bits) (S : Fin 2 → Bits) (k : Fin 2) (bits : Bits) :
    counterFrame block output (Function.update S k bits)=Function.update (counterFrame block output S) (Fin.castAdd 2 k) bits := by
  fin_cases k <;> simp [counterFrame]

theorem copyFrame_at (counter : Bits) (S : Fin 3 → Bits) (k : Fin 3) : copyFrame counter S (copyCode k)=S k := by
  fin_cases k <;> rfl

theorem copyFrame_update (counter : Bits) (S : Fin 3 → Bits) (k : Fin 3) (bits : Bits) :
    copyFrame counter (Function.update S k bits)=Function.update (copyFrame counter S) (copyCode k) bits := by
  funext j
  fin_cases k <;> fin_cases j <;> simp [copyFrame,copyCode,Preparation.quad]

theorem drainCounterFrame_at (block output : Bits) (S : Fin 1 → Bits) (k : Fin 1) :
    drainCounterFrame block output S (0 : Fin 4)=S k := by fin_cases k; rfl

theorem drainCounterFrame_update (block output : Bits) (S : Fin 1 → Bits) (k : Fin 1) (bits : Bits) :
    drainCounterFrame block output (Function.update S k bits)=Function.update (drainCounterFrame block output S) (0 : Fin 4) bits := by
  fin_cases k
  simp [drainCounterFrame]

theorem drainBlockFrame_at (output : Bits) (S : Fin 1 → Bits) (k : Fin 1) :
    drainBlockFrame output S (2 : Fin 4)=S k := by fin_cases k; rfl

theorem drainBlockFrame_update (output : Bits) (S : Fin 1 → Bits) (k : Fin 1) (bits : Bits) :
    drainBlockFrame output (Function.update S k bits)=Function.update (drainBlockFrame output S) (2 : Fin 4) bits := by
  funext j
  fin_cases k
  fin_cases j <;> simp [drainBlockFrame,Preparation.quad]

@[simp] theorem putCounter_get (v : Local) : putCounter v (getCounter v)=v := rfl

@[simp] theorem putIO_get (v : Local) : putIO v (getIO v)=v := rfl

theorem decrement_positive (counter block output : Bits) (v : Local) (hp : 0<binaryValue counter) :
    ∃ ticks next, next.length=counter.length ∧ binaryValue next+1=binaryValue counter ∧
      Stacks.stackRun program ticks ⟨some (.counter .borrow),v,Preparation.quad counter [] block output⟩=
        some ⟨some .branch,putCounter v (true,none),Preparation.quad next [] block output⟩ ∧
      Stacks.stackRunClock program ticks ⟨some (.counter .borrow),v,Preparation.quad counter [] block output⟩≤
        10*(1+counter.length)^2 := by
  obtain ⟨ticks,next,_,hlen,hval,hr,hc⟩ := Counter.decrement_positive counter (getCounter v) hp
  obtain ⟨hN,hNC⟩ := StackCall.execution (Fin.castAdd 2) Label.counter .branch getCounter putCounter
    (counterFrame block output) (counterFrame_at block output) (counterFrame_update block output)
    (fun _ _ => rfl) (fun _ _ _ => rfl) Counter.program program (fun _ => rfl) v ticks _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,
    counterFrame,Stacks.stackPair_zero,Stacks.stackPair_one,putCounter_get] at hN hNC
  exact ⟨ticks,next,hlen,hval,hN,hNC.trans_le hc⟩

theorem decrement_zero (counter block output : Bits) (v : Local) (hz : binaryValue counter=0) :
    Stacks.stackRun program (2*counter.length+2) ⟨some (.counter .borrow),v,Preparation.quad counter [] block output⟩=
      some ⟨some .branch,putCounter v (false,none),Preparation.quad (List.replicate counter.length true) [] block output⟩ ∧
    Stacks.stackRunClock program (2*counter.length+2) ⟨some (.counter .borrow),v,Preparation.quad counter [] block output⟩≤
      10*(1+counter.length)^2 := by
  obtain ⟨hr,hc⟩ := Counter.decrement_zero counter (getCounter v) hz
  obtain ⟨hN,hNC⟩ := StackCall.execution (Fin.castAdd 2) Label.counter .branch getCounter putCounter
    (counterFrame block output) (counterFrame_at block output) (counterFrame_update block output)
    (fun _ _ => rfl) (fun _ _ _ => rfl) Counter.program program (fun _ => rfl) v (2*counter.length+2) _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,
    counterFrame,Stacks.stackPair_zero,Stacks.stackPair_one,putCounter_get] at hN hNC
  exact ⟨hN,hNC.trans_le hc⟩

theorem copy (counter block output : Bits) (v : Local) :
    Stacks.stackRun program (2*block.length+3) ⟨some (.copy .emit),v,Preparation.quad counter [] block output⟩=
      some ⟨some (.counter .borrow),putIO v none,Preparation.quad counter [] block (block.reverse++output)⟩ ∧
    Stacks.stackRunClock program (2*block.length+3) ⟨some (.copy .emit),v,Preparation.quad counter [] block output⟩≤
      25*(1+block.length+output.length)^2 := by
  obtain ⟨hr,_⟩ := NatEmit.copy_complete block output (getIO v)
  have hc := NatEmit.copy_clock_bound block output (getIO v)
  obtain ⟨hN,hNC⟩ := StackCall.execution copyCode Label.copy (.counter .borrow) getIO putIO
    (copyFrame counter) (copyFrame_at counter) (copyFrame_update counter) (fun _ _ => rfl) (fun _ _ _ => rfl)
    NatEmit.program program (fun _ => rfl) v (2*block.length+3) _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,
    copyFrame,Parsing.triple_zero,Parsing.triple_one,Parsing.triple_two,putIO_get] at hN hNC
  exact ⟨hN,hNC.trans_le hc⟩

theorem drain_counter (counter block output : Bits) (v : Local) :
    Stacks.stackRun program (counter.length+1) ⟨some (.drainCounter 0),v,Preparation.quad counter [] block output⟩=
      some ⟨some (.drainBlock 0),putIO v none,Preparation.quad [] [] block output⟩ ∧
    Stacks.stackRunClock program (counter.length+1) ⟨some (.drainCounter 0),v,Preparation.quad counter [] block output⟩=
      counter.length^2+3*counter.length+3 := by
  have hr := Normalization.drain_run counter (getIO v)
  obtain ⟨hN,hNC⟩ := StackCall.execution (fun _ : Fin 1 => (0 : Fin 4)) Label.drainCounter (.drainBlock 0) getIO putIO
    (drainCounterFrame block output) (drainCounterFrame_at block output) (drainCounterFrame_update block output)
    (fun _ _ => rfl) (fun _ _ _ => rfl) Normalization.drainProgram program (fun _ => rfl) v (counter.length+1) _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,
    drainCounterFrame,Normalization.singleStack_zero,putIO_get] at hN hNC
  exact ⟨hN,hNC.trans (Normalization.drain_clock counter (getIO v))⟩

theorem drain_block (block output : Bits) (v : Local) :
    Stacks.stackRun program (block.length+1) ⟨some (.drainBlock 0),v,Preparation.quad [] [] block output⟩=
      some ⟨some .done,putIO v none,Preparation.quad [] [] [] output⟩ ∧
    Stacks.stackRunClock program (block.length+1) ⟨some (.drainBlock 0),v,Preparation.quad [] [] block output⟩=
      block.length^2+3*block.length+3 := by
  have hr := Normalization.drain_run block (getIO v)
  obtain ⟨hN,hNC⟩ := StackCall.execution (fun _ : Fin 1 => (2 : Fin 4)) Label.drainBlock .done getIO putIO
    (drainBlockFrame output) (drainBlockFrame_at output) (drainBlockFrame_update output)
    (fun _ _ => rfl) (fun _ _ _ => rfl) Normalization.drainProgram program (fun _ => rfl) v (block.length+1) _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,
    drainBlockFrame,Normalization.singleStack_zero,putIO_get] at hN hNC
  exact ⟨hN,hNC.trans (Normalization.drain_clock block (getIO v))⟩

theorem finish (counter block output : Bits) (v : Local) :
    Stacks.stackRun program (counter.length+block.length+3) ⟨some (.drainCounter 0),v,Preparation.quad counter [] block output⟩=
      some ⟨none,(getCounter v,none),Preparation.quad [] [] [] output⟩ ∧
    Stacks.stackRunClock program (counter.length+block.length+3) ⟨some (.drainCounter 0),v,Preparation.quad counter [] block output⟩=
      counter.length^2+3*counter.length+block.length^2+3*block.length+7 := by
  obtain ⟨hC,hCC⟩ := drain_counter counter block output v
  obtain ⟨hB,hBC⟩ := drain_block block output (putIO v none)
  have hCB : Stacks.stackRun program ((counter.length+1)+(block.length+1))
      ⟨some (.drainCounter 0),v,Preparation.quad counter [] block output⟩=
      some ⟨some .done,putIO (putIO v none) none,Preparation.quad [] [] [] output⟩ := by
    rw [Stacks.run_add,hC,Option.bind_some,hB]
  have hn : counter.length+block.length+3=((counter.length+1)+(block.length+1))+1 := by omega
  constructor
  · rw [hn,Stacks.run_add,hCB,Option.bind_some,Stacks.run_one]
    rfl
  · rw [hn,Stacks.clock_add _ _ 1 _ _ hCB]
    have hd :
        Stacks.stackRunClock program 1 ⟨some .done,putIO (putIO v none) none,Preparation.quad [] [] [] output⟩=1 := rfl
    rw [hd,Stacks.clock_add _ _ _ _ _ hC,hCC,hBC]
    ring

theorem branch_zero (v : Local) (S : Fin 4 → Bits) :
    Stacks.stackRun program 1 ⟨some .branch,putCounter v (false,none),S⟩=
      some ⟨some (.drainCounter 0),putCounter v (false,none),S⟩ := rfl

theorem branch_positive (v : Local) (S : Fin 4 → Bits) :
    Stacks.stackRun program 1 ⟨some .branch,putCounter v (true,none),S⟩=
      some ⟨some (.copy .emit),putCounter v (true,none),S⟩ := rfl

theorem branch_clock (v : Local) (S : Fin 4 → Bits) : Stacks.stackRunClock program 1 ⟨some .branch,v,S⟩=1 := by
  simp [Stacks.stackRunClock,program,Stacks.stackClock]

theorem complete (n : ℕ) (counter block output : Bits) (v : Local) (hnum : binaryValue counter=n) :
    ∃ ticks,
      Stacks.stackRun program ticks ⟨some (.counter .borrow),v,Preparation.quad counter [] block output⟩=
        some ⟨none,((false,none),none),Preparation.quad [] [] [] ((List.replicate n block).flatten.reverse++output)⟩ ∧
      Stacks.stackRunClock program ticks ⟨some (.counter .borrow),v,Preparation.quad counter [] block output⟩≤
        20*(n+1)*(1+counter.length)^2+
          50*(n+1)*(1+block.length+output.length+n*block.length)^2 := by
  induction n generalizing counter output v with
  | zero =>
    obtain ⟨hD,hDC⟩ := decrement_zero counter block output v hnum
    have hB := branch_zero v (Preparation.quad (List.replicate counter.length true) [] block output)
    obtain ⟨hF,hFC⟩ :=
        finish (List.replicate counter.length true) block output (putCounter v (false,none))
    have hDB : Stacks.stackRun program ((2*counter.length+2)+1)
        ⟨some (.counter .borrow),v,Preparation.quad counter [] block output⟩=
        some ⟨some (.drainCounter 0),putCounter v (false,none),Preparation.quad (List.replicate counter.length true) [] block output⟩ := by
      rw [Stacks.run_add,hD,Option.bind_some,hB]
    refine ⟨((2*counter.length+2)+1)+(counter.length+block.length+3),?_,?_⟩
    · rw [Stacks.run_add,hDB,Option.bind_some]
      simpa only [List.length_replicate,List.replicate_zero,List.flatten_nil,List.reverse_nil,List.nil_append] using! hF
    · rw [Stacks.clock_add _ _ _ _ _ hDB,Stacks.clock_add _ _ 1 _ _ hD,branch_clock]
      simp only [List.length_replicate] at hFC
      have hw : 1≤(1+counter.length)^2 :=
          (show 1≤1+counter.length by omega).trans (Nat.le_pow (by decide))
      simp only [Nat.zero_add,Nat.mul_one,Nat.zero_mul,Nat.add_zero]
      nlinarith [hDC,hFC,Nat.zero_le (counter.length^2),Nat.zero_le (block.length^2),Nat.zero_le (output.length^2),
        Nat.zero_le (block.length*output.length)]
  | succ n ih =>
    have hp : 0<binaryValue counter := by omega
    obtain ⟨decTicks,next,hlen,hval,hD,hDC⟩ := decrement_positive counter block output v hp
    have hn : binaryValue next=n := by omega
    have hB := branch_positive v (Preparation.quad next [] block output)
    obtain ⟨hC,hCC⟩ := copy next block output (putCounter v (true,none))
    obtain ⟨iterTicks,hI,hIC⟩ :=
        ih next (block.reverse++output) (putIO (putCounter v (true,none)) none) hn
    have hDB : Stacks.stackRun program (decTicks+1)
        ⟨some (.counter .borrow),v,Preparation.quad counter [] block output⟩=
        some ⟨some (.copy .emit),putCounter v (true,none),Preparation.quad next [] block output⟩ := by
      rw [Stacks.run_add,hD,Option.bind_some,hB]
    have hDBC : Stacks.stackRun program ((decTicks+1)+(2*block.length+3))
        ⟨some (.counter .borrow),v,Preparation.quad counter [] block output⟩=
        some ⟨some (.counter .borrow),putIO (putCounter v (true,none)) none,Preparation.quad next [] block (block.reverse++output)⟩ := by
      rw [Stacks.run_add,hDB,Option.bind_some,hC]
    refine ⟨((decTicks+1)+(2*block.length+3))+iterTicks,?_,?_⟩
    · rw [Stacks.run_add,hDBC,Option.bind_some]
      simpa only [List.replicate_succ,List.flatten_cons,List.reverse_append,List.append_assoc] using hI
    · rw [Stacks.clock_add _ _ _ _ _ hDBC,Stacks.clock_add _ _ _ _ _ hDB,
        Stacks.clock_add _ _ 1 _ _ hD,branch_clock]
      have hZ : 1+block.length+(block.reverse++output).length+n*block.length=
          1+block.length+output.length+(n+1)*block.length := by simp only [List.length_append,List.length_reverse]; ring
      rw [hlen,hZ] at hIC
      have hz : 1+block.length+output.length≤1+block.length+output.length+(n+1)*block.length := by
        omega
      have hsq := Nat.mul_le_mul hz hz
      have hw : 1≤(1+counter.length)^2 :=
          (show 1≤1+counter.length by omega).trans (Nat.le_pow (by decide))
      nlinarith only [hDC,hCC,hIC,hsq,hw,Nat.zero_le ((1+block.length+output.length+(n+1)*block.length)^2)]
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.ReadonlyRepeat

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.Stacks
open Turing
variable {K Λ σ : Type} [DecidableEq K]

def Execution (M : Λ → TM2.Stmt (fun _ : K => Bool) Λ σ)
    (first last : TM2.Cfg (fun _ : K => Bool) Λ σ) (budget : ℕ) : Prop :=
  ∃ ticks,stackRun M ticks first=some last ∧ stackRunClock M ticks first≤budget

theorem Execution.trans {M : Λ → TM2.Stmt (fun _ : K => Bool) Λ σ}
    {first mid last : TM2.Cfg (fun _ : K => Bool) Λ σ} {a b : ℕ}
    (h : Execution M first mid a) (g : Execution M mid last b) : Execution M first last (a+b) := by
  obtain ⟨n,hr,hc⟩ := h
  obtain ⟨m,gr,gc⟩ := g
  refine ⟨n+m,?_,?_⟩
  · rw [run_add,hr,Option.bind_some,gr]
  · rw [clock_add _ _ _ _ _ hr]
    exact Nat.add_le_add hc gc

theorem Execution.mono {M : Λ → TM2.Stmt (fun _ : K => Bool) Λ σ}
    {first last : TM2.Cfg (fun _ : K => Bool) Λ σ} {a b : ℕ}
    (h : Execution M first last a) (hab : a≤b) : Execution M first last b := by
  obtain ⟨n,hr,hc⟩ := h
  exact ⟨n,hr,hc.trans hab⟩
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.Stacks

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.NativeEcho
open Turing Qatlib.Concepts.BitWordCompiler.CanonicalCodec
abbrev Local := ReadonlyRepeat.Local
inductive Slot where | reader | counter | temp | wire | block | output deriving DecidableEq,Fintype

def store (reader counter temp wire block output : Bits) : Slot → Bits
  | .reader => reader
  | .counter => counter
  | .temp => temp
  | .wire => wire
  | .block => block
  | .output => output

def parseCode (k : Fin 3) : Slot := if k=0 then .reader else if k=1 then .temp else .block
def startCode (k : Fin 2) : Slot := if k=0 then .block else .reader
def countTransferCode (k : Fin 2) : Slot := if k=0 then .block else .counter
def wireTransferCode (k : Fin 2) : Slot := if k=0 then .block else .wire
def countCode (k : Fin 2) : Slot := if k=0 then .counter else .temp
def wireEmitCode (k : Fin 3) : Slot := if k=0 then .wire else if k=1 then .temp else .output
def countEmitCode (k : Fin 3) : Slot := if k=0 then .counter else if k=1 then .temp else .output
def blockEmitCode (k : Fin 3) : Slot := if k=0 then .wire else if k=1 then .temp else .block
def repeatCode (k : Fin 4) : Slot :=
    if k=0 then .counter else if k=1 then .temp else if k=2 then .wire else .output

inductive Label where
  | start (l : Fin 1)
  | flag
  | parseCount (l : Fin 3)
  | transferCount (l : Fin 1)
  | parseWire (l : Fin 3)
  | transferWire (l : Fin 1)
  | drainReader (l : Fin 1)
  | emitWire (l : NatEmit.Label)
  | ancilla
  | increment (l : Increment.Label)
  | shift
  | emitCount (l : NatEmit.Label)
  | unshift
  | blockStart
  | emitBlockWire (l : NatEmit.Label)
  | blockEnd
  | drainWire (l : Fin 1)
  | transferBlock (l : Fin 1)
  | repeat (l : ReadonlyRepeat.Label)
  | suffix
  deriving DecidableEq,Fintype
instance : Inhabited Label := ⟨.start 0⟩

def program : Label → TM2.Stmt (fun _ : Slot => Bool) Label Local
  | .start l => StackCall.stmt startCode Label.start .flag ReadonlyRepeat.getIO ReadonlyRepeat.putIO (Stacks.transferProgram l)
  | .flag => .pop .reader (fun v bit => ReadonlyRepeat.putIO v bit) (.goto (fun _ => .parseCount 0))
  | .parseCount l => StackCall.stmt parseCode Label.parseCount (.transferCount 0) ReadonlyRepeat.getIO ReadonlyRepeat.putIO (Parsing.natProgram l)
  | .transferCount l => StackCall.stmt countTransferCode Label.transferCount (.parseWire 0) ReadonlyRepeat.getIO ReadonlyRepeat.putIO (Stacks.transferProgram l)
  | .parseWire l => StackCall.stmt parseCode Label.parseWire (.transferWire 0) ReadonlyRepeat.getIO ReadonlyRepeat.putIO (Parsing.natProgram l)
  | .transferWire l => StackCall.stmt wireTransferCode Label.transferWire (.drainReader 0) ReadonlyRepeat.getIO ReadonlyRepeat.putIO (Stacks.transferProgram l)
  | .drainReader l => StackCall.stmt (fun _ : Fin 1 => Slot.reader) Label.drainReader (.emitWire .count)
      ReadonlyRepeat.getIO ReadonlyRepeat.putIO (Normalization.drainProgram l)
  | .emitWire l => StackCall.stmt wireEmitCode Label.emitWire .ancilla ReadonlyRepeat.getIO ReadonlyRepeat.putIO (NatEmit.program l)
  | .ancilla => Stacks.pushBits Slot.output (natBits 1) (.goto (fun _ => .increment .carry))
  | .increment l => StackCall.stmt countCode Label.increment .shift ReadonlyRepeat.getIO ReadonlyRepeat.putIO (Increment.program l)
  | .shift => .push .counter (fun _ => false) (.goto (fun _ => .emitCount .count))
  | .emitCount l => StackCall.stmt countEmitCode Label.emitCount .unshift ReadonlyRepeat.getIO ReadonlyRepeat.putIO (NatEmit.program l)
  | .unshift => .pop .counter (fun v _ => v) (.goto (fun _ => .blockStart))
  | .blockStart => Stacks.pushBits Slot.block (natBits 0) (.goto (fun _ => .emitBlockWire .count))
  | .emitBlockWire l => StackCall.stmt blockEmitCode Label.emitBlockWire .blockEnd ReadonlyRepeat.getIO ReadonlyRepeat.putIO (NatEmit.program l)
  | .blockEnd => Stacks.pushBits Slot.block ([3,0,0,0,0].flatMap natBits) (.goto (fun _ => .drainWire 0))
  | .drainWire l => StackCall.stmt (fun _ : Fin 1 => Slot.wire) Label.drainWire (.transferBlock 0)
      ReadonlyRepeat.getIO ReadonlyRepeat.putIO (Normalization.drainProgram l)
  | .transferBlock l => StackCall.stmt wireTransferCode Label.transferBlock (.repeat (.counter .borrow))
      ReadonlyRepeat.getIO ReadonlyRepeat.putIO (Stacks.transferProgram l)
  | .repeat l => StackCall.stmt repeatCode Label.repeat .suffix id (fun _ v => v) (ReadonlyRepeat.program l)
  | .suffix => Stacks.pushBits Slot.output (natBits 1++[false]) .halt

def block (wire : ℕ) : Bits := [0,wire,3,0,0,0,0].flatMap natBits

def output (wire k : ℕ) : Bits := [wire,1,2*(k+1)].flatMap natBits++
  (List.replicate (k+1) (block wire)).flatten++natBits 1++[false]

def startFrame (counter temp wire output : Bits) (S : Fin 2 → Bits) : Slot → Bits :=
    store (S 1) counter temp wire (S 0) output

theorem startFrame_at (counter temp wire output : Bits) (S : Fin 2 → Bits) (k : Fin 2) :
    startFrame counter temp wire output S (startCode k)=S k := by
  fin_cases k <;> rfl

theorem startFrame_update (counter temp wire output : Bits) (S : Fin 2 → Bits) (k : Fin 2) (bits : Bits) :
    startFrame counter temp wire output (Function.update S k bits)=Function.update (startFrame counter temp wire output S) (startCode k) bits := by
  funext j
  fin_cases k <;> cases j <;> simp [startFrame,startCode,store]

def parseFrame (counter wire output : Bits) (S : Fin 3 → Bits) : Slot → Bits :=
    store (S 0) counter (S 1) wire (S 2) output

theorem parseFrame_at (counter wire output : Bits) (S : Fin 3 → Bits) (k : Fin 3) :
    parseFrame counter wire output S (parseCode k)=S k := by
  fin_cases k <;> rfl

theorem parseFrame_update (counter wire output : Bits) (S : Fin 3 → Bits) (k : Fin 3) (bits : Bits) :
    parseFrame counter wire output (Function.update S k bits)=Function.update (parseFrame counter wire output S) (parseCode k) bits := by
  funext j
  fin_cases k <;> cases j <;> simp [parseFrame,parseCode,store]

def countTransferFrame (reader temp wire output : Bits) (S : Fin 2 → Bits) : Slot → Bits :=
    store reader (S 1) temp wire (S 0) output

theorem countTransferFrame_at (reader temp wire output : Bits) (S : Fin 2 → Bits) (k : Fin 2) :
    countTransferFrame reader temp wire output S (countTransferCode k)=S k := by
  fin_cases k <;> rfl

theorem countTransferFrame_update (reader temp wire output : Bits) (S : Fin 2 → Bits) (k : Fin 2) (bits : Bits) :
    countTransferFrame reader temp wire output (Function.update S k bits)=Function.update (countTransferFrame reader temp wire output S) (countTransferCode k) bits := by
  funext j
  fin_cases k <;> cases j <;> simp [countTransferFrame,countTransferCode,store]

def wireTransferFrame (reader counter temp output : Bits) (S : Fin 2 → Bits) : Slot → Bits :=
    store reader counter temp (S 1) (S 0) output

theorem wireTransferFrame_at (reader counter temp output : Bits) (S : Fin 2 → Bits) (k : Fin 2) :
    wireTransferFrame reader counter temp output S (wireTransferCode k)=S k := by
  fin_cases k <;> rfl

theorem wireTransferFrame_update (reader counter temp output : Bits) (S : Fin 2 → Bits) (k : Fin 2) (bits : Bits) :
    wireTransferFrame reader counter temp output (Function.update S k bits)=Function.update (wireTransferFrame reader counter temp output S) (wireTransferCode k) bits := by
  funext j
  fin_cases k <;> cases j <;> simp [wireTransferFrame,wireTransferCode,store]

def countFrame (reader wire block output : Bits) (S : Fin 2 → Bits) : Slot → Bits :=
    store reader (S 0) (S 1) wire block output

theorem countFrame_at (reader wire block output : Bits) (S : Fin 2 → Bits) (k : Fin 2) :
    countFrame reader wire block output S (countCode k)=S k := by
  fin_cases k <;> rfl

theorem countFrame_update (reader wire block output : Bits) (S : Fin 2 → Bits) (k : Fin 2) (bits : Bits) :
    countFrame reader wire block output (Function.update S k bits)=Function.update (countFrame reader wire block output S) (countCode k) bits := by
  funext j
  fin_cases k <;> cases j <;> simp [countFrame,countCode,store]

def wireEmitFrame (reader counter block : Bits) (S : Fin 3 → Bits) : Slot → Bits :=
    store reader counter (S 1) (S 0) block (S 2)

theorem wireEmitFrame_at (reader counter block : Bits) (S : Fin 3 → Bits) (k : Fin 3) :
    wireEmitFrame reader counter block S (wireEmitCode k)=S k := by
  fin_cases k <;> rfl

theorem wireEmitFrame_update (reader counter block : Bits) (S : Fin 3 → Bits) (k : Fin 3) (bits : Bits) :
    wireEmitFrame reader counter block (Function.update S k bits)=Function.update (wireEmitFrame reader counter block S) (wireEmitCode k) bits := by
  funext j
  fin_cases k <;> cases j <;> simp [wireEmitFrame,wireEmitCode,store]

def countEmitFrame (reader wire block : Bits) (S : Fin 3 → Bits) : Slot → Bits :=
    store reader (S 0) (S 1) wire block (S 2)

theorem countEmitFrame_at (reader wire block : Bits) (S : Fin 3 → Bits) (k : Fin 3) :
    countEmitFrame reader wire block S (countEmitCode k)=S k := by
  fin_cases k <;> rfl

theorem countEmitFrame_update (reader wire block : Bits) (S : Fin 3 → Bits) (k : Fin 3) (bits : Bits) :
    countEmitFrame reader wire block (Function.update S k bits)=Function.update (countEmitFrame reader wire block S) (countEmitCode k) bits := by
  funext j
  fin_cases k <;> cases j <;> simp [countEmitFrame,countEmitCode,store]

def blockEmitFrame (reader counter output : Bits) (S : Fin 3 → Bits) : Slot → Bits :=
    store reader counter (S 1) (S 0) (S 2) output

theorem blockEmitFrame_at (reader counter output : Bits) (S : Fin 3 → Bits) (k : Fin 3) :
    blockEmitFrame reader counter output S (blockEmitCode k)=S k := by
  fin_cases k <;> rfl

theorem blockEmitFrame_update (reader counter output : Bits) (S : Fin 3 → Bits) (k : Fin 3) (bits : Bits) :
    blockEmitFrame reader counter output (Function.update S k bits)=Function.update (blockEmitFrame reader counter output S) (blockEmitCode k) bits := by
  funext j
  fin_cases k <;> cases j <;> simp [blockEmitFrame,blockEmitCode,store]

def repeatFrame (reader block : Bits) (S : Fin 4 → Bits) : Slot → Bits :=
    store reader (S 0) (S 1) (S 2) block (S 3)

theorem repeatFrame_at (reader block : Bits) (S : Fin 4 → Bits) (k : Fin 4) :
    repeatFrame reader block S (repeatCode k)=S k := by
  fin_cases k <;> rfl

