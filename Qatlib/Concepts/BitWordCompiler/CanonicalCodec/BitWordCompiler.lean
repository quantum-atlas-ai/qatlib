      Stacks.stackRunClock program ticks ⟨some (.incrementWidth .carry),v,store reader counter [] width markers n.bits block output⟩≤50*(1+n.bits.length)^2 := by
  obtain ⟨ticks,_,hr,hc⟩ := Increment.complete n.bits [] (ReadonlyRepeat.getIO v)
