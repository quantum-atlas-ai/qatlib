    (countEmitFrame reader wire block) (countEmitFrame_at reader wire block) (countEmitFrame_update reader wire block)
    (fun _ _ => rfl) (fun _ _ _ => rfl) NatEmit.program program (fun _ => rfl) v (4*n.bits.length+5) _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,
    countEmitFrame,Parsing.triple_zero,Parsing.triple_one,Parsing.triple_two,ReadonlyRepeat.putIO_get] at hN hNC
