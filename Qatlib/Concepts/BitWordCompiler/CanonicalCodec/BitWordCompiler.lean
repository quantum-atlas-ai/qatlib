theorem start (input : Bits) (v : Local) :
    Stacks.stackRun program (input.length+1) ⟨some (.start 0),v,store [] [] [] [] input.reverse []⟩=
      some ⟨some .flag,ReadonlyRepeat.putIO v none,store input [] [] [] [] []⟩ ∧
