      40*(1+(natBits n++rest).length)^2 := by
  obtain ⟨hr,_⟩ := Parsing.skipNat_execution n rest (ReadonlyRepeat.getIO v)
  have hc := Parsing.skipNat_clock_bound n rest (ReadonlyRepeat.getIO v)
  obtain ⟨hN,hNC⟩ := StackCall.execution skipCode code returnTo ReadonlyRepeat.getIO ReadonlyRepeat.putIO
    (skipFrame counter width markers [] [] []) (skipFrame_at counter width markers [] [] []) (skipFrame_update counter width markers [] [] [])
    (fun _ _ => rfl) (fun _ _ _ => rfl) Parsing.skipNatProgram program hcode v (2*n.bits.length+3) _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,
    skipFrame,Stacks.stackPair_zero,Stacks.stackPair_one,ReadonlyRepeat.putIO_get] at hN hNC
  exact ⟨hN,hNC.trans_le hc⟩

theorem length_call (code : LengthCounter.Label → Label) (returnTo : Label)
    (hcode : ∀ l, program (code l)=StackCall.stmt lengthCode code returnTo ReadonlyRepeat.getIO ReadonlyRepeat.putIO (LengthCounter.program l))
    (n : ℕ) (bits reader counter markers : Bits) (v : Local) :
    ∃ ticks,
      Stacks.stackRun program ticks ⟨some (code .count),v,store reader counter [] n.bits markers bits [] []⟩=
        some ⟨some returnTo,ReadonlyRepeat.putIO v none,
          store reader counter [] (n+bits.length).bits (List.replicate bits.length true++markers) [] [] []⟩ ∧
      Stacks.stackRunClock program ticks ⟨some (code .count),v,store reader counter [] n.bits markers bits [] []⟩≤
        100*(bits.length+1)*(1+n+2*bits.length+markers.length)^2 := by
  obtain ⟨ticks,hr,hc⟩ := LengthCounter.complete n bits markers (ReadonlyRepeat.getIO v)
  obtain ⟨hN,hNC⟩ := StackCall.execution lengthCode code returnTo ReadonlyRepeat.getIO ReadonlyRepeat.putIO
    (lengthFrame reader counter [] []) (lengthFrame_at reader counter [] []) (lengthFrame_update reader counter [] [])
    (fun _ _ => rfl) (fun _ _ _ => rfl) LengthCounter.program program hcode v ticks _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,
    lengthFrame,Preparation.quad_zero,Preparation.quad_one,Preparation.quad_two,Preparation.quad_three,ReadonlyRepeat.putIO_get] at hN hNC
  exact ⟨ticks,hN,hNC.trans_le hc⟩

theorem drain_reader (reader counter width markers : Bits) (v : Local) :
    Stacks.stackRun program (reader.length+1) ⟨some (.drainReader 0),v,store reader counter [] width markers [] [] []⟩=
      some ⟨some (.cloneWidth .emit),ReadonlyRepeat.putIO v none,store [] counter [] width markers [] [] []⟩ ∧
    Stacks.stackRunClock program (reader.length+1) ⟨some (.drainReader 0),v,store reader counter [] width markers [] [] []⟩=
      reader.length^2+3*reader.length+3 := by
  have hr := Normalization.drain_run reader (ReadonlyRepeat.getIO v)
  obtain ⟨hN,hNC⟩ := StackCall.execution (fun _ : Fin 1 => Slot.reader) Label.drainReader (.cloneWidth .emit)
    ReadonlyRepeat.getIO ReadonlyRepeat.putIO (drainReaderFrame counter [] width markers [] [] [])
    (drainReaderFrame_at counter [] width markers [] [] []) (drainReaderFrame_update counter [] width markers [] [] [])
    (fun _ _ => rfl) (fun _ _ _ => rfl) Normalization.drainProgram program (fun _ => rfl) v (reader.length+1) _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,
    drainReaderFrame,Normalization.singleStack_zero,ReadonlyRepeat.putIO_get] at hN hNC
  exact ⟨hN,hNC.trans (Normalization.drain_clock reader (ReadonlyRepeat.getIO v))⟩

theorem frontend (k count dimension addresses alphabet : ℕ) (tail : Bits) (v : Local) :
    ∃ ticks,
      Stacks.stackRun program ticks
        ⟨some (.start 0),v,store [] [] [] [] [] (input k count dimension addresses alphabet tail).reverse [] []⟩=
        some ⟨some (.cloneWidth .emit),(ReadonlyRepeat.getCounter v,none),
          store [] k.bits [] (width addresses alphabet).bits (List.replicate (width addresses alphabet) true) [] [] []⟩ ∧
      Stacks.stackRunClock program ticks
        ⟨some (.start 0),v,store [] [] [] [] [] (input k count dimension addresses alphabet tail).reverse [] []⟩≤
        10000*(1+(input k count dimension addresses alphabet tail).length)^3 := by
  let raw := input k count dimension addresses alphabet tail
  let ra := natBits alphabet++tail
  let rd := natBits addresses++ra
  let rc := natBits dimension++rd
  let rk := natBits count++rc
  let v1 := ReadonlyRepeat.putIO v none
  obtain ⟨hS,hSC⟩ := start raw v
  obtain ⟨hK,hKC⟩ :=
      parse_call Label.parsePrecision (.transferPrecision 0) (fun _ => rfl) k rk [] [] [] [] [] v1
  obtain ⟨hT,hTC⟩ := transfer_precision k.bits rk [] [] v1
  obtain ⟨hC,hCC⟩ :=
      skip_call Label.skipCount (.skipDimension 0) (fun _ => rfl) count rc k.bits [] [] v1
  obtain ⟨hD,hDC⟩ :=
      skip_call Label.skipDimension (.parseAddress 0) (fun _ => rfl) dimension rd k.bits [] [] v1
  obtain ⟨hA,hAC⟩ :=
      parse_call Label.parseAddress (.countAddress .count) (fun _ => rfl) addresses ra k.bits [] []
      [] [] v1
  obtain ⟨lenATicks,hLA,hLAC⟩ :=
      length_call Label.countAddress (.parseAlphabet 0)
      (fun _ => rfl) 0 addresses.bits.reverse ra k.bits [] v1
  simp only [List.length_reverse,Nat.zero_add,List.append_nil,List.length_nil,Nat.add_zero] at hLA hLAC
  obtain ⟨hB,hBC⟩ := parse_call Label.parseAlphabet (.countAlphabet .count) (fun _ => rfl) alphabet tail k.bits addresses.bits.length.bits
    (List.replicate addresses.bits.length true) [] [] v1
  obtain ⟨lenBTicks,hLB,hLBC⟩ := length_call Label.countAlphabet (.drainReader 0) (fun _ => rfl) addresses.bits.length
    alphabet.bits.reverse tail k.bits (List.replicate addresses.bits.length true) v1
  simp only [List.length_reverse,List.length_replicate] at hLB hLBC
  have hmarks : List.replicate alphabet.bits.length true++List.replicate addresses.bits.length true=
      List.replicate (width addresses alphabet) true := by
    rw [← List.replicate_add]
    congr 1
    dsimp [width]
    omega
  rw [hmarks] at hLB
  obtain ⟨hR,hRC⟩ :=
      drain_reader tail k.bits (width addresses alphabet).bits
      (List.replicate (width addresses alphabet) true) v1
  let B := 1+raw.length
  let Q := 1000*B^3
  have hB1 : 1≤B := by dsimp [B]; omega
  have h23 : B^2≤B^3 := Nat.pow_le_pow_right (by omega) (by decide)
  have hk : k.bits.length≤raw.length := by
    simp only [raw,input,List.length_append,natBits_length]; omega
  have hm : width addresses alphabet≤raw.length := by
    simp only [width,raw,input,List.length_append,natBits_length]; omega
  have ha : addresses.bits.length≤raw.length := by dsimp [width] at hm; omega
  have hb : alphabet.bits.length≤raw.length := by dsimp [width] at hm; omega
  have htail : tail.length≤raw.length := by simp only [raw,input,List.length_append]; omega
  have hkl : k.bits.length≤B := by dsimp [B]; omega
  have htl : tail.length≤B := by dsimp [B]; omega
  have hk2 := Nat.mul_le_mul hkl hkl
  have ht2 := Nat.mul_le_mul htl htl
  have short (rest : Bits) (hr : rest.length≤raw.length) : 40*(1+rest.length)^2≤Q := by
    have hl : 1+rest.length≤B := by dsimp [B]; omega
    have hl2 := Nat.mul_le_mul hl hl
    dsimp only [Q]
    nlinarith only [hl2,h23,Nat.zero_le (B^3)]
  have eS : Stacks.Execution program _ _ Q := ⟨raw.length+1,hS,by
    rw [hSC]; dsimp only [Q,B]; nlinarith only
        [Nat.zero_le raw.length,Nat.zero_le (raw.length^2),Nat.zero_le (raw.length^3)]⟩
  have eK : Stacks.Execution program _ _ Q :=
      ⟨2*k.bits.length+3,hK,hKC.trans (short _ (by exact le_rfl))⟩
  have eT : Stacks.Execution program _ _ Q := ⟨k.bits.length+1,hT,by
    rw [hTC]; dsimp only [Q]; nlinarith only [hk2,hkl,hB1,h23]⟩
  have eC : Stacks.Execution program _ _ Q := ⟨2*count.bits.length+3,hC,hCC.trans (short _ (by
    simp only [rc,rd,ra,raw,input,List.length_append]; omega))⟩
  have eD : Stacks.Execution program _ _ Q := ⟨2*dimension.bits.length+3,hD,hDC.trans (short _ (by
    simp only [rd,ra,raw,input,List.length_append]; omega))⟩
  have eA : Stacks.Execution program _ _ Q := ⟨2*addresses.bits.length+3,hA,hAC.trans (short _ (by
    simp only [ra,raw,input,List.length_append]; omega))⟩
  have hla : addresses.bits.length+1≤B := by dsimp [B]; omega
  have hba : 1+2*addresses.bits.length≤2*B := by dsimp [B]; omega
  have hba2 : (1+2*addresses.bits.length)^2≤(2*B)^2 := by
    simpa only [pow_two] using Nat.mul_le_mul hba hba
  have hlaCost : 100*(addresses.bits.length+1)*(1+2*addresses.bits.length)^2≤Q := by
    have hp := Nat.mul_le_mul (Nat.mul_le_mul_left 100 hla) hba2
    dsimp only [Q]
    nlinarith only [hp,Nat.zero_le (B^3)]
  have eLA : Stacks.Execution program _ _ Q := ⟨lenATicks,hLA,hLAC.trans hlaCost⟩
  have eB : Stacks.Execution program _ _ Q := ⟨2*alphabet.bits.length+3,hB,hBC.trans (short _ (by
    simp only [raw,input,List.length_append]; omega))⟩
  have hlb : alphabet.bits.length+1≤B := by dsimp [B]; omega
  have hbb : 1+addresses.bits.length+2*alphabet.bits.length+addresses.bits.length≤2*B := by
    dsimp [B,width] at hm ⊢
    omega
  have hbb2 : (1+addresses.bits.length+2*alphabet.bits.length+addresses.bits.length)^2≤(2*B)^2 := by
    simpa only [pow_two] using Nat.mul_le_mul hbb hbb
  have hlbCost : 100*(alphabet.bits.length+1)*(1+addresses.bits.length+2*alphabet.bits.length+addresses.bits.length)^2≤Q := by
    have hp := Nat.mul_le_mul (Nat.mul_le_mul_left 100 hlb) hbb2
    dsimp only [Q]
    nlinarith only [hp,Nat.zero_le (B^3)]
  have eLB : Stacks.Execution program _ _ Q := ⟨lenBTicks,hLB,hLBC.trans hlbCost⟩
  have eR : Stacks.Execution program _ _ Q := ⟨tail.length+1,hR,by
    rw [hRC]; dsimp only [Q]; nlinarith only [ht2,htl,hB1,h23]⟩
  obtain ⟨ticks,hr,hc⟩ :=
      (((((((((eS.trans eK).trans eT).trans eC).trans eD).trans eA).trans eLA).trans eB).trans eLB).trans eR)
  refine ⟨ticks,hr,hc.trans ?_⟩
  change Q+Q+Q+Q+Q+Q+Q+Q+Q+Q≤10000*B^3
  dsimp only [Q]
  omega

theorem emit_width (n : ℕ) (reader counter width markers block output : Bits) (v : Local) :
    Stacks.stackRun program (4*n.bits.length+5) ⟨some (.emitWidth .count),v,store reader counter [] width markers n.bits block output⟩=
      some ⟨some (.drainWidthClone 0),ReadonlyRepeat.putIO v none,store reader counter [] width markers n.bits block ((natBits n).reverse++output)⟩ ∧
    Stacks.stackRunClock program (4*n.bits.length+5) ⟨some (.emitWidth .count),v,store reader counter [] width markers n.bits block output⟩≤
      100*(1+n.bits.length+output.length)^2 := by
  obtain ⟨hr,_⟩ := NatEmit.complete n output (ReadonlyRepeat.getIO v)
  have hc := NatEmit.clock_bound n output (ReadonlyRepeat.getIO v)
  obtain ⟨hN,hNC⟩ := StackCall.execution emitWidthCode Label.emitWidth (.drainWidthClone 0) ReadonlyRepeat.getIO ReadonlyRepeat.putIO
    (emitWidthFrame reader counter width markers block) (emitWidthFrame_at reader counter width markers block) (emitWidthFrame_update reader counter width markers block)
    (fun _ _ => rfl) (fun _ _ _ => rfl) NatEmit.program program (fun _ => rfl) v (4*n.bits.length+5) _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,
    emitWidthFrame,Parsing.triple_zero,Parsing.triple_one,Parsing.triple_two,ReadonlyRepeat.putIO_get] at hN hNC
  exact ⟨hN,hNC.trans_le hc⟩

