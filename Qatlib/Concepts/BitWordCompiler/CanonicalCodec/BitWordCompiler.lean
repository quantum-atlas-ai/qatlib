  obtain ⟨hN,hNC⟩ := StackCall.execution (fun _ : Fin 1 => Slot.reader) Label.drainReader (.emitWire .count)
    ReadonlyRepeat.getIO ReadonlyRepeat.putIO (drainReaderFrame counter temp wire block output)
    (drainReaderFrame_at counter temp wire block output) (drainReaderFrame_update counter temp wire block output)
    (fun _ _ => rfl) (fun _ _ _ => rfl) Normalization.drainProgram program (fun _ => rfl) v (reader.length+1) _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,
    drainReaderFrame,Normalization.singleStack_zero,ReadonlyRepeat.putIO_get] at hN hNC
