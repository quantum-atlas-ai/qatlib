theorem precision_call (k : ℕ) (reader params counters discard : Bits) (v : Local) :
    Stacks.stackRun program (2*k.bits.length+3) ⟨some (.precision .emit),v,store reader params counters k.bits.reverse [] [] discard []⟩=
      some ⟨some (.drain 0),putIO v none,store reader params counters k.bits.reverse k.bits [] discard []⟩ ∧
    Stacks.stackRunClock program (2*k.bits.length+3) ⟨some (.precision .emit),v,store reader params counters k.bits.reverse [] [] discard []⟩≤25*(1+k.bits.length)^2 := by
  let S := store reader params counters k.bits.reverse [] [] discard []
  have hsame : StackCall.frame precisionCode S (Parsing.triple k.bits.reverse [] [])=S := by
    apply StackCall.frame_same _ _ _ precisionCode_injective
    intro j
    fin_cases j <;> rfl
  have hfinal : StackCall.frame precisionCode S (Parsing.triple k.bits.reverse [] k.bits)=store reader params counters k.bits.reverse k.bits [] discard [] := by
    funext bank
    cases bank
    all_goals first
    | exact StackCall.frame_at precisionCode S _ precisionCode_injective 0
    | exact StackCall.frame_at precisionCode S _ precisionCode_injective 1
    | exact StackCall.frame_at precisionCode S _ precisionCode_injective 2
    | (rw [WordValidator.frame_outside precisionCode S _ _ (by intro j; fin_cases j <;> simp [precisionCode])]; rfl)
  obtain ⟨hr,_⟩ := NatEmit.copy_complete k.bits.reverse [] (getIO v)
  simp only [List.length_reverse,List.reverse_reverse,List.append_nil] at hr
  obtain ⟨hN,hNC⟩ := StackCall.execution precisionCode Label.precision (.drain 0) getIO putIO
    (StackCall.frame precisionCode S)
    (fun data j => StackCall.frame_at _ _ data precisionCode_injective j)
    (fun data j bits => StackCall.frame_update _ _ data precisionCode_injective j bits)
    (fun _ _ => rfl) (fun _ _ _ => rfl) NatEmit.program program (fun _ => rfl) v (2*k.bits.length+3) _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,getIO,putIO,hsame,hfinal] at hN hNC
  have hc := NatEmit.copy_clock_bound k.bits.reverse [] (getIO v)
  simp only [List.length_reverse,List.length_nil,Nat.add_zero] at hc
  exact ⟨hN,hNC.trans_le hc⟩

theorem finish (reader params counters precision value discard : Bits) (v : Local) : ∃ ticks last,
    Stacks.stackRun program ticks ⟨some (.drain 0),v,store reader params counters precision value [] discard []⟩=
      some ⟨none,last,store reader params counters precision value [] [] []⟩ ∧
    Stacks.stackRunClock program ticks ⟨some (.drain 0),v,store reader params counters precision value [] discard []⟩≤10*(1+discard.length)^2 := by
  let S := store reader params counters precision value [] discard []
  have hinj : Function.Injective drainCode := fun _ _ _ => Subsingleton.elim _ _
  have hsame : StackCall.frame drainCode S (Normalization.singleStack discard)=S := by
    apply StackCall.frame_same _ _ _ hinj
    intro j
    rfl
  have hfinal : StackCall.frame drainCode S (Normalization.singleStack [])=store reader params counters precision value [] [] [] := by
    funext bank
    cases bank
    all_goals first
    | exact StackCall.frame_at drainCode S _ hinj 0
    | (rw [WordValidator.frame_outside drainCode S _ _ (by intro j; simp [drainCode])]; rfl)
  have hr := Normalization.drain_run discard (getIO v)
  obtain ⟨hN,hNC⟩ := StackCall.execution drainCode Label.drain (.step .done) getIO putIO
    (StackCall.frame drainCode S)
    (fun data j => StackCall.frame_at _ _ data hinj j)
    (fun data j bits => StackCall.frame_update _ _ data hinj j bits)
    (fun _ _ => rfl) (fun _ _ _ => rfl) Normalization.drainProgram program (fun _ => rfl) v (discard.length+1) _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,getIO,putIO,hsame,hfinal] at hN hNC
  have hc := Normalization.drain_clock discard (getIO v)
  have hH : Stacks.stackRun program 1 ⟨some (.step .done),putIO v none,store reader params counters precision value [] [] []⟩=
      some ⟨none,putIO v none,store reader params counters precision value [] [] []⟩ := rfl
  have hHC :
      Stacks.stackRunClock program 1 ⟨some (.step .done),putIO v none,store reader params counters precision value [] [] []⟩=1 := rfl
  have eD : Stacks.Execution program _ _ _ := ⟨discard.length+1,hN,hNC.trans_le hc.le⟩
  have eH : Stacks.Execution program _ _ 1 := ⟨1,hH,hHC.le⟩
  obtain ⟨ticks,hR,hC⟩ := eD.trans eH
  exact ⟨ticks,putIO v none,hR,hC.trans (by nlinarith only [Nat.zero_le discard.length,Nat.zero_le (discard.length^2)])⟩

theorem lookup_complete (context : Bool) (values : List Bits) (other reader precision counter discard : Bits) (v : Local) : ∃ ticks last,
    Stacks.stackRun program ticks ⟨some (.lookup context (.copy .emit)),v,
      store reader (if context then other else (TableGet.stream values).reverse)
        (if context then (TableGet.stream values).reverse else other) precision counter [] discard []⟩=
      some ⟨none,last,store reader (if context then other else (TableGet.stream values).reverse)
        (if context then (TableGet.stream values).reverse else other) precision
        (binaryValue (values.getD (binaryValue counter) [])).bits [] [] []⟩ ∧
    Stacks.stackRunClock program ticks ⟨some (.lookup context (.copy .emit)),v,
      store reader (if context then other else (TableGet.stream values).reverse)
        (if context then (TableGet.stream values).reverse else other) precision counter [] discard []⟩≤
      100000*(1+(TableGet.stream values).length+counter.length+discard.length)^3 := by
  let params := if context then other else (TableGet.stream values).reverse
  let counters := if context then (TableGet.stream values).reverse else other
  let bits := values.getD (binaryValue counter) []
  let n := binaryValue bits
  obtain ⟨getTicks,v1,hG,hGC⟩ := lookup_call context values other reader precision counter discard v
  obtain ⟨normTicks,v2,hN,hNC⟩ := normalize_call bits reader params counters precision discard v1
  obtain ⟨hT,hTC⟩ := transfer_value_call n reader params counters precision discard v2
  obtain ⟨finishTicks,last,hF,hFC⟩ :=
      finish reader params counters precision n.bits discard (putIO v2 none)
  have eG : Stacks.Execution program _ _ _ := ⟨getTicks,hG,hGC⟩
  have eN : Stacks.Execution program _ _ _ := ⟨normTicks,hN,hNC⟩
  have eT : Stacks.Execution program _ _ _ := ⟨n.bits.length+1,hT,hTC.le⟩
  have eF : Stacks.Execution program _ _ _ := ⟨finishTicks,hF,hFC⟩
  obtain ⟨ticks,hr,hc⟩ := ((eG.trans eN).trans eT).trans eF
  refine ⟨ticks,last,hr,hc.trans ?_⟩
  let B := 1+(TableGet.stream values).length+counter.length+discard.length
  have hB : 1≤B := by dsimp [B]; omega
  have hB2 : B≤B^2 := Nat.le_pow (by decide)
  have h23 : B^2≤B^3 := Nat.pow_le_pow_right hB (by decide)
  have hbits : bits.length≤(TableGet.stream values).length :=
      TableGet.entry_length values (binaryValue counter)
  have hn : n.bits.length≤bits.length := BinaryNormalize.canonical_length bits
  have hnb : n.bits.length≤B := by dsimp [B]; omega
  have hnb2 := Nat.mul_le_mul hnb hnb
  have hg1 : 1+(TableGet.stream values).length≤B := by dsimp [B]; omega
  have hg2 : 1+(TableGet.stream values).length+counter.length≤B := by dsimp [B]; omega
  have hget := Nat.mul_le_mul hg1 (Nat.pow_le_pow_left hg2 2)
  have hn2 := Nat.pow_le_pow_left (show 1+bits.length≤B by dsimp [B]; omega) 2
  have hf2 := Nat.pow_le_pow_left (show 1+discard.length≤B by dsimp [B]; omega) 2
  change 30000*(1+(TableGet.stream values).length)*(1+(TableGet.stream values).length+counter.length)^2+
    20*(1+bits.length)^2+(n.bits.length*(2*n.bits.length+5)+3)+10*(1+discard.length)^2≤100000*B^3
  nlinarith only [hB,hB2,h23,hnb,hnb2,hget,hn2,hf2]

theorem phase_step (phase : Phase) (S : Slot → Bits) (v : Local) :
    Stacks.stackRun program 1 ⟨some (.step phase),v,S⟩=some (TM2.stepAux (phaseProgram phase) v S) := rfl

theorem goto_phase (phase : Phase) (after : Label) (hcode : phaseProgram phase=.goto (fun _ => after)) (S : Slot → Bits) (v : Local) :
    Stacks.stackRun program 1 ⟨some (.step phase),v,S⟩=some ⟨some after,v,S⟩ ∧
    Stacks.stackRunClock program 1 ⟨some (.step phase),v,S⟩=1 := by
  constructor
  · rw [phase_step,hcode]
    rfl
  · simp [Stacks.stackRunClock,program,hcode,Stacks.stackClock]

theorem literal_complete (n : ℕ) (tail params counters precision discard : Bits) (v : Local) : ∃ ticks last,
    Stacks.stackRun program ticks ⟨some (.read .literalDone (.read .unary)),v,store (natBits n++tail) params counters precision [] [] discard []⟩=
      some ⟨none,last,store tail params counters precision n.bits [] [] []⟩ ∧
    Stacks.stackRunClock program ticks ⟨some (.read .literalDone (.read .unary)),v,store (natBits n++tail) params counters precision [] [] discard []⟩≤
      1000*(1+(natBits n++tail).length+discard.length)^2 := by
  obtain ⟨readTicks,v1,hR,hRC⟩ := read_call .literalDone n tail params counters precision discard v
  let S1 := store tail params counters precision n.bits [] ((natBits n).reverse++discard) []
  obtain ⟨hG,hGC⟩ := goto_phase .literalDone (.drain 0) rfl S1 v1
  obtain ⟨finishTicks,last,hF,hFC⟩ :=
      finish tail params counters precision n.bits ((natBits n).reverse++discard) v1
  have eR : Stacks.Execution program _ _ _ := ⟨readTicks,hR,hRC⟩
  have eG : Stacks.Execution program _ _ 1 := ⟨1,hG,hGC.le⟩
  have eF : Stacks.Execution program _ _ _ := ⟨finishTicks,hF,hFC⟩
  obtain ⟨ticks,hr,hc⟩ := (eR.trans eG).trans eF
  refine ⟨ticks,last,hr,hc.trans ?_⟩
  let B := 1+(natBits n++tail).length+discard.length
  have hB : 1≤B^2 := Nat.one_le_pow 2 _ (by dsimp [B]; omega)
  have hh : 1+((natBits n).reverse++discard).length≤B := by
    dsimp [B]
    simp only [List.length_reverse,List.length_append]
    omega
  have hh2 := Nat.pow_le_pow_left hh 2
  change 500*B^2+1+10*(1+((natBits n).reverse++discard).length)^2≤1000*B^2
  nlinarith only [hB,hh2]

theorem indexed_complete (context : Bool) (values : List Bits) (other : Bits) (i : ℕ) (tail precision discard : Bits) (v : Local) : ∃ ticks last,
    Stacks.stackRun program ticks ⟨some (.read (if context then .counterDone else .paramDone) (.read .unary)),v,
      store (natBits i++tail) (if context then other else (TableGet.stream values).reverse)
        (if context then (TableGet.stream values).reverse else other) precision [] [] discard []⟩=
      some ⟨none,last,store tail (if context then other else (TableGet.stream values).reverse)
        (if context then (TableGet.stream values).reverse else other) precision (binaryValue (values.getD i [])).bits [] [] []⟩ ∧
    Stacks.stackRunClock program ticks ⟨some (.read (if context then .counterDone else .paramDone) (.read .unary)),v,
      store (natBits i++tail) (if context then other else (TableGet.stream values).reverse)
        (if context then (TableGet.stream values).reverse else other) precision [] [] discard []⟩≤
      1000000*(1+(natBits i++tail).length+discard.length+(TableGet.stream values).length)^3 := by
  let params := if context then other else (TableGet.stream values).reverse
  let counters := if context then (TableGet.stream values).reverse else other
  let ret := if context then Phase.counterDone else .paramDone
  obtain ⟨readTicks,v1,hR,hRC⟩ := read_call ret i tail params counters precision discard v
  let D := (natBits i).reverse++discard
  let S1 := store tail params counters precision i.bits [] D []
  have hcode : phaseProgram ret=.goto (fun _ => .lookup context (.copy .emit)) := by
    cases context <;> rfl
  obtain ⟨hG,hGC⟩ := goto_phase ret (.lookup context (.copy .emit)) hcode S1 v1
  obtain ⟨getTicks,last,hL,hLC⟩ := lookup_complete context values other tail precision i.bits D v1
  simp only [binaryValue_bits] at hL
  have eR : Stacks.Execution program _ _ _ := ⟨readTicks,hR,hRC⟩
  have eG : Stacks.Execution program _ _ 1 := ⟨1,hG,hGC.le⟩
  have eL : Stacks.Execution program _ _ _ := ⟨getTicks,hL,hLC⟩
  obtain ⟨ticks,hr,hc⟩ := (eR.trans eG).trans eL
  refine ⟨ticks,last,hr,hc.trans ?_⟩
  let B := 1+(natBits i++tail).length+discard.length+(TableGet.stream values).length
  have hB : 1≤B := by dsimp [B]; omega
  have h23 : B^2≤B^3 := Nat.pow_le_pow_right hB (by decide)
  have hB3 : 1≤B^3 := Nat.one_le_pow 3 _ hB
  have hread :=
      Nat.pow_le_pow_left (show 1+(natBits i++tail).length+discard.length≤B by dsimp [B]; omega) 2
  have hgroup : 1+(TableGet.stream values).length+i.bits.length+D.length≤2*B := by
    dsimp [B,D]
    simp only [List.length_append,List.length_reverse,natBits_length]
    omega
  have hgroup3 := Nat.pow_le_pow_left hgroup 3
  change 500*(1+(natBits i++tail).length+discard.length)^2+1+
    100000*(1+(TableGet.stream values).length+i.bits.length+D.length)^3≤1000000*B^3
  nlinarith only [h23,hB3,hread,hgroup3]

theorem precision_complete (k : ℕ) (tail params counters discard : Bits) (v : Local) : ∃ ticks last,
    Stacks.stackRun program ticks ⟨some (.precision .emit),v,store tail params counters k.bits.reverse [] [] discard []⟩=
      some ⟨none,last,store tail params counters k.bits.reverse k.bits [] [] []⟩ ∧
    Stacks.stackRunClock program ticks ⟨some (.precision .emit),v,store tail params counters k.bits.reverse [] [] discard []⟩≤
      1000*(1+k.bits.length+discard.length)^2 := by
  obtain ⟨hP,hPC⟩ := precision_call k tail params counters discard v
  obtain ⟨finishTicks,last,hF,hFC⟩ :=
      finish tail params counters k.bits.reverse k.bits discard (putIO v none)
  have eP : Stacks.Execution program _ _ _ := ⟨2*k.bits.length+3,hP,hPC⟩
  have eF : Stacks.Execution program _ _ _ := ⟨finishTicks,hF,hFC⟩
  obtain ⟨ticks,hr,hc⟩ := eP.trans eF
  refine ⟨ticks,last,hr,hc.trans ?_⟩
  have h1 := Nat.pow_le_pow_left (show 1+k.bits.length≤1+k.bits.length+discard.length by omega) 2
  have h2 := Nat.pow_le_pow_left (show 1+discard.length≤1+k.bits.length+discard.length by omega) 2
  nlinarith only [h1,h2]

def tableValue (params counters : List Bits) (k : ℕ) : Scalar → ℕ
  | .literal n => n
  | .parameter i => binaryValue (params.getD i [])
  | .precision => k
  | .counter d => binaryValue (counters.getD d [])

def scalarTag : Scalar → Fin 4
  | .literal _ => 0 | .parameter _ => 1 | .precision => 2 | .counter _ => 3

def bodyBits : Scalar → Bits
  | .literal n => natBits n | .parameter i => natBits i | .precision => [] | .counter d => natBits d

def bodyLabel : Scalar → Label
  | .literal _ => .read .literalDone (.read .unary)
  | .parameter _ => .read .paramDone (.read .unary)
  | .precision => .precision .emit
  | .counter _ => .read .counterDone (.read .unary)

def size (reader : Bits) (params counters : List Bits) (k : ℕ) (discard : Bits) : ℕ :=
  1+reader.length+(TableGet.stream params).length+(TableGet.stream counters).length+k.bits.length+discard.length

theorem scalarBits_parts (s : Scalar) : scalarBits s=natBits (scalarTag s).val++bodyBits s := by
    cases s <;> rfl

theorem quad_budget {a B : ℕ} (h : a≤B) (hB : 1≤B) : 1000*a^2≤1000000*B^3 := by
  have ha := Nat.pow_le_pow_left h 2
  have h23 := Nat.pow_le_pow_right hB (show 2≤3 by decide)
  nlinarith only [ha,h23]

theorem body_complete (s : Scalar) (params counters : List Bits) (k : ℕ) (tail discard : Bits) (v : Local) : ∃ ticks last,
    Stacks.stackRun program ticks ⟨some (bodyLabel s),v,
      store (bodyBits s++tail) (TableGet.stream params).reverse (TableGet.stream counters).reverse k.bits.reverse [] [] discard []⟩=
      some ⟨none,last,store tail (TableGet.stream params).reverse (TableGet.stream counters).reverse k.bits.reverse
        (tableValue params counters k s).bits [] [] []⟩ ∧
    Stacks.stackRunClock program ticks ⟨some (bodyLabel s),v,
      store (bodyBits s++tail) (TableGet.stream params).reverse (TableGet.stream counters).reverse k.bits.reverse [] [] discard []⟩≤
      1000000*(size (bodyBits s++tail) params counters k discard)^3 := by
  have hB (reader : Bits) : 1≤size reader params counters k discard := by dsimp [size]; omega
  cases s with
  | literal n =>
    obtain ⟨ticks,last,hr,hc⟩ :=
        literal_complete n tail (TableGet.stream params).reverse
        (TableGet.stream counters).reverse k.bits.reverse discard v
    exact ⟨ticks,last,hr,hc.trans (quad_budget (by dsimp [size,bodyBits]; omega) (hB _))⟩
  | parameter i =>
    obtain ⟨ticks,last,hr,hc⟩ :=
        indexed_complete false params
        (TableGet.stream counters).reverse i tail k.bits.reverse discard v
    refine ⟨ticks,last,hr,hc.trans ?_⟩
    exact Nat.mul_le_mul_left 1000000 (Nat.pow_le_pow_left (by dsimp [size,bodyBits]; omega) 3)
  | precision =>
    obtain ⟨ticks,last,hr,hc⟩ :=
        precision_complete k tail (TableGet.stream params).reverse
        (TableGet.stream counters).reverse discard v
    refine ⟨ticks,last,hr,hc.trans ?_⟩
    exact quad_budget (by dsimp [size,bodyBits]; omega) (hB _)
  | counter d =>
    obtain ⟨ticks,last,hr,hc⟩ :=
        indexed_complete true counters
        (TableGet.stream params).reverse d tail k.bits.reverse discard v
    refine ⟨ticks,last,hr,hc.trans ?_⟩
    exact Nat.mul_le_mul_left 1000000 (Nat.pow_le_pow_left (by dsimp [size,bodyBits]; omega) 3)

theorem dispatch_call (s : Scalar) (S : Slot → Bits) (v : Local) (htag : (getTag v).1.val=(scalarTag s).val) :
    Stacks.stackRun program 1 ⟨some (.step .dispatch),v,S⟩=some ⟨some (bodyLabel s),v,S⟩ ∧
    Stacks.stackRunClock program 1 ⟨some (.step .dispatch),v,S⟩=1 := by
  constructor
  · rw [phase_step]
    have heq : (getTag v).1=⟨(scalarTag s).val,by have := (scalarTag s).isLt; omega⟩ := Fin.ext htag
    cases s <;> simp [phaseProgram,scalarTag,bodyLabel,TM2.stepAux,heq]
  · simp [Stacks.stackRunClock,program,phaseProgram,Stacks.stackClock]

theorem complete_tables (s : Scalar) (params counters : List Bits) (k : ℕ) (tail : Bits) (v : Local) : ∃ ticks last,
    Stacks.stackRun program ticks ⟨some (.read .afterTag (.read .unary)),v,
      store (scalarBits s++tail) (TableGet.stream params).reverse (TableGet.stream counters).reverse k.bits.reverse [] [] [] []⟩=
      some ⟨none,last,store tail (TableGet.stream params).reverse (TableGet.stream counters).reverse k.bits.reverse
        (tableValue params counters k s).bits [] [] []⟩ ∧
    Stacks.stackRunClock program ticks ⟨some (.read .afterTag (.read .unary)),v,
      store (scalarBits s++tail) (TableGet.stream params).reverse (TableGet.stream counters).reverse k.bits.reverse [] [] [] []⟩≤
      2000000*(size (scalarBits s++tail) params counters k [])^3 := by
  let n : Fin 8 := ⟨(scalarTag s).val,by have := (scalarTag s).isLt; omega⟩
  let rest := bodyBits s++tail
  let paramsBits := (TableGet.stream params).reverse
  let countersBits := (TableGet.stream counters).reverse
  obtain ⟨readTicks,v1,hR,hRC⟩ :=
      read_call .afterTag n.val rest paramsBits countersBits k.bits.reverse [] v
  simp only [List.append_nil] at hR
  let D := (natBits n.val).reverse
  let S1 := store rest paramsBits countersBits k.bits.reverse n.val.bits [] D []
  obtain ⟨hG,hGC⟩ := goto_phase .afterTag (.transferTag 0) rfl S1 v1
  obtain ⟨tagTicks,v2,hT,htag,hTC⟩ :=
      classify_call n rest paramsBits countersBits k.bits.reverse D v1
  let S2 := store rest paramsBits countersBits k.bits.reverse [] [] D []
  obtain ⟨hD,hDC⟩ := dispatch_call s S2 v2 (congrArg Fin.val htag)
  obtain ⟨bodyTicks,last,hB,hBC⟩ := body_complete s params counters k tail D v2
  have eR : Stacks.Execution program _ _ _ := ⟨readTicks,hR,hRC⟩
  have eG : Stacks.Execution program _ _ 1 := ⟨1,hG,hGC.le⟩
  have eT : Stacks.Execution program _ _ _ := ⟨tagTicks,hT,hTC⟩
  have eD : Stacks.Execution program _ _ 1 := ⟨1,hD,hDC.le⟩
  have eB : Stacks.Execution program _ _ _ := ⟨bodyTicks,hB,hBC⟩
  obtain ⟨ticks,hr,hc⟩ := (((eR.trans eG).trans eT).trans eD).trans eB
  have hinput : natBits n.val++rest=scalarBits s++tail := by
    rw [scalarBits_parts]; exact List.append_assoc _ _ _ |>.symm
  refine ⟨ticks,last,?_,?_⟩
  · simpa only [List.append_nil,hinput] using hr
  · let B := size (scalarBits s++tail) params counters k []
    have hB1 : 1≤B := by dsimp [B,size]; omega
    have h13 : 1≤B^3 := Nat.one_le_pow 3 _ hB1
    have h23 : B^2≤B^3 := Nat.pow_le_pow_right hB1 (by decide)
    have hread : 1+(natBits n.val++rest).length+0≤B := by rw [hinput]; dsimp [B,size]; omega
    have htaglen : 1+n.val.bits.length≤B := by
      have he := congrArg List.length hinput
      simp only [List.length_append,natBits_length] at he
      dsimp [B,size]
      simp only [List.length_append]
      omega
    have hbody : size (bodyBits s++tail) params counters k D=B := by
      dsimp [size,B,D,rest] at *
      rw [← hinput]
      simp only [List.length_append,List.length_reverse]
      omega
    have hread2 := Nat.pow_le_pow_left hread 2
    have htag2 := Nat.pow_le_pow_left htaglen 2
    have hbound : 500*(1+(natBits n.val++rest).length+0)^2+1+
        100*(1+n.val.bits.length)^2+1+1000000*(size (bodyBits s++tail) params counters k D)^3≤2000000*B^3 := by
      rw [hbody]
      nlinarith only [h13,h23,hread2,htag2]
    simpa only [List.append_nil,hinput] using hc.trans hbound

theorem tableValue_counters (params : List Bits) (counters : List ℕ) (k : ℕ) (s : Scalar) :
    tableValue params (counters.map Nat.bits) k s=value params k counters s := by
  cases s with
  | literal n => rfl
  | parameter i => rfl
  | precision => rfl
  | counter d =>
    simp only [tableValue,value,ReadonlyTableGet.counter_table_value,binaryValue_bits]

theorem complete (s : Scalar) (params : List Bits) (counters : List ℕ) (k : ℕ) (tail : Bits) (v : Local) : ∃ ticks last,
    Stacks.stackRun program ticks ⟨some (.read .afterTag (.read .unary)),v,
      store (scalarBits s++tail) (TableGet.stream params).reverse (TableGet.stream (counters.map Nat.bits)).reverse k.bits.reverse [] [] [] []⟩=
      some ⟨none,last,store tail (TableGet.stream params).reverse (TableGet.stream (counters.map Nat.bits)).reverse k.bits.reverse
        (value params k counters s).bits [] [] []⟩ ∧
    Stacks.stackRunClock program ticks ⟨some (.read .afterTag (.read .unary)),v,
      store (scalarBits s++tail) (TableGet.stream params).reverse (TableGet.stream (counters.map Nat.bits)).reverse k.bits.reverse [] [] [] []⟩≤
      2000000*(size (scalarBits s++tail) params (counters.map Nat.bits) k [])^3 := by
  simpa only [tableValue_counters] using complete_tables s params (counters.map Nat.bits) k tail v

end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.ScalarEval

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.TableCopy
open Turing Qatlib.Concepts.BitWordCompiler.CanonicalCodec
inductive Slot where | reader | count | countTemp | discard | markers | payload | value | temporary | pending | output deriving DecidableEq,Fintype
inductive DrainBank where | count | discard deriving DecidableEq,Fintype
inductive Phase where | countDone | decide | clearHeader | done deriving DecidableEq,Fintype
inductive Label where
  | read (l : NatReadEmit.Label)
  | counter (l : Counter.Label)
  | frame (l : PlanCopy.Label)
  | drain (bank : DrainBank) (ret : Phase) (l : Fin 1)
  | step (phase : Phase)
  deriving DecidableEq,Fintype
instance : Inhabited Label := ⟨.read (.read .unary)⟩
abbrev Local := Counter.Local×NatReadEmit.Local×PlanCopy.Local×Symbol

def getCounter (v : Local) := v.1
def putCounter (v : Local) (s : Counter.Local) : Local := (s,v.2)
def getRead (v : Local) := v.2.1
def putRead (v : Local) (s : NatReadEmit.Local) : Local := (v.1,s,v.2.2)
def getFrame (v : Local) := v.2.2.1
def putFrame (v : Local) (s : PlanCopy.Local) : Local := (v.1,v.2.1,s,v.2.2.2)
def getIO (v : Local) := v.2.2.2
def putIO (v : Local) (s : Symbol) : Local := (v.1,v.2.1,v.2.2.1,s)
def counterCode : Fin 2 → Slot | 0 => .count | _ => .countTemp

def readCode : NatReadEmit.Slot → Slot
  | .reader => .reader | .markers => .markers | .payload => .payload | .value => .count | .temporary => .countTemp | .output => .discard

def frameCode : PlanCopy.Slot → Slot
  | .reader => .reader | .pending => .pending | .markers => .markers | .payload => .payload
  | .value => .value | .temporary => .temporary | .output => .output

def drainKey : DrainBank → Slot | .count => .count | .discard => .discard
def drainCode (bank : DrainBank) (_ : Fin 1) : Slot := drainKey bank

def phaseProgram : Phase → TM2.Stmt (fun _ : Slot => Bool) Label Local
  | .countDone => .goto (fun _ => .counter .borrow)
  | .decide => .branch (fun v => (getCounter v).1)
      (.goto (fun _ => .frame (.read .literalReady (.read .unary)))) (.goto (fun _ => .drain .count .clearHeader 0))
  | .clearHeader => .goto (fun _ => .drain .discard .done 0)
  | .done => .halt

def program : Label → TM2.Stmt (fun _ : Slot => Bool) Label Local
  | .read l => StackCall.stmt readCode Label.read (.step .countDone) getRead putRead (NatReadEmit.program l)
  | .counter l => StackCall.stmt counterCode Label.counter (.step .decide) getCounter putCounter (Counter.program l)
  | .frame l => StackCall.stmt frameCode Label.frame (.counter .borrow) getFrame putFrame (PlanCopy.program l)
  | .drain bank ret l => StackCall.stmt (drainCode bank) (Label.drain bank ret) (.step ret) getIO putIO (Normalization.drainProgram l)
  | .step phase => phaseProgram phase

def store (reader count discard out : Bits) : Slot → Bits
  | .reader => reader | .count => count | .discard => discard | .output => out | _ => []

theorem counterCode_injective : Function.Injective counterCode := by
    intro a b h; fin_cases a <;> fin_cases b <;> simp [counterCode] at h ⊢

theorem readCode_injective : Function.Injective readCode := by
    intro a b h; cases a <;> cases b <;> simp [readCode] at h ⊢

theorem frameCode_injective : Function.Injective frameCode := by
    intro a b h; cases a <;> cases b <;> simp [frameCode] at h ⊢

@[simp] theorem store_update_count (reader count discard out next : Bits) :
    Function.update (store reader count discard out) .count next=store reader next discard out := by funext k; cases k <;> rfl

@[simp] theorem store_update_discard (reader count discard out next : Bits) :
    Function.update (store reader count discard out) .discard next=store reader count next out := by funext k; cases k <;> rfl

theorem counter_frame (S : Slot → Bits) (counter next : Bits) (hc : S .count=counter) (ht : S .countTemp=[]) :
    StackCall.frame counterCode S (Stacks.stackPair next [])=Function.update S .count next := by
  have hinj := counterCode_injective
  have hsame : StackCall.frame counterCode S (Stacks.stackPair counter [])=S := by
    apply StackCall.frame_same _ _ _ hinj
    intro k
    fin_cases k <;> simp [counterCode,Stacks.stackPair,hc,ht]
  have h := StackCall.frame_update counterCode S (Stacks.stackPair counter []) hinj 0 next
  simpa only [Stacks.stackPair_update_zero,hsame] using! h

theorem counter_zero (counter reader discard out : Bits) (v : Local) (hz : binaryValue counter=0) :
    Stacks.stackRun program (2*counter.length+2) ⟨some (.counter .borrow),v,store reader counter discard out⟩=
      some ⟨some (.step .decide),putCounter v (false,none),store reader (List.replicate counter.length true) discard out⟩ ∧
    Stacks.stackRunClock program (2*counter.length+2) ⟨some (.counter .borrow),v,store reader counter discard out⟩≤10*(1+counter.length)^2 := by
  let S := store reader counter discard out
  have hsame : StackCall.frame counterCode S (Stacks.stackPair counter [])=S := by
    rw [counter_frame S counter counter rfl rfl]
    exact Function.update_eq_self .count S
  obtain ⟨hr,hc⟩ := Counter.decrement_zero counter (getCounter v) hz
  obtain ⟨hN,hNC⟩ := StackCall.execution counterCode Label.counter (.step .decide) getCounter putCounter
    (StackCall.frame counterCode S)
    (fun data k => StackCall.frame_at _ _ data counterCode_injective k)
    (fun data k bits => StackCall.frame_update _ _ data counterCode_injective k bits)
    (fun _ _ => rfl) (fun _ _ _ => rfl) Counter.program program (fun _ => rfl) v (2*counter.length+2) _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,getCounter,putCounter,
    hsame,counter_frame S counter _ rfl rfl,S,store_update_count] at hN hNC
  exact ⟨hN,hNC.trans_le hc⟩

theorem counter_positive (counter reader discard out : Bits) (v : Local) (hp : 0<binaryValue counter) :
    ∃ ticks next,next.length=counter.length ∧ binaryValue next+1=binaryValue counter ∧
      Stacks.stackRun program ticks ⟨some (.counter .borrow),v,store reader counter discard out⟩=
        some ⟨some (.step .decide),putCounter v (true,none),store reader next discard out⟩ ∧
      Stacks.stackRunClock program ticks ⟨some (.counter .borrow),v,store reader counter discard out⟩≤10*(1+counter.length)^2 := by
  let S := store reader counter discard out
  have hsame : StackCall.frame counterCode S (Stacks.stackPair counter [])=S := by
    rw [counter_frame S counter counter rfl rfl]
    exact Function.update_eq_self .count S
  obtain ⟨ticks,next,_,hlen,hvalue,hr,hc⟩ := Counter.decrement_positive counter (getCounter v) hp
  obtain ⟨hN,hNC⟩ := StackCall.execution counterCode Label.counter (.step .decide) getCounter putCounter
    (StackCall.frame counterCode S)
    (fun data k => StackCall.frame_at _ _ data counterCode_injective k)
    (fun data k bits => StackCall.frame_update _ _ data counterCode_injective k bits)
    (fun _ _ => rfl) (fun _ _ _ => rfl) Counter.program program (fun _ => rfl) v ticks _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,getCounter,putCounter,
    hsame,counter_frame S counter next rfl rfl,S,store_update_count] at hN hNC
  exact ⟨ticks,next,hlen,hvalue,hN,hNC.trans_le hc⟩

theorem frame_call (bits tail counter discard out : Bits) (v : Local) : ∃ ticks last,
    Stacks.stackRun program ticks ⟨some (.frame (.read .literalReady (.read .unary))),v,store (framed bits++tail) counter discard out⟩=
      some ⟨some (.counter .borrow),last,store tail counter discard ((framed bits).reverse++out)⟩ ∧
    Stacks.stackRunClock program ticks ⟨some (.frame (.read .literalReady (.read .unary))),v,store (framed bits++tail) counter discard out⟩≤
      20000*(1+(framed bits).length)*(1+(framed bits++tail).length+out.length)^2 := by
  let S := store (framed bits++tail) counter discard out
  have hinj := frameCode_injective
  have hsame : StackCall.frame frameCode S (PlanCopy.store (framed bits++tail) [] [] [] out)=S := by
    apply StackCall.frame_same _ _ _ hinj
    intro k
    cases k <;> rfl
  have hfinal : StackCall.frame frameCode S (PlanCopy.store tail [] [] [] ((framed bits).reverse++out))=store tail counter discard ((framed bits).reverse++out) := by
    funext bank
    cases bank
    all_goals first
    | exact StackCall.frame_at frameCode S _ hinj PlanCopy.Slot.reader
    | exact StackCall.frame_at frameCode S _ hinj PlanCopy.Slot.pending
    | exact StackCall.frame_at frameCode S _ hinj PlanCopy.Slot.markers
    | exact StackCall.frame_at frameCode S _ hinj PlanCopy.Slot.payload
    | exact StackCall.frame_at frameCode S _ hinj PlanCopy.Slot.value
    | exact StackCall.frame_at frameCode S _ hinj PlanCopy.Slot.temporary
    | exact StackCall.frame_at frameCode S _ hinj PlanCopy.Slot.output
    | (rw [WordValidator.frame_outside frameCode S _ _ (by intro k; cases k <;> simp [frameCode])]; rfl)
  obtain ⟨ticks,last,hr,hc⟩ := PlanCopy.framed_complete bits tail out (getFrame v)
  obtain ⟨hN,hNC⟩ := StackCall.execution frameCode Label.frame (.counter .borrow) getFrame putFrame
    (StackCall.frame frameCode S)
    (fun data k => StackCall.frame_at _ _ data hinj k)
    (fun data k bits => StackCall.frame_update _ _ data hinj k bits)
    (fun _ _ => rfl) (fun _ _ _ => rfl) PlanCopy.program program (fun _ => rfl) v ticks _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,getFrame,putFrame,hsame,hfinal] at hN hNC
  exact ⟨ticks,putFrame v last,hN,hNC.trans_le hc⟩

theorem read_call (n : ℕ) (tail out : Bits) (v : Local) : ∃ ticks last,
    Stacks.stackRun program ticks ⟨some (.read (.read .unary)),v,store (natBits n++tail) [] [] out⟩=
      some ⟨some (.step .countDone),last,store tail n.bits (natBits n).reverse out⟩ ∧
    Stacks.stackRunClock program ticks ⟨some (.read (.read .unary)),v,store (natBits n++tail) [] [] out⟩≤
      500*(1+(natBits n++tail).length+0)^2 := by
  let S := store (natBits n++tail) [] [] out
  have hsame : StackCall.frame readCode S (NatReadEmit.store (natBits n++tail) [] [] [] [] [])=S := by
    apply StackCall.frame_same _ _ _ readCode_injective
    intro k
    cases k <;> rfl
  have hfinal : StackCall.frame readCode S (NatReadEmit.store tail [] [] n.bits [] (natBits n).reverse)=
      store tail n.bits (natBits n).reverse out := by
    funext bank
    cases bank
    all_goals first
    | exact StackCall.frame_at readCode S _ readCode_injective NatReadEmit.Slot.reader
    | exact StackCall.frame_at readCode S _ readCode_injective NatReadEmit.Slot.markers
    | exact StackCall.frame_at readCode S _ readCode_injective NatReadEmit.Slot.payload
    | exact StackCall.frame_at readCode S _ readCode_injective NatReadEmit.Slot.value
    | exact StackCall.frame_at readCode S _ readCode_injective NatReadEmit.Slot.temporary
    | exact StackCall.frame_at readCode S _ readCode_injective NatReadEmit.Slot.output
    | (rw [WordValidator.frame_outside readCode S _ _ (by intro k; cases k <;> simp [readCode])]; rfl)
  obtain ⟨ticks,hr,hc⟩ := NatReadEmit.complete n tail [] (getRead v)
  obtain ⟨hN,hNC⟩ := StackCall.execution readCode Label.read (.step .countDone) getRead putRead
    (StackCall.frame readCode S)
    (fun data k => StackCall.frame_at _ _ data readCode_injective k)
    (fun data k bits => StackCall.frame_update _ _ data readCode_injective k bits)
    (fun _ _ => rfl) (fun _ _ _ => rfl) NatReadEmit.program program (fun _ => rfl) v ticks _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,getRead,putRead,hsame,hfinal,List.append_nil] at hN hNC
  exact ⟨ticks,putRead v ((true,CheckedNat.lastField n.bits none),none),hN,hNC.trans_le hc⟩

theorem drain_call (bank : DrainBank) (ret : Phase) (S : Slot → Bits) (v : Local) :
    Stacks.stackRun program ((S (drainKey bank)).length+1) ⟨some (.drain bank ret 0),v,S⟩=
      some ⟨some (.step ret),putIO v none,Function.update S (drainKey bank) []⟩ ∧
    Stacks.stackRunClock program ((S (drainKey bank)).length+1) ⟨some (.drain bank ret 0),v,S⟩=
      (S (drainKey bank)).length^2+3*(S (drainKey bank)).length+3 := by
  have hinj : Function.Injective (drainCode bank) := fun _ _ _ => Subsingleton.elim _ _
  have hsame : StackCall.frame (drainCode bank) S (Normalization.singleStack (S (drainKey bank)))=S := by
    apply StackCall.frame_same _ _ _ hinj
    intro k
    rfl
  have hfinal : StackCall.frame (drainCode bank) S (Normalization.singleStack [])=Function.update S (drainKey bank) [] := by
    have h :=
        StackCall.frame_update (drainCode bank) S
        (Normalization.singleStack (S (drainKey bank))) hinj 0 []
    simpa only [Normalization.singleStack_update,hsame] using! h
  have hr := Normalization.drain_run (S (drainKey bank)) (getIO v)
  obtain ⟨hN,hNC⟩ := StackCall.execution (drainCode bank) (Label.drain bank ret) (.step ret) getIO putIO
    (StackCall.frame (drainCode bank) S)
    (fun data k => StackCall.frame_at _ _ data hinj k)
    (fun data k bits => StackCall.frame_update _ _ data hinj k bits)
    (fun _ _ => rfl) (fun _ _ _ => rfl) Normalization.drainProgram program (fun _ => rfl) v ((S (drainKey bank)).length+1) _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,getIO,putIO,hsame,hfinal] at hN hNC
  exact ⟨hN,hNC.trans (Normalization.drain_clock (S (drainKey bank)) (getIO v))⟩

theorem phase_step (phase : Phase) (S : Slot → Bits) (v : Local) :
    Stacks.stackRun program 1 ⟨some (.step phase),v,S⟩=some (TM2.stepAux (phaseProgram phase) v S) := rfl

theorem goto_phase (phase : Phase) (after : Label) (hcode : phaseProgram phase=.goto (fun _ => after)) (S : Slot → Bits) (v : Local) :
    Stacks.stackRun program 1 ⟨some (.step phase),v,S⟩=some ⟨some after,v,S⟩ ∧
    Stacks.stackRunClock program 1 ⟨some (.step phase),v,S⟩=1 := by
  constructor
  · rw [phase_step,hcode]
    rfl
  · simp [Stacks.stackRunClock,program,hcode,Stacks.stackClock]

theorem count_branch (flag : Bool) (S : Slot → Bits) (v : Local) (hv : (getCounter v).1=flag) :
    Stacks.stackRun program 1 ⟨some (.step .decide),v,S⟩=
      some ⟨some (if flag then .frame (.read .literalReady (.read .unary)) else .drain .count .clearHeader 0),v,S⟩ ∧
    Stacks.stackRunClock program 1 ⟨some (.step .decide),v,S⟩=1 := by
  cases flag <;> constructor <;> simp
      [phase_step,phaseProgram,TM2.stepAux,hv,Stacks.stackRunClock,program,Stacks.stackClock]

theorem clear (reader count discard out : Bits) (v : Local) : ∃ ticks last,
    Stacks.stackRun program ticks ⟨some (.drain .count .clearHeader 0),v,store reader count discard out⟩=
      some ⟨none,last,store reader [] [] out⟩ ∧
    Stacks.stackRunClock program ticks ⟨some (.drain .count .clearHeader 0),v,store reader count discard out⟩≤
      30*(1+count.length+discard.length)^2 := by
  obtain ⟨hC,hCC⟩ := drain_call .count .clearHeader (store reader count discard out) v
  change Stacks.stackRun program (count.length+1) ⟨some (.drain .count .clearHeader 0),v,store reader count discard out⟩=
    some ⟨some (.step .clearHeader),putIO v none,Function.update (store reader count discard out) .count []⟩ at hC
  change _=count.length^2+3*count.length+3 at hCC
  rw [store_update_count] at hC
  obtain ⟨hG,hGC⟩ :=
      goto_phase .clearHeader (.drain .discard .done 0) rfl (store reader [] discard out)
      (putIO v none)
  obtain ⟨hD,hDC⟩ := drain_call .discard .done (store reader [] discard out) (putIO v none)
  change Stacks.stackRun program (discard.length+1) ⟨some (.drain .discard .done 0),putIO v none,store reader [] discard out⟩=
    some ⟨some (.step .done),putIO (putIO v none) none,Function.update (store reader [] discard out) .discard []⟩ at hD
  change _=discard.length^2+3*discard.length+3 at hDC
  rw [store_update_discard] at hD
  have hH : Stacks.stackRun program 1 ⟨some (.step .done),putIO (putIO v none) none,store reader [] [] out⟩=
    some ⟨none,putIO (putIO v none) none,store reader [] [] out⟩ := rfl
  have hHC :
      Stacks.stackRunClock program 1 ⟨some (.step .done),putIO (putIO v none) none,store reader [] [] out⟩=1 := rfl
  have eC : Stacks.Execution program _ _ _ := ⟨count.length+1,hC,hCC.le⟩
  have eG : Stacks.Execution program _ _ 1 := ⟨1,hG,hGC.le⟩
  have eD : Stacks.Execution program _ _ _ := ⟨discard.length+1,hD,hDC.le⟩
  have eH : Stacks.Execution program _ _ 1 := ⟨1,hH,hHC.le⟩
  obtain ⟨ticks,hr,hc⟩ := ((eC.trans eG).trans eD).trans eH
  exact ⟨ticks,_,hr,hc.trans (by nlinarith only [Nat.zero_le count.length,Nat.zero_le (count.length^2),Nat.zero_le discard.length,Nat.zero_le (discard.length^2),Nat.zero_le (count.length*discard.length)])⟩

def size (reader count discard out : Bits) := 1+reader.length+count.length+discard.length+out.length

theorem loop (values : List Bits) (tail count discard out : Bits) (v : Local) (hcount : binaryValue count=values.length) : ∃ ticks last,
    Stacks.stackRun program ticks ⟨some (.counter .borrow),v,store (TableGet.stream values++tail) count discard out⟩=
      some ⟨none,last,store tail [] [] ((TableGet.stream values).reverse++out)⟩ ∧
    Stacks.stackRunClock program ticks ⟨some (.counter .borrow),v,store (TableGet.stream values++tail) count discard out⟩≤
      50000*(1+(TableGet.stream values).length)*(size (TableGet.stream values++tail) count discard out)^2 := by
  induction values generalizing count out v with
  | nil =>
    obtain ⟨hC,hCC⟩ := counter_zero count tail discard out v hcount
    obtain ⟨hB,hBC⟩ :=
        count_branch false (store tail (List.replicate count.length true) discard out)
        (putCounter v (false,none)) rfl
    obtain ⟨cleanTicks,last,hD,hDC⟩ :=
        clear tail (List.replicate count.length true) discard out (putCounter v (false,none))
    have eC : Stacks.Execution program _ _ _ := ⟨2*count.length+2,hC,hCC⟩
    have eB : Stacks.Execution program _ _ 1 := ⟨1,hB,hBC.le⟩
    have eD : Stacks.Execution program _ _ _ := ⟨cleanTicks,hD,hDC⟩
    obtain ⟨ticks,hr,hc⟩ := (eC.trans eB).trans eD
    refine ⟨ticks,last,?_,?_⟩
    · simpa only [TableGet.stream,List.flatMap_nil,List.nil_append,List.reverse_nil] using hr
    · simp only [List.length_replicate] at hc
      let B := size tail count discard out
      have hB : 1≤B^2 := Nat.one_le_pow 2 _ (by dsimp [B,size]; omega)
      have h1 := Nat.pow_le_pow_left (show 1+count.length≤B by dsimp [B,size]; omega) 2
      have h2 :=
          Nat.pow_le_pow_left (show 1+count.length+discard.length≤B by dsimp [B,size]; omega) 2
      have hh : 10*(1+count.length)^2+1+30*(1+count.length+discard.length)^2≤50000*B^2 := by
        nlinarith only [hB,h1,h2]
      simpa only [TableGet.stream,List.flatMap_nil,List.nil_append,List.length_nil,Nat.add_zero,Nat.mul_one] using hc.trans hh
  | cons bits values ih =>
    let rest := TableGet.stream values++tail
    let reader := framed bits++rest
    obtain ⟨counterTicks,next,hlen,hvalue,hC,hCC⟩ :=
        counter_positive count reader discard out v
        (by simp only [List.length_cons] at hcount; omega)
    have hn : binaryValue next=values.length := by simp only [List.length_cons] at hcount; omega
    obtain ⟨hB,hBC⟩ :=
        count_branch true (store reader next discard out) (putCounter v (true,none)) rfl
    obtain ⟨frameTicks,v1,hF,hFC⟩ :=
        frame_call bits rest next discard out (putCounter v (true,none))
    obtain ⟨restTicks,last,hI,hIC⟩ := ih next ((framed bits).reverse++out) v1 hn
    have eC : Stacks.Execution program _ _ _ := ⟨counterTicks,hC,hCC⟩
    have eB : Stacks.Execution program _ _ 1 := ⟨1,hB,hBC.le⟩
    have eF : Stacks.Execution program _ _ _ := ⟨frameTicks,hF,hFC⟩
    have eI : Stacks.Execution program _ _ _ := ⟨restTicks,hI,hIC⟩
    obtain ⟨ticks,hr,hc⟩ := ((eC.trans eB).trans eF).trans eI
    have heq : reader=TableGet.stream (bits::values)++tail := by
      simp only [reader,rest,TableGet.stream,List.flatMap_cons,List.append_assoc]
    have hout : (TableGet.stream values).reverse++((framed bits).reverse++out)=(TableGet.stream (bits::values)).reverse++out := by
      simp only [TableGet.stream,List.flatMap_cons,List.reverse_append,List.append_assoc]
    refine ⟨ticks,last,?_,?_⟩
    · simpa only [heq,hout] using hr
    · let B := size reader count discard out
      have hB : 1≤B^2 := Nat.one_le_pow 2 _ (by dsimp [B,size]; omega)
      have hcounter := Nat.pow_le_pow_left (show 1+count.length≤B by dsimp [B,size]; omega) 2
      have hframe :=
          Nat.pow_le_pow_left
          (show 1+(framed bits++rest).length+out.length≤B by dsimp [B,size,reader]; omega) 2
      have hrest : size (TableGet.stream values++tail) next discard ((framed bits).reverse++out)=B := by
        dsimp [B,size,reader,rest]
        simp only [List.length_append,List.length_reverse,hlen]
        omega
      have hframeLen := TableGet.framed_length_ge bits
      have hh : 10*(1+count.length)^2+1+20000*(1+(framed bits).length)*(1+(framed bits++rest).length+out.length)^2+
          50000*(1+(TableGet.stream values).length)*(size (TableGet.stream values++tail) next discard ((framed bits).reverse++out))^2≤
          50000*(1+(TableGet.stream (bits::values)).length)*B^2 := by
        rw [hrest]
        simp only [TableGet.stream,List.flatMap_cons,List.length_append]
        have hm := Nat.mul_le_mul_left (20000*(1+(framed bits).length)) hframe
        simp only [List.length_append] at hm
        nlinarith only [hB,hcounter,hm,hframeLen,Nat.mul_le_mul_right (B^2) hframeLen]
      simpa only [B,heq] using hc.trans hh

theorem complete (values : List Bits) (tail out : Bits) (v : Local) : ∃ ticks last,
    Stacks.stackRun program ticks ⟨some (.read (.read .unary)),v,store (natBits values.length++TableGet.stream values++tail) [] [] out⟩=
      some ⟨none,last,store tail [] [] ((TableGet.stream values).reverse++out)⟩ ∧
    Stacks.stackRunClock program ticks ⟨some (.read (.read .unary)),v,store (natBits values.length++TableGet.stream values++tail) [] [] out⟩≤
      300000*(1+(natBits values.length++TableGet.stream values++tail).length+out.length)^3 := by
  let rest := TableGet.stream values++tail
  obtain ⟨readTicks,v1,hR,hRC⟩ := read_call values.length rest out v
  let D := (natBits values.length).reverse
  obtain ⟨hG,hGC⟩ :=
      goto_phase .countDone (.counter .borrow) rfl (store rest values.length.bits D out) v1
  obtain ⟨loopTicks,last,hL,hLC⟩ :=
      loop values tail values.length.bits D out v1 (binaryValue_bits _)
  have eR : Stacks.Execution program _ _ _ := ⟨readTicks,hR,hRC⟩
  have eG : Stacks.Execution program _ _ 1 := ⟨1,hG,hGC.le⟩
  have eL : Stacks.Execution program _ _ _ := ⟨loopTicks,hL,hLC⟩
  obtain ⟨ticks,hr,hc⟩ := (eR.trans eG).trans eL
  refine ⟨ticks,last,?_,?_⟩
  · simpa only [rest,List.append_assoc] using hr
  · let B := 1+(natBits values.length++rest).length+out.length
    have hB : 1≤B := by dsimp [B]; omega
    have h13 : 1≤B^3 := Nat.one_le_pow 3 _ hB
    have h23 : B^2≤B^3 := Nat.pow_le_pow_right hB (by decide)
    have hS : size (TableGet.stream values++tail) values.length.bits D out≤2*B := by
      dsimp [size,D,B,rest]
      simp only [List.length_reverse,List.length_append,natBits_length]
      omega
    have hS2 := Nat.pow_le_pow_left hS 2
    have hstream : 1+(TableGet.stream values).length≤B := by
      dsimp [B,rest]; simp only [List.length_append]; omega
    have hloop := Nat.mul_le_mul hstream hS2
    have hh : 500*(1+(natBits values.length++rest).length+0)^2+1+
        50000*(1+(TableGet.stream values).length)*(size (TableGet.stream values++tail) values.length.bits D out)^2≤300000*B^3 := by
      have hread :=
          Nat.pow_le_pow_left
          (show 1+(natBits values.length++rest).length+0≤B by dsimp [B]; omega) 2
      have hbase : 500*(1+(natBits values.length++rest).length+0)^2≤500*B^2 :=
          Nat.mul_le_mul_left _ hread
      change 500*(1+(natBits values.length++rest).length+0)^2+1+50000*(1+(TableGet.stream values).length)*(size (TableGet.stream values++tail) values.length.bits D out)^2≤300000*B^3
      nlinarith only [h13,h23,hloop,hbase]
    simpa only [rest,List.append_assoc] using hc.trans hh

end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.TableCopy
namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.FrameCopy
open Turing Qatlib.Concepts.BitWordCompiler.CanonicalCodec
inductive Slot where | source | restore | copy | count | temporary | markers | header | output deriving DecidableEq,Fintype
inductive Label where
  | copy (toOutput : Bool) (l : NatEmit.Label)
  | length (l : LengthCounter.Label)
  | header (l : NatEmit.Label)
  | drain (markers : Bool) (l : Fin 1)
  | transfer (l : Fin 1)
  | done
  deriving DecidableEq,Fintype
instance : Inhabited Label := ⟨.copy false .emit⟩
def copyCode (toOutput : Bool) : Fin 3 →
    Slot | 0 => .source | 1 => .restore | _ => if toOutput then .output else .copy
def lengthCode : Fin 4 → Slot | 0 => .count | 1 => .temporary | 2 => .markers | _ => .copy
def headerCode : Fin 3 → Slot | 0 => .count | 1 => .temporary | _ => .header
def drainCode (markers : Bool) (_ : Fin 1) : Slot := if markers then .markers else .count
def transferCode : Fin 2 → Slot | 0 => .header | _ => .output

def program : Label → TM2.Stmt (fun _ : Slot => Bool) Label Symbol
  | .copy toOutput l => StackCall.stmt (copyCode toOutput) (Label.copy toOutput)
      (if toOutput then .transfer 0 else .length .count) id (fun _ s => s) (NatEmit.program l)
  | .length l => StackCall.stmt lengthCode Label.length (.header .count) id (fun _ s => s) (LengthCounter.program l)
  | .header l => StackCall.stmt headerCode Label.header (.drain false 0) id (fun _ s => s) (NatEmit.program l)
  | .drain markers l => StackCall.stmt (drainCode markers) (Label.drain markers)
      (if markers then .copy true .emit else .drain true 0) id (fun _ s => s) (Normalization.drainProgram l)
  | .transfer l => StackCall.stmt transferCode Label.transfer .done id (fun _ s => s) (Stacks.transferProgram l)
  | .done => .halt

def store (source copy count markers header out : Bits) : Slot → Bits
  | .source => source | .copy => copy | .count => count | .markers => markers | .header => header | .output => out | _ => []

theorem copyCode_injective (toOutput : Bool) : Function.Injective (copyCode toOutput) := by
  intro a b h; cases toOutput <;> fin_cases a <;> fin_cases b <;> simp [copyCode] at h ⊢

theorem lengthCode_injective : Function.Injective lengthCode := by
    intro a b h; fin_cases a <;> fin_cases b <;> simp [lengthCode] at h ⊢

theorem headerCode_injective : Function.Injective headerCode := by
    intro a b h; fin_cases a <;> fin_cases b <;> simp [headerCode] at h ⊢

theorem transferCode_injective : Function.Injective transferCode := by
    intro a b h; fin_cases a <;> fin_cases b <;> simp [transferCode] at h ⊢

theorem copy_call (toOutput : Bool) (bits count markers header out : Bits) (v : Symbol) : Stacks.stackRun program (2*bits.length+3) ⟨some (.copy toOutput .emit),v,store bits.reverse [] count markers header out⟩=
      some ⟨some (if toOutput then .transfer 0 else .length .count),none,store bits.reverse (if toOutput then [] else bits) count markers header (if toOutput then bits++out else out)⟩ ∧
    Stacks.stackRunClock program (2*bits.length+3) ⟨some (.copy toOutput .emit),v,store bits.reverse [] count markers header out⟩=bits.length*(5*bits.length+2*(if toOutput then out.length else 0)+12)+7 := by
  let S := store bits.reverse [] count markers header out
  have hinj := copyCode_injective toOutput
  have hsame : StackCall.frame (copyCode toOutput) S (Parsing.triple bits.reverse [] (if toOutput then out else []))=S := by
    apply StackCall.frame_same _ _ _ hinj
    intro k
    cases toOutput <;> fin_cases k <;> rfl
  have hfinal : StackCall.frame (copyCode toOutput) S (Parsing.triple bits.reverse [] (bits++(if toOutput then out else [])))=store bits.reverse (if toOutput then [] else bits) count markers header (if toOutput then bits++out else out) := by
    cases toOutput with
    | false =>
      change StackCall.frame (copyCode false) S
          (Parsing.triple bits.reverse [] (bits++[]))=store bits.reverse bits count markers header out
      rw [List.append_nil]
      funext bank
      cases bank
      all_goals first
      | exact StackCall.frame_at (copyCode false) S _ hinj 0
      | exact StackCall.frame_at (copyCode false) S _ hinj 1
      | exact StackCall.frame_at (copyCode false) S _ hinj 2
      | (rw [WordValidator.frame_outside (copyCode false) S _ _ (by intro k; fin_cases k <;> simp [copyCode])]; rfl)
    | true =>
      funext bank
      cases bank
      all_goals first
      | exact StackCall.frame_at (copyCode true) S _ hinj 0
      | exact StackCall.frame_at (copyCode true) S _ hinj 1
      | exact StackCall.frame_at (copyCode true) S _ hinj 2
      | (rw [WordValidator.frame_outside (copyCode true) S _ _ (by intro k; fin_cases k <;> simp [copyCode])]; rfl)
  obtain ⟨hr,hc⟩ := NatEmit.copy_complete bits.reverse (if toOutput then out else []) v
  simp only [List.length_reverse,List.reverse_reverse] at hr hc
  have hout : (if toOutput then out else []).length=(if toOutput then out.length else 0) := by
    cases toOutput <;> rfl
  rw [hout] at hc
  obtain ⟨hN,hNC⟩ := StackCall.execution (copyCode toOutput) (Label.copy toOutput) (if toOutput then .transfer 0 else .length .count) id (fun _ t => t)
    (StackCall.frame (copyCode toOutput) S)
    (fun data k => StackCall.frame_at _ _ data hinj k)
    (fun data k bits => StackCall.frame_update _ _ data hinj k bits)
    (fun _ _ => rfl) (fun _ _ _ => rfl) NatEmit.program program (fun _ => rfl) v (2*bits.length+3) _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,hsame,hfinal] at hN hNC
  exact ⟨hN,hNC.trans hc⟩

theorem length_call (bits source header out : Bits) (v : Symbol) : ∃ ticks,
    Stacks.stackRun program ticks ⟨some (.length .count),v,store source bits [] [] header out⟩=
      some ⟨some (.header .count),none,store source [] bits.length.bits (List.replicate bits.length true) header out⟩ ∧
    Stacks.stackRunClock program ticks ⟨some (.length .count),v,store source bits [] [] header out⟩≤100*(bits.length+1)*(1+2*bits.length)^2 := by
  let S := store source bits [] [] header out
  have hinj := lengthCode_injective
  have hsame : StackCall.frame (lengthCode) S (Preparation.quad [] [] [] bits)=S := by
    apply StackCall.frame_same _ _ _ hinj
    intro k
    fin_cases k <;> rfl
  have hfinal : StackCall.frame (lengthCode) S (Preparation.quad bits.length.bits [] (List.replicate bits.length true) [])=store source [] bits.length.bits (List.replicate bits.length true) header out := by
    funext bank
    all_goals cases bank
    all_goals first
    | exact StackCall.frame_at (lengthCode) S _ hinj 0
    | exact StackCall.frame_at (lengthCode) S _ hinj 1
    | exact StackCall.frame_at (lengthCode) S _ hinj 2
    | exact StackCall.frame_at (lengthCode) S _ hinj 3
    | (rw [WordValidator.frame_outside (lengthCode) S _ _ (by intro k; fin_cases k <;> simp [lengthCode])]; rfl)
  obtain ⟨ticks,hr,hc⟩ := LengthCounter.complete 0 bits [] v
  simp only [Nat.zero_add,List.append_nil,Nat.zero_bits] at hr hc
  obtain ⟨hN,hNC⟩ := StackCall.execution (lengthCode) Label.length (.header .count) id (fun _ t => t)
    (StackCall.frame (lengthCode) S)
    (fun data k => StackCall.frame_at _ _ data hinj k)
    (fun data k bits => StackCall.frame_update _ _ data hinj k bits)
    (fun _ _ => rfl) (fun _ _ _ => rfl) LengthCounter.program program (fun _ => rfl) v ticks _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,hsame,hfinal] at hN hNC
  refine ⟨ticks,hN,hNC.trans_le hc⟩

theorem header_call (n : ℕ) (source markers out : Bits) (v : Symbol) : Stacks.stackRun program (4*n.bits.length+5) ⟨some (.header .count),v,store source [] n.bits markers [] out⟩=
      some ⟨some (.drain false 0),none,store source [] n.bits markers (natBits n).reverse out⟩ ∧
    Stacks.stackRunClock program (4*n.bits.length+5) ⟨some (.header .count),v,store source [] n.bits markers [] out⟩=n.bits.length*(12*n.bits.length+28)+16 := by
  let S := store source [] n.bits markers [] out
  have hinj := headerCode_injective
  have hsame : StackCall.frame (headerCode) S (Parsing.triple n.bits [] [])=S := by
    apply StackCall.frame_same _ _ _ hinj
    intro k
    fin_cases k <;> rfl
  have hfinal : StackCall.frame (headerCode) S (Parsing.triple n.bits [] (natBits n).reverse)=store source [] n.bits markers (natBits n).reverse out := by
    funext bank
    all_goals cases bank
    all_goals first
    | exact StackCall.frame_at (headerCode) S _ hinj 0
    | exact StackCall.frame_at (headerCode) S _ hinj 1
    | exact StackCall.frame_at (headerCode) S _ hinj 2
    | (rw [WordValidator.frame_outside (headerCode) S _ _ (by intro k; fin_cases k <;> simp [headerCode])]; rfl)
  obtain ⟨hr,hc⟩ := NatEmit.complete n [] v
  simp only [List.append_nil,List.length_nil,Nat.mul_zero,Nat.add_zero] at hr hc
  obtain ⟨hN,hNC⟩ := StackCall.execution (headerCode) Label.header (.drain false 0) id (fun _ t => t)
    (StackCall.frame (headerCode) S)
    (fun data k => StackCall.frame_at _ _ data hinj k)
    (fun data k bits => StackCall.frame_update _ _ data hinj k bits)
    (fun _ _ => rfl) (fun _ _ _ => rfl) NatEmit.program program (fun _ => rfl) v (4*n.bits.length+5) _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,hsame,hfinal] at hN hNC
  exact ⟨hN,hNC.trans hc⟩

theorem transfer_call (header source out : Bits) (v : Symbol) : Stacks.stackRun program (header.length+1) ⟨some (.transfer 0),v,store source [] [] [] header.reverse out⟩=
      some ⟨some (.done),none,store source [] [] [] [] (header++out)⟩ ∧
    Stacks.stackRunClock program (header.length+1) ⟨some (.transfer 0),v,store source [] [] [] header.reverse out⟩=header.length*(2*(header.length+out.length)+5)+3 := by
  let S := store source [] [] [] header.reverse out
  have hinj := transferCode_injective
  have hsame : StackCall.frame (transferCode) S (Stacks.stackPair header.reverse out)=S := by
    apply StackCall.frame_same _ _ _ hinj
    intro k
    fin_cases k <;> rfl
  have hfinal : StackCall.frame (transferCode) S (Stacks.stackPair [] (header++out))=store source [] [] [] [] (header++out) := by
    funext bank
    all_goals cases bank
    all_goals first
    | exact StackCall.frame_at (transferCode) S _ hinj 0
    | exact StackCall.frame_at (transferCode) S _ hinj 1
    | (rw [WordValidator.frame_outside (transferCode) S _ _ (by intro k; fin_cases k <;> simp [transferCode])]; rfl)
  have hr := Stacks.transfer_run header.reverse out v
  simp only [List.length_reverse,List.reverse_reverse] at hr
  obtain ⟨hN,hNC⟩ := StackCall.execution (transferCode) Label.transfer (.done) id (fun _ t => t)
    (StackCall.frame (transferCode) S)
    (fun data k => StackCall.frame_at _ _ data hinj k)
    (fun data k bits => StackCall.frame_update _ _ data hinj k bits)
    (fun _ _ => rfl) (fun _ _ _ => rfl) Stacks.transferProgram program (fun _ => rfl) v (header.length+1) _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,hsame,hfinal] at hN hNC
  have hc := Stacks.transfer_clock header.reverse out v
  simp only [List.length_reverse] at hc
  exact ⟨hN,hNC.trans hc⟩

def drainKey (markers : Bool) : Slot := if markers then .markers else .count

theorem drain_call (markers : Bool) (S : Slot → Bits) (v : Symbol) :
    Stacks.stackRun program ((S (drainKey markers)).length+1) ⟨some (.drain markers 0),v,S⟩=
      some ⟨some (if markers then .copy true .emit else .drain true 0),none,Function.update S (drainKey markers) []⟩ ∧
    Stacks.stackRunClock program ((S (drainKey markers)).length+1) ⟨some (.drain markers 0),v,S⟩=
      (S (drainKey markers)).length^2+3*(S (drainKey markers)).length+3 := by
  have hinj : Function.Injective (drainCode markers) := fun _ _ _ => Subsingleton.elim _ _
  have hsame : StackCall.frame (drainCode markers) S (Normalization.singleStack (S (drainKey markers)))=S := by
    apply StackCall.frame_same _ _ _ hinj
    intro k
    rfl
  have hfinal : StackCall.frame (drainCode markers) S (Normalization.singleStack [])=Function.update S (drainKey markers) [] := by
    have h :=
        StackCall.frame_update (drainCode markers) S
        (Normalization.singleStack (S (drainKey markers))) hinj 0 []
    simpa only [Normalization.singleStack_update,hsame] using! h
  have hr := Normalization.drain_run (S (drainKey markers)) v
  obtain ⟨hN,hNC⟩ := StackCall.execution (drainCode markers) (Label.drain markers) (if markers then .copy true .emit else .drain true 0) id (fun _ s => s)
    (StackCall.frame (drainCode markers) S)
    (fun data k => StackCall.frame_at _ _ data hinj k)
    (fun data k bits => StackCall.frame_update _ _ data hinj k bits)
    (fun _ _ => rfl) (fun _ _ _ => rfl) Normalization.drainProgram program (fun _ => rfl) v ((S (drainKey markers)).length+1) _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,hsame,hfinal] at hN hNC
  exact ⟨hN,hNC.trans (Normalization.drain_clock (S (drainKey markers)) v)⟩

@[simp] theorem store_update_count (source copy count markers header out next : Bits) :
    Function.update (store source copy count markers header out) .count next=store source copy next markers header out := by funext k; cases k <;> rfl

@[simp] theorem store_update_markers (source copy count markers header out next : Bits) :
    Function.update (store source copy count markers header out) .markers next=store source copy count next header out := by funext k; cases k <;> rfl

theorem drains (source count markers header out : Bits) (v : Symbol) : ∃ ticks,
    Stacks.stackRun program ticks ⟨some (.drain false 0),v,store source [] count markers header out⟩=
      some ⟨some (.copy true .emit),none,store source [] [] [] header out⟩ ∧
    Stacks.stackRunClock program ticks ⟨some (.drain false 0),v,store source [] count markers header out⟩≤
      20*(1+count.length+markers.length)^2 := by
  obtain ⟨hC,hCC⟩ := drain_call false (store source [] count markers header out) v
  change Stacks.stackRun program (count.length+1) ⟨some (.drain false 0),v,store source [] count markers header out⟩=
    some ⟨some (.drain true 0),none,Function.update (store source [] count markers header out) .count []⟩ at hC
  change _=count.length^2+3*count.length+3 at hCC
  rw [store_update_count] at hC
  obtain ⟨hM,hMC⟩ := drain_call true (store source [] [] markers header out) none
  change Stacks.stackRun program (markers.length+1) ⟨some (.drain true 0),none,store source [] [] markers header out⟩=
    some ⟨some (.copy true .emit),none,Function.update (store source [] [] markers header out) .markers []⟩ at hM
  change _=markers.length^2+3*markers.length+3 at hMC
  rw [store_update_markers] at hM
  have eC : Stacks.Execution program _ _ _ := ⟨count.length+1,hC,hCC.le⟩
  have eM : Stacks.Execution program _ _ _ := ⟨markers.length+1,hM,hMC.le⟩
  obtain ⟨ticks,hr,hc⟩ := eC.trans eM
  exact ⟨ticks,hr,hc.trans (by nlinarith only [Nat.zero_le count.length,Nat.zero_le (count.length^2),Nat.zero_le markers.length,Nat.zero_le (markers.length^2),Nat.zero_le (count.length*markers.length)])⟩

theorem complete (bits out : Bits) (v : Symbol) : ∃ ticks,
    Stacks.stackRun program ticks ⟨some (.copy false .emit),v,store bits.reverse [] [] [] [] out⟩=
      some ⟨none,none,store bits.reverse [] [] [] [] (framed bits++out)⟩ ∧
    Stacks.stackRunClock program ticks ⟨some (.copy false .emit),v,store bits.reverse [] [] [] [] out⟩≤
      10000*(1+bits.length+out.length)^3 := by
  obtain ⟨hC,hCC⟩ := copy_call false bits [] [] [] out v
  obtain ⟨lengthTicks,hL,hLC⟩ := length_call bits bits.reverse [] out none
  obtain ⟨hH,hHC⟩ := header_call bits.length bits.reverse (List.replicate bits.length true) out none
  obtain ⟨drainTicks,hD,hDC⟩ :=
      drains bits.reverse bits.length.bits (List.replicate bits.length true)
      (natBits bits.length).reverse out none
  obtain ⟨hO,hOC⟩ := copy_call true bits [] [] (natBits bits.length).reverse out none
  obtain ⟨hT,hTC⟩ := transfer_call (natBits bits.length) bits.reverse (bits++out) none
  have hS : Stacks.stackRun program 1 ⟨some .done,none,store bits.reverse [] [] [] [] (natBits bits.length++(bits++out))⟩=
    some ⟨none,none,store bits.reverse [] [] [] [] (natBits bits.length++(bits++out))⟩ := rfl
  have hSC :
      Stacks.stackRunClock program 1 ⟨some .done,none,store bits.reverse [] [] [] [] (natBits bits.length++(bits++out))⟩=1 := rfl
  have eC : Stacks.Execution program _ _ _ := ⟨2*bits.length+3,hC,hCC.le⟩
  have eL : Stacks.Execution program _ _ _ := ⟨lengthTicks,hL,hLC⟩
  have eH : Stacks.Execution program _ _ _ := ⟨4*bits.length.bits.length+5,hH,hHC.le⟩
  have eD : Stacks.Execution program _ _ _ := ⟨drainTicks,hD,hDC⟩
  have eO : Stacks.Execution program _ _ _ := ⟨2*bits.length+3,hO,hOC.le⟩
  have eT : Stacks.Execution program _ _ _ := ⟨(natBits bits.length).length+1,hT,hTC.le⟩
  have eS : Stacks.Execution program _ _ 1 := ⟨1,hS,hSC.le⟩
  obtain ⟨ticks,hr,hc⟩ := (((((eC.trans eL).trans eH).trans eD).trans eO).trans eT).trans eS
  refine ⟨ticks,?_,hc.trans ?_⟩
  · simpa only [framed,List.append_assoc] using hr
  · simp only [Bool.false_eq_true,ite_false,ite_true,List.length_replicate,List.length_append,natBits_length] at *
    let B := 1+bits.length+out.length
    have hB : 1≤B := by dsimp [B]; omega
    have hB2 : B≤B^2 := Nat.le_pow (by decide)
    have h23 : B^2≤B^3 := Nat.pow_le_pow_right hB (by decide)
    have h13 : 1≤B^3 := Nat.one_le_pow 3 _ hB
    have hb : bits.length≤B := by dsimp [B]; omega
    have ho : out.length≤B := by dsimp [B]; omega
    have hn : bits.length.bits.length≤B := (Counter.bits_length_le _).trans hb
    have hb2 := Nat.mul_le_mul hb hb
    have hn2 := Nat.mul_le_mul hn hn
    have hbo := Nat.mul_le_mul hb ho
    have hnb := Nat.mul_le_mul hn hb
    have hno := Nat.mul_le_mul hn ho
    have hlen : bits.length+1≤B := by dsimp [B]; omega
    have hgroup : 1+2*bits.length≤2*B := by dsimp [B]; omega
    have hlenCost := Nat.mul_le_mul hlen (Nat.pow_le_pow_left hgroup 2)
    have hclean : 1+bits.length.bits.length+bits.length≤2*B := by
      dsimp [B]; have := Counter.bits_length_le bits.length; omega
    have hclean2 := Nat.pow_le_pow_left hclean 2
    change _≤10000*B^3
    nlinarith only [hB,hB2,h23,h13,hb,ho,hn,hb2,hn2,hbo,hnb,hno,hlenCost,hclean2]

end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.FrameCopy

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.JobPush
open Turing Qatlib.Concepts.BitWordCompiler.CanonicalCodec
abbrev Slot := Fin 2 ⊕ FrameCopy.Slot
inductive Label where | plan (l : NatEmit.Label) | context (l : FrameCopy.Label) | done deriving DecidableEq,Fintype
instance : Inhabited Label := ⟨.plan .emit⟩
def planCode : Fin 3 → Slot | 0 => .inl 0 | 1 => .inl 1 | _ => .inr .output

def program : Label → TM2.Stmt (fun _ : Slot => Bool) Label Symbol
  | .plan l => StackCall.stmt planCode Label.plan (.context (.copy false .emit)) id (fun _ s => s) (NatEmit.program l)
  | .context l => StackCall.stmt Sum.inr Label.context .done id (fun _ s => s) (FrameCopy.program l)
  | .done => .halt

def store (plan context jobs : Bits) : Slot → Bits
  | .inl 0 => plan | .inl _ => [] | .inr k => FrameCopy.store context [] [] [] [] jobs k

theorem planCode_injective : Function.Injective planCode := by
    intro a b h; fin_cases a <;> fin_cases b <;> simp [planCode] at h ⊢

theorem plan_call (plan context jobs : Bits) (v : Symbol) :
    Stacks.stackRun program (2*plan.length+3) ⟨some (.plan .emit),v,store plan.reverse context.reverse jobs⟩=
      some ⟨some (.context (.copy false .emit)),none,store plan.reverse context.reverse (plan++jobs)⟩ ∧
    Stacks.stackRunClock program (2*plan.length+3) ⟨some (.plan .emit),v,store plan.reverse context.reverse jobs⟩=
      plan.length*(5*plan.length+2*jobs.length+12)+7 := by
  let S := store plan.reverse context.reverse jobs
  have hinj := planCode_injective
  have hsame : StackCall.frame planCode S (Parsing.triple plan.reverse [] jobs)=S := by
    apply StackCall.frame_same _ _ _ hinj
    intro k
    fin_cases k <;> rfl
  have hfinal : StackCall.frame planCode S (Parsing.triple plan.reverse [] (plan++jobs))=store plan.reverse context.reverse (plan++jobs) := by
    funext bank
    cases bank with
    | inl k =>
      fin_cases k
      · exact StackCall.frame_at planCode S _ hinj 0
      · exact StackCall.frame_at planCode S _ hinj 1
    | inr k =>
      cases k
      all_goals first
      | exact StackCall.frame_at planCode S _ hinj 2
      | (rw [WordValidator.frame_outside planCode S _ _ (by intro k; fin_cases k <;> simp [planCode])]; rfl)
  obtain ⟨hr,hc⟩ := NatEmit.copy_complete plan.reverse jobs v
  simp only [List.length_reverse,List.reverse_reverse] at hr hc
  obtain ⟨hN,hNC⟩ := StackCall.execution planCode Label.plan (.context (.copy false .emit)) id (fun _ s => s)
    (StackCall.frame planCode S)
    (fun data k => StackCall.frame_at _ _ data hinj k)
    (fun data k bits => StackCall.frame_update _ _ data hinj k bits)
    (fun _ _ => rfl) (fun _ _ _ => rfl) NatEmit.program program (fun _ => rfl) v (2*plan.length+3) _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,hsame,hfinal] at hN hNC
  exact ⟨hN,hNC.trans hc⟩

theorem context_call (plan context jobs : Bits) (v : Symbol) : ∃ ticks,
    Stacks.stackRun program ticks ⟨some (.context (.copy false .emit)),v,store plan context.reverse jobs⟩=
      some ⟨some .done,none,store plan context.reverse (framed context++jobs)⟩ ∧
    Stacks.stackRunClock program ticks ⟨some (.context (.copy false .emit)),v,store plan context.reverse jobs⟩≤
      10000*(1+context.length+jobs.length)^3 := by
  let S := store plan context.reverse jobs
  have hinj : Function.Injective (Sum.inr : FrameCopy.Slot → Slot) := Sum.inr_injective
  have hsame : StackCall.frame Sum.inr S (FrameCopy.store context.reverse [] [] [] [] jobs)=S := by
    apply StackCall.frame_same _ _ _ hinj
    intro k
    rfl
  have hfinal : StackCall.frame Sum.inr S (FrameCopy.store context.reverse [] [] [] [] (framed context++jobs))=store plan context.reverse (framed context++jobs) := by
    funext bank
    cases bank with
    | inl k => rw [WordValidator.frame_outside (Sum.inr : FrameCopy.Slot → Slot) S _ (.inl k) (by intro j; simp)]; fin_cases k <;> rfl
    | inr k => exact StackCall.frame_at Sum.inr S _ hinj k
  obtain ⟨ticks,hr,hc⟩ := FrameCopy.complete context jobs v
  obtain ⟨hN,hNC⟩ := StackCall.execution Sum.inr Label.context .done id (fun _ s => s)
    (StackCall.frame Sum.inr S)
    (fun data k => StackCall.frame_at _ _ data hinj k)
    (fun data k bits => StackCall.frame_update _ _ data hinj k bits)
    (fun _ _ => rfl) (fun _ _ _ => rfl) FrameCopy.program program (fun _ => rfl) v ticks _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,hsame,hfinal] at hN hNC
  exact ⟨ticks,hN,hNC.trans_le hc⟩

theorem complete (plan context jobs : Bits) (v : Symbol) : ∃ ticks,
    Stacks.stackRun program ticks ⟨some (.plan .emit),v,store plan.reverse context.reverse jobs⟩=
      some ⟨none,none,store plan.reverse context.reverse (framed context++plan++jobs)⟩ ∧
    Stacks.stackRunClock program ticks ⟨some (.plan .emit),v,store plan.reverse context.reverse jobs⟩≤
      100000*(1+plan.length+context.length+jobs.length)^3 := by
  obtain ⟨hP,hPC⟩ := plan_call plan context jobs v
  obtain ⟨contextTicks,hC,hCC⟩ := context_call plan.reverse context (plan++jobs) none
  have hH : Stacks.stackRun program 1 ⟨some .done,none,store plan.reverse context.reverse (framed context++(plan++jobs))⟩=
    some ⟨none,none,store plan.reverse context.reverse (framed context++(plan++jobs))⟩ := rfl
  have hHC :
      Stacks.stackRunClock program 1 ⟨some .done,none,store plan.reverse context.reverse (framed context++(plan++jobs))⟩=1 := rfl
  have eP : Stacks.Execution program _ _ _ := ⟨2*plan.length+3,hP,hPC.le⟩
  have eC : Stacks.Execution program _ _ _ := ⟨contextTicks,hC,hCC⟩
  have eH : Stacks.Execution program _ _ 1 := ⟨1,hH,hHC.le⟩
  obtain ⟨ticks,hr,hc⟩ := (eP.trans eC).trans eH
  refine ⟨ticks,?_,hc.trans ?_⟩
  · simpa only [List.append_assoc] using hr
  · let B := 1+plan.length+context.length+jobs.length
    have hB : 1≤B := by dsimp [B]; omega
    have hB2 : B≤B^2 := Nat.le_pow (by decide)
    have h13 : 1≤B^3 := Nat.one_le_pow 3 _ hB
    have h23 : B^2≤B^3 := Nat.pow_le_pow_right hB (by decide)
    have hp : plan.length≤B := by dsimp [B]; omega
    have hj : jobs.length≤B := by dsimp [B]; omega
    have hp2 := Nat.mul_le_mul hp hp
    have hpj := Nat.mul_le_mul hp hj
    have hgroup : 1+context.length+(plan++jobs).length=B := by
      dsimp [B]; simp only [List.length_append]; omega
    rw [hgroup]
    change _≤100000*B^3
    nlinarith only [hB,h13,h23,hp,hp2,hpj,hB2]
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.JobPush
namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.CounterContext
open Turing Qatlib.Concepts.BitWordCompiler.CanonicalCodec
abbrev Slot := Fin 5 ⊕ FrameCopy.Slot
inductive Label where
  | counter (l : NatEmit.Label)
  | normalize (l : Fin 1)
  | parent (l : NatEmit.Label)
  | frame (l : FrameCopy.Label)
  | transfer (l : Fin 1)
  | drain (l : Fin 1)
  | done
  deriving DecidableEq,Fintype
instance : Inhabited Label := ⟨.counter .emit⟩
def counterCode : Fin 3 → Slot | 0 => .inl 0 | 1 => .inl 3 | _ => .inr .source
def parentCode : Fin 3 → Slot | 0 => .inl 1 | 1 => .inl 4 | _ => .inr .output
def normCode (_ : Fin 1) : Slot := .inr .source
def transferCode : Fin 2 → Slot | 0 => .inr .output | _ => .inl 2

def program : Label → TM2.Stmt (fun _ : Slot => Bool) Label Symbol
  | .counter l => StackCall.stmt counterCode Label.counter (.normalize 0) id (fun _ s => s) (NatEmit.program l)
  | .normalize l => StackCall.stmt normCode Label.normalize (.parent .emit) id (fun _ s => s) (BinaryNormalize.program l)
  | .parent l => StackCall.stmt parentCode Label.parent (.frame (.copy false .emit)) id (fun _ s => s) (NatEmit.program l)
  | .frame l => StackCall.stmt Sum.inr Label.frame (.transfer 0) id (fun _ s => s) (FrameCopy.program l)
  | .transfer l => StackCall.stmt transferCode Label.transfer (.drain 0) id (fun _ s => s) (Stacks.transferProgram l)
  | .drain l => StackCall.stmt normCode Label.drain .done id (fun _ s => s) (Normalization.drainProgram l)
  | .done => .halt

def store (counter context normal work child : Bits) : Slot → Bits
  | .inl 0 => counter | .inl 1 => context | .inl 2 => child | .inl _ => []
  | .inr k => FrameCopy.store normal [] [] [] [] work k

theorem counterCode_injective : Function.Injective counterCode := by
    intro a b h; fin_cases a <;> fin_cases b <;> simp [counterCode] at h ⊢

theorem parentCode_injective : Function.Injective parentCode := by
    intro a b h; fin_cases a <;> fin_cases b <;> simp [parentCode] at h ⊢

theorem transferCode_injective : Function.Injective transferCode := by
    intro a b h; fin_cases a <;> fin_cases b <;> simp [transferCode] at h ⊢

theorem normCode_injective : Function.Injective normCode := fun _ _ _ => Subsingleton.elim _ _

theorem counter_call (counter context : Bits) (v : Symbol) : Stacks.stackRun program (2*counter.length+3) ⟨some (.counter .emit),v,store counter context [] [] []⟩=
      some ⟨some (.normalize 0),none,store counter context counter.reverse [] []⟩ ∧
    Stacks.stackRunClock program (2*counter.length+3) ⟨some (.counter .emit),v,store counter context [] [] []⟩=counter.length*(5*counter.length+12)+7 := by
  let S := store counter context [] [] []
  have hinj : Function.Injective (counterCode) := counterCode_injective
  have hsame : StackCall.frame (counterCode) S (Parsing.triple counter [] [])=S := by
    apply StackCall.frame_same _ _ _ hinj
    intro k
    fin_cases k <;> rfl
  have hfinal : StackCall.frame (counterCode) S (Parsing.triple counter [] counter.reverse)=store counter context counter.reverse [] [] := by
    funext bank
    cases bank with
    | inl k =>
      fin_cases k
      all_goals first
      | exact StackCall.frame_at (counterCode) S _ hinj 0
      | exact StackCall.frame_at (counterCode) S _ hinj 1
      | exact StackCall.frame_at (counterCode) S _ hinj 2
      | (rw [WordValidator.frame_outside (counterCode : Fin 3 → Slot) S _ _ (by intro j; fin_cases j <;> simp [counterCode])]; rfl)
    | inr k =>
      cases k
      all_goals first
      | exact StackCall.frame_at (counterCode) S _ hinj 0
      | exact StackCall.frame_at (counterCode) S _ hinj 1
      | exact StackCall.frame_at (counterCode) S _ hinj 2
      | (rw [WordValidator.frame_outside (counterCode) S _ _ (by intro j; fin_cases j <;> simp [counterCode])]; rfl)
  obtain ⟨hr,hc⟩ := NatEmit.copy_complete counter [] v
  simp only [List.append_nil,List.length_nil,Nat.mul_zero,Nat.add_zero] at hr hc
  obtain ⟨hN,hNC⟩ := StackCall.execution (counterCode) Label.counter (.normalize 0) id (fun _ t => t)
    (StackCall.frame (counterCode) S)
    (fun data k => StackCall.frame_at _ _ data hinj k)
    (fun data k bits => StackCall.frame_update _ _ data hinj k bits)
    (fun _ _ => rfl) (fun _ _ _ => rfl) NatEmit.program program (fun _ => rfl) v (2*counter.length+3) _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,hsame,hfinal] at hN hNC
  exact ⟨hN,hNC.trans hc⟩

theorem normalize_call (counter context : Bits) (v : Symbol) : ∃ ticks last,
    Stacks.stackRun program ticks ⟨some (.normalize 0),v,store counter context counter.reverse [] []⟩=
      some ⟨some (.parent .emit),last,store counter context (binaryValue counter).bits.reverse [] []⟩ ∧
    Stacks.stackRunClock program ticks ⟨some (.normalize 0),v,store counter context counter.reverse [] []⟩≤20*(1+counter.length)^2 := by
  let S := store counter context counter.reverse [] []
  have hinj : Function.Injective (normCode) := normCode_injective
  have hsame : StackCall.frame (normCode) S (Normalization.singleStack counter.reverse)=S := by
    apply StackCall.frame_same _ _ _ hinj
    intro k
    rfl
  have hfinal : StackCall.frame (normCode) S (Normalization.singleStack (binaryValue counter).bits.reverse)=store counter context (binaryValue counter).bits.reverse [] [] := by
    funext bank
    cases bank with
    | inl k =>
      fin_cases k
      all_goals first
      | exact StackCall.frame_at (normCode) S _ hinj 0
      | (rw [WordValidator.frame_outside (normCode : Fin 1 → Slot) S _ _ (by intro j; fin_cases j; simp [normCode])]; rfl)
    | inr k =>
      cases k
      all_goals first
      | exact StackCall.frame_at (normCode) S _ hinj 0
      | (rw [WordValidator.frame_outside (normCode) S _ _ (by intro j; fin_cases j; simp [normCode])]; rfl)
  obtain ⟨ticks,last,hr,hc⟩ := BinaryNormalize.complete counter.reverse v
  simp only [List.length_reverse,List.reverse_reverse] at hr hc
  obtain ⟨hN,hNC⟩ := StackCall.execution (normCode) Label.normalize (.parent .emit) id (fun _ t => t)
    (StackCall.frame (normCode) S)
    (fun data k => StackCall.frame_at _ _ data hinj k)
    (fun data k bits => StackCall.frame_update _ _ data hinj k bits)
    (fun _ _ => rfl) (fun _ _ _ => rfl) BinaryNormalize.program program (fun _ => rfl) v ticks _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,hsame,hfinal] at hN hNC
  exact ⟨ticks,last,hN,hNC.trans_le hc⟩

theorem parent_call (counter context normal : Bits) (v : Symbol) : Stacks.stackRun program (2*context.length+3) ⟨some (.parent .emit),v,store counter context.reverse normal [] []⟩=
      some ⟨some (.frame (.copy false .emit)),none,store counter context.reverse normal context []⟩ ∧
    Stacks.stackRunClock program (2*context.length+3) ⟨some (.parent .emit),v,store counter context.reverse normal [] []⟩=context.length*(5*context.length+12)+7 := by
  let S := store counter context.reverse normal [] []
  have hinj : Function.Injective (parentCode) := parentCode_injective
  have hsame : StackCall.frame (parentCode) S (Parsing.triple context.reverse [] [])=S := by
    apply StackCall.frame_same _ _ _ hinj
    intro k
    fin_cases k <;> rfl
  have hfinal : StackCall.frame (parentCode) S (Parsing.triple context.reverse [] context)=store counter context.reverse normal context [] := by
    funext bank
    cases bank with
    | inl k =>
      fin_cases k
      all_goals first
      | exact StackCall.frame_at (parentCode) S _ hinj 0
      | exact StackCall.frame_at (parentCode) S _ hinj 1
      | exact StackCall.frame_at (parentCode) S _ hinj 2
      | (rw [WordValidator.frame_outside (parentCode : Fin 3 → Slot) S _ _ (by intro j; fin_cases j <;> simp [parentCode])]; rfl)
    | inr k =>
      cases k
      all_goals first
      | exact StackCall.frame_at (parentCode) S _ hinj 0
      | exact StackCall.frame_at (parentCode) S _ hinj 1
      | exact StackCall.frame_at (parentCode) S _ hinj 2
      | (rw [WordValidator.frame_outside (parentCode) S _ _ (by intro j; fin_cases j <;> simp [parentCode])]; rfl)
  obtain ⟨hr,hc⟩ := NatEmit.copy_complete context.reverse [] v
  simp only [List.length_reverse,List.reverse_reverse,List.append_nil,List.length_nil,Nat.mul_zero,Nat.add_zero] at hr hc
  obtain ⟨hN,hNC⟩ := StackCall.execution (parentCode) Label.parent (.frame (.copy false .emit)) id (fun _ t => t)
    (StackCall.frame (parentCode) S)
    (fun data k => StackCall.frame_at _ _ data hinj k)
    (fun data k bits => StackCall.frame_update _ _ data hinj k bits)
    (fun _ _ => rfl) (fun _ _ _ => rfl) NatEmit.program program (fun _ => rfl) v (2*context.length+3) _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,hsame,hfinal] at hN hNC
  exact ⟨hN,hNC.trans hc⟩

theorem frame_call (n : ℕ) (counter context : Bits) (v : Symbol) : ∃ ticks,
    Stacks.stackRun program ticks ⟨some (.frame (.copy false .emit)),v,store counter context.reverse n.bits.reverse context []⟩=
      some ⟨some (.transfer 0),none,store counter context.reverse n.bits.reverse (framed n.bits++context) []⟩ ∧
    Stacks.stackRunClock program ticks ⟨some (.frame (.copy false .emit)),v,store counter context.reverse n.bits.reverse context []⟩≤10000*(1+n.bits.length+context.length)^3 := by
  let S := store counter context.reverse n.bits.reverse context []
  have hinj : Function.Injective (Sum.inr : FrameCopy.Slot → Slot) := Sum.inr_injective
  have hsame : StackCall.frame (Sum.inr) S (FrameCopy.store n.bits.reverse [] [] [] [] context)=S := by
    apply StackCall.frame_same _ _ _ hinj
    intro k
    rfl
  have hfinal : StackCall.frame (Sum.inr) S (FrameCopy.store n.bits.reverse [] [] [] [] (framed n.bits++context))=store counter context.reverse n.bits.reverse (framed n.bits++context) [] := by
    funext bank
    cases bank with
    | inl k =>
      fin_cases k
      all_goals first
      | (rw [WordValidator.frame_outside (Sum.inr : FrameCopy.Slot → Slot) S _ _ (by intro j; simp)]; rfl)
    | inr k =>
      exact StackCall.frame_at Sum.inr S _ hinj k
  obtain ⟨ticks,hr,hc⟩ := FrameCopy.complete n.bits context v
  obtain ⟨hN,hNC⟩ := StackCall.execution (Sum.inr) Label.frame (.transfer 0) id (fun _ t => t)
    (StackCall.frame (Sum.inr) S)
    (fun data k => StackCall.frame_at _ _ data hinj k)
    (fun data k bits => StackCall.frame_update _ _ data hinj k bits)
    (fun _ _ => rfl) (fun _ _ _ => rfl) FrameCopy.program program (fun _ => rfl) v ticks _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,hsame,hfinal] at hN hNC
  exact ⟨ticks,hN,hNC.trans_le hc⟩

theorem transfer_call (counter context normal work : Bits) (v : Symbol) : Stacks.stackRun program (work.length+1) ⟨some (.transfer 0),v,store counter context normal work []⟩=
      some ⟨some (.drain 0),none,store counter context normal [] work.reverse⟩ ∧
    Stacks.stackRunClock program (work.length+1) ⟨some (.transfer 0),v,store counter context normal work []⟩=work.length*(2*work.length+5)+3 := by
  let S := store counter context normal work []
  have hinj : Function.Injective (transferCode) := transferCode_injective
  have hsame : StackCall.frame (transferCode) S (Stacks.stackPair work [])=S := by
    apply StackCall.frame_same _ _ _ hinj
    intro k
    fin_cases k <;> rfl
  have hfinal : StackCall.frame (transferCode) S (Stacks.stackPair [] work.reverse)=store counter context normal [] work.reverse := by
    funext bank
    cases bank with
    | inl k =>
      fin_cases k
      all_goals first
      | exact StackCall.frame_at (transferCode) S _ hinj 0
      | exact StackCall.frame_at (transferCode) S _ hinj 1
      | (rw [WordValidator.frame_outside (transferCode : Fin 2 → Slot) S _ _ (by intro j; fin_cases j <;> simp [transferCode])]; rfl)
    | inr k =>
      cases k
      all_goals first
      | exact StackCall.frame_at (transferCode) S _ hinj 0
      | exact StackCall.frame_at (transferCode) S _ hinj 1
      | (rw [WordValidator.frame_outside (transferCode) S _ _ (by intro j; fin_cases j <;> simp [transferCode])]; rfl)
  have hr := Stacks.transfer_run work [] v
  simp only [List.append_nil] at hr
  have hc := Stacks.transfer_clock work [] v
  simp only [List.length_nil,Nat.add_zero] at hc
  obtain ⟨hN,hNC⟩ := StackCall.execution (transferCode) Label.transfer (.drain 0) id (fun _ t => t)
    (StackCall.frame (transferCode) S)
    (fun data k => StackCall.frame_at _ _ data hinj k)
    (fun data k bits => StackCall.frame_update _ _ data hinj k bits)
    (fun _ _ => rfl) (fun _ _ _ => rfl) Stacks.transferProgram program (fun _ => rfl) v (work.length+1) _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,hsame,hfinal] at hN hNC
  exact ⟨hN,hNC.trans hc⟩

theorem drain_call (counter context normal child : Bits) (v : Symbol) : Stacks.stackRun program (normal.length+1) ⟨some (.drain 0),v,store counter context normal [] child⟩=
      some ⟨some (.done),none,store counter context [] [] child⟩ ∧
    Stacks.stackRunClock program (normal.length+1) ⟨some (.drain 0),v,store counter context normal [] child⟩=normal.length^2+3*normal.length+3 := by
  let S := store counter context normal [] child
  have hinj : Function.Injective (normCode) := normCode_injective
  have hsame : StackCall.frame (normCode) S (Normalization.singleStack normal)=S := by
    apply StackCall.frame_same _ _ _ hinj
    intro k
    rfl
  have hfinal : StackCall.frame (normCode) S (Normalization.singleStack [])=store counter context [] [] child := by
    funext bank
    cases bank with
    | inl k =>
      fin_cases k
      all_goals first
      | exact StackCall.frame_at (normCode) S _ hinj 0
      | (rw [WordValidator.frame_outside (normCode : Fin 1 → Slot) S _ _ (by intro j; fin_cases j; simp [normCode])]; rfl)
    | inr k =>
      cases k
      all_goals first
      | exact StackCall.frame_at (normCode) S _ hinj 0
      | (rw [WordValidator.frame_outside (normCode) S _ _ (by intro j; fin_cases j; simp [normCode])]; rfl)
  have hr := Normalization.drain_run normal v
  have hc := Normalization.drain_clock normal v
  obtain ⟨hN,hNC⟩ := StackCall.execution (normCode) Label.drain (.done) id (fun _ t => t)
    (StackCall.frame (normCode) S)
    (fun data k => StackCall.frame_at _ _ data hinj k)
    (fun data k bits => StackCall.frame_update _ _ data hinj k bits)
    (fun _ _ => rfl) (fun _ _ _ => rfl) Normalization.drainProgram program (fun _ => rfl) v (normal.length+1) _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,hsame,hfinal] at hN hNC
  exact ⟨hN,hNC.trans hc⟩

theorem complete (counter context : Bits) (v : Symbol) : ∃ ticks,
    Stacks.stackRun program ticks ⟨some (.counter .emit),v,store counter context.reverse [] [] []⟩=
      some ⟨none,none,store counter context.reverse [] [] (framed (binaryValue counter).bits++context).reverse⟩ ∧
    Stacks.stackRunClock program ticks ⟨some (.counter .emit),v,store counter context.reverse [] [] []⟩≤
      1000000*(1+counter.length+context.length)^3 := by
  let n := binaryValue counter
  obtain ⟨hC,hCC⟩ := counter_call counter context.reverse v
  obtain ⟨normalTicks,last,hN,hNC⟩ := normalize_call counter context.reverse none
  obtain ⟨hP,hPC⟩ := parent_call counter context n.bits.reverse last
  obtain ⟨frameTicks,hF,hFC⟩ := frame_call n counter context none
  obtain ⟨hT,hTC⟩ :=
      transfer_call counter context.reverse n.bits.reverse (framed n.bits++context) none
  obtain ⟨hD,hDC⟩ :=
      drain_call counter context.reverse n.bits.reverse (framed n.bits++context).reverse none
  simp only [List.length_reverse] at hD hDC
  have hH : Stacks.stackRun program 1 ⟨some .done,none,store counter context.reverse [] [] (framed n.bits++context).reverse⟩=
    some ⟨none,none,store counter context.reverse [] [] (framed n.bits++context).reverse⟩ := rfl
  have hHC :
      Stacks.stackRunClock program 1 ⟨some .done,none,store counter context.reverse [] [] (framed n.bits++context).reverse⟩=1 := rfl
  have eC : Stacks.Execution program _ _ _ := ⟨2*counter.length+3,hC,hCC.le⟩
  have eN : Stacks.Execution program _ _ _ := ⟨normalTicks,hN,hNC⟩
  have eP : Stacks.Execution program _ _ _ := ⟨2*context.length+3,hP,hPC.le⟩
  have eF : Stacks.Execution program _ _ _ := ⟨frameTicks,hF,hFC⟩
  have eT : Stacks.Execution program _ _ _ := ⟨(framed n.bits++context).length+1,hT,hTC.le⟩
  have eD : Stacks.Execution program _ _ _ := ⟨n.bits.length+1,hD,hDC.le⟩
  have eH : Stacks.Execution program _ _ 1 := ⟨1,hH,hHC.le⟩
  obtain ⟨ticks,hr,hc⟩ := (((((eC.trans eN).trans eP).trans eF).trans eT).trans eD).trans eH
  refine ⟨ticks,hr,hc.trans ?_⟩
  let B := 1+counter.length+context.length
  have hB : 1≤B := by dsimp [B]; omega
  have hB2 : B≤B^2 := Nat.le_pow (by decide)
  have h23 : B^2≤B^3 := Nat.pow_le_pow_right hB (by decide)
  have h13 : 1≤B^3 := Nat.one_le_pow 3 _ hB
  have hn : n.bits.length≤counter.length := BinaryNormalize.canonical_length counter
  have hlen : (framed n.bits++context).length≤4*B := by
    have hh := Counter.bits_length_le n.bits.length
    dsimp [B]
    simp only [framed,List.length_append,natBits_length]
    omega
  have hg : 1+n.bits.length+context.length≤B := by dsimp [B]; omega
  have hg3 := Nat.pow_le_pow_left hg 3
  have ht2 := Nat.mul_le_mul hlen hlen
  have hc0 : counter.length≤B := by dsimp [B]; omega
  have hp0 : context.length≤B := by dsimp [B]; omega
  have hn0 : n.bits.length≤B := hn.trans hc0
  have hcsq := Nat.mul_le_mul hc0 hc0
  have hpsq := Nat.mul_le_mul hp0 hp0
  have hnsq := Nat.mul_le_mul hn0 hn0
  have hnorm := Nat.pow_le_pow_left (show 1+counter.length≤B by dsimp [B]; omega) 2
  change _≤1000000*B^3
  nlinarith only [hB,hB2,h23,h13,hn0,hc0,hp0,hcsq,hpsq,hnsq,hnorm,hg3,hlen,ht2]

end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.CounterContext
namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.PairZip
open Turing Qatlib.Concepts.BitWordCompiler.CanonicalCodec
abbrev Local := Symbol×Symbol
inductive Label where | scan | drain (second : Bool) (l : Fin 1) | done deriving DecidableEq,Fintype
instance : Inhabited Label := ⟨.scan⟩
def get (second : Bool) (v : Local) : Symbol := if second then v.2 else v.1
def put (second : Bool) (v : Local) (s : Symbol) : Local := if second then (v.1,s) else (s,v.2)

@[simp] theorem put_get (second : Bool) (v : Local) : put second v (get second v)=v := by cases second <;> rfl

def code (second : Bool) (_ : Fin 1) : Fin 3 := if second then 1 else 0

def program : Label → TM2.Stmt (fun _ : Fin 3 => Bool) Label Local
  | .scan => .pop 0 (fun v b => (b,v.2)) (.pop 1 (fun v b => (v.1,b))
      (.branch (fun v => v.1.isSome && v.2.isSome)
        (.push 2 (fun v => v.1.getD false) (.push 2 (fun v => v.2.getD false) (.goto (fun _ => .scan))))
        (.goto (fun _ => .drain false 0))))
  | .drain second l => StackCall.stmt (code second) (Label.drain second) (if second then .done else .drain true 0)
      (get second) (put second) (Normalization.drainProgram l)
  | .done => .halt

theorem drain_call (second : Bool) (a b out : Bits) (v : Local) :
    Stacks.stackRun program ((if second then b.length else a.length)+1)
      ⟨some (.drain second 0),v,Parsing.triple a b out⟩=
      some ⟨some (if second then .done else .drain true 0),put second v none,
        Parsing.triple (if second then a else []) (if second then [] else b) out⟩ ∧
    Stacks.stackRunClock program ((if second then b.length else a.length)+1)
      ⟨some (.drain second 0),v,Parsing.triple a b out⟩=
      (if second then b.length else a.length)^2+3*(if second then b.length else a.length)+3 := by
  let S := Parsing.triple a b out
  let bits := if second then b else a
  have hinj : Function.Injective (code second) := fun _ _ _ => Subsingleton.elim _ _
  have hsame : StackCall.frame (code second) S (Normalization.singleStack bits)=S := by
    apply StackCall.frame_same _ _ _ hinj
    intro k
    cases second <;> rfl
  have hfinal : StackCall.frame (code second) S (Normalization.singleStack [])=
      Parsing.triple (if second then a else []) (if second then [] else b) out := by
    funext k
    cases second <;> fin_cases k
    all_goals first
    | exact StackCall.frame_at (code false) S _ hinj 0
    | exact StackCall.frame_at (code true) S _ hinj 0
    | (rw [WordValidator.frame_outside (code false) S _ _ (by intro j; fin_cases j; simp [code])]; rfl)
    | (rw [WordValidator.frame_outside (code true) S _ _ (by intro j; fin_cases j; simp [code])]; rfl)
  have hlen : bits.length=(if second then b.length else a.length) := by cases second <;> rfl
  have hr := Normalization.drain_run bits (get second v)
  obtain ⟨hN,hNC⟩ := StackCall.execution (code second) (Label.drain second) (if second then .done else .drain true 0) (get second) (put second)
    (StackCall.frame (code second) S)
    (fun data k => StackCall.frame_at _ _ data hinj k)
    (fun data k bs => StackCall.frame_update _ _ data hinj k bs)
    (by intro w s; cases second <;> rfl) (by intro w s t; cases second <;> rfl)
    Normalization.drainProgram program (fun _ => rfl) v (bits.length+1) _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,hsame,hfinal,hlen,put_get] at hN hNC
  have hc := Normalization.drain_clock bits (get second v)
  rw [hlen] at hc
  exact ⟨hN,hNC.trans hc⟩

theorem sweep (a b out : Bits) (v : Local) : ∃ ticks,
    Stacks.stackRun program ticks ⟨some (.drain false 0),v,Parsing.triple a b out⟩=
      some ⟨none,(none,none),Parsing.triple [] [] out⟩ ∧
    Stacks.stackRunClock program ticks ⟨some (.drain false 0),v,Parsing.triple a b out⟩≤20*(1+a.length+b.length)^2 := by
  obtain ⟨hA,hAC⟩ := drain_call false a b out v
  obtain ⟨hB,hBC⟩ := drain_call true [] b out (put false v none)
  have hH : Stacks.stackRun program 1 ⟨some .done,(none,none),Parsing.triple [] [] out⟩=
      some ⟨none,(none,none),Parsing.triple [] [] out⟩ := rfl
  have hHC : Stacks.stackRunClock program 1 ⟨some .done,(none,none),Parsing.triple [] [] out⟩=1 :=
      rfl
  have eA : Stacks.Execution program _ _ _ := ⟨a.length+1,hA,hAC.le⟩
  have eB : Stacks.Execution program _ _ _ := ⟨b.length+1,hB,hBC.le⟩
  have eH : Stacks.Execution program _ _ 1 := ⟨1,hH,hHC.le⟩
  obtain ⟨ticks,hr,hc⟩ := (eA.trans eB).trans eH
  simp only [Bool.false_eq_true,ite_false,ite_true] at hc
  exact ⟨ticks,hr,hc.trans (by nlinarith only [Nat.zero_le (a.length^2),Nat.zero_le (b.length^2),Nat.zero_le (a.length*b.length)])⟩

theorem scan_stop (a b out : Bits) (v : Local) (he : a=[] ∨ b=[]) :
    Stacks.stackRun program 1 ⟨some .scan,v,Parsing.triple a b out⟩=
      some ⟨some (.drain false 0),(a.head?,b.head?),Parsing.triple a.tail b.tail out⟩ ∧
    Stacks.stackRunClock program 1 ⟨some .scan,v,Parsing.triple a b out⟩≤5*(1+a.length+b.length) := by
  rcases he with he | he
  · subst a
    cases b <;> constructor <;> simp
        [Stacks.run_one,TM2.step,program,TM2.stepAux,Stacks.stackRunClock,Stacks.stackClock]
    all_goals omega
  · subst b
    cases a <;> constructor <;> simp
        [Stacks.run_one,TM2.step,program,TM2.stepAux,Stacks.stackRunClock,Stacks.stackClock]
    all_goals omega

theorem scan_pair (x y : Bool) (a b out : Bits) (v : Local) :
    Stacks.stackRun program 1 ⟨some .scan,v,Parsing.triple (x::a) (y::b) out⟩=
      some ⟨some .scan,(some x,some y),Parsing.triple a b (y::x::out)⟩ ∧
    Stacks.stackRunClock program 1 ⟨some .scan,v,Parsing.triple (x::a) (y::b) out⟩=
      2*a.length+2*b.length+4*out.length+15 := by
  constructor
  · simp [Stacks.run_one,TM2.step,program,TM2.stepAux]
  · simp [Stacks.stackRunClock,program,Stacks.stackClock]
    omega

def output (a b : Bits) : Bits := (a.zip b).flatMap (fun pair => [pair.1,pair.2])
def size (a b out : Bits) := 1+2*a.length+2*b.length+out.length

theorem empty (a b out : Bits) (v : Local) (he : a=[] ∨ b=[]) : ∃ ticks,
    Stacks.stackRun program ticks ⟨some .scan,v,Parsing.triple a b out⟩=
      some ⟨none,(none,none),Parsing.triple [] [] out⟩ ∧
    Stacks.stackRunClock program ticks ⟨some .scan,v,Parsing.triple a b out⟩≤30*(1+a.length+b.length)^2 := by
  obtain ⟨hS,hSC⟩ := scan_stop a b out v he
  obtain ⟨sweepTicks,hD,hDC⟩ := sweep a.tail b.tail out (a.head?,b.head?)
  have eS : Stacks.Execution program _ _ _ := ⟨1,hS,hSC⟩
  have eD : Stacks.Execution program _ _ _ := ⟨sweepTicks,hD,hDC⟩
  obtain ⟨ticks,hr,hc⟩ := eS.trans eD
  refine ⟨ticks,hr,hc.trans ?_⟩
  have ht : 1+a.tail.length+b.tail.length≤1+a.length+b.length := by
    simp only [List.length_tail]; omega
  have ht2 := Nat.pow_le_pow_left ht 2
  have hb : 1+a.length+b.length≤(1+a.length+b.length)^2 := Nat.le_pow (by decide)
  nlinarith only [ht2,hb]

theorem complete (a b out : Bits) (v : Local) : ∃ ticks,
    Stacks.stackRun program ticks ⟨some .scan,v,Parsing.triple a b out⟩=
      some ⟨none,(none,none),Parsing.triple [] [] ((output a b).reverse++out)⟩ ∧
    Stacks.stackRunClock program ticks ⟨some .scan,v,Parsing.triple a b out⟩≤100*(size a b out)^2 := by
  induction a generalizing b out v with
  | nil =>
    obtain ⟨ticks,hr,hc⟩ := empty [] b out v (Or.inl rfl)
    refine ⟨ticks,?_,hc.trans ?_⟩
    · simpa only [output,List.zip_nil_left,List.flatMap_nil,List.reverse_nil,List.nil_append] using
        hr
    · have hh := Nat.pow_le_pow_left (show 1+([] : Bits).length+b.length≤size [] b out by dsimp [size]; omega) 2
      omega
  | cons x a ih =>
    cases b with
    | nil =>
      obtain ⟨ticks,hr,hc⟩ := empty (x::a) [] out v (Or.inr rfl)
      refine ⟨ticks,?_,hc.trans ?_⟩
      · simpa only
          [output,List.zip_nil_right,List.flatMap_nil,List.reverse_nil,List.nil_append] using hr
      · have hh := Nat.pow_le_pow_left (show 1+(x::a).length+([] : Bits).length≤size (x::a) [] out by dsimp [size]; omega) 2
        omega
    | cons y b =>
      obtain ⟨hS,hSC⟩ := scan_pair x y a b out v
      obtain ⟨tailTicks,hT,hTC⟩ := ih b (y::x::out) (some x,some y)
      have eS : Stacks.Execution program _ _ _ := ⟨1,hS,hSC.le⟩
      have eT : Stacks.Execution program _ _ _ := ⟨tailTicks,hT,hTC⟩
      obtain ⟨ticks,hr,hc⟩ := eS.trans eT
      refine ⟨ticks,?_,hc.trans ?_⟩
      · simpa only
          [output,List.zip_cons_cons,List.flatMap_cons,List.reverse_append,List.reverse_cons,List.reverse_nil,List.nil_append,List.append_assoc,List.singleton_append] using! hr
      · dsimp [size]
        nlinarith only [Nat.zero_le a.length,Nat.zero_le b.length,Nat.zero_le out.length]
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.PairZip

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Scheduler
open Qatlib.Concepts.BitWordCompiler.CanonicalCodec

def counterStream (cs : List ℕ) : Bits := TM.TableGet.stream (cs.map Nat.bits)
def jobBits (job : Job) : Bits := framed (counterStream job.counters)++planBits job.plan
def queueBits (jobs : List Job) : Bits := jobs.flatMap jobBits

def WellFormed (syntaxBound counterBound : ℕ) (job : Job) : Prop :=
  job.counters.length+(planBits job.plan).length≤syntaxBound ∧ ∀ n∈job.counters,n≤counterBound

theorem wellFormed_initial (p : Plan) (counterBound : ℕ) :
    WellFormed (planBits p).length counterBound ⟨[],p⟩ := by simp [WellFormed]

theorem wellFormed_child (params : List Bits) (k syntaxBound counterBound : ℕ) (job child : Job)
    (hw : WellFormed syntaxBound counterBound job) (hwork : work params k job.counters job.plan≤counterBound)
    (hchild : child∈(stepOne params k job).2) : WellFormed syntaxBound counterBound child := by
  rcases job with ⟨cs,p⟩
  rcases hw with ⟨hs,hn⟩
  change cs.length+(planBits p).length≤syntaxBound at hs
  change work params k cs p≤counterBound at hwork
  cases p with
  | literal bits => simp [stepOne] at hchild
  | copy i => simp [stepOne] at hchild
  | emitNat s => simp [stepOne] at hchild
  | fixedCount width s => simp [stepOne] at hchild
  | pairScan i j => simp [stepOne] at hchild
  | append a b =>
    simp [stepOne] at hchild
    rcases hchild with rfl | rfl
    all_goals refine ⟨?_,hn⟩
    all_goals simp only [planBits,List.length_append,natBits_length] at hs
    all_goals (try dsimp only); omega
  | «repeat» bound body =>
    have hc := child_count_le_work params k ⟨cs,.repeat bound body⟩
    simp only [stepOne,List.length_map,List.length_range] at hc
    simp only [stepOne,List.mem_map] at hchild
    obtain ⟨i,hi,rfl⟩ := hchild
    have hiBound := List.mem_range.mp hi
    refine ⟨?_,?_⟩
    · simp only [List.length_cons]
      simp only [planBits,List.length_append,natBits_length] at hs
      omega
    · intro n hmem
      rcases List.mem_cons.mp hmem with rfl | hmem
      · omega
      · exact hn n hmem

theorem framed_length_bound (bits : Bits) : (framed bits).length≤3*bits.length+1 := by
  have hh := TM.Counter.bits_length_le bits.length
  simp only [framed,List.length_append,natBits_length]
  omega

theorem counterStream_length (cs : List ℕ) (bound : ℕ) (hb : ∀ n∈cs,n≤bound) :
    (counterStream cs).length≤cs.length*(3*bound+1) := by
  induction cs with
  | nil => simp [counterStream,TM.TableGet.stream]
  | cons n cs ih =>
    have hn : n≤bound := hb n (List.mem_cons_self)
    have hnBits := TM.Counter.bits_length_le n
    have hframe := framed_length_bound n.bits
    have htail := ih (fun m hm => hb m (List.mem_cons_of_mem n hm))
    simp only [counterStream,TM.TableGet.stream,List.map_cons,List.flatMap_cons,List.length_append,List.length_cons] at htail ⊢
    nlinarith only [hn,hnBits,hframe,htail]

theorem jobBits_length_bound (syntaxBound counterBound B : ℕ) (hB : 1≤B) (hs : syntaxBound≤B) (hc : counterBound≤B)
    (job : Job) (hw : WellFormed syntaxBound counterBound job) : (jobBits job).length≤14*B^2 := by
  obtain ⟨hsyntax,hcounter⟩ := hw
  have hcs : job.counters.length≤B := by omega
  have hplan : (planBits job.plan).length≤B := by omega
  have hstream := counterStream_length job.counters counterBound hcounter
  have hg := Nat.mul_le_mul hcs (show 3*counterBound+1≤4*B by omega)
  have hframe := framed_length_bound (counterStream job.counters)
  have hB2 : B≤B^2 := Nat.le_pow (by decide)
  have h12 : 1≤B^2 := hB.trans hB2
  simp only [jobBits,List.length_append]
  nlinarith only [hstream,hg,hframe,hplan,hB2,h12]

theorem queueBits_length (syntaxBound counterBound B : ℕ) (hB : 1≤B) (hs : syntaxBound≤B) (hc : counterBound≤B)
    (jobs : List Job) (hw : ∀ job∈jobs,WellFormed syntaxBound counterBound job) :
    (queueBits jobs).length≤jobs.length*(14*B^2) := by
  induction jobs with
  | nil => simp [queueBits]
  | cons job jobs ih =>
    have hj :=
        jobBits_length_bound syntaxBound counterBound B hB hs hc job (hw job (List.mem_cons_self))
    have ht := ih (fun j hm => hw j (List.mem_cons_of_mem job hm))
    simp only [queueBits,List.flatMap_cons,List.length_append,List.length_cons] at ht ⊢
    nlinarith only [hj,ht]

theorem queueBits_length_budget (params : List Bits) (k syntaxBound counterBound B : ℕ) (hB : 1≤B)
    (hs : syntaxBound≤B) (hc : counterBound≤B) (jobs : List Job)
    (hw : ∀ job∈jobs,WellFormed syntaxBound counterBound job) (hwork : pendingWork params k jobs≤B) :
    (queueBits jobs).length≤14*B^3 := by
  have hl := queueBits_length syntaxBound counterBound B hB hs hc jobs hw
  have hj := pendingWork_length params k jobs
  have hm := Nat.mul_le_mul_right (14*B^2) (show jobs.length≤B by omega)
  nlinarith only [hl,hm]
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.Scheduler

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.EmitterCore
open Turing Qatlib.Concepts.BitWordCompiler.CanonicalCodec
inductive Work where
  | jobs | plan | eval | params | context | precision | output | value | width
  | first | second | firstNormal | secondNormal | firstPlan | secondPlan | loopCount | childContext | tag | discard | pending
  deriving DecidableEq,Fintype
inductive Aux where
  | scalar (s : ScalarEval.Slot) | read (s : NatReadEmit.Slot) | scanner (s : PlanCopy.Slot)
  | frame (s : FramedTake.Slot) | lookup (s : ReadonlyTableGet.Slot)
  | push (s : JobPush.Slot) | context (s : CounterContext.Slot)
  | copyTemporary | emitTemporary | takeTemporary | counterTemporary
  deriving DecidableEq,Fintype
abbrev Slot := Work ⊕ Aux
abbrev Local :=
    ((ScalarEval.Local×PlanCopy.Local)×(NatReadEmit.Local×FramedTake.Local))×((TinyTag.Local×Counter.Local)×(PairZip.Local×Symbol))

set_option synthInstance.maxSize 1024 in
instance localFintype : Fintype Local := inferInstance

def getScalar (v : Local) := v.1.1.1
def putScalar (v : Local) (s : ScalarEval.Local) : Local := (((s,v.1.1.2),v.1.2),v.2)
def getScan (v : Local) := v.1.1.2
def putScan (v : Local) (s : PlanCopy.Local) : Local := (((v.1.1.1,s),v.1.2),v.2)
def getRead (v : Local) := v.1.2.1
def putRead (v : Local) (s : NatReadEmit.Local) : Local := ((v.1.1,(s,v.1.2.2)),v.2)
def getFrame (v : Local) := v.1.2.2
def putFrame (v : Local) (s : FramedTake.Local) : Local := ((v.1.1,(v.1.2.1,s)),v.2)
def getTag (v : Local) := v.2.1.1
def putTag (v : Local) (s : TinyTag.Local) : Local := (v.1,((s,v.2.1.2),v.2.2))
def getCounter (v : Local) := v.2.1.2
def putCounter (v : Local) (s : Counter.Local) : Local := (v.1,((v.2.1.1,s),v.2.2))
def getZip (v : Local) := v.2.2.1
def putZip (v : Local) (s : PairZip.Local) : Local := (v.1,(v.2.1,(s,v.2.2.2)))
def getIO (v : Local) := v.2.2.2
def putIO (v : Local) (s : Symbol) : Local := (v.1,(v.2.1,(v.2.2.1,s)))
def getLookup (v : Local) := ScalarEval.getLookup (getScalar v)
def putLookup (v : Local) (s : ReadonlyTableGet.Local) : Local :=
    putScalar v (ScalarEval.putLookup (getScalar v) s)
def getTake (v : Local) : CountedTake.Local := (getCounter v,getIO v)
def putTake (v : Local) (s : CountedTake.Local) : Local := putIO (putCounter v s.1) s.2

inductive PlanBank where | original | first | second deriving DecidableEq,Fintype
inductive ReaderBank where | jobs | eval deriving DecidableEq,Fintype
inductive ContextBank where | parent | child deriving DecidableEq,Fintype
inductive FrameKind where | context | literal deriving DecidableEq,Fintype
inductive ValueBank where | value | width deriving DecidableEq,Fintype
inductive OutputBank where | output | first | second deriving DecidableEq,Fintype
inductive Phase where
  | loop | contextDecoded | planDecoded | planReady | rootRead | rootTag | dispatch
  | copyIndex | emitValue | widthRead | fixedValue | pairFirstIndex | pairFirstCopied | pairSecondIndex | pairSecondCopied | pairFirstNormal | pairSecondNormal
  | appendFirst | appendSecond | appendRight | repeatBound | repeatReady | repeatDecide | repeatContext | repeatPushed | repeatNext | finish
  | terminalParams | done
  deriving DecidableEq,Fintype

def planKey : PlanBank → Work | .original => .plan | .first => .firstPlan | .second => .secondPlan
def readerKey : ReaderBank → Work | .jobs => .jobs | .eval => .eval
def contextKey : ContextBank → Work | .parent => .context | .child => .childContext
def valueKey : ValueBank → Work | .value => .value | .width => .width
def outputKey : OutputBank → Work | .output => .output | .first => .first | .second => .second

def cleanList : List Work :=
    [.plan,.eval,.context,.value,.width,.first,.second,.firstNormal,.secondNormal,.firstPlan,.secondPlan,.loopCount,.childContext,.tag,.discard,.pending]

set_option synthInstance.maxSize 512 in
inductive Label where
  | step (phase : Phase)
  | read (ret : Phase) (dest : ValueBank) (l : NatReadEmit.Label)
  | scanStart (ret : Phase) (reader : ReaderBank) (dest : PlanBank)
  | scan (ret : Phase) (reader : ReaderBank) (dest : PlanBank) (l : PlanCopy.Label)
  | frame (ret : Phase) (kind : FrameKind) (l : FramedTake.Label)
  | scalar (ret : Phase) (forRepeat : Bool) (l : ScalarEval.Label)
  | lookup (ret : Phase) (dest : OutputBank) (l : ReadonlyTableGet.Label)
  | copy (ret : Phase) (source dest : Work) (l : NatEmit.Label)
  | transfer (ret : Phase) (source dest : Work) (l : Fin 1)
  | tag (l : TinyTag.Label)
  | emit (l : NatEmit.Label)
  | take (l : CountedTake.Label)
  | zip (l : PairZip.Label)
  | push (ret : Phase) (plan : PlanBank) (context : ContextBank) (l : JobPush.Label)
  | context (l : CounterContext.Label)
  | counter (l : Counter.Label)
  | drain (ret : Phase) (bank : Work) (l : Fin 1)
  | clean (i : Fin 17) (l : Fin 1)
  deriving DecidableEq,Fintype
instance : Inhabited Label := ⟨.step .loop⟩

def readCode (dest : ValueBank) : NatReadEmit.Slot → Slot
  | .reader => .inl .eval | .value => .inl (valueKey dest) | .output => .inl .discard | k => .inr (.read k)
def scanCode (reader : ReaderBank) (dest : PlanBank) : PlanCopy.Slot → Slot
  | .reader => .inl (readerKey reader) | .pending => .inl .pending | .output => .inl (planKey dest) | k => .inr (.scanner k)
def frameCode : FrameKind → FramedTake.Slot → Slot
  | .context,.reader => .inl .jobs | .context,.output => .inl .context
  | .literal,.reader => .inl .eval | .literal,.output => .inl .output
  | _,k => .inr (.frame k)
def scalarCode (forRepeat : Bool) : ScalarEval.Slot → Slot
  | .reader => .inl .eval | .params => .inl .params | .counters => .inl .context | .precision => .inl .precision
  | .value => .inl (if forRepeat then .loopCount else .value) | k => .inr (.scalar k)
def lookupCode (dest : OutputBank) : ReadonlyTableGet.Slot → Slot
  | .inl 0 => .inl .params
  | .inr .index => .inl .value
  | .inr .output => .inl (outputKey dest)
  | k => .inr (.lookup k)
def copyCode (source dest : Work) : Fin 3 → Slot
  | 0 => .inl source | 1 => .inr .copyTemporary | _ => .inl dest
def transferCode (source dest : Work) : Fin 2 → Slot | 0 => .inl source | _ => .inl dest
def tagCode (_ : Fin 1) : Slot := .inl .tag
def emitCode : Fin 3 → Slot | 0 => .inl .value | 1 => .inr .emitTemporary | _ => .inl .output
def takeCode : Fin 4 →
    Slot | 0 => .inl .width | 1 => .inr .takeTemporary | 2 => .inl .value | _ => .inl .output
def zipCode : Fin 3 → Slot | 0 => .inl .firstNormal | 1 => .inl .secondNormal | _ => .inl .output
def pushCode (plan : PlanBank) (context : ContextBank) : JobPush.Slot → Slot
  | .inl 0 => .inl (planKey plan)
  | .inr .source => .inl (contextKey context)
  | .inr .output => .inl .jobs
  | k => .inr (.push k)
def contextCode : CounterContext.Slot → Slot
  | .inl 0 => .inl .loopCount | .inl 1 => .inl .context | .inl 2 => .inl .childContext
  | k => .inr (.context k)
def counterCode : Fin 2 → Slot | 0 => .inl .loopCount | _ => .inr .counterTemporary
def drainCode (bank : Work) (_ : Fin 1) : Slot := .inl bank

def readField (ret : Phase) (dest : ValueBank) : TM2.Stmt (fun _ : Slot => Bool) Label Local :=
    .goto (fun _ => .read ret dest (.read .unary))
def scalarField (ret : Phase) (forRepeat : Bool) : TM2.Stmt (fun _ : Slot => Bool) Label Local :=
    .goto (fun _ => .scalar ret forRepeat (.read .afterTag (.read .unary)))
def scanField (ret : Phase) (reader : ReaderBank) (dest : PlanBank) :
    TM2.Stmt (fun _ : Slot => Bool) Label Local := .goto (fun _ => .scanStart ret reader dest)

def phaseProgram : Phase → TM2.Stmt (fun _ : Slot => Bool) Label Local
  | .loop => .peek (.inl .jobs) (fun v b => putIO v b) (.branch (fun v => (getIO v).isSome)
      (.goto (fun _ => .frame .contextDecoded .context (.read (.read .unary))))
      (.goto (fun _ => .drain .terminalParams .params 0)))
  | .contextDecoded => scanField .planDecoded .jobs .original
  | .planDecoded => .goto (fun _ => .copy .planReady .plan .eval .emit)
  | .planReady => readField .rootRead .value
  | .rootRead => .goto (fun _ => .transfer .rootTag .value .tag 0)
  | .rootTag => .goto (fun _ => .tag .start)
  | .dispatch => .branch (fun v => decide ((getTag v).1.val=0)) (.goto (fun _ => .frame .finish .literal (.read (.read .unary))))
      (.branch (fun v => decide ((getTag v).1.val=1)) (readField .copyIndex .value)
      (.branch (fun v => decide ((getTag v).1.val=2)) (scalarField .emitValue false)
      (.branch (fun v => decide ((getTag v).1.val=3)) (readField .widthRead .width)
      (.branch (fun v => decide ((getTag v).1.val=4)) (readField .pairFirstIndex .value)
      (.branch (fun v => decide ((getTag v).1.val=5)) (scanField .appendFirst .eval .first)
      (.branch (fun v => decide ((getTag v).1.val=6)) (scalarField .repeatBound true) .halt))))))
  | .copyIndex => .goto (fun _ => .lookup .finish .output (.copy .emit))
  | .emitValue => .goto (fun _ => .emit .count)
  | .widthRead => scalarField .fixedValue false
  | .fixedValue => .goto (fun _ => .take (.counter .borrow))
  | .pairFirstIndex => .goto (fun _ => .lookup .pairFirstCopied .first (.copy .emit))
  | .pairFirstCopied => readField .pairSecondIndex .value
  | .pairSecondIndex => .goto (fun _ => .lookup .pairSecondCopied .second (.copy .emit))
  | .pairSecondCopied => .goto (fun _ => .transfer .pairFirstNormal .first .firstNormal 0)
  | .pairFirstNormal => .goto (fun _ => .transfer .pairSecondNormal .second .secondNormal 0)
  | .pairSecondNormal => .goto (fun _ => .zip .scan)
  | .appendFirst => scanField .appendSecond .eval .second
  | .appendSecond => .goto (fun _ => .push .appendRight .second .parent (.plan .emit))
  | .appendRight => .goto (fun _ => .push .finish .first .parent (.plan .emit))
  | .repeatBound => scanField .repeatReady .eval .first
  | .repeatReady => .goto (fun _ => .counter .borrow)
  | .repeatDecide => .branch (fun v => (getCounter v).1)
      (.goto (fun _ => .context (.counter .emit))) (.goto (fun _ => .step .finish))
  | .repeatContext => .goto (fun _ => .push .repeatPushed .first .child (.plan .emit))
  | .repeatPushed => .goto (fun _ => .drain .repeatNext .childContext 0)
  | .repeatNext => .goto (fun _ => .counter .borrow)
  | .finish => .goto (fun _ => .clean 0 0)
  | .terminalParams => .goto (fun _ => .drain .done .precision 0)
  | .done => .halt

def program : Label → TM2.Stmt (fun _ : Slot => Bool) Label Local
  | .step phase => phaseProgram phase
  | .read ret dest l => StackCall.stmt (readCode dest) (Label.read ret dest) (.step ret) getRead putRead (NatReadEmit.program l)
  | .scanStart ret reader dest => .push (.inl .pending) (fun _ => true) (.goto (fun _ => .scan ret reader dest (.step .loop)))
  | .scan ret reader dest l => StackCall.stmt (scanCode reader dest) (Label.scan ret reader dest) (.step ret) getScan putScan (PlanCopy.program l)
  | .frame ret kind l => StackCall.stmt (frameCode kind) (Label.frame ret kind) (.step ret) getFrame putFrame (FramedTake.program l)
  | .scalar ret forRepeat l => StackCall.stmt (scalarCode forRepeat) (Label.scalar ret forRepeat) (.step ret) getScalar putScalar (ScalarEval.program l)
  | .lookup ret dest l => StackCall.stmt (lookupCode dest) (Label.lookup ret dest) (.step ret) getLookup putLookup (ReadonlyTableGet.program l)
  | .copy ret source dest l => StackCall.stmt (copyCode source dest) (Label.copy ret source dest) (.step ret) getIO putIO (NatEmit.program l)
  | .transfer ret source dest l => StackCall.stmt (transferCode source dest) (Label.transfer ret source dest) (.step ret) getIO putIO (Stacks.transferProgram l)
  | .tag l => StackCall.stmt tagCode Label.tag (.step .dispatch) getTag putTag (TinyTag.program l)
  | .emit l => StackCall.stmt emitCode Label.emit (.step .finish) getIO putIO (NatEmit.program l)
  | .take l => StackCall.stmt takeCode Label.take (.step .finish) getTake putTake (CountedTake.program l)
  | .zip l => StackCall.stmt zipCode Label.zip (.step .finish) getZip putZip (PairZip.program l)
  | .push ret plan context l => StackCall.stmt (pushCode plan context) (Label.push ret plan context) (.step ret) getIO putIO (JobPush.program l)
  | .context l => StackCall.stmt contextCode Label.context (.step .repeatContext) getIO putIO (CounterContext.program l)
  | .counter l => StackCall.stmt counterCode Label.counter (.step .repeatDecide) getCounter putCounter (Counter.program l)
  | .drain ret bank l => StackCall.stmt (drainCode bank) (Label.drain ret bank) (.step ret) getIO putIO (Normalization.drainProgram l)
  | .clean i l => if h : i.val<16 then
      StackCall.stmt (drainCode (cleanList[i.val]'(by simpa [cleanList] using h)))
        (Label.clean i) (Label.clean ⟨i.val+1,by omega⟩ 0) getIO putIO (Normalization.drainProgram l)
      else .goto (fun _ => .step .loop)

def store (S : Work → Bits) : Slot → Bits | .inl w => S w | .inr _ => []

@[simp] theorem putIO_get (v : Local) : putIO v (getIO v)=v := rfl

@[simp] theorem putRead_get (v : Local) : putRead v (getRead v)=v := rfl

@[simp] theorem putScan_get (v : Local) : putScan v (getScan v)=v := rfl

@[simp] theorem putFrame_get (v : Local) : putFrame v (getFrame v)=v := rfl

@[simp] theorem putScalar_get (v : Local) : putScalar v (getScalar v)=v := rfl

@[simp] theorem putLookup_get (v : Local) : putLookup v (getLookup v)=v := rfl

@[simp] theorem putTag_get (v : Local) : putTag v (getTag v)=v := rfl

@[simp] theorem putCounter_get (v : Local) : putCounter v (getCounter v)=v := rfl

@[simp] theorem putZip_get (v : Local) : putZip v (getZip v)=v := rfl

@[simp] theorem putTake_get (v : Local) : putTake v (getTake v)=v := rfl

theorem frame_target {K : Type} [DecidableEq K] (code : K → Slot) (saved target : Slot → Bits) (data : K → Bits)
    (hinj : Function.Injective code) (hm : ∀ k,target (code k)=data k)
    (ho : ∀ bank,(∀ k,code k≠bank) → target bank=saved bank) : StackCall.frame code saved data=target := by
  classical
  funext bank
  by_cases he : ∃ k,code k=bank
  · obtain ⟨k,rfl⟩ := he
    exact (StackCall.frame_at code saved data hinj k).trans (hm k).symm
  · rw [WordValidator.frame_outside code saved data bank (fun k hk => he ⟨k,hk⟩)]
    exact (ho bank (fun k hk => he ⟨k,hk⟩)).symm

@[simp] theorem store_update (S : Work → Bits) (bank : Work) (bits : Bits) :
    Function.update (store S) (.inl bank) bits=store (Function.update S bank bits) := by
  funext k
  cases k with
  | inl w =>
    by_cases h : w=bank
    · subst w; simp [store]
    · simp [store,Function.update_of_ne h]
  | inr a => rfl

theorem copyCode_injective (source dest : Work) (hne : source≠dest) : Function.Injective (copyCode source dest) := by
  intro a b h
  fin_cases a <;> fin_cases b <;> simp_all [copyCode]

theorem transferCode_injective (source dest : Work) (hne : source≠dest) : Function.Injective (transferCode source dest) := by
  intro a b h
  fin_cases a <;> fin_cases b <;> simp_all [transferCode]

theorem readCode_injective (dest : ValueBank) : Function.Injective (readCode dest) := by
  intro a b h
  cases dest <;> cases a <;> cases b <;> simp [readCode,valueKey] at h ⊢

theorem copy_call (ret : Phase) (source dest : Work) (hne : source≠dest) (S : Work → Bits) (v : Local) :
    Stacks.stackRun program (2*(S source).length+3) ⟨some (.copy ret source dest .emit),v,store S⟩=
      some ⟨some (.step ret),putIO v none,store (Function.update S dest ((S source).reverse++S dest))⟩ ∧
    Stacks.stackRunClock program (2*(S source).length+3) ⟨some (.copy ret source dest .emit),v,store S⟩=
      (S source).length*(5*(S source).length+2*(S dest).length+12)+7 := by
  have hinj := copyCode_injective source dest hne
  let S' := Function.update S dest ((S source).reverse++S dest)
  have hsame : StackCall.frame (copyCode source dest) (store S) (Parsing.triple (S source) [] (S dest))=store S := by
    apply StackCall.frame_same _ _ _ hinj
    intro k
    fin_cases k <;> rfl
  have hfinal : StackCall.frame (copyCode source dest) (store S) (Parsing.triple (S source) [] ((S source).reverse++S dest))=store S' := by
    apply frame_target _ _ _ _ hinj
    · intro k
      fin_cases k <;> simp [S',store,copyCode,hne]
    · intro bank hno
      cases bank with
      | inl w =>
        have hw : w≠dest := fun h => hno 2 (congrArg Sum.inl h.symm)
        simp [S',store,hw]
      | inr a => rfl
  obtain ⟨hr,hc⟩ := NatEmit.copy_complete (S source) (S dest) (getIO v)
  obtain ⟨hN,hNC⟩ := StackCall.execution (copyCode source dest) (Label.copy ret source dest) (.step ret) getIO putIO
    (StackCall.frame (copyCode source dest) (store S))
    (fun data k => StackCall.frame_at _ _ data hinj k)
    (fun data k bits => StackCall.frame_update _ _ data hinj k bits)
    (fun _ _ => rfl) (fun _ _ _ => rfl) NatEmit.program program (fun _ => rfl) v (2*(S source).length+3) _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,putIO_get,hsame,hfinal] at hN hNC
  exact ⟨hN,hNC.trans hc⟩

theorem transfer_call (ret : Phase) (source dest : Work) (hne : source≠dest) (S : Work → Bits) (v : Local) :
    Stacks.stackRun program ((S source).length+1) ⟨some (.transfer ret source dest 0),v,store S⟩=
      some ⟨some (.step ret),putIO v none,store (Function.update (Function.update S source []) dest ((S source).reverse++S dest))⟩ ∧
    Stacks.stackRunClock program ((S source).length+1) ⟨some (.transfer ret source dest 0),v,store S⟩=
      (S source).length*(2*((S source).length+(S dest).length)+5)+3 := by
  have hinj := transferCode_injective source dest hne
  let S' := Function.update (Function.update S source []) dest ((S source).reverse++S dest)
  have hsame : StackCall.frame (transferCode source dest) (store S) (Stacks.stackPair (S source) (S dest))=store S := by
    apply StackCall.frame_same _ _ _ hinj
    intro k
    fin_cases k <;> rfl
  have hfinal : StackCall.frame (transferCode source dest) (store S) (Stacks.stackPair [] ((S source).reverse++S dest))=store S' := by
    apply frame_target _ _ _ _ hinj
    · intro k
      fin_cases k <;> simp [S',store,transferCode,hne]
    · intro bank hno
      cases bank with
      | inl w =>
        have hs : w≠source := fun h => hno 0 (congrArg Sum.inl h.symm)
        have hd : w≠dest := fun h => hno 1 (congrArg Sum.inl h.symm)
        simp [S',store,hs,hd]
      | inr a => rfl
  have hr := Stacks.transfer_run (S source) (S dest) (getIO v)
  obtain ⟨hN,hNC⟩ := StackCall.execution (transferCode source dest) (Label.transfer ret source dest) (.step ret) getIO putIO
    (StackCall.frame (transferCode source dest) (store S))
    (fun data k => StackCall.frame_at _ _ data hinj k)
    (fun data k bits => StackCall.frame_update _ _ data hinj k bits)
    (fun _ _ => rfl) (fun _ _ _ => rfl) Stacks.transferProgram program (fun _ => rfl) v ((S source).length+1) _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,putIO_get,hsame,hfinal] at hN hNC
  exact ⟨hN,hNC.trans (Stacks.transfer_clock (S source) (S dest) (getIO v))⟩

theorem drain_call (ret : Phase) (bank : Work) (S : Work → Bits) (v : Local) :
    Stacks.stackRun program ((S bank).length+1) ⟨some (.drain ret bank 0),v,store S⟩=
      some ⟨some (.step ret),putIO v none,store (Function.update S bank [])⟩ ∧
    Stacks.stackRunClock program ((S bank).length+1) ⟨some (.drain ret bank 0),v,store S⟩=
      (S bank).length^2+3*(S bank).length+3 := by
  have hinj : Function.Injective (drainCode bank) := fun _ _ _ => Subsingleton.elim _ _
  have hsame : StackCall.frame (drainCode bank) (store S) (Normalization.singleStack (S bank))=store S := by
    apply StackCall.frame_same _ _ _ hinj
    intro k
    rfl
  have hfinal : StackCall.frame (drainCode bank) (store S) (Normalization.singleStack [])=store (Function.update S bank []) := by
    have h :=
        StackCall.frame_update (drainCode bank) (store S)
        (Normalization.singleStack (S bank)) hinj 0 []
    simpa only [Normalization.singleStack_update,hsame,drainCode,store_update] using h
  have hr := Normalization.drain_run (S bank) (getIO v)
  obtain ⟨hN,hNC⟩ := StackCall.execution (drainCode bank) (Label.drain ret bank) (.step ret) getIO putIO
    (StackCall.frame (drainCode bank) (store S))
    (fun data k => StackCall.frame_at _ _ data hinj k)
    (fun data k bits => StackCall.frame_update _ _ data hinj k bits)
    (fun _ _ => rfl) (fun _ _ _ => rfl) Normalization.drainProgram program (fun _ => rfl) v ((S bank).length+1) _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,putIO_get,hsame,hfinal] at hN hNC
  exact ⟨hN,hNC.trans (Normalization.drain_clock (S bank) (getIO v))⟩

def readResult (dest : ValueBank) (n : ℕ) (tail : Bits) (S : Work → Bits) : Work → Bits :=
  Function.update (Function.update (Function.update S .eval tail) (valueKey dest) n.bits) .discard ((natBits n).reverse++S .discard)

theorem read_call (ret : Phase) (dest : ValueBank) (n : ℕ) (tail : Bits) (S : Work → Bits) (v : Local)
    (hrd : S .eval=natBits n++tail) (hv : S (valueKey dest)=[]) : ∃ ticks,
    Stacks.stackRun program ticks ⟨some (.read ret dest (.read .unary)),v,store S⟩=
      some ⟨some (.step ret),putRead v ((true,CheckedNat.lastField n.bits none),none),store (readResult dest n tail S)⟩ ∧
    Stacks.stackRunClock program ticks ⟨some (.read ret dest (.read .unary)),v,store S⟩≤
      500*(1+(S .eval).length+(S .discard).length)^2 := by
  have hinj := readCode_injective dest
  have hsame : StackCall.frame (readCode dest) (store S) (NatReadEmit.store (natBits n++tail) [] [] [] [] (S .discard))=store S := by
    apply StackCall.frame_same _ _ _ hinj
    intro k
    cases k <;> simp [store,readCode,NatReadEmit.store,hrd,hv]
  have hfinal : StackCall.frame (readCode dest) (store S) (NatReadEmit.store tail [] [] n.bits [] ((natBits n).reverse++S .discard))=store (readResult dest n tail S) := by
    apply frame_target _ _ _ _ hinj
    · intro k
      cases dest <;> cases k <;> simp [store,readCode,readResult,valueKey,NatReadEmit.store]
    · intro bank hno
      cases bank with
      | inl w =>
        have he : w≠.eval := fun h => hno .reader (congrArg Sum.inl h.symm)
        have hv : w≠valueKey dest := fun h => hno .value (congrArg Sum.inl h.symm)
        have hd : w≠.discard := fun h => hno .output (congrArg Sum.inl h.symm)
        simp [store,readResult,he,hv,hd]
      | inr a => rfl
  obtain ⟨ticks,hr,hc⟩ := NatReadEmit.complete n tail (S .discard) (getRead v)
  obtain ⟨hN,hNC⟩ := StackCall.execution (readCode dest) (Label.read ret dest) (.step ret) getRead putRead
    (StackCall.frame (readCode dest) (store S))
    (fun data k => StackCall.frame_at _ _ data hinj k)
    (fun data k bits => StackCall.frame_update _ _ data hinj k bits)
    (fun _ _ => rfl) (fun _ _ _ => rfl) NatReadEmit.program program (fun _ => rfl) v ticks _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,putRead_get,hsame,hfinal] at hN hNC
  exact ⟨ticks,hN,hNC.trans_le (by simpa only [hrd] using hc)⟩

theorem scanCode_injective (reader : ReaderBank) (dest : PlanBank) : Function.Injective (scanCode reader dest) := by
  intro a b h
  cases reader <;> cases dest <;> cases a <;> cases b <;> simp [scanCode,readerKey,planKey] at h ⊢

theorem scalarCode_injective (forRepeat : Bool) : Function.Injective (scalarCode forRepeat) := by
  intro a b h
  cases forRepeat <;> cases a <;> cases b <;> simp [scalarCode] at h ⊢

theorem frameCode_injective (kind : FrameKind) : Function.Injective (frameCode kind) := by
  intro a b h
  cases kind <;> cases a <;> cases b <;> simp [frameCode] at h ⊢

def scanResult (reader : ReaderBank) (dest : PlanBank) (p : Plan) (tail : Bits) (S : Work → Bits) : Work → Bits :=
  Function.update (Function.update S (readerKey reader) tail) (planKey dest) (planBits p).reverse

theorem scan_call (ret : Phase) (reader : ReaderBank) (dest : PlanBank) (p : Plan) (tail : Bits) (S : Work → Bits) (v : Local)
    (hr : S (readerKey reader)=planBits p++tail) (hd : S (planKey dest)=[]) (hp : S .pending=[]) : ∃ ticks last,
    Stacks.stackRun program ticks ⟨some (.scanStart ret reader dest),v,store S⟩=
      some ⟨some (.step ret),last,store (scanResult reader dest p tail S)⟩ ∧
    Stacks.stackRunClock program ticks ⟨some (.scanStart ret reader dest),v,store S⟩≤
      4+30000*(1+(planBits p).length)*(PlanCopy.scanSize (planBits p++tail) [] 1)^2 := by
  have hinj := scanCode_injective reader dest
  let S1 := Function.update S .pending [true]
  have hP : Stacks.stackRun program 1 ⟨some (.scanStart ret reader dest),v,store S⟩=
      some ⟨some (.scan ret reader dest (.step .loop)),v,store S1⟩ := by
    simp [Stacks.run_one,TM2.step,program,TM2.stepAux,store,hp,S1,← store_update]
  have hPC : Stacks.stackRunClock program 1 ⟨some (.scanStart ret reader dest),v,store S⟩=4 := by
    simp [Stacks.stackRunClock,program,Stacks.stackClock,store,hp]
  have hsame : StackCall.frame (scanCode reader dest) (store S1) (PlanCopy.store (planBits p++tail) [true] [] [] [])=store S1 := by
    apply StackCall.frame_same _ _ _ hinj
    intro k
    cases reader <;> cases dest <;> cases k
    all_goals simp only [readerKey,planKey] at hr hd
    all_goals simp [store,S1,scanCode,readerKey,planKey,PlanCopy.store,hr,hd]
  have hfinal : StackCall.frame (scanCode reader dest) (store S1) (PlanCopy.store tail [] [] [] (planBits p).reverse)=store (scanResult reader dest p tail S) := by
    apply frame_target _ _ _ _ hinj
    · intro k
      cases reader <;> cases dest <;> cases k <;> simp
          [store,scanCode,scanResult,readerKey,planKey,PlanCopy.store,hp]
    · intro bank hno
      cases bank with
      | inl w =>
        have hr : w≠readerKey reader := fun h => hno .reader (congrArg Sum.inl h.symm)
        have hd : w≠planKey dest := fun h => hno .output (congrArg Sum.inl h.symm)
        have hp : w≠.pending := fun h => hno .pending (congrArg Sum.inl h.symm)
        simp [store,scanResult,S1,hr,hd,hp]
      | inr a => rfl
  obtain ⟨ticks,last,hR,hRC⟩ := PlanCopy.complete p tail [] (getScan v)
  simp only [List.append_nil] at hR
  obtain ⟨hN,hNC⟩ := StackCall.execution (scanCode reader dest) (Label.scan ret reader dest) (.step ret) getScan putScan
    (StackCall.frame (scanCode reader dest) (store S1))
    (fun data k => StackCall.frame_at _ _ data hinj k)
    (fun data k bits => StackCall.frame_update _ _ data hinj k bits)
    (fun _ _ => rfl) (fun _ _ _ => rfl) PlanCopy.program program (fun _ => rfl) v ticks _ _ hR
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,putScan_get,hsame,hfinal] at hN hNC
  have eP : Stacks.Execution program _ _ 4 := ⟨1,hP,hPC.le⟩
  have eN : Stacks.Execution program _ _ _ := ⟨ticks,hN,hNC.trans_le hRC⟩
  obtain ⟨total,hRun,hClock⟩ := eP.trans eN
  exact ⟨total,putScan v last,hRun,hClock⟩

def scalarValueKey (forRepeat : Bool) : Work := if forRepeat then .loopCount else .value
def scalarResult (forRepeat : Bool) (n : ℕ) (tail : Bits) (S : Work → Bits) : Work → Bits :=
  Function.update (Function.update S .eval tail) (scalarValueKey forRepeat) n.bits

theorem scalar_call (ret : Phase) (forRepeat : Bool) (s : Scalar) (params : List Bits) (cs : List ℕ) (k : ℕ) (tail : Bits) (S : Work → Bits) (v : Local)
    (hr : S .eval=scalarBits s++tail) (hp : S .params=(TableGet.stream params).reverse)
    (hc : S .context=(TableGet.stream (cs.map Nat.bits)).reverse) (hk : S .precision=k.bits.reverse)
    (hv : S (scalarValueKey forRepeat)=[]) : ∃ ticks last,
    Stacks.stackRun program ticks ⟨some (.scalar ret forRepeat (.read .afterTag (.read .unary))),v,store S⟩=
      some ⟨some (.step ret),last,store (scalarResult forRepeat (value params k cs s) tail S)⟩ ∧
    Stacks.stackRunClock program ticks ⟨some (.scalar ret forRepeat (.read .afterTag (.read .unary))),v,store S⟩≤
      2000000*(ScalarEval.size (scalarBits s++tail) params (cs.map Nat.bits) k [])^3 := by
  have hinj := scalarCode_injective forRepeat
  have hsame : StackCall.frame (scalarCode forRepeat) (store S)
      (ScalarEval.store (scalarBits s++tail) (TableGet.stream params).reverse (TableGet.stream (cs.map Nat.bits)).reverse k.bits.reverse [] [] [] [])=store S := by
    apply StackCall.frame_same _ _ _ hinj
    intro key
    cases forRepeat <;> cases key <;> simp
        [store,scalarCode,ScalarEval.store,hr,hp,hc,hk,scalarValueKey] at hv ⊢
    all_goals exact hv
  have hfinal : StackCall.frame (scalarCode forRepeat) (store S)
      (ScalarEval.store tail (TableGet.stream params).reverse (TableGet.stream (cs.map Nat.bits)).reverse k.bits.reverse (value params k cs s).bits [] [] [])=
      store (scalarResult forRepeat (value params k cs s) tail S) := by
    apply frame_target _ _ _ _ hinj
    · intro key
      cases forRepeat <;> cases key <;> simp
          [store,scalarCode,scalarResult,scalarValueKey,ScalarEval.store,hp,hc,hk]
    · intro bank hno
      cases bank with
      | inl w =>
        have hr : w≠.eval := fun h => hno .reader (congrArg Sum.inl h.symm)
        have hv : w≠scalarValueKey forRepeat := fun h => hno .value (congrArg Sum.inl h.symm)
        simp [store,scalarResult,hr,hv]
      | inr a => rfl
  obtain ⟨ticks,last,hR,hRC⟩ := ScalarEval.complete s params cs k tail (getScalar v)
  obtain ⟨hN,hNC⟩ := StackCall.execution (scalarCode forRepeat) (Label.scalar ret forRepeat) (.step ret) getScalar putScalar
    (StackCall.frame (scalarCode forRepeat) (store S))
    (fun data key => StackCall.frame_at _ _ data hinj key)
    (fun data key bits => StackCall.frame_update _ _ data hinj key bits)
    (fun _ _ => rfl) (fun _ _ _ => rfl) ScalarEval.program program (fun _ => rfl) v ticks _ _ hR
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,putScalar_get,hsame,hfinal] at hN hNC
  exact ⟨ticks,putScalar v last,hN,hNC.trans_le hRC⟩

def frameReader : FrameKind → Work | .context => .jobs | .literal => .eval
def frameOutput : FrameKind → Work | .context => .context | .literal => .output
def frameResult (kind : FrameKind) (bits tail : Bits) (S : Work → Bits) : Work → Bits :=
  Function.update (Function.update S (frameReader kind) tail) (frameOutput kind) (bits.reverse++S (frameOutput kind))

theorem frame_call (ret : Phase) (kind : FrameKind) (bits tail : Bits) (S : Work → Bits) (v : Local)
    (hr : S (frameReader kind)=framed bits++tail) : ∃ ticks last,
    Stacks.stackRun program ticks ⟨some (.frame ret kind (.read (.read .unary))),v,store S⟩=
      some ⟨some (.step ret),last,store (frameResult kind bits tail S)⟩ ∧
    Stacks.stackRunClock program ticks ⟨some (.frame ret kind (.read (.read .unary))),v,store S⟩≤
      5000*(bits.length+1)*(1+(framed bits++tail).length+(S (frameOutput kind)).length)^2 := by
  have hinj := frameCode_injective kind
  have hsame : StackCall.frame (frameCode kind) (store S) (FramedTake.store (framed bits++tail) [] [] (S (frameOutput kind)))=store S := by
    apply StackCall.frame_same _ _ _ hinj
    intro key
    cases kind <;> cases key <;> simp
        [store,frameCode,frameReader,frameOutput,FramedTake.store] at hr ⊢
    all_goals exact hr
  have hfinal : StackCall.frame (frameCode kind) (store S) (FramedTake.store tail [] [] (bits.reverse++S (frameOutput kind)))=store (frameResult kind bits tail S) := by
    apply frame_target _ _ _ _ hinj
    · intro key
      cases kind <;> cases key <;> simp
          [store,frameCode,frameResult,frameReader,frameOutput,FramedTake.store]
    · intro bank hno
      cases bank with
      | inl w =>
        have hr : w≠frameReader kind := by
          cases kind <;> intro h <;> exact hno .reader (congrArg Sum.inl h.symm)
        have ho : w≠frameOutput kind := by
          cases kind <;> intro h <;> exact hno .output (congrArg Sum.inl h.symm)
        simp [store,frameResult,hr,ho]
      | inr a => rfl
  obtain ⟨ticks,last,hR,hRC⟩ := FramedTake.complete bits tail (S (frameOutput kind)) (getFrame v)
  obtain ⟨hN,hNC⟩ := StackCall.execution (frameCode kind) (Label.frame ret kind) (.step ret) getFrame putFrame
    (StackCall.frame (frameCode kind) (store S))
    (fun data key => StackCall.frame_at _ _ data hinj key)
    (fun data key bits => StackCall.frame_update _ _ data hinj key bits)
    (fun _ _ => rfl) (fun _ _ _ => rfl) FramedTake.program program (fun _ => rfl) v ticks _ _ hR
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,putFrame_get,hsame,hfinal] at hN hNC
  exact ⟨ticks,putFrame v last,hN,hNC.trans_le hRC⟩

theorem lookupCode_injective (dest : OutputBank) : Function.Injective (lookupCode dest) := by
    cases dest <;> decide

theorem pushCode_injective (plan : PlanBank) (context : ContextBank) :
    Function.Injective (pushCode plan context) := by cases plan <;> cases context <;> decide

theorem contextCode_injective : Function.Injective contextCode := by decide

def lookupResult (dest : OutputBank) (params : List Bits) (S : Work → Bits) : Work → Bits :=
  Function.update (Function.update S .value []) (outputKey dest) ((params.getD (binaryValue (S .value)) []).reverse++S (outputKey dest))

theorem lookup_call (ret : Phase) (dest : OutputBank) (params : List Bits) (S : Work → Bits) (v : Local)
    (hp : S .params=(TableGet.stream params).reverse) : ∃ ticks last,
    Stacks.stackRun program ticks ⟨some (.lookup ret dest (.copy .emit)),v,store S⟩=
      some ⟨some (.step ret),last,store (lookupResult dest params S)⟩ ∧
    Stacks.stackRunClock program ticks ⟨some (.lookup ret dest (.copy .emit)),v,store S⟩≤
      30000*(1+(TableGet.stream params).length)*(1+(TableGet.stream params).length+(S .value).length+(S (outputKey dest)).length)^2 := by
  have hinj := lookupCode_injective dest
  have hsame : StackCall.frame (lookupCode dest) (store S)
      (ReadonlyTableGet.store (TableGet.stream params).reverse [] (S .value) (S (outputKey dest)))=store S := by
    apply StackCall.frame_same _ _ _ hinj
    intro key
    cases key with
    | inl key => fin_cases key <;> simp [store,lookupCode,ReadonlyTableGet.store,hp]
    | inr key => cases key <;> simp [store,lookupCode,ReadonlyTableGet.store,TableGet.store]
  have hfinal : StackCall.frame (lookupCode dest) (store S)
      (ReadonlyTableGet.store (TableGet.stream params).reverse [] [] ((params.getD (binaryValue (S .value)) []).reverse++S (outputKey dest)))=
      store (lookupResult dest params S) := by
    apply frame_target _ _ _ _ hinj
    · intro key
      cases key with
      | inl key => cases dest <;> fin_cases key <;> simp [store,lookupCode,lookupResult,outputKey,ReadonlyTableGet.store,hp]
      | inr key => cases dest <;> cases key <;> simp [store,lookupCode,lookupResult,outputKey,ReadonlyTableGet.store,TableGet.store]
    · intro bank hno
      cases bank with
      | inl w =>
        have hv : w≠.value := fun h => hno (.inr .index) (congrArg Sum.inl h.symm)
        have ho : w≠outputKey dest := fun h => hno (.inr .output) (congrArg Sum.inl h.symm)
        simp [store,lookupResult,hv,ho]
      | inr a => rfl
  obtain ⟨ticks,last,hR,hRC⟩ :=
      ReadonlyTableGet.complete params (S .value) (S (outputKey dest)) (getLookup v)
  obtain ⟨hN,hNC⟩ := StackCall.execution (lookupCode dest) (Label.lookup ret dest) (.step ret) getLookup putLookup
    (StackCall.frame (lookupCode dest) (store S))
    (fun data key => StackCall.frame_at _ _ data hinj key)
    (fun data key bits => StackCall.frame_update _ _ data hinj key bits)
    (fun _ _ => rfl) (fun _ _ _ => rfl) ReadonlyTableGet.program program (fun _ => rfl) v ticks _ _ hR
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,putLookup_get,hsame,hfinal] at hN hNC
  exact ⟨ticks,putLookup v last,hN,hNC.trans_le hRC⟩

def pushResult (plan context : Bits) (S : Work → Bits) : Work → Bits :=
    Function.update S .jobs (framed context++plan++S .jobs)

theorem push_call (ret : Phase) (planBank : PlanBank) (contextBank : ContextBank) (plan context : Bits) (S : Work → Bits) (v : Local)
    (hp : S (planKey planBank)=plan.reverse) (hc : S (contextKey contextBank)=context.reverse) : ∃ ticks,
    Stacks.stackRun program ticks ⟨some (.push ret planBank contextBank (.plan .emit)),v,store S⟩=
      some ⟨some (.step ret),putIO v none,store (pushResult plan context S)⟩ ∧
    Stacks.stackRunClock program ticks ⟨some (.push ret planBank contextBank (.plan .emit)),v,store S⟩≤
      100000*(1+plan.length+context.length+(S .jobs).length)^3 := by
  have hinj := pushCode_injective planBank contextBank
  have hsame : StackCall.frame (pushCode planBank contextBank) (store S) (JobPush.store plan.reverse context.reverse (S .jobs))=store S := by
    apply StackCall.frame_same _ _ _ hinj
    intro key
    cases key with
    | inl key => fin_cases key <;> simp [store,pushCode,JobPush.store,hp]
    | inr key => cases key <;> simp [store,pushCode,JobPush.store,FrameCopy.store,hc]
  have hfinal : StackCall.frame (pushCode planBank contextBank) (store S) (JobPush.store plan.reverse context.reverse (framed context++plan++S .jobs))=
      store (pushResult plan context S) := by
    apply frame_target _ _ _ _ hinj
    · intro key
      cases key with
      | inl key =>
        cases planBank <;> fin_cases key
        all_goals simp only [planKey] at hp
        all_goals simp [store,pushCode,pushResult,planKey,JobPush.store,hp]
      | inr key =>
        cases contextBank <;> cases key
        all_goals simp only [contextKey] at hc
        all_goals simp [store,pushCode,pushResult,contextKey,JobPush.store,FrameCopy.store,hc]
    · intro bank hno
      cases bank with
      | inl w =>
        have hj : w≠.jobs := fun h => hno (.inr .output) (congrArg Sum.inl h.symm)
        simp [store,pushResult,hj]
      | inr a => rfl
  obtain ⟨ticks,hR,hRC⟩ := JobPush.complete plan context (S .jobs) (getIO v)
  obtain ⟨hN,hNC⟩ := StackCall.execution (pushCode planBank contextBank) (Label.push ret planBank contextBank) (.step ret) getIO putIO
    (StackCall.frame (pushCode planBank contextBank) (store S))
    (fun data key => StackCall.frame_at _ _ data hinj key)
    (fun data key bits => StackCall.frame_update _ _ data hinj key bits)
    (fun _ _ => rfl) (fun _ _ _ => rfl) JobPush.program program (fun _ => rfl) v ticks _ _ hR
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,putIO_get,hsame,hfinal] at hN hNC
  exact ⟨ticks,hN,hNC.trans_le hRC⟩

def contextResult (context : Bits) (S : Work → Bits) : Work → Bits :=
  Function.update S .childContext (framed (binaryValue (S .loopCount)).bits++context).reverse

theorem context_call (context : Bits) (S : Work → Bits) (v : Local)
    (hc : S .context=context.reverse) (he : S .childContext=[]) : ∃ ticks,
    Stacks.stackRun program ticks ⟨some (.context (.counter .emit)),v,store S⟩=
      some ⟨some (.step .repeatContext),putIO v none,store (contextResult context S)⟩ ∧
    Stacks.stackRunClock program ticks ⟨some (.context (.counter .emit)),v,store S⟩≤
      1000000*(1+(S .loopCount).length+context.length)^3 := by
  have hinj := contextCode_injective
  have hsame : StackCall.frame contextCode (store S) (CounterContext.store (S .loopCount) context.reverse [] [] [])=store S := by
    apply StackCall.frame_same _ _ _ hinj
    intro key
    cases key with
    | inl key => fin_cases key <;> simp [store,contextCode,CounterContext.store,hc,he]
    | inr key => cases key <;> rfl
  have hfinal : StackCall.frame contextCode (store S) (CounterContext.store (S .loopCount) context.reverse [] [] (framed (binaryValue (S .loopCount)).bits++context).reverse)=
      store (contextResult context S) := by
    apply frame_target _ _ _ _ hinj
    · intro key
      cases key with
      | inl key => fin_cases key <;> simp [store,contextCode,CounterContext.store,contextResult,hc]
      | inr key => cases key <;> rfl
    · intro bank hno
      cases bank with
      | inl w =>
        have hj : w≠.childContext := fun h => hno (.inl 2) (congrArg Sum.inl h.symm)
        simp [store,contextResult,hj]
      | inr a => rfl
  obtain ⟨ticks,hR,hRC⟩ := CounterContext.complete (S .loopCount) context (getIO v)
  obtain ⟨hN,hNC⟩ := StackCall.execution contextCode Label.context (.step .repeatContext) getIO putIO
    (StackCall.frame contextCode (store S))
    (fun data key => StackCall.frame_at _ _ data hinj key)
    (fun data key bits => StackCall.frame_update _ _ data hinj key bits)
    (fun _ _ => rfl) (fun _ _ _ => rfl) CounterContext.program program (fun _ => rfl) v ticks _ _ hR
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,putIO_get,hsame,hfinal] at hN hNC
  exact ⟨ticks,hN,hNC.trans_le hRC⟩

theorem emitCode_injective : Function.Injective emitCode := by decide

theorem zipCode_injective : Function.Injective zipCode := by decide

theorem takeCode_injective : Function.Injective takeCode := by decide

theorem counterCode_injective : Function.Injective counterCode := by decide

theorem emit_call (n : ℕ) (S : Work → Bits) (v : Local) (hv : S .value=n.bits) :
    Stacks.stackRun program (4*n.bits.length+5) ⟨some (.emit .count),v,store S⟩=
      some ⟨some (.step .finish),putIO v none,store (Function.update S .output ((natBits n).reverse++S .output))⟩ ∧
    Stacks.stackRunClock program (4*n.bits.length+5) ⟨some (.emit .count),v,store S⟩≤
      100*(1+n.bits.length+(S .output).length)^2 := by
  have hinj := emitCode_injective
  have hsame : StackCall.frame emitCode (store S) (Parsing.triple n.bits [] (S .output))=store S := by
    apply StackCall.frame_same _ _ _ hinj
    intro key
    fin_cases key <;> simp [store,emitCode,Parsing.triple,hv]
  have hfinal : StackCall.frame emitCode (store S) (Parsing.triple n.bits [] ((natBits n).reverse++S .output))=
      store (Function.update S .output ((natBits n).reverse++S .output)) := by
    apply frame_target _ _ _ _ hinj
    · intro key
      fin_cases key <;> simp [store,emitCode,Parsing.triple,hv]
    · intro bank hno
      cases bank with
      | inl w =>
        have hw : w≠.output := fun h => hno 2 (congrArg Sum.inl h.symm)
        simp [store,hw]
      | inr a => rfl
  obtain ⟨hR,_⟩ := NatEmit.complete n (S .output) (getIO v)
  obtain ⟨hN,hNC⟩ := StackCall.execution emitCode Label.emit (.step .finish) getIO putIO
    (StackCall.frame emitCode (store S))
    (fun data key => StackCall.frame_at _ _ data hinj key)
    (fun data key bits => StackCall.frame_update _ _ data hinj key bits)
    (fun _ _ => rfl) (fun _ _ _ => rfl) NatEmit.program program (fun _ => rfl) v (4*n.bits.length+5) _ _ hR
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,putIO_get,hsame,hfinal] at hN hNC
  exact ⟨hN,hNC.trans_le (NatEmit.clock_bound n (S .output) (getIO v))⟩

theorem tag_call (n : Fin 8) (S : Work → Bits) (v : Local) (ht : S .tag=n.val.bits.reverse) :
    Stacks.stackRun program (n.val.bits.length+2) ⟨some (.tag .start),v,store S⟩=
      some ⟨some (.step .dispatch),putTag v (n,none),store (Function.update S .tag [])⟩ ∧
    Stacks.stackRunClock program (n.val.bits.length+2) ⟨some (.tag .start),v,store S⟩≤30*(1+n.val.bits.length)^2 := by
  have hinj : Function.Injective tagCode := fun _ _ _ => Subsingleton.elim _ _
  have hsame : StackCall.frame tagCode (store S) (Normalization.singleStack n.val.bits.reverse)=store S := by
    apply StackCall.frame_same _ _ _ hinj
    intro key
    exact ht
  have hfinal : StackCall.frame tagCode (store S) (Normalization.singleStack [])=store (Function.update S .tag []) := by
    have hh :=
        StackCall.frame_update tagCode (store S)
        (Normalization.singleStack n.val.bits.reverse) hinj 0 []
    simpa only [Normalization.singleStack_update,hsame,tagCode,store_update] using hh
  obtain ⟨hR,hRC⟩ := TinyTag.complete n (getTag v)
  obtain ⟨hN,hNC⟩ := StackCall.execution tagCode Label.tag (.step .dispatch) getTag putTag
    (StackCall.frame tagCode (store S))
    (fun data key => StackCall.frame_at _ _ data hinj key)
    (fun data key bits => StackCall.frame_update _ _ data hinj key bits)
    (fun _ _ => rfl) (fun _ _ _ => rfl) TinyTag.program program (fun _ => rfl) v (n.val.bits.length+2) _ _ hR
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,putTag_get,hsame,hfinal] at hN hNC
  exact ⟨hN,hNC.trans_le hRC⟩

def zipResult (S : Work → Bits) : Work → Bits :=
  Function.update (Function.update (Function.update S .firstNormal []) .secondNormal []) .output
    ((PairZip.output (S .firstNormal) (S .secondNormal)).reverse++S .output)

theorem zip_call (S : Work → Bits) (v : Local) : ∃ ticks,
    Stacks.stackRun program ticks ⟨some (.zip .scan),v,store S⟩=
      some ⟨some (.step .finish),putZip v (none,none),store (zipResult S)⟩ ∧
    Stacks.stackRunClock program ticks ⟨some (.zip .scan),v,store S⟩≤
      100*(PairZip.size (S .firstNormal) (S .secondNormal) (S .output))^2 := by
  have hinj := zipCode_injective
  have hsame : StackCall.frame zipCode (store S) (Parsing.triple (S .firstNormal) (S .secondNormal) (S .output))=store S := by
    apply StackCall.frame_same _ _ _ hinj
    intro key
    fin_cases key <;> rfl
  have hfinal : StackCall.frame zipCode (store S) (Parsing.triple [] [] ((PairZip.output (S .firstNormal) (S .secondNormal)).reverse++S .output))=store (zipResult S) := by
    apply frame_target _ _ _ _ hinj
    · intro key
      fin_cases key <;> simp [store,zipCode,Parsing.triple,zipResult]
    · intro bank hno
      cases bank with
      | inl w =>
        have ha : w≠.firstNormal := fun h => hno 0 (congrArg Sum.inl h.symm)
        have hb : w≠.secondNormal := fun h => hno 1 (congrArg Sum.inl h.symm)
        have ho : w≠.output := fun h => hno 2 (congrArg Sum.inl h.symm)
        simp [store,zipResult,ha,hb,ho]
      | inr a => rfl
  obtain ⟨ticks,hR,hRC⟩ :=
      PairZip.complete (S .firstNormal) (S .secondNormal) (S .output) (getZip v)
  obtain ⟨hN,hNC⟩ := StackCall.execution zipCode Label.zip (.step .finish) getZip putZip
    (StackCall.frame zipCode (store S))
    (fun data key => StackCall.frame_at _ _ data hinj key)
    (fun data key bits => StackCall.frame_update _ _ data hinj key bits)
    (fun _ _ => rfl) (fun _ _ _ => rfl) PairZip.program program (fun _ => rfl) v ticks _ _ hR
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,putZip_get,hsame,hfinal] at hN hNC
  exact ⟨ticks,hN,hNC.trans_le hRC⟩

def takeResult (width n : ℕ) (S : Work → Bits) : Work → Bits :=
  Function.update (Function.update (Function.update S .width []) .value (n.bits.drop width)) .output
    ((List.ofFn (fun i : Fin width => n.testBit i.val)).reverse++S .output)

theorem take_call (width n : ℕ) (S : Work → Bits) (v : Local) (hw : S .width=width.bits) (hv : S .value=n.bits) : ∃ ticks,
    Stacks.stackRun program ticks ⟨some (.take (.counter .borrow)),v,store S⟩=
      some ⟨some (.step .finish),putTake v ((false,none),none),store (takeResult width n S)⟩ ∧
    Stacks.stackRunClock program ticks ⟨some (.take (.counter .borrow)),v,store S⟩≤
      150*(width+1)*(1+width.bits.length+n.bits.length+(S .output).length+width)^2 := by
  have hinj := takeCode_injective
  have hsame : StackCall.frame takeCode (store S) (Preparation.quad width.bits [] n.bits (S .output))=store S := by
    apply StackCall.frame_same _ _ _ hinj
    intro key
    fin_cases key <;> simp [store,takeCode,Preparation.quad,hw,hv]
  have hfinal : StackCall.frame takeCode (store S)
      (Preparation.quad [] [] (n.bits.drop width) ((List.ofFn (fun i : Fin width => n.testBit i.val)).reverse++S .output))=store (takeResult width n S) := by
    apply frame_target _ _ _ _ hinj
    · intro key
      fin_cases key <;> simp [store,takeCode,Preparation.quad,takeResult]
    · intro bank hno
      cases bank with
      | inl w =>
        have ha : w≠.width := fun h => hno 0 (congrArg Sum.inl h.symm)
        have hb : w≠.value := fun h => hno 2 (congrArg Sum.inl h.symm)
        have ho : w≠.output := fun h => hno 3 (congrArg Sum.inl h.symm)
        simp [store,takeResult,ha,hb,ho]
      | inr a => rfl
  obtain ⟨ticks,hR,hRC⟩ := CountedTake.fixed_count width n (S .output) (getTake v)
  obtain ⟨hN,hNC⟩ := StackCall.execution takeCode Label.take (.step .finish) getTake putTake
    (StackCall.frame takeCode (store S))
    (fun data key => StackCall.frame_at _ _ data hinj key)
    (fun data key bits => StackCall.frame_update _ _ data hinj key bits)
    (fun _ _ => rfl) (fun _ _ _ => rfl) CountedTake.program program (fun _ => rfl) v ticks _ _ hR
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,putTake_get,hsame,hfinal] at hN hNC
  exact ⟨ticks,hN,hNC.trans_le hRC⟩

theorem counter_frame (S : Work → Bits) (next : Bits) :
    StackCall.frame counterCode (store S) (Stacks.stackPair next [])=store (Function.update S .loopCount next) := by
  have hinj := counterCode_injective
  have hsame : StackCall.frame counterCode (store S) (Stacks.stackPair (S .loopCount) [])=store S := by
    apply StackCall.frame_same _ _ _ hinj
    intro key
    fin_cases key <;> rfl
  have hh :=
      StackCall.frame_update counterCode (store S) (Stacks.stackPair (S .loopCount) []) hinj 0 next
  simpa only [Stacks.stackPair_update_zero,hsame,counterCode,store_update] using hh

theorem counter_positive (S : Work → Bits) (v : Local) (hp : 0<binaryValue (S .loopCount)) :
    ∃ ticks next,next.length=(S .loopCount).length ∧ binaryValue next+1=binaryValue (S .loopCount) ∧
      Stacks.stackRun program ticks ⟨some (.counter .borrow),v,store S⟩=
        some ⟨some (.step .repeatDecide),putCounter v (true,none),store (Function.update S .loopCount next)⟩ ∧
      Stacks.stackRunClock program ticks ⟨some (.counter .borrow),v,store S⟩≤10*(1+(S .loopCount).length)^2 := by
  obtain ⟨ticks,next,_,hlen,hvalue,hR,hRC⟩ :=
      Counter.decrement_positive (S .loopCount) (getCounter v) hp
  obtain ⟨hN,hNC⟩ := StackCall.execution counterCode Label.counter (.step .repeatDecide) getCounter putCounter
    (StackCall.frame counterCode (store S))
    (fun data key => StackCall.frame_at _ _ data counterCode_injective key)
    (fun data key bits => StackCall.frame_update _ _ data counterCode_injective key bits)
    (fun _ _ => rfl) (fun _ _ _ => rfl) Counter.program program (fun _ => rfl) v ticks _ _ hR
  have hsame : store (Function.update S .loopCount (S .loopCount))=store S := by
    rw [Function.update_eq_self]
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,putCounter_get,counter_frame,hsame] at hN hNC
  exact ⟨ticks,next,hlen,hvalue,hN,hNC.trans_le hRC⟩

theorem counter_zero (S : Work → Bits) (v : Local) (hz : binaryValue (S .loopCount)=0) :
    Stacks.stackRun program (2*(S .loopCount).length+2) ⟨some (.counter .borrow),v,store S⟩=
      some ⟨some (.step .repeatDecide),putCounter v (false,none),store (Function.update S .loopCount (List.replicate (S .loopCount).length true))⟩ ∧
    Stacks.stackRunClock program (2*(S .loopCount).length+2) ⟨some (.counter .borrow),v,store S⟩≤10*(1+(S .loopCount).length)^2 := by
  obtain ⟨hR,hRC⟩ := Counter.decrement_zero (S .loopCount) (getCounter v) hz
  obtain ⟨hN,hNC⟩ := StackCall.execution counterCode Label.counter (.step .repeatDecide) getCounter putCounter
    (StackCall.frame counterCode (store S))
    (fun data key => StackCall.frame_at _ _ data counterCode_injective key)
    (fun data key bits => StackCall.frame_update _ _ data counterCode_injective key bits)
    (fun _ _ => rfl) (fun _ _ _ => rfl) Counter.program program (fun _ => rfl) v (2*(S .loopCount).length+2) _ _ hR
  have hsame : store (Function.update S .loopCount (S .loopCount))=store S := by
    rw [Function.update_eq_self]
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,putCounter_get,counter_frame,hsame] at hN hNC
  exact ⟨hN,hNC.trans_le hRC⟩

def ready (jobs params precision out : Bits) : Work → Bits
  | .jobs => jobs | .params => params | .precision => precision | .output => out | _ => []

def erase : List Work → (Work → Bits) → Work → Bits
  | [],S => S
  | bank::banks,S => erase banks (Function.update S bank [])

theorem erase_apply (banks : List Work) (S : Work → Bits) (w : Work) :
    erase banks S w=if w∈banks then [] else S w := by
  induction banks generalizing S with
  | nil => simp [erase]
  | cons bank banks ih =>
    rw [erase,ih]
    by_cases ha : w=bank
    · subst w
      by_cases hb : bank∈banks <;> simp [hb]
    · by_cases hb : w∈banks <;> simp [List.mem_cons,ha,hb]

theorem erase_cleanList (S : Work → Bits) : erase cleanList S=ready (S .jobs) (S .params) (S .precision) (S .output) := by
  funext w
  cases w <;> simp [erase_apply,cleanList,ready]

theorem clean_call (i : ℕ) (hi : i<16) (S : Work → Bits) (v : Local) :
    let bank := cleanList[i]'(by simpa [cleanList] using hi)
    Stacks.stackRun program ((S bank).length+1) ⟨some (.clean ⟨i,by omega⟩ 0),v,store S⟩=
      some ⟨some (.clean ⟨i+1,by omega⟩ 0),putIO v none,store (Function.update S bank [])⟩ ∧
    Stacks.stackRunClock program ((S bank).length+1) ⟨some (.clean ⟨i,by omega⟩ 0),v,store S⟩=
      (S bank).length^2+3*(S bank).length+3 := by
  let bank := cleanList[i]'(by simpa [cleanList] using hi)
  have hinj : Function.Injective (drainCode bank) := fun _ _ _ => Subsingleton.elim _ _
  have hsame : StackCall.frame (drainCode bank) (store S) (Normalization.singleStack (S bank))=store S := by
    apply StackCall.frame_same _ _ _ hinj
    intro key
    rfl
  have hfinal : StackCall.frame (drainCode bank) (store S) (Normalization.singleStack [])=store (Function.update S bank []) := by
    have hh :=
        StackCall.frame_update (drainCode bank) (store S)
        (Normalization.singleStack (S bank)) hinj 0 []
    simpa only [Normalization.singleStack_update,hsame,drainCode,store_update] using hh
  have hR := Normalization.drain_run (S bank) (getIO v)
  obtain ⟨hN,hNC⟩ := StackCall.execution (drainCode bank) (Label.clean ⟨i,by omega⟩) (.clean ⟨i+1,by omega⟩ 0) getIO putIO
    (StackCall.frame (drainCode bank) (store S))
    (fun data key => StackCall.frame_at _ _ data hinj key)
    (fun data key bits => StackCall.frame_update _ _ data hinj key bits)
    (fun _ _ => rfl) (fun _ _ _ => rfl) Normalization.drainProgram program (by intro key; simp [program,hi,bank]) v ((S bank).length+1) _ _ hR
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,putIO_get,hsame,hfinal] at hN hNC
  exact ⟨hN,hNC.trans (Normalization.drain_clock (S bank) (getIO v))⟩

theorem clean_tail (n i : ℕ) (he : i+n=16) (S : Work → Bits) (v : Local) (H : ℕ) (hH : ∀ w,(S w).length≤H) : ∃ ticks last,
    Stacks.stackRun program ticks ⟨some (.clean ⟨i,by omega⟩ 0),v,store S⟩=
      some ⟨some (.step .loop),last,store (erase (cleanList.drop i) S)⟩ ∧
    Stacks.stackRunClock program ticks ⟨some (.clean ⟨i,by omega⟩ 0),v,store S⟩≤(n+1)*10*(1+H)^2 := by
  induction n generalizing i S v with
  | zero =>
    have hi : i=16 := by omega
    subst i
    refine ⟨1,v,?_,?_⟩
    · simp [Stacks.run_one,TM2.step,program,TM2.stepAux,cleanList,erase]
    · change 1≤(0+1)*10*(1+H)^2
      have hh : 1≤(1+H)^2 := Nat.one_le_pow 2 _ (by omega)
      omega
  | succ n ih =>
    have hi : i<16 := by omega
    let bank := cleanList[i]'(by simpa [cleanList] using hi)
    obtain ⟨hC,hCC⟩ := clean_call i hi S v
    let S1 := Function.update S bank []
    have hS1 : ∀ w,(S1 w).length≤H := by
      intro w
      by_cases hw : w=bank
      · subst w; simp [S1]
      · simpa only [S1,Function.update_of_ne hw] using hH w
    obtain ⟨restTicks,last,hR,hRC⟩ := ih (i+1) (by omega) S1 (putIO v none) hS1
    have eC : Stacks.Execution program _ _ _ := ⟨(S bank).length+1,hC,hCC.le⟩
    have eR : Stacks.Execution program _ _ _ := ⟨restTicks,hR,hRC⟩
    obtain ⟨ticks,hr,hc⟩ := eC.trans eR
    have hclean : erase (cleanList.drop i) S=erase (cleanList.drop (i+1)) S1 := by
      rw [List.drop_eq_getElem_cons (show i<cleanList.length by simpa [cleanList] using hi)]
      rfl
    refine ⟨ticks,last,?_,hc.trans ?_⟩
    · simpa only [hclean] using hr
    · have hb := hH bank
      have hb2 := Nat.pow_le_pow_left (show 1+(S bank).length≤1+H by omega) 2
      have hcost : (S bank).length^2+3*(S bank).length+3≤10*(1+H)^2 := by
        nlinarith only [hb2,Nat.zero_le (S bank).length,Nat.zero_le ((S bank).length^2)]
      nlinarith only [hcost]

theorem cleanup (S : Work → Bits) (v : Local) (H : ℕ) (hH : ∀ w,(S w).length≤H) : ∃ ticks last,
    Stacks.stackRun program ticks ⟨some (.clean 0 0),v,store S⟩=
      some ⟨some (.step .loop),last,store (ready (S .jobs) (S .params) (S .precision) (S .output))⟩ ∧
    Stacks.stackRunClock program ticks ⟨some (.clean 0 0),v,store S⟩≤170*(1+H)^2 := by
  simpa only [List.drop_zero,erase_cleanList] using! clean_tail 16 0 rfl S v H hH

theorem phase_step (phase : Phase) (S : Slot → Bits) (v : Local) :
    Stacks.stackRun program 1 ⟨some (.step phase),v,S⟩=some (TM2.stepAux (phaseProgram phase) v S) := rfl

theorem goto_phase (phase : Phase) (after : Label) (hcode : phaseProgram phase=.goto (fun _ => after)) (S : Work → Bits) (v : Local) :
    Stacks.stackRun program 1 ⟨some (.step phase),v,store S⟩=some ⟨some after,v,store S⟩ ∧
    Stacks.stackRunClock program 1 ⟨some (.step phase),v,store S⟩=1 := by
  constructor
  · rw [phase_step,hcode]
    rfl
  · simp [Stacks.stackRunClock,program,hcode,Stacks.stackClock]

theorem loop_peek (S : Work → Bits) (v : Local) :
    Stacks.stackRun program 1 ⟨some (.step .loop),v,store S⟩=
      some ⟨some (if S .jobs=[] then .drain .terminalParams .params 0 else .frame .contextDecoded .context (.read (.read .unary))),
        putIO v (S .jobs).head?,store S⟩ ∧
    Stacks.stackRunClock program 1 ⟨some (.step .loop),v,store S⟩=2*(S .jobs).length+3 := by
  cases he : S .jobs with
  | nil => constructor <;> simp [phase_step,phaseProgram,TM2.stepAux,getIO,putIO,store,he,Stacks.stackRunClock,program,Stacks.stackClock]
  | cons bit bits =>
    constructor <;> simp [phase_step,phaseProgram,TM2.stepAux,getIO,putIO,store,he,Stacks.stackRunClock,program,Stacks.stackClock]
    omega

def planEntry : Fin 7 → Label
  | 0 => .frame .finish .literal (.read (.read .unary))
  | 1 => .read .copyIndex .value (.read .unary)
  | 2 => .scalar .emitValue false (.read .afterTag (.read .unary))
  | 3 => .read .widthRead .width (.read .unary)
  | 4 => .read .pairFirstIndex .value (.read .unary)
  | 5 => .scanStart .appendFirst .eval .first
  | _ => .scalar .repeatBound true (.read .afterTag (.read .unary))

theorem dispatch (tag : Fin 7) (S : Work → Bits) (v : Local) (ht : (getTag v).1=tag.castSucc) :
    Stacks.stackRun program 1 ⟨some (.step .dispatch),v,store S⟩=some ⟨some (planEntry tag),v,store S⟩ ∧
    Stacks.stackRunClock program 1 ⟨some (.step .dispatch),v,store S⟩=1 := by
  fin_cases tag <;> constructor <;>
    simp [phase_step,phaseProgram,planEntry,readField,scalarField,scanField,TM2.stepAux,ht,Stacks.stackRunClock,program,Stacks.stackClock]

theorem repeat_branch (flag : Bool) (S : Work → Bits) (v : Local) (hf : (getCounter v).1=flag) :
    Stacks.stackRun program 1 ⟨some (.step .repeatDecide),v,store S⟩=
      some ⟨some (if flag then .context (.counter .emit) else .step .finish),v,store S⟩ ∧
    Stacks.stackRunClock program 1 ⟨some (.step .repeatDecide),v,store S⟩=1 := by
  cases flag <;> constructor <;> simp
      [phase_step,phaseProgram,TM2.stepAux,hf,Stacks.stackRunClock,program,Stacks.stackClock]

theorem terminal (params precision out : Bits) (v : Local) : ∃ ticks last,
    Stacks.stackRun program ticks ⟨some (.step .loop),v,store (ready [] params precision out)⟩=
      some ⟨none,last,store (ready [] [] [] out)⟩ ∧
    Stacks.stackRunClock program ticks ⟨some (.step .loop),v,store (ready [] params precision out)⟩≤100*(1+params.length+precision.length)^2 := by
  let S0 := ready [] params precision out
  let v0 := putIO v none
  obtain ⟨hL,hLC⟩ := loop_peek S0 v
  change Stacks.stackRun program 1 ⟨some (.step .loop),v,store S0⟩=some ⟨some (.drain .terminalParams .params 0),v0,store S0⟩ at hL
  change _=3 at hLC
  let S1 := Function.update S0 .params []
  obtain ⟨hP,hPC⟩ := drain_call .terminalParams .params S0 v0
  obtain ⟨hG,hGC⟩ := goto_phase .terminalParams (.drain .done .precision 0) rfl S1 (putIO v0 none)
  let S2 := Function.update S1 .precision []
  obtain ⟨hK,hKC⟩ := drain_call .done .precision S1 (putIO v0 none)
  let last := putIO (putIO v0 none) none
  have hH :
      Stacks.stackRun program 1 ⟨some (.step .done),last,store S2⟩=some ⟨none,last,store S2⟩ := rfl
  have hHC : Stacks.stackRunClock program 1 ⟨some (.step .done),last,store S2⟩=1 := rfl
  have eL : Stacks.Execution program _ _ 3 := ⟨1,hL,hLC.le⟩
  have eP : Stacks.Execution program _ _ _ := ⟨params.length+1,hP,hPC.le⟩
  have eG : Stacks.Execution program _ _ 1 := ⟨1,hG,hGC.le⟩
  have eK : Stacks.Execution program _ _ _ := ⟨precision.length+1,hK,hKC.le⟩
  have eH : Stacks.Execution program _ _ 1 := ⟨1,hH,hHC.le⟩
  obtain ⟨ticks,hr,hc⟩ := (((eL.trans eP).trans eG).trans eK).trans eH
  have hS2 : S2=ready [] [] [] out := by funext w; cases w <;> simp [S2,S1,S0,ready]
  refine ⟨ticks,last,?_,hc.trans ?_⟩
  · simpa only [hS2] using hr
  · change 3+(params.length^2+3*params.length+3)+1+(precision.length^2+3*precision.length+3)+1≤_
    nlinarith only [Nat.zero_le (params.length^2),Nat.zero_le (precision.length^2),Nat.zero_le (params.length*precision.length)]

def nodeBits (p : Plan) : Bits := PlanCopy.bodyHead p++(PlanCopy.children p).flatMap planBits

theorem planBits_root (p : Plan) : planBits p=natBits (PlanCopy.planTag p).val++nodeBits p := by
  simp only [PlanCopy.planBits_parts,PlanCopy.headBits,nodeBits,List.append_assoc]

def dispatchState (p : Plan) (cs : List ℕ) (params : List Bits) (k : ℕ) (rest out : Bits) : Work → Bits
  | .jobs => rest | .plan => (planBits p).reverse | .eval => nodeBits p
  | .params => (TableGet.stream params).reverse | .context => (Scheduler.counterStream cs).reverse
  | .precision => k.bits.reverse | .output => out | .discard => (natBits (PlanCopy.planTag p).val).reverse | _ => []

def decodeCost (p : Plan) (context rest : Bits) : ℕ :=
  let q := framed context++(planBits p++rest)
  let tag := (PlanCopy.planTag p).val
  (2*q.length+3)+5000*(context.length+1)*(1+q.length)^2+1+
    (4+30000*(1+(planBits p).length)*(PlanCopy.scanSize (planBits p++rest) [] 1)^2)+1+
    ((planBits p).length*(5*(planBits p).length+12)+7)+1+
    500*(1+(planBits p).length)^2+1+(tag.bits.length*(2*tag.bits.length+5)+3)+1+30*(1+tag.bits.length)^2

theorem decode_job (p : Plan) (cs : List ℕ) (params : List Bits) (k : ℕ) (rest out : Bits) (v : Local) : ∃ ticks last,
    Stacks.stackRun program ticks
      ⟨some (.step .loop),v,store (ready (Scheduler.jobBits ⟨cs,p⟩++rest) (TableGet.stream params).reverse k.bits.reverse out)⟩=
      some ⟨some (.step .dispatch),last,store (dispatchState p cs params k rest out)⟩ ∧
    (getTag last).1=(PlanCopy.planTag p).castSucc ∧
    Stacks.stackRunClock program ticks
      ⟨some (.step .loop),v,store (ready (Scheduler.jobBits ⟨cs,p⟩++rest) (TableGet.stream params).reverse k.bits.reverse out)⟩≤
      decodeCost p (Scheduler.counterStream cs) rest := by
  let context := Scheduler.counterStream cs
  let tag : Fin 8 := (PlanCopy.planTag p).castSucc
  let q := framed context++(planBits p++rest)
  let S0 := ready q (TableGet.stream params).reverse k.bits.reverse out
  let v0 := putIO v q.head?
  have hq : q≠[] := TableGet.framed_nonempty context (planBits p++rest)
  obtain ⟨hL,hLC⟩ := loop_peek S0 v
  simp only [S0,ready,if_neg hq] at hL
  obtain ⟨frameTicks,v1,hF,hFC⟩ :=
      frame_call .contextDecoded .context context (planBits p++rest) S0 v0 rfl
  let S1 := frameResult .context context (planBits p++rest) S0
  obtain ⟨hG1,hG1C⟩ :=
      goto_phase .contextDecoded (.scanStart .planDecoded .jobs .original) rfl S1 v1
  obtain ⟨scanTicks,v2,hS,hSC⟩ := scan_call .planDecoded .jobs .original p rest S1 v1
    (by simp [S1,S0,frameResult,frameReader,frameOutput,readerKey,ready])
    (by simp [S1,S0,frameResult,frameReader,frameOutput,planKey,ready])
    (by simp [S1,S0,frameResult,frameReader,frameOutput,ready])
  let S2 := scanResult .jobs .original p rest S1
  obtain ⟨hG2,hG2C⟩ := goto_phase .planDecoded (.copy .planReady .plan .eval .emit) rfl S2 v2
  obtain ⟨hC,hCC⟩ := copy_call .planReady .plan .eval (by decide) S2 v2
  let S3 := Function.update S2 .eval ((S2 .plan).reverse++S2 .eval)
  let v3 := putIO v2 none
  obtain ⟨hG3,hG3C⟩ := goto_phase .planReady (.read .rootRead .value (.read .unary)) rfl S3 v3
  obtain ⟨readTicks,hR,hRC⟩ := read_call .rootRead .value tag.val (nodeBits p) S3 v3
    (by simp only [S3,Function.update_self]; simp [S2,S1,S0,scanResult,frameResult,frameReader,frameOutput,readerKey,planKey,ready]; exact planBits_root p)
    (by simp [S3,S2,S1,S0,scanResult,frameResult,frameReader,frameOutput,readerKey,planKey,ready,valueKey])
  let S4 := readResult .value tag.val (nodeBits p) S3
  let v4 := putRead v3 ((true,CheckedNat.lastField tag.val.bits none),none)
  obtain ⟨hG4,hG4C⟩ := goto_phase .rootRead (.transfer .rootTag .value .tag 0) rfl S4 v4
  obtain ⟨hT,hTC⟩ := transfer_call .rootTag .value .tag (by decide) S4 v4
  let S5 := Function.update (Function.update S4 .value []) .tag ((S4 .value).reverse++S4 .tag)
  let v5 := putIO v4 none
  obtain ⟨hG5,hG5C⟩ := goto_phase .rootTag (.tag .start) rfl S5 v5
  obtain ⟨hTag,hTagC⟩ :=
      tag_call tag S5 v5
      (by simp [S5,S4,S3,S2,S1,S0,readResult,valueKey,scanResult,frameResult,frameReader,frameOutput,readerKey,planKey,ready])
  let S6 := Function.update S5 .tag []
  let last := putTag v5 (tag,none)
  have eL : Stacks.Execution program _ _ _ := ⟨1,hL,hLC.le⟩
  have eF : Stacks.Execution program _ _ _ := ⟨frameTicks,hF,hFC⟩
  have eG1 : Stacks.Execution program _ _ 1 := ⟨1,hG1,hG1C.le⟩
  have eS : Stacks.Execution program _ _ _ := ⟨scanTicks,hS,hSC⟩
  have eG2 : Stacks.Execution program _ _ 1 := ⟨1,hG2,hG2C.le⟩
  have eC : Stacks.Execution program _ _ _ := ⟨2*(S2 .plan).length+3,hC,hCC.le⟩
  have eG3 : Stacks.Execution program _ _ 1 := ⟨1,hG3,hG3C.le⟩
  have eR : Stacks.Execution program _ _ _ := ⟨readTicks,hR,hRC⟩
  have eG4 : Stacks.Execution program _ _ 1 := ⟨1,hG4,hG4C.le⟩
  have eT : Stacks.Execution program _ _ _ := ⟨(S4 .value).length+1,hT,hTC.le⟩
  have eG5 : Stacks.Execution program _ _ 1 := ⟨1,hG5,hG5C.le⟩
  have eTag : Stacks.Execution program _ _ _ := ⟨tag.val.bits.length+2,hTag,hTagC⟩
  obtain ⟨ticks,hr,hc⟩ :=
      ((((((((((eL.trans eF).trans eG1).trans eS).trans eG2).trans eC).trans eG3).trans eR).trans eG4).trans eT).trans eG5).trans eTag
  have hS6 : S6=dispatchState p cs params k rest out := by
    funext w
    cases w <;> simp
        [S6,S5,S4,S3,S2,S1,S0,readResult,valueKey,scanResult,frameResult,frameReader,frameOutput,readerKey,planKey,ready,dispatchState,context,tag]
  have hS0 : S0=ready (Scheduler.jobBits ⟨cs,p⟩++rest) (TableGet.stream params).reverse k.bits.reverse out := by
    simp only [S0,q,Scheduler.jobBits,context,List.append_assoc]
  refine ⟨ticks,last,?_,rfl,?_⟩
  · change Stacks.stackRun program ticks ⟨some (.step .loop),v,store S0⟩=some ⟨some (.step .dispatch),last,store S6⟩ at hr
    rw [hS0,hS6] at hr
    exact hr
  · have hc0 : Stacks.stackRunClock program ticks ⟨some (.step .loop),v,store S0⟩≤decodeCost p context rest := hc.trans (by
      simp [S4,S3,S2,S1,S0,readResult,valueKey,scanResult,frameResult,frameReader,frameOutput,readerKey,planKey,ready,decodeCost,tag,q])
    simpa only [hS0] using hc0

theorem decodeCost_bound (p : Plan) (context rest : Bits) (B : ℕ) (hQ : 1+(framed context++(planBits p++rest)).length≤B) :
    decodeCost p context rest≤10000000*B^3 := by
  let q := framed context++(planBits p++rest)
  have hB : 1≤B := by omega
  have hB2 : B≤B^2 := Nat.le_pow (by decide)
  have h23 : B^2≤B^3 := Nat.pow_le_pow_right hB (by decide)
  have h13 : 1≤B^3 := Nat.one_le_pow 3 _ hB
  have hctx := TableGet.framed_length_ge context
  have hctx1 : context.length+1≤B := by simp only [List.length_append] at hQ; omega
  have hplan1 : 1+(planBits p).length≤B := by simp only [List.length_append] at hQ; omega
  have hreader : 1+(planBits p++rest).length≤B := by simp only [List.length_append] at hQ ⊢; omega
  have ht := congrArg List.length (planBits_root p)
  simp only [List.length_append,natBits_length] at ht
  have htag1 : 1+(PlanCopy.planTag p).val.bits.length≤B := by omega
  have hscan : PlanCopy.scanSize (planBits p++rest) [] 1≤3*B := by
    dsimp [PlanCopy.scanSize]
    omega
  have hframeCost := Nat.mul_le_mul hctx1 (Nat.pow_le_pow_left hQ 2)
  have hscanCost := Nat.mul_le_mul hplan1 (Nat.pow_le_pow_left hscan 2)
  have hreadCost := Nat.pow_le_pow_left hplan1 2
  have htagCost := Nat.pow_le_pow_left htag1 2
  have hplan : (planBits p).length≤B := by omega
  have htag : (PlanCopy.planTag p).val.bits.length≤B := by omega
  have hplan2 := Nat.mul_le_mul hplan hplan
  have htag2 := Nat.mul_le_mul htag htag
  change (2*q.length+3)+5000*(context.length+1)*(1+q.length)^2+1+
    (4+30000*(1+(planBits p).length)*(PlanCopy.scanSize (planBits p++rest) [] 1)^2)+1+
    ((planBits p).length*(5*(planBits p).length+12)+7)+1+
    500*(1+(planBits p).length)^2+1+
    ((PlanCopy.planTag p).val.bits.length*(2*(PlanCopy.planTag p).val.bits.length+5)+3)+1+
    30*(1+(PlanCopy.planTag p).val.bits.length)^2≤10000000*B^3
  change 1+q.length≤B at hQ
  nlinarith only [hQ,hB2,h23,h13,hframeCost,hscanCost,hreadCost,htagCost,hplan,htag,hplan2,htag2]

def repeatJobs (cs : List ℕ) (body : Plan) (n : ℕ) : List Scheduler.Job :=
  (List.range n).map (fun i => ⟨i::cs,body⟩)
def repeatBits (cs : List ℕ) (body : Plan) (n : ℕ) : Bits :=
    Scheduler.queueBits (repeatJobs cs body n)

theorem repeatBits_zero (cs : List ℕ) (body : Plan) : repeatBits cs body 0=[] := rfl

theorem repeatBits_succ (cs : List ℕ) (body : Plan) (n : ℕ) :
    repeatBits cs body (n+1)=repeatBits cs body n++Scheduler.jobBits ⟨n::cs,body⟩ := by
  simp [repeatBits,repeatJobs,List.range_succ,Scheduler.queueBits]

def repeatSize (cs : List ℕ) (body : Plan) (n : ℕ) (S : Work → Bits) : ℕ :=
  1+(S .loopCount).length+(Scheduler.counterStream cs).length+(planBits body).length+(repeatBits cs body n++S .jobs).length

def repeatResult (cs : List ℕ) (body : Plan) (n : ℕ) (S : Work → Bits) : Work → Bits :=
  Function.update (Function.update S .loopCount (List.replicate (S .loopCount).length true)) .jobs (repeatBits cs body n++S .jobs)

theorem repeat_loop (cs : List ℕ) (body : Plan) (n : ℕ) (S : Work → Bits) (v : Local)
    (hn : binaryValue (S .loopCount)=n) (hp : S .firstPlan=(planBits body).reverse)
    (hc : S .context=(Scheduler.counterStream cs).reverse) (he : S .childContext=[]) : ∃ ticks last,
    Stacks.stackRun program ticks ⟨some (.counter .borrow),v,store S⟩=
      some ⟨some (.step .finish),last,store (repeatResult cs body n S)⟩ ∧
    Stacks.stackRunClock program ticks ⟨some (.counter .borrow),v,store S⟩≤
      10000000*(n+1)*(repeatSize cs body n S)^3 := by
  induction n generalizing S v with
  | zero =>
    obtain ⟨hC,hCC⟩ := counter_zero S v hn
    let S1 := Function.update S .loopCount (List.replicate (S .loopCount).length true)
    obtain ⟨hB,hBC⟩ := repeat_branch false S1 (putCounter v (false,none)) rfl
    have eC : Stacks.Execution program _ _ _ := ⟨2*(S .loopCount).length+2,hC,hCC⟩
    have eB : Stacks.Execution program _ _ 1 := ⟨1,hB,hBC.le⟩
    obtain ⟨ticks,hr,hclock⟩ := eC.trans eB
    have hS1 : S1=repeatResult cs body 0 S := by
      funext w
      by_cases hw : w=.jobs
      · subst w; simp [S1,repeatResult,repeatBits_zero]
      · simp [S1,repeatResult,repeatBits_zero,hw]
    refine ⟨ticks,putCounter v (false,none),?_,hclock.trans ?_⟩
    · simpa only [hS1] using! hr
    · let B := repeatSize cs body 0 S
      have hB : 1≤B := by dsimp [B,repeatSize]; omega
      have h13 : 1≤B^3 := Nat.one_le_pow 3 _ hB
      have h23 : B^2≤B^3 := Nat.pow_le_pow_right hB (by decide)
      have hcounter :=
          Nat.pow_le_pow_left (show 1+(S .loopCount).length≤B by dsimp [B,repeatSize]; omega) 2
      change 10*(1+(S .loopCount).length)^2+1≤10000000*(0+1)*B^3
      nlinarith only [h13,h23,hcounter]
  | succ n ih =>
    obtain ⟨counterTicks,next,hlen,hvalue,hC,hCC⟩ := counter_positive S v (by omega)
    have hnext : binaryValue next=n := by omega
    let S1 := Function.update S .loopCount next
    let v1 := putCounter v (true,none)
    obtain ⟨hB,hBC⟩ := repeat_branch true S1 v1 rfl
    obtain ⟨contextTicks,hX,hXC⟩ := context_call (Scheduler.counterStream cs) S1 v1
      (by simpa only [S1,Function.update_of_ne (show Work.context≠.loopCount by decide)] using hc)
      (by simpa only [S1,Function.update_of_ne (show Work.childContext≠.loopCount by decide)] using he)
    let S2 := contextResult (Scheduler.counterStream cs) S1
    let v2 := putIO v1 none
    obtain ⟨hG1,hG1C⟩ :=
        goto_phase .repeatContext (.push .repeatPushed .first .child (.plan .emit)) rfl S2 v2
    let child := Scheduler.counterStream (n::cs)
    obtain ⟨pushTicks,hP,hPC⟩ := push_call .repeatPushed .first .child (planBits body) child S2 v2
      (by simpa [S2,contextResult,S1,planKey] using hp)
      (by simp [S2,contextResult,S1,contextKey,hnext,child,Scheduler.counterStream,TableGet.stream])
    let S3 := pushResult (planBits body) child S2
    let v3 := putIO v2 none
    obtain ⟨hG2,hG2C⟩ := goto_phase .repeatPushed (.drain .repeatNext .childContext 0) rfl S3 v3
    obtain ⟨hD,hDC⟩ := drain_call .repeatNext .childContext S3 v3
    let S4 := Function.update S3 .childContext []
    let v4 := putIO v3 none
    obtain ⟨hG3,hG3C⟩ := goto_phase .repeatNext (.counter .borrow) rfl S4 v4
    obtain ⟨restTicks,last,hR,hRC⟩ := ih S4 v4
      (by simp [S4,S3,S2,S1,pushResult,contextResult,hnext])
      (by simpa [S4,S3,S2,S1,pushResult,contextResult] using hp)
      (by simpa [S4,S3,S2,S1,pushResult,contextResult] using hc)
      (by simp [S4])
    have eC : Stacks.Execution program _ _ _ := ⟨counterTicks,hC,hCC⟩
    have eB : Stacks.Execution program _ _ 1 := ⟨1,hB,hBC.le⟩
    have eX : Stacks.Execution program _ _ _ := ⟨contextTicks,hX,hXC⟩
    have eG1 : Stacks.Execution program _ _ 1 := ⟨1,hG1,hG1C.le⟩
    have eP : Stacks.Execution program _ _ _ := ⟨pushTicks,hP,hPC⟩
    have eG2 : Stacks.Execution program _ _ 1 := ⟨1,hG2,hG2C.le⟩
    have eD : Stacks.Execution program _ _ _ := ⟨(S3 .childContext).length+1,hD,hDC.le⟩
    have eG3 : Stacks.Execution program _ _ 1 := ⟨1,hG3,hG3C.le⟩
    have eR : Stacks.Execution program _ _ _ := ⟨restTicks,hR,hRC⟩
    obtain ⟨ticks,hr,hclock⟩ :=
        (((((((eC.trans eB).trans eX).trans eG1).trans eP).trans eG2).trans eD).trans eG3).trans eR
    have hS : repeatResult cs body n S4=repeatResult cs body (n+1) S := by
      funext w
      cases w <;> simp
          [repeatResult,S4,S3,S2,S1,pushResult,contextResult,repeatBits_succ,hnext,hlen,hp,hc,he,child,Scheduler.jobBits,Scheduler.counterStream,TableGet.stream,List.append_assoc]
    refine ⟨ticks,last,?_,hclock.trans ?_⟩
    · simpa only [hS] using hr
    · let B := repeatSize cs body (n+1) S
      have hB : 1≤B := by dsimp [B,repeatSize]; omega
      have h13 : 1≤B^3 := Nat.one_le_pow 3 _ hB
      have h23 : B^2≤B^3 := Nat.pow_le_pow_right hB (by decide)
      have hstable : repeatSize cs body n S4=B := by
        simp [B,repeatSize,S4,S3,S2,S1,pushResult,contextResult,hlen,repeatBits_succ,child,Scheduler.jobBits,List.append_assoc]
      have hcounter :=
          Nat.pow_le_pow_left (show 1+(S .loopCount).length≤B by dsimp [B,repeatSize]; omega) 2
      have hcontext : 1+(S1 .loopCount).length+(Scheduler.counterStream cs).length≤B := by
        simp only [S1,Function.update_self,hlen]
        dsimp [B,repeatSize]
        omega
      have hcontext3 := Nat.pow_le_pow_left hcontext 3
      have hchild : child.length+1≤(framed child).length := TableGet.framed_length_ge child
      have hqueue : (framed child++planBits body++S .jobs).length≤(repeatBits cs body (n+1)++S .jobs).length := by
        rw [repeatBits_succ]
        simp only [Scheduler.jobBits,List.length_append]
        change _≤(repeatBits cs body n).length+((framed child).length+(planBits body).length)+(S .jobs).length
        omega
      have hpush : 1+(planBits body).length+child.length+(S2 .jobs).length≤B := by
        simp [S2,S1,contextResult]
        dsimp [B,repeatSize]
        simp only [List.length_append] at hqueue ⊢
        omega
      have hpush3 := Nat.pow_le_pow_left hpush 3
      have hchildLength : (S3 .childContext).length=child.length := by
        simp [S3,S2,S1,pushResult,contextResult,hnext,child,Scheduler.counterStream,TableGet.stream,Nat.add_comm]
      have hchildB : child.length≤B := by omega
      have hchild2 := Nat.mul_le_mul hchildB hchildB
      rw [hstable,hchildLength]
      change _≤10000000*(n+1+1)*B^3
      nlinarith only [h13,h23,hcounter,hcontext3,hpush3,hchildB,hchild2]

theorem scalar_value_bits (params : List Bits) (cs : List ℕ) (k : ℕ) (s : Scalar) :
    (value params k cs s).bits.length≤(scalarBits s).length+(TableGet.stream params).length+(Scheduler.counterStream cs).length+k.bits.length := by
  cases s with
  | literal n =>
    simp only [value,scalarBits,List.length_append,natBits_length]
    omega
  | parameter i =>
    have hn := BinaryNormalize.canonical_length (params.getD i [])
    have hp := TableGet.entry_length params i
    change (binaryValue (params.getD i [])).bits.length≤_
    omega
  | precision =>
    change k.bits.length≤_
    omega
  | counter d =>
    have hh := TableGet.entry_length (cs.map Nat.bits) d
    rw [ReadonlyTableGet.counter_table_value] at hh
    change (cs.getD d 0).bits.length≤_
    change _≤(TableGet.stream (cs.map Nat.bits)).length at hh
    dsimp only [Scheduler.counterStream]
    omega

theorem literal_body (bits : Bits) (S : Work → Bits) (v : Local) (hr : S .eval=framed bits) : ∃ ticks last,
    Stacks.stackRun program ticks ⟨some (.frame .finish .literal (.read (.read .unary))),v,store S⟩=
      some ⟨some (.step .finish),last,store (frameResult .literal bits [] S)⟩ ∧
    Stacks.stackRunClock program ticks ⟨some (.frame .finish .literal (.read (.read .unary))),v,store S⟩≤
      5000*(bits.length+1)*(1+(framed bits).length+(S .output).length)^2 := by
  simpa only [List.append_nil] using!
      frame_call .finish .literal bits [] S v (by simpa only [frameReader,List.append_nil] using hr)

def copyBodyResult (params : List Bits) (i : ℕ) (S : Work → Bits) : Work → Bits :=
  lookupResult .output params (readResult .value i [] S)
def copyBodyCost (params : List Bits) (i : ℕ) (S : Work → Bits) : ℕ :=
  500*(1+(natBits i).length+(S .discard).length)^2+1+
    30000*(1+(TableGet.stream params).length)*(1+(TableGet.stream params).length+i.bits.length+(S .output).length)^2

theorem copy_body (params : List Bits) (i : ℕ) (S : Work → Bits) (v : Local)
    (hr : S .eval=natBits i) (hv : S .value=[]) (hp : S .params=(TableGet.stream params).reverse) : ∃ ticks last,
    Stacks.stackRun program ticks ⟨some (.read .copyIndex .value (.read .unary)),v,store S⟩=
      some ⟨some (.step .finish),last,store (copyBodyResult params i S)⟩ ∧
    Stacks.stackRunClock program ticks ⟨some (.read .copyIndex .value (.read .unary)),v,store S⟩≤copyBodyCost params i S := by
  obtain ⟨readTicks,hR,hRC⟩ :=
      read_call .copyIndex .value i [] S v (by simpa only [List.append_nil] using hr) hv
  let S1 := readResult .value i [] S
  let v1 := putRead v ((true,CheckedNat.lastField i.bits none),none)
  obtain ⟨hG,hGC⟩ := goto_phase .copyIndex (.lookup .finish .output (.copy .emit)) rfl S1 v1
  obtain ⟨getTicks,last,hL,hLC⟩ :=
      lookup_call .finish .output params S1 v1 (by simpa [S1,readResult,valueKey] using hp)
  have eR : Stacks.Execution program _ _ _ := ⟨readTicks,hR,hRC⟩
  have eG : Stacks.Execution program _ _ 1 := ⟨1,hG,hGC.le⟩
  have eL : Stacks.Execution program _ _ _ := ⟨getTicks,hL,hLC⟩
  obtain ⟨ticks,hRun,hClock⟩ := (eR.trans eG).trans eL
  refine ⟨ticks,last,hRun,hClock.trans ?_⟩
  simp [copyBodyCost,S1,readResult,valueKey,outputKey,hr]

def emitBodyResult (s : Scalar) (params : List Bits) (cs : List ℕ) (k : ℕ) (S : Work → Bits) : Work → Bits :=
  Function.update (scalarResult false (value params k cs s) [] S) .output ((natBits (value params k cs s)).reverse++S .output)
def emitBodyCost (s : Scalar) (params : List Bits) (cs : List ℕ) (k : ℕ) (S : Work → Bits) : ℕ :=
  2000000*(ScalarEval.size (scalarBits s) params (cs.map Nat.bits) k [])^3+1+
    100*(1+(value params k cs s).bits.length+(S .output).length)^2

theorem emitNat_body (s : Scalar) (params : List Bits) (cs : List ℕ) (k : ℕ) (S : Work → Bits) (v : Local)
    (hr : S .eval=scalarBits s) (hp : S .params=(TableGet.stream params).reverse)
    (hc : S .context=(Scheduler.counterStream cs).reverse) (hk : S .precision=k.bits.reverse) (hv : S .value=[]) : ∃ ticks last,
    Stacks.stackRun program ticks ⟨some (.scalar .emitValue false (.read .afterTag (.read .unary))),v,store S⟩=
      some ⟨some (.step .finish),last,store (emitBodyResult s params cs k S)⟩ ∧
    Stacks.stackRunClock program ticks ⟨some (.scalar .emitValue false (.read .afterTag (.read .unary))),v,store S⟩≤emitBodyCost s params cs k S := by
  let n := value params k cs s
  obtain ⟨scalarTicks,v1,hS,hSC⟩ := scalar_call .emitValue false s params cs k [] S v
    (by simpa only [List.append_nil] using hr) hp hc hk hv
  let S1 := scalarResult false n [] S
  obtain ⟨hG,hGC⟩ := goto_phase .emitValue (.emit .count) rfl S1 v1
  obtain ⟨hE,hEC⟩ := emit_call n S1 v1 (by simp [S1,scalarResult,scalarValueKey])
  have eS : Stacks.Execution program _ _ _ := ⟨scalarTicks,hS,hSC⟩
  have eG : Stacks.Execution program _ _ 1 := ⟨1,hG,hGC.le⟩
  have eE : Stacks.Execution program _ _ _ := ⟨4*n.bits.length+5,hE,hEC⟩
  obtain ⟨ticks,hRun,hClock⟩ := (eS.trans eG).trans eE
  have hOut : S1 .output=S .output := by simp [S1,scalarResult,scalarValueKey]
  rw [hOut] at hRun
  refine ⟨ticks,putIO v1 none,hRun,hClock.trans ?_⟩
  simp only [emitBodyCost,List.append_nil,hOut,n]
  exact le_rfl

def fixedBodyResult (width : ℕ) (s : Scalar) (params : List Bits) (cs : List ℕ) (k : ℕ) (S : Work → Bits) : Work → Bits :=
  takeResult width (value params k cs s) (scalarResult false (value params k cs s) [] (readResult .width width (scalarBits s) S))
def fixedBodyCost (width : ℕ) (s : Scalar) (params : List Bits) (cs : List ℕ) (k : ℕ) (S : Work → Bits) : ℕ :=
  500*(1+(natBits width++scalarBits s).length+(S .discard).length)^2+1+
    2000000*(ScalarEval.size (scalarBits s) params (cs.map Nat.bits) k [])^3+1+
    150*(width+1)*(1+width.bits.length+(value params k cs s).bits.length+(S .output).length+width)^2

theorem fixedCount_body (width : ℕ) (s : Scalar) (params : List Bits) (cs : List ℕ) (k : ℕ) (S : Work → Bits) (v : Local)
    (hr : S .eval=natBits width++scalarBits s) (hp : S .params=(TableGet.stream params).reverse)
    (hc : S .context=(Scheduler.counterStream cs).reverse) (hk : S .precision=k.bits.reverse) (hv : S .value=[]) (hw : S .width=[]) : ∃ ticks last,
    Stacks.stackRun program ticks ⟨some (.read .widthRead .width (.read .unary)),v,store S⟩=
      some ⟨some (.step .finish),last,store (fixedBodyResult width s params cs k S)⟩ ∧
    Stacks.stackRunClock program ticks ⟨some (.read .widthRead .width (.read .unary)),v,store S⟩≤fixedBodyCost width s params cs k S := by
  let n := value params k cs s
  obtain ⟨readTicks,hR,hRC⟩ := read_call .widthRead .width width (scalarBits s) S v hr hw
  let S1 := readResult .width width (scalarBits s) S
  let v1 := putRead v ((true,CheckedNat.lastField width.bits none),none)
  obtain ⟨hG1,hG1C⟩ :=
      goto_phase .widthRead (.scalar .fixedValue false (.read .afterTag (.read .unary))) rfl S1 v1
  obtain ⟨scalarTicks,v2,hS,hSC⟩ := scalar_call .fixedValue false s params cs k [] S1 v1
    (by simp [S1,readResult,valueKey])
    (by simpa [S1,readResult,valueKey] using hp)
    (by simpa [S1,readResult,valueKey] using! hc)
    (by simpa [S1,readResult,valueKey] using hk)
    (by simpa [S1,readResult,valueKey,scalarValueKey] using hv)
  let S2 := scalarResult false n [] S1
  obtain ⟨hG2,hG2C⟩ := goto_phase .fixedValue (.take (.counter .borrow)) rfl S2 v2
  obtain ⟨takeTicks,hT,hTC⟩ := take_call width n S2 v2
    (by simp [S2,S1,scalarResult,scalarValueKey,readResult,valueKey])
    (by simp [S2,scalarResult,scalarValueKey])
  have eR : Stacks.Execution program _ _ _ := ⟨readTicks,hR,hRC⟩
  have eG1 : Stacks.Execution program _ _ 1 := ⟨1,hG1,hG1C.le⟩
  have eS : Stacks.Execution program _ _ _ := ⟨scalarTicks,hS,hSC⟩
  have eG2 : Stacks.Execution program _ _ 1 := ⟨1,hG2,hG2C.le⟩
  have eT : Stacks.Execution program _ _ _ := ⟨takeTicks,hT,hTC⟩
  obtain ⟨ticks,hRun,hClock⟩ := (((eR.trans eG1).trans eS).trans eG2).trans eT
  refine ⟨ticks,putTake v2 ((false,none),none),hRun,hClock.trans ?_⟩
  simp [fixedBodyCost,S2,S1,scalarResult,scalarValueKey,readResult,valueKey,List.append_nil,hr,n]

def appendBodyResult (a b : Plan) (cs : List ℕ) (S : Work → Bits) : Work → Bits :=
  let S1 := scanResult .eval .first a (planBits b) S
  let S2 := scanResult .eval .second b [] S1
  pushResult (planBits a) (Scheduler.counterStream cs) (pushResult (planBits b) (Scheduler.counterStream cs) S2)
def appendBodyCost (a b : Plan) (cs : List ℕ) (S : Work → Bits) : ℕ :=
  (4+30000*(1+(planBits a).length)*(PlanCopy.scanSize (planBits a++planBits b) [] 1)^2)+1+
    (4+30000*(1+(planBits b).length)*(PlanCopy.scanSize (planBits b) [] 1)^2)+1+
    100000*(1+(planBits b).length+(Scheduler.counterStream cs).length+(S .jobs).length)^3+1+
    100000*(1+(planBits a).length+(Scheduler.counterStream cs).length+
      (framed (Scheduler.counterStream cs)++planBits b++S .jobs).length)^3

theorem append_body (a b : Plan) (cs : List ℕ) (S : Work → Bits) (v : Local)
    (hr : S .eval=planBits a++planBits b) (ha : S .firstPlan=[]) (hb : S .secondPlan=[]) (hpend : S .pending=[])
    (hc : S .context=(Scheduler.counterStream cs).reverse) : ∃ ticks last,
    Stacks.stackRun program ticks ⟨some (.scanStart .appendFirst .eval .first),v,store S⟩=
      some ⟨some (.step .finish),last,store (appendBodyResult a b cs S)⟩ ∧
    Stacks.stackRunClock program ticks ⟨some (.scanStart .appendFirst .eval .first),v,store S⟩≤appendBodyCost a b cs S := by
  obtain ⟨firstTicks,v1,hA,hAC⟩ :=
      scan_call .appendFirst .eval .first a (planBits b) S v hr ha hpend
  let S1 := scanResult .eval .first a (planBits b) S
  obtain ⟨hG1,hG1C⟩ := goto_phase .appendFirst (.scanStart .appendSecond .eval .second) rfl S1 v1
  obtain ⟨secondTicks,v2,hB,hBC⟩ := scan_call .appendSecond .eval .second b [] S1 v1
    (by simp [S1,scanResult,readerKey,planKey])
    (by simpa [S1,scanResult,readerKey,planKey] using hb)
    (by simpa [S1,scanResult,readerKey,planKey] using hpend)
  let S2 := scanResult .eval .second b [] S1
  obtain ⟨hG2,hG2C⟩ :=
      goto_phase .appendSecond (.push .appendRight .second .parent (.plan .emit)) rfl S2 v2
  obtain ⟨rightTicks,hR,hRC⟩ := push_call .appendRight .second .parent (planBits b) (Scheduler.counterStream cs) S2 v2
    (by simp [S2,scanResult,readerKey,planKey])
    (by simpa [S2,S1,scanResult,readerKey,planKey,contextKey] using hc)
  let S3 := pushResult (planBits b) (Scheduler.counterStream cs) S2
  let v3 := putIO v2 none
  obtain ⟨hG3,hG3C⟩ :=
      goto_phase .appendRight (.push .finish .first .parent (.plan .emit)) rfl S3 v3
  obtain ⟨leftTicks,hL,hLC⟩ := push_call .finish .first .parent (planBits a) (Scheduler.counterStream cs) S3 v3
    (by simp [S3,S2,S1,pushResult,scanResult,readerKey,planKey])
    (by simpa [S3,S2,S1,pushResult,scanResult,readerKey,planKey,contextKey] using hc)
  have eA : Stacks.Execution program _ _ _ := ⟨firstTicks,hA,hAC⟩
  have eG1 : Stacks.Execution program _ _ 1 := ⟨1,hG1,hG1C.le⟩
  have eB : Stacks.Execution program _ _ _ := ⟨secondTicks,hB,hBC⟩
  have eG2 : Stacks.Execution program _ _ 1 := ⟨1,hG2,hG2C.le⟩
  have eR : Stacks.Execution program _ _ _ := ⟨rightTicks,hR,hRC⟩
  have eG3 : Stacks.Execution program _ _ 1 := ⟨1,hG3,hG3C.le⟩
  have eL : Stacks.Execution program _ _ _ := ⟨leftTicks,hL,hLC⟩
  obtain ⟨ticks,hRun,hClock⟩ :=
      (((((eA.trans eG1).trans eB).trans eG2).trans eR).trans eG3).trans eL
  refine ⟨ticks,putIO v3 none,hRun,hClock.trans ?_⟩
  simp [appendBodyCost,S3,S2,S1,pushResult,scanResult,readerKey,planKey]

def repeatBodyResult (bound : Scalar) (body : Plan) (params : List Bits) (cs : List ℕ) (k : ℕ) (S : Work → Bits) : Work → Bits :=
  let n := value params k cs bound
  repeatResult cs body n (scanResult .eval .first body [] (scalarResult true n (planBits body) S))
def repeatBodyCost (bound : Scalar) (body : Plan) (params : List Bits) (cs : List ℕ) (k : ℕ) (S : Work → Bits) : ℕ :=
  let n := value params k cs bound
  let S2 := scanResult .eval .first body [] (scalarResult true n (planBits body) S)
  2000000*(ScalarEval.size (scalarBits bound++planBits body) params (cs.map Nat.bits) k [])^3+1+
    (4+30000*(1+(planBits body).length)*(PlanCopy.scanSize (planBits body) [] 1)^2)+1+
    10000000*(n+1)*(repeatSize cs body n S2)^3

theorem repeat_body (bound : Scalar) (body : Plan) (params : List Bits) (cs : List ℕ) (k : ℕ) (S : Work → Bits) (v : Local)
    (hr : S .eval=scalarBits bound++planBits body) (hp : S .params=(TableGet.stream params).reverse)
    (hc : S .context=(Scheduler.counterStream cs).reverse) (hk : S .precision=k.bits.reverse)
    (hcount : S .loopCount=[]) (hbody : S .firstPlan=[]) (hpend : S .pending=[]) (he : S .childContext=[]) : ∃ ticks last,
    Stacks.stackRun program ticks ⟨some (.scalar .repeatBound true (.read .afterTag (.read .unary))),v,store S⟩=
      some ⟨some (.step .finish),last,store (repeatBodyResult bound body params cs k S)⟩ ∧
    Stacks.stackRunClock program ticks ⟨some (.scalar .repeatBound true (.read .afterTag (.read .unary))),v,store S⟩≤
      repeatBodyCost bound body params cs k S := by
  let n := value params k cs bound
  obtain ⟨scalarTicks,v1,hS,hSC⟩ :=
      scalar_call .repeatBound true bound params cs k (planBits body) S v hr hp hc hk hcount
  let S1 := scalarResult true n (planBits body) S
  obtain ⟨hG1,hG1C⟩ := goto_phase .repeatBound (.scanStart .repeatReady .eval .first) rfl S1 v1
  obtain ⟨scanTicks,v2,hB,hBC⟩ := scan_call .repeatReady .eval .first body [] S1 v1
    (by simp [S1,scalarResult,scalarValueKey,readerKey])
    (by simpa [S1,scalarResult,scalarValueKey,planKey] using hbody)
    (by simpa [S1,scalarResult,scalarValueKey] using hpend)
  let S2 := scanResult .eval .first body [] S1
  obtain ⟨hG2,hG2C⟩ := goto_phase .repeatReady (.counter .borrow) rfl S2 v2
  obtain ⟨loopTicks,last,hL,hLC⟩ := repeat_loop cs body n S2 v2
    (by simp [S2,S1,scanResult,readerKey,planKey,scalarResult,scalarValueKey,binaryValue_bits])
    (by simp [S2,scanResult,readerKey,planKey])
    (by simpa [S2,S1,scanResult,readerKey,planKey,scalarResult,scalarValueKey] using hc)
    (by simpa [S2,S1,scanResult,readerKey,planKey,scalarResult,scalarValueKey] using he)
  have eS : Stacks.Execution program _ _ _ := ⟨scalarTicks,hS,hSC⟩
  have eG1 : Stacks.Execution program _ _ 1 := ⟨1,hG1,hG1C.le⟩
  have eB : Stacks.Execution program _ _ _ := ⟨scanTicks,hB,hBC⟩
  have eG2 : Stacks.Execution program _ _ 1 := ⟨1,hG2,hG2C.le⟩
  have eL : Stacks.Execution program _ _ _ := ⟨loopTicks,hL,hLC⟩
  obtain ⟨ticks,hRun,hClock⟩ := (((eS.trans eG1).trans eB).trans eG2).trans eL
  refine ⟨ticks,last,hRun,hClock.trans ?_⟩
  simp only [repeatBodyCost,List.append_nil,n]
  exact le_rfl

end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.EmitterCore

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.EmitterCore
open Turing Qatlib.Concepts.BitWordCompiler.CanonicalCodec

def transferResult (source dest : Work) (S : Work → Bits) : Work → Bits :=
  Function.update (Function.update S source []) dest ((S source).reverse++S dest)

def pairBeforeZip (params : List Bits) (i j : ℕ) (S : Work → Bits) : Work → Bits :=
  let S1 := readResult .value i (natBits j) S
  let S2 := lookupResult .first params S1
  let S3 := readResult .value j [] S2
  let S4 := lookupResult .second params S3
  transferResult .second .secondNormal (transferResult .first .firstNormal S4)
def pairBodyResult (params : List Bits) (i j : ℕ) (S : Work → Bits) : Work → Bits :=
    zipResult (pairBeforeZip params i j S)

def pairBodyCost (params : List Bits) (i j : ℕ) (S : Work → Bits) : ℕ :=
  let A := params.getD i []
  let B := params.getD j []
  let PL := (TableGet.stream params).length
  500*(1+(natBits i++natBits j).length+(S .discard).length)^2+1+
    30000*(1+PL)*(1+PL+i.bits.length)^2+1+
    500*(1+(natBits j).length+((natBits i).reverse++S .discard).length)^2+1+
    30000*(1+PL)*(1+PL+j.bits.length)^2+1+
    (A.length*(2*A.length+5)+3)+1+(B.length*(2*B.length+5)+3)+1+
    100*(PairZip.size A B (S .output))^2

theorem pairScan_body (params : List Bits) (i j : ℕ) (S : Work → Bits) (v : Local)
    (hr : S .eval=natBits i++natBits j) (hp : S .params=(TableGet.stream params).reverse)
    (hv : S .value=[]) (hf : S .first=[]) (hs : S .second=[])
    (hfn : S .firstNormal=[]) (hsn : S .secondNormal=[]) : ∃ ticks last,
    Stacks.stackRun program ticks ⟨some (.read .pairFirstIndex .value (.read .unary)),v,store S⟩=
      some ⟨some (.step .finish),last,store (pairBodyResult params i j S)⟩ ∧
    Stacks.stackRunClock program ticks ⟨some (.read .pairFirstIndex .value (.read .unary)),v,store S⟩≤pairBodyCost params i j S := by
  obtain ⟨readFirstTicks,hR1,hR1C⟩ := read_call .pairFirstIndex .value i (natBits j) S v hr hv
  let S1 := readResult .value i (natBits j) S
  let v1 := putRead v ((true,CheckedNat.lastField i.bits none),none)
  obtain ⟨hG1,hG1C⟩ :=
      goto_phase .pairFirstIndex (.lookup .pairFirstCopied .first (.copy .emit)) rfl S1 v1
  obtain ⟨getFirstTicks,v2,hL1,hL1C⟩ :=
      lookup_call .pairFirstCopied .first params S1 v1 (by simpa [S1,readResult,valueKey] using hp)
  let S2 := lookupResult .first params S1
  obtain ⟨hG2,hG2C⟩ :=
      goto_phase .pairFirstCopied (.read .pairSecondIndex .value (.read .unary)) rfl S2 v2
  obtain ⟨readSecondTicks,hR2,hR2C⟩ := read_call .pairSecondIndex .value j [] S2 v2
    (by simp [S2,S1,lookupResult,readResult,valueKey,outputKey])
    (by simp [S2,lookupResult,outputKey,valueKey])
  let S3 := readResult .value j [] S2
  let v3 := putRead v2 ((true,CheckedNat.lastField j.bits none),none)
  obtain ⟨hG3,hG3C⟩ :=
      goto_phase .pairSecondIndex (.lookup .pairSecondCopied .second (.copy .emit)) rfl S3 v3
  obtain ⟨getSecondTicks,v4,hL2,hL2C⟩ := lookup_call .pairSecondCopied .second params S3 v3
    (by simpa [S3,S2,S1,readResult,lookupResult,valueKey,outputKey] using hp)
  let S4 := lookupResult .second params S3
  obtain ⟨hG4,hG4C⟩ :=
      goto_phase .pairSecondCopied (.transfer .pairFirstNormal .first .firstNormal 0) rfl S4 v4
  obtain ⟨hT1,hT1C⟩ := transfer_call .pairFirstNormal .first .firstNormal (by decide) S4 v4
  let S5 := transferResult .first .firstNormal S4
  let v5 := putIO v4 none
  obtain ⟨hG5,hG5C⟩ :=
      goto_phase .pairFirstNormal (.transfer .pairSecondNormal .second .secondNormal 0) rfl S5 v5
  obtain ⟨hT2,hT2C⟩ := transfer_call .pairSecondNormal .second .secondNormal (by decide) S5 v5
  let S6 := transferResult .second .secondNormal S5
  let v6 := putIO v5 none
  obtain ⟨hG6,hG6C⟩ := goto_phase .pairSecondNormal (.zip .scan) rfl S6 v6
  obtain ⟨zipTicks,hZ,hZC⟩ := zip_call S6 v6
  have eR1 : Stacks.Execution program _ _ _ := ⟨readFirstTicks,hR1,hR1C⟩
  have eG1 : Stacks.Execution program _ _ 1 := ⟨1,hG1,hG1C.le⟩
  have eL1 : Stacks.Execution program _ _ _ := ⟨getFirstTicks,hL1,hL1C⟩
  have eG2 : Stacks.Execution program _ _ 1 := ⟨1,hG2,hG2C.le⟩
  have eR2 : Stacks.Execution program _ _ _ := ⟨readSecondTicks,hR2,hR2C⟩
  have eG3 : Stacks.Execution program _ _ 1 := ⟨1,hG3,hG3C.le⟩
  have eL2 : Stacks.Execution program _ _ _ := ⟨getSecondTicks,hL2,hL2C⟩
  have eG4 : Stacks.Execution program _ _ 1 := ⟨1,hG4,hG4C.le⟩
  have eT1 : Stacks.Execution program _ _ _ := ⟨(S4 .first).length+1,hT1,hT1C.le⟩
  have eG5 : Stacks.Execution program _ _ 1 := ⟨1,hG5,hG5C.le⟩
  have eT2 : Stacks.Execution program _ _ _ := ⟨(S5 .second).length+1,hT2,hT2C.le⟩
  have eG6 : Stacks.Execution program _ _ 1 := ⟨1,hG6,hG6C.le⟩
  have eZ : Stacks.Execution program _ _ _ := ⟨zipTicks,hZ,hZC⟩
  obtain ⟨ticks,hRun,hClock⟩ :=
      (((((((((((eR1.trans eG1).trans eL1).trans eG2).trans eR2).trans eG3).trans eL2).trans eG4).trans eT1).trans eG5).trans eT2).trans eG6).trans eZ
  refine ⟨ticks,putZip v6 (none,none),hRun,hClock.trans ?_⟩
  simp [pairBodyCost,S6,S5,S4,S3,S2,S1,transferResult,lookupResult,readResult,valueKey,outputKey,hr,hf,hs,hfn,hsn,binaryValue_bits]

def nodeResult (p : Plan) (cs : List ℕ) (params : List Bits) (k : ℕ) (rest out : Bits) : Work → Bits :=
  let S := dispatchState p cs params k rest out
  match p with
  | .literal bits => frameResult .literal bits [] S
  | .copy i => copyBodyResult params i S
  | .emitNat s => emitBodyResult s params cs k S
  | .fixedCount width s => fixedBodyResult width s params cs k S
  | .pairScan i j => pairBodyResult params i j S
  | .append a b => appendBodyResult a b cs S
  | .repeat bound body => repeatBodyResult bound body params cs k S

def nodeCost (p : Plan) (cs : List ℕ) (params : List Bits) (k : ℕ) (rest out : Bits) : ℕ :=
  let S := dispatchState p cs params k rest out
  match p with
  | .literal bits => 5000*(bits.length+1)*(1+(framed bits).length+out.length)^2
  | .copy i => copyBodyCost params i S
  | .emitNat s => emitBodyCost s params cs k S
  | .fixedCount width s => fixedBodyCost width s params cs k S
  | .pairScan i j => pairBodyCost params i j S
  | .append a b => appendBodyCost a b cs S
  | .repeat bound body => repeatBodyCost bound body params cs k S

theorem node_body (p : Plan) (cs : List ℕ) (params : List Bits) (k : ℕ) (rest out : Bits) (v : Local) : ∃ ticks last,
    Stacks.stackRun program ticks ⟨some (planEntry (PlanCopy.planTag p)),v,store (dispatchState p cs params k rest out)⟩=
      some ⟨some (.step .finish),last,store (nodeResult p cs params k rest out)⟩ ∧
    Stacks.stackRunClock program ticks ⟨some (planEntry (PlanCopy.planTag p)),v,store (dispatchState p cs params k rest out)⟩≤
      nodeCost p cs params k rest out := by
  cases p with
  | literal bits =>
    exact literal_body bits _ v
        (by simp [dispatchState,nodeBits,PlanCopy.bodyHead,PlanCopy.children])
  | copy i =>
    exact copy_body params i _ v
        (by simp [dispatchState,nodeBits,PlanCopy.bodyHead,PlanCopy.children]) rfl rfl
  | emitNat s =>
    exact emitNat_body s params cs k _ v
        (by simp [dispatchState,nodeBits,PlanCopy.bodyHead,PlanCopy.children]) rfl rfl rfl rfl
  | fixedCount width s =>
    exact fixedCount_body width s params cs k _ v
        (by simp [dispatchState,nodeBits,PlanCopy.bodyHead,PlanCopy.children]) rfl rfl rfl rfl rfl
  | pairScan i j =>
    exact pairScan_body params i j _ v
        (by simp [dispatchState,nodeBits,PlanCopy.bodyHead,PlanCopy.children]) rfl rfl rfl rfl rfl rfl
  | append a b =>
    exact append_body a b cs _ v
        (by simp [dispatchState,nodeBits,PlanCopy.bodyHead,PlanCopy.children]) rfl rfl rfl rfl
  | «repeat» bound body =>
    exact repeat_body bound body params cs k _ v
        (by simp [dispatchState,nodeBits,PlanCopy.bodyHead,PlanCopy.children]) rfl rfl rfl rfl rfl rfl rfl

def Outcome (p : Plan) (cs : List ℕ) (params : List Bits) (k : ℕ) (rest out : Bits) (S : Work → Bits) : Prop :=
  S .jobs=Scheduler.queueBits (Scheduler.stepOne params k ⟨cs,p⟩).2++rest ∧
  S .params=(TableGet.stream params).reverse ∧ S .precision=k.bits.reverse ∧
  S .output=(Scheduler.stepOne params k ⟨cs,p⟩).1.reverse++out

theorem nodeResult_outcome (p : Plan) (cs : List ℕ) (params : List Bits) (k : ℕ) (rest out : Bits) :
    Outcome p cs params k rest out (nodeResult p cs params k rest out) := by
  cases p <;> simp [Outcome,nodeResult,dispatchState,frameResult,frameReader,frameOutput,
    copyBodyResult,lookupResult,outputKey,readResult,valueKey,emitBodyResult,scalarResult,scalarValueKey,
    fixedBodyResult,takeResult,pairBodyResult,pairBeforeZip,zipResult,transferResult,PairZip.output,
    appendBodyResult,scanResult,readerKey,planKey,pushResult,repeatBodyResult,repeatResult,repeatBits,repeatJobs,
    Scheduler.stepOne,Scheduler.queueBits,Scheduler.jobBits,emit,binaryValue_bits,List.append_assoc]

end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.EmitterCore

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.EmitterCore
open Turing Qatlib.Concepts.BitWordCompiler.CanonicalCodec

def spentFields (p : Plan) : Bits :=
  natBits (PlanCopy.planTag p).val++match p with
  | .copy i => natBits i | .fixedCount width _ => natBits width
  | .pairScan i j => natBits i++natBits j | _ => []

theorem spentFields_length (p : Plan) : (spentFields p).length≤(planBits p).length := by
  cases p <;> simp [spentFields,PlanCopy.planTag,planBits,List.length_append]

def normalResult (p : Plan) (cs : List ℕ) (params : List Bits) (k : ℕ) (rest out : Bits) : Work → Bits
  | .jobs => Scheduler.queueBits (Scheduler.stepOne params k ⟨cs,p⟩).2++rest
  | .plan => (planBits p).reverse
  | .params => (TableGet.stream params).reverse
  | .context => (Scheduler.counterStream cs).reverse
  | .precision => k.bits.reverse
  | .output => (Scheduler.stepOne params k ⟨cs,p⟩).1.reverse++out
  | .value => match p with
    | .emitNat s => (value params k cs s).bits
    | .fixedCount width s => (value params k cs s).bits.drop width
    | _ => []
  | .firstPlan => match p with | .append a _ => (planBits a).reverse | .repeat _ body => (planBits body).reverse | _ => []
  | .secondPlan => match p with | .append _ b => (planBits b).reverse | _ => []
  | .loopCount => match p with | .repeat bound _ => List.replicate (value params k cs bound).bits.length true | _ => []
  | .discard => (spentFields p).reverse
  | _ => []

theorem nodeResult_eq (p : Plan) (cs : List ℕ) (params : List Bits) (k : ℕ) (rest out : Bits) :
    nodeResult p cs params k rest out=normalResult p cs params k rest out := by
  obtain ⟨hJ,hP,hK,hO⟩ := nodeResult_outcome p cs params k rest out
  funext w
  cases w
  all_goals first | exact hJ | exact hP | exact hK | exact hO | skip
  all_goals cases p <;> simp [normalResult,nodeResult,dispatchState,frameResult,frameReader,frameOutput,
    copyBodyResult,lookupResult,outputKey,readResult,valueKey,emitBodyResult,scalarResult,scalarValueKey,
    fixedBodyResult,takeResult,pairBodyResult,pairBeforeZip,zipResult,transferResult,
    appendBodyResult,scanResult,readerKey,planKey,pushResult,repeatBodyResult,repeatResult,
    spentFields,PlanCopy.planTag,binaryValue_bits,List.reverse_append,List.append_assoc]

structure NodeBounds (p : Plan) (cs : List ℕ) (params : List Bits) (k : ℕ) (rest out : Bits) (B : ℕ) : Prop where
  positive : 1≤B
  code : (planBits p).length≤B
  parameters : (TableGet.stream params).length≤B
  precision : k.bits.length≤B
  context : (Scheduler.counterStream cs).length≤4*B^2
  queue : rest.length≤14*B^3
  children : (Scheduler.queueBits (Scheduler.stepOne params k ⟨cs,p⟩).2++rest).length≤14*B^3
  output : (Scheduler.stepOne params k ⟨cs,p⟩).1.length+out.length≤B
  work : work params k cs p≤B

theorem nodeResult_height (p : Plan) (cs : List ℕ) (params : List Bits) (k : ℕ) (rest out : Bits) (B : ℕ)
    (h : NodeBounds p cs params k rest out B) : ∀ w,(nodeResult p cs params k rest out w).length≤20*B^3 := by
  rw [nodeResult_eq]
  have hB2 : B≤B^2 := Nat.le_pow (by decide)
  have hB3 : B≤B^3 := Nat.le_pow (by decide)
  have h23 : B^2≤B^3 := Nat.pow_le_pow_right h.positive (by decide)
  have hBH : B≤20*B^3 := by omega
  have hSyntax := h.code
  have hParameters := h.parameters
  have hPrecision := h.precision
  have hContext := h.context
  have hScalar (s : Scalar) (hs : (scalarBits s).length≤B) : (value params k cs s).bits.length≤7*B^2 := by
    have hv := scalar_value_bits params cs k s
    nlinarith only [hv,hs,hParameters,hPrecision,hContext,hB2]
  intro w
  cases w with
  | jobs => exact h.children.trans (by omega)
  | plan => simpa only [normalResult,List.length_reverse] using hSyntax.trans hBH
  | params => simpa only [normalResult,List.length_reverse] using hParameters.trans hBH
  | precision => simpa only [normalResult,List.length_reverse] using hPrecision.trans hBH
  | context =>
    change (Scheduler.counterStream cs).reverse.length≤_
    rw [List.length_reverse]
    nlinarith only [hContext,h23]
  | output => simpa only [normalResult,List.length_append,List.length_reverse] using h.output.trans hBH
  | discard =>
    change (spentFields p).reverse.length≤_
    rw [List.length_reverse]
    exact (spentFields_length p).trans (hSyntax.trans hBH)
  | firstPlan =>
    cases p <;> simp only [normalResult,List.length_reverse,List.length_nil]
    all_goals simp only [planBits,List.length_append] at hSyntax
    all_goals omega
  | secondPlan =>
    cases p <;> simp only [normalResult,List.length_reverse,List.length_nil]
    all_goals simp only [planBits,List.length_append] at hSyntax
    all_goals omega
  | value =>
    cases p with
    | emitNat s =>
      have hs : (scalarBits s).length≤B := by
        simp only [planBits,List.length_append] at hSyntax; omega
      have hv := hScalar s hs
      change (value params k cs s).bits.length≤_
      nlinarith only [hv,h23]
    | fixedCount width s =>
      have hs : (scalarBits s).length≤B := by
        simp only [planBits,List.length_append] at hSyntax; omega
      have hv := hScalar s hs
      change ((value params k cs s).bits.drop width).length≤_
      rw [List.length_drop]
      have hd := Nat.sub_le (value params k cs s).bits.length width
      nlinarith only [hv,hd,h23]
    | literal bits => simp [normalResult]
    | copy i => simp [normalResult]
    | pairScan i j => simp [normalResult]
    | append a b => simp [normalResult]
    | «repeat» bound body => simp [normalResult]
  | loopCount =>
    cases p with
    | «repeat» bound body =>
      have hn := Scheduler.child_count_le_work params k ⟨cs,.repeat bound body⟩
      simp only [Scheduler.stepOne,List.length_map,List.length_range] at hn
      have hw := h.work
      have hb := Counter.bits_length_le (value params k cs bound)
      simp only [normalResult,List.length_replicate]
      omega
    | literal bits => simp [normalResult]
    | copy i => simp [normalResult]
    | emitNat s => simp [normalResult]
    | fixedCount width s => simp [normalResult]
    | pairScan i j => simp [normalResult]
    | append a b => simp [normalResult]
  | eval | width | first | second | firstNormal | secondNormal | childContext | tag | pending => simp [normalResult]

theorem root_length (p : Plan) : (natBits (PlanCopy.planTag p).val).length≤(planBits p).length := by
  have hh := congrArg List.length (planBits_root p)
  simp only [List.length_append] at hh
  omega

theorem NodeBounds.root {p : Plan} {cs : List ℕ} {params : List Bits} {k : ℕ} {rest out : Bits} {B : ℕ}
    (h : NodeBounds p cs params k rest out B) : (natBits (PlanCopy.planTag p).val).length≤B := (root_length p).trans h.code

theorem NodeBounds.scalarSize {p : Plan} {cs : List ℕ} {params : List Bits} {k : ℕ} {rest out : Bits} {B : ℕ}
    (h : NodeBounds p cs params k rest out B) (reader : Bits) (hr : reader.length≤B) :
    ScalarEval.size reader params (cs.map Nat.bits) k []≤8*B^2 := by
  have hB2 : B≤B^2 := Nat.le_pow (by decide)
  have h12 : 1≤B^2 := h.positive.trans hB2
  have hp := h.parameters
  have hc := h.context
  have hk := h.precision
  change 1+reader.length+(TableGet.stream params).length+(Scheduler.counterStream cs).length+k.bits.length≤_
  nlinarith only [hr,hp,hc,hk,hB2,h12]

theorem NodeBounds.valueSize {p : Plan} {cs : List ℕ} {params : List Bits} {k : ℕ} {rest out : Bits} {B : ℕ}
    (h : NodeBounds p cs params k rest out B) (s : Scalar) (hs : (scalarBits s).length≤B) :
    (value params k cs s).bits.length≤7*B^2 := by
  have hh := scalar_value_bits params cs k s
  have hB2 : B≤B^2 := Nat.le_pow (by decide)
  have hp := h.parameters
  have hc := h.context
  have hk := h.precision
  nlinarith only [hh,hs,hp,hc,hk,hB2]

theorem scanSize_bound (reader : Bits) (B : ℕ) (hB : 1≤B) (hr : reader.length≤B) :
    PlanCopy.scanSize reader [] 1≤6*B := by dsimp [PlanCopy.scanSize]; omega

theorem cost_literal (bits : Bits) (cs : List ℕ) (params : List Bits) (k : ℕ) (rest out : Bits) (B : ℕ)
    (h : NodeBounds (.literal bits) cs params k rest out B) :
    nodeCost (.literal bits) cs params k rest out≤1000000000000000*B^11 := by
  have hcode := h.code
  have hout := h.output
  have hwork := h.work
  have h3 : B^3≤B^11 := Nat.pow_le_pow_right h.positive (by decide)
  have hb : bits.length+1≤2*B := by change bits.length+1≤B at hwork; omega
  have hf : (framed bits).length≤B := by simp only [planBits,List.length_append] at hcode; omega
  have ho : out.length≤B := by omega
  have hg : 1+(framed bits).length+out.length≤3*B := by have := h.positive; omega
  have hm := Nat.mul_le_mul hb (Nat.pow_le_pow_left hg 2)
  change 5000*(bits.length+1)*(1+(framed bits).length+out.length)^2≤_
  nlinarith only [hm,h3]

theorem cost_copy (i : ℕ) (cs : List ℕ) (params : List Bits) (k : ℕ) (rest out : Bits) (B : ℕ)
    (h : NodeBounds (.copy i) cs params k rest out B) :
    nodeCost (.copy i) cs params k rest out≤1000000000000000*B^11 := by
  have hcode := h.code
  have hroot := h.root
  have hp := h.parameters
  have hout := h.output
  have hB := h.positive
  have h2 : B^2≤B^11 := Nat.pow_le_pow_right hB (by decide)
  have h3 : B^3≤B^11 := Nat.pow_le_pow_right hB (by decide)
  have h1 : 1≤B^11 := Nat.one_le_pow 11 _ hB
  have hi : (natBits i).length≤B := by simp only [planBits,List.length_append] at hcode; omega
  have hib : i.bits.length≤B := by have hh := natBits_length i; omega
  have ho : out.length≤B := by omega
  have hread : 1+(natBits i).length+(natBits (PlanCopy.planTag (.copy i)).val).length≤3*B := by
    omega
  have hget1 : 1+(TableGet.stream params).length≤2*B := by omega
  have hget2 : 1+(TableGet.stream params).length+i.bits.length+out.length≤4*B := by omega
  have hr2 := Nat.pow_le_pow_left hread 2
  have hg := Nat.mul_le_mul hget1 (Nat.pow_le_pow_left hget2 2)
  simp only [nodeCost,copyBodyCost,dispatchState,List.length_reverse]
  nlinarith only [h2,h3,h1,hr2,hg]

theorem cost_emitNat (s : Scalar) (cs : List ℕ) (params : List Bits) (k : ℕ) (rest out : Bits) (B : ℕ)
    (h : NodeBounds (.emitNat s) cs params k rest out B) :
    nodeCost (.emitNat s) cs params k rest out≤1000000000000000*B^11 := by
  have hcode := h.code
  have hB := h.positive
  have hB2 : B≤B^2 := Nat.le_pow (by decide)
  have h12 : 1≤B^2 := hB.trans hB2
  have h4 : B^4≤B^11 := Nat.pow_le_pow_right hB (by decide)
  have h6 : B^6≤B^11 := Nat.pow_le_pow_right hB (by decide)
  have h1 : 1≤B^11 := Nat.one_le_pow 11 _ hB
  have hs : (scalarBits s).length≤B := by simp only [planBits,List.length_append] at hcode; omega
  have hv := h.valueSize s hs
  have hsize := h.scalarSize (scalarBits s) hs
  have hout := h.output
  have ho : out.length≤B := by omega
  have hg : 1+(value params k cs s).bits.length+out.length≤9*B^2 := by
    nlinarith only [hv,ho,hB2,h12]
  have hc := Nat.pow_le_pow_left hsize 3
  have he := Nat.pow_le_pow_left hg 2
  simp only [nodeCost,emitBodyCost,dispatchState]
  nlinarith only [h4,h6,h1,hc,he]

theorem cost_fixedCount (width : ℕ) (s : Scalar) (cs : List ℕ) (params : List Bits) (k : ℕ) (rest out : Bits) (B : ℕ)
    (h : NodeBounds (.fixedCount width s) cs params k rest out B) :
    nodeCost (.fixedCount width s) cs params k rest out≤1000000000000000*B^11 := by
  have hcode := h.code
  have hroot := h.root
  have hB := h.positive
  have hB2 : B≤B^2 := Nat.le_pow (by decide)
  have h12 : 1≤B^2 := hB.trans hB2
  have h2 : B^2≤B^11 := Nat.pow_le_pow_right hB (by decide)
  have h5 : B^5≤B^11 := Nat.pow_le_pow_right hB (by decide)
  have h6 : B^6≤B^11 := Nat.pow_le_pow_right hB (by decide)
  have h1 : 1≤B^11 := Nat.one_le_pow 11 _ hB
  have hs : (scalarBits s).length≤B := by simp only [planBits,List.length_append] at hcode; omega
  have hi : (natBits width++scalarBits s).length≤B := by
    simp only [planBits,List.length_append] at hcode ⊢; omega
  have hwcode : (natBits width).length≤B := by simp only [List.length_append] at hi; omega
  have hwbits : width.bits.length≤B := by have hh := natBits_length width; omega
  have hww := h.work
  change width+1≤B at hww
  have hout := h.output
  have ho : out.length≤B := by omega
  have hv := h.valueSize s hs
  have hsize := h.scalarSize (scalarBits s) hs
  have hread :
      1+(natBits width++scalarBits s).length+(natBits (PlanCopy.planTag (.fixedCount width s)).val).length≤3*B := by omega
  have hcount1 : width+1≤2*B := by omega
  have hcount2 : 1+width.bits.length+(value params k cs s).bits.length+out.length+width≤11*B^2 := by
    nlinarith only [hwbits,hv,ho,hww,hB2,h12]
  have hr2 := Nat.pow_le_pow_left hread 2
  have hs3 := Nat.pow_le_pow_left hsize 3
  have hc := Nat.mul_le_mul hcount1 (Nat.pow_le_pow_left hcount2 2)
  simp only [nodeCost,fixedBodyCost,dispatchState,List.length_reverse]
  nlinarith only [h2,h5,h6,h1,hr2,hs3,hc]

theorem cost_pairScan (i j : ℕ) (cs : List ℕ) (params : List Bits) (k : ℕ) (rest out : Bits) (B : ℕ)
    (h : NodeBounds (.pairScan i j) cs params k rest out B) :
    nodeCost (.pairScan i j) cs params k rest out≤1000000000000000*B^11 := by
  have hcode := h.code
  have hroot := h.root
  have hB := h.positive
  have hB2 : B≤B^2 := Nat.le_pow (by decide)
  have h2 : B^2≤B^11 := Nat.pow_le_pow_right hB (by decide)
  have h3 : B^3≤B^11 := Nat.pow_le_pow_right hB (by decide)
  have h1 : 1≤B^11 := Nat.one_le_pow 11 _ hB
  have hi : (natBits i).length≤B := by simp only [planBits,List.length_append] at hcode; omega
  have hj : (natBits j).length≤B := by simp only [planBits,List.length_append] at hcode; omega
  have hib : i.bits.length≤B := by have hh := natBits_length i; omega
  have hjb : j.bits.length≤B := by have hh := natBits_length j; omega
  have hp := h.parameters
  have ha := (TableGet.entry_length params i).trans hp
  have hb := (TableGet.entry_length params j).trans hp
  have hout := h.output
  have ho : out.length≤B := by omega
  have hr1 : 1+(natBits i++natBits j).length+(natBits (PlanCopy.planTag (.pairScan i j)).val).length≤4*B := by
    simp only [List.length_append]
    omega
  have hr2 :
      1+(natBits j).length+(natBits i).length+(natBits (PlanCopy.planTag (.pairScan i j)).val).length≤4*B := by omega
  have hg1 : 1+(TableGet.stream params).length≤2*B := by omega
  have hgi : 1+(TableGet.stream params).length+i.bits.length≤3*B := by omega
  have hgj : 1+(TableGet.stream params).length+j.bits.length≤3*B := by omega
  have hz : PairZip.size (params.getD i []) (params.getD j []) out≤6*B := by
    dsimp [PairZip.size]; omega
  have hri := Nat.pow_le_pow_left hr1 2
  have hrj := Nat.pow_le_pow_left hr2 2
  have hgeti := Nat.mul_le_mul hg1 (Nat.pow_le_pow_left hgi 2)
  have hgetj := Nat.mul_le_mul hg1 (Nat.pow_le_pow_left hgj 2)
  have hzip := Nat.pow_le_pow_left hz 2
  have ha2 := Nat.mul_le_mul ha ha
  have hb2 := Nat.mul_le_mul hb hb
  simp only [nodeCost,pairBodyCost,dispatchState,List.length_reverse,List.length_append]
  simp only [List.length_append] at hri
  nlinarith only [hB2,h2,h3,h1,hri,hrj,hgeti,hgetj,hzip,ha,hb,ha2,hb2]

theorem cost_append (a b : Plan) (cs : List ℕ) (params : List Bits) (k : ℕ) (rest out : Bits) (B : ℕ)
    (h : NodeBounds (.append a b) cs params k rest out B) :
    nodeCost (.append a b) cs params k rest out≤1000000000000000*B^11 := by
  have hcode := h.code
  have hB := h.positive
  have hB2 : B≤B^2 := Nat.le_pow (by decide)
  have hB3 : B≤B^3 := Nat.le_pow (by decide)
  have h23 : B^2≤B^3 := Nat.pow_le_pow_right hB (by decide)
  have h13 : 1≤B^3 := hB.trans hB3
  have h3 : B^3≤B^11 := Nat.pow_le_pow_right hB (by decide)
  have h9 : B^9≤B^11 := Nat.pow_le_pow_right hB (by decide)
  have h1 : 1≤B^11 := Nat.one_le_pow 11 _ hB
  have hab : (planBits a++planBits b).length≤B := by
    simp only [planBits,List.length_append] at hcode ⊢; omega
  have ha : (planBits a).length≤B := by simp only [List.length_append] at hab; omega
  have hb : (planBits b).length≤B := by simp only [List.length_append] at hab; omega
  have hsa := scanSize_bound (planBits a++planBits b) B hB hab
  have hsb := scanSize_bound (planBits b) B hB hb
  have has : 1+(planBits a).length≤2*B := by omega
  have hbs : 1+(planBits b).length≤2*B := by omega
  have hsca := Nat.mul_le_mul has (Nat.pow_le_pow_left hsa 2)
  have hscb := Nat.mul_le_mul hbs (Nat.pow_le_pow_left hsb 2)
  have hc := h.context
  have hq := h.queue
  have hnew := h.children
  have hright : (framed (Scheduler.counterStream cs)++planBits b++rest).length≤14*B^3 := by
    simp only [Scheduler.stepOne,Scheduler.queueBits,List.flatMap_cons,List.flatMap_nil,List.append_nil,
      Scheduler.jobBits,List.length_append] at hnew ⊢
    omega
  have hpr : 1+(planBits b).length+(Scheduler.counterStream cs).length+rest.length≤20*B^3 := by
    nlinarith only [hb,hc,hq,hB3,h23,h13]
  have hpl : 1+(planBits a).length+(Scheduler.counterStream cs).length+
      (framed (Scheduler.counterStream cs)++planBits b++rest).length≤20*B^3 := by
    nlinarith only [ha,hc,hright,hB3,h23,h13]
  have hpushR := Nat.pow_le_pow_left hpr 3
  have hpushL := Nat.pow_le_pow_left hpl 3
  simp only [nodeCost,appendBodyCost,dispatchState]
  nlinarith only [h3,h9,h1,hsca,hscb,hpushR,hpushL]

theorem cost_repeat (bound : Scalar) (body : Plan) (cs : List ℕ) (params : List Bits) (k : ℕ) (rest out : Bits) (B : ℕ)
    (h : NodeBounds (.repeat bound body) cs params k rest out B) :
    nodeCost (.repeat bound body) cs params k rest out≤1000000000000000*B^11 := by
  let n := value params k cs bound
  have hcode := h.code
  have hB := h.positive
  have hB3 : B≤B^3 := Nat.le_pow (by decide)
  have h23 : B^2≤B^3 := Nat.pow_le_pow_right hB (by decide)
  have h13 : 1≤B^3 := hB.trans hB3
  have h3 : B^3≤B^11 := Nat.pow_le_pow_right hB (by decide)
  have h6 : B^6≤B^11 := Nat.pow_le_pow_right hB (by decide)
  have h10 : B^10≤B^11 := Nat.pow_le_pow_right hB (by decide)
  have h1 : 1≤B^11 := Nat.one_le_pow 11 _ hB
  have hreader : (scalarBits bound++planBits body).length≤B := by
    simp only [planBits,List.length_append] at hcode ⊢; omega
  have hbody : (planBits body).length≤B := by simp only [List.length_append] at hreader; omega
  have hsize := h.scalarSize (scalarBits bound++planBits body) hreader
  have hscalar := Nat.pow_le_pow_left hsize 3
  have hscan := scanSize_bound (planBits body) B hB hbody
  have hbody1 : 1+(planBits body).length≤2*B := by omega
  have hsc := Nat.mul_le_mul hbody1 (Nat.pow_le_pow_left hscan 2)
  have hn := Scheduler.child_count_le_work params k ⟨cs,.repeat bound body⟩
  simp only [Scheduler.stepOne,List.length_map,List.length_range] at hn
  have hw := h.work
  have hnB : n≤B := by omega
  have hnBits : n.bits.length≤B := (Counter.bits_length_le n).trans hnB
  have hc := h.context
  have hq := h.children
  have hqueue : (repeatBits cs body n++rest).length≤14*B^3 := by
    simpa only [repeatBits,repeatJobs,Scheduler.stepOne,n] using hq
  have hloop : repeatSize cs body n
      (scanResult .eval .first body [] (scalarResult true n (planBits body) (dispatchState (.repeat bound body) cs params k rest out)))≤25*B^3 := by
    simp [repeatSize,scanResult,scalarResult,scalarValueKey,readerKey,planKey,dispatchState]
    simp only [List.length_append] at hqueue
    nlinarith only [hnBits,hc,hbody,hqueue,hB3,h23,h13]
  have hn1 : n+1≤2*B := by omega
  have hl := Nat.mul_le_mul hn1 (Nat.pow_le_pow_left hloop 3)
  simp only [nodeCost,repeatBodyCost]
  change _≤1000000000000000*B^11
  nlinarith only [h3,h6,h10,h1,hscalar,hsc,hl]

theorem nodeCost_bound (p : Plan) (cs : List ℕ) (params : List Bits) (k : ℕ) (rest out : Bits) (B : ℕ)
    (h : NodeBounds p cs params k rest out B) : nodeCost p cs params k rest out≤1000000000000000*B^11 := by
  cases p with
  | literal bits => exact cost_literal bits cs params k rest out B h
  | copy i => exact cost_copy i cs params k rest out B h
  | emitNat s => exact cost_emitNat s cs params k rest out B h
  | fixedCount width s => exact cost_fixedCount width s cs params k rest out B h
  | pairScan i j => exact cost_pairScan i j cs params k rest out B h
  | append a b => exact cost_append a b cs params k rest out B h
  | «repeat» bound body => exact cost_repeat bound body cs params k rest out B h

theorem job_step (p : Plan) (cs : List ℕ) (params : List Bits) (k : ℕ) (rest out : Bits) (v : Local) (B : ℕ)
    (h : NodeBounds p cs params k rest out B) : ∃ ticks last,
    Stacks.stackRun program ticks
      ⟨some (.step .loop),v,store (ready (Scheduler.jobBits ⟨cs,p⟩++rest) (TableGet.stream params).reverse k.bits.reverse out)⟩=
      some ⟨some (.step .loop),last,store (ready
        (Scheduler.queueBits (Scheduler.stepOne params k ⟨cs,p⟩).2++rest) (TableGet.stream params).reverse k.bits.reverse
        ((Scheduler.stepOne params k ⟨cs,p⟩).1.reverse++out))⟩ ∧
    Stacks.stackRunClock program ticks
      ⟨some (.step .loop),v,store (ready (Scheduler.jobBits ⟨cs,p⟩++rest) (TableGet.stream params).reverse k.bits.reverse out)⟩≤
      2000000000000000*B^11 := by
  obtain ⟨decodeTicks,v1,hD,htag,hDC⟩ := decode_job p cs params k rest out v
  let S1 := dispatchState p cs params k rest out
  obtain ⟨hP,hPC⟩ := dispatch (PlanCopy.planTag p) S1 v1 htag
  obtain ⟨nodeTicks,v2,hN,hNC⟩ := node_body p cs params k rest out v1
  let S2 := nodeResult p cs params k rest out
  obtain ⟨hG,hGC⟩ := goto_phase .finish (.clean 0 0) rfl S2 v2
  obtain ⟨cleanTicks,last,hC,hCC⟩ :=
      cleanup S2 v2 (20*B^3) (nodeResult_height p cs params k rest out B h)
  obtain ⟨hJ,hParams,hK,hO⟩ := nodeResult_outcome p cs params k rest out
  change S2 .jobs=_ at hJ
  change S2 .params=_ at hParams
  change S2 .precision=_ at hK
  change S2 .output=_ at hO
  rw [hJ,hParams,hK,hO] at hC
  have eD : Stacks.Execution program _ _ _ := ⟨decodeTicks,hD,hDC⟩
  have eP : Stacks.Execution program _ _ 1 := ⟨1,hP,hPC.le⟩
  have eN : Stacks.Execution program _ _ _ := ⟨nodeTicks,hN,hNC⟩
  have eG : Stacks.Execution program _ _ 1 := ⟨1,hG,hGC.le⟩
  have eC : Stacks.Execution program _ _ _ := ⟨cleanTicks,hC,hCC⟩
  obtain ⟨ticks,hr,hc⟩ := (((eD.trans eP).trans eN).trans eG).trans eC
  refine ⟨ticks,last,hr,hc.trans ?_⟩
  have hB := h.positive
  have hB2 : B≤B^2 := Nat.le_pow (by decide)
  have hB3 : B≤B^3 := Nat.le_pow (by decide)
  have h23 : B^2≤B^3 := Nat.pow_le_pow_right hB (by decide)
  have h12 : 1≤B^2 := hB.trans hB2
  have h13 : 1≤B^3 := hB.trans hB3
  have h6 : B^6≤B^11 := Nat.pow_le_pow_right hB (by decide)
  have h9 : B^9≤B^11 := Nat.pow_le_pow_right hB (by decide)
  have h1 : 1≤B^11 := Nat.one_le_pow 11 _ hB
  have hCode := h.code
  have hContext := h.context
  have hRest := h.queue
  have hFrame := Scheduler.framed_length_bound (Scheduler.counterStream cs)
  have hJob : (Scheduler.jobBits ⟨cs,p⟩).length≤14*B^2 := by
    simp only [Scheduler.jobBits,List.length_append]
    nlinarith only [hFrame,hCode,hContext,hB2,h12]
  have hQueue : 1+(framed (Scheduler.counterStream cs)++(planBits p++rest)).length≤29*B^3 := by
    have hh : 1+(Scheduler.jobBits ⟨cs,p⟩++rest).length≤29*B^3 := by
      simp only [List.length_append]
      nlinarith only [hJob,hRest,h23,h13]
    simpa only [Scheduler.jobBits,List.append_assoc] using hh
  have hDecode := decodeCost_bound p (Scheduler.counterStream cs) rest (29*B^3) hQueue
  have hNode := nodeCost_bound p cs params k rest out B h
  have hCleanGroup : 1+20*B^3≤21*B^3 := by omega
  have hClean := Nat.pow_le_pow_left hCleanGroup 2
  nlinarith only [h6,h9,h1,hDecode,hNode,hClean]

theorem queueBits_append (a b : List Scheduler.Job) : Scheduler.queueBits (a++b)=Scheduler.queueBits a++Scheduler.queueBits b :=
  List.flatMap_append

theorem work_drop (params : List Bits) (k : ℕ) (job : Scheduler.Job) (rest : List Scheduler.Job) :
    Scheduler.pendingWork params k ((Scheduler.stepOne params k job).2++rest)+1≤Scheduler.pendingWork params k (job::rest) := by
  have hh := Scheduler.stepOne_work params k job
  rw [Scheduler.pendingWork_append,Scheduler.pendingWork_cons]
  omega

theorem output_step (params : List Bits) (k : ℕ) (job : Scheduler.Job) (rest : List Scheduler.Job) :
    (Scheduler.stepOne params k job).1++Scheduler.pendingOutput params k ((Scheduler.stepOne params k job).2++rest)=
      Scheduler.pendingOutput params k (job::rest) := by
  simp only [Scheduler.pendingOutput,List.flatMap_append,List.flatMap_cons]
  rw [← List.append_assoc]
  exact congrArg (fun bits => bits++Scheduler.pendingOutput params k rest)
      (Scheduler.stepOne_output params k job)

structure LoopBounds (params : List Bits) (k codeBound counterBound B : ℕ) (jobs : List Scheduler.Job) (out : Bits) : Prop where
  positive : 1≤B
  codeLimit : codeBound≤B
  counterLimit : counterBound≤B
  parameters : (TableGet.stream params).length≤B
  precision : k.bits.length≤B
  wellFormed : ∀ job∈jobs,Scheduler.WellFormed codeBound counterBound job
  work : Scheduler.pendingWork params k jobs≤counterBound
  output : out.length+(Scheduler.pendingOutput params k jobs).length≤B

theorem LoopBounds.frontWork {params : List Bits} {k codeBound counterBound B : ℕ} {job : Scheduler.Job} {rest : List Scheduler.Job} {out : Bits}
    (h : LoopBounds params k codeBound counterBound B (job::rest) out) : Qatlib.Concepts.BitWordCompiler.CanonicalCodec.work params k job.counters job.plan≤counterBound := by
  have hh := h.work
  rw [Scheduler.pendingWork_cons] at hh
  omega

theorem LoopBounds.step {params : List Bits} {k codeBound counterBound B : ℕ} {job : Scheduler.Job} {rest : List Scheduler.Job} {out : Bits}
    (h : LoopBounds params k codeBound counterBound B (job::rest) out) :
    LoopBounds params k codeBound counterBound B ((Scheduler.stepOne params k job).2++rest) ((Scheduler.stepOne params k job).1.reverse++out) := by
  refine ⟨h.positive,h.codeLimit,h.counterLimit,h.parameters,h.precision,?_,?_,?_⟩
  · intro child hm
    rcases List.mem_append.mp hm with hc | hr
    · exact Scheduler.wellFormed_child params k codeBound counterBound job child
        (h.wellFormed job List.mem_cons_self) h.frontWork hc
    · exact h.wellFormed child (List.mem_cons_of_mem job hr)
  · have hd := work_drop params k job rest
    have hw := h.work
    omega
  · have hh := congrArg List.length (output_step params k job rest)
    have ho := h.output
    simp only [List.length_append,List.length_reverse] at hh ⊢
    omega

theorem LoopBounds.node {params : List Bits} {k codeBound counterBound B : ℕ} {job : Scheduler.Job} {rest : List Scheduler.Job} {out : Bits}
    (h : LoopBounds params k codeBound counterBound B (job::rest) out) :
    NodeBounds job.plan job.counters params k (Scheduler.queueBits rest) out B := by
  have hf := h.wellFormed job List.mem_cons_self
  obtain ⟨hsyntax,hcounter⟩ := hf
  have hs := h.codeLimit
  have hc := h.counterLimit
  have hfront := h.frontWork
  have hRestWF : ∀ child∈rest,Scheduler.WellFormed codeBound counterBound child :=
      fun child hm => h.wellFormed child (List.mem_cons_of_mem job hm)
  have hRestWork : Scheduler.pendingWork params k rest≤B := by
    have hh := h.work
    rw [Scheduler.pendingWork_cons] at hh
    omega
  have hRestLen :=
      Scheduler.queueBits_length_budget params k codeBound counterBound B h.positive hs hc rest hRestWF hRestWork
  have hNew := h.step
  have hNewLen := Scheduler.queueBits_length_budget params k codeBound counterBound B h.positive hs hc
    ((Scheduler.stepOne params k job).2++rest) hNew.wellFormed (hNew.work.trans hc)
  refine ⟨h.positive,?_,h.parameters,h.precision,?_,hRestLen,?_,?_,hfront.trans hc⟩
  · omega
  · have hcs : job.counters.length≤B := by omega
    have hh := Scheduler.counterStream_length job.counters counterBound hcounter
    have hm := Nat.mul_le_mul hcs (show 3*counterBound+1≤4*B by have := h.positive; omega)
    nlinarith only [hh,hm]
  · simpa only [queueBits_append] using hNewLen
  · change (Scheduler.stepOne params k job).1.length+out.length≤B
    have hh := congrArg List.length (output_step params k job rest)
    have ho := h.output
    simp only [List.length_append] at hh
    omega

theorem empty_loop (params : List Bits) (k codeBound counterBound B : ℕ) (out : Bits) (v : Local)
    (h : LoopBounds params k codeBound counterBound B [] out) : ∃ ticks last,
    Stacks.stackRun program ticks ⟨some (.step .loop),v,store (ready [] (TableGet.stream params).reverse k.bits.reverse out)⟩=
      some ⟨none,last,store (ready [] [] [] out)⟩ ∧
    Stacks.stackRunClock program ticks ⟨some (.step .loop),v,store (ready [] (TableGet.stream params).reverse k.bits.reverse out)⟩≤
      2000000000000000*B^11 := by
  obtain ⟨ticks,last,hr,hc⟩ := terminal (TableGet.stream params).reverse k.bits.reverse out v
  refine ⟨ticks,last,hr,hc.trans ?_⟩
  simp only [List.length_reverse]
  have hB := h.positive
  have hp := h.parameters
  have hk := h.precision
  have hg : 1+(TableGet.stream params).length+k.bits.length≤3*B := by omega
  have hg2 := Nat.pow_le_pow_left hg 2
  have h2 : B^2≤B^11 := Nat.pow_le_pow_right hB (by decide)
  nlinarith only [hg2,h2]

theorem loop_complete (params : List Bits) (k codeBound counterBound B fuel : ℕ) (jobs : List Scheduler.Job) (out : Bits) (v : Local)
    (h : LoopBounds params k codeBound counterBound B jobs out) (hfuel : Scheduler.pendingWork params k jobs≤fuel) : ∃ ticks last,
    Stacks.stackRun program ticks ⟨some (.step .loop),v,store (ready (Scheduler.queueBits jobs) (TableGet.stream params).reverse k.bits.reverse out)⟩=
      some ⟨none,last,store (ready [] [] [] ((Scheduler.pendingOutput params k jobs).reverse++out))⟩ ∧
    Stacks.stackRunClock program ticks ⟨some (.step .loop),v,store (ready (Scheduler.queueBits jobs) (TableGet.stream params).reverse k.bits.reverse out)⟩≤
      2000000000000000*(Scheduler.pendingWork params k jobs+1)*B^11 := by
  induction fuel generalizing jobs out v with
  | zero =>
    cases jobs with
    | nil => simpa only [Scheduler.queueBits,Scheduler.pendingOutput,Scheduler.pendingWork,List.flatMap_nil,List.map_nil,List.sum_nil,List.reverse_nil,List.nil_append,Nat.zero_add,Nat.add_zero,Nat.mul_one] using empty_loop params k codeBound counterBound B out v h
    | cons job rest =>
      have hp := Scheduler.work_positive params k job.counters job.plan
      rw [Scheduler.pendingWork_cons] at hfuel
      omega
  | succ fuel ih =>
    cases jobs with
    | nil => simpa only [Scheduler.queueBits,Scheduler.pendingOutput,Scheduler.pendingWork,List.flatMap_nil,List.map_nil,List.sum_nil,List.reverse_nil,List.nil_append,Nat.zero_add,Nat.add_zero,Nat.mul_one] using empty_loop params k codeBound counterBound B out v h
    | cons job rest =>
      let next := (Scheduler.stepOne params k job).2++rest
      let outNext := (Scheduler.stepOne params k job).1.reverse++out
      obtain ⟨stepTicks,v1,hS,hSC⟩ :=
          job_step job.plan job.counters params k (Scheduler.queueBits rest) out v B h.node
      have hOldQueue :
          Scheduler.jobBits ⟨job.counters,job.plan⟩++Scheduler.queueBits rest=Scheduler.queueBits
          (job::rest) := rfl
      have hNewQueue :
          Scheduler.queueBits
          (Scheduler.stepOne params k job).2++Scheduler.queueBits rest=Scheduler.queueBits next :=
          by dsimp only [next]; rw [queueBits_append]
      rw [hOldQueue,hNewQueue] at hS
      rw [hOldQueue] at hSC
      have hDrop := work_drop params k job rest
      have hNextFuel : Scheduler.pendingWork params k next≤fuel := by dsimp [next]; omega
      obtain ⟨tailTicks,last,hT,hTC⟩ := ih next outNext v1 h.step hNextFuel
      have eS : Stacks.Execution program _ _ _ := ⟨stepTicks,hS,hSC⟩
      have eT : Stacks.Execution program _ _ _ := ⟨tailTicks,hT,hTC⟩
      obtain ⟨ticks,hr,hc⟩ := eS.trans eT
      have hResult : (Scheduler.pendingOutput params k next).reverse++outNext=(Scheduler.pendingOutput params k (job::rest)).reverse++out := by
        dsimp [outNext,next]
        rw [← List.append_assoc,← List.reverse_append,output_step]
      refine ⟨ticks,last,?_,hc.trans ?_⟩
      · simpa only [hResult] using hr
      · have hm := Nat.mul_le_mul_right (2000000000000000*B^11) hDrop
        change 2000000000000000*B^11+2000000000000000*(Scheduler.pendingWork params k next+1)*B^11≤_
        dsimp [next]
        nlinarith only [hm]

def inputBudget (p : Plan) (params : List Bits) (k : ℕ) : ℕ :=
  1+(emitterInput p params k).length+(emit params k [] p).length+work params k [] p

theorem input_lengths (p : Plan) (params : List Bits) (k : ℕ) :
    (planBits p).length≤(emitterInput p params k).length ∧
    (TableGet.stream params).length≤(emitterInput p params k).length ∧
    k.bits.length≤(emitterInput p params k).length := by
  have hk := natBits_length k
  simp only [emitterInput,List.length_append,TableGet.stream]
  omega

theorem initial_bounds (p : Plan) (params : List Bits) (k : ℕ) :
    LoopBounds params k (planBits p).length (work params k [] p) (inputBudget p params k) [⟨[],p⟩] [] := by
  obtain ⟨hcode,hparams,hk⟩ := input_lengths p params k
  refine ⟨?_,?_,?_,?_,?_,?_,?_,?_⟩
  · dsimp [inputBudget]; omega
  · dsimp [inputBudget]; omega
  · dsimp [inputBudget]; omega
  · dsimp [inputBudget]; omega
  · dsimp [inputBudget]; omega
  · intro job hm
    simp only [List.mem_singleton] at hm
    subst job
    exact Scheduler.wellFormed_initial p _
  · simp [Scheduler.pendingWork]
  · simp only [List.length_nil,Scheduler.pendingOutput,List.flatMap_cons,List.flatMap_nil,List.append_nil,Nat.zero_add]
    dsimp [inputBudget]
    omega

theorem complete (p : Plan) (params : List Bits) (k : ℕ) (v : Local) : ∃ ticks last,
    Stacks.stackRun program ticks
      ⟨some (.step .loop),v,store (ready (Scheduler.jobBits ⟨[],p⟩) (TableGet.stream params).reverse k.bits.reverse [])⟩=
      some ⟨none,last,store (ready [] [] [] (emit params k [] p).reverse)⟩ ∧
    Stacks.stackRunClock program ticks
      ⟨some (.step .loop),v,store (ready (Scheduler.jobBits ⟨[],p⟩) (TableGet.stream params).reverse k.bits.reverse [])⟩≤
      2000000000000000*(inputBudget p params k)^12 := by
  let B := inputBudget p params k
  let W := work params k [] p
  obtain ⟨ticks,last,hr,hc⟩ := loop_complete params k (planBits p).length W B W [⟨[],p⟩] [] v (initial_bounds p params k)
    (by simp [Scheduler.pendingWork,W])
  simp only [Scheduler.queueBits,Scheduler.pendingOutput,Scheduler.pendingWork,List.flatMap_cons,List.flatMap_nil,
    List.map_cons,List.map_nil,List.sum_cons,List.sum_nil,List.append_nil,Nat.add_zero] at hr hc
  refine ⟨ticks,last,hr,hc.trans ?_⟩
  have hW : W+1≤B := by dsimp [W,B,inputBudget]; omega
  have hm := Nat.mul_le_mul_right (2000000000000000*B^11) hW
  change 2000000000000000*(W+1)*B^11≤2000000000000000*B^12
  nlinarith only [hm]

end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.EmitterCore

namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.Emitter
open Turing Qatlib.Concepts.BitWordCompiler.CanonicalCodec
abbrev Slot := EmitterCore.Slot
abbrev Local := EmitterCore.Local×TableCopy.Local×Symbol

def getCore (v : Local) := v.1
def putCore (v : Local) (s : EmitterCore.Local) : Local := (s,v.2)
def getTable (v : Local) := v.2.1
def putTable (v : Local) (s : TableCopy.Local) : Local := (v.1,s,v.2.2)
def getIO (v : Local) := v.2.2
def putIO (v : Local) (s : Symbol) : Local := (v.1,v.2.1,s)
def getPlan (v : Local) := EmitterCore.getScan (getCore v)
def putPlan (v : Local) (s : PlanCopy.Local) : Local :=
    putCore v (EmitterCore.putScan (getCore v) s)

inductive Label where
  | start (l : Fin 1) | planStart | plan (l : PlanCopy.Label) | table (l : TableCopy.Label)
  | precision (l : Fin 3) | copy (l : NatEmit.Label) | emptyContext | clearPlan (l : Fin 1)
  | core (l : EmitterCore.Label) | done
  deriving DecidableEq,Fintype
instance : Inhabited Label := ⟨.start 0⟩
instance localFintype : Fintype Local := inferInstance
set_option synthInstance.maxSize 1024 in
instance localInhabited : Inhabited Local := inferInstance

def tableCode : TableCopy.Slot → Slot
  | .reader => .inl .eval | .output => .inl .params
  | .count => .inr (.scalar .tableCount) | .countTemp => .inr (.scalar .tableTemporary)
  | .discard => .inr (.scalar .discard) | .markers => .inr (.scalar .markers)
  | .payload => .inr (.scalar .payload) | .value => .inr (.scalar .value)
  | .temporary => .inr (.scalar .temporary) | .pending => .inr (.scalar .tableIndexTemp)
def precisionCode : Fin 3 →
    Slot | 0 => .inl .eval | 1 => .inr (.scalar .markers) | _ => .inl .precision

def program : Label → TM2.Stmt (fun _ : Slot => Bool) Label Local
  | .start l => StackCall.stmt (EmitterCore.transferCode .tag .eval) Label.start .planStart getIO putIO (Stacks.transferProgram l)
  | .planStart => .push (.inl .pending) (fun _ => true) (.goto (fun _ => .plan (.step .loop)))
  | .plan l => StackCall.stmt (EmitterCore.scanCode .eval .original) Label.plan (.table (.read (.read .unary))) getPlan putPlan (PlanCopy.program l)
  | .table l => StackCall.stmt tableCode Label.table (.precision 0) getTable putTable (TableCopy.program l)
  | .precision l => StackCall.stmt precisionCode Label.precision (.copy .emit) getIO putIO (Parsing.natProgram l)
  | .copy l => StackCall.stmt (EmitterCore.copyCode .plan .jobs) Label.copy .emptyContext getIO putIO (NatEmit.program l)
  | .emptyContext => .push (.inl .jobs) (fun _ => false) (.goto (fun _ => .clearPlan 0))
  | .clearPlan l => StackCall.stmt (EmitterCore.drainCode .plan) Label.clearPlan (.core (.step .loop)) getIO putIO (Normalization.drainProgram l)
  | .core l => StackCall.stmt id Label.core .done getCore putCore (EmitterCore.program l)
  | .done => .halt

@[simp] theorem putIO_get (v : Local) : putIO v (getIO v)=v := rfl

@[simp] theorem putPlan_get (v : Local) : putPlan v (getPlan v)=v := rfl

@[simp] theorem putTable_get (v : Local) : putTable v (getTable v)=v := rfl

@[simp] theorem putCore_get (v : Local) : putCore v (getCore v)=v := rfl

theorem tableCode_injective : Function.Injective tableCode := by decide

theorem precisionCode_injective : Function.Injective precisionCode := by decide

theorem copy_call (S : EmitterCore.Work → Bits) (v : Local) :
    Stacks.stackRun program (2*(S .plan).length+3) ⟨some (.copy .emit),v,EmitterCore.store S⟩=
      some ⟨some (.emptyContext),putIO v none,EmitterCore.store (Function.update S .jobs ((S .plan).reverse++S .jobs))⟩ ∧
    Stacks.stackRunClock program (2*(S .plan).length+3) ⟨some (.copy .emit),v,EmitterCore.store S⟩=
      (S .plan).length*(5*(S .plan).length+2*(S .jobs).length+12)+7 := by
  have hinj := EmitterCore.copyCode_injective .plan .jobs (by decide)
  let S' := Function.update S .jobs ((S .plan).reverse++S .jobs)
  have hsame : StackCall.frame (EmitterCore.copyCode .plan .jobs) (EmitterCore.store S) (Parsing.triple (S .plan) [] (S .jobs))=EmitterCore.store S := by
    apply StackCall.frame_same _ _ _ hinj
    intro k
    fin_cases k <;> rfl
  have hfinal : StackCall.frame (EmitterCore.copyCode .plan .jobs) (EmitterCore.store S) (Parsing.triple (S .plan) [] ((S .plan).reverse++S .jobs))=EmitterCore.store S' := by
    apply EmitterCore.frame_target _ _ _ _ hinj
    · intro k
      fin_cases k <;> simp [S',EmitterCore.store,EmitterCore.copyCode]
    · intro bank hno
      cases bank with
      | inl w =>
        have hw : w≠EmitterCore.Work.jobs := fun h => hno 2 (congrArg Sum.inl h.symm)
        simp [S',EmitterCore.store,hw]
      | inr a => rfl
  obtain ⟨hr,hc⟩ := NatEmit.copy_complete (S .plan) (S .jobs) (getIO v)
  obtain ⟨hN,hNC⟩ := StackCall.execution (EmitterCore.copyCode .plan .jobs) (Label.copy) (.emptyContext) getIO putIO
    (StackCall.frame (EmitterCore.copyCode .plan .jobs) (EmitterCore.store S))
    (fun data k => StackCall.frame_at _ _ data hinj k)
    (fun data k bits => StackCall.frame_update _ _ data hinj k bits)
    (fun _ _ => rfl) (fun _ _ _ => rfl) NatEmit.program program (fun _ => rfl) v (2*(S .plan).length+3) _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,putIO_get,hsame,hfinal] at hN hNC
  exact ⟨hN,hNC.trans hc⟩

theorem start_call (S : EmitterCore.Work → Bits) (v : Local) :
    Stacks.stackRun program ((S .tag).length+1) ⟨some (.start 0),v,EmitterCore.store S⟩=
      some ⟨some (.planStart),putIO v none,EmitterCore.store (Function.update (Function.update S .tag []) EmitterCore.Work.eval ((S .tag).reverse++S .eval))⟩ ∧
    Stacks.stackRunClock program ((S .tag).length+1) ⟨some (.start 0),v,EmitterCore.store S⟩=
      (S .tag).length*(2*((S .tag).length+(S .eval).length)+5)+3 := by
  have hinj := EmitterCore.transferCode_injective .tag .eval (by decide)
  let S' :=
      Function.update (Function.update S .tag []) EmitterCore.Work.eval ((S .tag).reverse++S .eval)
  have hsame : StackCall.frame (EmitterCore.transferCode .tag .eval) (EmitterCore.store S) (Stacks.stackPair (S .tag) (S .eval))=EmitterCore.store S := by
    apply StackCall.frame_same _ _ _ hinj
    intro k
    fin_cases k <;> rfl
  have hfinal : StackCall.frame (EmitterCore.transferCode .tag .eval) (EmitterCore.store S) (Stacks.stackPair [] ((S .tag).reverse++S .eval))=EmitterCore.store S' := by
    apply EmitterCore.frame_target _ _ _ _ hinj
    · intro k
      fin_cases k <;> simp [S',EmitterCore.store,EmitterCore.transferCode]
    · intro bank hno
      cases bank with
      | inl w =>
        have hs : w≠EmitterCore.Work.tag := fun h => hno 0 (congrArg Sum.inl h.symm)
        have hd : w≠EmitterCore.Work.eval := fun h => hno 1 (congrArg Sum.inl h.symm)
        simp [S',EmitterCore.store,hs,hd]
      | inr a => rfl
  have hr := Stacks.transfer_run (S .tag) (S .eval) (getIO v)
  obtain ⟨hN,hNC⟩ := StackCall.execution (EmitterCore.transferCode .tag .eval) (Label.start) (.planStart) getIO putIO
    (StackCall.frame (EmitterCore.transferCode .tag .eval) (EmitterCore.store S))
    (fun data k => StackCall.frame_at _ _ data hinj k)
    (fun data k bits => StackCall.frame_update _ _ data hinj k bits)
    (fun _ _ => rfl) (fun _ _ _ => rfl) Stacks.transferProgram program (fun _ => rfl) v ((S .tag).length+1) _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,putIO_get,hsame,hfinal] at hN hNC
  exact ⟨hN,hNC.trans (Stacks.transfer_clock (S .tag) (S .eval) (getIO v))⟩

theorem clear_call (S : EmitterCore.Work → Bits) (v : Local) :
    Stacks.stackRun program ((S .plan).length+1) ⟨some (.clearPlan 0),v,EmitterCore.store S⟩=
      some ⟨some (.core (.step .loop)),putIO v none,EmitterCore.store (Function.update S .plan [])⟩ ∧
    Stacks.stackRunClock program ((S .plan).length+1) ⟨some (.clearPlan 0),v,EmitterCore.store S⟩=
      (S .plan).length^2+3*(S .plan).length+3 := by
  have hinj : Function.Injective (EmitterCore.drainCode .plan) := fun _ _ _ => Subsingleton.elim _ _
  have hsame : StackCall.frame (EmitterCore.drainCode .plan) (EmitterCore.store S) (Normalization.singleStack (S .plan))=EmitterCore.store S := by
    apply StackCall.frame_same _ _ _ hinj
    intro k
    rfl
  have hfinal : StackCall.frame (EmitterCore.drainCode .plan) (EmitterCore.store S) (Normalization.singleStack [])=EmitterCore.store (Function.update S .plan []) := by
    have h :=
        StackCall.frame_update (EmitterCore.drainCode .plan) (EmitterCore.store S)
        (Normalization.singleStack (S .plan)) hinj 0 []
    simpa only [Normalization.singleStack_update,hsame,EmitterCore.drainCode,EmitterCore.store_update] using h
  have hr := Normalization.drain_run (S .plan) (getIO v)
  obtain ⟨hN,hNC⟩ := StackCall.execution (EmitterCore.drainCode .plan) (Label.clearPlan) (.core (.step .loop)) getIO putIO
    (StackCall.frame (EmitterCore.drainCode .plan) (EmitterCore.store S))
    (fun data k => StackCall.frame_at _ _ data hinj k)
    (fun data k bits => StackCall.frame_update _ _ data hinj k bits)
    (fun _ _ => rfl) (fun _ _ _ => rfl) Normalization.drainProgram program (fun _ => rfl) v ((S .plan).length+1) _ _ hr
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,putIO_get,hsame,hfinal] at hN hNC
  exact ⟨hN,hNC.trans (Normalization.drain_clock (S .plan) (getIO v))⟩

theorem plan_call (p : Plan) (tail : Bits) (S : EmitterCore.Work → Bits) (v : Local)
    (hr : S .eval=planBits p++tail) (hd : S .plan=[]) (hp : S .pending=[]) : ∃ ticks last,
    Stacks.stackRun program ticks ⟨some .planStart,v,EmitterCore.store S⟩=
      some ⟨some (.table (.read (.read .unary))),last,EmitterCore.store (EmitterCore.scanResult .eval .original p tail S)⟩ ∧
    Stacks.stackRunClock program ticks ⟨some .planStart,v,EmitterCore.store S⟩≤
      4+30000*(1+(planBits p).length)*(PlanCopy.scanSize (planBits p++tail) [] 1)^2 := by
  have hinj := EmitterCore.scanCode_injective .eval .original
  let S1 := Function.update S .pending [true]
  have hP : Stacks.stackRun program 1 ⟨some .planStart,v,EmitterCore.store S⟩=
      some ⟨some (.plan (.step .loop)),v,EmitterCore.store S1⟩ := by
    simp [Stacks.run_one,TM2.step,program,TM2.stepAux,EmitterCore.store,hp,S1,← EmitterCore.store_update]
  have hPC : Stacks.stackRunClock program 1 ⟨some .planStart,v,EmitterCore.store S⟩=4 := by
    simp [Stacks.stackRunClock,program,Stacks.stackClock,EmitterCore.store,hp]
  have hsame : StackCall.frame (EmitterCore.scanCode .eval .original) (EmitterCore.store S1) (PlanCopy.store (planBits p++tail) [true] [] [] [])=EmitterCore.store S1 := by
    apply StackCall.frame_same _ _ _ hinj
    intro key
    cases key <;> simp
        [EmitterCore.store,S1,EmitterCore.scanCode,EmitterCore.readerKey,EmitterCore.planKey,PlanCopy.store,hr,hd]
  have hfinal : StackCall.frame (EmitterCore.scanCode .eval .original) (EmitterCore.store S1) (PlanCopy.store tail [] [] [] (planBits p).reverse)=
      EmitterCore.store (EmitterCore.scanResult .eval .original p tail S) := by
    apply EmitterCore.frame_target _ _ _ _ hinj
    · intro key
      cases key <;> simp
          [EmitterCore.store,EmitterCore.scanCode,EmitterCore.scanResult,EmitterCore.readerKey,EmitterCore.planKey,PlanCopy.store,hp]
    · intro bank hno
      cases bank with
      | inl w =>
        have he : w≠EmitterCore.Work.eval := fun h => hno .reader (congrArg Sum.inl h.symm)
        have hd : w≠EmitterCore.Work.plan := fun h => hno .output (congrArg Sum.inl h.symm)
        have hp : w≠EmitterCore.Work.pending := fun h => hno .pending (congrArg Sum.inl h.symm)
        simp [EmitterCore.store,EmitterCore.scanResult,EmitterCore.readerKey,EmitterCore.planKey,S1,he,hd,hp]
      | inr a => rfl
  obtain ⟨ticks,last,hR,hRC⟩ := PlanCopy.complete p tail [] (getPlan v)
  simp only [List.append_nil] at hR
  obtain ⟨hN,hNC⟩ := StackCall.execution (EmitterCore.scanCode .eval .original) Label.plan (.table (.read (.read .unary))) getPlan putPlan
    (StackCall.frame (EmitterCore.scanCode .eval .original) (EmitterCore.store S1))
    (fun data key => StackCall.frame_at _ _ data hinj key)
    (fun data key bits => StackCall.frame_update _ _ data hinj key bits)
    (fun _ _ => rfl) (fun _ _ _ => rfl) PlanCopy.program program (fun _ => rfl) v ticks _ _ hR
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,putPlan_get,hsame,hfinal] at hN hNC
  have eP : Stacks.Execution program _ _ 4 := ⟨1,hP,hPC.le⟩
  have eN : Stacks.Execution program _ _ _ := ⟨ticks,hN,hNC.trans_le hRC⟩
  obtain ⟨total,hRun,hClock⟩ := eP.trans eN
  exact ⟨total,putPlan v last,hRun,hClock⟩

def tableResult (params : List Bits) (tail : Bits) (S : EmitterCore.Work → Bits) : EmitterCore.Work → Bits :=
  Function.update (Function.update S .eval tail) .params (TableGet.stream params).reverse

theorem table_call (params : List Bits) (tail : Bits) (S : EmitterCore.Work → Bits) (v : Local)
    (hr : S .eval=natBits params.length++TableGet.stream params++tail) (hp : S .params=[]) : ∃ ticks last,
    Stacks.stackRun program ticks ⟨some (.table (.read (.read .unary))),v,EmitterCore.store S⟩=
      some ⟨some (.precision 0),last,EmitterCore.store (tableResult params tail S)⟩ ∧
    Stacks.stackRunClock program ticks ⟨some (.table (.read (.read .unary))),v,EmitterCore.store S⟩≤
      300000*(1+(natBits params.length++TableGet.stream params++tail).length)^3 := by
  have hinj := tableCode_injective
  have hsame : StackCall.frame tableCode (EmitterCore.store S) (TableCopy.store (natBits params.length++TableGet.stream params++tail) [] [] [])=EmitterCore.store S := by
    apply StackCall.frame_same _ _ _ hinj
    intro key
    cases key <;> simp [EmitterCore.store,tableCode,TableCopy.store,hr,hp]
  have hfinal : StackCall.frame tableCode (EmitterCore.store S) (TableCopy.store tail [] [] (TableGet.stream params).reverse)=EmitterCore.store (tableResult params tail S) := by
    apply EmitterCore.frame_target _ _ _ _ hinj
    · intro key
      cases key <;> simp [EmitterCore.store,tableCode,tableResult,TableCopy.store]
    · intro bank hno
      cases bank with
      | inl w =>
        have he : w≠EmitterCore.Work.eval := fun h => hno .reader (congrArg Sum.inl h.symm)
        have hp : w≠EmitterCore.Work.params := fun h => hno .output (congrArg Sum.inl h.symm)
        simp [EmitterCore.store,tableResult,he,hp]
      | inr a => rfl
  obtain ⟨ticks,last,hR,hRC⟩ := TableCopy.complete params tail [] (getTable v)
  simp only [List.append_nil] at hR
  obtain ⟨hN,hNC⟩ := StackCall.execution tableCode Label.table (.precision 0) getTable putTable
    (StackCall.frame tableCode (EmitterCore.store S))
    (fun data key => StackCall.frame_at _ _ data hinj key)
    (fun data key bits => StackCall.frame_update _ _ data hinj key bits)
    (fun _ _ => rfl) (fun _ _ _ => rfl) TableCopy.program program (fun _ => rfl) v ticks _ _ hR
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,putTable_get,hsame,hfinal] at hN hNC
  simp only [List.length_nil,Nat.add_zero] at hRC
  exact ⟨ticks,putTable v last,hN,hNC.trans_le hRC⟩

def precisionResult (k : ℕ) (tail : Bits) (S : EmitterCore.Work → Bits) : EmitterCore.Work → Bits :=
  Function.update (Function.update S .eval tail) .precision k.bits.reverse

theorem precision_call (k : ℕ) (tail : Bits) (S : EmitterCore.Work → Bits) (v : Local)
    (hr : S .eval=natBits k++tail) (hk : S .precision=[]) :
    Stacks.stackRun program (2*k.bits.length+3) ⟨some (.precision 0),v,EmitterCore.store S⟩=
      some ⟨some (.copy .emit),putIO v none,EmitterCore.store (precisionResult k tail S)⟩ ∧
    Stacks.stackRunClock program (2*k.bits.length+3) ⟨some (.precision 0),v,EmitterCore.store S⟩≤
      40*(1+(natBits k++tail).length)^2 := by
  have hinj := precisionCode_injective
  have hsame : StackCall.frame precisionCode (EmitterCore.store S) (Parsing.triple (natBits k++tail) [] [])=EmitterCore.store S := by
    apply StackCall.frame_same _ _ _ hinj
    intro key
    fin_cases key <;> simp [EmitterCore.store,precisionCode,Parsing.triple,hr,hk]
  have hfinal : StackCall.frame precisionCode (EmitterCore.store S) (Parsing.triple tail [] k.bits.reverse)=EmitterCore.store (precisionResult k tail S) := by
    apply EmitterCore.frame_target _ _ _ _ hinj
    · intro key
      fin_cases key <;> simp [EmitterCore.store,precisionCode,precisionResult,Parsing.triple]
    · intro bank hno
      cases bank with
      | inl w =>
        have he : w≠EmitterCore.Work.eval := fun h => hno 0 (congrArg Sum.inl h.symm)
        have hk : w≠EmitterCore.Work.precision := fun h => hno 2 (congrArg Sum.inl h.symm)
        simp [EmitterCore.store,precisionResult,he,hk]
      | inr a => rfl
  have hR := Parsing.nat_run k tail [] (getIO v)
  simp only [List.append_nil] at hR
  obtain ⟨hN,hNC⟩ := StackCall.execution precisionCode Label.precision (.copy .emit) getIO putIO
    (StackCall.frame precisionCode (EmitterCore.store S))
    (fun data key => StackCall.frame_at _ _ data hinj key)
    (fun data key bits => StackCall.frame_update _ _ data hinj key bits)
    (fun _ _ => rfl) (fun _ _ _ => rfl) Parsing.natProgram program (fun _ => rfl) v (2*k.bits.length+3) _ _ hR
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,putIO_get,hsame,hfinal] at hN hNC
  have hRC := Parsing.nat_clock_bound k tail [] (getIO v)
  simp only [List.length_nil,Nat.add_zero] at hRC
  exact ⟨hN,hNC.trans_le hRC⟩

theorem frame_id (saved data : Slot → Bits) : StackCall.frame id saved data=data := by
  funext bank
  exact StackCall.frame_at id saved data Function.injective_id bank

theorem core_call (p : Plan) (params : List Bits) (k : ℕ) (v : Local) : ∃ ticks last,
    Stacks.stackRun program ticks
      ⟨some (.core (.step .loop)),v,EmitterCore.store (EmitterCore.ready (Scheduler.jobBits ⟨[],p⟩) (TableGet.stream params).reverse k.bits.reverse [])⟩=
      some ⟨some .done,last,EmitterCore.store (EmitterCore.ready [] [] [] (emit params k [] p).reverse)⟩ ∧
    Stacks.stackRunClock program ticks
      ⟨some (.core (.step .loop)),v,EmitterCore.store (EmitterCore.ready (Scheduler.jobBits ⟨[],p⟩) (TableGet.stream params).reverse k.bits.reverse [])⟩≤
      2000000000000000*(EmitterCore.inputBudget p params k)^12 := by
  let S :=
      EmitterCore.store
      (EmitterCore.ready (Scheduler.jobBits ⟨[],p⟩) (TableGet.stream params).reverse k.bits.reverse [])
  obtain ⟨ticks,last,hR,hRC⟩ := EmitterCore.complete p params k (getCore v)
  obtain ⟨hN,hNC⟩ := StackCall.execution id Label.core .done getCore putCore
    (StackCall.frame id S)
    (fun data key => StackCall.frame_at _ _ data Function.injective_id key)
    (fun data key bits => StackCall.frame_update _ _ data Function.injective_id key bits)
    (fun _ _ => rfl) (fun _ _ _ => rfl) EmitterCore.program program (fun _ => rfl) v ticks _ _ hR
  simp only [StackCall.cfg,Option.map_some,Option.getD_some,Option.map_none,Option.getD_none,putCore_get,frame_id] at hN hNC
  exact ⟨ticks,putCore v last,hN,hNC.trans_le hRC⟩

def initial (raw : Bits) : EmitterCore.Work → Bits := Function.update (fun _ => []) .tag raw.reverse

theorem empty_job (p : Plan) : Scheduler.jobBits ⟨[],p⟩=false::planBits p := by
  simp [Scheduler.jobBits,Scheduler.counterStream,TableGet.stream,framed,natBits,Nat.zero_bits]

theorem empty_context (S : EmitterCore.Work → Bits) (v : Local) :
    Stacks.stackRun program 1 ⟨some .emptyContext,v,EmitterCore.store S⟩=
      some ⟨some (.clearPlan 0),v,EmitterCore.store (Function.update S .jobs (false::S .jobs))⟩ ∧
    Stacks.stackRunClock program 1 ⟨some .emptyContext,v,EmitterCore.store S⟩=2*(S .jobs).length+4 := by
  constructor
  · simp [Stacks.run_one,TM2.step,program,TM2.stepAux,EmitterCore.store,← EmitterCore.store_update]
  · simp [Stacks.stackRunClock,program,Stacks.stackClock,EmitterCore.store]
    omega

def frontendCost (p : Plan) (params : List Bits) (k : ℕ) : ℕ :=
  let raw := emitterInput p params k
  let tail := natBits params.length++TableGet.stream params++natBits k
  raw.length*(2*raw.length+5)+3+
    (4+30000*(1+(planBits p).length)*(PlanCopy.scanSize raw [] 1)^2)+
    300000*(1+tail.length)^3+40*(1+(natBits k).length)^2+
    ((planBits p).length*(5*(planBits p).length+12)+7)+(2*(planBits p).length+4)+
    ((planBits p).length^2+3*(planBits p).length+3)

theorem frontend (p : Plan) (params : List Bits) (k : ℕ) (v : Local) : ∃ ticks last,
    Stacks.stackRun program ticks ⟨some (.start 0),v,EmitterCore.store (initial (emitterInput p params k))⟩=
      some ⟨some (.core (.step .loop)),last,EmitterCore.store (EmitterCore.ready
        (Scheduler.jobBits ⟨[],p⟩) (TableGet.stream params).reverse k.bits.reverse [])⟩ ∧
    Stacks.stackRunClock program ticks ⟨some (.start 0),v,EmitterCore.store (initial (emitterInput p params k))⟩≤frontendCost p params k := by
  let raw := emitterInput p params k
  let tail := natBits params.length++TableGet.stream params++natBits k
  let S0 := initial raw
  obtain ⟨hS,hSC⟩ := start_call S0 v
  let S1 := EmitterCore.transferResult .tag .eval S0
  let v1 := putIO v none
  have hInput : planBits p++tail=emitterInput p params k := by
    simp [emitterInput,tail,TableGet.stream,List.append_assoc]
  obtain ⟨planTicks,v2,hP,hPC⟩ := plan_call p tail S1 v1
    (by simp [S1,S0,EmitterCore.transferResult,initial,raw,hInput])
    (by simp [S1,S0,EmitterCore.transferResult,initial])
    (by simp [S1,S0,EmitterCore.transferResult,initial])
  let S2 := EmitterCore.scanResult .eval .original p tail S1
  obtain ⟨tableTicks,v3,hT,hTC⟩ := table_call params (natBits k) S2 v2
    (by simp [S2,EmitterCore.scanResult,EmitterCore.readerKey,EmitterCore.planKey,tail])
    (by simp [S2,S1,S0,EmitterCore.scanResult,EmitterCore.readerKey,EmitterCore.planKey,EmitterCore.transferResult,initial])
  let S3 := tableResult params (natBits k) S2
  obtain ⟨hK,hKC⟩ := precision_call k [] S3 v3
    (by simp [S3,tableResult])
    (by simp [S3,S2,S1,S0,tableResult,EmitterCore.scanResult,EmitterCore.readerKey,EmitterCore.planKey,EmitterCore.transferResult,initial])
  let S4 := precisionResult k [] S3
  let v4 := putIO v3 none
  obtain ⟨hC,hCC⟩ := copy_call S4 v4
  let S5 := Function.update S4 .jobs ((S4 .plan).reverse++S4 .jobs)
  let v5 := putIO v4 none
  obtain ⟨hE,hEC⟩ := empty_context S5 v5
  let S6 := Function.update S5 .jobs (false::S5 .jobs)
  obtain ⟨hD,hDC⟩ := clear_call S6 v5
  let S7 := Function.update S6 .plan []
  let last := putIO v5 none
  have eS : Stacks.Execution program _ _ _ := ⟨(S0 .tag).length+1,hS,hSC.le⟩
  have eP : Stacks.Execution program _ _ _ := ⟨planTicks,hP,hPC⟩
  have eT : Stacks.Execution program _ _ _ := ⟨tableTicks,hT,hTC⟩
  have eK : Stacks.Execution program _ _ _ := ⟨2*k.bits.length+3,hK,hKC⟩
  have eC : Stacks.Execution program _ _ _ := ⟨2*(S4 .plan).length+3,hC,hCC.le⟩
  have eE : Stacks.Execution program _ _ _ := ⟨1,hE,hEC.le⟩
  have eD : Stacks.Execution program _ _ _ := ⟨(S6 .plan).length+1,hD,hDC.le⟩
  obtain ⟨ticks,hr,hc⟩ := (((((eS.trans eP).trans eT).trans eK).trans eC).trans eE).trans eD
  have hS7 : S7=EmitterCore.ready (Scheduler.jobBits ⟨[],p⟩) (TableGet.stream params).reverse k.bits.reverse [] := by
    funext w
    cases w <;> simp [S7,S6,S5,S4,S3,S2,S1,S0,initial,EmitterCore.transferResult,EmitterCore.scanResult,
      EmitterCore.readerKey,EmitterCore.planKey,tableResult,precisionResult,EmitterCore.ready,empty_job]
  refine ⟨ticks,last,?_,hc.trans ?_⟩
  · change Stacks.stackRun program ticks ⟨some (.start 0),v,EmitterCore.store S0⟩=some ⟨some (.core (.step .loop)),last,EmitterCore.store S7⟩ at hr
    rw [hS7] at hr
    exact hr
  · simp [frontendCost,S6,S5,S4,S3,S2,S1,S0,initial,EmitterCore.transferResult,EmitterCore.scanResult,
      EmitterCore.readerKey,EmitterCore.planKey,tableResult,precisionResult,raw,hInput]

theorem frontendCost_bound (p : Plan) (params : List Bits) (k : ℕ) :
    frontendCost p params k≤100000000*(1+(emitterInput p params k).length)^3 := by
  let raw := emitterInput p params k
  let tail := natBits params.length++TableGet.stream params++natBits k
  let L := raw.length
  let P := (planBits p).length
  let B := 1+L
  have hInput : planBits p++tail=raw := by
    simp [raw,emitterInput,tail,TableGet.stream,List.append_assoc]
  have hlen := congrArg List.length hInput
  change (planBits p++tail).length=raw.length at hlen
  simp only [List.length_append] at hlen
  have hP : P≤L := by dsimp [P,L]; omega
  have htail : 1+tail.length≤B := by dsimp [B,L]; omega
  have hk : (natBits k).length≤tail.length := by dsimp [tail]; simp only [List.length_append]; omega
  have hkB : 1+(natBits k).length≤B := by omega
  have hB : 1≤B := by dsimp [B]; omega
  have h23 : B^2≤B^3 := Nat.pow_le_pow_right hB (by decide)
  have hB2 : B≤B^2 := Nat.le_pow (by decide)
  have h13 : 1≤B^3 := Nat.one_le_pow 3 _ hB
  have hL : L≤B := by dsimp [B]; omega
  have hPL : P≤B := hP.trans hL
  have hP1 : 1+P≤B := by dsimp [B]; omega
  have hscan : PlanCopy.scanSize raw [] 1≤3*B := by dsimp [PlanCopy.scanSize,B,L]; omega
  have hplan := Nat.mul_le_mul hP1 (Nat.pow_le_pow_left hscan 2)
  have htable := Nat.pow_le_pow_left htail 3
  have hprec := Nat.pow_le_pow_left hkB 2
  have hL2 := Nat.mul_le_mul hL hL
  have hP2 := Nat.mul_le_mul hPL hPL
  change L*(2*L+5)+3+(4+30000*(1+P)*(PlanCopy.scanSize raw [] 1)^2)+
    300000*(1+tail.length)^3+40*(1+(natBits k).length)^2+
    (P*(5*P+12)+7)+(2*P+4)+(P^2+3*P+3)≤100000000*B^3
  nlinarith only [h23,hB2,h13,hL,hPL,hL2,hP2,hplan,htable,hprec]

theorem complete (p : Plan) (params : List Bits) (k : ℕ) (v : Local) : ∃ ticks last,
    Stacks.stackRun program ticks ⟨some (.start 0),v,EmitterCore.store (initial (emitterInput p params k))⟩=
      some ⟨none,last,EmitterCore.store (EmitterCore.ready [] [] [] (emit params k [] p).reverse)⟩ ∧
    Stacks.stackRunClock program ticks ⟨some (.start 0),v,EmitterCore.store (initial (emitterInput p params k))⟩≤
      3000000000000000*(EmitterCore.inputBudget p params k)^12 := by
  obtain ⟨frontTicks,v1,hF,hFC⟩ := frontend p params k v
  obtain ⟨coreTicks,last,hC,hCC⟩ := core_call p params k v1
  let S := EmitterCore.store (EmitterCore.ready [] [] [] (emit params k [] p).reverse)
  have hH : Stacks.stackRun program 1 ⟨some .done,last,S⟩=some ⟨none,last,S⟩ := rfl
  have hHC : Stacks.stackRunClock program 1 ⟨some .done,last,S⟩=1 := rfl
  have eF : Stacks.Execution program _ _ _ := ⟨frontTicks,hF,hFC⟩
  have eC : Stacks.Execution program _ _ _ := ⟨coreTicks,hC,hCC⟩
  have eH : Stacks.Execution program _ _ 1 := ⟨1,hH,hHC.le⟩
  obtain ⟨ticks,hr,hc⟩ := (eF.trans eC).trans eH
  refine ⟨ticks,last,hr,hc.trans ?_⟩
  let B := EmitterCore.inputBudget p params k
  have hB : 1≤B := by dsimp [B,EmitterCore.inputBudget]; omega
  have h13 : 1≤B^12 := Nat.one_le_pow 12 _ hB
  have h3 : B^3≤B^12 := Nat.pow_le_pow_right hB (by decide)
  have hInput : 1+(emitterInput p params k).length≤B := by dsimp [B,EmitterCore.inputBudget]; omega
  have hIn3 := Nat.pow_le_pow_left hInput 3
  have hfront := frontendCost_bound p params k
  change frontendCost p params k+2000000000000000*B^12+1≤3000000000000000*B^12
  nlinarith only [h13,h3,hIn3,hfront]

theorem initial_eq (raw : Bits) :
    (TM2.init (.inl EmitterCore.Work.tag) raw.reverse : TM2.Cfg (fun _ : Slot => Bool) Label Local)=
      ⟨some (.start 0),default,EmitterCore.store (initial raw)⟩ := by
  change (⟨some (.start 0),default,Function.update (fun _ : Slot => []) (.inl EmitterCore.Work.tag) raw.reverse⟩ : TM2.Cfg (fun _ : Slot => Bool) Label Local)=_
  congr 1
  funext bank
  cases bank with
  | inl w => cases w <;> rfl
  | inr a => rfl

theorem output_store (bits : Bits) : EmitterCore.store (EmitterCore.ready [] [] [] bits)=
    Function.update (fun _ : Slot => []) (.inl EmitterCore.Work.output) bits := by
  funext bank
  cases bank with
  | inl w => cases w <;> rfl
  | inr a => rfl

theorem raw_machine : ∃ (q : ℕ) (M : TM0.Machine (Option Bool) (Fin (q+1))) (C : ℕ),0<C ∧
    ∀ (p : Plan) (params : List Bits) (k : ℕ),
      Runs M (emitterInput p params k) (emit params k [] p)
        (C*(EmitterCore.inputBudget p params k)^12) (C*(EmitterCore.inputBudget p params k)^12) := by
  obtain ⟨q,M,C,hC,hM⟩ :=
      Stacks.raw_compiler program (.inl EmitterCore.Work.tag) (.inl EmitterCore.Work.output)
  refine ⟨q,M,4000000000000000*C,Nat.mul_pos (by decide) hC,?_⟩
  intro p params k
  obtain ⟨steps,last,hr,hc⟩ := complete p params k default
  have hrun : Stacks.stackRun program steps (TM2.init (.inl EmitterCore.Work.tag) (emitterInput p params k).reverse)=
      some ⟨none,last,Function.update (fun _ => []) (.inl EmitterCore.Work.output) (emit params k [] p).reverse⟩ := by
    rw [initial_eq,← output_store]
    exact hr
  have hclock : Stacks.stackRunClock program steps (TM2.init (.inl EmitterCore.Work.tag) (emitterInput p params k).reverse)≤
      3000000000000000*(EmitterCore.inputBudget p params k)^12 := by
    rw [initial_eq]
    exact hc
  have hraw := hM (emitterInput p params k) (emit params k [] p) steps last hrun
  let B := EmitterCore.inputBudget p params k
  have hB : 1≤B := by dsimp [B,EmitterCore.inputBudget]; omega
  have h2 : B^2≤B^12 := Nat.pow_le_pow_right hB (by decide)
  have hi : 1+(emitterInput p params k).length≤B := by dsimp [B,EmitterCore.inputBudget]; omega
  have ho : 1+(emit params k [] p).length≤B := by dsimp [B,EmitterCore.inputBudget]; omega
  have hi2 := Nat.pow_le_pow_left hi 2
  have ho2 := Nat.pow_le_pow_left ho 2
  have hsum : (1+(emitterInput p params k).length)^2+
      Stacks.stackRunClock program steps (TM2.init (.inl EmitterCore.Work.tag) (emitterInput p params k).reverse)+
      (1+(emit params k [] p).length)^2≤4000000000000000*B^12 := by
    nlinarith only [hclock,h2,hi2,ho2,Nat.zero_le (B^12)]
  have hbudget : C*((1+(emitterInput p params k).length)^2+
      Stacks.stackRunClock program steps (TM2.init (.inl EmitterCore.Work.tag) (emitterInput p params k).reverse)+
      (1+(emit params k [] p).length)^2)≤(4000000000000000*C)*B^12 := by
    calc
      _ ≤ C*(4000000000000000*B^12) := Nat.mul_le_mul_left C hsum
      _ = _ := by ring
  exact runs_mono hraw hbudget hbudget

end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.TM.Emitter
namespace Qatlib.Concepts.BitWordCompiler.CanonicalCodec.BitWordCompiler
open Qatlib.Concepts.BitWordCompiler.CanonicalCodec

theorem uniform_emitter_machine :
  ∃ (q : ℕ) (M : Turing.TM0.Machine (Option Bool) (Fin (q+1))) (C : ℕ),0<C ∧
    ∀ (p : Plan) (params : List Bits) (k : ℕ),
      let input := emitterInput p params k
      let output := emit params k [] p
      let budget := C*(1+input.length+output.length+work params k [] p)^12
      Runs M input output budget budget ∧
      (∀ w,Legal w → output=wordBits w →
        ∃ t cfg,t≤budget ∧ BitMachineAfter M (input.map some) t=some cfg ∧
          Turing.TM0.step M cfg=none ∧
          ∀ i,cfg.Tape.right₀.nth i=((wordBits w).map some).getD i none) := by
  obtain ⟨q,M,C,hC,hM⟩ := TM.Emitter.raw_machine
  refine ⟨q,M,C,hC,?_⟩
  intro p params k
  have hr := hM p params k
  refine ⟨hr,?_⟩
  intro w _ hword
  obtain ⟨_,t,cfg,ht,ha,hh,_,hout,_,_⟩ := hr
  exact ⟨t,cfg,ht,ha,hh,by simpa only [hword] using hout⟩
end Qatlib.Concepts.BitWordCompiler.CanonicalCodec.BitWordCompiler
