import Qatlib.Concepts.LchsSimulation.WindowLchs.TimeDependentLCHSWindow

/-!
# Trapezoidal discretization of the LCHS parameter

`kTrapNode` and `kTrapWeight` give a uniform grid on the symmetric cutoff interval with half
weights at the endpoints. The Cauchy-weighted coefficients `kTrapCoeff` define the finite
propagator sum `kTrapSum`. See [AnLiuLin2023] for the mathematical setting.

## Main statements

* `kTrapCoeff`: The complex coefficient obtained by multiplying the trapezoidal weight by the
  Cauchy density at `kTrapNode K M j`.
* `kTrapSum`: The finite Cauchy-weighted trapezoidal sum of ordered evolutions generated by
  `Complex.I • (H u + k • L u)` at the parameter-grid nodes.

## References

* [An, Liu, and Lin, 2023][AnLiuLin2023]
-/

set_option backward.isDefEq.respectTransparency false
open Qatlib.Concepts.BlockEncoding
open Qatlib.Concepts.BlockEncoding.Encoding
open Qatlib.Concepts.BlockEncoding.Postselection.Encoding

set_option autoImplicit false

open Matrix Qatlib.Concepts.BlockEncoding
open Qatlib.Concepts.BlockEncoding.Encoding
open Qatlib.Concepts.BlockEncoding.Postselection.Encoding MeasureTheory
open scoped Classical BigOperators Matrix.Norms.L2Operator ComplexOrder

variable {I : Type} [Fintype I] [DecidableEq I]

open Qatlib.Concepts.TimeEvolution.TimeOrderedEvolution

namespace Qatlib.Concepts.LchsSimulation.KTrapezoid

/-- The uniform parameter-grid node `-K + j * (2 * K / M)` indexed by `Fin (M + 1)`. -/
noncomputable def kTrapNode (K M : ℕ) (j : Fin (M + 1)) : ℝ :=
  -(K : ℝ) + (j : ℝ) * (2*(K : ℝ)/M)

/-- The trapezoidal parameter weight, equal to `K / M` at either endpoint and `2 * K / M` at
interior indices. -/
noncomputable def kTrapWeight (K M : ℕ) (j : Fin (M + 1)) : ℝ :=
  if (j : ℕ) = 0 ∨ (j : ℕ) = M then (K : ℝ)/M else 2*(K : ℝ)/M

/-- The complex coefficient obtained by multiplying the trapezoidal weight by the Cauchy density
at `kTrapNode K M j`. -/
noncomputable def kTrapCoeff (K M : ℕ) (j : Fin (M + 1)) : ℂ :=
  ((kTrapWeight K M j/(Real.pi*(1+(kTrapNode K M j)^2))) : ℝ)

/-- The finite Cauchy-weighted trapezoidal sum of ordered evolutions generated by `Complex.I •
(H u + k • L u)` at the parameter-grid nodes. -/
noncomputable def kTrapSum (L H : ℝ → Matrix I I ℂ) (s t : ℝ) (K M : ℕ) :
    Matrix I I ℂ :=
  ∑ j : Fin (M+1), kTrapCoeff K M j • orderedEvolution
    (fun u => Complex.I • (H u + (kTrapNode K M j) • L u)) s t
end Qatlib.Concepts.LchsSimulation.KTrapezoid
