import Qatlib.Concepts.LchsSimulation.InteractHybrid.InteractionPictureLchsReprStat

/-!
# Interaction-picture factorization of LCHS evolutions

`interactionPictureLchsRepresentation` factors the unitary evolution generated by `H u + k • L`
into a constant Hamiltonian evolution and an interaction-picture evolution. The fixed matrix `L`
and the time-dependent field `H` are Hermitian. See [AnLiuLin2023] for the mathematical setting.

## Main statements

* `interactionPictureLchsRepresentation`: The ordered evolution generated by `Complex.I • (H u +
  k • L)` equals the evolution of `k • L` multiplied by the ordered interaction-picture
  evolution under the stated Hermitian hypotheses.

## References

* [An, Liu, and Lin, 2023][AnLiuLin2023]
-/

set_option backward.isDefEq.respectTransparency false

open Qatlib.Concepts.LchsSimulation.TimeOrdered

namespace Qatlib.Concepts.LchsSimulation.InteractHybrid

open Matrix
open scoped Matrix.Norms.L2Operator
set_option warningAsError false

/-- The ordered evolution generated by `Complex.I • (H u + k • L)` equals the evolution of `k •
L` multiplied by the ordered interaction-picture evolution under the stated Hermitian
hypotheses. See [AnLiuLin2023]. -/
theorem interactionPictureLchsRepresentation : InteractionPictureLchsRepresentation := by
  intro I _ _ L H k t hL hH hHerm
  have h := ordered_interaction_picture_identity I (k • L) H
    (hL.smul (R := ℝ) (IsSelfAdjoint.all k)) hH hHerm t
  simpa only [add_comm] using! h

end Qatlib.Concepts.LchsSimulation.InteractHybrid
