import Qatlib.Concepts.EffectiveGauge.RationalFlow.SourceJetExecution
import Qatlib.Concepts.EffectiveGauge.RationalFlow.MeanIntegral

set_option backward.isDefEq.respectTransparency false

/-!
# Curvature density from the same finite original-source packet

The integer triple product is the density accumulated by the source-mean
producer. Its common denominator is retained exactly. The stability result
does not normalize noisy values or project noisy derivatives to a tangent plane.
-/

set_option autoImplicit false
namespace Qatlib.Concepts.EffectiveGauge.HopfAtlas
open Qatlib.Concepts.EffectiveGauge.RationalFlow

/-- The producer's integer scalar triple product, with the fixed orientation. -/
def firstJetIntegerTriple (s a b : Fin 3 → ℤ) : ℤ :=
  s 0*(a 1*b 2-a 2*b 1)+s 1*(a 2*b 0-a 0*b 2)+s 2*(a 0*b 1-a 1*b 0)

/-- Actual rational curvature density from a common-denominator integer packet. -/
def firstJetPacketCurvature (p : ℕ) (packet : RationalFirstJetPacket) (i j : Fin 3) : ℚ :=
  (firstJetIntegerTriple packet.1 (packet.2 i) (packet.2 j) : ℚ)/(2^(3*p+1) : ℚ)

noncomputable section
open Set
open scoped Quaternion ContDiff

/-- The finite integer density is exactly the native quaternion curvature
evaluated on the decoded packet; the half-factor and three denominators agree. -/
theorem firstJetPacketCurvature_cast (p : ℕ) (packet : RationalFirstJetPacket) (i j : Fin 3) :
    (firstJetPacketCurvature p packet i j : ℝ)=
      spinCurvatureValue (spinOfVector (firstJetPacketVector p packet.1))
        (spinOfVector (firstJetPacketVector p (packet.2 i)))
        (spinOfVector (firstJetPacketVector p (packet.2 j))) := by
  rw [spinCurvatureValue_components]
  have hp : (2^(3*p+1) : ℝ)=2*(2^p : ℝ)^3 := by
    rw [show 3*p+1=p*3+1 by omega,pow_add,pow_mul]
    ring
  simp only [firstJetPacketCurvature,firstJetIntegerTriple,firstJetPacketVector,rationalSpatialPoint]
  push_cast
  rw [hp]
  field_simp

/-- Original `spinVector_difference_norm` guarantee for the `SourceJetCurvature` construction; the complete source hypotheses are retained. -/
private theorem spinVector_difference_norm (a b : SpatialPoint) :
    ‖spinOfVector a-spinOfVector b‖=‖a-b‖ := by
  have he : spinOfVector a-spinOfVector b=spinOfVector (a-b) := by ext <;> simp [spinOfVector]
  rw [he,spinOfVector_norm]

/-- The actual packet generated by the original program approximates the
curvature of the fixed true `L*a` source and its scaled derivatives. -/
theorem roundedSourceCurvature_error (v : SpatialPoint → SpatialPoint) (hv : ContDiff ℝ ∞ v)
    (hu : ∀ x, ‖v x‖=1) (source : RationalJetSource) (hs : OriginalFirstJetAccurate v source)
    (m1 m2 : ℚ) (hm1 : 0 ≤ m1) (hm2 : 0 ≤ m2)
    (hbounds : SourceAllRescalingBounds v (m1 : ℝ) (m2 : ℝ))
    (a : Fin 3 → ℚ) (ha : ∀ k, (a k : ℝ) ∈ Icc 0 1) (b : ℕ)
    (hb : (2^b : ℝ)⁻¹ ≤ 1/64) (i j : Fin 3) :
    |(firstJetPacketCurvature (b+2) (roundedSourceFirstJet source m1 m2 a b) i j : ℝ)-
      spinCurvatureValue (spinOfVector (v (physicalPeriod • rationalSpatialPoint a)))
        (spinOfVector (physicalPeriod • fderiv ℝ v (physicalPeriod • rationalSpatialPoint a)
          (EuclideanSpace.single i 1)))
        (spinOfVector (physicalPeriod • fderiv ℝ v (physicalPeriod • rationalSpatialPoint a)
          (EuclideanSpace.single j 1)))| ≤ 2*(2^b : ℝ)⁻¹*(7*(m1 : ℝ)+1)^2 := by
  have hcube : InFundamentalCube (physicalPeriod • rationalSpatialPoint a) := by
    intro k
    change 0 ≤ physicalPeriod*(a k : ℝ) ∧ physicalPeriod*(a k : ℝ) ≤ physicalPeriod
    exact ⟨mul_nonneg physicalPeriod_pos.le (ha k).1,
      (mul_le_mul_of_nonneg_left (ha k).2 physicalPeriod_pos.le).trans (by simp)⟩
  have hm : (0 : ℝ) ≤ m1 := by exact_mod_cast hm1
  have hperiod : physicalPeriod ≤ 7 := by dsimp [physicalPeriod]; linarith [Real.pi_lt_d2]
  have hnorm (k : Fin 3) :
      ‖spinOfVector (physicalPeriod • fderiv ℝ v (physicalPeriod • rationalSpatialPoint a)
        (EuclideanSpace.single k 1))‖ ≤ 7*(m1 : ℝ) := by
    rw [spinOfVector_norm,norm_smul,Real.norm_eq_abs,abs_of_pos physicalPeriod_pos]
    exact (mul_le_mul_of_nonneg_left (hbounds.1 _ hcube k) physicalPeriod_pos.le).trans
      (mul_le_mul_of_nonneg_right hperiod hm)
  have hp := roundedSourceFirstJet_error v hv source hs m1 m2 hm1 hm2 hbounds a ha b
  rw [firstJetPacketCurvature_cast]
  apply spinCurvatureValue_packet_error
  · positivity
  · positivity
  · exact hb
  · rw [spinOfVector_norm,hu]
  · exact hnorm i
  · exact hnorm j
  · rw [spinVector_difference_norm]
    exact hp.1
  · rw [spinVector_difference_norm]
    exact hp.2 i
  · rw [spinVector_difference_norm]
    exact hp.2 j

/-- Identify the fixed source density with the actual unit-coordinate
curvature used by the already proved same-reference mean identity. -/
theorem sourceCurvature_unit_value (v : SpatialPoint → SpatialPoint) (hv : ContDiff ℝ ∞ v)
    (u : SpatialPoint) (i j : Fin 3) :
    sourceCurvature (unitCoordinateSpin v) u i j=
      spinCurvatureValue (spinOfVector (v (physicalPeriod • u)))
        (spinOfVector (physicalPeriod • fderiv ℝ v (physicalPeriod • u) (EuclideanSpace.single i 1)))
        (spinOfVector (physicalPeriod • fderiv ℝ v (physicalPeriod • u) (EuclideanSpace.single j 1))) := by
  have hd (k : Fin 3) : fderiv ℝ (unitCoordinateSpin v) u (EuclideanSpace.single k 1)=
      physicalPeriod • fderiv ℝ v (physicalPeriod • u) (EuclideanSpace.single k 1) := by
    have h := (hv.differentiable (by simp) (physicalPeriod • u)).hasFDerivAt.comp u
      ((hasFDerivAt_id u).const_smul physicalPeriod)
    change HasFDerivAt (unitCoordinateSpin v) _ u at h
    rw [h.fderiv]
    simp
  simp only [sourceCurvature,hd,unitCoordinateSpin]

/-- The same successful four-answer execution yields accurate curvature
samples for the exact unit-coordinate moment; no separate packet oracle appears. -/
theorem sourceFirstJetCurvatureExecution_correct (v : SpatialPoint → SpatialPoint)
    (hv : ContDiff ℝ ∞ v) (hu : ∀ x, ‖v x‖=1)
    (source : RationalJetSource) (hs : OriginalFirstJetAccurate v source)
    (m1 m2 : ℚ) (hm1 : 0 ≤ m1) (hm2 : 0 ≤ m2)
    (hbounds : SourceAllRescalingBounds v (m1 : ℝ) (m2 : ℝ))
    (a : Fin 3 → ℚ) (ha : ∀ k, (a k : ℝ) ∈ Icc 0 1) (b : ℕ)
    (hb : (2^b : ℝ)⁻¹ ≤ 1/64) :
    ∃ packet, sourceFirstJetExecution source m1 m2 a b=some packet ∧
      ∀ i j, |(firstJetPacketCurvature (b+2) packet i j : ℝ)-
        sourceCurvature (unitCoordinateSpin v) (rationalSpatialPoint a) i j| ≤
          2*(2^b : ℝ)⁻¹*(7*(m1 : ℝ)+1)^2 := by
  refine ⟨_,sourceFirstJetExecution_eq source m1 m2 a b,?_⟩
  intro i j
  rw [sourceCurvature_unit_value v hv]
  exact roundedSourceCurvature_error v hv hu source hs m1 m2 hm1 hm2 hbounds a ha b hb i j

end
end Qatlib.Concepts.EffectiveGauge.HopfAtlas
