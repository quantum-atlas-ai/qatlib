module

public import Mathlib.Algebra.Group.Subgroup.Basic
public import Mathlib.Data.Fintype.Sets

@[expose] public section


/-! # Genuine finite subgroup generating lists

This produces a finite list by enumerating the actual subgroup. It makes no
logarithmic-length or polynomial-time claim.
-/

set_option autoImplicit false
noncomputable section
open scoped Classical

namespace Qatlib.Foundations.FiniteGroups.HiddenCosets.Generators

variable {G : Type*} [Group G]

/-- The actual subgroup generated by a list of group elements. -/
def listClosure (l : List G) : Subgroup G := Subgroup.closure {g | g ∈ l}

/-- A finite subgroup has a concrete finite generating list, with no size bound. -/
theorem hasGenerators [Fintype G] (H : Subgroup G) :
    ∃ gs : List G, listClosure gs = H := by
  let U : Finset G := Finset.univ.filter (fun g => g ∈ H)
  refine ⟨U.toList, ?_⟩
  apply le_antisymm
  · rw [listClosure, Subgroup.closure_le]
    intro g hg
    exact (Finset.mem_filter.mp (Finset.mem_toList.mp hg)).2
  · intro g hg
    apply Subgroup.subset_closure
    exact Finset.mem_toList.mpr (Finset.mem_filter.mpr ⟨Finset.mem_univ g, hg⟩)

end Qatlib.Foundations.FiniteGroups.HiddenCosets.Generators
